+/* Preserve all ten bits through VKMS's u16 composer and writeback. */
+static void ARGB2101010_to_argb_u16(u8 *src, struct pixel_argb_u16 *out)
+{
+	u32 pixel = get_unaligned_le32(src);
+
+	out->a = (pixel >> 30) * 21845;
+	out->r = DIV_ROUND_CLOSEST(((pixel >> 20) & 1023) * 65535, 1023);
+	out->g = DIV_ROUND_CLOSEST(((pixel >> 10) & 1023) * 65535, 1023);
+	out->b = DIV_ROUND_CLOSEST((pixel & 1023) * 65535, 1023);
+}
+
+static void XRGB2101010_to_argb_u16(u8 *src, struct pixel_argb_u16 *out)
+{
+	ARGB2101010_to_argb_u16(src, out);
+	out->a = 65535;
+}
+
+static void argb_u16_to_ARGB2101010(u8 *dst, struct pixel_argb_u16 *in)
+{
+	u32 a = DIV_ROUND_CLOSEST(in->a, 21845);
+	u32 r = DIV_ROUND_CLOSEST(in->r * 1023, 65535);
+	u32 g = DIV_ROUND_CLOSEST(in->g * 1023, 65535);
+	u32 b = DIV_ROUND_CLOSEST(in->b * 1023, 65535);
+
+	put_unaligned_le32((a << 30) | (r << 20) | (g << 10) | b, dst);
+}
+
+static void argb_u16_to_XRGB2101010(u8 *dst, struct pixel_argb_u16 *in)
+{
+	argb_u16_to_ARGB2101010(dst, in);
+	put_unaligned_le32(get_unaligned_le32(dst) | 0xc0000000, dst);
+}
