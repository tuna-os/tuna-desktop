FROM quay.io/fedora/fedora:45
RUN dnf -y --setopt=install_weak_deps=False install mesa-dri-drivers xorg-x11-server-Xvfb xdotool scrot python3-gobject python3-pyatspi gtk4 libadwaita libgweather4 gtk4-layer-shell adwaita-fonts-all adwaita-icon-theme jq dbus-daemon xdg-desktop-portal xdg-desktop-portal-gnome-51.0 xdg-desktop-portal-gtk pipewire wireplumber pipewire-gstreamer gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-good at-spi2-core && dnf clean all
RUN dnf -y --setopt=install_weak_deps=False install libseat libinput libxkbcommon-x11 gobject-introspection libglvnd-gles pipewire-utils && dnf clean all
RUN dnf -y --setopt=install_weak_deps=False install libei-devel libeis-devel gcc pkgconf-pkg-config && dnf clean all
# R-GRD-ENABLE: the genuine GNOME 51 gnome-remote-desktop daemon, the
# keyring holding its Desktop Sharing credentials, a real FreeRDP client, the
# dconf settings the compositor reads, and GIO headers for the in-binary
# name probe.
RUN dnf -y --setopt=install_weak_deps=False install gnome-remote-desktop gnome-keyring freerdp dconf glib2-devel && dnf clean all
