#!/usr/bin/python3
"""Native GTK event wake regression using matched frozen binaries.

Delivers real Alt-Tab, observes the delayed popup's rendered client pixels,
resizes the host without extra keys, commits a real grouped selection, and
verifies private accessibility/runtime cleanup. Optional launch-time syscall
tracing checks the owned GTK control connection before and after the popup.

Run under dbus-run-session. Requires Xvfb, xdotool, scrot, PyGObject and Pillow;
--trace-idle also requires strace. Schemas missing host keys use declared
fixture extensions. Counts and accepted allocations alone never qualify the
visible popup. Source and executable identities are retained separately.

This is a nested software rendering regression. Observer times include host,
trace and screenshot delays; no physical latency, total CPU, GNOME or power
qualification is inferred. --expect-periodic-poll is a rejected old-source
negative control, never a performance qualification.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import shutil
import hashlib
import signal
import select
import gi
from gi.repository import Gio, GLib
import time
import re
from PIL import Image
p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--bin-dir", type=Path, required=True)
p.add_argument("--artifacts", type=Path, required=True)
p.add_argument("--display", default=":95")
p.add_argument("--trace-idle",action="store_true")
p.add_argument("--expect-periodic-poll",action="store_true",help="Negative control: require old polling behavior")
a = p.parse_args()
root = Path(__file__).resolve().parent.parent
art = a.artifacts.resolve()
art.mkdir(parents=True, exist_ok=True)
runtime = art / "runtime"
runtime.mkdir(mode=0o700, exist_ok=True)
os.chmod(runtime, 0o700)
state = art / "state.json"
clock = art / "clock"
command = art / "command.json"
clock.write_text("0\n")
(art / "assertions.txt").unlink(missing_ok=True)
state.unlink(missing_ok=True)
command.unlink(missing_ok=True)
env = dict(os.environ, DISPLAY=a.display, XDG_RUNTIME_DIR=str(runtime),
           XDG_CONFIG_HOME=str(art / "config"), XDG_DATA_HOME=str(art / "data"), GSETTINGS_BACKEND="keyfile",
           TUNA_COMPOSITOR_STATE=str(state), TUNA_ANIMATION_CLOCK=str(clock),
           TUNA_XWAYLAND="0", LIBGL_ALWAYS_SOFTWARE="1", ADW_DISABLE_PORTAL="1", GSK_RENDERER="cairo", TUNA_LIFECYCLE_COMMAND=str(command))
# A real private desktop entry makes the six client windows one known app,
# rather than six separate window-backed unknown apps (GNOME's matching rule).
applications=art / 'data' / 'applications'
applications.mkdir(parents=True,exist_ok=True)
(applications/'tuna-modal-dim-proof.desktop').write_text('[Desktop Entry]\nType=Application\nName=Switcher wake fixture\nExec=/bin/false\nIcon=application-x-executable\n')
# Freeze the tested binaries so another worktree's build cannot change this run.
frozen = art / "bin"
frozen.mkdir(exist_ok=True)
def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream,"sha256").hexdigest()
binaries = {}
bundle_manifest = json.loads((a.bin_dir / "manifest.json").read_text())
assert bundle_manifest["source_dirty"] is False, "frozen source is dirty"
for name in ("tuna-compositor","tuna-shell-gtk","tuna-modal-dim-client"):
    source = a.bin_dir.resolve() / name
    assert digest(source) == bundle_manifest["binary_sha256"][name], "frozen binary differs: " + name
    dest = frozen / name
    shutil.copy2(source,dest)
    binaries[name] = {"source_path":str(source),"sha256":digest(dest)}
manifest = {
    "source_revision":subprocess.check_output(["git","rev-parse","HEAD"],cwd=root,text=True).strip(),
    "source_dirty":bool(subprocess.check_output(["git","status","--porcelain"],cwd=root,text=True).strip()),
    "binaries":binaries,
    "binary_source_revision":bundle_manifest["source_revision"],
    "proof_sha256":digest(Path(__file__).resolve()),
    "client_sha256":digest(root / "crates/compositor/examples/tuna-modal-dim-client.rs"),
    "backend":"winit/Xvfb/llvmpipe", "gnome_comparison":False,
}
(art / "manifest.json").write_text(json.dumps(manifest,indent=2))
processes = []
logs = []
def spawn(args, name, extra=None):
    log = (art / f"{name}.log").open("w")
    logs.append(log)
    proc = subprocess.Popen(args, env=env | (extra or {}), stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    processes.append(proc)
    return proc
def wait(check, label):
    end = time.monotonic() + 25
    while time.monotonic() < end:
        try:
            data = json.loads(state.read_text())
            if check(data):
                (art / f"{label}.json").write_text(json.dumps(data, indent=2))
                return data
        except (OSError, ValueError, KeyError, IndexError):
            pass
        time.sleep(.05)
    raise AssertionError(f"timed out: {label}; see {art}")
def screenshot(name):
    time.sleep(.1)
    path = art / f"{name}.png"
    subprocess.run(["scrot", str(path)], env=env, check=True)
    return Image.open(path).convert("RGB")
def require_owned_cleanup(cleanup):
    if not cleanup["runtime_removed"] or not cleanup["accessibility_processes_stopped"] or not cleanup["accessibility_identity_verified"]:
        raise AssertionError("owned proof session cleanup failed")

def expected_missing_accessibility_owner(name, remote_error):
    return name == "org.a11y.atspi.Registry" and remote_error == "org.freedesktop.DBus.Error.NameHasNoOwner"

success = False
owned_pidfds = []
accessibility = None
try:
    # Private session buses alone do not isolate the fixed AT-SPI runtime socket.
    launcher = spawn(["/usr/libexec/at-spi-bus-launcher","--launch-immediately"],"atspi")
    session_bus = Gio.bus_get_sync(Gio.BusType.SESSION,None)
    deadline = time.monotonic()+10
    while True:
        try:
            address = session_bus.call_sync("org.a11y.Bus","/org/a11y/bus","org.a11y.Bus","GetAddress",None,None,Gio.DBusCallFlags.NO_AUTO_START,2000,None).unpack()[0]
            break
        except Exception:
            if time.monotonic() >= deadline:
                raise
            time.sleep(.1)
    assert str(runtime) in address, "accessibility bus escaped private runtime"
    env["AT_SPI_BUS_ADDRESS"] = address
    accessibility = Gio.DBusConnection.new_for_address_sync(address,Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,None,None)
    bus_pid = accessibility.call_sync("org.freedesktop.DBus","/org/freedesktop/DBus","org.freedesktop.DBus","GetConnectionUnixProcessID",GLib.Variant("(s)",("org.freedesktop.DBus",)),None,Gio.DBusCallFlags.NONE,2000,None).unpack()[0]
    owned_pidfds.append(os.pidfd_open(bus_pid))
    manifest["session_isolation"] = {
        "runtime_directory":str(runtime), "runtime_mode":oct(runtime.stat().st_mode & 0o777),
        "session_bus":env.get("DBUS_SESSION_BUS_ADDRESS"), "accessibility_bus":address,
        "accessibility_launcher_pid":launcher.pid,"accessibility_bus_pid":bus_pid,
    }
    (art / "manifest.json").write_text(json.dumps(manifest,indent=2))
    # Refuse an existing display; never point the proof at a user's session.
    if Path(f"/tmp/.X11-unix/X{a.display.lstrip(':')}").exists():
        raise RuntimeError("display already in use; choose a private unused display")
    spawn(["Xvfb", a.display, "-screen", "0", "1920x1080x24"], "xvfb")
    for _ in range(100):
        if subprocess.run(["xdotool", "getdisplaygeometry"], env=env, capture_output=True).returncode == 0:
            break
        time.sleep(.05)
    fixture_keys = []
    schemas = art / "schemas"
    for schema, key, fixture in (
        ("org.gnome.desktop.a11y.interface", "reduced-motion", "gnome51-a11y-interface.gschema.xml"),
        ("org.gnome.mutter", "attach-modal-dialogs", "gnome51-mutter.gschema.xml"),
    ):
        if subprocess.run(["gsettings", "range", schema, key], env=env, capture_output=True).returncode:
            schemas.mkdir(exist_ok=True)
            shutil.copy(root / "tests/settings" / fixture, schemas)
            fixture_keys.append(f"{schema}:{key}")
    if fixture_keys:
        import xml.etree.ElementTree as ET
        mutter_file = schemas / 'gnome51-mutter.gschema.xml'
        if mutter_file.exists():
            tree=ET.parse(mutter_file);schema=tree.getroot().find('schema')
            for name in ('dynamic-workspaces','workspaces-only-on-primary','edge-tiling'):
                if schema.find("key[@name='"+name+"']") is None:
                    key=ET.SubElement(schema,'key',name=name,type='b');ET.SubElement(key,'default').text='true'
                    fixture_keys.append('org.gnome.mutter:'+name)
            tree.write(mutter_file)
        subprocess.run(["glib-compile-schemas", str(schemas)], check=True)
        env["GSETTINGS_SCHEMA_DIR"] = str(schemas)
    manifest["settings_fixture_keys"] = fixture_keys
    subprocess.run(["gsettings", "set", "org.gnome.mutter", "attach-modal-dialogs", "true"], env=env, check=True)
    subprocess.run(["gsettings","set","org.gnome.desktop.a11y.interface","reduced-motion","no-preference"],env=env,check=True)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "enable-animations", "true"], env=env, check=True)
    trace_prefix=["strace","-f","-qq","-yy","-ttt","-e","trace=read,recvfrom,recvmsg,poll,ppoll,epoll_wait,epoll_pwait,connect","-e","raw=read,recvfrom,recvmsg","-o",str(art/"native-read-poll.trace")] if a.trace_idle else []
    compositor = spawn(trace_prefix+[str(frozen / "tuna-compositor"), "--socket", "lifecycle-proof", "--shell-bin", str(frozen / "tuna-shell-gtk")], "compositor")
    wait(lambda d: d["animation_clock_manual"] and d["rendered_frames"] >= 5 and d["wallpaper_diagnostics"]["decode_result_count"] > 0 and any(layer["namespace"] == "tuna-panel" for layer in d["layers"]), "ready")
    subprocess.run(['gsettings','set','org.gnome.desktop.interface','enable-animations','false'],env=env,check=True)
    wait(lambda d: not d['animations_enabled'], 'motion-disabled')
    idle_phases=[]
    def idle_trace(label):
        if not a.trace_idle:return
        time.sleep(3)
        phase={'name':label,'start_time_unix':time.time(),'start_offset_bytes':(art/'native-read-poll.trace').stat().st_size}
        time.sleep(5)
        phase.update(end_time_unix=time.time(),end_offset_bytes=(art/'native-read-poll.trace').stat().st_size)
        idle_phases.append(phase)
        (art/'idle-phases.json').write_text(json.dumps(idle_phases,indent=2))
    if a.trace_idle:
        comp_pid=next(int(child) for child in Path(f'/proc/{compositor.pid}/task/{compositor.pid}/children').read_text().split() if Path(f'/proc/{child}/exe').resolve()==frozen/'tuna-compositor')
        gtk_pid=next(int(child) for child in Path(f'/proc/{comp_pid}/task/{comp_pid}/children').read_text().split() if Path(f'/proc/{child}/exe').resolve()==frozen/'tuna-shell-gtk')
        assert digest(Path(f'/proc/{comp_pid}/exe'))==binaries['tuna-compositor']['sha256']
        assert digest(Path(f'/proc/{gtk_pid}/exe'))==binaries['tuna-shell-gtk']['sha256']
        manifest.update(compositor_pid=comp_pid,gtk_pid=gtk_pid)
        trace=(art/'native-read-poll.trace').read_text()
        connections=re.findall(r'^'+str(gtk_pid)+r' \S+ connect\((\d+)<.*sun_path="'+re.escape(str(runtime/'tuna-lifecycle-proof.control'))+r'"',trace,re.M)
        assert len(connections)==1,'exactly one authenticated private control connection required'
        control_fd=int(connections[0])
        manifest['control_fd']=control_fd
        idle_trace('initial-empty')
    # Every peer creates a real independent xdg-toplevel with the same app id.
    # A held application switch then has no focused window until the genuine
    # GTK500ms popup deadline expires; no synthetic control command is used.
    peers=[]
    for index in range(6):
        peer_command=art / ('peer-'+str(index)+'.json')
        peers.append((spawn([str(frozen/'tuna-modal-dim-client')], 'peer-'+str(index), {'WAYLAND_DISPLAY':'lifecycle-proof','TUNA_LIFECYCLE_COMMAND':str(peer_command)}),peer_command))
        wait(lambda d: len(d['windows']) == index+1, 'mapped-'+str(index+1))
    host_windows=subprocess.check_output(['xdotool','search','--onlyvisible','--name','.'],env=env,text=True).splitlines()
    assert len(host_windows)==1, 'proof requires exactly one private nested host window'
    host=host_windows[0]
    subprocess.run(['xdotool','windowfocus','--sync',host],env=env,check=True)
    def keys(*args):
        subprocess.run(['xdotool',*args],env=env,check=True)
    before=json.loads(state.read_text())['rendered_frames']
    start=time.monotonic()
    keys('keydown','Alt_L','key','Tab')
    initial=wait(lambda d:any(layer['namespace']=='tuna-shell-switcher' for layer in d['layers']), 'application-switcher-open')
    # Keep Alt held with Tab released: no key repeat or extra control input is
    # needed to reveal the app's multi-window thumbnails.
    completed=wait(lambda d:d['switcher_thumbnails']>0 and d['rendered_frames']>before, 'delayed-popup-complete')
    first_count_frame=completed['rendered_frames']
    def color_segments(image, rectangle, row, color):
        x,y,width,height=rectangle
        samples=[all(abs(image.getpixel((at,y+row))[channel]-color[channel])<=3 for channel in range(3)) for at in range(x,x+width)]
        segments=[]
        begin=None
        for index,matching in enumerate(samples+[False]):
            if matching and begin is None: begin=index
            if not matching and begin is not None:
                if 150<=index-begin<=270: segments.append([x+begin,x+index])
                begin=None
        return segments
    # A frame count or accepted geometry alone cannot prove rendered clones.
    # Wait for actual allocation and a later genuine frame, then observe the
    # private Xvfb framebuffer. The fixture supplies real opaque red/blue halves.
    visual_deadline=time.monotonic()+25
    attempt=0
    while time.monotonic()<visual_deadline:
        data=json.loads(state.read_text())
        layer=next((layer for layer in data['layers'] if layer['namespace']=='tuna-shell-switcher-thumbnails'),None)
        if layer and layer['rect'][2]>=1000 and layer['rect'][3]>=260 and data['rendered_frames']>first_count_frame:
            image=screenshot('popup-visual-'+str(attempt))
            red=color_segments(image,layer['rect'],96,(239,41,41))
            blue=color_segments(image,layer['rect'],200,(52,101,164))
            if len(red)==4 and red==blue:
                completed=data
                (art/'visually-complete.json').write_text(json.dumps(data,indent=2))
                break
            attempt+=1
        time.sleep(.05)
    else:
        raise AssertionError('count-only popup never reached four actual rendered client clones without further input')
    complete_at=time.monotonic()
    elapsed=complete_at-start
    assert elapsed>=.45, 'thumbnails appeared before the half-second popup deadline'
    assert completed['seat_pressed_key_count']==1, 'hold just the Alt modifier'
    assert initial['switcher_thumbnails']==0, 'first response must not be counted as visually complete'
    assert completed['switcher_thumbnails']==4, 'expected all four fully visible cards in this fixed viewport'
    screenshot('delayed-popup')
    (art/'popup-receipt.json').write_text(json.dumps({'original_input_monotonic':start,'observed_complete_monotonic':complete_at,'elapsed_seconds':elapsed,'first_response_thumbnail_count':initial['switcher_thumbnails'],'completed_thumbnail_count':completed['switcher_thumbnails'],'completed_rendered_frames':completed['rendered_frames'],'red_segments':red,'blue_segments':blue,'first_count_rendered_frames':first_count_frame,'binary_source_revision':bundle_manifest['source_revision'],'physical_latency_qualified':False},indent=2))
    # Resize the real host while only Alt remains held. Reconciliation must
    # follow actual allocation/paint and monitor changes without another key.
    for width, count in [(1820,6),(960,3),(1280,4)]:
        previous=json.loads(state.read_text())['rendered_frames']
        keys('windowsize','--sync',host,str(width),'800')
        deadline=time.monotonic()+25
        attempt=0
        while time.monotonic()<deadline:
            data=json.loads(state.read_text())
            layer=next((layer for layer in data['layers'] if layer['namespace']=='tuna-shell-switcher-thumbnails'),None)
            if data['switcher_thumbnails']==count and layer and layer['rect'][3]>=260 and data['rendered_frames']>previous:
                image=screenshot('resize-'+str(width)+'-'+str(attempt))
                red_resize=color_segments(image,layer['rect'],96,(239,41,41))
                blue_resize=color_segments(image,layer['rect'],200,(52,101,164))
                if len(red_resize)==count and red_resize==blue_resize:
                    (art/('resize-'+str(width)+'.json')).write_text(json.dumps({'state':data,'red_segments':red_resize,'blue_segments':blue_resize},indent=2))
                    break
                attempt+=1
            time.sleep(.05)
        else:
            raise AssertionError('real host resize failed actual clone geometry: '+str(width))
    # Actual grouped-window selection and scroll adjustment must publish real
    # post-allocation thumbnail frames as focus moves across an overflowing strip.
    keys('key','Down')
    wait(lambda d:d['switcher_thumbnails']>0,'thumbnail-focus-entered')
    for index in range(5):
        previous=json.loads(state.read_text())['rendered_frames']
        keys('key','Right')
        wait(lambda d:d['switcher_thumbnails']>0 and d['rendered_frames']>previous, 'group-step-'+str(index))
    screenshot('scrolled-popup')
    keys('keyup','Alt_L')
    released=wait(lambda d:d['switcher_thumbnails']==0 and d['seat_pressed_key_count']==0 and d['focused']==1,'released-switcher')
    assert released['focused']==1, 'five delivered Right keys must select the oldest of six real windows'
    for index,(peer,path) in enumerate(peers):
        temp=path.with_suffix('.tmp')
        temp.write_text(json.dumps({'action':'close','generation':1}))
        temp.replace(path)
        peer.wait(timeout=10)
    wait(lambda d: not d['windows'],'all-peers-closed')
    idle_trace('post-switcher-close')
    if a.trace_idle:
        trace=(art/'native-read-poll.trace').read_text()
        for phase in idle_phases:
            lines=[line for line in trace.splitlines() if line.startswith(str(gtk_pid)+' ') and phase['start_time_unix']<=float(line.split()[1])<phase['end_time_unix']]
            reads=[line for line in lines if 'recvfrom('+hex(control_fd)+',' in line]
            phase.update(control_read_attempts=len(reads),complete_eagain_reads=sum('EAGAIN' in line for line in reads),unfinished_reads=sum('<unfinished' in line for line in reads),seconds=phase['end_time_unix']-phase['start_time_unix'])
            if a.expect_periodic_poll:assert len(reads)>100,'negative control did not reproduce periodic control polling'
            else:assert len(reads)<=10,'idle GTK control read loop persists despite event sources'
        (art/'idle-phases.json').write_text(json.dumps(idle_phases,indent=2))
    assert compositor.poll() is None
    success=True

finally:
    owned_accessibility_pids = [manifest["session_isolation"]["accessibility_bus_pid"]] if "session_isolation" in manifest else []
    cleanup_query_errors = []
    if accessibility:
        for name in ("org.a11y.atspi.Registry",):
            try:
                owned_accessibility_pids.append(accessibility.call_sync("org.freedesktop.DBus","/org/freedesktop/DBus","org.freedesktop.DBus","GetConnectionUnixProcessID",GLib.Variant("(s)",(name,)),None,Gio.DBusCallFlags.NONE,2000,None).unpack()[0])
            except GLib.Error as error:
                if not expected_missing_accessibility_owner(name, Gio.DBusError.get_remote_error(error)):
                    cleanup_query_errors.append(str(error))
            except Exception as error:
                cleanup_query_errors.append(str(error))
    for pid in owned_accessibility_pids[1:]:
        try:
            owned_pidfds.append(os.pidfd_open(pid))
        except ProcessLookupError:
            pass
    for proc in reversed(processes):
        if proc.poll() is None:
            try:
                os.killpg(proc.pid,signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid,signal.SIGKILL)
                proc.wait()
    accessibility_stopped = True
    for pidfd in owned_pidfds:
        poller = select.poll()
        poller.register(pidfd,select.POLLIN)
        try:
            signal.pidfd_send_signal(pidfd,signal.SIGTERM)
        except ProcessLookupError:
            pass
        if not poller.poll(1000):
            signal.pidfd_send_signal(pidfd,signal.SIGKILL)
            accessibility_stopped = bool(poller.poll(1000)) and accessibility_stopped
        os.close(pidfd)
    if accessibility:
        try:
            accessibility.close_sync(None)
        except GLib.Error:
            pass
    shutil.rmtree(runtime)
    manifest["owned_cleanup"] = {"runtime_removed":not runtime.exists(), "accessibility_pids":owned_accessibility_pids,"accessibility_processes_stopped":accessibility_stopped, "accessibility_identity_verified":bool(owned_accessibility_pids) and not cleanup_query_errors, "query_errors":cleanup_query_errors}
    (art / "manifest.json").write_text(json.dumps(manifest,indent=2))
    for log in logs:
        log.close()

require_owned_cleanup(manifest["owned_cleanup"])
if success:
    (art / 'assertions.txt').write_text('delivered Alt-Tab held-modifier delayed popup: four actual clones; host resize1820/960/1280: six/three/four actual clones; grouped commit focus1 acknowledgment and cleared frames; private owned cleanup pass; idle trace scoped when requested; no physical latency/GNOME/resource qualification claim\n')
    print('Native GTK popup/geometry/selection proof passed:',art)
