#!/usr/bin/env python3
"""Observe aggregate guest CPU in an admitted, already selected stock desktop.

No image/VM configuration changes. This independent idle window includes
collector/SSH overhead, excludes host CPU and does not prove completed actions.
"""
import argparse
import base64
import hashlib
import json
from pathlib import Path
import sys
import subprocess
import time
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
from corral_guest_cpu import collect_idle
from corral_session import Session, PHASE, admit_imported_disk
from corral_ssh import client_key
from corral_visual import candidate_intent
from gnome_reference import validate_image, validate_reference, same_reference


from corral_guest_admission import (PROCESS_BYTES, fingerprint, stock_reference,
                                   image_reference, selected_identity, AggregateAdmission)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('context', 'vm', 'key', 'known-hosts', 'reference-image', 'tuna-payload', 'tuna-selection', 'export-dir', 'import-receipt', 'candidate-sha', 'out'):
        parser.add_argument('--' + name, required=True)
    parser.add_argument('--namespace', default='corral-vms')
    parser.add_argument('--public-key')
    parser.add_argument('--package-run', type=int, required=True)
    parser.add_argument('--desktop', choices=('gnome', 'tuna'), required=True)
    args = parser.parse_args()
    export = Path(args.export_dir)
    manifest = json.loads((export / 'manifest.json').read_text())
    candidate_intent(manifest, args.candidate_sha, args.package_run)
    if manifest.get('gnome_profile') != 'stock':raise ValueError('aggregate comparison requires stock GNOME 51 export')
    reference = validate_image(json.loads(Path(args.reference_image).read_text()), 'stock')
    admitted = admit_imported_disk(export, args.import_receipt, args.context, args.namespace, args.vm, args.reference_image, args.tuna_payload, args.tuna_selection)
    key = client_key(manifest, args.key, args.public_key or args.key + '.pub', 'root')
    root = Path(__file__).resolve().parent.parent
    out = Path(args.out).resolve()
    if out == root or root in out.parents:raise ValueError('collector evidence must be outside source checkout')
    out.mkdir(mode=0o700, parents=True, exist_ok=False)
    report = {'schema': 1, 'completed': False, 'context': args.context, 'namespace': args.namespace, 'vm': args.vm, 'desktop': args.desktop, 'candidate_source_commit': args.candidate_sha,
              'export_observer_source_commit': manifest['observer_source_commit'],
              'package_run': args.package_run, 'package_sha256': manifest['package_sha256'], 'fixture_image_id': manifest['fixture_image_id'],
              'reference': reference, 'original_import': admitted, 'client_key': key,

              'scope': 'Independent read-only idle window; aggregate guest includes collector/SSH overhead; no completed-action or whole-host CPU claim.',
              'hardware_gpu_qualified': False, 'total_power_qualified': False, 'performance_qualified': False}
    session = None
    try:
        session = Session(args.context, args.namespace, args.vm, 'root', args.key, args.known_hosts, out)
        report['session'] = session.metadata
        selected=session.desktop(args.desktop)
        original=stock_reference(session) if args.desktop=='gnome' else None
        admission=AggregateAdmission(session,vars(args),reference,selected,original)
        report['admission']=admission.evidence
        time.sleep(30)  # Equal standalone settle; paired hook reuses its existing settle.
        report['aggregate'] = collect_idle(session, out)
        report['admission']=admission.finish()
        report['completed'] = True
    except Exception as error:
        report['error'] = type(error).__name__ + ': ' + str(error)[:2000]
    finally:
        if session:
            try:session.close()
            except Exception as error:report['completed'] = False;report['cleanup_error'] = str(error)[:2000]
        raw_path = out / 'guest-aggregate-raw.json'
        if raw_path.exists():report['raw_capture'] = {'file': raw_path.name, 'sha256': fingerprint(raw_path), 'validated': report['completed']}
        (out / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
    return 0 if report['completed'] else 1


if __name__ == '__main__':raise SystemExit(main())
