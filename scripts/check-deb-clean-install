#!/bin/sh
# check-deb-clean-install — install a Tuna Desktop .deb on a pristine Ubuntu image.
#
# Usage:
#   scripts/check-deb-clean-install <package.deb> [image]
#
# Lists the original archive with dpkg-deb -c and requires root:root
# ownership for every entry plus the preferred GTK shell, then installs the
# package with apt in a clean container (default ubuntu:26.04, the first
# package target) where only the declared Depends can satisfy the binaries.
# Every installed binary must load its libraries and report the package
# version (a X.Y.Z~beta.N package carries X.Y.Z-beta.N binaries), and the
# GTK shell must sit beside the compositor so the session
# selects it ahead of the legacy shell.
set -eu

unset CDPATH

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: scripts/check-deb-clean-install <package.deb> [image]" >&2
    exit 1
fi

PKG="$1"
IMAGE="${2:-ubuntu:26.04}"
fail() {
    echo "check-deb-clean-install: $1" >&2
    exit 1
}

[ -f "$PKG" ] || fail "no package $PKG"
VERSION="$(dpkg-deb -f "$PKG" Version)"
[ -n "$VERSION" ] || fail "empty Version field"
# tuna-release writes a SemVer prerelease's hyphen as "~" for dpkg ordering.
SEMVER="$(printf '%s' "$VERSION" | sed 's/~/-/')"

# Original archive listing: owner/group is the second column.
LISTING="$(dpkg-deb -c "$PKG")"
printf '%s\n' "$LISTING"
BAD_OWNER="$(printf '%s\n' "$LISTING" | awk '$2 != "root/root"')"
[ -z "$BAD_OWNER" ] || fail "entries not owned by root/root:
$BAD_OWNER"
printf '%s\n' "$LISTING" | awk '$6 == "./" && $1 == "drwxr-xr-x" { found = 1 } END { exit !found }' \
    || fail "archive root is not drwxr-xr-x"
printf '%s\n' "$LISTING" | awk '$6 == "./usr/bin/tuna-shell-gtk" && $1 == "-rwxr-xr-x" { found = 1 } END { exit !found }' \
    || fail "tuna-shell-gtk missing or not 0755"

if command -v docker >/dev/null 2>&1; then
    ENGINE=docker
elif command -v podman >/dev/null 2>&1; then
    ENGINE=podman
else
    fail "needs docker or podman"
fi

PKG_DIR="$(cd -- "$(dirname -- "$PKG")" && pwd)"
PKG_NAME="$(basename -- "$PKG")"

# shellcheck disable=SC2016 # expanded inside the container
"$ENGINE" run --rm -e DEBIAN_FRONTEND=noninteractive -e PKG_VERSION="$VERSION" -e BIN_VERSION="$SEMVER" -e PKG_NAME="$PKG_NAME" \
    -v "$PKG_DIR:/pkg:ro" "$IMAGE" sh -euc '
fail() { echo "check-deb-clean-install (container): $1" >&2; exit 1; }
apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=20 -o Acquire::https::Timeout=20 update >/dev/null
apt-get install -y --no-install-recommends "/pkg/$PKG_NAME" >/dev/null
echo "installed tuna-desktop $(dpkg-query -W -f "\${Version}" tuna-desktop) on $(sed -n "s/^PRETTY_NAME=//p" /etc/os-release)"
for bin in tuna-compositor tuna-session tuna-shell-gtk tuna-shell-host tuna-ibus-bridge tuna-greeter tuna-wallpaper-svg; do
    path="/usr/bin/$bin"
    [ "$(stat -c "%u:%g %a" "$path")" = "0:0 755" ] || fail "$path not root-owned 0755"
    if ldd "$path" | grep "not found"; then fail "$bin missing a library on a clean install"; fi
    [ "$("$path" --version)" = "$bin $BIN_VERSION" ] || fail "$bin version differs from package $PKG_VERSION"
done
# Native bell and volume feedback invoke the player, dynamically load the
# Pulse backend, and read theme assets: ldd on Tuna binaries cannot find these.
command -v canberra-gtk-play >/dev/null || fail "event sound player missing"
for package in gnome-session-canberra libcanberra-pulse sound-theme-freedesktop; do
    [ "$(dpkg-query -W -f "\${Status}" "$package")" = "install ok installed" ] \
        || fail "event sound package $package missing"
done
pulse_plugin="$(dpkg-query -L libcanberra-pulse | grep "/libcanberra-pulse\.so$" )"
[ -n "$pulse_plugin" ] && [ -s "$pulse_plugin" ] || fail "event sound Pulse backend missing"
for event in bell audio-volume-change; do
    [ -s "/usr/share/sounds/freedesktop/stereo/$event.oga" ] || fail "event sound asset $event missing"
done
# The compositor prefers tuna-shell-gtk beside itself over tuna-shell-host.
[ "$(dirname "$(readlink -f "$(command -v tuna-compositor)")")" = "$(dirname "$(readlink -f "$(command -v tuna-shell-gtk)")")" ] \
    || fail "tuna-shell-gtk is not beside tuna-compositor"
# The one-release compatibility names (#505) are gone: nothing under the
# old name may ship.
if ls /usr/bin/roost-* >/dev/null 2>&1 || [ -e /usr/share/wayland-sessions/roost.desktop ] || [ -e /etc/pam.d/roost-lock ]; then  # tuna-rename: keep
    fail "legacy roost names still installed"  # tuna-rename: keep
fi
EXEC="$(sed -n "s/^Exec=\([^ ]*\).*/\1/p" /usr/share/wayland-sessions/tuna.desktop)"
command -v "$EXEC" >/dev/null || fail "session Exec $EXEC not installed"
for path in /usr/lib/systemd/user/tuna-session.target /etc/pam.d/tuna-lock; do
    [ "$(stat -c "%u:%g" "$path")" = "0:0" ] || fail "$path not root-owned"
done
' || fail "clean install on $IMAGE failed"

echo "check-deb-clean-install: $PKG OK on $IMAGE (version $VERSION)"
