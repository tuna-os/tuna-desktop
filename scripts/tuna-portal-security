#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ "$#" != 4 ] || [ "$1" != --candidate ] || [ "$3" != --out ]; then echo 'usage: tuna-portal-security --candidate DIR --out DIR' >&2; exit 2; fi
candidate="$(realpath "$2")"
out="$(realpath -m "$4")"
if [ ! -x "$candidate/usr/bin/tuna-compositor" ] || [ ! -x "$candidate/usr/bin/tuna-shell-gtk" ]; then
    echo 'packaged compositor and GTK shell required' >&2
    exit 2
fi
[ ! -f "$out/assertions.txt" ] || { echo 'use a fresh artifact directory' >&2; exit 2; }
mkdir -p "$out"
# Retain the actual observer checkout before crossing the container boundary;
# a worktree's .git file may point outside the /repo bind mount.
git -C "$ROOT" rev-parse HEAD >"$out/observer-source-revision.txt"
git -C "$ROOT" status --porcelain >"$out/observer-source-status.txt"
podman build --tag localhost/tuna-portal-reference --file "$ROOT/tests/portal-reference/Containerfile" "$ROOT/tests/portal-reference"
# Preserve zip-compatible evidence on failure as well as success.
cleanup_artifacts() {
    find "$out" \( -type s -o -type p -o -type b -o -type c \) -delete
}
trap cleanup_artifacts EXIT
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/run.sh

# A fresh session checks the stock Settings UI with shared persisted settings.
# It never inherits the locked portal/security desktop or its memory backend.
mkdir -p "$out/stock-settings"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out/stock-settings:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/settings-run.sh

# Independent shared settings session for the genuine GNOME shortcuts provider.
# This backend-only stage does not use a host-app-ID frontend test bypass.
mkdir -p "$out/global-shortcuts"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out/global-shortcuts:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/global-shortcuts-run.sh

mkdir -p "$out/stock-backgrounds"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out/stock-backgrounds:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/backgrounds-run.sh

mkdir -p "$out/stock-slideshow"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out/stock-slideshow:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/slideshow-run.sh

mkdir -p "$out/stock-svg"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out/stock-svg:/out" localhost/tuna-portal-reference /repo/tests/portal-reference/svg-run.sh
