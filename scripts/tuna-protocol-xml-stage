#!/usr/bin/python3
"""Stage actual locked Cargo wayland-protocols XML for native C consumers.

Run in the source checkout after the normal locked dependency acquisition/build;
this never fetches dependencies, substitutes distro XML, or edits Cargo.lock.
The output can be an ordinary CI artifact consumed by an image producer.
"""
import hashlib
import io
import json
from pathlib import Path
import subprocess
import sys
import tomllib
import tarfile

def verify_registry_protocols(source, archive, checksum):
    """Verify the exact cached crate and every resolved protocol source file."""
    archive_bytes = archive.read_bytes()
    if hashlib.sha256(archive_bytes).hexdigest() != checksum:
        raise SystemExit('cached registry archive checksum differs from Cargo.lock')
    expected = {}
    prefix = source.name + '/'
    with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode='r:gz') as crate:
        for member in crate.getmembers():
            if not member.name.startswith(prefix + 'protocols/') or member.isdir():
                continue
            if not member.isfile():
                raise SystemExit('non-regular registry protocol member: ' + member.name)
            relative = member.name.removeprefix(prefix)
            if relative in expected:
                raise SystemExit('duplicate registry protocol member: ' + relative)
            expected[relative] = hashlib.sha256(crate.extractfile(member).read()).hexdigest()
    observed = {}
    for path in sorted((source / 'protocols').rglob('*')):
        if path.is_symlink():
            raise SystemExit('resolved registry protocol source is a symlink: ' + str(path))
        if path.is_file():
            relative = path.relative_to(source).as_posix()
            observed[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
    if not expected or observed != expected:
        raise SystemExit('resolved registry protocol files differ from the locked archive')
    return observed


def main():
    if len(sys.argv) != 2:
        raise SystemExit('usage: tuna-protocol-xml-stage OUTPUT_DIRECTORY')
    root = Path(__file__).resolve().parent.parent
    lock_bytes = (root / 'Cargo.lock').read_bytes()
    lock = tomllib.loads(lock_bytes.decode())
    locked = [package for package in lock['package'] if package['name'] == 'wayland-protocols']
    if len(locked) != 1:
        raise SystemExit('one exact locked wayland-protocols package required')
    package = locked[0]
    metadata = json.loads(subprocess.check_output(
        ['cargo', 'metadata', '--locked', '--offline', '--format-version', '1'], cwd=root))
    resolved = [entry for entry in metadata['packages']
                if entry['name'] == package['name'] and entry['version'] == package['version']]
    if len(resolved) != 1 or not resolved[0]['source'] or not resolved[0]['source'].startswith('registry+'):
        raise SystemExit('actual locked registry package path is unavailable')
    source = Path(resolved[0]['manifest_path']).resolve().parent
    archive = source.parents[2] / 'cache' / source.parent.name / (source.name + '.crate')
    observed = verify_registry_protocols(source, archive, package['checksum'])
    out = Path(sys.argv[1]).resolve()
    out.mkdir(mode=0o700, parents=True, exist_ok=False)
    for relative, digest in observed.items():
        content = (source / relative).read_bytes()
        if hashlib.sha256(content).hexdigest() != digest:
            raise SystemExit('registry protocol source changed during staging: ' + relative)
        destination = out / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(content)
    (out / 'source.json').write_text(json.dumps({
        'package': package['name'], 'version': package['version'],
        'registry_package_sha256': package['checksum'],
        'verified_registry_archive_sha256': package['checksum'],
        'cargo_lock_sha256': hashlib.sha256(lock_bytes).hexdigest(),
        'metadata_package_id': resolved[0]['id'], 'file_sha256': observed,
    }, indent=2) + '\n')
    print(out)


if __name__ == '__main__':
    main()
