#!/usr/bin/python3
"""Exercise the real GTK AT-SPI root on stock and identically staged CI GTK."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import resource
import select
import signal
import subprocess
import sys
import time

NAMES = ['Visible root child One', 'Visible root child Two', 'Visible root child Three']
ROOT_PATH = '/org/a11y/atspi/accessible/root'
ACCESSIBLE = 'org.a11y.atspi.Accessible'
PROPERTIES = 'org.freedesktop.DBus.Properties'


def application():
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gio, GLib, Gtk
    app = Gtk.Application(application_id='org.tuna.CiAtSpiRoot', flags=Gio.ApplicationFlags.NON_UNIQUE)
    windows = []

    def activate(_app):
        for name in [*NAMES, 'Hidden tail without an accessible path']:
            window = Gtk.ApplicationWindow(application=app, title=name)
            window.set_default_size(240, 120)
            windows.append(window)
        for window in windows[:3]:
            window.present()

        def ready():
            print(json.dumps({'ready': True, 'pid': os.getpid(),
                              'gtk': [Gtk.get_major_version(), Gtk.get_minor_version(), Gtk.get_micro_version()]}), flush=True)
            return False
        GLib.idle_add(ready)

    def hide():
        for window in windows[:3]:
            window.set_visible(False)
        return True

    def show():
        for window in windows[:3]:
            window.present()
        return True

    app.connect('activate', activate)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, hide)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, show)
    return app.run([])


def session(artifacts, patched):
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    artifacts.mkdir(parents=True, exist_ok=False)
    resource.setrlimit(resource.RLIMIT_CORE, (0, resource.getrlimit(resource.RLIMIT_CORE)[1]))
    env = {key: value for key, value in os.environ.items() if key in
           ('PATH', 'HOME', 'DISPLAY', 'XAUTHORITY', 'DBUS_SESSION_BUS_ADDRESS',
            'XDG_RUNTIME_DIR', 'LD_LIBRARY_PATH', 'LANG', 'LC_ALL')}
    env.update(GTK_A11Y='atspi', GDK_BACKEND='x11', GDK_DEBUG='no-portals')
    child = None
    receipt = {'scope': 'real private AT-SPI toolkit dependency regression, not Tuna product qualification',
               'patched': patched, 'known_visible_names': NAMES, 'core_dump_limit': 0}
    try:
        with (artifacts / 'application.stderr').open('w') as stderr:
            child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--application'],
                                     env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=stderr, text=True)
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                if child.poll() is not None:
                    raise RuntimeError(f'GTK fixture exited before readiness: {child.returncode}')
                if select.select([child.stdout], [], [], .05)[0]:
                    ready = json.loads(child.stdout.readline())
                    if ready.get('ready') is True and ready.get('pid') == child.pid:
                        receipt['application'] = ready
                        break
            else:
                raise RuntimeError('actual GTK fixture did not report readiness within 10 seconds')
            maps = Path(f'/proc/{child.pid}/maps').read_text().splitlines()
            libraries = {line.split()[-1] for line in maps if '/libgtk-4.so.' in line}
            if len(libraries) != 1:
                raise RuntimeError('actual fixture does not map one unique GTK library')
            library = Path(libraries.pop()).resolve()
            receipt['runtime_library'] = str(library)
            receipt['runtime_sha256'] = hashlib.sha256(library.read_bytes()).hexdigest()
            notes = subprocess.check_output(['readelf', '-n', str(library)], text=True, timeout=10)
            receipt['runtime_build_ids'] = [line.split('Build ID:', 1)[1].strip() for line in notes.splitlines() if 'Build ID:' in line]
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            address = bus.call_sync('org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Bus', 'GetAddress',
                                    None, GLib.VariantType.new('(s)'), Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
            connection = Gio.DBusConnection.new_for_address_sync(
                address, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
                None, None)

            def call(destination, path, interface, method, parameters=None):
                return connection.call_sync(destination, path, interface, method, parameters, None,
                                            Gio.DBusCallFlags.NONE, 3000, None)

            def pid_of(owner):
                return call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                            'GetConnectionUnixProcessID', GLib.Variant('(s)', (owner,))).unpack()[0]

            owner = None
            deadline = time.monotonic() + 10
            while owner is None and time.monotonic() < deadline:
                names = call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'ListNames').unpack()[0]
                for name in names:
                    if not name.startswith(':'):
                        continue
                    try:
                        if pid_of(name) == child.pid:
                            call(name, ROOT_PATH, ACCESSIBLE, 'GetRole')
                            owner = name
                            break
                    except GLib.Error:
                        continue
                if owner is None:
                    time.sleep(.05)
            if owner is None:
                raise RuntimeError('owned real GTK AT-SPI application root did not register within 10 seconds')
            receipt['atspi_owner'] = {'name': owner, 'pid': pid_of(owner)}

            def property_value(destination, path, name):
                return call(destination, path, PROPERTIES, 'Get',
                            GLib.Variant('(ss)', (ACCESSIBLE, name))).unpack()[0]

            def wait_count(expected):
                deadline = time.monotonic() + 5
                while time.monotonic() < deadline:
                    if property_value(owner, ROOT_PATH, 'ChildCount') == expected:
                        return
                    time.sleep(.05)
                raise RuntimeError(f'actual visible child count did not become {expected}')

            def children():
                result = []
                for index, expected in enumerate(NAMES):
                    destination, path = call(owner, ROOT_PATH, ACCESSIBLE, 'GetChildAtIndex',
                                             GLib.Variant('(i)', (index,))).unpack()[0]
                    if pid_of(destination) != child.pid or path == '/org/a11y/atspi/null':
                        raise RuntimeError('valid child is not a reference owned by the actual fixture')
                    name = property_value(destination, path, 'Name')
                    if name != expected:
                        raise RuntimeError(f'actual child {index} name {name!r} differs from {expected!r}')
                    result.append({'index': index, 'name': name, 'path': path})
                return result

            def invalid(index):
                try:
                    call(owner, ROOT_PATH, ACCESSIBLE, 'GetChildAtIndex', GLib.Variant('(i)', (index,)))
                except GLib.Error as error:
                    remote = Gio.DBusError.is_remote_error(error)
                    invalid_argument = error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.INVALID_ARGUMENT)
                    if not remote or not invalid_argument:
                        raise RuntimeError(f'expected actual remote G_IO_ERROR_INVALID_ARGUMENT; got domain={error.domain} code={error.code}') from error
                    if child.poll() is not None:
                        raise RuntimeError('fixture exited after rejecting the invalid index')
                    return {'index': index, 'remote_error': Gio.DBusError.get_remote_error(error),
                            'domain': error.domain, 'code': error.code}
                raise RuntimeError('out-of-range child index returned a reference instead of InvalidArgument')

            wait_count(3)
            receipt['valid_before'] = children()
            if not patched:
                try:
                    call(owner, ROOT_PATH, ACCESSIBLE, 'GetChildAtIndex', GLib.Variant('(i)', (3,)))
                except GLib.Error:
                    pass
                status = child.wait(timeout=3)
                receipt['unpatched_exit'] = status
                if status != -signal.SIGSEGV:
                    raise RuntimeError(f'unpatched negative control did not reproduce SIGSEGV: {status}')
                receipt['unpatched_signal'] = 'SIGSEGV'
                # PyGObject relays GLib criticals as Python warnings, so match
                # the assertion text itself rather than a log-level prefix.
                assertions = [line.strip() for line in
                              (artifacts / 'application.stderr').read_text().splitlines()
                              if "assertion 'string != NULL' failed" in line
                              or "assertion 'g_variant_is_object_path (object_path)' failed" in line]
                if not any('g_variant_is_object_path:' in line for line in assertions) or \
                        not any('g_variant_new_object_path:' in line for line in assertions):
                    raise RuntimeError('stock negative control lacks the actual NULL object-path critical')
                receipt['unpatched_critical'] = assertions
            else:
                receipt['hidden_tail_invalid'] = invalid(3)
                receipt['valid_after_first_error'] = children()
                os.kill(child.pid, signal.SIGUSR1)
                wait_count(0)
                receipt['all_hidden_invalid'] = invalid(0)
                os.kill(child.pid, signal.SIGUSR2)
                wait_count(3)
                receipt['valid_after_remap'] = children()
                receipt['survived'] = child.poll() is None
            receipt['passed'] = True
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait(timeout=3)
        receipt['fixture_reaped'] = child is None or child.poll() is not None
        (artifacts / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps(receipt, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--application', action='store_true')
    parser.add_argument('--session', choices=('stock', 'patched'))
    parser.add_argument('--artifacts', type=Path)
    args = parser.parse_args()
    if args.application:
        return application()
    if args.artifacts is None:
        parser.error('--artifacts is required')
    if args.session:
        session(args.artifacts.resolve(), args.session == 'patched')
        return 0
    root = Path(os.environ['TUNA_CI_GTK_ROOT']).resolve()
    build_record = root / 'usr/local/share/doc/tuna-ci-gtk4-atspi-root/source-build-receipt.json'
    record = json.loads(build_record.read_text())
    if record['upstream_commit'] != '21d3eb76b68d6758122eddaf00b5823f9b2d7f34':
        raise RuntimeError('unexpected staged toolkit patch revision')
    args.artifacts.mkdir(parents=True, exist_ok=False)
    for mode in ('stock', 'patched'):
        env = dict(os.environ)
        if mode == 'stock':
            env.pop('LD_LIBRARY_PATH', None)
        else:
            env['LD_LIBRARY_PATH'] = str((root / record['runtime_relative_path']).parent)
        argv = ['dbus-run-session', '--', 'xvfb-run', '-a', sys.executable,
                str(Path(__file__).resolve()), '--session', mode,
                '--artifacts', str(args.artifacts.resolve() / mode)]
        child = subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, start_new_session=True)
        try:
            status = child.wait(timeout=45)
        finally:
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait(timeout=3)
        if status != 0:
            raise RuntimeError(f'{mode} real AT-SPI dependency control failed: {status}')
        receipt = json.loads((args.artifacts / mode / 'receipt.json').read_text())
        if mode == 'patched' and receipt['runtime_sha256'] != record['runtime_sha256']:
            raise RuntimeError('actual fixture did not load the staged proven toolkit bytes')
    print('GTK-ATSPI-ROOT pass: stock GTK reproduces the real crash; patched GTK rejects invalid indices and retains valid named children')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
