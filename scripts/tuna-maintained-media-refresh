#!/usr/bin/env python3
"""Promote only successful trusted main-CI media through an ordinary pull request."""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import subprocess
import sys
import zipfile
import tempfile

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
from maintained_media import confined, inventory, inventory_rows, manifest_name, required_source_inputs

REPOSITORY = 'tuna-os/tuna-desktop'
MAX_ARCHIVE = 512 * 1024 * 1024
MAX_EXPANDED = 4 * 1024 * 1024 * 1024


def require(value, message):
    if not value:
        raise ValueError(message)


class ArtifactUnavailable(ValueError):
    """No retained original evidence exists; this never authorizes reuse."""


def fetch_source_commits(sources):
    commits = set()
    for source in sources:
        for key in ('built_commit', 'capture_commit'):
            commit = source.get(key, '')
            require(isinstance(commit, str) and re.fullmatch('[0-9a-f]{40}', commit),
                    'missing strict actual build/capture Git commit')
            commits.add(commit)
    missing = [commit for commit in sorted(commits)
               if subprocess.run(['git', 'cat-file', '-e', commit + '^{commit}'], cwd=ROOT,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode]
    if missing:
        require(command('git', 'remote', 'get-url', 'origin') in {
            'https://github.com/tuna-os/tuna-desktop.git', 'https://github.com/tuna-os/tuna-desktop',
            'git@github.com:tuna-os/tuna-desktop.git'}, 'source origin must be the trusted repository')
        command('git', 'fetch', '--no-tags', 'origin', *missing)


def command(*args, **kwargs):
    return subprocess.check_output(list(map(str, args)), cwd=ROOT, timeout=kwargs.pop('timeout', 60), **kwargs).decode().strip()


def api(path):
    return json.loads(command('gh', 'api', 'repos/' + REPOSITORY + '/' + path))


def inspect_run(run, workflow_id, run_id, attempt, head):
    require(run.get('id') == run_id and run.get('run_attempt') == attempt
            and run.get('workflow_id') == workflow_id and run.get('event') == 'push'
            and run.get('head_branch') == 'main' and run.get('head_sha') == head
            and run.get('status') == 'completed' and run.get('conclusion') == 'success'
            and run.get('repository', {}).get('full_name') == REPOSITORY
            and run.get('head_repository', {}).get('full_name') == REPOSITORY,
            'source run is not the exact successful trusted main push and attempt')


def extract_selected(archive, target, allowlist):
    """Validate the entire ZIP before extracting only fixed non-executable media."""
    target = Path(target)
    require(not target.exists(), 'refusing an existing artifact extraction directory')
    with zipfile.ZipFile(archive) as source:
        seen, expanded, selected = set(), 0, []
        for member in source.infolist():
            path = PurePosixPath(member.filename)
            require(member.filename and '\\' not in member.filename and '\x00' not in member.filename
                    and path.parts and not path.is_absolute()
                    and str(path) == member.filename.rstrip('/')
                    and all(part not in ('', '.', '..') for part in path.parts)
                    and ':' not in path.parts[0], 'unsafe artifact ZIP member path')
            require(member.filename not in seen, 'duplicate artifact ZIP member')
            seen.add(member.filename)
            mode = member.external_attr >> 16
            require(not stat.S_ISLNK(mode) and (not stat.S_IFMT(mode) or stat.S_ISREG(mode)
                    or member.is_dir() and stat.S_ISDIR(mode)), 'non-regular artifact ZIP member')
            expanded += member.file_size
            require(expanded <= MAX_EXPANDED and member.file_size <= MAX_ARCHIVE,
                    'artifact ZIP expands beyond its finite bound')
            if not member.is_dir() and member.filename in allowlist:
                selected.append(member)
        target.mkdir(parents=True, mode=0o700)
        for member in selected:
            output = target.joinpath(*PurePosixPath(member.filename).parts)
            output.parent.mkdir(parents=True, exist_ok=True)
            with source.open(member) as stream, output.open('xb') as destination:
                while chunk := stream.read(1024 * 1024):
                    destination.write(chunk)
            output.chmod(0o600)


def latest_is(head):
    require(api('git/ref/heads/main')['object']['sha'] == head,
            'STALE: newer main exists; no older capture may overwrite or claim current media')


def generated_paths(mapping):
    paths = {destination for rows in mapping.values() for _, destination in rows}
    return paths | {manifest_name(kind) for kind in mapping}


def download_artifacts(run_id, attempt, output, mapping, *, vm_tour_only=False):
    """Authenticate exact GitHub-uploaded bytes before admitting any media."""
    artifacts, page = [], 1
    while True:
        result = api('actions/runs/%d/artifacts?per_page=100&page=%d' % (run_id, page))
        artifacts.extend(result['artifacts'])
        require(len(artifacts) <= 1000, 'artifact listing bound')
        if len(artifacts) >= result['total_count']:
            break
        require(bool(result['artifacts']), 'incomplete artifact listing')
        page += 1
    roots, artifact_receipts = {}, {}
    sources = {
        'gtk-shell': ({name for name, _ in mapping['gtk-walkthrough']}
                      | {'assertions.txt', 'media-source.json', 'media-capture.json', 'media-receipt.json'}),
        'marlin-vm': {'manifest.json', 'repeat-manifest.json', 'strip-image.json', 'media-source.json',
                      'media-receipt.json', 'native-base/index.json', 'native-base/platform-cosign.json',
                      'native-base/platform-verification.json'},
        'tuna-tour': ({name.removeprefix('tour/') for name, _ in mapping['vm-tour']}
                      | {'tuna-tour.webm', 'capture-timing.json'}),
        'overview-demo': ({name for name, _ in mapping['overview-demo']}
                          | {'overview-demo.raw.mp4', 'overview-demo-actions.json', 'assertions.txt',
                             'media-source.json', 'media-receipt.json'}),
    }
    if vm_tour_only:
        sources = {name: sources[name] for name in ('marlin-vm', 'tuna-tour')}
    for name, allowlist in sources.items():
        members = [row for row in artifacts if row.get('name') == name and not row.get('expired')]
        if not members:
            raise ArtifactUnavailable('missing/expired exact-run artifact: ' + name)
        require(len(members) == 1, 'missing or ambiguous exact-run artifact: ' + name)
        member = members[0]
        require(member.get('workflow_run', {}).get('id') == run_id
                and 0 < member.get('size_in_bytes', 0) <= MAX_ARCHIVE,
                'artifact run identity/size mismatch')
        expected_digest = member.get('digest', '')
        require(re.fullmatch('sha256:[0-9a-f]{64}', expected_digest), 'artifact lacks actual upload digest')
        artifact_receipts[name] = {'id': member['id'], 'digest': expected_digest,
                                  'run_id': run_id, 'run_attempt': attempt}
        archive = output / (name + '.zip')
        with archive.open('xb') as stream:
            subprocess.run(['gh', 'api', 'repos/' + REPOSITORY + '/actions/artifacts/%d/zip' % member['id']],
                           cwd=ROOT, stdout=stream, check=True, timeout=180)
        require(archive.stat().st_size <= MAX_ARCHIVE, 'actual archive exceeds bound')
        hasher = hashlib.sha256()
        with archive.open('rb') as stream:
            while chunk := stream.read(1024 * 1024):
                hasher.update(chunk)
        require('sha256:' + hasher.hexdigest() == expected_digest, 'actual archive differs from upload digest')
        target = output / name
        extract_selected(archive, target, allowlist)
        roots[name] = target
    roots['tuna-tour'].rename(roots['marlin-vm'] / 'tour')
    return roots, artifact_receipts


def authenticated_freshness(roots, pins, destination=None):
    subprocess.run([sys.executable, str(ROOT / 'scripts/lib/maintained_media.py'),
                    'freshness', *pins, '--dest', str(ROOT if destination is None else destination),
                    *[item for name in ('gtk-shell', 'marlin-vm', 'overview-demo')
                      for item in ('--source-artifact', str(roots[name]))]],
                   cwd=ROOT, check=True, timeout=600)


def admit_current_capture(roots, pins, staging):
    """Validate real current-run bytes even when exact canonical image reuse is possible."""
    subprocess.run([sys.executable, str(ROOT / 'scripts/lib/maintained_media.py'),
                    'intake', str(roots['gtk-shell']), str(roots['marlin-vm']),
                    str(roots['overview-demo']), *pins, '--dest', str(staging)],
                   cwd=ROOT, check=True, timeout=600)
    authenticated_freshness(roots, pins, staging)


def verify_canonical():
    mapping = inventory()
    documents = [json.loads((ROOT / manifest_name(kind)).read_bytes())
                 for kind in ('gtk-walkthrough', 'vm-tour', 'overview-demo')]
    receipts = [document['receipt'] for document in documents]
    original = receipts[0]
    source, run = original['source'], original['run']
    require(all(row['source']['capture_commit'] == source['capture_commit']
                and row['source']['capture_tree'] == source['capture_tree']
                and row['source']['merged_commit'] == source['merged_commit']
                and row['source']['required_source_inputs_sha256'] == source['required_source_inputs_sha256']
                and row['run'] == run for row in receipts), 'mixed canonical media capture identities')
    workflow = api('actions/workflows/ci.yml')
    require(workflow.get('path') == '.github/workflows/ci.yml' and workflow.get('name') == 'ci',
            'unexpected source workflow identity')
    inspect_run(api('actions/runs/' + run['id']), workflow['id'], int(run['id']),
                int(run['attempt']), source['capture_commit'])
    fetch_source_commits([row['source'] for row in receipts])
    latest = api('git/ref/heads/main')['object']['sha']
    command('git', 'fetch', '--no-tags', 'origin', latest)
    drift = set(filter(None, command('git', 'diff', '--no-renames', '--name-only', '-z',
                                    source['capture_commit'], latest).split('\0')))
    require(drift <= generated_paths(mapping), 'STALE: canonical media source differs from actual current main inputs')
    require(command('git', 'rev-parse', source['capture_commit'] + '^{tree}') == source['capture_tree'],
            'canonical capture tree is not the actual producer Git commit tree')
    image = next(row['image'] for row in receipts if row['bundle'] == 'vm-tour')
    pins = ['--run-id', run['id'], '--attempt', run['attempt'],
            '--expect-merge', source['merged_commit'], '--expect-head', source['capture_commit'],
            '--expect-tree', source['capture_tree'], '--expect-source-inputs', required_source_inputs(ROOT),
            '--expect-image', image['id'], '--expect-package', image['package_sha256']]
    pins += [item for row in receipts for item in ('--bundle', row['bundle'])]
    # PR-local manifests may name a genuine run while forging all local hashes.
    # Independently retrieve and replay that run's authenticated original bytes.
    with tempfile.TemporaryDirectory(prefix='tuna-media-verify-') as directory:
        roots, _ = download_artifacts(int(run['id']), int(run['attempt']), Path(directory), mapping)
        authenticated_freshness(roots, pins)
    return documents


def same_native_product(image, documents, current_base_index):
    document = next(row for row in documents if row['receipt']['bundle'] == 'vm-tour')
    original = json.loads(base64.b64decode(document['evidence']['image_receipt'], validate=True))
    # Selected ELFs cannot prove that GTK/Mesa/fonts or other runtime inputs
    # stayed unchanged. Reuse only the exact authenticated final immutable
    # image/package and the independently current requested base pair.
    require(re.fullmatch('sha256:[0-9a-f]{64}', current_base_index or ''),
            'actual current requested native base index required')
    return (original['image_id'] == image['image_id']
            and original['package_sha256'] == image['package_sha256']
            and original['base_image'] == image['base_image']
            and original['member_sha256'] == image['member_sha256']
            and 'sha256:' + document['receipt']['base_verification']['index']['sha256'] == current_base_index)


def canonical_changes(base):
    require(re.fullmatch('[0-9a-f]{40}', base or ''), 'exact canonical comparison base required')
    protected = generated_paths(inventory())
    inventory_path = 'scripts/lib/maintained-media.tsv'
    if command('git', 'ls-tree', '--name-only', base, '--', inventory_path):
        protected |= generated_paths(inventory_rows(command('git', 'show', base + ':' + inventory_path)))
    changed = set(filter(None, command('git', 'diff', '--no-renames', '--name-only', '-z', base + '...HEAD').split('\0')))
    return changed & protected


def verify_if_changed(base):
    if not base:
        base = api('git/ref/heads/main')['object']['sha']
        command('git', 'fetch', '--no-tags', 'origin', base)
    changed = canonical_changes(base)
    if changed:
        verify_canonical()
    return bool(changed)


def main():
    if sys.argv[1:] == ['--verify-canonical']:
        verify_canonical()
        return
    if len(sys.argv) == 3 and sys.argv[1] == '--verify-if-changed':
        verify_if_changed(sys.argv[2])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run-id', required=True, type=int)
    parser.add_argument('--attempt', required=True, type=int)
    parser.add_argument('--source-sha', required=True)
    parser.add_argument('--output', required=True, type=Path)
    parser.add_argument('--create-pr', action='store_true')
    args = parser.parse_args()
    require(args.run_id > 0 and args.attempt > 0 and re.fullmatch('[0-9a-f]{40}', args.source_sha),
            'exact source/run/attempt required')
    require(not args.output.exists(), 'fresh owned output directory required')
    require(command('git', 'rev-parse', 'HEAD') == args.source_sha
            and not command('git', 'status', '--porcelain', '--untracked-files=no'),
            'refresh checkout must be the exact clean captured main source')
    require(command('git', 'remote', 'get-url', 'origin') in {
        'https://github.com/tuna-os/tuna-desktop.git', 'https://github.com/tuna-os/tuna-desktop',
        'git@github.com:tuna-os/tuna-desktop.git'}, 'refresh origin must be the trusted source repository')
    workflow = api('actions/workflows/ci.yml')
    require(workflow.get('path') == '.github/workflows/ci.yml' and workflow.get('name') == 'ci',
            'unexpected source workflow identity')
    run = api('actions/runs/' + str(args.run_id))
    inspect_run(run, workflow['id'], args.run_id, args.attempt, args.source_sha)
    latest_is(args.source_sha)
    args.output.mkdir(parents=True, mode=0o700)
    mapping = inventory()
    roots, artifact_receipts = download_artifacts(args.run_id, args.attempt, args.output, mapping)
    fetch_source_commits([json.loads((roots[name] / 'media-source.json').read_bytes())
                          for name in ('gtk-shell', 'marlin-vm', 'overview-demo')])
    image = json.loads((roots['marlin-vm'] / 'strip-image.json').read_bytes())
    source_inputs = required_source_inputs(ROOT)
    pins = ['--run-id', str(args.run_id), '--attempt', str(args.attempt),
            '--expect-merge', args.source_sha, '--expect-head', args.source_sha,
            '--expect-tree', command('git', 'rev-parse', 'HEAD^{tree}'),
            '--expect-source-inputs', source_inputs,
            '--expect-image', image['image_id'], '--expect-package', image['package_sha256']]
    bundles = [item for kind in ('gtk-walkthrough', 'vm-tour', 'overview-demo') for item in ('--bundle', kind)]
    generated = generated_paths(mapping)
    changed_source = set(filter(None, command('git', 'diff-tree', '--no-renames', '--no-commit-id', '--name-only',
                                             '-z', '-r', 'HEAD^', 'HEAD').split('\0')))
    generated_only = changed_source <= generated
    media_only = False
    prior_unavailable = None
    # Never overwrite old canonical bytes before independently authenticating
    # them. Expired/missing evidence earns no reuse: genuinely validated new
    # current-run media may replace it only through an ordinary fresh PR.
    if generated_only:
        try:
            current_base_index = 'sha256:' + hashlib.sha256(
                (roots['marlin-vm'] / 'native-base/index.json').read_bytes()).hexdigest()
            media_only = same_native_product(image, verify_canonical(), current_base_index)
        except (ArtifactUnavailable, FileNotFoundError) as error:
            prior_unavailable = str(error)
    latest_is(args.source_sha)
    staging = args.output / 'current-capture'
    admit_current_capture(roots, [*bundles, *pins], staging)
    if not media_only:
        for name in sorted(generated):
            source, destination = confined(staging, name), confined(ROOT, name)
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source, destination)
    result = {'run_id': args.run_id, 'run_attempt': args.attempt, 'source_commit': args.source_sha,
              'source_inputs_sha256': source_inputs, 'image_id': image['image_id'],
              'package_sha256': image['package_sha256'], 'canonical_paths': sorted(generated),
              'artifacts': artifact_receipts,
              'historical_receipts_overwritten': False, 'installed_signed_release_qualified': False,
              'prior_canonical_unavailable': prior_unavailable,
              'validated_current_capture': str(staging),
              'status': 'validated-current-run-media; not yet normal-merged canonical media'}
    if media_only:
        result['status'] = ('validated actual current-run capture and authenticated canonical media; '
                            'exact final immutable image/package/current-base identity retained; no recursive PR')
    elif args.create_pr:
        latest_is(args.source_sha)
        branch = 'automation/maintained-media-%d-%d' % (args.run_id, args.attempt)
        command('git', 'switch', '-c', branch)
        command('git', 'config', 'user.name', 'github-actions[bot]')
        command('git', 'config', 'user.email', '41898282+github-actions[bot]@users.noreply.github.com')
        command('git', 'add', '--', *sorted(generated))
        require(bool(command('git', 'diff', '--cached', '--name-only')), 'no canonical media changes to propose')
        command('git', 'commit', '-m', 'docs: refresh maintained media for ' + args.source_sha[:12])
        command('gh', 'auth', 'setup-git', '--hostname', 'github.com')
        latest_is(args.source_sha)
        command('git', 'push', 'origin', 'HEAD:refs/heads/' + branch, timeout=180)
        body = ('Real current-run media from successful trusted main CI %d, attempt %d, source %s. '
                'Actual build/image/package/source-input identities and real decoded UI receipts are retained. '
                'Only inventoried maintained media and their new provenance manifests change; dated diagnostics '
                'and versioned release media remain immutable. This PR uses the ordinary required checks/queue. '
                'A subsequent successful main CI is still required before claiming current merged qualification.'
                % (args.run_id, args.attempt, args.source_sha))
        result['pull_request'] = command('gh', 'pr', 'create', '--repo', REPOSITORY, '--base', 'main',
             '--head', branch, '--title', 'docs: refresh maintained screenshots and overview video', '--body', body)
        command('gh', 'workflow', 'run', 'ci.yml', '--repo', REPOSITORY, '--ref', branch)
    (args.output / 'refresh-result.json').write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
