#!/usr/bin/env python3
"""Verify bundled or staged GNOME51 cursor data against its upstream manifest."""
import argparse
import hashlib
import json
import math
from pathlib import Path
import re


def verify(root):
    root = root.resolve(strict=True)
    manifest = json.loads((root / "UPSTREAM.json").read_text())
    assert manifest["upstream"] == "https://github.com/GNOME/gnome-shell"
    assert manifest["tag"] == "51.0"
    assert re.fullmatch(r"[0-9a-f]{40}", manifest["source_revision"])
    assert re.fullmatch(r"[0-9a-f]{64}", manifest["archive_sha256"])
    entries = manifest["entries"]
    assert len(entries) == 188
    paths = set()
    metadata_count = 0
    svg_count = 0
    frame_count = 0
    for entry in entries:
        relative = Path(entry["path"])
        assert not relative.is_absolute() and ".." not in relative.parts
        assert entry["path"] not in paths
        paths.add(entry["path"])
        path = root / relative
        assert path.resolve(strict=True).is_relative_to(root)
        if "symlink" in entry:
            assert path.is_symlink() and str(path.readlink()) == entry["symlink"]
            assert path.resolve().is_dir()
            continue
        assert path.is_file() and not path.is_symlink()
        assert not path.stat().st_mode & 0o022
        assert hashlib.sha256(path.read_bytes()).hexdigest() == entry["sha256"], path
        if path.suffix == ".svg":
            svg_count += 1
        if path.name != "metadata.json":
            continue
        metadata_count += 1
        frames = json.loads(path.read_text())
        assert isinstance(frames, list) and 0 < len(frames) <= 1024
        frame_count += len(frames)
        for frame in frames:
            filename = Path(frame["filename"])
            assert not filename.is_absolute() and ".." not in filename.parts
            assert (path.parent / filename).resolve(strict=True).is_relative_to(root)
            assert (path.parent / filename).is_file()
            nominal = frame["nominal_size"]
            assert isinstance(nominal, (int, float)) and math.isfinite(nominal) and nominal > 0
            for key in ("hotspot_x", "hotspot_y"):
                assert math.isfinite(frame.get(key, 0))
            delay = frame.get("delay", 0)
            assert isinstance(delay, int) and 0 <= delay <= 0xffffffff
    assert svg_count == 151 and metadata_count == 35 and frame_count == 151
    for name in ("LICENSE-MIT", "UPSTREAM-COPYING", "README", "index.theme"):
        assert (root / name).is_file()
    return {"scope": "data integrity and metadata; not rendered/native/installed-image parity",
            "source_revision": manifest["source_revision"], "entries": len(entries),
            "shapes": metadata_count, "svg_frames": svg_count, "verified": True}


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", type=Path)
    args = parser.parse_args()
    try:
        print(json.dumps(verify(args.root), sort_keys=True))
    except (AssertionError, OSError, ValueError, KeyError, TypeError) as error:
        parser.exit(1, f"cursor asset verification failed: {error}\n")
