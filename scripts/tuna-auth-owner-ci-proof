#!/usr/bin/env bash
# Source/runtime proof only: no installed/PAM retirement qualification.
set -euo pipefail
out=${1:?owned artifact directory required}
mkdir -p "$out"
git rev-parse HEAD > "$out/source.txt"
git rev-parse --show-toplevel > "$out/root.txt"
git diff --quiet
git diff --cached --quiet
sha256sum Cargo.lock crates/compositor/Cargo.toml scripts/lib/auth-owner-admission.py scripts/tuna-auth-owner-ci-proof crates/compositor/src/auth_owner.rs crates/compositor/src/control.rs crates/compositor/src/runtime.rs crates/compositor/src/sleep.rs crates/compositor/tests/auth_owner_runtime.rs crates/compositor/examples/native-auth-owner-probe.rs > "$out/source-sha256.txt"
cargo metadata --no-deps --format-version=1 > "$out/metadata.json"
cargo test -p tuna-compositor --test auth_owner_runtime --no-run --message-format=json > "$out/build.json"
cargo build -p tuna-compositor --example native-auth-owner-probe --message-format=json > "$out/probe-build.json"
python3 - "$out" <<'PY'
import hashlib,importlib.util,json,pathlib,sys
sys.dont_write_bytecode=True
out=pathlib.Path(sys.argv[1]); root=pathlib.Path((out/'root.txt').read_text().strip())
spec=importlib.util.spec_from_file_location('auth_owner_admission',root/'scripts/lib/auth-owner-admission.py')
matcher=importlib.util.module_from_spec(spec); spec.loader.exec_module(matcher)
selected=matcher.select_inputs(out)
inputs={p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest() for p in [selected['test'],selected['compositor'],selected['probe']]}
receipt={'source':(out/'source.txt').read_text().strip(),'executables':inputs,**selected,
         'build_sha256':hashlib.sha256((out/'build.json').read_bytes()).hexdigest(),
         'metadata_sha256':hashlib.sha256((out/'metadata.json').read_bytes()).hexdigest(),
         'probe_build_sha256':hashlib.sha256((out/'probe-build.json').read_bytes()).hexdigest()}
(out/'binary-receipt.json').write_text(json.dumps(receipt,indent=2)+'\n')
(out/'test-executable').write_text(selected['test']+'\n')
(out/'probe-executable').write_text(selected['probe']+'\n')
PY
IFS= read -r test_executable < "$out/test-executable"
Xvfb -displayfd 3 -screen 0 800x600x24 -nolisten tcp 3>"$out/display" >"$out/xvfb.log" 2>&1 &
xvfb_pid=$!
trap 'kill "$xvfb_pid" 2>/dev/null || true; wait "$xvfb_pid" 2>/dev/null || true' EXIT
for _ in $(seq 1 50); do
    [ -s "$out/display" ] && break
    kill -0 "$xvfb_pid"
    sleep 0.1
done
IFS= read -r display_num < "$out/display"
case "$display_num" in ''|*[!0-9]*) exit 1 ;; esac
DISPLAY=":$display_num" TUNA_REQUIRE_AUTH_OWNER_RUNTIME=1 TUNA_AUTH_OWNER_ARTIFACTS="$out/runtime" \
    timeout --kill-after=3s 45s \
    "$test_executable" --exact actual_runtime_owns_delayed_greetd_result_and_lock_epochs --nocapture 2>&1 | tee "$out/test.log"
grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored;' "$out/test.log"
grep -q '^auth owner compositor runtime receipt: ' "$out/test.log"
IFS= read -r probe_executable < "$out/probe-executable"
DISPLAY=":$display_num" TUNA_REQUIRE_AUTH_OWNER_RUNTIME=1 TUNA_AUTH_OWNER_ARTIFACTS="$out/runtime-epoch" TUNA_AUTH_OWNER_PROBE_BIN="$probe_executable" \
    timeout --kill-after=3s 45s \
    "$test_executable" --exact actual_runtime_epoch_invalidation_and_public_sync_unlock --nocapture 2>&1 | tee "$out/test-epoch.log"
grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored;' "$out/test-epoch.log"
grep -q '^auth owner probe runtime receipt: ' "$out/test-epoch.log"
python3 - "$out" <<'PY'
import hashlib,importlib.util,json,pathlib,sys
sys.dont_write_bytecode=True
out=pathlib.Path(sys.argv[1]); root=pathlib.Path((out/'root.txt').read_text().strip())
spec=importlib.util.spec_from_file_location('auth_owner_admission',root/'scripts/lib/auth-owner-admission.py')
matcher=importlib.util.module_from_spec(spec); spec.loader.exec_module(matcher)
selected=matcher.select_inputs(out)
r=json.loads((out/'binary-receipt.json').read_text())
for key in ['test','compositor','probe','package_id','root']:assert selected[key]==r[key],'Cargo selection changed'
assert hashlib.sha256((out/'build.json').read_bytes()).hexdigest()==r['build_sha256'],'build metadata changed'
assert hashlib.sha256((out/'metadata.json').read_bytes()).hexdigest()==r['metadata_sha256'],'package metadata changed'
assert hashlib.sha256((out/'probe-build.json').read_bytes()).hexdigest()==r['probe_build_sha256'],'probe build metadata changed'
for path,wanted in r['executables'].items():assert hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()==wanted,'binary changed'
receipt=json.loads((out/'runtime/success.json').read_text());assert receipt['late_closed_origin_success_denied'] and receipt['fresh_origin_success']
lines=[l.removeprefix('auth owner compositor sha256: ') for l in (out/'test.log').read_text().splitlines() if l.startswith('auth owner compositor sha256: ')]
assert len(lines)==1 and lines[0] == r['executables'][r['compositor']],'actual compositor mismatched'
epoch_receipt=json.loads((out/'runtime-epoch/success.json').read_text())
for key in ['late_epoch_success_denied','busy_public_sync_denied','fresh_origin_success','public_sync_success']:assert epoch_receipt[key] is True
probe_lines=[l.removeprefix('auth owner probe sha256: ') for l in (out/'test-epoch.log').read_text().splitlines() if l.startswith('auth owner probe sha256: ')]
assert len(probe_lines)==1 and probe_lines[0]==r['executables'][r['probe']],'actual Runtime probe mismatched'

PY
sha256sum --check "$out/source-sha256.txt"
git diff --quiet
git diff --cached --quiet
[ "$(git rev-parse HEAD)" = "$(cat "$out/source.txt")" ]
