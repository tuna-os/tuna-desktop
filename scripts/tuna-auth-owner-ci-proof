#!/usr/bin/env bash
# Source/runtime proof only: no installed/PAM retirement qualification.
set -Eeuo pipefail
out=${1:?owned artifact directory required}
mkdir -p "$out"
pretest_phase=source_admission
pretest_failure() {
    local status=$?
    printf '{"phase":"%s","line":%s,"status":%s}\n' "$pretest_phase" "$1" "$status" > "$out/pretest-failure.json"
    return "$status"
}
trap 'pretest_failure "$LINENO"' ERR
git rev-parse HEAD > "$out/source.txt"
git rev-parse --show-toplevel > "$out/root.txt"
git diff --quiet
git diff --cached --quiet
sha256sum Cargo.lock crates/compositor/Cargo.toml scripts/lib/auth-owner-admission.py scripts/lib/auth-display-readiness.py scripts/tuna-auth-owner-ci-proof crates/compositor/src/auth_owner.rs crates/compositor/src/main.rs crates/compositor/src/lib.rs crates/compositor/src/control.rs crates/compositor/src/runtime.rs crates/compositor/src/runtime/auth.rs crates/compositor/src/sleep.rs crates/compositor/src/pam.rs crates/compositor/src/pam_backend.rs crates/compositor/src/pam_helper.rs crates/compositor/src/unlock.rs crates/compositor/tests/fixtures/pam_conversation.c crates/compositor/tests/auth_owner_runtime.rs crates/compositor/examples/native-auth-owner-probe.rs > "$out/source-sha256.txt"
cargo metadata --locked --no-deps --format-version=1 > "$out/metadata.json"
pretest_phase=test_build
cargo test --locked -p tuna-compositor --test auth_owner_runtime --no-run --message-format=json > "$out/build.json"
pretest_phase=probe_build
cargo build --locked -p tuna-compositor --example native-auth-owner-probe --message-format=json > "$out/probe-build.json"
python3 - "$out" <<'PY'
import hashlib,importlib.util,json,pathlib,sys
sys.dont_write_bytecode=True
out=pathlib.Path(sys.argv[1]); root=pathlib.Path((out/'root.txt').read_text().strip())
spec=importlib.util.spec_from_file_location('auth_owner_admission',root/'scripts/lib/auth-owner-admission.py')
matcher=importlib.util.module_from_spec(spec); spec.loader.exec_module(matcher)
selected=matcher.select_inputs(out)
inputs={p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest() for p in [selected['test'],selected['compositor'],selected['probe']]}
receipt={'source':(out/'source.txt').read_text().strip(),'executables':inputs,**selected,
         'build_sha256':hashlib.sha256((out/'build.json').read_bytes()).hexdigest(),
         'metadata_sha256':hashlib.sha256((out/'metadata.json').read_bytes()).hexdigest(),
         'probe_build_sha256':hashlib.sha256((out/'probe-build.json').read_bytes()).hexdigest()}
(out/'binary-receipt.json').write_text(json.dumps(receipt,indent=2)+'\n')
(out/'test-executable').write_text(selected['test']+'\n')
(out/'probe-executable').write_text(selected['probe']+'\n')
PY
pretest_phase=test_executable_admission
IFS= read -r test_executable < "$out/test-executable"
pretest_phase=xvfb_launch
: > "$out/display"
Xvfb -displayfd 3 -screen 0 800x600x24 -nolisten tcp 3>"$out/display" >"$out/xvfb.log" 2>&1 &
xvfb_pid=$!
trap 'kill "$xvfb_pid" 2>/dev/null || true; wait "$xvfb_pid" 2>/dev/null || true' EXIT
pretest_phase=display_admission
python3 scripts/lib/auth-display-readiness.py "$out/display" "$xvfb_pid" "$out/display-readiness.json" > "$out/display-admitted"
IFS= read -r display_num < "$out/display-admitted"
case "$display_num" in ''|*[!0-9]*) exit 1 ;; esac
trap - ERR
IFS= read -r probe_executable < "$out/probe-executable"
DISPLAY=":$display_num" TUNA_REQUIRE_AUTH_OWNER_RUNTIME=1 TUNA_AUTH_OWNER_ARTIFACTS="$out/runtime-epoch" TUNA_AUTH_OWNER_PROBE_BIN="$probe_executable" \
    timeout --kill-after=3s 45s \
    "$test_executable" --exact actual_runtime_epoch_invalidation_and_public_sync_unlock --nocapture 2>&1 | tee "$out/test-epoch.log"
grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored;' "$out/test-epoch.log"
grep -q '^auth owner probe runtime receipt: ' "$out/test-epoch.log"
grep -Fxq 'auth owner runtime environment preserved with concurrent libc getenv' "$out/runtime-epoch/compositor.log"
DISPLAY=":$display_num" TUNA_REQUIRE_AUTH_OWNER_RUNTIME=1 TUNA_AUTH_OWNER_ARTIFACTS="$out/runtime-pam" \
    timeout --kill-after=3s 45s \
    "$test_executable" --exact actual_main_runtime_private_pam_retirement_and_held_self --nocapture 2>&1 | tee "$out/test-pam.log"
grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored;' "$out/test-pam.log"
grep -q '^auth owner pam runtime receipt: ' "$out/test-pam.log"
DISPLAY=":$display_num" TUNA_REQUIRE_AUTH_OWNER_RUNTIME=1 TUNA_AUTH_OWNER_ARTIFACTS="$out/runtime-conversation" \
    timeout --kill-after=3s 45s \
    "$test_executable" --exact actual_main_runtime_pam_conversation_relay --nocapture 2>&1 | tee "$out/test-conversation.log"
grep -Eq '^test result: ok\. 1 passed; 0 failed; 0 ignored;' "$out/test-conversation.log"
grep -q '^auth owner conversation runtime receipt: ' "$out/test-conversation.log"
python3 - "$out" <<'PY'
import hashlib,importlib.util,json,pathlib,sys
sys.dont_write_bytecode=True
out=pathlib.Path(sys.argv[1]); root=pathlib.Path((out/'root.txt').read_text().strip())
spec=importlib.util.spec_from_file_location('auth_owner_admission',root/'scripts/lib/auth-owner-admission.py')
matcher=importlib.util.module_from_spec(spec); spec.loader.exec_module(matcher)
selected=matcher.select_inputs(out)
r=json.loads((out/'binary-receipt.json').read_text())
for key in ['test','compositor','probe','package_id','root']:assert selected[key]==r[key],'Cargo selection changed'
assert hashlib.sha256((out/'build.json').read_bytes()).hexdigest()==r['build_sha256'],'build metadata changed'
assert hashlib.sha256((out/'metadata.json').read_bytes()).hexdigest()==r['metadata_sha256'],'package metadata changed'
assert hashlib.sha256((out/'probe-build.json').read_bytes()).hexdigest()==r['probe_build_sha256'],'probe build metadata changed'
for path,wanted in r['executables'].items():assert hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()==wanted,'binary changed'
epoch_receipt=json.loads((out/'runtime-epoch/success.json').read_text())
for key in ['stale_epoch_attempt_denied_retired','busy_other_origin_denied','busy_public_sync_denied','fresh_origin_success','public_sync_success']:assert epoch_receipt[key] is True
probe_lines=[l.removeprefix('auth owner probe sha256: ') for l in (out/'test-epoch.log').read_text().splitlines() if l.startswith('auth owner probe sha256: ')]
assert len(probe_lines)==1 and probe_lines[0]==r['executables'][r['probe']],'actual Runtime probe mismatched'
pam_receipt=json.loads((out/'runtime-pam/success.json').read_text())
for key in ['closed_origin_canceled_retired','origin_loss_wakes_private_pam_without_fixture_release','fresh_origin_success','held_self_path_replaced']:assert pam_receipt[key] is True
assert pam_receipt['compositor_sha256']==r['executables'][r['compositor']],'actual PAM main image differs'
conversation=json.loads((out/'runtime-conversation/success.json').read_text())
for key in ['fingerprint_unavailable_denied','second_password_conversation_denied','stale_sequence_dropped','distinct_answers_per_question','info_and_error_relayed','wrong_pin_denied_with_problem','cancel_denied_silently','fresh_answers_unlock']:assert conversation[key] is True,key
assert conversation['compositor_sha256']==r['executables'][r['compositor']],'actual conversation main image differs'
pam_lines=[l.removeprefix('auth owner pam sha256: ') for l in (out/'test-pam.log').read_text().splitlines() if l.startswith('auth owner pam sha256: ')]
assert len(pam_lines)==1 and pam_lines[0]==r['executables'][r['compositor']],'PAM source admission differs'


PY
sha256sum --check "$out/source-sha256.txt"
git diff --quiet
git diff --cached --quiet
[ "$(git rev-parse HEAD)" = "$(cat "$out/source.txt")" ]
