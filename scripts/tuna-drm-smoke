#!/bin/sh
# tuna-drm-smoke — hardware-session smoke test on a virtual KMS device (#52).
#
# Usage:
#   scripts/tuna-drm-smoke [--artifacts DIR] [--seconds N]
#
# Loads vkms (a kernel virtual GPU with a connected virtual output), runs a
# private seatd, and starts tuna-compositor --backend drm on that device
# with its supervised shell: the same code path a GDM or TTY login takes,
# minus real hardware. Asserts on state, not pixels:
#   D-OUTPUT   the backend lit the vkms connector
#   D-SHELL    the shell connected over the control socket (introspection)
#   D-IDLE     an unchanged scene stops redundant scanout submissions
#   D-FRAMES   a real active Wayland client receives 240 page-flip presentations
#   D-SCALE    a GNOME monitors.xml giving the connector scale 2 is
#              honored: logical layout at half the mode size, frames flip
#   D-MODES    GNOME Settings' DisplayConfig lists the connector's modes;
#              ApplyMonitorsConfig switches the CRTC to another mode (the
#              kernel reports it, frames keep flipping) and an unconfirmed
#              persistent change reverts after Mutter's 20 s (#340)
#   D-COLORD   a real colord on a private system bus gets Mutter's device
#              (id, metadata) and its generated sRGB profile as default
#   D-GAMMA    the kernel's GAMMA_LUT, read back with KMS ioctls, is the
#              assigned profile's ramp, Night Light's 3000 K blackbody, and
#              an imported vcgt profile times 3000 K (P-DS-03, #341)
#   D-CALIBRATE CalibrateMonitor/SetCrtcGammaLut program a raw ramp; Stop
#              and a vanished caller both restore the white point
#   D-COLOR-RESTART a restart unregisters the device and colord's mapping
#              restores the calibrated profile to the next session
#   D-TABLET   an emulated (uinput, ADR 0008) Wacom Cintiq 22HD pen and pad
#              (P-IN-05): libwacom identity and pen/pad pairing, a GTK 4
#              GtkGestureStylus client's position, pressure, tilt and tool
#              (pen, eraser), GNOME's area, keep-aspect, output and
#              relative mapping, stylus and pad switch-monitor and
#              keybinding actions, strip keybindings, the pad OSD in the
#              GTK shell (help button, org.gnome.Shell.Wacom.PadOsd),
#              hotplug, and nothing reaching the client while locked
# and captures a scanout screenshot with ffmpeg kmsgrab when possible.
# Needs root (sudo) for modprobe, seatd and uinput. Exits nonzero on any failure.
set -eu
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
ARTIFACTS="$ROOT/drm-smoke-artifacts"
SECONDS_UP=20
while [ $# -gt 0 ]; do
    case "$1" in
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --seconds) SECONDS_UP="$2"; shift 2 ;;
        --help|-h) sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "tuna-drm-smoke: unknown argument $1" >&2; exit 1 ;;
    esac
done
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/compositor.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
: >"$ASSERTIONS"
SEATD_SOCK="/run/seatd.sock"
SYSTEM_SEATD=""
STATE="$ARTIFACTS/shell-state.json"
CSTATE="$ARTIFACTS/compositor-state.json"
SEATD_PID=""
COMP_PID=""
DBUS_PID=""
COLORD_PID=""
SYSTEM_BUS_PID=""
CALIBRATION_PID=""
EMU_PID=""
CLIENT_PID=""

cleanup() {
    if [ -n "$CLIENT_PID" ]; then kill "$CLIENT_PID" 2>/dev/null || true; fi
    # The emulator (root) exits when its command pipe closes.
    exec 8>&- 2>/dev/null || true
    if [ -n "$EMU_PID" ]; then wait "$EMU_PID" 2>/dev/null || true; fi
    if [ -n "$COMP_PID" ]; then kill "$COMP_PID" 2>/dev/null || true; fi
    if [ -n "$CALIBRATION_PID" ]; then kill "$CALIBRATION_PID" 2>/dev/null || true; fi
    if [ -n "$COLORD_PID" ]; then sudo kill "$COLORD_PID" 2>/dev/null || true; fi
    if [ -n "$SYSTEM_BUS_PID" ]; then kill "$SYSTEM_BUS_PID" 2>/dev/null || true; fi
    if [ -n "$DBUS_PID" ]; then kill "$DBUS_PID" 2>/dev/null || true; fi
    if [ -n "$SEATD_PID" ]; then sudo kill "$SEATD_PID" 2>/dev/null || true; fi
    # Put a stopped system seatd back exactly as we found it.
    if [ -n "$SYSTEM_SEATD" ]; then sudo systemctl start seatd 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM

pass() { echo "$1 pass $2" >>"$ASSERTIONS"; echo "tuna-drm-smoke: $1 pass: $2"; }
# Capture the failed process before cleanup kills it. In particular, a live
# startup stall needs thread wait/syscall information, not a longer deadline.
# Diagnostics are best effort and never alter the assertion's failure status.
capture_failure() {
    {
        date -u
        if [ -n "$COMP_PID" ] && [ -d "/proc/$COMP_PID" ]; then
            ps -L -p "$COMP_PID" -o pid,tid,stat,wchan:40,comm || true
            for task in /proc/"$COMP_PID"/task/*; do
                [ -d "$task" ] || continue
                echo "thread ${task##*/}"
                for detail in status wchan syscall stack; do
                    echo "$detail"
                    timeout 2s sudo -n cat "$task/$detail" || true
                done
            done
        fi
        for connector in /sys/class/drm/card*-*; do
            [ -d "$connector" ] || continue
            echo "$connector"
            for detail in status enabled modes; do
                [ -r "$connector/$detail" ] || continue
                echo "$detail"
                cat "$connector/$detail" || true
            done
        done
    } >"$ARTIFACTS/failure-diagnostics.txt" 2>&1
}

fail() {
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "tuna-drm-smoke: $1 FAIL: $2" >&2
    # Bound total collection too: many renderer threads must not hold up a
    # terminal failure or the cleanup trap indefinitely.
    (capture_failure) &
    diagnostic_pid=$!
    (sleep 10; kill "$diagnostic_pid" 2>/dev/null || true) &
    diagnostic_watchdog=$!
    wait "$diagnostic_pid" || true
    kill "$diagnostic_watchdog" 2>/dev/null || true
    wait "$diagnostic_watchdog" 2>/dev/null || true
    tail -40 "$LOG" >&2 || true
    exit 1
}

validate_presentation() {
python3 - "$1" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as stream:
    data = json.load(stream)
frames = data["frames"]
assert len(frames) == 240
assert all(f["flags"] & 1 and f["flags"] & 4 for f in frames), "requires vsync and hardware completion"
assert all(f["refresh_ns"] > 0 for f in frames)
assert all(a["presented_ns"] < b["presented_ns"] and a["sequence"] < b["sequence"]
           and a["commit"] < b["commit"] for a, b in zip(frames, frames[1:]))
PY
}

sudo modprobe vkms
CARD=""
for dev in /sys/class/drm/card*; do
    case "$(readlink -f "$dev/device" 2>/dev/null)" in
        */vkms) CARD="/dev/dri/$(basename "$dev")" ;;
    esac
done
[ -n "$CARD" ] || { echo "tuna-drm-smoke: no vkms card appeared" >&2; exit 1; }
echo "tuna-drm-smoke: vkms at $CARD"

echo "tuna-drm-smoke: building"
cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor -p tuna-shell-host -p tuna-shell-gtk
"$ROOT/scripts/tuna-frame-pacer-build" "$ARTIFACTS/frame-pacer"

# seatd always serves /run/seatd.sock (and removes a leftover one), so a
# running system seatd is stopped for the test and restarted on exit.
# Ours hands the socket to this user so the compositor needs no root.
if systemctl is-active --quiet seatd 2>/dev/null; then
    SYSTEM_SEATD=1
    sudo systemctl stop seatd
fi
# The log stays user-owned on purpose.
# shellcheck disable=SC2024
sudo seatd -u "$(id -un)" -g "$(id -gn)" >"$ARTIFACTS/seatd.log" 2>&1 &
SEATD_PID=$!
for _ in $(seq 1 50); do [ -S "$SEATD_SOCK" ] && break; sleep 0.1; done
[ -S "$SEATD_SOCK" ] || { echo "tuna-drm-smoke: seatd never listened" >&2; exit 1; }

RUNTIME="$(mktemp -d)"
chmod 700 "$RUNTIME"
env -u DISPLAY -u WAYLAND_DISPLAY \
    XDG_RUNTIME_DIR="$RUNTIME" \
    XDG_STATE_HOME="$ARTIFACTS/state" XDG_DATA_HOME="$ARTIFACTS/data" \
    LIBSEAT_BACKEND=seatd \
    TUNA_DRM_DEVICE="$CARD" TUNA_INTROSPECT_FILE="$STATE" TUNA_COMPOSITOR_STATE="$CSTATE" \
    "$ROOT/target/debug/tuna-compositor" --backend drm --socket tuna-drm-smoke \
    --shell-bin "$ROOT/target/debug/tuna-shell-host" >"$LOG" 2>&1 &
COMP_PID=$!

end=$(($(date +%s) + 30))
until grep -q 'drm: output' "$LOG" 2>/dev/null; do
    kill -0 "$COMP_PID" 2>/dev/null || fail D-OUTPUT "compositor exited during startup"
    [ "$(date +%s)" -le "$end" ] || fail D-OUTPUT "no output lit within 30s"
    sleep 0.2
done
pass D-OUTPUT "$(grep -m1 'drm: output' "$LOG" | sed 's/.*drm: //')"

end=$(($(date +%s) + 30))
until [ -s "$STATE" ] && jq -e '.revision != null' "$STATE" >/dev/null 2>&1; do
    kill -0 "$COMP_PID" 2>/dev/null || fail D-SHELL "compositor exited before the shell connected"
    [ "$(date +%s)" -le "$end" ] || fail D-SHELL "shell never connected over the control socket"
    sleep 0.2
done
pass D-SHELL "shell connected (revision $(jq .revision "$STATE"))"

sleep 2
[ -s "$CSTATE" ] || fail D-IDLE "missing compositor frame counter"
idle_before=$(jq -er '.rendered_frames' "$CSTATE")
cp "$CSTATE" "$ARTIFACTS/idle-before.json"
sleep 3
idle_after=$(jq -er '.rendered_frames' "$CSTATE")
cp "$CSTATE" "$ARTIFACTS/idle-after.json"
if [ "$idle_after" -lt "$idle_before" ] || [ "$((idle_after - idle_before))" -gt 1 ]; then
    fail D-IDLE "stationary scene redrew $((idle_after - idle_before)) times in 3 seconds"
fi
pass D-IDLE "retained stationary scanout: $idle_before to $idle_after frames in 3 seconds"
sleep "$SECONDS_UP"
initial_frames=$(jq -er '.rendered_frames' "$CSTATE")
# GNOME's 500 ms startup reveal draws its own frames once, then settles.
reveal_frames=$(jq -er '.transitions.startup.animated_frames' "$CSTATE")
jq -e '.transitions.startup.active | not' "$CSTATE" >/dev/null ||
    fail D-IDLE "the startup reveal never settled"
if [ "$initial_frames" -lt 1 ] || [ "$((initial_frames - reveal_frames))" -gt 10 ]; then
    fail D-IDLE "unchanged shell should submit initial frames then sleep, got $initial_frames ($reveal_frames for the startup reveal)"
fi
pass D-IDLE "$initial_frames initial frames ($reveal_frames for the startup reveal) over $SECONDS_UP additional idle seconds; no continuous repaint"
# Resume real native presentation at the default scale as well as 200% below.
timeout 20s env -u WAYLAND_SOCKET XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=tuna-drm-smoke \
    "$ARTIFACTS/frame-pacer/tuna-frame-pacer" >"$ARTIFACTS/presentation.json" \
    2>"$ARTIFACTS/presentation.stderr" || fail D-FRAMES "native presentation probe failed"
validate_presentation "$ARTIFACTS/presentation.json" || fail D-FRAMES "invalid native presentation trace"
pass D-FRAMES "240 changing client frames at default scale received real ordered page-flip feedback"
env -u WAYLAND_SOCKET XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=tuna-drm-smoke \
    timeout 20 "$ARTIFACTS/frame-pacer/tuna-frame-pacer" --endurance-seconds 16 \
    >"$ARTIFACTS/presentation-endurance.jsonl" \
    2>"$ARTIFACTS/presentation-endurance.stderr" || fail D-ENDURANCE "native endurance workload failed"
python3 - "$ROOT" "$ARTIFACTS/presentation-endurance.jsonl" <<'PYCODE' || fail D-ENDURANCE "invalid/incomplete native endurance trace"
import sys
sys.path.insert(0, sys.argv[1] + "/scripts/lib")
from endurance_presentation import Reader
with open(sys.argv[2], "rb") as stream:
    result = Reader(stream, 16).finish()
    if result["batches"] < 2:
        raise ValueError("native control did not exercise batch rollover")
    print(result)
PYCODE
pass D-ENDURANCE "real feedback, batch rollover and requested 16-second completion"
if command -v ffmpeg >/dev/null 2>&1; then
    sudo ffmpeg -loglevel error -y -device "$CARD" -f kmsgrab -i - -frames:v 1 \
        -vf 'hwdownload,format=bgr0' "$ARTIFACTS/scanout.png" 2>"$ARTIFACTS/kmsgrab.log" &&
        sudo chown "$(id -u):$(id -g)" "$ARTIFACTS/scanout.png" &&
        echo "tuna-drm-smoke: scanout captured" ||
        echo "tuna-drm-smoke: kmsgrab unavailable (see kmsgrab.log); state assertions still gate"
fi

kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
frames="$(sed -n 's/.*shutdown after \([0-9]*\) frames.*/\1/p' "$LOG" | tail -1)"
if [ -z "$frames" ] || [ "$frames" -lt 240 ]; then
    fail D-FRAMES "expected at least 240 completed frames, got '${frames:-none}'"
fi
if grep -q panicked "$LOG"; then fail D-NOPANIC "panic in compositor log"; fi
pass D-NOPANIC "no panic"
# Per-output scale from GNOME's monitors.xml (#59): the same session with
# the vkms connector set to 200 percent.
CONNECTOR="$(sed -n 's/.*drm: output \([^ ]*\) .*/\1/p' "$LOG" | head -1)"
MODE_W="$(sed -n 's/.*drm: output [^ ]* \([0-9]*\)x.*/\1/p' "$LOG" | head -1)"
mkdir -p "$ARTIFACTS/config"
cat >"$ARTIFACTS/config/monitors.xml" <<XML
<monitors version="2">
  <configuration>
    <logicalmonitor>
      <x>0</x><y>0</y><scale>2</scale><primary>yes</primary>
      <monitor><monitorspec><connector>$CONNECTOR</connector></monitorspec></monitor>
    </logicalmonitor>
  </configuration>
</monitors>
XML
SCALED_LOG="$ARTIFACTS/compositor-scaled.log"
CSTATE="$ARTIFACTS/compositor-state-scaled.json"
env -u DISPLAY -u WAYLAND_DISPLAY \
    XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$ARTIFACTS/config" \
    XDG_STATE_HOME="$ARTIFACTS/state" XDG_DATA_HOME="$ARTIFACTS/data" \
    LIBSEAT_BACKEND=seatd TUNA_DRM_DEVICE="$CARD" TUNA_COMPOSITOR_STATE="$CSTATE" \
    "$ROOT/target/debug/tuna-compositor" --backend drm --socket tuna-drm-scaled \
    --shell-bin "$ROOT/target/debug/tuna-shell-host" >"$SCALED_LOG" 2>&1 &
COMP_PID=$!
half=$((MODE_W / 2))
end=$(($(date +%s) + 30))
until [ -s "$CSTATE" ] && jq -e ".layers | any(.rect[2] == $half)" "$CSTATE" >/dev/null 2>&1; do
    kill -0 "$COMP_PID" 2>/dev/null || { LOG="$SCALED_LOG"; fail D-SCALE "compositor exited"; }
    [ "$(date +%s)" -le "$end" ] || { LOG="$SCALED_LOG"; fail D-SCALE "no layer laid out $half logical pixels wide"; }
    sleep 0.2
done
grep -q "drm: output $CONNECTOR .* scale 2" "$SCALED_LOG" ||
    { LOG="$SCALED_LOG"; fail D-SCALE "the output did not take scale 2 from monitors.xml"; }
# A callback-paced real client alternates its pixels and requests presentation
# feedback. Idle suppression must not prevent active rendering or real vblank
# feedback. The fixture comes from the independently reviewed cadence lane.
timeout 20s env XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=tuna-drm-scaled \
    "$ARTIFACTS/frame-pacer/tuna-frame-pacer" >"$ARTIFACTS/active-presentations.json" \
    2>"$ARTIFACTS/frame-pacer.log" ||
    { LOG="$SCALED_LOG"; fail D-FRAMES "active client did not receive all presentations"; }
validate_presentation "$ARTIFACTS/active-presentations.json" ||
    { LOG="$SCALED_LOG"; fail D-FRAMES "invalid hardware presentation feedback"; }
pass D-FRAMES "240 changing client frames received real ordered page-flip feedback"
sleep 2
kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
scaled_frames="$(sed -n 's/.*shutdown after \([0-9]*\) frames.*/\1/p' "$SCALED_LOG" | tail -1)"
if [ -z "$scaled_frames" ] || [ "$scaled_frames" -lt 240 ]; then
    LOG="$SCALED_LOG"
    fail D-SCALE "expected frames at scale 2, got '${scaled_frames:-none}'"
fi
pass D-SCALE "monitors.xml scale 2 on $CONNECTOR: $half logical px wide, $scaled_frames frames"

# Modes from GNOME Settings (#340): the same connector with no stored
# configuration, its DisplayConfig on a private session bus.
MODES_LOG="$ARTIFACTS/compositor-modes.log"
CSTATE="$ARTIFACTS/compositor-state-modes.json"
mkdir -p "$ARTIFACTS/config-modes"
dbus-daemon --session --fork --print-address=1 --print-pid=1 >"$ARTIFACTS/dbus-modes.txt"
DBUS_SESSION_BUS_ADDRESS="$(sed -n 1p "$ARTIFACTS/dbus-modes.txt")"
DBUS_PID="$(sed -n 2p "$ARTIFACTS/dbus-modes.txt")"
export DBUS_SESSION_BUS_ADDRESS
env -u DISPLAY -u WAYLAND_DISPLAY \
    XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$ARTIFACTS/config-modes" \
    XDG_STATE_HOME="$ARTIFACTS/state" XDG_DATA_HOME="$ARTIFACTS/data" \
    LIBSEAT_BACKEND=seatd TUNA_DRM_DEVICE="$CARD" TUNA_COMPOSITOR_STATE="$CSTATE" \
    "$ROOT/target/debug/tuna-compositor" --backend drm --socket tuna-drm-modes \
    --shell-bin "$ROOT/target/debug/tuna-shell-host" >"$MODES_LOG" 2>&1 &
COMP_PID=$!
LOG="$MODES_LOG"
display_call() {
    method="$1"
    shift
    gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method "org.gnome.Mutter.DisplayConfig.$method" "$@"
}
# apply_mode METHOD MODE: one logical monitor at scale 1 in MODE, with
# the serial GetCurrentState reports, as GNOME Settings sends it.
apply_mode() {
    serial="$(display_call GetCurrentState | sed -n 's/^(uint32 \([0-9]*\),.*/\1/p')"
    [ -n "$serial" ] || return 1
    display_call ApplyMonitorsConfig "$serial" "$1" \
        "[(0, 0, 1.0, uint32 0, true, [('$CONNECTOR', '$2', {'color-mode': <uint32 0>, 'underscanning': <false>})])]" \
        "@a{sv} {}" >>"$ARTIFACTS/display-modes.log" 2>&1
}
# wait_crtc MODE TIMEOUT: the kernel reports the CRTC in MODE, the
# advertised current mode agrees and the layout is that wide.
wait_crtc() {
    width="${1%%x*}"
    end=$(($(date +%s) + $2))
    until [ -s "$CSTATE" ] && jq -e --arg c "$CONNECTOR" --arg m "$1" --argjson w "$width" \
        '(.display_config.monitors[] | select(.connector == $c) | .crtc_mode == $m and .mode == $m)
         and (.layers | any(.rect[2] == $w))' "$CSTATE" >/dev/null 2>&1; do
        kill -0 "$COMP_PID" 2>/dev/null || return 1
        [ "$(date +%s)" -le "$end" ] || return 1
        sleep 0.2
    done
}
end=$(($(date +%s) + 30))
until grep -q 'serving org.gnome.Mutter.DisplayConfig' "$MODES_LOG" 2>/dev/null &&
    [ -s "$CSTATE" ] && jq -e '.display_config.serial >= 1 and (.layers | length > 0)' "$CSTATE" >/dev/null 2>&1; do
    kill -0 "$COMP_PID" 2>/dev/null || fail D-MODES "compositor exited"
    [ "$(date +%s)" -le "$end" ] || fail D-MODES "DisplayConfig never served the monitor"
    sleep 0.2
done
display_call GetCurrentState >"$ARTIFACTS/modes-state.txt" 2>&1 ||
    fail D-MODES "GetCurrentState failed: $(tail -2 "$ARTIFACTS/modes-state.txt")"
# The kernel's mode list as Mutter advertises it: the current and
# preferred mode, and another resolution to switch to (800x600 when the
# connector has it).
picked="$(python3 - "$ARTIFACTS/modes-state.txt" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
modes = re.findall(
    r"\('(\d+)x(\d+)(i?)@([\d.]+)', \d+, \d+, [\d.e+-]+, [\d.e+-]+, \[[^\]]*\], \{([^}]*)\}\)", text)
ids = [(f"{w}x{h}{i}@{r}", int(w), int(h), i, props) for w, h, i, r, props in modes]
current = [m for m in ids if "'is-current': <true>" in m[4]]
preferred = [m for m in ids if "'is-preferred': <true>" in m[4]]
assert len(ids) > 1, f"only {len(ids)} advertised modes"
assert len(current) == 1 and len(preferred) == 1, (current, preferred)
others = [m for m in ids if not m[3] and (m[1], m[2]) != (current[0][1], current[0][2])]
target = next((m for m in others if (m[1], m[2]) == (800, 600)), others[0] if others else None)
assert target is not None, "no other resolution"
print(current[0][0], target[0], len(ids))
PY
)" || fail D-MODES "GetCurrentState does not list the connector's modes: $(head -c 2000 "$ARTIFACTS/modes-state.txt")"
ORIGINAL_MODE="${picked%% *}"
rest="${picked#* }"
TARGET_MODE="${rest%% *}"
MODE_COUNT="${rest#* }"
wait_crtc "$ORIGINAL_MODE" 10 || fail D-MODES "the CRTC does not run the advertised current mode $ORIGINAL_MODE"
# Verify refuses a mode the connector lacks, as Mutter does.
if apply_mode 0 "123x45@60.000"; then fail D-MODES "an unknown mode verified"; fi
tail -2 "$ARTIFACTS/display-modes.log" | grep -q "InvalidArgs.*Invalid mode '123x45@60.000' specified" ||
    fail D-MODES "an unknown mode was not refused: $(tail -2 "$ARTIFACTS/display-modes.log")"
# Temporary: the CRTC switches (atomic test first) and frames flip on.
frames_before=$(jq -er '.rendered_frames' "$CSTATE")
apply_mode 1 "$TARGET_MODE" || fail D-MODES "ApplyMonitorsConfig $TARGET_MODE failed: $(tail -2 "$ARTIFACTS/display-modes.log")"
wait_crtc "$TARGET_MODE" 10 || fail D-MODES "the kernel did not report the CRTC in $TARGET_MODE"
end=$(($(date +%s) + 10))
until [ "$(jq -er '.rendered_frames' "$CSTATE")" -gt "$frames_before" ]; do
    [ "$(date +%s)" -le "$end" ] || fail D-MODES "no frame flipped in $TARGET_MODE"
    sleep 0.2
done
cp "$CSTATE" "$ARTIFACTS/modes-switched.json"
# Persistent and unanswered (no GNOME Shell dialog here): the CRTC
# returns to the original mode, then Mutter's timeout reverts to the
# configuration before it.
apply_mode 2 "$ORIGINAL_MODE" || fail D-MODES "persistent $ORIGINAL_MODE failed: $(tail -2 "$ARTIFACTS/display-modes.log")"
wait_crtc "$ORIGINAL_MODE" 10 || fail D-MODES "the persistent change did not reach the CRTC"
changed_at=$(date +%s)
jq -e '.display_config.awaiting_confirmation' "$CSTATE" >/dev/null ||
    fail D-MODES "the persistent change did not await confirmation"
wait_crtc "$TARGET_MODE" 30 || fail D-MODES "the unconfirmed change did not revert the CRTC to $TARGET_MODE"
elapsed=$(($(date +%s) - changed_at))
[ "$elapsed" -ge 18 ] || fail D-MODES "the change reverted after ${elapsed}s, before Mutter's 20 second timeout"
[ ! -e "$ARTIFACTS/config-modes/tuna/monitors.xml" ] || fail D-MODES "an unconfirmed change was saved"
# Back to the original mode for a clean exit.
apply_mode 1 "$ORIGINAL_MODE" || fail D-MODES "restoring $ORIGINAL_MODE failed"
wait_crtc "$ORIGINAL_MODE" 10 || fail D-MODES "the CRTC did not return to $ORIGINAL_MODE"
kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
if grep -q panicked "$MODES_LOG"; then fail D-NOPANIC "panic in the mode-change session"; fi
pass D-MODES "$MODE_COUNT advertised modes on $CONNECTOR; CRTC $ORIGINAL_MODE -> $TARGET_MODE by ApplyMonitorsConfig with frames flipping, unconfirmed persistent $ORIGINAL_MODE reverted after ${elapsed}s"

# Colour management (P-DS-03, #341): the real colord on a private system
# bus, Mutter's device and profile registration, and the CRTC GAMMA_LUT
# read back from the kernel (not from the compositor) for the assigned
# profile, Night Light, an assigned VCGT calibration, a calibration
# session (stopped, then abandoned) and a restart that keeps the
# assignment through colord's mapping database.
COLORD_BIN=""
for candidate in /usr/libexec/colord /usr/lib/colord/colord; do
    [ -x "$candidate" ] && COLORD_BIN="$candidate" && break
done
[ -n "$COLORD_BIN" ] || fail D-COLORD "colord is not installed"
SYSTEM_BUS_SOCKET="$RUNTIME/system_bus_socket"
cat >"$ARTIFACTS/system-bus.conf" <<XML
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=$SYSTEM_BUS_SOCKET</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*" eavesdrop="true"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
XML
dbus-daemon --config-file="$ARTIFACTS/system-bus.conf" --fork --print-address=1 --print-pid=1 \
    >"$ARTIFACTS/dbus-system.txt"
SYSTEM_BUS="$(sed -n 1p "$ARTIFACTS/dbus-system.txt")"
SYSTEM_BUS_PID="$(sed -n 2p "$ARTIFACTS/dbus-system.txt")"
# colord keeps its databases in /var/lib/colord: a private tmpfs there,
# and the daemon runs as this user, so it trusts our calls as its own
# (cd_main_sender_authenticated) without the host's polkit.
sudo mkdir -p /var/lib/colord
# shellcheck disable=SC2016,SC2024
sudo unshare --mount --propagation private sh -c \
    'mount -t tmpfs tmpfs /var/lib/colord && exec setpriv --reuid="$1" --regid="$2" --clear-groups env DBUS_SYSTEM_BUS_ADDRESS="$3" "$4" -v' \
    sh "$(id -u)" "$(id -g)" "$SYSTEM_BUS" "$COLORD_BIN" >"$ARTIFACTS/colord.log" 2>&1 &
COLORD_PID=$!
cd_call() {
    gdbus call --address "$SYSTEM_BUS" --dest org.freedesktop.ColorManager "$@"
}
end=$(($(date +%s) + 30))
until cd_call --object-path /org/freedesktop/ColorManager \
    --method org.freedesktop.ColorManager.GetDevices >/dev/null 2>&1; do
    kill -0 "$COLORD_PID" 2>/dev/null || fail D-COLORD "colord exited: $(tail -5 "$ARTIFACTS/colord.log")"
    [ "$(date +%s)" -le "$end" ] || fail D-COLORD "colord never served the private system bus"
    sleep 0.2
done
COLOR_LOG="$ARTIFACTS/compositor-color.log"
CSTATE="$ARTIFACTS/compositor-state-color.json"
COLOR_DATA="$ARTIFACTS/data-color"
start_color_session() {
    env -u DISPLAY -u WAYLAND_DISPLAY \
        XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$ARTIFACTS/config-modes" \
        XDG_STATE_HOME="$ARTIFACTS/state" XDG_DATA_HOME="$COLOR_DATA" \
        DBUS_SYSTEM_BUS_ADDRESS="$SYSTEM_BUS" \
        LIBSEAT_BACKEND=seatd TUNA_DRM_DEVICE="$CARD" TUNA_COMPOSITOR_STATE="$CSTATE" \
        "$ROOT/target/debug/tuna-compositor" --backend drm --socket tuna-drm-color \
        --shell-bin "$ROOT/target/debug/tuna-shell-host" >>"$COLOR_LOG" 2>&1 &
    COMP_PID=$!
    LOG="$COLOR_LOG"
}
readback() {
    # The output file stays user-owned on purpose.
    # shellcheck disable=SC2024
    sudo python3 "$ROOT/scripts/lib/drm-gamma-readback.py" "$CARD" >"$ARTIFACTS/gamma-$1.json"
}
# wait_gamma NAME MODE ARGS...: the kernel's GAMMA_LUT becomes what MODE expects.
wait_gamma() {
    name="$1"
    shift
    end=$(($(date +%s) + 15))
    until readback "$name" &&
        python3 "$ROOT/scripts/lib/drm-gamma-expect.py" check "$ARTIFACTS/gamma-$name.json" "$@" \
            >"$ARTIFACTS/gamma-$name.check" 2>&1; do
        kill -0 "$COMP_PID" 2>/dev/null || return 1
        [ "$(date +%s)" -le "$end" ] || return 1
        sleep 0.2
    done
}
color_set_temperature() {
    gdbus call --session --dest org.gnome.SettingsDaemon.Color \
        --object-path /org/gnome/SettingsDaemon/Color \
        --method org.freedesktop.DBus.Properties.Set \
        org.gnome.SettingsDaemon.Color Temperature "<uint32 $1>" >/dev/null
}
# The vkms connector has no EDID: Mutter names the device after the
# connector and generates lcms2's sRGB profile for it (gamma LUT present).
DEVICE_ID="xrandr-$CONNECTOR"
start_color_session
end=$(($(date +%s) + 30))
until [ -s "$CSTATE" ] && jq -e '.color.devices[0].ready and .color.devices[0].assigned != null' \
    "$CSTATE" >/dev/null 2>&1; do
    kill -0 "$COMP_PID" 2>/dev/null || fail D-COLORD "compositor exited"
    [ "$(date +%s)" -le "$end" ] || fail D-COLORD "no colord device was set up: $(jq -c .color "$CSTATE" 2>/dev/null)"
    sleep 0.2
done
cp "$CSTATE" "$ARTIFACTS/color-registered.json"
device_path="$(cd_call --object-path /org/freedesktop/ColorManager \
    --method org.freedesktop.ColorManager.FindDeviceById "$DEVICE_ID" | sed -n "s/^(objectpath '\(.*\)',)$/\1/p")"
[ -n "$device_path" ] || fail D-COLORD "colord has no device $DEVICE_ID"
cd_prop() {
    cd_call --object-path "$1" --method org.freedesktop.DBus.Properties.Get "$2" "$3"
}
cd_prop "$device_path" org.freedesktop.ColorManager.Device Kind | grep -q "'display'" ||
    fail D-COLORD "device kind is not display"
cd_prop "$device_path" org.freedesktop.ColorManager.Device Metadata >"$ARTIFACTS/colord-device-metadata.txt"
grep -q "'XRANDR_name': '$CONNECTOR'" "$ARTIFACTS/colord-device-metadata.txt" ||
    fail D-COLORD "device metadata lacks XRANDR_name: $(cat "$ARTIFACTS/colord-device-metadata.txt")"
grep -q "'OutputPriority': 'primary'" "$ARTIFACTS/colord-device-metadata.txt" ||
    fail D-COLORD "device metadata lacks OutputPriority primary"
default_profile="$(cd_prop "$device_path" org.freedesktop.ColorManager.Device Profiles |
    sed -n "s/^(<\[objectpath '\([^']*\)'.*/\1/p")"
[ -n "$default_profile" ] || fail D-COLORD "colord assigned no profile to $DEVICE_ID"
profile_file="$(cd_prop "$default_profile" org.freedesktop.ColorManager.Profile Filename |
    sed -n "s/^(<'\(.*\)'>,)$/\1/p")"
case "$profile_file" in
    "$COLOR_DATA"/icc/device-*.icc) ;;
    *) fail D-COLORD "the default profile is not Mutter's device profile: $profile_file" ;;
esac
cd_prop "$default_profile" org.freedesktop.ColorManager.Profile Title | grep -q "sRGB built-in" ||
    fail D-COLORD "colord did not read the generated sRGB profile's description"
cd_prop "$default_profile" org.freedesktop.ColorManager.Profile Metadata |
    grep -q "'MAPPING_device_id': '$DEVICE_ID'" ||
    fail D-COLORD "colord did not read the profile's MAPPING_device_id"
pass D-COLORD "$DEVICE_ID registered in the real colord with Mutter's metadata; its generated sRGB profile $profile_file is the default"

wait_gamma assigned ramp 6500 ||
    fail D-GAMMA "the assigned profile did not program the identity ramp: $(cat "$ARTIFACTS/gamma-assigned.check")"
color_set_temperature 3000 || fail D-GAMMA "could not set the Night Light Temperature"
wait_gamma night-light ramp 3000 ||
    fail D-GAMMA "Temperature 3000 K did not reach GAMMA_LUT: $(cat "$ARTIFACTS/gamma-night-light.check")"
# GNOME Settings' import: the calibrated file lands in the ICC store and
# becomes the default; Mutter applies its vcgt under Night Light.
python3 "$ROOT/scripts/lib/drm-gamma-expect.py" vcgt-add "$profile_file" "$ARTIFACTS/calibrated.icc"
cp "$ARTIFACTS/calibrated.icc" "$COLOR_DATA/icc/calibrated.icc"
end=$(($(date +%s) + 15))
until calibrated="$(cd_call --object-path /org/freedesktop/ColorManager \
    --method org.freedesktop.ColorManager.FindProfileByFilename "$COLOR_DATA/icc/calibrated.icc" 2>/dev/null |
    sed -n "s/^(objectpath '\(.*\)',)$/\1/p")" && [ -n "$calibrated" ]; do
    [ "$(date +%s)" -le "$end" ] || fail D-GAMMA "the compositor did not register the imported profile with colord"
    sleep 0.2
done
cd_call --object-path "$device_path" --method org.freedesktop.ColorManager.Device.AddProfile hard "$calibrated" \
    >/dev/null 2>&1 || true
cd_call --object-path "$device_path" --method org.freedesktop.ColorManager.Device.MakeProfileDefault "$calibrated" \
    >/dev/null || fail D-GAMMA "colord refused MakeProfileDefault"
wait_gamma vcgt-night-light vcgt "$ARTIFACTS/calibrated.icc.json" 3000 ||
    fail D-GAMMA "the assigned vcgt did not reach GAMMA_LUT: $(cat "$ARTIFACTS/gamma-vcgt-night-light.check")"
pass D-GAMMA "kernel GAMMA_LUT ($(jq '.[0].gamma_lut_size' "$ARTIFACTS/gamma-assigned.json") entries) read back: identity for the sRGB profile, the 3000 K blackbody ramp for Night Light, the imported profile's vcgt times 3000 K"

# A calibration session as GNOME Settings opens it: the white point goes
# to 6500 K and the raw ramp is programmed; Stop restores the profile.
python3 "$ROOT/scripts/lib/drm-gamma-expect.py" ramp 256 1 >"$ARTIFACTS/calibration-ramp.json"
calibrate() {
    rm -f "$ARTIFACTS/calibration-$1.status"
    mkfifo "$ARTIFACTS/calibration-$1.in"
    python3 "$ROOT/scripts/lib/color-calibration-client.py" "$CONNECTOR" \
        "$ARTIFACTS/calibration-ramp.json" "$ARTIFACTS/calibration-$1.status" \
        <"$ARTIFACTS/calibration-$1.in" >"$ARTIFACTS/calibration-$1.log" 2>&1 &
    CALIBRATION_PID=$!
    exec 9>"$ARTIFACTS/calibration-$1.in"
    end=$(($(date +%s) + 10))
    until [ -s "$ARTIFACTS/calibration-$1.status" ]; do
        kill -0 "$CALIBRATION_PID" 2>/dev/null ||
            fail D-CALIBRATE "the calibration client failed: $(cat "$ARTIFACTS/calibration-$1.log")"
        [ "$(date +%s)" -le "$end" ] || fail D-CALIBRATE "CalibrateMonitor never answered"
        sleep 0.1
    done
}
calibrate stop
jq -e '.gamma_lut_size == 256' "$ARTIFACTS/calibration-stop.status" >/dev/null ||
    fail D-CALIBRATE "GammaLutSize is not the CRTC's: $(cat "$ARTIFACTS/calibration-stop.status")"
wait_gamma calibrating raw "$ARTIFACTS/calibration-ramp.json" ||
    fail D-CALIBRATE "SetCrtcGammaLut did not reach GAMMA_LUT: $(cat "$ARTIFACTS/gamma-calibrating.check")"
echo stop >&9
exec 9>&-
wait "$CALIBRATION_PID" || fail D-CALIBRATE "Stop failed: $(cat "$ARTIFACTS/calibration-stop.log")"
wait_gamma stopped vcgt "$ARTIFACTS/calibrated.icc.json" 3000 ||
    fail D-CALIBRATE "Stop did not restore the profile white point: $(cat "$ARTIFACTS/gamma-stopped.check")"
# A caller that leaves the bus without Stop loses its session too.
calibrate vanish
wait_gamma abandoned-calibrating raw "$ARTIFACTS/calibration-ramp.json" ||
    fail D-CALIBRATE "the second session's ramp did not apply"
echo leave >&9
exec 9>&-
wait "$CALIBRATION_PID" || true
wait_gamma abandoned vcgt "$ARTIFACTS/calibrated.icc.json" 3000 ||
    fail D-CALIBRATE "a vanished caller's session kept its ramp: $(cat "$ARTIFACTS/gamma-abandoned.check")"
pass D-CALIBRATE "CalibrateMonitor/SetCrtcGammaLut programmed the raw 256-entry ramp; Stop and a vanished caller both restored the vcgt white point"

# Restart: the session's devices leave colord, and the next session's
# device gets the calibrated profile back from colord's mapping database.
kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
if cd_call --object-path /org/freedesktop/ColorManager \
    --method org.freedesktop.ColorManager.FindDeviceById "$DEVICE_ID" >/dev/null 2>&1; then
    fail D-COLOR-RESTART "the stopped session left its colord device behind"
fi
start_color_session
wait_gamma restarted vcgt "$ARTIFACTS/calibrated.icc.json" 6500 ||
    fail D-COLOR-RESTART "the restarted session did not restore the calibrated profile: $(cat "$ARTIFACTS/gamma-restarted.check")"
jq -e --arg f "$COLOR_DATA/icc/calibrated.icc" '.color.devices[0].assigned.filename == $f and .color.devices[0].has_vcgt' \
    "$CSTATE" >/dev/null || fail D-COLOR-RESTART "the restarted session reports another assignment: $(jq -c .color.devices "$CSTATE")"
kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
if grep -q panicked "$COLOR_LOG"; then fail D-NOPANIC "panic in the colour sessions"; fi
pass D-COLOR-RESTART "after a restart colord's mapping kept the calibrated profile and its vcgt reached GAMMA_LUT at 6500 K"
sudo kill "$COLORD_PID" 2>/dev/null || true
COLORD_PID=""
kill "$SYSTEM_BUS_PID" 2>/dev/null || true
SYSTEM_BUS_PID=""

# Drawing tablets (P-IN-05, #344), emulated per ADR 0008: uinput devices
# exactly as the wacom driver creates them for a Cintiq 22HD, a GTK 4
# stylus client, GNOME 51's tablet settings in a private keyfile, and the
# GTK shell (whose pad OSD the help button opens).
kill "$DBUS_PID" 2>/dev/null || true
TABLET_LOG="$ARTIFACTS/compositor-tablet.log"
CSTATE="$ARTIFACTS/compositor-state-tablet.json"
CLIENT_LOG="$ARTIFACTS/tablet-client.jsonl"
EMU_OUT="$ARTIFACTS/tablet-emulator.log"
mkdir -p "$ARTIFACTS/config-tablet" "$ARTIFACTS/schemas-tablet"
cp "$ROOT/tests/settings/gnome51-peripherals-tablet.gschema.xml" "$ARTIFACTS/schemas-tablet/"
glib-compile-schemas "$ARTIFACTS/schemas-tablet"
GSETTINGS_SCHEMA_DIR="$ARTIFACTS/schemas-tablet${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
GSETTINGS_BACKEND=keyfile
XDG_CONFIG_HOME="$ARTIFACTS/config-tablet"
export GSETTINGS_SCHEMA_DIR GSETTINGS_BACKEND XDG_CONFIG_HOME
dbus-daemon --session --fork --print-address=1 --print-pid=1 >"$ARTIFACTS/dbus-tablet.txt"
DBUS_SESSION_BUS_ADDRESS="$(sed -n 1p "$ARTIFACTS/dbus-tablet.txt")"
DBUS_PID="$(sed -n 2p "$ARTIFACTS/dbus-tablet.txt")"
export DBUS_SESSION_BUS_ADDRESS
LOG="$TABLET_LOG"
env -u DISPLAY -u WAYLAND_DISPLAY \
    XDG_RUNTIME_DIR="$RUNTIME" XDG_STATE_HOME="$ARTIFACTS/state" XDG_DATA_HOME="$ARTIFACTS/data" \
    LIBSEAT_BACKEND=seatd TUNA_DRM_DEVICE="$CARD" TUNA_COMPOSITOR_STATE="$CSTATE" \
    "$ROOT/target/debug/tuna-compositor" --backend drm --socket tuna-drm-tablet \
    --shell-bin "$ROOT/target/debug/tuna-shell-gtk" >"$TABLET_LOG" 2>&1 &
COMP_PID=$!
# state JQ [SECONDS]: the compositor state satisfies JQ in time.
state() {
    end=$(($(date +%s) + ${2:-10}))
    until [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1; do
        kill -0 "$COMP_PID" 2>/dev/null || return 1
        [ "$(date +%s)" -le "$end" ] || return 1
        sleep 0.1
    done
}
state '.display_config.serial >= 1 and (.layers | length > 0)' 30 ||
    fail D-TABLET "the tablet session never lit its output"
state '.layers | any(.namespace == "tuna-panel")' 30 || fail D-TABLET "the GTK shell never mapped its panel"

# The emulator answers one line per command on the pipe. Only uinput
# needs root; the pipe and the log stay ours.
mkfifo "$ARTIFACTS/tablet-emulator.fifo"
# shellcheck disable=SC2024
sudo python3 "$ROOT/scripts/lib/tuna-uinput-tablet.py" <"$ARTIFACTS/tablet-emulator.fifo" >"$EMU_OUT" 2>&1 &
EMU_PID=$!
exec 8>"$ARTIFACTS/tablet-emulator.fifo"
emu_sent=0
emu() {
    echo "$*" >&8
    emu_sent=$((emu_sent + 1))
    end=$(($(date +%s) + 10))
    until [ "$(grep -c '^ok$' "$EMU_OUT")" -ge "$emu_sent" ]; do
        grep -q '^error' "$EMU_OUT" && fail D-TABLET "emulator: $(grep '^error' "$EMU_OUT" | tail -1)"
        [ "$(date +%s)" -le "$end" ] || fail D-TABLET "emulator did not answer '$*'"
        sleep 0.05
    done
    sleep 0.1
}
TPATH=/org/gnome/desktop/peripherals/tablets/056a:00fa/
SPATH=/org/gnome/desktop/peripherals/stylus/2f4a1c3/
tset() { gsettings set "org.gnome.desktop.peripherals.tablet:$TPATH" "$@"; }
sset() { gsettings set "org.gnome.desktop.peripherals.tablet.stylus:$SPATH" "$@"; }
pset() { gsettings set "org.gnome.desktop.peripherals.tablet.pad-button:$TPATH$1/" "$2" "$3"; }

state '(.tablets.tablets | length == 1) and (.tablets.pads | length == 1)' 15 ||
    fail D-TABLET "the emulated pen and pad did not appear"
state '.tablets.tablets[0].libwacom == "Wacom Cintiq 22HD" and .tablets.pads[0].libwacom == "Wacom Cintiq 22HD"
       and (.tablets.pads[0].layout | endswith("cintiq-22hd.svg")) and .tablets.pads[0].buttons == 18' ||
    fail D-TABLET "libwacom does not know the emulated model: $(jq -c .tablets "$CSTATE")"
# libinput adds the pen and the pad in either order; the pad pairs with
# its pen as soon as both are there.
grep -q 'pad Wacom Cintiq 22HD Pad .*paired=Wacom Cintiq 22HD Pen' "$TABLET_LOG" ||
    fail D-TABLET "the pad was not paired with its pen through the libinput device group"
PAD_ID="$(jq -r '.tablets.pads[0].id' "$CSTATE")"
PAD_NODE="$(jq -r '.tablets.pads[0].devnode' "$CSTATE")"

env -u DISPLAY XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=tuna-drm-tablet GDK_BACKEND=wayland \
    python3 "$ROOT/scripts/lib/tuna-tablet-client.py" >"$CLIENT_LOG" 2>"$ARTIFACTS/tablet-client.stderr" &
CLIENT_PID=$!
# client PYTHON [SECONDS]: a client record since the last mark satisfies
# PYTHON (r is the record, W and H the window size).
client_mark=0
mark() { client_mark=$(wc -l <"$CLIENT_LOG"); }
client() {
    end=$(($(date +%s) + ${2:-5}))
    until python3 - "$CLIENT_LOG" "$client_mark" "$1" <<'PY'
import json, sys
lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
ready = [json.loads(l) for l in lines if '"ready"' in l]
W, H = (ready[0]["width"], ready[0]["height"]) if ready else (0, 0)
records = [json.loads(l) for l in lines[int(sys.argv[2]):]]
sys.exit(0 if any(eval(sys.argv[3], {}, {"r": r, "W": W, "H": H}) for r in records) else 1)
PY
    do
        [ "$(date +%s)" -le "$end" ] || return 1
        sleep 0.1
    done
}
client 'r["event"] == "ready" and W > 0' 20 || fail D-TABLET "the GTK client never mapped: $(tail -3 "$ARTIFACTS/tablet-client.stderr")"
client "r['event'] == 'ready' and W == $MODE_W" || fail D-TABLET "the client is not fullscreen on the ${MODE_W}px output"
near() { echo "abs(r['x'] - $1) <= 3 and abs(r['y'] - $2) <= 3"; }

# Absolute mapping over the whole display, hovering then drawing.
mark
emu tool pen
emu pen 0.5 0.25 0 10 -5 20
client "r['event'] in ('proximity', 'motion') and r['tool'] == 'pen' and $(near 'W * 0.5' 'H * 0.25') and r['distance'] is not None" ||
    fail D-TABLET "hover did not reach the client at the tablet's position: $(tail -2 "$CLIENT_LOG")"
mark
emu pen 0.5 0.5 0.5 10 -5 0
# GDK reports tilt over -90..90 degrees as -1..1 (gdkdevice-wayland.c).
client "r['event'] == 'down' and $(near 'W * 0.5' 'H * 0.5') and abs(r['pressure'] - 0.25) < 0.04 and abs(r['xtilt'] - 10.05 / 90) < 0.006 and abs(r['ytilt'] + 5.03 / 90) < 0.006" ||
    fail D-TABLET "the tip did not go down with GNOME's default pressure curve and the tilt: $(tail -2 "$CLIENT_LOG")"
mark
emu pen 0.75 0.5 0.8
client "r['event'] == 'motion' and $(near 'W * 0.75' 'H * 0.5') and abs(r['pressure'] - 0.64) < 0.05" ||
    fail D-TABLET "drawing motion lost position or pressure: $(tail -2 "$CLIENT_LOG")"
mark
emu pen 0.75 0.5 0
client "r['event'] == 'up'" || fail D-TABLET "the tip never came up"
mark
emu tool eraser
emu pen 0.25 0.5 0
client "r['tool'] == 'eraser' and $(near 'W * 0.25' 'H * 0.5')" || fail D-TABLET "the eraser end did not reach the client as an eraser"
emu tool out
pass D-TABLET "libwacom Cintiq 22HD pen and pad paired; GTK GestureStylus saw position, pressure through GNOME's curve, tilt, distance, pen and eraser"

# GNOME's area (calibration matrix) and keep-aspect, then the output key.
tset area "[0.25, 0.25, 0.0, 0.0]"
state '.tablets.tablets[0].area == [0.25, 0.25, 0, 0] and .tablets.tablets[0].calibration[0] == 2' ||
    fail D-TABLET "the area did not reach libinput's calibration: $(jq -c '.tablets.tablets[0]' "$CSTATE")"
AREA_MATRIX="$(jq -c '.tablets.tablets[0].calibration' "$CSTATE")"
mark
emu tool pen
emu pen 0.375 0.5 0
client "$(near 'W * 0.25' 'H * 0.5')" || fail D-TABLET "the area did not remap the pen: $(tail -1 "$CLIENT_LOG")"
emu tool out
tset area "[0.0, 0.0, 0.0, 0.0]"
state '.tablets.tablets[0].calibration == null' || fail D-TABLET "an empty area did not clear the calibration"
tset keep-aspect true
state '.tablets.tablets[0].keep_aspect_ratio > 0' || fail D-TABLET "keep-aspect did not apply"
mark
emu tool pen
emu pen 0.6 0.5 0
client "abs(r['x'] - W * 0.6 * (477 / 269) / (W / H)) <= 4 and abs(r['y'] - H * 0.5) <= 3" ||
    fail D-TABLET "keep-aspect did not stretch the pen to the display's aspect: $(tail -1 "$CLIENT_LOG")"
emu tool out
tset keep-aspect false
gdbus call --session --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
    --method org.gnome.Mutter.DisplayConfig.GetCurrentState >"$ARTIFACTS/tablet-display.txt"
EDID="$(python3 - "$ARTIFACTS/tablet-display.txt" "$CONNECTOR" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
spec = re.search(r"\(\('%s', '([^']*)', '([^']*)', '([^']*)'\)" % re.escape(sys.argv[2]), text)
print("['%s', '%s', '%s']" % spec.groups())
PY
)" || fail D-TABLET "no monitor identity for $CONNECTOR"
tset output "$EDID"
state ".tablets.tablets[0].output == \"$CONNECTOR\"" || fail D-TABLET "output $EDID did not map the tablet to $CONNECTOR"
tset output "['', '', '']"
state '.tablets.tablets[0].output == null' || fail D-TABLET "an empty output did not map the whole desktop"
pass D-TABLET "area calibration $AREA_MATRIX remapped, keep-aspect stretched, output $EDID mapped to $CONNECTOR"

# Stylus actions: switch-monitor cycles the output and shows the OSD;
# keybinding types into the focused client.
sset secondary-button-action switch-monitor
sset button-action keybinding
sset button-keybinding '<Shift>x'
sleep 0.5
emu tool pen
emu pen 0.5 0.5 0
emu stylus BTN_STYLUS2 1
emu stylus BTN_STYLUS2 0
state ".tablets.tablets[0].output == \"$CONNECTOR\"" ||
    fail D-TABLET "switch-monitor did not cycle from all monitors to $CONNECTOR"
[ "$(gsettings get "org.gnome.desktop.peripherals.tablet:$TPATH" output)" = "$EDID" ] ||
    fail D-TABLET "switch-monitor did not store the output: $(gsettings get "org.gnome.desktop.peripherals.tablet:$TPATH" output)"
grep -q "tablet: Wacom Cintiq 22HD switch-monitor to $CONNECTOR" "$TABLET_LOG" || fail D-TABLET "no switch-monitor notification"
mark
emu stylus BTN_STYLUS 1
emu stylus BTN_STYLUS 0
client "r['event'] == 'key' and r['key'] == 'X' and r['shift']" ||
    fail D-TABLET "the stylus keybinding did not type <Shift>x: $(tail -2 "$CLIENT_LOG")"
emu tool out

# Pad actions: a button keybinding, a strip keybinding by direction, and
# switch-monitor (integrated: never the span of all monitors).
pset buttonC action keybinding
pset buttonC keybinding '<Control>b'
pset stripA-up-mode-0 keybinding 'Up'
pset stripA-down-mode-0 keybinding 'Down'
pset buttonD action switch-monitor
sleep 0.5
mark
emu pad 2 1
emu pad 2 0
client "r['event'] == 'key' and r['key'] == 'b' and r['control']" ||
    fail D-TABLET "the pad keybinding did not type <Control>b: $(tail -2 "$CLIENT_LOG")"
mark
emu strip 0 3
emu strip 0 6
client "r['event'] == 'key' and r['key'] == 'Down'" || fail D-TABLET "a strip moving down did not type Down"
mark
emu strip 0 2
emu strip 0 -1
client "r['event'] == 'key' and r['key'] == 'Up'" || fail D-TABLET "a strip moving up did not type Up"
# On an integrated tablet the cycle skips the span of all monitors
# (cycle_logical_monitors): with one monitor it comes back to it.
switches=$(grep -c "switch-monitor to $CONNECTOR" "$TABLET_LOG")
emu pad 3 1
emu pad 3 0
sleep 0.5
[ "$(grep -c "switch-monitor to $CONNECTOR" "$TABLET_LOG")" -eq $((switches + 1)) ] ||
    fail D-TABLET "the integrated tablet's pad switch-monitor did not cycle back to $CONNECTOR"
state ".tablets.tablets[0].output == \"$CONNECTOR\"" || fail D-TABLET "the integrated tablet's pad switch-monitor left $CONNECTOR"
pass D-TABLET "stylus switch-monitor cycled all monitors -> $CONNECTOR and stored it; stylus <Shift>x, pad <Control>b, strip Up/Down typed into the client; pad switch-monitor skipped the span"

# The pad OSD: the help button, then GNOME Settings' D-Bus request.
pset buttonB action help
sleep 0.5
emu pad 1 1
emu pad 1 0
state ".tablets.pad_osd == $PAD_ID and (.layers | any(.namespace == \"tuna-pad-osd\"))" ||
    fail D-TABLET "the help button did not show the pad OSD: $(grep 'pad OSD' "$TABLET_LOG" | tail -2)"
mark
emu pad 2 1
emu pad 2 0
sleep 0.5
client "r['event'] == 'key'" 1 && fail D-TABLET "a pad button reached the client under the pad OSD"
emu key KEY_ESC
state '.tablets.pad_osd == null and (.layers | all(.namespace != "tuna-pad-osd"))' ||
    fail D-TABLET "a key did not close the pad OSD"
if gdbus call --session --dest org.gnome.Shell.Wacom.PadOsd --object-path /org/gnome/Shell/Wacom \
    --method org.gnome.Shell.Wacom.PadOsd.Show /dev/input/event999 false >"$ARTIFACTS/padosd-invalid.txt" 2>&1; then
    fail D-TABLET "PadOsd.Show accepted an unknown device"
fi
grep -q 'Invalid params' "$ARTIFACTS/padosd-invalid.txt" || fail D-TABLET "PadOsd.Show error: $(cat "$ARTIFACTS/padosd-invalid.txt")"
gdbus call --session --dest org.gnome.Shell.Wacom.PadOsd --object-path /org/gnome/Shell/Wacom \
    --method org.gnome.Shell.Wacom.PadOsd.Show "$PAD_NODE" true >"$ARTIFACTS/padosd-show.txt" 2>&1 ||
    fail D-TABLET "PadOsd.Show failed: $(cat "$ARTIFACTS/padosd-show.txt")"
state ".tablets.pad_osd == $PAD_ID and (.layers | any(.namespace == \"tuna-pad-osd\"))" ||
    fail D-TABLET "PadOsd.Show did not open the OSD"
grep -q 'pad OSD for Wacom Cintiq 22HD Pad (.*cintiq-22hd.svg) edition=true' "$TABLET_LOG" ||
    fail D-TABLET "PadOsd.Show did not ask for edition mode"
emu key KEY_ESC
state '.tablets.pad_osd == null' || fail D-TABLET "Escape did not close the edition OSD"
pass D-TABLET "pad OSD shown by the help button and PadOsd.Show (edition), pad buttons captured, closed by a key; unknown device refused"

# Relative mapping: the pen moves on from its last position (the centre,
# where the output check left it), as Mutter's stylus state does.
tset mapping relative
state '.tablets.tablets[0].mapping == "relative"' || fail D-TABLET "relative mapping did not apply"
mark
emu pen 0.9 0.9 0
emu pen 0.905 0.9 0
# GtkGestureStylus reports hovering moves as "proximity".
client "r['event'] == 'proximity' and W * 0.5 < r['x'] < W * 0.6" ||
    fail D-TABLET "relative mode followed the tablet's absolute position: $(tail -2 "$CLIENT_LOG")"
emu tool out
tset mapping absolute

# Hotplug: unplugged and back.
emu unplug
state '(.tablets.tablets | length == 0) and (.tablets.pads | length == 0)' || fail D-TABLET "unplug left devices behind"
emu plug
state '(.tablets.tablets | length == 1) and (.tablets.pads | length == 1)' 15 || fail D-TABLET "replug did not bring the devices back"

# Locked: the lock surface alone hears the pen.
gdbus call --session --dest org.gnome.ScreenSaver --object-path /org/gnome/ScreenSaver \
    --method org.gnome.ScreenSaver.Lock >/dev/null 2>&1 || fail D-TABLET "could not lock"
state '.locked' || fail D-TABLET "the session did not lock"
sleep 1
mark
emu tool pen
emu pen 0.5 0.5 0
emu pen 0.5 0.5 0.5
emu pen 0.5 0.5 0
emu tool out
sleep 0.5
client "r['event'] != 'ready'" 1 && fail D-TABLET "the pen reached the client while locked: $(tail -2 "$CLIENT_LOG")"
pass D-TABLET "relative mapping moved from the cursor; unplug/replug; nothing reached the client while locked"

kill "$CLIENT_PID" 2>/dev/null || true
CLIENT_PID=""
exec 8>&-
wait "$EMU_PID" 2>/dev/null || true
EMU_PID=""
kill -TERM "$COMP_PID"
wait "$COMP_PID" || true
COMP_PID=""
if grep -q panicked "$TABLET_LOG"; then fail D-NOPANIC "panic in the tablet session"; fi

echo "tuna-drm-smoke: OK, artifacts in $ARTIFACTS"
