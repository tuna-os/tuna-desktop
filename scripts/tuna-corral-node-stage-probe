#!/usr/bin/env python3
"""Prepare/execute an explicitly authorized synthetic node-stage tiny proof.

No installed image, VM, service account, registry credential, or full admission.
"""
import argparse
import json
from pathlib import Path
import re
import sys
sys.path.insert(0,str(Path(__file__).resolve().parent/'lib'))
import corral_node_stage as stage
from corral_node_probe import Probe
from corral_perf import node_name


def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--context');p.add_argument('--node');p.add_argument('--namespace',default='corral-vms')
    p.add_argument('--tool-directory',type=Path,required=True)
    p.add_argument('--built-source',required=True);p.add_argument('--publisher-source',required=True)
    p.add_argument('--out',type=Path);p.add_argument('--observer-source');p.add_argument('--execute',action='store_true')
    p.add_argument('--admit-only',action='store_true',help=argparse.SUPPRESS)
    a=p.parse_args()
    if any(not re.fullmatch('[0-9a-f]{40}',s) for s in (a.built_source,a.publisher_source)):p.error('exact source identities required')
    if a.admit_only:
        print(json.dumps(stage.load_tool(a.tool_directory,a.built_source,a.publisher_source)));return
    if not a.execute:p.error('requires separately authorized --execute; --help is read-only')
    if not a.context or a.context.startswith('-') or not a.node or not a.out:p.error('explicit context/node/out required')
    node_name(a.node)
    if not re.fullmatch('[a-z0-9][a-z0-9-]{0,62}',a.namespace):p.error('invalid namespace')
    a.out=a.out.resolve();root=Path(__file__).resolve().parents[1]
    if a.out==root or root in a.out.parents:p.error('proof output must be outside source checkout')
    a.out.mkdir(mode=0o700,parents=True,exist_ok=False)
    probe=Probe(a)
    def admit_observer():
        head=probe.command(['git','-C',str(root),'rev-parse','HEAD']).decode().strip()
        tree=probe.command(['git','-C',str(root),'rev-parse','HEAD^{tree}']).decode().strip()
        clean=probe.command(['git','-C',str(root),'status','--porcelain','--untracked-files=all'])==b''
        if not a.observer_source or not re.fullmatch('[0-9a-f]{40}',a.observer_source) or head!=a.observer_source or not clean:
            raise ValueError('exact clean reviewed observer source required before resources')
        probe.receipt.update(observer_source=head,observer_tree=tree)
    admit_observer()
    # All original GitHub admission runs in an owned bounded child before any
    # Kubernetes command; credentials stay on the host, not in exec payloads.
    raw=probe.command([sys.executable,str(Path(__file__).resolve()),'--admit-only',
                       '--tool-directory',str(a.tool_directory),'--built-source',a.built_source,
                       '--publisher-source',a.publisher_source],credentials=True)
    closure=json.loads(raw);probe.record('admitted-tool.json',closure)
    admit_observer()
    try:
        probe.project_routing()
        receipt=probe.execute(closure)
        if receipt['completed'] is not True:raise RuntimeError('tiny proof incomplete')
        try:admit_observer()
        except BaseException as error:
            receipt.update(completed=False,observer_postcheck_error_type=type(error).__name__);probe.record('receipt.json',receipt);raise
    finally:
        primary=sys.exc_info()[1]
        try:probe.close_routing()
        except BaseException as error:
            probe.receipt.update(completed=False,private_routing_cleanup_error_type=type(error).__name__)
            probe.record('receipt.json',probe.receipt)
            if primary is None:raise
    print(json.dumps(receipt,indent=2))



if __name__=='__main__':main()
