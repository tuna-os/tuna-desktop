#!/bin/sh
# tuna-hero-media — promote the six README heroes from a receipted VM tour.
#
# Usage:
#   scripts/tuna-hero-media RUN --attempt N --expect-merge SHA --expect-head SHA \
#       --expect-tree TREE --expect-source-inputs DIGEST --expect-image sha256:DIGEST \
#       --expect-package DIGEST [--repo OWNER/REPO] [--dest REPOSITORY_OR_STAGING_ROOT]
#
# The normal main CI run must be complete and successful. Authenticated
# marlin-vm evidence and tuna-tour media are reassembled into the original
# receipt-root/tour layout before intake, using the shared bounded downloader.
# Shared intake validates all hashes/outcomes/identities before copying only
# the six canonical heroes. It neither rewrites historical receipts nor changes
# the PNG bytes through recompression. No nested/old footage qualifies as native
# installed proof or signed-release qualification.
set -eu
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
REPO=tuna-os/tuna-desktop
RUN="${1:-}"
[ "$#" -gt 0 ] && shift
case "$RUN" in
    -h|--help|'') sed -n '2,15p' "$0"; exit 0 ;;
esac
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM
# Preserve argument boundaries instead of collecting flags in a shell string.
python3 - "$ROOT" "$WORK" "$REPO" "$RUN" "$@" <<'PROMOTE'
import json
import runpy
from pathlib import Path
import subprocess
import sys
root, work, repo, run, *arguments = sys.argv[1:]
if "--repo" in arguments:
    index = arguments.index("--repo")
    if index + 1 >= len(arguments):
        sys.exit("tuna-hero-media: --repo needs OWNER/REPO")
    repo = arguments[index + 1]
    del arguments[index:index + 2]
def argument(name):
    if name not in arguments or arguments.index(name) + 1 >= len(arguments):
        sys.exit("tuna-hero-media: required " + name)
    return arguments[arguments.index(name) + 1]
refresh = runpy.run_path(str(Path(root) / "scripts/tuna-maintained-media-refresh"))
if repo != refresh["REPOSITORY"]:
    sys.exit("tuna-hero-media: only the trusted repository can promote heroes")
workflow = refresh["api"]("actions/workflows/ci.yml")
refresh["require"](workflow.get("path") == ".github/workflows/ci.yml" and workflow.get("name") == "ci",
                   "unexpected source workflow identity")
source_run = refresh["api"]("actions/runs/" + run)
refresh["inspect_run"](source_run, workflow["id"], int(run), int(argument("--attempt")),
                       argument("--expect-merge"))
refresh["latest_is"](argument("--expect-merge"))
roots, _ = refresh["download_artifacts"](int(run), int(argument("--attempt")),
                                       Path(work), refresh["inventory"](), vm_tour_only=True)
refresh["fetch_source_commits"]([json.loads((roots["marlin-vm"] / "media-source.json").read_bytes())])
subprocess.run([sys.executable, str(Path(root) / "scripts/lib/maintained_media.py"),
                "intake", str(roots["marlin-vm"]), "--bundle", "vm-tour", "--run-id", run, *arguments], check=True)
PROMOTE
