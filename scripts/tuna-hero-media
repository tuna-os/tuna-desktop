#!/bin/sh
# tuna-hero-media — install the README hero set from a CI run.
#
# Usage:
#   scripts/tuna-hero-media <run-id> [--repo OWNER/REPO]
#
# The marlin-vm job boots the real Marlin image and its --tour writes
# 1280x800 stills (T-<section>.png) into the tuna-tour artifact. This
# downloads that artifact for <run-id> and copies the six README stills
# into docs/walkthrough/hero-*.png (recompressed with optipng when it is
# installed), failing if any is missing, or if the tour never saw its
# view on screen (capture-timing.json), so the set is never partial.
# A fresh run: gh workflow run ci.yml --ref main. Then update the
# provenance in docs/walkthrough/README-media.md.
set -eu

unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
REPO=tuna-os/tuna-desktop
RUN=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
        *) RUN="$1"; shift ;;
    esac
done
[ -n "$RUN" ] || { sed -n '2,14p' "$0" >&2; exit 2; }

# hero name:tour still
SET="hero-overview:overview-windows hero-app-grid:app-grid
hero-quick-settings:quick-settings hero-calendar:calendar
hero-switcher:alt-tab hero-lock:lock"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
gh run download "$RUN" --repo "$REPO" --name tuna-tour --dir "$WORK"
for pair in $SET; do
    if [ ! -s "$WORK/T-${pair#*:}.png" ]; then
        echo "tuna-hero-media: run $RUN has no T-${pair#*:}.png" >&2
        exit 1
    fi
done
# The tour lists stills whose view never appeared on screen.
unconfirmed="$(python3 -c 'import json, sys
print(" ".join(json.load(open(sys.argv[1])).get("unconfirmed_stills", [])))' \
    "$WORK/capture-timing.json")"
for pair in $SET; do
    case " $unconfirmed " in
        *" ${pair#*:} "*)
            echo "tuna-hero-media: run $RUN never showed the ${pair#*:} view" >&2
            exit 1 ;;
    esac
done
for pair in $SET; do
    dst="$ROOT/docs/walkthrough/${pair%%:*}.png"
    cp "$WORK/T-${pair#*:}.png" "$dst"
    if command -v optipng >/dev/null 2>&1; then
        optipng -quiet -o2 "$dst"
    fi
done
ls -l "$ROOT"/docs/walkthrough/hero-*.png
