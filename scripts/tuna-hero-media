#!/bin/sh
# tuna-hero-media — promote the six README heroes from a receipted VM tour.
#
# Usage:
#   scripts/tuna-hero-media RUN --attempt N --expect-merge SHA --expect-head SHA \
#       --expect-tree TREE --expect-source-inputs DIGEST --expect-image sha256:DIGEST \
#       --expect-package DIGEST [--repo OWNER/REPO] [--dest REPOSITORY_OR_STAGING_ROOT]
#
# The normal main CI run must be complete and successful. The root-preserving
# tuna-tour artifact must contain media-receipt.json, media-source.json,
# manifest.json, strip-image.json and the actual tour video, timing and stills.
# Shared intake validates all hashes/outcomes/identities before copying only
# the six canonical heroes. It neither rewrites historical receipts nor changes
# the PNG bytes through recompression. No nested/old footage qualifies as native
# installed proof or signed-release qualification.
set -eu
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
REPO=tuna-os/tuna-desktop
RUN="${1:-}"
[ "$#" -gt 0 ] && shift
case "$RUN" in
    -h|--help|'') sed -n '2,15p' "$0"; exit 0 ;;
esac
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM
# Preserve argument boundaries instead of collecting flags in a shell string.
python3 - "$ROOT" "$WORK" "$REPO" "$RUN" "$@" <<'PROMOTE'
import json
from pathlib import Path
import subprocess
import sys
root, work, repo, run, *arguments = sys.argv[1:]
if "--repo" in arguments:
    index = arguments.index("--repo")
    if index + 1 >= len(arguments):
        sys.exit("tuna-hero-media: --repo needs OWNER/REPO")
    repo = arguments[index + 1]
    del arguments[index:index + 2]
def argument(name):
    if name not in arguments or arguments.index(name) + 1 >= len(arguments):
        sys.exit("tuna-hero-media: required " + name)
    return arguments[arguments.index(name) + 1]
status = json.loads(subprocess.check_output([
    "gh", "run", "view", run, "--repo", repo, "--json",
    "databaseId,attempt,headSha,headBranch,status,conclusion,event",
], text=True))
if not (str(status["databaseId"]) == run and str(status["attempt"]) == argument("--attempt")
        and status["headSha"] == argument("--expect-merge")
        and status["headBranch"] == "main" and status["event"] == "push"
        and status["status"] == "completed" and status["conclusion"] == "success"):
    sys.exit("tuna-hero-media: only the exact completed successful normal-main run can promote heroes")
subprocess.run(["gh", "run", "download", run, "--repo", repo,
                "--name", "tuna-tour", "--dir", work], check=True)
subprocess.run([sys.executable, str(Path(root) / "scripts/lib/maintained_media.py"),
                "intake", work, "--bundle", "vm-tour", "--run-id", run, *arguments], check=True)
PROMOTE
