#!/bin/sh
# Capture GNOME 51 itself in the states Tuna Desktop recreates, for pixel parity.
#
# Usage: tuna-gnome-reference [--motion] [--out DIR]
#
# Builds tests/gnome-reference/Containerfile (Fedora 45, GNOME Shell
# 51) with podman, runs gnome-shell headless at 1280x800 with
# capture.js as its automation script, and writes DIR/<state>.png plus
# DIR/<state>.json: every visible styled actor with its class, name,
# rectangle, font and colours. Pair with scripts/tuna-parity-capture
# and scripts/proof-lib/tuna-parity-compare.py.
# --motion runs motion.js instead: GNOME's window effects sampled at fixed
# animation times into DIR/motion.json and frames (default DIR
# target/gnome-reference-motion); scripts/tuna-motion-reference turns them
# into tests/gnome-reference/motion-reference.json. PODMAN overrides the
# podman command (e.g. PODMAN="sudo -n podman").
set -eu
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
OUT=""
SCRIPT=capture.js
DONE='GREF done'
while [ $# -gt 0 ]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --motion) SCRIPT=motion.js; DONE='GREF motion done'; shift ;;
        --help|-h) sed -n '2,17p' "$0"; exit 0 ;;
        *) echo "tuna-gnome-reference: unknown argument $1" >&2; exit 1 ;;
    esac
done
[ -n "$OUT" ] || if [ "$SCRIPT" = motion.js ]; then OUT="$ROOT/target/gnome-reference-motion"; else OUT="$ROOT/target/gnome-reference"; fi
PODMAN="${PODMAN:-podman}"
# shellcheck disable=SC2086 # PODMAN may carry a wrapper such as sudo
command -v ${PODMAN%% *} >/dev/null 2>&1 || { echo "tuna-gnome-reference: needs podman" >&2; exit 1; }
mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
IMAGE=localhost/tuna-gnome51-reference
# shellcheck disable=SC2086
$PODMAN build -q -t "$IMAGE" "$ROOT/tests/gnome-reference" >/dev/null
rm -rf "$OUT"/*.png "$OUT"/*.json "$OUT/share"
# The image identity and GNOME package versions behind these frames.
# shellcheck disable=SC2086
{
    printf 'image %s\n' "$($PODMAN image inspect --format '{{.Id}}' "$IMAGE")"
    $PODMAN run --rm "$IMAGE" rpm -q gnome-shell mutter gtk4 mesa-dri-drivers
} >"$OUT/image.txt"
# The unlock prompt shows the user's name; use the one Tuna Desktop's lock
# screen will show for whoever runs the comparison (GECOS, else login).
USER_NAME="$(getent passwd "$(id -un)" | cut -d: -f5 | cut -d, -f1)"
[ -n "$USER_NAME" ] || USER_NAME="$(id -un)"
# GNOME 51 decodes and encodes images (screenshots, backgrounds) through
# glycin, whose loaders sandbox themselves with bwrap; that needs the user
# namespaces the default container profile denies. GREF_PODMAN_FLAGS
# overrides these run flags.
GREF_PODMAN_FLAGS="${GREF_PODMAN_FLAGS:---security-opt seccomp=unconfined --security-opt apparmor=unconfined --cap-add SYS_ADMIN}"
capture() {
    # shellcheck disable=SC2086
    $PODMAN run --rm $GREF_PODMAN_FLAGS \
        -e GREF_USER_NAME="$USER_NAME" \
        -e GREF_SCRIPT="$SCRIPT" \
        -v "$ROOT/tests/gnome-reference:/gref:ro,Z" \
        -v "$ROOT/scripts/lib:/proof-lib:ro,Z" \
        -v "$OUT:/out:Z" \
        "$IMAGE" /gref/run.sh >"$OUT/gnome-shell.log" 2>&1
}
# A headless gnome-shell occasionally stalls at startup; one retry.
capture || capture || {
    echo "tuna-gnome-reference: gnome-shell failed; see $OUT/gnome-shell.log" >&2
    exit 1
}
grep -q "$DONE" "$OUT/gnome-shell.log" || {
    echo "tuna-gnome-reference: capture incomplete; see $OUT/gnome-shell.log" >&2
    exit 1
}
echo "tuna-gnome-reference: $(find "$OUT" -maxdepth 1 -name '*.png' | wc -l) GNOME 51 frames in $OUT"
