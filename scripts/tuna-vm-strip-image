#!/usr/bin/env python3
"""Produce a CI image receipt from original package and immutable-image inspection."""
import argparse
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / 'scripts/lib'))
from vm_strip_image import admission, canonical_image_id, inspection_program


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--inspection-program', action='store_true')
    parser.add_argument('--canonical-image-id')
    parser.add_argument('--package')
    parser.add_argument('--observed')
    parser.add_argument('--commit')
    parser.add_argument('--capture-commit', help='actual current capture checkout commit')
    parser.add_argument('--product-origin', help='explicit native-product selection.json')
    parser.add_argument('--base-evidence', help='current preselection verified native-base directory')
    parser.add_argument('--image-id')
    parser.add_argument('--base-image')
    parser.add_argument('--out')
    parser.add_argument('--fixture', choices=('lifecycle', 'autotz', 'core-apps'), default='lifecycle')
    args = parser.parse_args()
    if args.canonical_image_id is not None:
        if args.fixture != 'lifecycle' or args.inspection_program or any(getattr(args, name) is not None for name in
                ('package', 'observed', 'commit', 'capture_commit', 'product_origin', 'base_evidence',
                 'image_id', 'base_image', 'out')):
            parser.error('image ID canonicalization requires a separate invocation')
        print(canonical_image_id(args.canonical_image_id))
        return
    if args.inspection_program:
        print(inspection_program(args.fixture), end='')
        return
    if any(getattr(args, name) is None for name in ('package', 'observed', 'commit', 'image_id', 'base_image', 'out')):
        parser.error('complete original package/image/source inputs required')
    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, timeout=5, text=True).strip()
    if head != (args.capture_commit or args.commit):
        raise ValueError('executing checkout differs from exact capture commit')
    origin = None
    if args.product_origin:
        from maintained_media import json_blob
        path = Path(args.product_origin)
        if path.is_symlink() or not path.is_file() or path.stat().st_size > 1048576:
            raise ValueError('invalid explicit product origin file')
        origin = json_blob(path.read_bytes())
    spec = importlib.util.spec_from_file_location('payload', root / 'scripts/lib/tuna-perf-payload.py')
    payload = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(payload)
    package = payload.inspect_package(args.package)
    with open(args.observed, 'rb') as stream:
        raw = stream.read(16385)
    if len(raw) > 16384:
        raise ValueError('image inspection receipt bound exceeded')
    receipt = admission(package, json.loads(raw), root, args.commit, args.image_id, args.base_image,
                        fixture=args.fixture, capture_commit=args.capture_commit, product_origin=origin,
                        base_evidence=args.base_evidence)
    with open(args.out, 'x') as output:
        json.dump(receipt, output, indent=2)
        output.write('\n')


if __name__ == '__main__':
    main()
