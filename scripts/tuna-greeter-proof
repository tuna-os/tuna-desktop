#!/usr/bin/env bash
# tuna-greeter-proof: the Tuna login screen on GDM's greeter API in the
# nested session (#1164, docs/greeter.md, ledger P-LK-03).
#
# Usage:
#   scripts/tuna-greeter-proof [--display :N] [--artifacts DIR]
#
# Binaries: $TUNA_PROOF_BIN_DIR when set, else a cargo build of
# tuna-compositor and tuna-greeter (${CARGO_TARGET_DIR:-target}/debug).
#
# The real `tuna-compositor --greeter` runs nested on Xvfb and supervises
# the real tuna-greeter (TUNA_GREETER_TRACE=1) on a private session bus,
# AT-SPI bus and XDG dirs. GDM's daemon and AccountsService are
# scripts/lib/tuna-gdm-mock.py on a private system bus (a dbus-daemon with
# a permissive test policy) handed to the compositor only as
# DBUS_SYSTEM_BUS_ADDRESS: Manager.OpenSession returns the address of a
# GDBusServer on unix:dir= (GDM's /run/gdm/dbus), whose
# /org/gnome/DisplayManager/Session serves UserVerifier and Greeter as GDM
# 51.1.1 does, with logind and gsd-smartcard alongside, and a control
# interface the proof uses to insert the card or the passkey, install
# gdm-switchable-auth, configure timed login and restart the greeter's
# channel. Users ada, grace, katherine, dorothy (a second factor), mary (a
# running session), annie (a remote session GDM does not manage), hedy (the
# smartcard's), joan (SSSD web login), radia (an SSSD passkey), frances
# (SSSD smartcard certificates) and evelyn (an expired SSSD password) are
# listed; gdm-greeter (system) and mallory (locked) are not.
# The sessions are fixture wayland-sessions Tuna (tuna, GDM's fallback, as
# TunaOS sets FallbackSession=tuna) and GNOME (gnome). NOTIFY_SOCKET is a
# datagram socket of this proof. Gates (assertions.txt carries the ID):
#   G-GREETER-READY      the greeter's layer maps, the compositor sends
#                        READY=1 once, the greeter registers with GDM
#   G-GREETER-USER-LIST  the listed fixture users show (no system or locked
#                        account), each a row with an avatar; ada's is her
#                        AccountsService IconFile, on the list and her prompt
#   G-GREETER-NO-SHELL   only the tuna-greeter layer; no shell process;
#                        Super, the hot corner and Super+L open no
#                        overview and no lock
#   G-GREETER-NOT-LISTED "Not listed?" asks "Username" (visible entry);
#                        the typed name begins gdm-password for it; Back
#                        cancels to the list
#   G-GREETER-GIVE-UP    three wrong passwords (allowed-failures 3) show
#                        GDM's problem each time and return to the list
#   G-GREETER-SESSION    Login Options shows GDM's default Tuna checked;
#                        GNOME goes to SelectSession and is selected again
#                        after the retry's begin; a login without a choice
#                        sends no SelectSession and starts Tuna
#   G-GREETER-WRONG-PASSWORD GDM's problem shows, gdm-password begins
#                        again, and the retry with the right password logs in
#   G-GREETER-PASSWORD   the typed secret reaches AnswerQuery (its SHA-256
#                        matches; it is in no log or artifact)
#   G-GREETER-START      StartSessionWhenReady(gdm-password, true) after
#                        VerificationComplete and SessionOpened
#   G-GREETER-SUPERVISION killing tuna-greeter restarts it (new channel,
#                        user list back); with the restart budget spent the
#                        compositor exits non-zero
#   G-GREETER-MULTISTEP  after dorothy's password GDM asks 'Verification code: '
#                        (InfoQuery): a visible entry at step 2; Back there
#                        resets softly (Cancel, gdm-password begins again for
#                        her, 'Password' at step 1); then the code reaches
#                        AnswerQuery and she logs in
#   G-GREETER-SWITCH-RETURN mary (a running GDM session) is ringed as
#                        logged in; choosing her opens her re-authentication
#                        channel (OpenReauthenticationChannel), gdm-password
#                        runs there, GDM switches to her session with no
#                        new session; users without one get AccessDenied
#                        and verify on the greeter's channel
#   G-GREETER-CONFLICT   annie's remote session conflicts: "Session Already
#                        Running"; Cancel resets at GDM, Force Stop sends
#                        StopConflictingSession and starts once logind
#                        removed the old session
#   G-GREETER-CONFLICT-TIMEOUT the dialog unanswered for 60 s closes with
#                        "Login Attempt Timed Out", resets at GDM (the opened
#                        session closes) and returns to the user list
#   G-GREETER-SMARTCARD  Login Options offers Smartcard; gdm-smartcard says
#                        'Please insert smart card'; gsd-smartcard's token
#                        insertion restarts it; the PIN logs hedy in
#   G-GREETER-CHOICE-LIST GDM's ChoiceList query (two certificates) shows as
#                        a list; the chosen key reaches SelectChoice
#   G-GREETER-WEB-LOGIN  SSSD's CustomJSON auth-mechanisms (eidp first):
#                        "Log In", then the dialog (message, QR code of the
#                        URL, URL, login code, Cancel back to "Log In",
#                        Done); Done replies {"eidp": {}} and joan logs in
#   G-GREETER-PASSKEY    SSSD's passkey without the key: its insert
#                        instruction (Back resets to the list); with the key:
#                        the PIN (hidden) with the attempts warning, then the
#                        touch instruction; the reply carries the PIN,
#                        kerberos and cryptoChallenge; the touch logs radia in
#   G-GREETER-SSSD-SMARTCARD SSSD's smartcard with two certificates: "Select
#                        Identity" lists them by CN; Back at the PIN returns
#                        to the list (no Cancel); the reply names the chosen
#                        certificate with the card's PIN and frances logs in
#   G-GREETER-PASSWORD-EXPIRED SSSD's password is right but expired: pam_sss's
#                        'Password expired. Change your password now.' shows
#                        with 'New Password', then 'Reenter new Password'
#                        (hidden entries, AnswerQuery on gdm-switchable-auth)
#                        and evelyn logs in
#   G-GREETER-POLICY-AUTH enable-password-authentication=false: no Password
#                        mechanism or entry, gdm-smartcard runs instead;
#                        with switchable auth also off no username is
#                        asked (BeginVerification(gdm-smartcard));
#                        enable-smartcard-authentication=false: Login Options
#                        offers Password only and gdm-password runs
#   G-GREETER-TIMED-LOGIN TimedLoginRequested(katherine, 8): after 5 idle
#                        seconds her row counts down 3 s; a key and a click
#                        each start it over; then BeginAutoLogin and
#                        gdm-autologin starts
#   G-GREETER-TIMED-LOGIN-PROMPT with disable-user-list (a restarted
#                        greeter) the countdown runs on the username prompt
#                        and BeginAutoLogin follows
#   G-GREETER-HYGIENE    no password, code or PIN in any artifact; no panic
# Then a second login screen on the same GDM, with GDM 51.1.1's
# org.gnome.login-screen schema (scripts/lib) on the keyfile backend and
# TUNA_SESSION_KIND=hardware (the mock also serves logind's power calls):
#   G-GREETER-POLICY     disable-user-list asks "Username" (no list, no Back);
#                        the banner text and the logo show; allowed-failures
#                        1 gives up after one wrong password; with
#                        disable-user-list off a restarted greeter lists
#   G-GREETER-CAPS-LOCK  Caps Lock shows "Caps lock is on" under the
#                        password entry only, and Caps Lock off hides it
#   G-GREETER-POWER-MENU on hardware "Power Off / Log Out" offers Suspend,
#                        Restart… and Power Off…; Suspend reaches logind;
#                        disable-restart-buttons removes the menu
#   G-GREETER-LIVE-USERS AccountsService's UserAdded adds a row and
#                        UserDeleted removes it, on the list page
#   G-GREETER-RECONNECT  GDM closing the greeter's channel: the greeter asks
#                        for a new one and keeps its list; the begin owed a
#                        result is denied and begins again on the new
#                        channel, where the login completes
# Screenshots (x11grab of the nested window) and AT-SPI dumps for each step;
# A-1-user-list.png, C-1-prompt.png and P-1-policy.png are the review shots
# against GNOME 51's login dialog. Writes assertions.txt and receipt.json;
# exits non-zero naming the failed gate.
set -eu

if [ -z "${TUNA_PROOF_PRIVATE_BUS:-}" ]; then
    TUNA_PROOF_PRIVATE_BUS=1 exec "$(dirname -- "$0")/lib/tuna-proof-session" --bus -- "$0" "$@"
fi
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/greeter-artifacts"
WIDTH=1280
HEIGHT=800
while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --help|-h) sed -n '2,132p' "$0"; exit 0 ;;
        *) echo "tuna-greeter-proof: unknown argument $1" >&2; exit 2 ;;
    esac
done
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
CSTATE="$ARTIFACTS/compositor-state.json"
GDM_LOG="$ARTIFACTS/gdm-calls.jsonl"
NOTIFY_LOG="$ARTIFACTS/notify.log"
: >"$ASSERTIONS"
: >"$LOG"
: >"$GDM_LOG"
: >"$NOTIFY_LOG"
rm -f "$ARTIFACTS/receipt.json" "$CSTATE" "$ARTIFACTS"/*.png "$ARTIFACTS"/a11y-*.json "$ARTIFACTS"/a11y-*.err
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3
ORIG_HOME="$HOME"
BIN_DIR="${TUNA_PROOF_BIN_DIR:-${CARGO_TARGET_DIR:-$ROOT/target}/debug}"

# Private runtime (AF_UNIX paths stay short) and XDG/HOME directories.
RUN_PRIV="$(mktemp -d "${TMPDIR:-/tmp}/tuna-grp.XXXXXX")"
chmod 700 "$RUN_PRIV"
HOME="$ARTIFACTS/home"
XDG_RUNTIME_DIR="$RUN_PRIV"
XDG_CONFIG_HOME="$ARTIFACTS/config"
XDG_DATA_HOME="$ARTIFACTS/data"
XDG_CACHE_HOME="$ARTIFACTS/cache"
XDG_STATE_HOME="$ARTIFACTS/state"
FIXTURE="$ARTIFACTS/fixture"
rm -rf "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$FIXTURE"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" \
    "$FIXTURE/share/wayland-sessions"
# GDM's greeter environment (docs/greeter.md): its own data dir first,
# the supported session types, keyfile settings in the private config.
XDG_DATA_DIRS="$FIXTURE/share:/usr/local/share:/usr/share"
GDM_SUPPORTED_SESSION_TYPES=wayland
GSETTINGS_BACKEND=keyfile
TUNA_COMPOSITOR_STATE="$CSTATE"
TUNA_XWAYLAND=0
export HOME XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME \
    XDG_DATA_DIRS GDM_SUPPORTED_SESSION_TYPES GSETTINGS_BACKEND TUNA_COMPOSITOR_STATE TUNA_XWAYLAND
# GDM's own org.gnome.login-screen (GDM 51.1.1, verbatim), compiled for
# this run; keys are set with gsettings on the keyfile backend.
GSETTINGS_SCHEMA_DIR="$FIXTURE/schemas"
export GSETTINGS_SCHEMA_DIR
unset WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SYSTEM_BUS_ADDRESS AT_SPI_BUS_ADDRESS NOTIFY_SOCKET \
    GDM_MESSAGE_TIME_MULTIPLIER TUNA_GREETER_BIN TUNA_SHELL_BIN XDG_SESSION_ID TUNA_SESSION_KIND

# Secrets of this run only: never written below $ARTIFACTS.
secret() { echo "$1-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"; }
ADA_PASSWORD="$(secret ada)"
GRACE_PASSWORD="$(secret grace)"
KATHERINE_PASSWORD="$(secret katherine)"
WRONG_PASSWORD="$(secret nope)"
DOROTHY_PASSWORD="$(secret dorothy)"
DOROTHY_CODE="$(secret code)"
MARY_PASSWORD="$(secret mary)"
ANNIE_PASSWORD="$(secret annie)"
HEDY_PASSWORD="$(secret hedy)"
JOAN_PASSWORD="$(secret joan)"
CARD_PIN="$(secret pin)"
PASSKEY_PIN="$(secret passkey)"
EVELYN_PASSWORD="$(secret evelyn)"
EVELYN_NEW_PASSWORD="$(secret evelyn-new)"

XVFB_PID=""
ATSPI_PID=""
SYSBUS_PID=""
MOCK_PID=""
NOTIFY_PID=""
COMPOSITOR_PID=""
COMPOSITOR_STATUS=""
GREETER_PID=""
WID=""
CURRENT_GATE="SETUP"
FAILED_GATE=""

pass() {
    echo "$1 pass $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 pass: $2"
}
fail() {
    FAILED_GATE="$1"
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 FAIL: $2" >&2
    tail -40 "$LOG" >&2 2>/dev/null || true
    exit 1
}

# Every process this proof started carries XDG_RUNTIME_DIR=$RUN_PRIV.
owned_pids() {
    : >"$ARTIFACTS/owned-pids.txt"
    for environ in /proc/[0-9]*/environ; do
        pid="${environ#/proc/}"
        pid="${pid%/environ}"
        [ "$pid" = "$$" ] && continue
        if tr '\0' '\n' 2>/dev/null <"$environ" | grep -qxF "XDG_RUNTIME_DIR=$RUN_PRIV"; then
            echo "$pid" >>"$ARTIFACTS/owned-pids.txt"
        fi
    done
}

stop_pid() {
    [ -n "$1" ] || return 0
    kill "$1" 2>/dev/null || return 0
    for _ in $(seq 1 50); do kill -0 "$1" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$1" 2>/dev/null || true
    wait "$1" 2>/dev/null || true
}

finish() {
    status=$?
    set +e
    trap - EXIT INT TERM
    if [ "$status" != 0 ] && [ -z "$FAILED_GATE" ]; then
        FAILED_GATE="$CURRENT_GATE"
        echo "$CURRENT_GATE fail exited with status $status" >>"$ASSERTIONS"
    fi
    [ -s "$CSTATE" ] && cp "$CSTATE" "$ARTIFACTS/final-state.json"
    stop_pid "$COMPOSITOR_PID"
    stop_pid "$MOCK_PID"
    stop_pid "$NOTIFY_PID"
    stop_pid "$SYSBUS_PID"
    stop_pid "$ATSPI_PID"
    stop_pid "$XVFB_PID"
    owned_pids
    swept=""
    while read -r pid; do
        comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo gone)"
        kill "$pid" 2>/dev/null && swept="$swept $pid:$comm"
    done <"$ARTIFACTS/owned-pids.txt"
    [ -n "$swept" ] && sleep 1
    while read -r pid; do kill -9 "$pid" 2>/dev/null; done <"$ARTIFACTS/owned-pids.txt"
    sleep 0.3
    owned_pids
    cp "$ARTIFACTS/owned-pids.txt" "$ARTIFACTS/leftover-pids.txt"
    rm -rf "$RUN_PRIV"
    leftover="$(tr '\n' ' ' <"$ARTIFACTS/leftover-pids.txt")"
    if [ -n "$leftover" ]; then
        echo "CLEANUP fail processes outlived the proof: $leftover" >>"$ASSERTIONS"
        [ -n "$FAILED_GATE" ] || FAILED_GATE=CLEANUP
    fi
    if [ -e "$RUN_PRIV" ]; then
        echo "CLEANUP fail $RUN_PRIV remains" >>"$ASSERTIONS"
        FAILED_GATE="${FAILED_GATE:-CLEANUP}"
    fi
    "$PY" - "$ARTIFACTS" "$ROOT" "$BIN_DIR" "$FAILED_GATE" "$swept" "$COMPOSITOR_STATUS" <<'RECEIPT'
import hashlib, json, pathlib, subprocess, sys
out, root, bins, failed, swept, status = (pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]),
                                          pathlib.Path(sys.argv[3]), sys.argv[4], sys.argv[5].split(), sys.argv[6])
def sha(path):
    try:
        return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
    except OSError:
        return None
def git(*args):
    try:
        return subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
gates = []
for line in (out / 'assertions.txt').read_text().splitlines():
    gate, verdict, detail = (line.split(' ', 2) + ['', ''])[:3]
    gates.append({'gate': gate, 'verdict': verdict, 'detail': detail})
state = git('status', '--porcelain', '--untracked-files=no')
receipt = {
    'proof': 'tuna-greeter-proof', 'issue': 1164, 'ledger': 'P-LK-03',
    'result': 'fail' if failed else 'pass', 'failed_gate': failed or None,
    'source': {'head': git('rev-parse', 'HEAD'), 'dirty': bool(state),
               'status_sha256': hashlib.sha256((state or '').encode()).hexdigest()},
    'binaries': {name: sha(bins / name) for name in ('tuna-compositor', 'tuna-greeter')},
    'fixtures': {name: sha(root / name) for name in (
        'scripts/tuna-greeter-proof', 'scripts/lib/tuna-gdm-mock.py', 'scripts/lib/tuna-a11y-dump.py',
        'scripts/lib/org.gnome.login-screen.gschema.xml')},
    'bin_dir': str(bins), 'gates': gates,
    'compositor_exit_status': int(status) if status.isdigit() else None,
    'review_screenshots': ['A-1-user-list.png', 'C-1-prompt.png', 'C-2-wrong-password.png',
                           'F-2-code.png', 'G-2-conflict.png', 'H-1-insert.png',
                           'H-2-choice.png', 'I-2-web-login.png', 'J-1-policy.png',
                           'K-1-timed.png', 'P-2-pin.png', 'P-3-touch.png', 'S-1-identity.png',
                           'X-2-new.png', 'G-3-timeout.png', 'L-1-prompt-timed.png',
                           'P-1-policy.png'],
    'cleanup': {'swept_pids': swept,
                'leftover_pids': (out / 'leftover-pids.txt').read_text().split()},
    'scope': 'nested winit session on Xvfb; GDM 51 greeter API and AccountsService as a D-Bus '
             'mock on a private system bus; real compositor (--greeter), tuna-greeter, GTK '
             'widgets, X11 input and AT-SPI',
    'not_covered': ['GDM itself: PAM, the session worker, VT handoff and session start',
                    'gnome-session --session gnome-login and tuna-greeter.service (V-GDM-LOGIN)',
                    'DRM hardware, the dynamic greeter user and GDM\'s uid checks',
                    'fingerprint: GDM 51 offers it only for re-authentication and the '
                    'login dialog never starts it (not applicable)',
                    'real SSSD, pam_sss, a smartcard reader, a passkey and an identity provider',
                    'a FIDO2 token plugged in (fido2TokenManager.js watches udev hidraw): '
                    'the greeter does not restart the passkey prompt on its own (not implemented)'],
}
(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
RECEIPT
    if [ -n "$FAILED_GATE" ]; then
        echo "tuna-greeter-proof: FAILED $FAILED_GATE (artifacts in $ARTIFACTS)" >&2
        exit 1
    fi
    echo "tuna-greeter-proof: OK, artifacts in $ARTIFACTS"
    exit 0
}
trap finish EXIT
trap 'exit 130' INT TERM

alive() { [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; }
cstate() {
    end=$(($(date +%s) + ${2:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        alive || return 1
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    return 1
}

# Nested log: `mark` it, then wait for an exact greeter trace line after
# the mark (`twait`); prints the line number.
mark() { wc -l <"$LOG" | tr -d ' '; }
twait() {
    from="$1" text="tuna-greeter: $2" end=$(($(date +%s) + ${3:-20}))
    while :; do
        n="$(tail -n "+$((from + 1))" "$LOG" | grep -n -Fx -m1 -- "$text" | cut -d: -f1 || true)"
        if [ -n "$n" ]; then echo $((from + n)); return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.2
    done
}

# The GDM mock's log: `gmark`, then `gwait MARK JQ [TIMEOUT]` until an
# entry after the mark satisfies the predicate; `gcount MARK JQ` counts.
gmark() { wc -l <"$GDM_LOG" | tr -d ' '; }
gsel() { tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "select($2)"; }
gcount() { gsel "$1" "$2" | wc -l | tr -d ' '; }
gwait() {
    end=$(($(date +%s) + ${3:-20}))
    while :; do
        [ "$(gcount "$1" "$2")" -gt 0 ] && return 0
        [ "$(date +%s)" -ge "$end" ] && return 1
        sleep 0.2
    done
}
call() { echo ".kind == \"call\" and .member == \"$1\"${2:+ and $2}"; }
sig() { echo ".kind == \"signal\" and .member == \"$1\"${2:+ and $2}"; }
# The line (1-based, absolute) of the first entry after MARK matching JQ.
gline() {
    tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "($2)" | grep -n -m1 -x true | cut -d: -f1 |
        { read -r n && echo $(($1 + n)); } || true
}
sha() { printf %s "$1" | sha256sum | cut -d' ' -f1; }

greeter_pid() { pgrep -P "$COMPOSITOR_PID" -x tuna-greeter | head -1 || true; }
# A greeter other than $1 runs (the compositor restarted it).
await_greeter() {
    end=$(($(date +%s) + ${2:-30}))
    while :; do
        pid="$(greeter_pid)"
        if [ -n "$pid" ] && [ "$pid" != "${1:-}" ]; then GREETER_PID="$pid"; return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.1
    done
}

# AT-SPI dump of the running greeter.
dump() {
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-greeter "$ARTIFACTS/a11y-$1.json" 20 \
        --pid "$GREETER_PID" "${@:2}" >/dev/null 2>"$ARTIFACTS/a11y-$1.err" ||
        fail "$CURRENT_GATE" "accessibility dump $1 failed"
}
showing() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
hidden() { ! showing "$@"; }
# shown_within DUMP TEXT SECONDS: dump until TEXT is showing, from now. GDM's
# problem message stays up for about three seconds before a retry clears it,
# and one dump started half a second late can miss it on a loaded host.
shown_within() {
    sw_end=$(($(date +%s%N) / 1000000 + $3 * 1000))
    while :; do
        dump "$1"
        showing "$1" "$2" && return 0
        [ "$(($(date +%s%N) / 1000000))" -ge "$sw_end" ] && return 1
        sleep 0.1
    done
}
role_of() {
    jq -r --arg n "$2" 'first(.[] | select(.name == $n and .showing and .role != "label")) | .role' \
        "$ARTIFACTS/a11y-$1.json"
}
checked() { jq -e --arg n "$2" 'any(.[]; .name == $n and .checked)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
shot() {
    geom="$(xdotool getwindowgeometry --shell "$WID")"
    gx="$(echo "$geom" | sed -n 's/^X=//p')"
    gy="$(echo "$geom" | sed -n 's/^Y=//p')"
    ffmpeg -loglevel error -y -f x11grab -draw_mouse 0 -video_size "${WIDTH}x${HEIGHT}" \
        -i "$DISPLAY+$gx,$gy" -frames:v 1 "$ARTIFACTS/$1.png" ||
        fail "$CURRENT_GATE" "x11grab of the nested window failed for $1"
}
# Choose the INDEXth user of the list with the keyboard, as GDM's list is
# driven: the first row has the focus, Down moves, Return activates. (GTK
# 4.14 adds a GtkStack page's offset twice to its children's AT-SPI
# extents, so the stack's pages are not clicked by their bounds.)
pick_user() {
    for _ in $(seq 1 "$1"); do xdotool key Down; sleep 0.2; done
    xdotool key Return
}
focused() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing and .focused)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
answer() {
    xdotool type --delay 40 "$1"
    xdotool key Return
}

# The mock's controls (the proof's hand on GDM, the card and SSSD).
control() {
    gdbus call --address "$SYS_ADDR" --dest org.gnome.DisplayManager \
        --object-path /org/tuna/Proof/GdmMock --method "org.tuna.Proof.GdmMock.$1" "${@:2}" \
        >/dev/null 2>>"$ARTIFACTS/control.err" || fail "$CURRENT_GATE" "the GDM mock refused $1"
}
# GDM restarts the greeter's channel (the login before it is done); the
# greeter connects again and shows its user list.
new_channel() {
    nc="$(mark)"
    control CloseGreeterChannels
    twait "$nc" "greeter gdm-connected" 20 >/dev/null || fail "$CURRENT_GATE" "the greeter did not reconnect to GDM"
    sleep 1
}
description() {
    jq -r --arg n "$2" 'first(.[] | select(.name == $n and .role == "list item")) | .description' \
        "$ARTIFACTS/a11y-$1.json"
}
# The wall time of the first entry after MARK matching JQ.
wall_of() { gsel "$1" "$2" | head -1 | jq -r .wall; }
# Pixels of screenshot $1 within 24 of the colour R G B ($2 $3 $4).
colour_pixels() {
    "$PY" - "$ARTIFACTS/$1.png" "$2" "$3" "$4" <<'COLOUR'
import sys
from PIL import Image
img = Image.open(sys.argv[1]).convert('RGB')
want = tuple(int(v) for v in sys.argv[2:5])
print(sum(1 for px in img.getdata() if all(abs(a - b) <= 24 for a, b in zip(px, want))))
COLOUR
}

GDM_FAILED="Sorry, password authentication didn’t work. Please try again."

# The user's gdm-password conversation is asking for the password after
# the mark: the mock's SecretInfoQuery, then the entry on screen.
await_password_prompt() {
    gwait "$1" "$(sig SecretInfoQuery '.args == ["gdm-password", "Password: "]')" 20 ||
        fail "$CURRENT_GATE" "GDM's 'Password: ' query never came ($2)"
    sleep 0.5
    dump "$2"
    showing "$2" "Password" || fail "$CURRENT_GATE" "no showing Password entry ($2)"
    [ "$(role_of "$2" Password)" = "password text" ] ||
        fail "$CURRENT_GATE" "the Password entry is not a hidden-text entry ($2)"
}
# Answer the focused password entry of a dump.
type_password() {
    focused "$1" "Password" || fail "$CURRENT_GATE" "the Password entry does not have the keyboard focus ($1)"
    answer "$2"
}

