    fail G-GREETER-NO-SHELL "Super, the hot corner or Super+L changed the login screen: $(jq -c '{overview_open, locked, layers: [.layers[].namespace]}' "$CSTATE")"
pass G-GREETER-NO-SHELL "layers $namespaces only; compositor children: $children; Super, the hot corner and Super+L left overview_open=false and locked=false"

# --- B: Not listed? -----------------------------------------------------
CURRENT_GATE=G-GREETER-NOT-LISTED
m="$(mark)"; g="$(gmark)"
dump B-0-not-listed --press "Not listed?"
twait "$m" "greeter page username" 10 >/dev/null || fail G-GREETER-NOT-LISTED "Not listed? did not ask for a username"
sleep 0.5
dump B-1-username
shot B-1-username
showing B-1-username "Username" || fail G-GREETER-NOT-LISTED "no showing Username entry"
[ "$(role_of B-1-username Username)" != "password text" ] || fail G-GREETER-NOT-LISTED "the Username entry hides its text"
[ "$(gcount "$g" "$(call BeginVerificationForUser)")" = 0 ] ||
    fail G-GREETER-NOT-LISTED "verification began before a username was typed"
answer dave
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "dave"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-NOT-LISTED "the typed username did not begin gdm-password for dave"
await_password_prompt "$g" B-2-password
shot B-2-password
showing B-2-password "dave" || fail G-GREETER-NOT-LISTED "the prompt does not name dave"
m="$(mark)"; g2="$(gmark)"
xdotool key Escape
gwait "$g2" "$(call Cancel)" 10 || fail G-GREETER-NOT-LISTED "Back did not cancel the conversation"
gwait "$g2" "$(sig Reset)" 10 ||
    fail G-GREETER-NOT-LISTED "GDM did not reset the session after Cancel"
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-NOT-LISTED "Back did not return to the user list"
sleep 0.5
dump B-3-back
showing B-3-back "Ada Lovelace" || fail G-GREETER-NOT-LISTED "the user list is not back"
hidden B-3-back "Password" || fail G-GREETER-NOT-LISTED "the prompt still shows"
pass G-GREETER-NOT-LISTED "Not listed? asked 'Username' (visible entry); 'dave' began gdm-password for dave with a hidden Password prompt; Back sent Cancel and returned to the list"

# --- D: allowed-failures --------------------------------------------------
CURRENT_GATE=G-GREETER-GIVE-UP
m="$(mark)"; g="$(gmark)"
pick_user 2
twait "$m" "greeter page prompt user=katherine" 10 >/dev/null || fail G-GREETER-GIVE-UP "the prompt did not open for katherine"
# Each retry's query may arrive while the previous problem is being dumped,
# so it is awaited from before the previous answer, not from the loop's top.
gt="$g"
for try in 1 2 3; do
    await_password_prompt "$gt" "D-$try-password"
    gq="$(gmark)"
    gt="$gq"
    type_password "D-$try-password" "$WRONG_PASSWORD-$try"
    gwait "$gq" "$(call AnswerQuery '.detail.matches_password == false and .detail.user == "katherine"')" 10 ||
        fail G-GREETER-GIVE-UP "wrong answer $try did not reach AnswerQuery"
    gwait "$gq" "$(sig VerificationFailed)" 10 || fail G-GREETER-GIVE-UP "GDM did not fail answer $try"
    shown_within "D-$try-problem" "$GDM_FAILED" 3 ||
        fail G-GREETER-GIVE-UP "GDM's problem is not shown after try $try"
    [ "$try" = 1 ] && shot D-1-problem
done
twait "$m" "greeter give-up" 20 >/dev/null || fail G-GREETER-GIVE-UP "the greeter did not give up after three failures"
twait "$m" "greeter page users" 20 >/dev/null || fail G-GREETER-GIVE-UP "the greeter did not return to the user list"
sleep 1
dump D-4-list
shot D-4-list
showing D-4-list "Katherine Johnson" || fail G-GREETER-GIVE-UP "the user list is not showing"
hidden D-4-list "Password" || fail G-GREETER-GIVE-UP "the prompt still shows after giving up"
begins="$(gcount "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "katherine"]')")"
[ "$begins" = 3 ] || fail G-GREETER-GIVE-UP "$begins begins for katherine instead of 3"
[ "$(gcount "$g" "$(sig VerificationFailed '.args == ["gdm-password"]')")" = 3 ] || fail G-GREETER-GIVE-UP "not three VerificationFailed"
pass G-GREETER-GIVE-UP "three wrong answers each showed '$GDM_FAILED'; after the third (allowed-failures 3) the greeter gave up to the user list with 3 begins in all"

# --- C: wrong password, session choice, retry, start ---------------------
CURRENT_GATE=G-GREETER-SESSION
m="$(mark)"; g="$(gmark)"
pick_user 0
twait "$m" "greeter page prompt user=ada" 10 >/dev/null || fail G-GREETER-SESSION "the prompt did not open for ada"
gwait "$g" "$(sig DefaultSessionNameChanged '.args == ["tuna"]')" 10 ||
    fail G-GREETER-SESSION "GDM's default session (tuna) was not announced"
await_password_prompt "$g" C-1-prompt
shot C-1-prompt
prompt_avatar_px="$(colour_pixels C-1-prompt 255 255 0)"
[ "$prompt_avatar_px" -ge 9000 ] ||
    fail G-GREETER-USER-LIST "ada's avatar image is not on her prompt ($prompt_avatar_px avatar pixels)"
showing C-1-prompt "Ada Lovelace" || fail G-GREETER-SESSION "the prompt does not name Ada Lovelace"
showing C-1-prompt "Login Options" || fail G-GREETER-SESSION "Login Options is not offered on the prompt"
dump C-2-options --press "Login Options"
shot C-2-options
showing C-2-options "Tuna" || fail G-GREETER-SESSION "Login Options does not list Tuna"
showing C-2-options "GNOME" || fail G-GREETER-SESSION "Login Options does not list GNOME"
checked C-2-options "Tuna" || fail G-GREETER-SESSION "GDM's default Tuna is not the checked session"
! checked C-2-options "GNOME" || fail G-GREETER-SESSION "GNOME is checked before it was chosen"
# The menu has the focus on the checked item; GNOME is the one above it.
focused C-2-options "Tuna" || fail G-GREETER-SESSION "the menu's focus is not on the checked Tuna"
gs="$(gmark)"
xdotool key Up
how="Up (a radio group selects as its focus moves)"
if ! gwait "$gs" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 3; then
    xdotool key space
    how="Up, Space"
fi
gwait "$gs" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SESSION "choosing GNOME did not reach SelectSession"
[ "$(gcount "$gs" "$(call SelectSession)")" = 1 ] ||
    fail G-GREETER-SESSION "choosing GNOME sent other SelectSession calls: $(gsel "$gs" "$(call SelectSession)" | jq -c .args)"
sleep 0.5
dump C-3-closed
hidden C-3-closed "Session Type" || fail G-GREETER-SESSION "Login Options stayed open after the choice"
# As GNOME's menus do, closing gives the focus back to the prompt.
focused C-3-closed "Password" || fail G-GREETER-SESSION "the Password entry did not get the focus back after the choice"
dump C-3-gnome --press "Login Options"
checked C-3-gnome "GNOME" || fail G-GREETER-SESSION "GNOME is not checked after choosing it"
! checked C-3-gnome "Tuna" || fail G-GREETER-SESSION "Tuna is still checked after choosing GNOME"
dump C-4-prompt --press "Login Options"
hidden C-4-prompt "Session Type" || fail G-GREETER-SESSION "Login Options did not close"

CURRENT_GATE=G-GREETER-WRONG-PASSWORD
gw="$(gmark)"; m="$(mark)"
type_password C-4-prompt "$WRONG_PASSWORD"
gwait "$gw" "$(call AnswerQuery '.detail.matches_password == false and .detail.user == "ada"')" 10 ||
    fail G-GREETER-WRONG-PASSWORD "the wrong answer did not reach AnswerQuery"
gwait "$gw" "$(sig Problem "(.args == [\"gdm-password\", \"$GDM_FAILED\"])")" 10 ||
    fail G-GREETER-WRONG-PASSWORD "GDM's problem was not sent"
shown_within C-5-wrong-password "$GDM_FAILED" 3 || fail G-GREETER-WRONG-PASSWORD "GDM's problem is not shown"
shot C-2-wrong-password
await_password_prompt "$gw" C-6-retry
gwait "$gw" "$(call BeginVerificationForUser '.args == ["gdm-password", "ada"] and .outcome == "ok"')" 5 ||
    fail G-GREETER-WRONG-PASSWORD "gdm-password did not begin again for ada after the failure"
CURRENT_GATE=G-GREETER-SESSION
gwait "$gw" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SESSION "the chosen GNOME was not selected again after the retry's begin"

CURRENT_GATE=G-GREETER-PASSWORD
gp="$(gmark)"
type_password C-6-retry "$ADA_PASSWORD"
gwait "$gp" "$(call AnswerQuery ".detail.matches_password == true and .detail.user == \"ada\" and .detail.answer_sha256 == \"$(sha "$ADA_PASSWORD")\"")" 10 ||
    fail G-GREETER-PASSWORD "ada's password did not reach AnswerQuery"
pass G-GREETER-PASSWORD "the typed password reached AnswerQuery(gdm-password) on GDM's peer channel (SHA-256 matches ada's)"
CURRENT_GATE=G-GREETER-WRONG-PASSWORD
gwait "$gp" "$(sig VerificationComplete '.args == ["gdm-password"]')" 10 ||
    fail G-GREETER-WRONG-PASSWORD "the retry did not verify"
pass G-GREETER-WRONG-PASSWORD "a wrong password showed '$GDM_FAILED' (C-2-wrong-password.png); gdm-password began again for ada and the retry verified"

CURRENT_GATE=G-GREETER-START
gwait "$gp" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 10 ||
    fail G-GREETER-START "StartSessionWhenReady(gdm-password, true) never came"
opened="$(gline "$gp" "$(sig SessionOpened)")"
complete="$(gline "$gp" "$(sig VerificationComplete)")"
started="$(gline "$gp" "$(call StartSessionWhenReady)")"
if [ -z "$opened" ] || [ -z "$complete" ] || [ "$complete" -ge "$opened" ] || [ "$opened" -ge "$started" ]; then
    fail G-GREETER-START "order VerificationComplete=$complete SessionOpened=$opened StartSessionWhenReady=$started"
fi
[ "$(gcount "$gp" "$(call StartSessionWhenReady)")" = 1 ] || fail G-GREETER-START "StartSessionWhenReady sent more than once"
selected="$(gsel "$gp" "$(call StartSessionWhenReady)" | jq -r '.detail.selected_session')"
CURRENT_GATE=G-GREETER-SESSION
[ "$selected" = gnome ] || fail G-GREETER-SESSION "GDM would start $selected, not the chosen gnome"
pass G-GREETER-START "VerificationComplete, SessionOpened, then one StartSessionWhenReady(gdm-password, true) (GDM log lines $complete, $opened, $started)"

# --- F: a second factor -------------------------------------------------
CURRENT_GATE=G-GREETER-MULTISTEP
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 3
twait "$m" "greeter page prompt user=dorothy" 10 >/dev/null || fail G-GREETER-MULTISTEP "the prompt did not open for dorothy"
await_password_prompt "$g" F-1-password
gq="$(gmark)"
type_password F-1-password "$DOROTHY_PASSWORD"
gwait "$gq" "$(call AnswerQuery '.detail.matches_password == true and .detail.user == "dorothy"')" 10 ||
    fail G-GREETER-MULTISTEP "dorothy's password did not reach AnswerQuery"
gwait "$gq" "$(sig InfoQuery '.args == ["gdm-password", "Verification code: "]')" 10 ||
    fail G-GREETER-MULTISTEP "GDM's second question never came"
twait "$m" "auth query service=password step=2 secret=false question=Verification code" 10 >/dev/null ||
    fail G-GREETER-MULTISTEP "the prompt did not take the code as its second step"
sleep 0.5
dump F-2-code
shot F-2-code
showing F-2-code "Verification code" || fail G-GREETER-MULTISTEP "no showing Verification code entry"
[ "$(role_of F-2-code "Verification code")" != "password text" ] ||
    fail G-GREETER-MULTISTEP "the code entry hides its text (InfoQuery echoes)"
focused F-2-code "Verification code" || fail G-GREETER-MULTISTEP "the code entry does not have the keyboard focus"
hidden F-2-code "Password" || fail G-GREETER-MULTISTEP "the password entry still shows"
# Back at step 2 resets softly (authPrompt.js `cancel` past the first
# step): GDM cancels, gdm-password begins again for dorothy and her prompt
# asks for the password at step 1; the user list does not come back.
gb="$(gmark)"; mb="$(mark)"
xdotool key Escape
gwait "$gb" "$(call Cancel)" 10 || fail G-GREETER-MULTISTEP "Back at step 2 did not cancel at GDM"
gwait "$gb" "$(call BeginVerificationForUser '.args == ["gdm-password", "dorothy"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-MULTISTEP "Back at step 2 did not begin gdm-password again for dorothy"
twait "$mb" "auth query service=password step=1 secret=true question=Password" 10 >/dev/null ||
    fail G-GREETER-MULTISTEP "Back at step 2 did not return to the password at step 1"
await_password_prompt "$gb" F-3-back
shot F-3-back
showing F-3-back "Dorothy Vaughan" || fail G-GREETER-MULTISTEP "after Back the prompt no longer names Dorothy Vaughan"
hidden F-3-back "Verification code" || fail G-GREETER-MULTISTEP "after Back the code entry still shows"
[ "$(tail -n "+$((mb + 1))" "$LOG" | grep -cFx "tuna-greeter: greeter page users")" = 0 ] ||
    fail G-GREETER-MULTISTEP "Back at step 2 returned to the user list (a hard reset)"
gq="$(gmark)"; m="$(mark)"
type_password F-3-back "$DOROTHY_PASSWORD"
gwait "$gq" "$(sig InfoQuery '.args == ["gdm-password", "Verification code: "]')" 10 ||
    fail G-GREETER-MULTISTEP "GDM's second question did not come again"
twait "$m" "auth query service=password step=2 secret=false question=Verification code" 10 >/dev/null ||
    fail G-GREETER-MULTISTEP "the prompt did not take the code as its second step again"
sleep 0.5
dump F-4-code
focused F-4-code "Verification code" || fail G-GREETER-MULTISTEP "the code entry does not have the keyboard focus again"
gc="$(gmark)"
answer "$DOROTHY_CODE"
gwait "$gc" "$(call AnswerQuery ".detail.step == \"code\" and .detail.matches == true and .detail.answer_sha256 == \"$(sha "$DOROTHY_CODE")\"")" 10 ||
    fail G-GREETER-MULTISTEP "the code did not reach AnswerQuery"
gwait "$gc" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 15 ||
    fail G-GREETER-MULTISTEP "dorothy's session did not start"
pass G-GREETER-MULTISTEP "after the password GDM's InfoQuery 'Verification code: ' became step 2 (visible entry, focused, F-2-code.png); Back there reset softly: Cancel, gdm-password began again for dorothy and her prompt asked for the password at step 1 (F-3-back.png); then the code reached AnswerQuery (SHA-256 matches) and dorothy's session started"

# --- F: back to a running session (user switching) ------------------------
CURRENT_GATE=G-GREETER-SWITCH-RETURN
new_channel
denied="$(gcount 0 "$(call OpenReauthenticationChannel '.args == ["ada"] and .outcome == "org.freedesktop.DBus.Error.AccessDenied"')")"
[ "$denied" -ge 1 ] || fail G-GREETER-SWITCH-RETURN "ada's begins did not ask GDM for a re-authentication channel first"
m="$(mark)"; g="$(gmark)"
pick_user 4
twait "$m" "greeter page prompt user=mary" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the prompt did not open for mary"
gwait "$g" "$(call OpenReauthenticationChannel '.args == ["mary"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SWITCH-RETURN "GDM was not asked for mary's re-authentication channel"
# Each begin asks for the channel again (the switchable service's, then,
# after the cascade, gdm-password's): follow the one gdm-password ran on.
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "mary"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SWITCH-RETURN "gdm-password did not begin for mary"
rc="$(gsel "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "mary"]')" | head -1 | jq -r .conn)"
[ "$(gcount "$g" ".kind == \"connect\" and .args == [\"mary\"] and .conn == $rc")" = 1 ] ||
    fail G-GREETER-SWITCH-RETURN "gdm-password did not begin on mary's re-authentication channel"
gwait "$g" "$(call EnableExtensions ".conn == $rc")" 10 || fail G-GREETER-SWITCH-RETURN "the extensions were not enabled on mary's channel"
await_password_prompt "$g" F-3-mary
dump F-4-options --press "Login Options"
hidden F-4-options "Session Type" || fail G-GREETER-SWITCH-RETURN "a logged-in user is offered a session type"
dump F-5-closed --press "Login Options"
gp="$(gmark)"
type_password F-5-closed "$MARY_PASSWORD"
gwait "$gp" "$(sig VerificationComplete ".args == [\"gdm-password\"] and .conn == $rc")" 10 ||
    fail G-GREETER-SWITCH-RETURN "mary's re-authentication did not verify"
gwait "$gp" '.kind == "switch" and .args[0] == "mary" and .args[1] == "7"' 10 ||
    fail G-GREETER-SWITCH-RETURN "GDM did not switch to mary's session"
twait "$m" "greeter reauthenticated user=mary" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the greeter did not see the re-authentication succeed"
sleep 1
[ "$(gcount "$gp" "$(sig SessionOpened)")" = 0 ] || fail G-GREETER-SWITCH-RETURN "a new session was opened for mary"
[ "$(gcount "$gp" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-SWITCH-RETURN "a session was started for mary"
m2="$(mark)"
control ActivateGreeterSession
twait "$m2" "greeter login-screen-activated" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the login screen's activation went unseen"
twait "$m2" "greeter page users" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "back on the login screen, the prompt did not reset"
pass G-GREETER-SWITCH-RETURN "Mary Jackson ringed as logged in; choosing her opened her re-authentication channel (conn $rc), gdm-password verified there, GDM switched to her session 7 with no SessionOpened or StartSessionWhenReady; ada's begins got AccessDenied first ($denied); the login screen reset when active again"

# --- G: a conflicting session -------------------------------------------
CURRENT_GATE=G-GREETER-CONFLICT
CONFLICT_TEXT="Login is not possible because a remote session is already running for annie. To login, you must log out from the remote session or force stop it."
# Cancel, then (G-GREETER-CONFLICT-TIMEOUT) no answer for a minute, then
# Force Stop: annie's session 9 stays until the last.
for try in cancel timeout force; do
    m="$(mark)"; g="$(gmark)"
    pick_user 5
    twait "$m" "greeter page prompt user=annie" 10 >/dev/null || fail G-GREETER-CONFLICT "the prompt did not open for annie"
    await_password_prompt "$g" "G-1-$try"
    gwait "$g" "$(call OpenReauthenticationChannel '.args == ["annie"] and .outcome == "org.freedesktop.DBus.Error.AccessDenied"')" 5 ||
        fail G-GREETER-CONFLICT "annie's unmanaged session got a re-authentication channel"
    type_password "G-1-$try" "$ANNIE_PASSWORD"
    gwait "$g" "$(sig SessionOpened '.args[0] == "gdm-password"')" 10 || fail G-GREETER-CONFLICT "annie's session did not open"
    twait "$m" "greeter conflict user=annie session=9 remote=true" 15 >/dev/null ||
        fail G-GREETER-CONFLICT "the conflicting session was not found"
    gwait "$g" "$(call ListSessions)" 5 || fail G-GREETER-CONFLICT "logind was not asked for the sessions"
    sleep 0.5
    dump "G-2-$try"
    [ "$try" = cancel ] && shot G-2-conflict
    for text in "Session Already Running" "$CONFLICT_TEXT" "Force stopping will quit any running apps and processes, and could result in data loss" "Cancel" "Force Stop"; do
        showing "G-2-$try" "$text" || fail G-GREETER-CONFLICT "'$text' is not showing"
    done
    [ "$(gcount "$g" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-CONFLICT "the session started over a running one"
    ms="$m"; gd="$(gmark)"; m="$(mark)"
    if [ "$try" = cancel ]; then
        dump G-3-cancel --press "Cancel"
        gwait "$gd" "$(call Cancel)" 10 || fail G-GREETER-CONFLICT "Cancel did not reset at GDM"
        gwait "$gd" '.kind == "logind" and .member == "SessionRemoved" and .args != ["9"]' 10 ||
            fail G-GREETER-CONFLICT "the opened session was not closed"
        twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-CONFLICT "Cancel did not return to the user list"
        sleep 1
        [ "$(gcount "$g" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-CONFLICT "a cancelled login started"
    elif [ "$try" = timeout ]; then
        CURRENT_GATE=G-GREETER-CONFLICT-TIMEOUT
        # From the iteration's start: under load the dumps above may
        # outlast the minute.
        twait "$ms" "greeter conflict timed-out" 75 >/dev/null ||
            fail G-GREETER-CONFLICT-TIMEOUT "the unanswered dialog did not time out"
        dump G-3-timeout
        shot G-3-timeout
        showing G-3-timeout "Login Attempt Timed Out: login took too long, please try again" ||
            fail G-GREETER-CONFLICT-TIMEOUT "'Login Attempt Timed Out' is not showing"
        hidden G-3-timeout "Session Already Running" || fail G-GREETER-CONFLICT-TIMEOUT "the dialog still shows"
        # The timeout's Cancel is the first after the session opened.
        go="$(gline "$g" "$(sig SessionOpened '.args[0] == "gdm-password"')")"
        gwait "$go" "$(call Cancel)" 10 || fail G-GREETER-CONFLICT-TIMEOUT "the timeout did not reset at GDM"
        waited="$("$PY" -c "print(round($(wall_of "$go" "$(call Cancel)") - $(wall_of "$g" "$(sig SessionOpened)"), 1))")"
        "$PY" -c "import sys; sys.exit(0 if $waited >= 59.5 else 1)" ||
            fail G-GREETER-CONFLICT-TIMEOUT "the dialog timed out ${waited}s after the session opened, not 60 s"
        gwait "$go" '.kind == "logind" and .member == "SessionRemoved" and .args != ["9"]' 10 ||
            fail G-GREETER-CONFLICT-TIMEOUT "the opened session was not closed"
        twait "$ms" "greeter page users" 10 >/dev/null ||
            fail G-GREETER-CONFLICT-TIMEOUT "the timeout did not return to the user list"
        [ "$(gcount "$g" "$(call StartSessionWhenReady)")" = 0 ] ||
            fail G-GREETER-CONFLICT-TIMEOUT "a timed-out login started"
        [ "$(gcount "$g" "$(call StopConflictingSession)")" = 0 ] ||
            fail G-GREETER-CONFLICT-TIMEOUT "the timeout stopped the other session"
        pass G-GREETER-CONFLICT-TIMEOUT "unanswered, the dialog closed with 'Login Attempt Timed Out: login took too long, please try again' (kept up as GNOME's critical banner, G-3-timeout.png) and GDM got Cancel ${waited}s after the session opened; the opened session closed, session 9 stayed and the user list returned"
        CURRENT_GATE=G-GREETER-CONFLICT
        sleep 1
    else
        dump G-3-force --press "Force Stop"
        gwait "$gd" "$(call StopConflictingSession '.outcome == "ok"')" 10 || fail G-GREETER-CONFLICT "Force Stop did not reach GDM"
        gwait "$gd" '.kind == "logind" and .member == "SessionRemoved" and .args == ["9"]' 10 ||
            fail G-GREETER-CONFLICT "the old session was not stopped"
        gwait "$gd" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 10 ||
            fail G-GREETER-CONFLICT "the session did not start once the old one stopped"
        removed="$(gline "$gd" '.kind == "logind" and .member == "SessionRemoved"')"
        started="$(gline "$gd" "$(call StartSessionWhenReady)")"
        [ "$removed" -lt "$started" ] || fail G-GREETER-CONFLICT "the session started before the old one stopped"
        twait "$m" "greeter conflict stopped session=9" 5 >/dev/null || fail G-GREETER-CONFLICT "the greeter did not see the old session go"
    fi
done
pass G-GREETER-CONFLICT "annie's remote session 9 (no re-authentication channel) conflicted: 'Session Already Running' with GNOME's remote text, Cancel and Force Stop (G-2-conflict.png); Cancel reset at GDM and closed the opened session; Force Stop sent StopConflictingSession and the session started after logind removed session 9"

# --- H: smartcard ----------------------------------------------------------
CURRENT_GATE=G-GREETER-SMARTCARD
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 6
twait "$m" "greeter page prompt user=hedy" 10 >/dev/null || fail G-GREETER-SMARTCARD "the prompt did not open for hedy"
await_password_prompt "$g" H-0-password
dump H-0-options --press "Login Options"
showing H-0-options "Smartcard" || fail G-GREETER-SMARTCARD "Login Options does not offer Smartcard"
checked H-0-options "Password" || fail G-GREETER-SMARTCARD "Password is not the selected mechanism"
gs="$(gmark)"; m="$(mark)"
dump H-0-select --press "Smartcard"
gwait "$gs" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SMARTCARD "choosing Smartcard did not begin gdm-smartcard"
[ -n "$(gline "$gs" "$(call Cancel)")" ] || fail G-GREETER-SMARTCARD "the password conversation was not cancelled first"
gwait "$gs" "$(sig Info '.args == ["gdm-smartcard", "Please insert smart card"]')" 10 ||
    fail G-GREETER-SMARTCARD "gdm-smartcard did not ask for the card"
sleep 1
dump H-1-insert
shot H-1-insert
showing H-1-insert "Please insert smart card" || fail G-GREETER-SMARTCARD "'Please insert smart card' is not showing"
hidden H-1-insert "Password" || fail G-GREETER-SMARTCARD "a Password entry shows for the smartcard"
gi="$(gmark)"; m="$(mark)"
control SetSmartcard true
twait "$m" "greeter smartcard inserted=true" 10 >/dev/null || fail G-GREETER-SMARTCARD "gsd-smartcard's insertion went unseen"
gwait "$gi" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SMARTCARD "the insertion did not restart gdm-smartcard"
CURRENT_GATE=G-GREETER-CHOICE-LIST
gwait "$gi" "$(sig ChoiceQuery '.args[0] == "gdm-smartcard" and .args[1] == "Select a certificate"')" 10 ||
    fail G-GREETER-CHOICE-LIST "GDM's ChoiceQuery never came"
sleep 0.5
dump H-2-choice
shot H-2-choice
for text in "Select a certificate" "Hedy Lamarr (Authentication)" "Hedy Lamarr (Signing)"; do
    showing H-2-choice "$text" || fail G-GREETER-CHOICE-LIST "'$text' is not showing"
done
focused H-2-choice "Hedy Lamarr (Authentication)" || fail G-GREETER-CHOICE-LIST "the list does not have the keyboard focus"
xdotool key Down
sleep 0.2
xdotool key Return
gwait "$gi" "$(call SelectChoice '.args == ["gdm-smartcard", "cert-2"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-CHOICE-LIST "the second certificate did not reach SelectChoice"
pass G-GREETER-CHOICE-LIST "GDM's ChoiceQuery 'Select a certificate' showed as a list of its two choices (H-2-choice.png); Down, Return sent SelectChoice(gdm-smartcard, cert-2)"
CURRENT_GATE=G-GREETER-SMARTCARD
gwait "$gi" "$(sig SecretInfoQuery '.args == ["gdm-smartcard", "PIN for PIV_II: "]')" 10 ||
    fail G-GREETER-SMARTCARD "gdm-smartcard did not ask for the PIN"
sleep 0.5
dump H-3-pin
showing H-3-pin "PIN for PIV_II" || fail G-GREETER-SMARTCARD "no showing PIN entry"
[ "$(role_of H-3-pin "PIN for PIV_II")" = "password text" ] || fail G-GREETER-SMARTCARD "the PIN entry shows its text"
focused H-3-pin "PIN for PIV_II" || fail G-GREETER-SMARTCARD "the PIN entry does not have the keyboard focus"
gp="$(gmark)"
answer "$CARD_PIN"
gwait "$gp" "$(call AnswerQuery ".detail.step == \"pin\" and .detail.matches == true and .detail.answer_sha256 == \"$(sha "$CARD_PIN")\"")" 10 ||
    fail G-GREETER-SMARTCARD "the PIN did not reach AnswerQuery"
gwait "$gp" "$(call StartSessionWhenReady '.args == ["gdm-smartcard", true]')" 15 ||
    fail G-GREETER-SMARTCARD "hedy's smartcard session did not start"
control SetSmartcard false
pass G-GREETER-SMARTCARD "Login Options offered Smartcard; choosing it cancelled gdm-password and began gdm-smartcard, whose 'Please insert smart card' showed without a Password entry (H-1-insert.png); gsd-smartcard's insertion restarted it; the PIN (hidden entry) reached AnswerQuery and gdm-smartcard's session started"

# --- I: web login (SSSD's switchable authentication) -------------------------
CURRENT_GATE=G-GREETER-WEB-LOGIN
control SetSwitchable true
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 7
twait "$m" "greeter page prompt user=joan" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the prompt did not open for joan"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-switchable-auth", "joan"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-WEB-LOGIN "gdm-switchable-auth did not begin"
gwait "$g" "$(sig Request '.args[0] == "gdm-switchable-auth" and .args[1] == "auth-mechanisms"')" 10 ||
    fail G-GREETER-WEB-LOGIN "SSSD's mechanisms were not requested"
twait "$m" "greeter mechanisms list=gdm-switchable-auth:password,gdm-switchable-auth:eidp selected=gdm-switchable-auth:eidp" 10 >/dev/null ||
    fail G-GREETER-WEB-LOGIN "Login Options did not take SSSD's mechanisms with web login first"
twait "$m" "auth ask service=password step=1 kind=button" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "no Log In button"
sleep 0.5
dump I-1-button
shot I-1-button
showing I-1-button "Log In" || fail G-GREETER-WEB-LOGIN "'Log In' is not showing"
m="$(mark)"
dump I-1-press --press "Log In"
twait "$m" "auth ask service=password step=2 kind=web-login" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the web login dialog did not open"
sleep 0.5
dump I-2-web-login
shot I-2-web-login
for text in "Log in online with another device" "https://idp.example.org/device/" "idp.example.org/device" "4219-7730" "Done" "Cancel"; do
    showing I-2-web-login "$text" || fail G-GREETER-WEB-LOGIN "'$text' is not showing"
done
hidden I-2-web-login "Password" || fail G-GREETER-WEB-LOGIN "a Password entry shows with web login"
m="$(mark)"
dump I-3-cancel --press "Cancel"
twait "$m" "auth ask service=password step=1 kind=button" 10 >/dev/null ||
    fail G-GREETER-WEB-LOGIN "the dialog's Cancel did not step back to Log In"
[ "$(gcount "$g" "$(call Reply)")" = 0 ] || fail G-GREETER-WEB-LOGIN "a reply went out before Done"
control ApproveWebLogin true
m="$(mark)"
dump I-4-again --press "Log In"
twait "$m" "auth ask service=password step=2 kind=web-login" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the dialog did not open again"
sleep 0.5
gr="$(gmark)"
dump I-5-done --press "Done"
gwait "$gr" "$(call Reply '.args[0] == "gdm-switchable-auth" and .detail.mechanism == "eidp" and .detail.status == "Ok" and .detail.matches == true')" 10 ||
    fail G-GREETER-WEB-LOGIN "Done did not reply {\"eidp\": {}} to SSSD"
gwait "$gr" "$(call StartSessionWhenReady '.args == ["gdm-switchable-auth", true]')" 15 ||
    fail G-GREETER-WEB-LOGIN "joan's web login did not start her session"
control SetSwitchable false
control ApproveWebLogin false
pass G-GREETER-WEB-LOGIN "SSSD's CustomJSON auth-mechanisms put web login first: 'Log In', then the dialog with GNOME's message, the QR code of https://idp.example.org/device/, the URL as idp.example.org/device and code 4219-7730 (I-2-web-login.png); Cancel stepped back to 'Log In'; Done replied authSelection {status Ok, eidp {}} and gdm-switchable-auth's session started"

# --- I: SSSD's passkey ------------------------------------------------------
CURRENT_GATE=G-GREETER-PASSKEY
control SetSwitchable true
control SetPasskey false
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 8
twait "$m" "greeter page prompt user=radia" 10 >/dev/null || fail G-GREETER-PASSKEY "the prompt did not open for radia"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-switchable-auth", "radia"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-PASSKEY "gdm-switchable-auth did not begin"
gwait "$g" "$(sig Request '.args[1] == "auth-mechanisms" and .args[3].authSelection.mechanisms.passkey.keyConnected == false')" 10 ||
    fail G-GREETER-PASSKEY "SSSD's passkey mechanism (no key) was not requested"
twait "$m" "greeter mechanisms list=gdm-switchable-auth:passkey selected=gdm-switchable-auth:passkey" 10 >/dev/null ||
    fail G-GREETER-PASSKEY "Login Options did not take SSSD's passkey mechanism"
twait "$m" "auth ask service=password step=1 kind=choices" 10 >/dev/null || fail G-GREETER-PASSKEY "no insert-key instruction"
sleep 0.5
dump P-1-insert
shot P-1-insert
showing P-1-insert "Insert your passkey device, then press ENTER." || fail G-GREETER-PASSKEY "the insert-key instruction is not showing"
hidden P-1-insert "Password" || fail G-GREETER-PASSKEY "a Password entry shows for the passkey"
hidden P-1-insert "Security key PIN" || fail G-GREETER-PASSKEY "the PIN is asked without the key"
# Back at the key prompt resets hard (cancelRequested: false).
m="$(mark)"; g="$(gmark)"
xdotool key Escape
gwait "$g" "$(call Cancel)" 10 || fail G-GREETER-PASSKEY "Back did not cancel at GDM"
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-PASSKEY "Back at the key prompt did not return to the list"
control SetPasskey true
sleep 0.5
m="$(mark)"; g="$(gmark)"
pick_user 8
twait "$m" "greeter page prompt user=radia" 10 >/dev/null || fail G-GREETER-PASSKEY "the prompt did not open for radia again"
gwait "$g" "$(sig Request '.args[1] == "auth-mechanisms" and .args[3].authSelection.mechanisms.passkey.keyConnected == true')" 10 ||
    fail G-GREETER-PASSKEY "SSSD's passkey mechanism (key in) was not requested"
twait "$m" "auth query service=password step=1 secret=true question=Security key PIN" 10 >/dev/null ||
    fail G-GREETER-PASSKEY "the passkey's PIN was not asked"
PASSKEY_WARNING="You have 2 attempts left. If the passkey gets locked, you may not able to access your account."
twait "$m" "auth message type=info text=$PASSKEY_WARNING" 10 >/dev/null ||
    fail G-GREETER-PASSKEY "the attempts warning was not queued"
sleep 0.5
dump P-2-pin
shot P-2-pin
showing P-2-pin "Security key PIN" || fail G-GREETER-PASSKEY "no showing PIN entry"
[ "$(role_of P-2-pin "Security key PIN")" = "password text" ] || fail G-GREETER-PASSKEY "the PIN entry shows its text"
focused P-2-pin "Security key PIN" || fail G-GREETER-PASSKEY "the PIN entry does not have the keyboard focus"
showing P-2-pin "$PASSKEY_WARNING" || fail G-GREETER-PASSKEY "the attempts warning is not showing"
gr="$(gmark)"; m="$(mark)"
answer "$PASSKEY_PIN"
gwait "$gr" "$(call Reply '.args[0] == "gdm-switchable-auth" and .detail.mechanism == "passkey" and .detail.status == "Ok" and .detail.matches == true')" 10 ||
    fail G-GREETER-PASSKEY "the reply did not carry the PIN, kerberos and cryptoChallenge"
twait "$m" "auth ask service=password step=2 kind=choices" 10 >/dev/null || fail G-GREETER-PASSKEY "no touch instruction"
sleep 0.5
dump P-3-touch
shot P-3-touch
showing P-3-touch "Touch security key" || fail G-GREETER-PASSKEY "the touch instruction is not showing"
hidden P-3-touch "Security key PIN" || fail G-GREETER-PASSKEY "the PIN entry still shows"
[ "$(gcount "$gr" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-PASSKEY "the session started before the touch"
control TouchPasskey
gwait "$gr" "$(call StartSessionWhenReady '.args == ["gdm-switchable-auth", true]')" 15 ||
    fail G-GREETER-PASSKEY "radia's passkey login did not start her session"
control SetPasskey false
control SetSwitchable false
pass G-GREETER-PASSKEY "SSSD's passkey without the key showed 'Insert your passkey device, then press ENTER.' (P-1-insert.png) and Back reset to the list; with the key the PIN (hidden, P-2-pin.png) came with '$PASSKEY_WARNING'; the reply carried the PIN, kerberos and cryptoChallenge, 'Touch security key' showed (P-3-touch.png) and the touch started radia's session"

# --- I: SSSD's smartcard certificates ---------------------------------------
CURRENT_GATE=G-GREETER-SSSD-SMARTCARD
control SetSwitchable true
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 9
twait "$m" "greeter page prompt user=frances" 10 >/dev/null || fail G-GREETER-SSSD-SMARTCARD "the prompt did not open for frances"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-switchable-auth", "frances"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SSSD-SMARTCARD "gdm-switchable-auth did not begin"
twait "$m" "greeter mechanisms list=gdm-switchable-auth:smartcard selected=gdm-switchable-auth:smartcard" 10 >/dev/null ||
    fail G-GREETER-SSSD-SMARTCARD "Login Options did not take SSSD's smartcard mechanism"
twait "$m" "auth ask service=password step=1 kind=choices" 10 >/dev/null || fail G-GREETER-SSSD-SMARTCARD "no certificate list"
sleep 0.5
dump S-1-identity
shot S-1-identity
for text in "Select Identity" "Frances Allen (Authentication)" "Frances Allen (Signature)" \
    "Certificate for PIV Authentication — IBM" "Certificate for Digital Signature"; do
    showing S-1-identity "$text" || fail G-GREETER-SSSD-SMARTCARD "'$text' is not showing"
done
hidden S-1-identity "Password" || fail G-GREETER-SSSD-SMARTCARD "a Password entry shows for the smartcard"
focused S-1-identity "Frances Allen (Authentication)" || fail G-GREETER-SSSD-SMARTCARD "the list does not have the keyboard focus"
for round in back pin; do
    m="$(mark)"
    xdotool key Down
    sleep 0.2
    xdotool key Return
    twait "$m" "auth query service=password step=2 secret=true question=PIN for PIV_II" 10 >/dev/null ||
        fail G-GREETER-SSSD-SMARTCARD "the chosen certificate's PIN was not asked"
    sleep 0.5
    dump "S-2-$round"
    showing "S-2-$round" "PIN for PIV_II" || fail G-GREETER-SSSD-SMARTCARD "no showing PIN entry"
    [ "$(role_of "S-2-$round" "PIN for PIV_II")" = "password text" ] || fail G-GREETER-SSSD-SMARTCARD "the PIN entry shows its text"
    focused "S-2-$round" "PIN for PIV_II" || fail G-GREETER-SSSD-SMARTCARD "the PIN entry does not have the keyboard focus"
    [ "$round" = pin ] && break
    # Back at the PIN of one of several certificates: the list again,
    # nothing at GDM (cancelRequested steps back).
    gb="$(gmark)"; m="$(mark)"
    xdotool key Escape
    twait "$m" "auth ask service=password step=1 kind=choices" 10 >/dev/null ||
        fail G-GREETER-SSSD-SMARTCARD "Back at the PIN did not return to the certificate list"
    sleep 0.5
    dump S-3-back
    showing S-3-back "Frances Allen (Signature)" || fail G-GREETER-SSSD-SMARTCARD "the certificates are not showing after Back"
    focused S-3-back "Frances Allen (Authentication)" || fail G-GREETER-SSSD-SMARTCARD "the list does not have the focus after Back"
    [ "$(gcount "$gb" "$(call Cancel)")" = 0 ] || fail G-GREETER-SSSD-SMARTCARD "Back at the PIN cancelled at GDM"
done
gr="$(gmark)"
answer "$CARD_PIN"
gwait "$gr" "$(call Reply '.args[0] == "gdm-switchable-auth" and .detail.mechanism == "smartcard:1" and .detail.key_id == "02" and .detail.matches == true')" 10 ||
    fail G-GREETER-SSSD-SMARTCARD "the reply did not name the second certificate with the card's PIN"
gwait "$gr" "$(call StartSessionWhenReady '.args == ["gdm-switchable-auth", true]')" 15 ||
    fail G-GREETER-SSSD-SMARTCARD "frances's smartcard login did not start her session"
control SetSwitchable false
pass G-GREETER-SSSD-SMARTCARD "SSSD's smartcard with two certificates: 'Select Identity' listed them by CN with their descriptions (S-1-identity.png); Back at the PIN returned to the list with no Cancel at GDM; the second certificate's PIN (hidden) went out in a reply naming keyId 02 and frances's session started"

# --- I: an expired SSSD password ---------------------------------------------
CURRENT_GATE=G-GREETER-PASSWORD-EXPIRED
control SetSwitchable true
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 10
twait "$m" "greeter page prompt user=evelyn" 10 >/dev/null || fail G-GREETER-PASSWORD-EXPIRED "the prompt did not open for evelyn"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-switchable-auth", "evelyn"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-PASSWORD-EXPIRED "gdm-switchable-auth did not begin"
twait "$m" "auth query service=password step=1 secret=true question=Password" 10 >/dev/null ||
    fail G-GREETER-PASSWORD-EXPIRED "SSSD's password was not asked"
sleep 0.5
dump X-1-password
gq="$(gmark)"; m="$(mark)"
type_password X-1-password "$EVELYN_PASSWORD"
gwait "$gq" "$(call Reply '.args[0] == "gdm-switchable-auth" and .detail.mechanism == "password" and .detail.matches == true')" 10 ||
    fail G-GREETER-PASSWORD-EXPIRED "evelyn's password did not reach SSSD"
gwait "$gq" "$(sig Info '.args == ["gdm-switchable-auth", "Password expired. Change your password now."]')" 10 ||
    fail G-GREETER-PASSWORD-EXPIRED "pam_sss's expiry notice was not sent"
twait "$m" "auth query service=password step=2 secret=true question=New Password" 10 >/dev/null ||
    fail G-GREETER-PASSWORD-EXPIRED "the new password was not asked"
sleep 0.5
dump X-2-new
shot X-2-new
showing X-2-new "Password expired. Change your password now." || fail G-GREETER-PASSWORD-EXPIRED "the expiry notice is not showing"
showing X-2-new "New Password" || fail G-GREETER-PASSWORD-EXPIRED "no showing New Password entry"
[ "$(role_of X-2-new "New Password")" = "password text" ] || fail G-GREETER-PASSWORD-EXPIRED "the new password shows its text"
focused X-2-new "New Password" || fail G-GREETER-PASSWORD-EXPIRED "the New Password entry does not have the keyboard focus"
for step in new retype; do
    question="New Password"
    [ "$step" = retype ] && question="Reenter new Password"
    if [ "$step" = retype ]; then
        twait "$m" "auth query service=password step=3 secret=true question=$question" 10 >/dev/null ||
            fail G-GREETER-PASSWORD-EXPIRED "the new password was not asked again"
        sleep 0.5
        dump X-3-retype
        [ "$(role_of X-3-retype "$question")" = "password text" ] || fail G-GREETER-PASSWORD-EXPIRED "the retyped password shows its text"
        focused X-3-retype "$question" || fail G-GREETER-PASSWORD-EXPIRED "the $question entry does not have the keyboard focus"
    fi
    ga="$(gmark)"; m="$(mark)"
    answer "$EVELYN_NEW_PASSWORD"
    gwait "$ga" "$(call AnswerQuery ".args[0] == \"gdm-switchable-auth\" and .detail.step == \"$step\" and .detail.matches == true and .detail.answer_sha256 == \"$(sha "$EVELYN_NEW_PASSWORD")\"")" 10 ||
        fail G-GREETER-PASSWORD-EXPIRED "the $step password did not reach AnswerQuery on gdm-switchable-auth"
done
gwait "$gq" "$(call StartSessionWhenReady '.args == ["gdm-switchable-auth", true]')" 15 ||
    fail G-GREETER-PASSWORD-EXPIRED "evelyn's session did not start after the change"
[ "$(gcount "$gq" "$(call Reply)")" = 1 ] || fail G-GREETER-PASSWORD-EXPIRED "the new password went out as JSON"
control SetSwitchable false
pass G-GREETER-PASSWORD-EXPIRED "SSSD's right but expired password: 'Password expired. Change your password now.' showed with a hidden 'New Password' entry at step 2 (X-2-new.png), then 'Reenter new Password' at step 3; both answers went to AnswerQuery(gdm-switchable-auth), not JSON, and evelyn's session started"

# --- J: authentication policy ---------------------------------------------
CURRENT_GATE=G-GREETER-POLICY-AUTH
new_channel
gsettings set org.gnome.login-screen enable-password-authentication false
sleep 1
m="$(mark)"; g="$(gmark)"
pick_user 6
twait "$m" "greeter page prompt user=hedy" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "the prompt did not open for hedy"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 15 ||
    fail G-GREETER-POLICY-AUTH "gdm-smartcard did not begin with passwords disabled"
gwait "$g" "$(sig Info '.args == ["gdm-smartcard", "Please insert smart card"]')" 10 ||
    fail G-GREETER-POLICY-AUTH "gdm-smartcard did not ask for the card"
sleep 1
dump J-1-policy
shot J-1-policy
hidden J-1-policy "Password" || fail G-GREETER-POLICY-AUTH "a Password entry or mechanism shows with passwords disabled"
showing J-1-policy "Please insert smart card" || fail G-GREETER-POLICY-AUTH "the smartcard prompt is not showing"
[ "$(gcount "$g" "$(call BeginVerificationForUser '.args[0] == "gdm-password"')")" = 0 ] ||
    fail G-GREETER-POLICY-AUTH "gdm-password began with passwords disabled"
dump J-2-options --press "Login Options"
showing J-2-options "Smartcard" || fail G-GREETER-POLICY-AUTH "Login Options does not offer Smartcard"
hidden J-2-options "Password" || fail G-GREETER-POLICY-AUTH "Login Options offers Password"
dump J-3-closed --press "Login Options"
gsettings set org.gnome.login-screen enable-switchable-authentication false
sleep 1
m="$(mark)"; g="$(gmark)"
xdotool key Escape
gwait "$g" "$(call BeginVerification '.args == ["gdm-smartcard"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-POLICY-AUTH "smartcard alone did not begin without a username"
twait "$m" "greeter page prompt user=" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "the prompt did not open without a user"
sleep 0.5
dump J-4-no-user
shot J-4-no-user
hidden J-4-no-user "Not listed?" || fail G-GREETER-POLICY-AUTH "the user list shows"
hidden J-4-no-user "Hedy Lamarr" || fail G-GREETER-POLICY-AUTH "the prompt still names hedy"
gsettings reset org.gnome.login-screen enable-password-authentication
gsettings reset org.gnome.login-screen enable-switchable-authentication
sleep 1
m="$(mark)"
xdotool key Escape
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "with passwords back the user list did not return"
# Smartcard off (password on): Login Options offers Password alone.
gsettings set org.gnome.login-screen enable-smartcard-authentication false
sleep 1
m="$(mark)"; g="$(gmark)"
pick_user 6
twait "$m" "greeter page prompt user=hedy" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "the prompt did not open for hedy with smartcards off"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "hedy"] and .outcome == "ok"')" 15 ||
    fail G-GREETER-POLICY-AUTH "gdm-password did not begin with smartcards disabled"
twait "$m" "greeter mechanisms list=gdm-password:password selected=gdm-password:password" 10 >/dev/null ||
    fail G-GREETER-POLICY-AUTH "the mechanisms are not Password alone"
await_password_prompt "$g" J-5-password
dump J-6-options --press "Login Options"
shot J-6-options
checked J-6-options "Password" || fail G-GREETER-POLICY-AUTH "Password is not the selected mechanism"
hidden J-6-options "Smartcard" || fail G-GREETER-POLICY-AUTH "Login Options offers Smartcard with smartcards disabled"
dump J-7-closed --press "Login Options"
[ "$(gcount "$g" "$(call BeginVerificationForUser '.args[0] == "gdm-smartcard"')")" = 0 ] ||
    fail G-GREETER-POLICY-AUTH "gdm-smartcard began with smartcards disabled"
gsettings reset org.gnome.login-screen enable-smartcard-authentication
sleep 1
m="$(mark)"
xdotool key Escape
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "Back did not return to the user list"
pass G-GREETER-POLICY-AUTH "with enable-password-authentication false Login Options offered Smartcard only, no Password entry showed and gdm-smartcard began for hedy (J-1-policy.png); with enable-switchable-authentication false as well no username was asked: BeginVerification(gdm-smartcard) (J-4-no-user.png); with enable-smartcard-authentication false Login Options offered Password only and gdm-password ran (J-6-options.png)"

# --- K: timed login ---------------------------------------------------------
CURRENT_GATE=G-GREETER-TIMED-LOGIN
control SetTimedLogin "'katherine'" 8
m="$(mark)"; g="$(gmark)"
new_channel
gwait "$g" "$(call GetTimedLoginDetails '.outcome == "ok"')" 10 || fail G-GREETER-TIMED-LOGIN "the greeter did not ask for the timed login details"
twait "$m" "greeter timed-login requested user=katherine delay=8" 10 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN "TimedLoginRequested was not taken"
twait "$m" "greeter timed-login indicator user=katherine secs=3" 15 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN "the countdown did not start after 5 idle seconds"
sleep 1
dump K-1-timed
shot K-1-timed
showing K-1-timed "Automatic login" || fail G-GREETER-TIMED-LOGIN "the countdown is not showing"
[ "$(gcount "$g" "$(call BeginAutoLogin)")" = 0 ] || fail G-GREETER-TIMED-LOGIN "auto login began early"
m="$(mark)"
xdotool key Shift_L
twait "$m" "greeter timed-login restart" 5 >/dev/null || fail G-GREETER-TIMED-LOGIN "a key did not start the countdown over"
sleep 0.5
dump K-2-restarted
hidden K-2-restarted "Automatic login" || fail G-GREETER-TIMED-LOGIN "the countdown kept running after a key"
twait "$m" "greeter timed-login indicator user=katherine secs=3" 10 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN "the countdown did not come back after 5 more idle seconds"
# A click on the background starts it over too (the stage's button
# capture).
m="$(mark)"
clicked="$(date +%s.%N)"
xdotool mousemove --window "$WID" 40 $((HEIGHT - 40)) click 1
twait "$m" "greeter timed-login restart" 5 >/dev/null || fail G-GREETER-TIMED-LOGIN "a click did not start the countdown over"
sleep 0.5
dump K-3-clicked
hidden K-3-clicked "Automatic login" || fail G-GREETER-TIMED-LOGIN "the countdown kept running after a click"
gwait "$g" "$(call BeginAutoLogin '.args == ["katherine"] and .outcome == "ok"')" 20 ||
    fail G-GREETER-TIMED-LOGIN "BeginAutoLogin(katherine) never came"
began="$(wall_of "$g" "$(call BeginAutoLogin)")"
waited="$("$PY" -c "print(round($began - $clicked, 2))")"
"$PY" -c "import sys; sys.exit(0 if $waited >= 7.5 else 1)" ||
    fail G-GREETER-TIMED-LOGIN "auto login began ${waited}s after the click, not after the full 8 s"
[ "$(gcount "$g" "$(call BeginAutoLogin)")" = 1 ] || fail G-GREETER-TIMED-LOGIN "auto login began more than once"
gwait "$g" "$(call StartSessionWhenReady '.args == ["gdm-autologin", true]')" 15 ||
    fail G-GREETER-TIMED-LOGIN "gdm-autologin's session did not start"
control SetTimedLogin "''" 0
pass G-GREETER-TIMED-LOGIN "GetTimedLoginDetails answered TimedLoginRequested(katherine, 8); after 5 idle seconds Katherine's row counted down 3 s (K-1-timed.png); a key hid it and started over, and so did a click once it was back; BeginAutoLogin(katherine) came ${waited}s after the click and gdm-autologin's session started"

# --- K: timed login on the prompt (disable-user-list) ------------------------
CURRENT_GATE=G-GREETER-TIMED-LOGIN-PROMPT
# disable-user-list is read when the greeter starts: a restarted one.
gsettings set org.gnome.login-screen disable-user-list true
# Katherine logged out of the session timed login gave her (else it would
# conflict with the next one).
control EndSessions "'katherine'"
control SetTimedLogin "'katherine'" 3
previous="$GREETER_PID"
m="$(mark)"; g="$(gmark)"
kill -KILL "$previous"
await_greeter "$previous" 30 || fail G-GREETER-TIMED-LOGIN-PROMPT "the compositor did not restart the greeter"
twait "$m" "greeter page username" 30 >/dev/null || fail G-GREETER-TIMED-LOGIN-PROMPT "without the user list the username was not asked"
twait "$m" "greeter timed-login indicator user=katherine secs=3" 15 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN-PROMPT "the countdown did not start on the prompt"
# The page's 250 ms crossfade; the bar stays up once the 3 s ran out.
sleep 0.5
dump L-1-prompt-timed
shot L-1-prompt-timed
showing L-1-prompt-timed "Automatic login" || fail G-GREETER-TIMED-LOGIN-PROMPT "the prompt's countdown is not showing"
showing L-1-prompt-timed "Username" || fail G-GREETER-TIMED-LOGIN-PROMPT "the username entry is not showing"
hidden L-1-prompt-timed "Not listed?" || fail G-GREETER-TIMED-LOGIN-PROMPT "the user list shows"
hidden L-1-prompt-timed "Katherine Johnson" || fail G-GREETER-TIMED-LOGIN-PROMPT "a user row shows"
gwait "$g" "$(call BeginAutoLogin '.args == ["katherine"] and .outcome == "ok"')" 15 ||
    fail G-GREETER-TIMED-LOGIN-PROMPT "BeginAutoLogin(katherine) never came"
gwait "$g" "$(call StartSessionWhenReady '.args == ["gdm-autologin", true]')" 15 ||
    fail G-GREETER-TIMED-LOGIN-PROMPT "gdm-autologin's session did not start"
control SetTimedLogin "''" 0
gsettings reset org.gnome.login-screen disable-user-list
pass G-GREETER-TIMED-LOGIN-PROMPT "with disable-user-list the restarted greeter asked for a username and ran TimedLoginRequested(katherine, 3)'s countdown on the prompt (L-1-prompt-timed.png); BeginAutoLogin(katherine) followed and gdm-autologin's session started"

# --- E: supervision, and a login with GDM's default session -------------
CURRENT_GATE=G-GREETER-SUPERVISION
first="$GREETER_PID"
g="$(gmark)"; m="$(mark)"
kill -KILL "$first"
await_greeter "$first" 30 || fail G-GREETER-SUPERVISION "the compositor did not restart a killed greeter"
gwait "$g" '.kind == "disconnect"' 10 || fail G-GREETER-SUPERVISION "the killed greeter's channel did not close"
gwait "$g" "$(call OpenSession)" 20 || fail G-GREETER-SUPERVISION "the restarted greeter did not ask GDM for its channel"
twait "$m" "greeter page users" 30 >/dev/null || fail G-GREETER-SUPERVISION "the restarted greeter did not show the user list"
cstate '.layers | any(.namespace == "tuna-greeter")' 20 || fail G-GREETER-SUPERVISION "the restarted greeter's layer did not map"
sleep 1
dump E-1-restarted
shot E-1-restarted
showing E-1-restarted "Grace Hopper" || fail G-GREETER-SUPERVISION "the restarted greeter's user list is not showing"
[ "$(grep -c ' READY=1$' "$NOTIFY_LOG")" = 1 ] || fail G-GREETER-READY "READY=1 was sent again for a restarted greeter"
restarted="$GREETER_PID"

CURRENT_GATE=G-GREETER-SESSION
m="$(mark)"; g="$(gmark)"
pick_user 1
twait "$m" "greeter page prompt user=grace" 10 >/dev/null || fail G-GREETER-SESSION "the prompt did not open for grace"
await_password_prompt "$g" E-2-prompt
type_password E-2-prompt "$GRACE_PASSWORD"
gwait "$g" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 15 ||
    fail G-GREETER-SESSION "grace's login did not start"
[ "$(gcount "$g" "$(call SelectSession)")" = 0 ] || fail G-GREETER-SESSION "SelectSession was sent without a choice"
selected="$(gsel "$g" "$(call StartSessionWhenReady)" | jq -r '.detail.selected_session')"
[ "$selected" = tuna ] || fail G-GREETER-SESSION "the default login would start $selected, not tuna"
pass G-GREETER-SESSION "Login Options showed GDM's default Tuna checked; GNOME (keys: $how) reached SelectSession, the focus went back to the Password entry, GNOME was re-selected after the retry's begin and was the session started; a login without a choice sent no SelectSession and started tuna"

CURRENT_GATE=G-GREETER-SUPERVISION
kills=1
previous="$restarted"
while alive; do
    kill -KILL "$previous" 2>/dev/null || true
    kills=$((kills + 1))
    [ "$kills" -le 10 ] || fail G-GREETER-SUPERVISION "the compositor outlived $kills greeter kills"
    if ! await_greeter "$previous" 20; then
        break
    fi
    previous="$GREETER_PID"
done
for _ in $(seq 1 100); do alive || break; sleep 0.1; done
alive && fail G-GREETER-SUPERVISION "the compositor is still running after the greeter's budget ran out"
if wait "$COMPOSITOR_PID"; then COMPOSITOR_STATUS=0; else COMPOSITOR_STATUS=$?; fi
COMPOSITOR_PID=""
[ "$COMPOSITOR_STATUS" != 0 ] || fail G-GREETER-SUPERVISION "the compositor exited 0 with the greeter's budget spent"
grep -qF "tuna-compositor: greeter restart budget exhausted; ending the login screen" "$LOG" ||
    fail G-GREETER-SUPERVISION "the compositor did not say the greeter's budget ran out"
pass G-GREETER-SUPERVISION "a killed greeter came back as pid $restarted (was $first) with a new GDM channel and the user list; after $kills kills the budget ran out and the compositor exited $COMPOSITOR_STATUS"

# --- P: login-screen policy, the power menu, live users, GDM restarts ----
# A second login screen on the same GDM and AccountsService: the
# compositor runs as on hardware (TUNA_SESSION_KIND=hardware, the power
# menu's logind is the mock's) and org.gnome.login-screen is set first.
CURRENT_GATE=G-GREETER-POLICY
login_key() {
    gsettings set org.gnome.login-screen "$@" 2>>"$ARTIFACTS/gsettings.err" ||
        fail "$CURRENT_GATE" "gsettings could not set $1"
}
login_key disable-user-list true
login_key allowed-failures 1
login_key banner-message-enable true
login_key banner-message-text "'Authorized use only.'"
login_key logo "'$FIXTURE/logo.png'"
[ -s "$CSTATE" ] && mv "$CSTATE" "$ARTIFACTS/first-state.json"
m="$(mark)"; g="$(gmark)"
env DBUS_SYSTEM_BUS_ADDRESS="$SYS_ADDR" TUNA_SESSION_KIND=hardware \
    TUNA_GREETER_BIN="$BIN_DIR/tuna-greeter" TUNA_GREETER_TRACE=1 RUST_BACKTRACE=1 \
    "$BIN_DIR/tuna-compositor" --backend winit --socket "tuna-greeter-p-$$" --greeter >>"$LOG" 2>&1 &
COMPOSITOR_PID=$!
WID=""
for _ in $(seq 1 90); do
    alive || fail G-GREETER-POLICY "the second compositor exited during startup"
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    [ -n "$WID" ] && break
    sleep 1
done
[ -n "$WID" ] || fail G-GREETER-POLICY "no nested window for the second login screen"
xdotool windowfocus --sync "$WID"
cstate '.layers | any(.namespace == "tuna-greeter")' 120 || fail G-GREETER-POLICY "the greeter's layer never mapped"
await_greeter "" 10 || fail G-GREETER-POLICY "no tuna-greeter child of the second compositor"
USERS_LISTED="ada,grace,katherine,dorothy,mary,annie,hedy,joan,radia,frances,evelyn"
twait "$m" "greeter users names=$USERS_LISTED" 30 >/dev/null || fail G-GREETER-POLICY "the greeter did not load its users"
twait "$m" "greeter page username" 10 >/dev/null || fail G-GREETER-POLICY "disable-user-list did not ask for a username"
tail -n "+$((m + 1))" "$LOG" | grep -qFx "tuna-greeter: greeter page users" &&
    fail G-GREETER-POLICY "the user list showed under disable-user-list"
sleep 1
dump P-1-username
shot P-1-policy
showing P-1-username "Username" || fail G-GREETER-POLICY "no showing Username entry"
for name in "Ada Lovelace" "Not listed?" "Back"; do
    hidden P-1-username "$name" || fail G-GREETER-POLICY "'$name' shows under disable-user-list"
done
showing P-1-username "Authorized use only." || fail G-GREETER-POLICY "the banner text is not showing"
logo_px="$(colour_pixels P-1-policy 255 0 255)"
[ "$logo_px" -ge 1500 ] || fail G-GREETER-POLICY "the logo is not drawn ($logo_px logo pixels)"

CURRENT_GATE=G-GREETER-CAPS-LOCK
xdotool key Caps_Lock
sleep 0.8
dump P-2-caps-username
hidden P-2-caps-username "Caps lock is on" || fail G-GREETER-CAPS-LOCK "the warning shows for the visible Username entry"
xdotool key Caps_Lock
sleep 0.5
g="$(gmark)"
answer katherine
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "katherine"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-CAPS-LOCK "the typed username did not begin gdm-password for katherine"
await_password_prompt "$g" P-3-password
hidden P-3-password "Caps lock is on" || fail G-GREETER-CAPS-LOCK "the warning shows with Caps Lock off"
xdotool key Caps_Lock
sleep 0.8
dump P-4-caps
shot P-4-caps
showing P-4-caps "Caps lock is on" || fail G-GREETER-CAPS-LOCK "Caps Lock on shows no warning under the password entry"
xdotool key Caps_Lock
sleep 0.8
dump P-5-caps-off
hidden P-5-caps-off "Caps lock is on" || fail G-GREETER-CAPS-LOCK "the warning stayed after Caps Lock went off"
pass G-GREETER-CAPS-LOCK "Caps Lock left the visible Username entry without a warning; on the hidden Password entry 'Caps lock is on' showed (P-4-caps.png) and went with Caps Lock off"

CURRENT_GATE=G-GREETER-POLICY
m="$(mark)"; gq="$(gmark)"
type_password P-5-caps-off "$WRONG_PASSWORD"
gwait "$gq" "$(call AnswerQuery '.detail.matches_password == false and .detail.user == "katherine"')" 10 ||
    fail G-GREETER-POLICY "the wrong answer did not reach AnswerQuery"
gwait "$gq" "$(sig VerificationFailed)" 10 || fail G-GREETER-POLICY "GDM did not fail the answer"
twait "$m" "greeter give-up" 20 >/dev/null || fail G-GREETER-POLICY "allowed-failures 1 did not give up after one failure"
twait "$m" "greeter page username" 20 >/dev/null || fail G-GREETER-POLICY "giving up did not return to the username question"
begins="$(gcount "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "katherine"]')")"
[ "$begins" = 1 ] || fail G-GREETER-POLICY "$begins begins for katherine instead of 1"

CURRENT_GATE=G-GREETER-POWER-MENU
sleep 1
dump P-6-panel
showing P-6-panel "Power Off / Log Out" || fail G-GREETER-POWER-MENU "the hardware login screen has no power menu"
dump P-7-power --press "Power Off / Log Out"
sleep 0.8
dump P-8-menu
shot P-8-menu
for item in "Suspend" "Restart…" "Power Off…"; do
    showing P-8-menu "$item" || fail G-GREETER-POWER-MENU "'$item' is not in the power menu"
done
g="$(gmark)"
dump P-9-suspend --press "Suspend"
gwait "$g" "$(call Suspend '.args == [true]')" 10 || fail G-GREETER-POWER-MENU "Suspend did not reach logind"
[ "$(gcount "$g" "$(call Reboot) or $(call PowerOff)")" = 0 ] || fail G-GREETER-POWER-MENU "Suspend also rebooted or powered off"

# GDM restarts a greeter that read other keys: the list and no power menu.
CURRENT_GATE=G-GREETER-POLICY
login_key disable-user-list false
login_key disable-restart-buttons true
gsettings reset org.gnome.login-screen allowed-failures
first="$GREETER_PID"
m="$(mark)"
kill -KILL "$first"
await_greeter "$first" 30 || fail G-GREETER-POLICY "the compositor did not restart the greeter"
twait "$m" "greeter page users" 30 >/dev/null || fail G-GREETER-POLICY "with disable-user-list off the greeter did not list its users"
sleep 1
dump P-10-list
for name in "Ada Lovelace" "Grace Hopper" "Katherine Johnson" "Not listed?"; do
    showing P-10-list "$name" || fail G-GREETER-POLICY "'$name' is not showing with disable-user-list off"
done
pass G-GREETER-POLICY "disable-user-list asked 'Username' with no list, Not listed? or Back; banner 'Authorized use only.' and the logo ($logo_px px) showed (P-1-policy.png); allowed-failures 1 gave up after one wrong password; a greeter started with disable-user-list off listed the users"
CURRENT_GATE=G-GREETER-POWER-MENU
hidden P-10-list "Power Off / Log Out" || fail G-GREETER-POWER-MENU "disable-restart-buttons did not remove the power menu"
pass G-GREETER-POWER-MENU "on hardware 'Power Off / Log Out' offered Suspend, Restart… and Power Off… (P-8-menu.png); Suspend reached logind Suspend(true); under disable-restart-buttons the menu is gone"

CURRENT_GATE=G-GREETER-LIVE-USERS
m="$(mark)"; g="$(gmark)"
control AddUser "'lynn'" "'Lynn Conway'" 1020
gwait "$g" "$(sig UserAdded)" 5 || fail G-GREETER-LIVE-USERS "AccountsService did not announce the new user"
twait "$m" "greeter users names=$USERS_LISTED,lynn" 15 >/dev/null ||
    fail G-GREETER-LIVE-USERS "UserAdded did not add lynn to the list"
sleep 1
dump P-11-added
[ "$(role_of P-11-added "Lynn Conway")" = "list item" ] || fail G-GREETER-LIVE-USERS "Lynn Conway has no row"
m="$(mark)"; g="$(gmark)"
control DeleteUser "'lynn'"
gwait "$g" "$(sig UserDeleted)" 5 || fail G-GREETER-LIVE-USERS "AccountsService did not announce the deleted user"
twait "$m" "greeter users names=$USERS_LISTED" 15 >/dev/null ||
    fail G-GREETER-LIVE-USERS "UserDeleted did not remove lynn from the list"
sleep 1
dump P-12-deleted
hidden P-12-deleted "Lynn Conway" || fail G-GREETER-LIVE-USERS "Lynn Conway's row stayed"
showing P-12-deleted "Ada Lovelace" || fail G-GREETER-LIVE-USERS "the list is not showing"
pass G-GREETER-LIVE-USERS "UserAdded put a Lynn Conway row on the showing list and UserDeleted took it away"

CURRENT_GATE=G-GREETER-RECONNECT
m="$(mark)"; g="$(gmark)"
control CloseGreeterChannels
twait "$m" "greeter gdm-closed" 10 >/dev/null || fail G-GREETER-RECONNECT "the greeter did not see its channel close"
gwait "$g" '.kind == "disconnect"' 10 || fail G-GREETER-RECONNECT "GDM did not close the channel"
gwait "$g" "$(call OpenSession)" 10 || fail G-GREETER-RECONNECT "the greeter did not ask GDM for a new channel"
gwait "$g" '.kind == "connect"' 10 || fail G-GREETER-RECONNECT "the greeter did not connect to the new channel"
twait "$m" "greeter gdm-connected" 10 >/dev/null || fail G-GREETER-RECONNECT "the greeter did not reconnect"
sleep 1
dump P-13-reconnected
showing P-13-reconnected "Grace Hopper" || fail G-GREETER-RECONNECT "the user list is not showing after the reconnect"
# Grace logged out of her earlier session (else it would conflict).
control EndSessions "'grace'"
m="$(mark)"; g="$(gmark)"
pick_user 1
twait "$m" "greeter page prompt user=grace" 10 >/dev/null || fail G-GREETER-RECONNECT "the prompt did not open for grace"
await_password_prompt "$g" P-14-prompt
old="$(gsel "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "grace"]')" | head -1 | jq -r .conn)"
m="$(mark)"; g="$(gmark)"
control CloseGreeterChannels
twait "$m" "greeter gdm-closed" 10 >/dev/null || fail G-GREETER-RECONNECT "the greeter did not see its channel close mid-prompt"
denied=""
for _ in $(seq 1 50); do
    denied="$(tail -n "+$((m + 1))" "$LOG" | grep -E -m1 '^tuna-greeter: auth result service=password request=[0-9]+ applied=false$' || true)"
    [ -n "$denied" ] && break
    sleep 0.2
done
[ -n "$denied" ] || fail G-GREETER-RECONNECT "the begin owed a result was not denied when the channel closed"
gwait "$g" "$(call BeginVerificationForUser ".args == [\"gdm-password\", \"grace\"] and .outcome == \"ok\" and .conn > $old")" 15 ||
    fail G-GREETER-RECONNECT "gdm-password did not begin again for grace on the new channel"
await_password_prompt "$g" P-15-again
gp="$(gmark)"
type_password P-15-again "$GRACE_PASSWORD"
gwait "$gp" "$(call StartSessionWhenReady ".args == [\"gdm-password\", true] and .conn > $old")" 15 ||
    fail G-GREETER-RECONNECT "grace's login did not start on the new channel"
pass G-GREETER-RECONNECT "GDM closed the channel: the greeter asked for a new one (OpenSession, connect) and kept its list; closed mid-prompt, the begin owed a result was denied ('${denied#tuna-greeter: }'), gdm-password began again for grace on the new channel (after conn $old) and her login started there"
stop_pid "$COMPOSITOR_PID"
COMPOSITOR_PID=""
gsettings reset-recursively org.gnome.login-screen

# --- Z: hygiene ---------------------------------------------------------
CURRENT_GATE=G-GREETER-HYGIENE
if grep -rlF -e "$ADA_PASSWORD" -e "$GRACE_PASSWORD" -e "$KATHERINE_PASSWORD" -e "$WRONG_PASSWORD" \
    -e "$DOROTHY_PASSWORD" -e "$DOROTHY_CODE" -e "$MARY_PASSWORD" -e "$ANNIE_PASSWORD" \
    -e "$HEDY_PASSWORD" -e "$JOAN_PASSWORD" -e "$CARD_PIN" -e "$PASSKEY_PIN" \
    -e "$EVELYN_PASSWORD" -e "$EVELYN_NEW_PASSWORD" \
    "$ARTIFACTS" >"$ARTIFACTS/secret-hits.txt" 2>/dev/null; then
    fail G-GREETER-HYGIENE "a secret reached the artifacts: $(tr '\n' ' ' <"$ARTIFACTS/secret-hits.txt")"
fi
grep -qi panicked "$LOG" && fail G-GREETER-HYGIENE "panic in the nested log"
pass G-GREETER-HYGIENE "no password, verification code or PIN in any artifact or log; no panic"
