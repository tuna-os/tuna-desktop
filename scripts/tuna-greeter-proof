#!/usr/bin/env bash
# tuna-greeter-proof: the Tuna login screen on GDM's greeter API in the
# nested session (#1164, docs/greeter.md, ledger P-LK-03).
#
# Usage:
#   scripts/tuna-greeter-proof [--display :N] [--artifacts DIR] [--orca-only]
#
# The default run (gtk-shell CI job) proves every gate below except
# G-GREETER-ORCA, which it skips and says so. --orca-only runs
# G-GREETER-READY then G-GREETER-ORCA only: it needs Orca 50 or later
# (orca-speech CI job, as tuna-orca-speech-proof), since the compositor
# starts Orca without DISPLAY and Orca 46 dies there. Either mode fails
# when one of its gates fails.
#
# Binaries: $TUNA_PROOF_BIN_DIR when set, else a cargo build of
# tuna-compositor and tuna-greeter (${CARGO_TARGET_DIR:-target}/debug).
#
# The real `tuna-compositor --greeter` runs nested on Xvfb and supervises
# the real tuna-greeter (TUNA_GREETER_TRACE=1) on a private session bus,
# AT-SPI bus and XDG dirs. GDM's daemon and AccountsService are
# scripts/lib/tuna-gdm-mock.py on a private system bus (a dbus-daemon with
# a permissive test policy) handed to the compositor only as
# DBUS_SYSTEM_BUS_ADDRESS: Manager.OpenSession returns the address of a
# GDBusServer on unix:dir= (GDM's /run/gdm/dbus), whose
# /org/gnome/DisplayManager/Session serves UserVerifier and Greeter as GDM
# 51.1.1 does for the gdm-password conversation. Users ada, grace and
# katherine are listed; gdm-greeter (system) and mallory (locked) are not.
# The sessions are fixture wayland-sessions Tuna (tuna, GDM's fallback, as
# TunaOS sets FallbackSession=tuna) and GNOME (gnome). NOTIFY_SOCKET is a
# datagram socket of this proof. Gates (assertions.txt carries the ID):
#   G-GREETER-READY      the greeter's layer maps, the compositor sends
#                        READY=1 once, the greeter registers with GDM
#   G-GREETER-USER-LIST  the listed fixture users show (no system or locked
#                        account), each a row with an avatar; ada's is her
#                        AccountsService IconFile, on the list and her prompt
#   G-GREETER-NO-SHELL   only the tuna-greeter layer; no shell process;
#                        Super, the hot corner and Super+L open no
#                        overview and no lock
#   G-GREETER-NOT-LISTED "Not listed?" asks "Username" (visible entry);
#                        the typed name begins gdm-password for it; Back
#                        cancels to the list
#   G-GREETER-GIVE-UP    three wrong passwords (allowed-failures 3) show
#                        GDM's problem each time and return to the list
#   G-GREETER-SESSION    Login Options shows GDM's default Tuna checked;
#                        GNOME goes to SelectSession and is selected again
#                        after the retry's begin; a login without a choice
#                        sends no SelectSession and starts Tuna
#   G-GREETER-WRONG-PASSWORD GDM's problem shows, gdm-password begins
#                        again, and the retry with the right password logs in
#   G-GREETER-PASSWORD   the typed secret reaches AnswerQuery (its SHA-256
#                        matches; it is in no log or artifact)
#   G-GREETER-START      StartSessionWhenReady(gdm-password, true) after
#                        VerificationComplete and SessionOpened
#   G-GREETER-SUPERVISION killing tuna-greeter restarts it (new channel,
#                        user list back); with the restart budget spent the
#                        compositor exits non-zero
#   G-GREETER-HYGIENE    no password in any artifact; no panic
# The login screen's chrome (#1164). The mock also serves logind's power
# calls, localed (us,de), UPower (a 57 % battery) and NetworkManager (wired);
# GDM 51.1.1's org.gnome.login-screen schema (scripts/lib) is installed for
# the greeter, which runs with TUNA_SESSION_KIND=hardware against that bus:
#   G-GREETER-SERVICES   the compositor owns exactly the gdm mode's session-bus
#                        names (DisplayConfig, IdleMonitor, a11y.Manager,
#                        ServiceChannel, ColorManager, Introspect, Screenshot;
#                        no ScreenCast, RemoteDesktop, InputCapture,
#                        SettingsDaemon.Color, SessionManager, IBus bridge)
#   G-GREETER-LOGO       banner text, banner file and logo follow
#                        org.gnome.login-screen live (F-0-chrome.png)
#   G-GREETER-INPUT-SOURCE localed's us,de make the compositor's keymap and
#                        the "Keyboard" indicator; choosing German switches
#                        the layout; the greeter user's own sources win
#   G-GREETER-A11Y-MENU  "Accessibility" (bottom right) lists GNOME's ten
#                        toggles in order; High Contrast restyles, Zoom
#                        turns the compositor's magnifier on, Visual Alerts
#                        and Sticky/Slow/Bounce/Mouse Keys reach the
#                        compositor's bell and keyboard aids
#   G-GREETER-LARGE-TEXT Large Text sets text-scaling-factor 1.25 and the
#                        login screen's text grows
#   G-GREETER-ORCA       (--orca-only) Screen Reader starts the
#                        compositor's Orca, which speaks (speech-dispatcher
#                        log), and stops it
#   G-GREETER-OSK        Screen Keyboard opens the prompt's keyboard on the
#                        password entry; its keys type the answer GDM gets
#   G-GREETER-POWER      quick settings show the battery, the wired
#                        connection and Suspend/Restart…/Power Off…;
#                        Suspend and the end-session dialog's Power Off
#                        reach logind, Cancel does not; disable-restart-
#                        buttons hides all three live
#   G-GREETER-I18N       a second login screen in de_DE.UTF-8 (localedef into
#                        a private LOCPATH) shows gnome-shell's msgids in the
#                        German of a fixture catalog that msgfmt compiled into
#                        the greeter's data dir (G-1-i18n.png)
# Then a second login screen on the same GDM, with org.gnome.login-screen
# set before it starts:
#   G-GREETER-POLICY     disable-user-list asks "Username" (no list, no Back);
#                        the banner text and the logo show; allowed-failures
#                        1 gives up after one wrong password; a greeter
#                        restarted with disable-user-list off lists, and one
#                        started under disable-restart-buttons has no power
#                        button
#   G-GREETER-CAPS-LOCK  Caps Lock shows "Caps lock is on" under the
#                        password entry only, and Caps Lock off hides it
#   G-GREETER-LIVE-USERS AccountsService's UserAdded adds a row and
#                        UserDeleted removes it, on the list page
#   G-GREETER-RECONNECT  GDM closing the greeter's channel: the greeter asks
#                        for a new one and keeps its list; the begin owed a
#                        result is denied and begins again on the new
#                        channel, where the login completes
# Screenshots (x11grab of the nested window) and AT-SPI dumps for each step;
# A-1-user-list.png, C-1-prompt.png, F-0-chrome.png and P-1-policy.png are
# the review shots against GNOME 51's login dialog. Writes assertions.txt
# and receipt.json; exits non-zero naming the failed gate.
set -eu

if [ -z "${TUNA_PROOF_PRIVATE_BUS:-}" ]; then
    TUNA_PROOF_PRIVATE_BUS=1 exec dbus-run-session -- "$0" "$@"
fi
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/greeter-artifacts"
WIDTH=1280
HEIGHT=800
ORCA_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --orca-only) ORCA_ONLY=1; shift ;;
        --help|-h) sed -n '2,112p' "$0"; exit 0 ;;
        *) echo "tuna-greeter-proof: unknown argument $1" >&2; exit 2 ;;
    esac
done
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
CSTATE="$ARTIFACTS/compositor-state.json"
GDM_LOG="$ARTIFACTS/gdm-calls.jsonl"
NOTIFY_LOG="$ARTIFACTS/notify.log"
: >"$ASSERTIONS"
: >"$LOG"
: >"$GDM_LOG"
: >"$NOTIFY_LOG"
rm -f "$ARTIFACTS/receipt.json" "$CSTATE" "$ARTIFACTS"/*.png "$ARTIFACTS"/a11y-*.json "$ARTIFACTS"/a11y-*.err
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3
ORIG_HOME="$HOME"
BIN_DIR="${TUNA_PROOF_BIN_DIR:-${CARGO_TARGET_DIR:-$ROOT/target}/debug}"

# Private runtime (AF_UNIX paths stay short) and XDG/HOME directories.
RUN_PRIV="$(mktemp -d "${TMPDIR:-/tmp}/tuna-grp.XXXXXX")"
chmod 700 "$RUN_PRIV"
HOME="$ARTIFACTS/home"
XDG_RUNTIME_DIR="$RUN_PRIV"
XDG_CONFIG_HOME="$ARTIFACTS/config"
XDG_DATA_HOME="$ARTIFACTS/data"
XDG_CACHE_HOME="$ARTIFACTS/cache"
XDG_STATE_HOME="$ARTIFACTS/state"
FIXTURE="$ARTIFACTS/fixture"
rm -rf "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$FIXTURE"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" \
    "$FIXTURE/share/wayland-sessions"
# GDM's greeter environment (docs/greeter.md): its own data dir first,
# the supported session types, keyfile settings in the private config.
XDG_DATA_DIRS="$FIXTURE/share:/usr/local/share:/usr/share"
GDM_SUPPORTED_SESSION_TYPES=wayland
GSETTINGS_BACKEND=keyfile
TUNA_COMPOSITOR_STATE="$CSTATE"
TUNA_XWAYLAND=0
# GDM 51.1.1's own org.gnome.login-screen schema, unmodified (scripts/lib),
# next to the system's GNOME schemas; the keys are set with gsettings.
mkdir -p "$FIXTURE/schemas"
cp "$ROOT/scripts/lib/org.gnome.login-screen.gschema.xml" "$FIXTURE/schemas/"
glib-compile-schemas "$FIXTURE/schemas" ||
    { echo "tuna-greeter-proof: glib-compile-schemas failed" >&2; exit 1; }
GSETTINGS_SCHEMA_DIR="$FIXTURE/schemas"
# The greeter's logind is the mock's (power actions are offered on
# hardware only); UTF-8 for Orca's speech log and GNOME's ellipses.
TUNA_SESSION_KIND=hardware
LANG=C.UTF-8
export HOME XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME \
    XDG_DATA_DIRS GDM_SUPPORTED_SESSION_TYPES GSETTINGS_BACKEND TUNA_COMPOSITOR_STATE TUNA_XWAYLAND \
    GSETTINGS_SCHEMA_DIR TUNA_SESSION_KIND LANG
unset WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SYSTEM_BUS_ADDRESS AT_SPI_BUS_ADDRESS NOTIFY_SOCKET \
    GDM_MESSAGE_TIME_MULTIPLIER TUNA_GREETER_BIN TUNA_SHELL_BIN LC_ALL LC_MESSAGES LANGUAGE

# Secrets of this run only: never written below $ARTIFACTS.
secret() { echo "$1-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"; }
ADA_PASSWORD="$(secret ada)"
GRACE_PASSWORD="$(secret grace)"
KATHERINE_PASSWORD="$(secret katherine)"
WRONG_PASSWORD="$(secret nope)"

XVFB_PID=""
ATSPI_PID=""
SYSBUS_PID=""
MOCK_PID=""
NOTIFY_PID=""
COMPOSITOR_PID=""
COMPOSITOR_STATUS=""
GREETER_PID=""
WID=""
CURRENT_GATE="SETUP"
FAILED_GATE=""

pass() {
    echo "$1 pass $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 pass: $2"
}
fail() {
    FAILED_GATE="$1"
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 FAIL: $2" >&2
    tail -40 "$LOG" >&2 2>/dev/null || true
    exit 1
}

# Every process this proof started carries XDG_RUNTIME_DIR=$RUN_PRIV.
owned_pids() {
    : >"$ARTIFACTS/owned-pids.txt"
    for environ in /proc/[0-9]*/environ; do
        pid="${environ#/proc/}"
        pid="${pid%/environ}"
        [ "$pid" = "$$" ] && continue
        if tr '\0' '\n' 2>/dev/null <"$environ" | grep -qxF "XDG_RUNTIME_DIR=$RUN_PRIV"; then
            echo "$pid" >>"$ARTIFACTS/owned-pids.txt"
        fi
    done
}

stop_pid() {
    [ -n "$1" ] || return 0
    kill "$1" 2>/dev/null || return 0
    for _ in $(seq 1 50); do kill -0 "$1" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$1" 2>/dev/null || true
    wait "$1" 2>/dev/null || true
}

finish() {
    status=$?
    set +e
    trap - EXIT INT TERM
    if [ "$status" != 0 ] && [ -z "$FAILED_GATE" ]; then
        FAILED_GATE="$CURRENT_GATE"
        echo "$CURRENT_GATE fail exited with status $status" >>"$ASSERTIONS"
    fi
    [ -s "$CSTATE" ] && cp "$CSTATE" "$ARTIFACTS/final-state.json"
    stop_pid "$COMPOSITOR_PID"
    stop_pid "$MOCK_PID"
    stop_pid "$NOTIFY_PID"
    stop_pid "$SYSBUS_PID"
    stop_pid "$ATSPI_PID"
    stop_pid "$XVFB_PID"
    owned_pids
    swept=""
    while read -r pid; do
        comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo gone)"
        kill "$pid" 2>/dev/null && swept="$swept $pid:$comm"
    done <"$ARTIFACTS/owned-pids.txt"
    [ -n "$swept" ] && sleep 1
    while read -r pid; do kill -9 "$pid" 2>/dev/null; done <"$ARTIFACTS/owned-pids.txt"
    sleep 0.3
    owned_pids
    cp "$ARTIFACTS/owned-pids.txt" "$ARTIFACTS/leftover-pids.txt"
    rm -rf "$RUN_PRIV"
    leftover="$(tr '\n' ' ' <"$ARTIFACTS/leftover-pids.txt")"
    if [ -n "$leftover" ]; then
        echo "CLEANUP fail processes outlived the proof: $leftover" >>"$ASSERTIONS"
        [ -n "$FAILED_GATE" ] || FAILED_GATE=CLEANUP
    fi
    if [ -e "$RUN_PRIV" ]; then
        echo "CLEANUP fail $RUN_PRIV remains" >>"$ASSERTIONS"
        FAILED_GATE="${FAILED_GATE:-CLEANUP}"
    fi
    "$PY" - "$ARTIFACTS" "$ROOT" "$BIN_DIR" "$FAILED_GATE" "$swept" "$COMPOSITOR_STATUS" "$ORCA_ONLY" <<'RECEIPT'
import hashlib, json, pathlib, subprocess, sys
out, root, bins, failed, swept, status = (pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]),
                                          pathlib.Path(sys.argv[3]), sys.argv[4], sys.argv[5].split(), sys.argv[6])
orca_only = sys.argv[7] == '1'
def sha(path):
    try:
        return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
    except OSError:
        return None
def git(*args):
    try:
        return subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
gates = []
for line in (out / 'assertions.txt').read_text().splitlines():
    gate, verdict, detail = (line.split(' ', 2) + ['', ''])[:3]
    gates.append({'gate': gate, 'verdict': verdict, 'detail': detail})
state = git('status', '--porcelain', '--untracked-files=no')
receipt = {
    'proof': 'tuna-greeter-proof', 'issue': 1164, 'ledger': 'P-LK-03',
    'mode': 'orca-only' if orca_only else 'default',
    'skipped': [] if orca_only else ['G-GREETER-ORCA: needs Orca 50 or later, run with --orca-only'],
    'result': 'fail' if failed else 'pass', 'failed_gate': failed or None,
    'source': {'head': git('rev-parse', 'HEAD'), 'dirty': bool(state),
               'status_sha256': hashlib.sha256((state or '').encode()).hexdigest()},
    'binaries': {name: sha(bins / name) for name in ('tuna-compositor', 'tuna-greeter')},
    'fixtures': {name: sha(root / name) for name in (
        'scripts/tuna-greeter-proof', 'scripts/lib/tuna-gdm-mock.py', 'scripts/lib/tuna-a11y-dump.py',
        'scripts/lib/org.gnome.login-screen.gschema.xml')},
    'bin_dir': str(bins), 'gates': gates,
    'compositor_exit_status': int(status) if status.isdigit() else None,
    'review_screenshots': [] if orca_only else [
        'A-1-user-list.png', 'C-1-prompt.png', 'C-2-wrong-password.png', 'F-0-chrome.png',
        'F-1-quick-settings.png', 'F-2-a11y-menu.png', 'F-3-end-session.png', 'F-4-osk.png',
        'P-1-policy.png', 'G-1-i18n.png'],
    'cleanup': {'swept_pids': swept,
                'leftover_pids': (out / 'leftover-pids.txt').read_text().split()},
    'scope': 'nested winit session on Xvfb; GDM 51 greeter API and AccountsService as a D-Bus '
             'mock on a private system bus; real compositor (--greeter), tuna-greeter, GTK '
             'widgets, X11 input and AT-SPI',
    'not_covered': ['GDM itself: PAM, the session worker, VT handoff and session start',
                    'gnome-session --session gnome-login and tuna-greeter.service (V-GDM-LOGIN)',
                    'DRM hardware, the dynamic greeter user and GDM\'s uid checks',
                    'fingerprint, smartcard, ChoiceList and CustomJSON web login'],
}
(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
RECEIPT
    if [ -n "$FAILED_GATE" ]; then
        echo "tuna-greeter-proof: FAILED $FAILED_GATE (artifacts in $ARTIFACTS)" >&2
        exit 1
    fi
    echo "tuna-greeter-proof: OK, artifacts in $ARTIFACTS"
    exit 0
}
trap finish EXIT
trap 'exit 130' INT TERM

alive() { [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; }
cstate() {
    end=$(($(date +%s) + ${2:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        alive || return 1
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    return 1
}

# Nested log: `mark` it, then wait for an exact greeter trace line after
# the mark (`twait`); prints the line number.
mark() { wc -l <"$LOG" | tr -d ' '; }
twait() {
    from="$1" text="tuna-greeter: $2" end=$(($(date +%s) + ${3:-20}))
    while :; do
        n="$(tail -n "+$((from + 1))" "$LOG" | grep -n -Fx -m1 -- "$text" | cut -d: -f1 || true)"
        if [ -n "$n" ]; then echo $((from + n)); return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.2
    done
}

# The GDM mock's log: `gmark`, then `gwait MARK JQ [TIMEOUT]` until an
# entry after the mark satisfies the predicate; `gcount MARK JQ` counts.
gmark() { wc -l <"$GDM_LOG" | tr -d ' '; }
gsel() { tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "select($2)"; }
gcount() { gsel "$1" "$2" | wc -l | tr -d ' '; }
gwait() {
    end=$(($(date +%s) + ${3:-20}))
    while :; do
        [ "$(gcount "$1" "$2")" -gt 0 ] && return 0
        [ "$(date +%s)" -ge "$end" ] && return 1
        sleep 0.2
    done
}
call() { echo ".kind == \"call\" and .member == \"$1\"${2:+ and $2}"; }
sig() { echo ".kind == \"signal\" and .member == \"$1\"${2:+ and $2}"; }
# The line (1-based, absolute) of the first entry after MARK matching JQ.
gline() {
    tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "($2)" | grep -n -m1 -x true | cut -d: -f1 |
        { read -r n && echo $(($1 + n)); } || true
}
sha() { printf %s "$1" | sha256sum | cut -d' ' -f1; }

greeter_pid() { pgrep -P "$COMPOSITOR_PID" -x tuna-greeter | head -1 || true; }
# A greeter other than $1 runs (the compositor restarted it).
await_greeter() {
    end=$(($(date +%s) + ${2:-30}))
    while :; do
        pid="$(greeter_pid)"
        if [ -n "$pid" ] && [ "$pid" != "${1:-}" ]; then GREETER_PID="$pid"; return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.1
    done
}

# AT-SPI dump of the running greeter.
dump() {
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-greeter "$ARTIFACTS/a11y-$1.json" 20 \
        --pid "$GREETER_PID" "${@:2}" >/dev/null 2>"$ARTIFACTS/a11y-$1.err" ||
        fail "$CURRENT_GATE" "accessibility dump $1 failed"
}
showing() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
hidden() { ! showing "$@"; }
# shown_within DUMP TEXT SECONDS: dump until TEXT is showing, from now. GDM's
# problem message stays up for about three seconds before a retry clears it,
# and one dump started half a second late can miss it on a loaded host.
shown_within() {
    sw_end=$(($(date +%s%N) / 1000000 + $3 * 1000))
    while :; do
        dump "$1"
        showing "$1" "$2" && return 0
        [ "$(($(date +%s%N) / 1000000))" -ge "$sw_end" ] && return 1
        sleep 0.1
    done
}
role_of() {
    jq -r --arg n "$2" 'first(.[] | select(.name == $n and .showing and .role != "label")) | .role' \
        "$ARTIFACTS/a11y-$1.json"
}
checked() { jq -e --arg n "$2" 'any(.[]; .name == $n and .checked)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
shot() {
    geom="$(xdotool getwindowgeometry --shell "$WID")"
    gx="$(echo "$geom" | sed -n 's/^X=//p')"
    gy="$(echo "$geom" | sed -n 's/^Y=//p')"
    ffmpeg -loglevel error -y -f x11grab -draw_mouse 0 -video_size "${WIDTH}x${HEIGHT}" \
        -i "$DISPLAY+$gx,$gy" -frames:v 1 "$ARTIFACTS/$1.png" ||
        fail "$CURRENT_GATE" "x11grab of the nested window failed for $1"
}
# Choose the INDEXth user of the list with the keyboard, as GDM's list is
# driven: the first row has the focus, Down moves, Return activates. (GTK
# 4.14 adds a GtkStack page's offset twice to its children's AT-SPI
# extents, so the stack's pages are not clicked by their bounds.)
pick_user() {
    for _ in $(seq 1 "$1"); do xdotool key Down; sleep 0.2; done
    xdotool key Return
}
focused() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing and .focused)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
answer() {
    xdotool type --delay 40 "$1"
    xdotool key Return
}

# The mock's controls (the proof's hand on GDM and AccountsService).
control() {
    gdbus call --address "$SYS_ADDR" --dest org.gnome.DisplayManager \
        --object-path /org/tuna/Proof/GdmMock --method "org.tuna.Proof.GdmMock.$1" "${@:2}" \
        >/dev/null 2>>"$ARTIFACTS/control.err" || fail "$CURRENT_GATE" "the GDM mock refused $1"
}
# Pixels of screenshot $1 within 24 of the colour R G B ($2 $3 $4).
colour_pixels() {
    "$PY" - "$ARTIFACTS/$1.png" "$2" "$3" "$4" <<'COLOUR'
import sys
from PIL import Image
img = Image.open(sys.argv[1]).convert('RGB')
want = tuple(int(v) for v in sys.argv[2:5])
print(sum(1 for px in img.getdata() if all(abs(a - b) <= 24 for a, b in zip(px, want))))
COLOUR
}

GDM_FAILED="Sorry, password authentication didn’t work. Please try again."

# The user's gdm-password conversation is asking for the password after
# the mark: the mock's SecretInfoQuery, then the entry on screen.
await_password_prompt() {
    gwait "$1" "$(sig SecretInfoQuery '.args == ["gdm-password", "Password: "]')" 20 ||
        fail "$CURRENT_GATE" "GDM's 'Password: ' query never came ($2)"
    sleep 0.5
    dump "$2"
    showing "$2" "Password" || fail "$CURRENT_GATE" "no showing Password entry ($2)"
    [ "$(role_of "$2" Password)" = "password text" ] ||
        fail "$CURRENT_GATE" "the Password entry is not a hidden-text entry ($2)"
}
# Answer the focused password entry of a dump.
type_password() {
    focused "$1" "Password" || fail "$CURRENT_GATE" "the Password entry does not have the keyboard focus ($1)"
    answer "$2"
}

# --- environment ------------------------------------------------------
# Orca and speech-dispatcher for G-GREETER-ORCA only; x11grab for the rest.
if [ "$ORCA_ONLY" = 1 ]; then
    tools="orca speech-dispatcher"
else
    tools="ffmpeg msgfmt localedef"
fi
for tool in Xvfb xdotool jq gdbus dbus-daemon pgrep sha256sum gsettings glib-compile-schemas $tools; do
    command -v "$tool" >/dev/null 2>&1 || fail SETUP "$tool is required"
done

if [ -x /usr/libexec/at-spi-bus-launcher ]; then
    /usr/libexec/at-spi-bus-launcher --launch-immediately >"$ARTIFACTS/atspi.log" 2>&1 &
    ATSPI_PID=$!
    AT_SPI_BUS_ADDRESS="$("$PY" - <<'AT_SPI_ADDRESS'
import time
from gi.repository import Gio
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
end = time.monotonic() + 10
while True:
    try:
        reply = bus.call_sync('org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Bus', 'GetAddress',
                              None, None, Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        print(reply.unpack()[0])
        break
    except Exception:
        if time.monotonic() >= end:
            raise
        time.sleep(0.1)
AT_SPI_ADDRESS
)" || fail SETUP "the private accessibility bus did not start"
    export AT_SPI_BUS_ADDRESS
else
    fail SETUP "at-spi-bus-launcher is required for the accessibility dumps"
fi

[ -n "$DISPLAY_ARG" ] && DISPLAY="$DISPLAY_ARG" && export DISPLAY
if [ -z "$DISPLAY_ARG" ]; then
    "$ROOT/scripts/lib/tuna-xvfb" -displayfd 3 -screen 0 "${WIDTH}x${HEIGHT}x24" -nolisten tcp \
        3>"$ARTIFACTS/xvfb-display" >"$ARTIFACTS/xvfb.log" 2>&1 &
    XVFB_PID=$!
    for _ in $(seq 1 30); do [ -s "$ARTIFACTS/xvfb-display" ] && break; sleep 0.5; done
    [ -s "$ARTIFACTS/xvfb-display" ] || fail SETUP "Xvfb did not allocate a display"
    DISPLAY=":$(cat "$ARTIFACTS/xvfb-display")"
    export DISPLAY
else
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" -nolisten tcp >"$ARTIFACTS/xvfb.log" 2>&1 &
    XVFB_PID=$!
fi
for _ in $(seq 1 30); do xdotool getdisplaygeometry >/dev/null 2>&1 && break; sleep 0.5; done
xdotool getdisplaygeometry >/dev/null 2>&1 || fail SETUP "no X display at $DISPLAY"
if [ "$ORCA_ONLY" = 1 ]; then
    # As tuna-orca-speech-proof: Orca initialises its AT-SPI device even
    # for --version and segfaults without a display, so ask once one exists.
    orca --version >"$ARTIFACTS/orca-version.txt" 2>&1 || true
    speech-dispatcher --version >"$ARTIFACTS/speechd-version.txt" 2>&1 || true
fi

if [ -z "${TUNA_PROOF_BIN_DIR:-}" ]; then
    RUSTUP_HOME="${RUSTUP_HOME:-$ORIG_HOME/.rustup}" CARGO_HOME="${CARGO_HOME:-$ORIG_HOME/.cargo}" \
        cargo build --locked --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor -p tuna-greeter ||
        fail SETUP "cargo build failed"
fi
for bin in tuna-compositor tuna-greeter; do
    [ -x "$BIN_DIR/$bin" ] || fail SETUP "$BIN_DIR/$bin is missing"
done

# The sessions GDM would offer (gnome-greeter's data dir comes first).
printf '[Desktop Entry]\nName=Tuna\nComment=Tuna Desktop\nExec=tuna-session\nType=Application\n' \
    >"$FIXTURE/share/wayland-sessions/tuna.desktop"
printf '[Desktop Entry]\nName=GNOME\nComment=GNOME\nExec=gnome-session\nType=Application\n' \
    >"$FIXTURE/share/wayland-sessions/gnome.desktop"
# Hide the host's other sessions as libgdm honours it (an earlier data
# dir's Hidden=true file wins), so the menu is GNOME then Tuna everywhere.
for desktop in /usr/local/share/wayland-sessions/*.desktop /usr/share/wayland-sessions/*.desktop; do
    [ -e "$desktop" ] || continue
    case "${desktop##*/}" in tuna.desktop | gnome.desktop) continue ;; esac
    printf '[Desktop Entry]\nName=hidden\nType=Application\nHidden=true\n' \
        >"$FIXTURE/share/wayland-sessions/${desktop##*/}"
done
cat >"$FIXTURE/users.json" <<'USERS'
[
  {"name": "ada", "real_name": "Ada Lovelace", "uid": 1001, "icon": "ada.png"},
  {"name": "grace", "real_name": "Grace Hopper", "uid": 1002},
  {"name": "katherine", "real_name": "Katherine Johnson", "uid": 1003},
  {"name": "gdm-greeter", "real_name": "GDM Greeter", "uid": 60578, "system": true},
  {"name": "mallory", "real_name": "Locked Account", "uid": 1004, "locked": true}
]
USERS
printf 'ada:%s\ngrace:%s\nkatherine:%s\n' "$ADA_PASSWORD" "$GRACE_PASSWORD" "$KATHERINE_PASSWORD" \
    >"$RUN_PRIV/secrets"
chmod 600 "$RUN_PRIV/secrets"
gsettings get org.gnome.login-screen enable-password-authentication >/dev/null ||
    fail SETUP "org.gnome.login-screen is not readable"
# ada's avatar (solid yellow): a colour the screenshots find.
"$PY" - "$FIXTURE" <<'IMAGES' || fail SETUP "the avatar fixture could not be drawn"
import sys
from PIL import Image
Image.new('RGB', (96, 96), (255, 255, 0)).save(f'{sys.argv[1]}/ada.png')
IMAGES

# speech-dispatcher, autospawned by the compositor's Orca with this
# configuration (as tuna-orca-speech-proof): one generic module whose
# "synthesis" appends each utterance, UTF-8, to spoken.log.
SPOKEN="$ARTIFACTS/spoken.log"
: >"$SPOKEN"
mkdir -p "$XDG_CONFIG_HOME/speech-dispatcher/modules" "$ARTIFACTS/speechd"
cat >"$XDG_CONFIG_HOME/speech-dispatcher/speechd.conf" <<CONF
LogLevel 3
LogDir "$ARTIFACTS/speechd"
AudioOutputMethod "alsa"
AddModule "tunalog" "sd_generic" "tunalog.conf"
DefaultModule tunalog
DefaultLanguage "en"
CONF
cat >"$XDG_CONFIG_HOME/speech-dispatcher/modules/tunalog.conf" <<CONF
GenericExecuteSynth "printf '%s\\\\n' \\'\$DATA\\' >> $SPOKEN"
GenericLanguage "en" "en" "UTF-8"
GenericDefaultCharset "UTF-8"
AddVoice "en" "MALE1" "tuna"
DefaultVoice "tuna"
CONF
printf 'pcm.!default { type null }\nctl.!default { type null }\n' >"$HOME/.asoundrc"
if [ "$ORCA_ONLY" = 0 ]; then
    # The logo (a 120×60 magenta block, easy to find on the screenshot) and
    # the banner file the login-screen keys point at.
    "$PY" - "$FIXTURE/logo.png" <<'LOGO' || fail SETUP "the logo fixture could not be drawn"
import sys
from PIL import Image
Image.new('RGB', (120, 60), (255, 0, 255)).save(sys.argv[1])
LOGO
    printf 'Banner from a file.' >"$FIXTURE/banner.txt"
fi

# The private "system" bus: GDM's and AccountsService's only home here.
cat >"$RUN_PRIV/system-bus.conf" <<BUSCONF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>tuna-proof-system</type>
  <listen>unix:path=$RUN_PRIV/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_type="method_call"/>
    <allow send_type="signal"/>
    <allow send_type="method_return"/>
    <allow send_type="error"/>
    <allow receive_type="method_call"/>
    <allow receive_type="method_return"/>
    <allow receive_type="error"/>
    <allow receive_type="signal"/>
  </policy>
</busconfig>
BUSCONF
dbus-daemon --config-file="$RUN_PRIV/system-bus.conf" --nofork --print-address=3 \
    3>"$RUN_PRIV/system-bus-address" >"$ARTIFACTS/system-bus.log" 2>&1 &
SYSBUS_PID=$!
for _ in $(seq 1 50); do [ -s "$RUN_PRIV/system-bus-address" ] && break; sleep 0.1; done
SYS_ADDR="$(head -1 "$RUN_PRIV/system-bus-address")"
case "$SYS_ADDR" in unix:path=*) ;; *) fail SETUP "the private system bus did not start" ;; esac

mkdir -m 711 "$RUN_PRIV/gdm-dbus"
"$PY" "$ROOT/scripts/lib/tuna-gdm-mock.py" --address "$SYS_ADDR" --server-dir "$RUN_PRIV/gdm-dbus" \
    --log "$GDM_LOG" --users "$FIXTURE/users.json" --secrets "$RUN_PRIV/secrets" \
    --sessions tuna,gnome --fallback-session tuna --localed-layout us,de --localed-variant , \
    >"$ARTIFACTS/gdm-mock.out" 2>"$ARTIFACTS/gdm-mock.err" &
MOCK_PID=$!
for _ in $(seq 1 50); do grep -q '^tuna-gdm-mock: ready ' "$ARTIFACTS/gdm-mock.out" && break; sleep 0.1; done
grep -q '^tuna-gdm-mock: ready ' "$ARTIFACTS/gdm-mock.out" || fail SETUP "the GDM mock did not start"

# systemd's side of Type=notify: one datagram socket, every message logged.
"$PY" - "$RUN_PRIV/notify" "$NOTIFY_LOG" <<'NOTIFY' &
import socket, sys, time
sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
sock.bind(sys.argv[1])
with open(sys.argv[2], 'a', encoding='utf-8') as out:
    while True:
        data = sock.recv(4096).decode(errors='replace')
        out.write(f'{time.time():.3f} {data}\n')
        out.flush()
NOTIFY
NOTIFY_PID=$!
for _ in $(seq 1 50); do [ -S "$RUN_PRIV/notify" ] && break; sleep 0.1; done
[ -S "$RUN_PRIV/notify" ] || fail SETUP "the notify socket did not appear"

{
    echo "source $(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
    sha256sum "$BIN_DIR/tuna-compositor" "$BIN_DIR/tuna-greeter"
} >"$ARTIFACTS/manifest.txt"

# The nested login screen: `start_login_screen SOCKET [VAR=VALUE...]`, the
# extra environment for the compositor and so the greeter it supervises.
start_login_screen() {
    socket="$1"
    shift
    env DBUS_SYSTEM_BUS_ADDRESS="$SYS_ADDR" TUNA_GREETER_BIN="$BIN_DIR/tuna-greeter" \
        TUNA_GREETER_TRACE=1 RUST_BACKTRACE=1 "$@" \
        "$BIN_DIR/tuna-compositor" --backend winit --socket "$socket" --greeter --screen-reader \
        >>"$LOG" 2>&1 &
    COMPOSITOR_PID=$!
    WID=""
    for _ in $(seq 1 90); do
        alive || fail "$CURRENT_GATE" "the compositor exited during startup"
        WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
        [ -n "$WID" ] && break
        sleep 1
    done
    [ -n "$WID" ] || fail "$CURRENT_GATE" "no nested window"
    xdotool windowfocus --sync "$WID"
}
start_login_screen "tuna-greeter-$$" NOTIFY_SOCKET="$RUN_PRIV/notify"

# --- helpers of the chrome gates (F) and G-GREETER-ORCA -------------------
gs() { gsettings "$@" 2>>"$ARTIFACTS/gsettings.err"; }
# The first showing node named $2 in dump $1: its window-relative bounds.
bounds() {
    jq -r --arg n "$2" --arg r "${3:-}" \
        'first(.[] | select(.name == $n and .showing and ($r == "" or .role == $r)) | .bounds | @tsv)' \
        "$ARTIFACTS/a11y-$1.json"
}
# Pixels that differ between two screenshots inside X Y W H.
pixels_differ() {
    "$PY" - "$ARTIFACTS/$1.png" "$ARTIFACTS/$2.png" "$3" "$4" "$5" "$6" <<'DIFF'
import sys
from PIL import Image, ImageChops
a, b = (Image.open(p).convert('RGB') for p in sys.argv[1:3])
x, y, w, h = (int(v) for v in sys.argv[3:7])
box = (x, y, x + w, y + h)
diff = ImageChops.difference(a.crop(box), b.crop(box)).convert('L')
print(sum(1 for v in diff.getdata() if v > 24))
DIFF
}
# Magenta (the logo fixture's) pixels in the bottom band of a screenshot.
magenta() {
    "$PY" - "$ARTIFACTS/$1.png" <<'MAGENTA'
import sys
from PIL import Image
img = Image.open(sys.argv[1]).convert('RGB')
w, h = img.size
band = img.crop((0, h - 240, w, h))
print(sum(1 for r, g, b in band.getdata() if r > 230 and g < 30 and b > 230))
MAGENTA
}
# Orca's speech log: `smark`, then wait for a line after it.
smark() { wc -l <"$SPOKEN" | tr -d ' '; }
swait() {
    end=$(($(date +%s) + ${3:-30}))
    while :; do
        tail -n "+$(($1 + 1))" "$SPOKEN" | grep -qE -- "$2" && return 0
        [ "$(date +%s)" -ge "$end" ] && return 1
        sleep 0.3
    done
}
# Open the accessibility menu (or close it) and press one of its toggles.
a11y_menu() { dump "$1" --press "Accessibility"; sleep 0.8; }
a11y_toggle() { dump "$1" --press "$2"; sleep 0.8; }

# --- A: the login screen comes up ---------------------------------------
CURRENT_GATE=G-GREETER-READY
cstate '.layers | any(.namespace == "tuna-greeter")' 120 || fail G-GREETER-READY "the greeter's layer never mapped"
await_greeter "" 10 || fail G-GREETER-READY "no tuna-greeter child of the compositor"
for _ in $(seq 1 50); do grep -q ' READY=1$' "$NOTIFY_LOG" && break; sleep 0.1; done
grep -q ' READY=1$' "$NOTIFY_LOG" || fail G-GREETER-READY "no READY=1 on NOTIFY_SOCKET after the greeter mapped"
grep -qFx "tuna-compositor: greeter mapped; READY=1" "$LOG" ||
    fail G-GREETER-READY "READY=1 was not sent for the mapped greeter"
gwait 0 "$(call OpenSession)" 20 || fail G-GREETER-READY "the greeter never asked GDM for its channel"
gwait 0 '.kind == "connect"' 20 || fail G-GREETER-READY "the greeter never connected to GDM's session server"
gwait 0 "$(call RegisterSession)" 20 || fail G-GREETER-READY "the greeter did not register its session with GDM"
gwait 0 "$(call RegisterDisplay)" 20 || fail G-GREETER-READY "the greeter did not register its display with GDM"
pass G-GREETER-READY "the tuna-greeter layer mapped and READY=1 reached NOTIFY_SOCKET; OpenSession, the peer channel and RegisterSession/RegisterDisplay reached GDM"

# --orca-only: G-GREETER-ORCA on the login screen just brought up.
if [ "$ORCA_ONLY" = 1 ]; then
    CURRENT_GATE=G-GREETER-ORCA
    cstate '.screen_reader_state == "disabled"' 5 || fail G-GREETER-ORCA "a screen reader ran before it was asked for"
    twait 0 "greeter users names=ada,grace,katherine" 20 >/dev/null ||
        fail G-GREETER-ORCA "the greeter did not list its users"
    a11y_menu F-orca-0
    s="$(smark)"
    a11y_toggle F-orca-1 "Screen Reader"
    cstate '.screen_reader_state == "active" and .screen_reader_pid != null' 90 ||
        fail G-GREETER-ORCA "Screen Reader did not start the compositor's Orca"
    READER_PID="$(jq -r .screen_reader_pid "$CSTATE")"
    swait "$s" '^Screen reader on\.$' 60 || fail G-GREETER-ORCA "Orca did not say 'Screen reader on.'"
    sleep 2
    s="$(smark)"
    a11y_menu F-orca-2
    swait "$s" 'Accessibility|Ada Lovelace|Grace Hopper|Katherine Johnson|Not listed' 30 ||
        fail G-GREETER-ORCA "Orca did not read the login screen's focus"
    said="$(tail -n "+$((s + 1))" "$SPOKEN" | grep -E 'Accessibility|Ada Lovelace|Grace Hopper|Katherine Johnson|Not listed' | head -1)"
    a11y_menu F-orca-3
    a11y_toggle F-orca-4 "Screen Reader"
    cstate '.screen_reader_state == "disabled" and .screen_reader_pid == null' 30 ||
        fail G-GREETER-ORCA "Screen Reader off did not stop Orca"
    for _ in $(seq 1 50); do kill -0 "$READER_PID" 2>/dev/null || break; sleep 0.1; done
    kill -0 "$READER_PID" 2>/dev/null && fail G-GREETER-ORCA "Orca (pid $READER_PID) outlived Screen Reader off"
    pass G-GREETER-ORCA "Screen Reader started the compositor's Orca (pid $READER_PID, $(head -1 "$ARTIFACTS/orca-version.txt")): 'Screen reader on.', then '$said' for the login screen; off stopped it"
    exit 0
fi

CURRENT_GATE=G-GREETER-USER-LIST
m="$(mark)"
twait 0 "greeter users names=ada,grace,katherine" 20 >/dev/null ||
    fail G-GREETER-USER-LIST "the greeter did not list exactly ada, grace and katherine"
gwait 0 "$(call ListCachedUsers)" 5 || fail G-GREETER-USER-LIST "AccountsService was not asked for its users"
sleep 1.5
dump A-1-user-list
shot A-1-user-list
for name in "Ada Lovelace" "Grace Hopper" "Katherine Johnson" "Not listed?"; do
    showing A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' is not showing"
done
for name in "GDM Greeter" "Locked Account" "Password"; do
    hidden A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' shows on the user list"
done
rows="$(jq '[.[] | select(.showing and (.role == "list item") and (.name | IN("Ada Lovelace", "Grace Hopper", "Katherine Johnson")))] | length' "$ARTIFACTS/a11y-A-1-user-list.json")"
[ "$rows" = 3 ] || fail G-GREETER-USER-LIST "$rows user rows instead of 3"
# Ada's IconFile is her avatar; the others' are the default.
avatar_px="$(colour_pixels A-1-user-list 255 255 0)"
if ! { [ "$avatar_px" -ge 2500 ] && [ "$avatar_px" -le 4500 ]; }; then
    fail G-GREETER-USER-LIST "ada's 64 px avatar image is not on her row alone ($avatar_px avatar pixels)"
fi
pass G-GREETER-USER-LIST "Ada Lovelace, Grace Hopper and Katherine Johnson listed as rows with Not listed?, Ada's row with her IconFile avatar ($avatar_px px); the system and locked accounts are not (A-1-user-list.png)"

CURRENT_GATE=G-GREETER-NO-SHELL
namespaces="$(jq -c '[.layers[].namespace] | unique' "$CSTATE")"
[ "$namespaces" = '["tuna-greeter"]' ] || fail G-GREETER-NO-SHELL "layers other than the greeter's: $namespaces"
children="$(pgrep -P "$COMPOSITOR_PID" -l | awk '{print $2}' | sort | tr '\n' ' ')"
case " $children " in *" tuna-shell-gtk "* | *" tuna-shell "*) fail G-GREETER-NO-SHELL "a shell runs: $children" ;; esac
xdotool key --clearmodifiers super
sleep 1
xdotool mousemove --window "$WID" 0 0
sleep 1.5
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key --clearmodifiers super+l
sleep 1.5
jq -e '.overview_open == false and .locked == false and ([.layers[].namespace] | unique) == ["tuna-greeter"]' "$CSTATE" >/dev/null ||
    fail G-GREETER-NO-SHELL "Super, the hot corner or Super+L changed the login screen: $(jq -c '{overview_open, locked, layers: [.layers[].namespace]}' "$CSTATE")"
pass G-GREETER-NO-SHELL "layers $namespaces only; compositor children: $children; Super, the hot corner and Super+L left overview_open=false and locked=false"

# --- F: the login screen's chrome ----------------------------------------
CURRENT_GATE=G-GREETER-SERVICES
gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.ListNames >"$ARTIFACTS/session-bus-names.txt" ||
    fail G-GREETER-SERVICES "the session bus did not list its names"
# login_services.rs's gdm-mode table: what runs is owned and never
# reported refused; the rest is neither owned nor running, each refusal said.
for name in org.gnome.Mutter.DisplayConfig org.gnome.Mutter.IdleMonitor org.freedesktop.a11y.Manager \
    org.gnome.Mutter.ServiceChannel org.gnome.Mutter.ColorManager org.gnome.Shell.Introspect \
    org.gnome.Shell.Screenshot; do
    grep -qF "'$name'" "$ARTIFACTS/session-bus-names.txt" ||
        fail G-GREETER-SERVICES "$name is not served at the login screen"
    ! grep -qF "tuna-compositor: greeter: not serving $name (" "$LOG" ||
        fail G-GREETER-SERVICES "the compositor says it refuses $name, which the gdm mode runs"
done
for name in org.gnome.Mutter.ScreenCast org.gnome.Mutter.RemoteDesktop org.gnome.Mutter.InputCapture \
    org.gnome.SettingsDaemon.Color org.gnome.SessionManager; do
    ! grep -qF "'$name'" "$ARTIFACTS/session-bus-names.txt" ||
        fail G-GREETER-SERVICES "$name is served at the login screen"
    grep -qF "tuna-compositor: greeter: not serving $name (" "$LOG" ||
        fail G-GREETER-SERVICES "the compositor did not say it refuses $name"
done
pgrep -P "$COMPOSITOR_PID" -f tuna-ibus-bridge >/dev/null &&
    fail G-GREETER-SERVICES "tuna-ibus-bridge runs at the login screen"
grep -qF "tuna-compositor: greeter: not serving tuna-ibus-bridge (" "$LOG" ||
    fail G-GREETER-SERVICES "the compositor did not say it starts no IBus bridge"
pass G-GREETER-SERVICES "DisplayConfig, IdleMonitor, a11y.Manager, ServiceChannel, ColorManager, Introspect and Screenshot are owned; ScreenCast, RemoteDesktop, InputCapture, SettingsDaemon.Color and SessionManager are not, each refusal logged; no tuna-ibus-bridge"

CURRENT_GATE=G-GREETER-LOGO
twait 0 "greeter logo path=" 5 >/dev/null || fail G-GREETER-LOGO "the greeter did not read the logo key"
shot F-pre-logo
[ "$(magenta F-pre-logo)" = 0 ] || fail G-GREETER-LOGO "magenta at the bottom before a logo was set"
m="$(mark)"
gs set org.gnome.login-screen logo "$FIXTURE/logo.png"
twait "$m" "greeter logo path=$FIXTURE/logo.png" 10 >/dev/null || fail G-GREETER-LOGO "the logo key change was not followed"
sleep 1
shot F-logo
logo_px="$(magenta F-logo)"
[ "$logo_px" -ge 6000 ] || fail G-GREETER-LOGO "the 120×60 logo is not drawn at the bottom ($logo_px magenta pixels)"
m="$(mark)"
gs set org.gnome.login-screen banner-message-text "Authorized use only."
gs set org.gnome.login-screen banner-message-enable true
twait "$m" "greeter banner shown=true" 10 >/dev/null || fail G-GREETER-LOGO "banner-message-enable was not followed"
sleep 0.5
dump F-banner-text
showing F-banner-text "Authorized use only." || fail G-GREETER-LOGO "the banner text is not showing"
gs set org.gnome.login-screen banner-message-path "$FIXTURE/banner.txt"
gs set org.gnome.login-screen banner-message-source file
sleep 1
dump F-banner-file
showing F-banner-file "Banner from a file." || fail G-GREETER-LOGO "the banner file is not showing"
hidden F-banner-file "Authorized use only." || fail G-GREETER-LOGO "the banner still shows the text key with source=file"
printf 'The banner file changed.' >"$FIXTURE/banner.txt"
sleep 2
dump F-banner-changed
showing F-banner-changed "The banner file changed." || fail G-GREETER-LOGO "the banner did not follow its file"
sleep 0.5
shot F-0-chrome
pass G-GREETER-LOGO "logo set live ($logo_px logo pixels); banner text, banner file and an edit of that file shown live (F-0-chrome.png)"

CURRENT_GATE=G-GREETER-INPUT-SOURCE
twait 0 "greeter input-sources from=localed ids=us,de" 20 >/dev/null ||
    fail G-GREETER-INPUT-SOURCE "localed's us,de did not become the sources"
cstate '.keyboard.layouts == ["English (US)", "German"]' 10 ||
    fail G-GREETER-INPUT-SOURCE "the compositor's keymap is not localed's: $(jq -c .keyboard.layouts "$CSTATE")"
dump F-input-0
showing F-input-0 "Keyboard" || fail G-GREETER-INPUT-SOURCE "the Keyboard indicator does not show with two sources"
showing F-input-0 "en" || fail G-GREETER-INPUT-SOURCE "the indicator does not say en"
dump F-input-1 --press "Keyboard"
sleep 0.8
dump F-input-1
for source in "English (US)" German; do
    showing F-input-1 "$source" ||
        fail G-GREETER-INPUT-SOURCE "the indicator's menu does not list English (US) and German"
done
checked F-input-1 "English (US)" || fail G-GREETER-INPUT-SOURCE "English (US) is not the current source"
# The menu is a radio group (as Login Options): the focus starts on a
# source and moving it selects.
focused F-input-1 "English (US)" || fail G-GREETER-INPUT-SOURCE "the menu's focus is not on English (US)"
m="$(mark)"
xdotool key Down
twait "$m" "greeter input-source current=1 id=de" 10 >/dev/null || fail G-GREETER-INPUT-SOURCE "choosing German did not switch"
cstate '.keyboard.layout == "German"' 10 || fail G-GREETER-INPUT-SOURCE "the compositor's layout is $(jq -c .keyboard.layout "$CSTATE"), not German"
sleep 0.5
dump F-input-3
showing F-input-3 "de" || fail G-GREETER-INPUT-SOURCE "the indicator does not say de"
dump F-input-4 --press "Keyboard"
sleep 0.8
dump F-input-5
if focused F-input-5 "German"; then xdotool key Up; else xdotool key space; fi
cstate '.keyboard.layout == "English (US)"' 10 || fail G-GREETER-INPUT-SOURCE "switching back to English (US) failed"
m="$(mark)"
gs set org.gnome.desktop.input-sources sources "[('xkb', 'fr')]"
twait "$m" "greeter input-sources from=user ids=fr" 10 >/dev/null ||
    fail G-GREETER-INPUT-SOURCE "the greeter user's sources did not win over localed's"
cstate '.keyboard.layouts == ["French"]' 10 || fail G-GREETER-INPUT-SOURCE "the keymap is not the greeter user's fr"
sleep 0.5
dump F-input-5
hidden F-input-5 "Keyboard" || fail G-GREETER-INPUT-SOURCE "the indicator shows with one source"
m="$(mark)"
gs reset org.gnome.desktop.input-sources sources
twait "$m" "greeter input-sources from=localed ids=us,de" 10 >/dev/null ||
    fail G-GREETER-INPUT-SOURCE "resetting the user's sources did not return to localed's"
cstate '.keyboard.layouts == ["English (US)", "German"] and .keyboard.layout == "English (US)"' 10 ||
    fail G-GREETER-INPUT-SOURCE "the keymap did not return to localed's"
pass G-GREETER-INPUT-SOURCE "localed's us,de became the keymap and the Keyboard indicator (en); German switched the compositor's layout (de) and back; the greeter user's [('xkb','fr')] won (indicator hidden) and its reset returned to localed's"

CURRENT_GATE=G-GREETER-A11Y-MENU
a11y_menu F-a11y-0
dump F-a11y-1
shot F-2-a11y-menu
# The menu's toggles in tree order (the menu buttons' own toggles carry
# their buttons' names).
order="$(jq -c '[.[] | select(.showing and .role == "toggle button" and (.name | IN("High Contrast", "Zoom", "Large Text", "Screen Reader", "Screen Keyboard", "Visual Alerts", "Sticky Keys", "Slow Keys", "Bounce Keys", "Mouse Keys"))) | .name]' "$ARTIFACTS/a11y-F-a11y-1.json")"
[ "$order" = '["High Contrast","Zoom","Large Text","Screen Reader","Screen Keyboard","Visual Alerts","Sticky Keys","Slow Keys","Bounce Keys","Mouse Keys"]' ] ||
    fail G-GREETER-A11Y-MENU "the menu's toggles are $order"
read -r ax ay aw ah <<EOF
$(bounds F-a11y-1 Accessibility)
EOF
[ -n "$ah" ] || fail G-GREETER-A11Y-MENU "no bounds for the Accessibility button"
if [ "$ax" -le $((WIDTH / 2)) ] || [ "$ay" -le $((HEIGHT / 2)) ]; then
    fail G-GREETER-A11Y-MENU "the Accessibility button is not at the bottom right ($ax,$ay)"
fi
m="$(mark)"
a11y_toggle F-a11y-hc "High Contrast"
twait "$m" "greeter a11y high-contrast=true" 10 >/dev/null || fail G-GREETER-A11Y-MENU "High Contrast did not set high-contrast"
[ "$(gs get org.gnome.desktop.a11y.interface high-contrast)" = true ] || fail G-GREETER-A11Y-MENU "high-contrast is not true"
sleep 0.5
shot F-a11y-hc
hc_px="$(pixels_differ F-2-a11y-menu F-a11y-hc "$ax" "$ay" "$aw" "$ah")"
[ "$hc_px" -ge 20 ] || fail G-GREETER-A11Y-MENU "High Contrast did not restyle the Accessibility button ($hc_px pixels changed)"
a11y_toggle F-a11y-hc-off "High Contrast"
[ "$(gs get org.gnome.desktop.a11y.interface high-contrast)" = false ] || fail G-GREETER-A11Y-MENU "High Contrast did not turn off"
a11y_toggle F-a11y-zoom "Zoom"
cstate '.magnifier.active == true' 10 || fail G-GREETER-A11Y-MENU "Zoom did not turn the compositor's magnifier on"
a11y_toggle F-a11y-zoom-off "Zoom"
cstate '.magnifier.active == false' 10 || fail G-GREETER-A11Y-MENU "Zoom did not turn the magnifier off"
a11y_toggle F-a11y-bell "Visual Alerts"
cstate '.bell.visual == true' 10 || fail G-GREETER-A11Y-MENU "Visual Alerts did not reach the compositor's bell"
a11y_toggle F-a11y-bell-off "Visual Alerts"
cstate '.bell.visual == false' 10 || fail G-GREETER-A11Y-MENU "Visual Alerts did not turn off"
for aid in "Sticky Keys:sticky" "Slow Keys:slow" "Bounce Keys:bounce" "Mouse Keys:mouse"; do
    a11y_toggle "F-a11y-${aid#*:}" "${aid%%:*}"
    cstate ".input_aids.${aid#*:} == true" 10 || fail G-GREETER-A11Y-MENU "${aid%%:*} did not reach the compositor"
    a11y_toggle "F-a11y-${aid#*:}-off" "${aid%%:*}"
    cstate ".input_aids.${aid#*:} == false" 10 || fail G-GREETER-A11Y-MENU "${aid%%:*} did not turn off"
done
pass G-GREETER-A11Y-MENU "Accessibility (bottom right) lists $order; High Contrast restyled the login screen ($hc_px pixels of the button), Zoom drove the compositor's magnifier, Visual Alerts its bell, Sticky/Slow/Bounce/Mouse Keys its keyboard aids, each on and off (F-2-a11y-menu.png)"

CURRENT_GATE=G-GREETER-LARGE-TEXT
