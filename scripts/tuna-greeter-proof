for _ in $(seq 1 50); do grep -q ' READY=1$' "$NOTIFY_LOG" && break; sleep 0.1; done
grep -q ' READY=1$' "$NOTIFY_LOG" || fail G-GREETER-READY "no READY=1 on NOTIFY_SOCKET after the greeter mapped"
grep -qFx "tuna-compositor: greeter mapped; READY=1" "$LOG" ||
    fail G-GREETER-READY "READY=1 was not sent for the mapped greeter"
gwait 0 "$(call OpenSession)" 20 || fail G-GREETER-READY "the greeter never asked GDM for its channel"
gwait 0 '.kind == "connect"' 20 || fail G-GREETER-READY "the greeter never connected to GDM's session server"
gwait 0 "$(call RegisterSession)" 20 || fail G-GREETER-READY "the greeter did not register its session with GDM"
gwait 0 "$(call RegisterDisplay)" 20 || fail G-GREETER-READY "the greeter did not register its display with GDM"
pass G-GREETER-READY "the tuna-greeter layer mapped and READY=1 reached NOTIFY_SOCKET; OpenSession, the peer channel and RegisterSession/RegisterDisplay reached GDM"

CURRENT_GATE=G-GREETER-USER-LIST
m="$(mark)"
twait 0 "greeter users names=ada,grace,katherine,dorothy,mary,annie,hedy,joan,radia,frances,evelyn" 20 >/dev/null ||
    fail G-GREETER-USER-LIST "the greeter did not list exactly the eleven fixture users"
twait 0 "greeter logged-in names=mary,annie" 20 >/dev/null ||
    fail G-GREETER-USER-LIST "logind's logged-in users (mary, annie) were not read"
gwait 0 "$(call ListCachedUsers)" 5 || fail G-GREETER-USER-LIST "AccountsService was not asked for its users"
sleep 1.5
dump A-1-user-list
shot A-1-user-list
for name in "Ada Lovelace" "Grace Hopper" "Katherine Johnson" "Not listed?"; do
    showing A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' is not showing"
done
for name in "GDM Greeter" "Locked Account" "Password"; do
    hidden A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' shows on the user list"
done
rows="$(jq '[.[] | select(.showing and (.role == "list item") and (.name | IN("Ada Lovelace", "Grace Hopper", "Katherine Johnson")))] | length' "$ARTIFACTS/a11y-A-1-user-list.json")"
[ "$rows" = 3 ] || fail G-GREETER-USER-LIST "$rows user rows instead of 3"
[ "$(description A-1-user-list "Mary Jackson")" = "Logged in" ] ||
    fail G-GREETER-USER-LIST "Mary Jackson's row is not marked logged in"
[ "$(description A-1-user-list "Annie Easley")" = "Logged in" ] ||
    fail G-GREETER-USER-LIST "Annie Easley's row is not marked logged in"
[ "$(description A-1-user-list "Ada Lovelace")" = "" ] ||
    fail G-GREETER-USER-LIST "Ada Lovelace's row is marked logged in"
# Ada's IconFile is her avatar; the others' are the default.
avatar_px="$(colour_pixels A-1-user-list 255 255 0)"
if ! { [ "$avatar_px" -ge 2500 ] && [ "$avatar_px" -le 4500 ]; }; then
    fail G-GREETER-USER-LIST "ada's 64 px avatar image is not on her row alone ($avatar_px avatar pixels)"
fi
pass G-GREETER-USER-LIST "Ada Lovelace, Grace Hopper and Katherine Johnson listed first as rows with Not listed?, eleven users in all, Ada's row with her IconFile avatar ($avatar_px px), Mary Jackson and Annie Easley marked logged in (logind); the system and locked accounts are not (A-1-user-list.png)"

CURRENT_GATE=G-GREETER-NO-SHELL
namespaces="$(jq -c '[.layers[].namespace] | unique' "$CSTATE")"
[ "$namespaces" = '["tuna-greeter"]' ] || fail G-GREETER-NO-SHELL "layers other than the greeter's: $namespaces"
children="$(pgrep -P "$COMPOSITOR_PID" -l | awk '{print $2}' | sort | tr '\n' ' ')"
case " $children " in *" tuna-shell-gtk "* | *" tuna-shell "*) fail G-GREETER-NO-SHELL "a shell runs: $children" ;; esac
xdotool key --clearmodifiers super
sleep 1
