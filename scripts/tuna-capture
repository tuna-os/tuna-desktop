#!/bin/sh
# tuna-capture — scripted demo-media capture for the release walkthrough.
#
# Usage:
#   scripts/tuna-capture [--bin-dir DIR] [--display :N] [--artifacts DIR] [--socket NAME]
#   scripts/tuna-capture --render-walkthrough vX.Y.Z [--artifacts DIR]
#
# --render-walkthrough stamps docs/walkthrough-template.md into
# docs/walkthrough.md for the given release tag (run by the release
# checklist after uploading the media bundle as release assets).
#
# Drives the GTK shell through each core-tour feature (overview, app-launch,
# tiling-scroll, quick-settings, notifications, lock-screen) under Xvfb,
# recording each with ffmpeg x11grab while replaying the pinned interaction
# sequence, plus one still per feature. Emits <feature>.mp4 + <feature>.png
# under stable names; the same feature yields the same shots every release
# unless the feature changed.
#
# Requires ffmpeg for clips; stills fall back to scrot alone when ffmpeg is
# absent (clips are then skipped, not faked).
set -eu

unset CDPATH

ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/capture-artifacts"
SOCKET="tuna-capture-$$"
BIN_DIR=""
WIDTH=1280
HEIGHT=800

RENDER_TAG=""
# Overridable descriptions for the captured GTK shell.
QUICK_SETTINGS_BLURB="${QUICK_SETTINGS_BLURB:-The panel status button opens quick settings with sliders and toggles.}"
NOTIFICATIONS_BLURB="${NOTIFICATIONS_BLURB:-Notification banners stack over the session.}"
LOCK_BLURB="${LOCK_BLURB:-The idle shield locks the session; waking it reveals the authentication prompt.}"
# The six-feature core tour. This list is the contract: every segment
# must produce a clip plus a still below, and the walkthrough template
# must link both under the release-asset URL for each name.
SEGMENTS="overview app-launch tiling-scroll notifications quick-settings lock-screen"

check_walkthrough() {
    # Template/segment agreement: adding or renaming a segment must
    # update docs/walkthrough-template.md in the same change, or the
    # release page links media the capture never produced (or the
    # capture produces media no page shows).
    for seg in $SEGMENTS; do
        for ext in mp4 png; do
            if ! grep -q "$seg\\.$ext" "$ROOT/docs/walkthrough-template.md"; then
                echo "tuna-capture: template missing $seg.$ext link" >&2
                exit 1
            fi
        done
    done
}

check_rendered() {
    # Rendered page must have no leftover placeholders: every
    # @VERSION@ and @BLURB@ resolves or the release page ships
    # literal placeholder text.
    if grep -q "@[A-Z_]*@" "$1"; then
        echo "tuna-capture: rendered page has placeholder" >&2
        grep -n "@[A-Z_]*@" "$1" >&2
        exit 1
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --socket) SOCKET="$2"; shift 2 ;;
        --bin-dir) BIN_DIR="$2"; shift 2 ;;
        --render-walkthrough) RENDER_TAG="$2"; shift 2 ;;
        --help | -h) sed -n '2,14p' "$0"; exit 0 ;;
        *) echo "tuna-capture: unknown argument $1" >&2; exit 1 ;;
    esac
done

if [ -n "$RENDER_TAG" ]; then
    case "$RENDER_TAG" in
        v*) ;;
        *) echo "tuna-capture: tag must look like vX.Y.Z" >&2; exit 1 ;;
    esac
    mkdir -p "$ARTIFACTS"
    sed -e "s/@VERSION@/$RENDER_TAG/g" \
        -e "s/@QUICK_SETTINGS_BLURB@/$QUICK_SETTINGS_BLURB/g" \
        -e "s/@NOTIFICATIONS_BLURB@/$NOTIFICATIONS_BLURB/g" \
        -e "s/@LOCK_BLURB@/$LOCK_BLURB/g" \
        "$ROOT/docs/walkthrough-template.md" >"$ROOT/docs/walkthrough.md"
    check_walkthrough
    check_rendered "$ROOT/docs/walkthrough.md"
    echo "tuna-capture: rendered docs/walkthrough.md for $RENDER_TAG"
    exit 0
fi

mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"
. "$ROOT/scripts/lib/tuna-introspect.sh"
TUNA_COMPOSITOR_STATE="$TUNA_INTROSPECT_FILE"
export TUNA_COMPOSITOR_STATE

# The launched fixture maps a real GTK window; a marker-only process would
# leave app-launch and tiling footage showing an empty desktop.
PROBE_HOME="$ARTIFACTS/probe-home"
MARKER="$ARTIFACTS/launch-marker"
rm -f "$MARKER" "$ARTIFACTS/seed-marker"
mkdir -p "$PROBE_HOME/applications" "$PROBE_HOME/config"
cat >"$PROBE_HOME/application.py" <<'PY'
import pathlib
import sys
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio

marker, title = sys.argv[1:3]
app = Gtk.Application(application_id="org.tuna.Capture", flags=Gio.ApplicationFlags.NON_UNIQUE)

def activate(application):
    window = Gtk.ApplicationWindow(application=application, title=title)
    window.set_default_size(540, 360)
    window.set_child(Gtk.Label(label=title))
    def mapped(widget):
        clock = widget.get_frame_clock()

        def painted(frame_clock):
            frame_clock.disconnect(handler)
            pathlib.Path(marker).write_text("painted\n")

        handler = clock.connect("after-paint", painted)
        widget.queue_draw()

    window.connect("map", mapped)
    window.present()

app.connect("activate", activate)
app.run([])
PY
cat >"$PROBE_HOME/applications/tunaterm-probe.desktop" <<EOF
[Desktop Entry]
Name=Tunaterm Probe
Exec=/usr/bin/python3 "$PROBE_HOME/application.py" "$MARKER" "Launched from overview"
Type=Application
EOF
XDG_DATA_HOME="$PROBE_HOME"
export XDG_DATA_HOME
XDG_CONFIG_HOME="$PROBE_HOME/config"
GSETTINGS_BACKEND=keyfile
XDG_RUNTIME_DIR="$ARTIFACTS/runtime"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
export XDG_CONFIG_HOME GSETTINGS_BACKEND XDG_RUNTIME_DIR
# The GTK shell publishes this policy to the compositor, overriding its
# developer timeout. Keep the tour unlocked until its final idle segment.
gsettings set org.gnome.desktop.session idle-delay 300
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.screensaver lock-delay 0
# Hermetic shell state: the notification queue (and any future shell
# state) must resolve under the probe home, never the runner's real
# ~/.local/state — otherwise ambient entries leak into the capture and
# the notifications segment is not reproducible release to release.
XDG_STATE_HOME="$PROBE_HOME"
export XDG_STATE_HOME
# Deterministic banner set: start each capture with an empty queue so
# the notifications segment shows exactly the banner it posts.
rm -f "$PROBE_HOME/tuna-shell/notifications.json"
COMPOSITOR_PID=""
OWNED_XVFB=""
BUS_PID=""
HAVE_FFMPEG=""
PROBE_PID=""
REC_PID=""
REC_FEATURE=""

if command -v ffmpeg >/dev/null 2>&1; then
    HAVE_FFMPEG=1
fi

cleanup() {
    if [ -n "$REC_PID" ]; then
        kill -INT "$REC_PID" 2>/dev/null || true
        wait "$REC_PID" 2>/dev/null || true
    fi
    if [ -n "$PROBE_PID" ]; then
        kill "$PROBE_PID" 2>/dev/null || true
        wait "$PROBE_PID" 2>/dev/null || true
    fi
    if [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        kill "$COMPOSITOR_PID" 2>/dev/null || true
        wait "$COMPOSITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$OWNED_XVFB" ]; then
        kill "$OWNED_XVFB" 2>/dev/null || true
        wait "$OWNED_XVFB" 2>/dev/null || true
    fi
    if [ -n "$BUS_PID" ]; then
        kill "$BUS_PID" 2>/dev/null || true
        wait "$BUS_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# Private session bus: the shell serves org.freedesktop.Notifications on
# it, so the notifications segment can post a banner with gdbus.
command -v dbus-daemon >/dev/null 2>&1 || {
    echo "tuna-capture: dbus-daemon is required" >&2
    exit 1
}
command -v gdbus >/dev/null 2>&1 || {
    echo "tuna-capture: gdbus is required" >&2
    exit 1
}
BUS_ADDRESS_FILE="$ARTIFACTS/bus-address"
dbus-daemon --session --fork --print-address=1 --print-pid=1 \
    >"$BUS_ADDRESS_FILE" 2>"$ARTIFACTS/bus.log" || {
    echo "tuna-capture: dbus-daemon failed to start" >&2
    exit 1
}
DBUS_SESSION_BUS_ADDRESS="$(sed -n '1p' "$BUS_ADDRESS_FILE")"
BUS_PID="$(sed -n '2p' "$BUS_ADDRESS_FILE")"
export DBUS_SESSION_BUS_ADDRESS
echo "tuna-capture: private bus $DBUS_SESSION_BUS_ADDRESS (pid $BUS_PID)"

display_works() {
    xdotool getdisplaygeometry >/dev/null 2>&1
}

if [ -n "$DISPLAY_ARG" ]; then
    DISPLAY="$DISPLAY_ARG"
    export DISPLAY
fi
if ! display_works; then
    DISPLAY=":97"
    export DISPLAY
    echo "tuna-capture: starting Xvfb on $DISPLAY"
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" >"$ARTIFACTS/xvfb.log" 2>&1 &
    OWNED_XVFB=$!
    for _ in $(seq 1 30); do
        if display_works; then
            break
        fi
        sleep 1
    done
    display_works || {
        echo "tuna-capture: Xvfb never answered on $DISPLAY" >&2
        exit 1
    }
fi
echo "tuna-capture: display $DISPLAY geometry $(xdotool getdisplaygeometry)"

if [ -z "$BIN_DIR" ]; then
    echo "tuna-capture: building GTK session"
    cargo build --locked --quiet --manifest-path "$ROOT/Cargo.toml" \
        -p tuna-compositor -p tuna-shell-gtk
    BIN_DIR="${CARGO_TARGET_DIR:-$ROOT/target}/debug"
fi
BIN_DIR="$(cd "$BIN_DIR" && pwd)"
for bin in tuna-compositor tuna-shell-gtk; do
    test -x "$BIN_DIR/$bin" || {
        echo "tuna-capture: missing executable $BIN_DIR/$bin" >&2
        exit 1
    }
    "$BIN_DIR/$bin" --version
done >"$ARTIFACTS/versions.txt"
sha256sum "$BIN_DIR/tuna-compositor" "$BIN_DIR/tuna-shell-gtk" \
    >"$ARTIFACTS/binaries.sha256"


echo "tuna-capture: starting compositor on socket $SOCKET"
env -u WAYLAND_DISPLAY "$BIN_DIR/tuna-compositor" --socket "$SOCKET" --width "$WIDTH" --height "$HEIGHT" \
    --shell-bin "$BIN_DIR/tuna-shell-gtk" \
    >"$LOG" 2>&1 &
COMPOSITOR_PID=$!

echo "tuna-capture: waiting for the nested window"
WID=""
for _ in $(seq 1 60); do
    if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        echo "tuna-capture: compositor died during startup" >&2
        tail -30 "$LOG" >&2 || true
        exit 1
    fi
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    if [ -n "$WID" ]; then
        break
    fi
    sleep 1
done
if [ -z "$WID" ]; then
    echo "tuna-capture: no Smithay window found" >&2
    exit 1
fi
xdotool windowfocus --sync "$WID"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2)) click 1
sleep 3
for _ in $(seq 1 60); do
    if grep -q 'tuna-shell-gtk: keybindings:' "$LOG"; then
        break
    fi
    kill -0 "$COMPOSITOR_PID" 2>/dev/null || exit 1
    sleep 1
done
grep -q 'tuna-shell-gtk: keybindings:' "$LOG" || {
    echo "tuna-capture: GTK shell never became ready" >&2
    exit 1
}
xdotool key Escape
assert_state C-DESKTOP '.overview_open == false and .locked == false' "GTK desktop ready"
env -u DISPLAY WAYLAND_DISPLAY="$SOCKET" /usr/bin/python3 \
    "$PROBE_HOME/application.py" "$ARTIFACTS/seed-marker" "Tuna Desktop capture fixture" \
    >"$ARTIFACTS/application.log" 2>&1 &
PROBE_PID=$!
# Mapping precedes the first buffer; cold software shaders can take seconds.
for _ in $(seq 1 150); do
    test -s "$ARTIFACTS/seed-marker" && break
    kill -0 "$PROBE_PID" 2>/dev/null || break
    sleep 0.2
done
test -s "$ARTIFACTS/seed-marker" || {
    echo "tuna-capture: GTK fixture did not paint its first frame" >&2
    exit 1
}
assert_state C-SEED '(.windows | length) == 1' "seed window managed"
sleep 1

# --- media helpers -------------------------------------------------------
# record_start <feature>: begin ffmpeg x11grab into <feature>.raw.mp4.
# record_stop: stop the recorder and remux to <feature>.mp4.

record_start() {
    REC_FEATURE="$1"
    if [ -z "$HAVE_FFMPEG" ]; then
        return 0
    fi
    ffmpeg -hide_banner -loglevel error -y -f x11grab -framerate 15 \
        -video_size "${WIDTH}x${HEIGHT}" -i "$DISPLAY" \
        -c:v libx264 -preset veryfast -pix_fmt yuv420p \
        "$ARTIFACTS/$REC_FEATURE.raw.mp4" >/dev/null 2>&1 &
    REC_PID=$!
    # Let the recorder grab a settled first frame before interaction.
    sleep 1
}

record_stop() {
    if [ -z "$HAVE_FFMPEG" ] || [ -z "$REC_PID" ]; then
        return 0
    fi
    kill -INT "$REC_PID" 2>/dev/null || true
    wait "$REC_PID" 2>/dev/null || true
    mv "$ARTIFACTS/$REC_FEATURE.raw.mp4" "$ARTIFACTS/$REC_FEATURE.mp4"
    echo "tuna-capture: clip $REC_FEATURE.mp4"
    REC_PID=""
}

shot() {
    # Stills come from the clip, not scrot: scrot reads back black for the
    # GL-rendered nested window, while x11grab sees full content. This also
    # guarantees each still matches its clip.
    if [ -n "$HAVE_FFMPEG" ]; then
        # Settle one second before the end: every segment holds its final
        # state (open menu, up banner, engaged lock) through record_stop.
        ffmpeg -hide_banner -loglevel error -y -sseof -1 -i "$ARTIFACTS/$1.mp4" \
            -frames:v 1 "$ARTIFACTS/$1.png" >/dev/null 2>&1
    else
        scrot "$ARTIFACTS/$1.png" >/dev/null
    fi
    echo "tuna-capture: still $1.png"
}

check_media() {
    for f in "$@"; do
        if [ ! -s "$ARTIFACTS/$f" ]; then
            echo "tuna-capture: missing artifact $f" >&2
            exit 1
        fi
    done
}


# --- segment: overview ---------------------------------------------------
record_start "overview"
xdotool key Super_L
assert_state C-OVERVIEW '.overview_progress == 1 and (.previews | length) > 0' "overview with a real preview"
keep_state overview-state
sleep 2
record_stop
shot "overview"

# --- segment: app-launch ---------------------------------------------------
# Escape back to the desktop first so the launch starts from rest.
xdotool key Escape
sleep 1
record_start "app-launch"
xdotool key Super_L
sleep 1
xdotool type "tunaterm"
sleep 2
xdotool key Return
# Admit exactly one launch and wait for its first frame, not another Return.
for _ in $(seq 1 150); do
    test -s "$MARKER" && break
    kill -0 "$COMPOSITOR_PID" 2>/dev/null || break
    sleep 0.2
done
if [ ! -s "$MARKER" ]; then
    echo "tuna-capture: probe app never painted (no marker at $MARKER)" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
xdotool key Escape
sleep 1
assert_state C-LAUNCH '.overview_open == false and (.windows | length) == 2' "launched GTK window managed"
keep_state app-launch-state
record_stop
shot "app-launch"

# --- segment: tiling-scroll ------------------------------------------------
# Both real fixture windows are present when the strip mode and width change.
record_start "tiling-scroll"
xdotool key Super_L+Shift+T
sleep 2
xdotool key Super_L+R
sleep 2
assert_state C-SCROLL '.session_mode == "scroll"' "scroll layout active"
keep_state tiling-scroll-state
record_stop
shot "tiling-scroll"

# --- segment: notifications -------------------------------------------------
# Post a banner over the bus the shell serves, then hold the frame so the
# clip shows it stacked over the session.
record_start "notifications"
NOTIFY_RESULT="$(gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "tuna-capture" 0 "" "Capture demo" "A notification banner, pinned for the walkthrough." \
    "[]" "{}" 8000)"
sleep 5
record_stop
shot "notifications"
NOTIFICATION_ID="${NOTIFY_RESULT#* }"
NOTIFICATION_ID="${NOTIFICATION_ID%%,*}"
gdbus call --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.CloseNotification "$NOTIFICATION_ID" >/dev/null

# --- segment: quick-settings -------------------------------------------------
# Open the GTK panel's unified quick-settings popover.
record_start "quick-settings"
xdotool mousemove --window "$WID" 1263 16 click 1
sleep 2
record_stop
shot "quick-settings"
xdotool key Escape
sleep 1

# --- segment: lock-screen (last: the session stays locked) -----------------
# Change the same GSettings policy a user controls, then require actual lock.
record_start "lock-screen"
gsettings set org.gnome.desktop.session idle-delay 10
assert_state C-LOCK '.locked == true' "idle lock engaged" 45
xdotool mousemove --window "$WID" 640 400 click 1
assert_state C-WAKE '.locked == true and .idle_blank_alpha == 0' "locked screen awake"
sleep 1
# The first input wakes the blanked output; a separate key lifts the curtain.
xdotool key space
sleep 2
keep_state lock-state
record_stop
shot "lock-screen"
if grep -q "panicked" "$LOG"; then
    echo "tuna-capture: panic in nested log" >&2
    grep "panicked" "$LOG" >&2
    exit 1
fi

CLIPS=""
STILLS=""
for seg in $SEGMENTS; do
    CLIPS="$CLIPS $seg.mp4"
    STILLS="$STILLS $seg.png"
done
# shellcheck disable=SC2086
if [ -n "$HAVE_FFMPEG" ]; then
    check_media $CLIPS
fi
# shellcheck disable=SC2086
check_media $STILLS
check_walkthrough

echo "tuna-capture: OK, artifacts in $ARTIFACTS"
