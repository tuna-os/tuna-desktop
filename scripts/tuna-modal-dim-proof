#!/usr/bin/python3
"""Actual native xdg-dialog parent dim rendering proof; requires built binaries + Xvfb.

Run under dbus-run-session. --bin-dir points to a Cargo target/debug directory.
Uses a private display, settings, runtime directory, and manual animation clock.
This is local rendering evidence, not a GNOME paired benchmark or v1 verdict.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import shutil
import hashlib
import signal
import select
import gi
from gi.repository import Gio, GLib
import time
from PIL import Image
p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--bin-dir", type=Path, required=True)
p.add_argument("--artifacts", type=Path, required=True)
p.add_argument("--display", default=":95")
a = p.parse_args()
root = Path(__file__).resolve().parent.parent
art = a.artifacts.resolve()
art.mkdir(parents=True, exist_ok=True)
runtime = art / "runtime"
runtime.mkdir(mode=0o700, exist_ok=True)
os.chmod(runtime, 0o700)
state = art / "state.json"
clock = art / "clock"
command = art / "command.json"
clock.write_text("0\n")
(art / "assertions.txt").unlink(missing_ok=True)
state.unlink(missing_ok=True)
command.unlink(missing_ok=True)
env = dict(os.environ, DISPLAY=a.display, XDG_RUNTIME_DIR=str(runtime),
           XDG_CONFIG_HOME=str(art / "config"), GSETTINGS_BACKEND="keyfile",
           TUNA_COMPOSITOR_STATE=str(state), TUNA_ANIMATION_CLOCK=str(clock),
           TUNA_XWAYLAND="0", LIBGL_ALWAYS_SOFTWARE="1", ADW_DISABLE_PORTAL="1", GSK_RENDERER="cairo", TUNA_LIFECYCLE_COMMAND=str(command))
# Freeze the tested binaries so another worktree's build cannot change this run.
frozen = art / "bin"
frozen.mkdir(exist_ok=True)
def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream,"sha256").hexdigest()
binaries = {}
for name in ("tuna-compositor","tuna-shell-gtk","tuna-modal-dim-client"):
    source = a.bin_dir.resolve() / name
    dest = frozen / name
    shutil.copy2(source,dest)
    binaries[name] = {"source_path":str(source),"sha256":digest(dest)}
manifest = {
    "source_revision":subprocess.check_output(["git","rev-parse","HEAD"],cwd=root,text=True).strip(),
    "source_dirty":bool(subprocess.check_output(["git","status","--porcelain"],cwd=root,text=True).strip()),
    "binaries":binaries,
    "proof_sha256":digest(Path(__file__).resolve()),
    "client_sha256":digest(root / "crates/compositor/examples/tuna-modal-dim-client.rs"),
    "backend":"winit/Xvfb/llvmpipe", "gnome_comparison":False,
}
(art / "manifest.json").write_text(json.dumps(manifest,indent=2))
processes = []
logs = []
def spawn(args, name, extra=None):
    log = (art / f"{name}.log").open("w")
    logs.append(log)
    proc = subprocess.Popen(args, env=env | (extra or {}), stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    processes.append(proc)
    return proc
def wait(check, label):
    end = time.monotonic() + 25
    while time.monotonic() < end:
        try:
            data = json.loads(state.read_text())
            if check(data):
                (art / f"{label}.json").write_text(json.dumps(data, indent=2))
                return data
        except (OSError, ValueError, KeyError, IndexError):
            pass
        time.sleep(.05)
    raise AssertionError(f"timed out: {label}; see {art}")
def screenshot(name):
    time.sleep(.1)
    path = art / f"{name}.png"
    subprocess.run(["scrot", str(path)], env=env, check=True)
    return Image.open(path).convert("RGB")
def move(ms):
    temp = art / "clock.tmp"
    temp.write_text(str(ms))
    before = json.loads(state.read_text())["rendered_frames"]
    temp.replace(clock)
    wait(lambda d:d["animation_clock_ms"] >= clock_base + ms and d["rendered_frames"] >= before+2, f"clock-{ms}")
def action(name, generation):
    temp = art / "command.tmp"
    temp.write_text(json.dumps(dict(action=name, generation=generation)))
    temp.replace(command)
def require_owned_cleanup(cleanup):
    if not cleanup["runtime_removed"] or not cleanup["accessibility_processes_stopped"] or not cleanup["accessibility_identity_verified"]:
        raise AssertionError("owned proof session cleanup failed")

def expected_missing_accessibility_owner(name, remote_error):
    return name == "org.a11y.atspi.Registry" and remote_error == "org.freedesktop.DBus.Error.NameHasNoOwner"

success = False
owned_pidfds = []
accessibility = None
try:
    # Private session buses alone do not isolate the fixed AT-SPI runtime socket.
    launcher = spawn(["/usr/libexec/at-spi-bus-launcher","--launch-immediately"],"atspi")
    session_bus = Gio.bus_get_sync(Gio.BusType.SESSION,None)
    deadline = time.monotonic()+10
    while True:
        try:
            address = session_bus.call_sync("org.a11y.Bus","/org/a11y/bus","org.a11y.Bus","GetAddress",None,None,Gio.DBusCallFlags.NO_AUTO_START,2000,None).unpack()[0]
            break
        except Exception:
            if time.monotonic() >= deadline:
                raise
            time.sleep(.1)
    assert str(runtime) in address, "accessibility bus escaped private runtime"
    env["AT_SPI_BUS_ADDRESS"] = address
    accessibility = Gio.DBusConnection.new_for_address_sync(address,Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,None,None)
    bus_pid = accessibility.call_sync("org.freedesktop.DBus","/org/freedesktop/DBus","org.freedesktop.DBus","GetConnectionUnixProcessID",GLib.Variant("(s)",("org.freedesktop.DBus",)),None,Gio.DBusCallFlags.NONE,2000,None).unpack()[0]
    owned_pidfds.append(os.pidfd_open(bus_pid))
    manifest["session_isolation"] = {
        "runtime_directory":str(runtime), "runtime_mode":oct(runtime.stat().st_mode & 0o777),
        "session_bus":env.get("DBUS_SESSION_BUS_ADDRESS"), "accessibility_bus":address,
        "accessibility_launcher_pid":launcher.pid,"accessibility_bus_pid":bus_pid,
    }
    (art / "manifest.json").write_text(json.dumps(manifest,indent=2))
    # Refuse an existing display; never point the proof at a user's session.
    if Path(f"/tmp/.X11-unix/X{a.display.lstrip(':')}").exists():
        raise RuntimeError("display already in use; choose a private unused display")
    spawn(["Xvfb", a.display, "-screen", "0", "1280x800x24"], "xvfb")
    for _ in range(100):
        if subprocess.run(["xdotool", "getdisplaygeometry"], env=env, capture_output=True).returncode == 0:
            break
        time.sleep(.05)
    if subprocess.run(["gsettings", "range", "org.gnome.desktop.a11y.interface", "reduced-motion"],env=env,capture_output=True).returncode:
        schemas = art / "schemas"
        schemas.mkdir(exist_ok=True)
        shutil.copy(root / "tests/settings/gnome51-a11y-interface.gschema.xml",schemas)
        subprocess.run(["glib-compile-schemas",str(schemas)],check=True)
        env["GSETTINGS_SCHEMA_DIR"] = str(schemas)
    subprocess.run(["gsettings","set","org.gnome.desktop.a11y.interface","reduced-motion","no-preference"],env=env,check=True)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "enable-animations", "true"], env=env, check=True)
    compositor = spawn([str(frozen / "tuna-compositor"), "--socket", "lifecycle-proof", "--shell-bin", str(frozen / "tuna-shell-gtk")], "compositor")
    wait(lambda d: d["animation_clock_manual"] and d["rendered_frames"] >= 5 and d["wallpaper_diagnostics"]["decode_result_count"] > 0 and any(layer["namespace"] == "tuna-panel" for layer in d["layers"]), "ready")
    clock_base = json.loads(state.read_text())["animation_clock_ms"]
    baseline = screenshot("00-baseline")
    client = spawn([str(frozen / "tuna-modal-dim-client")], "client", {"WAYLAND_DISPLAY":"lifecycle-proof"})
    wait(lambda d: len(d["windows"]) == 1 and bool(d["window_lifecycle"]["opening"]), "parent-map")
    move(150)
    ready = wait(lambda d:not d["window_lifecycle"]["opening"],"parent-landed")
    parent = ready["windows"][0]
    parent_id = parent["id"]
    x,y,w,h = parent["rect"]
    point = (x+w-60,y+h-40)
    transparent = (x+20,y+h-40)
    normal = screenshot("01-parent-normal")
    def factor(d):
        return next((e["multiplier"] for e in d["modal_dim"]["parents"] if e["parent"] == parent_id),1.0)
    def pixel_factor(image, factor):
        before = normal.getpixel(point)
        after = image.getpixel(point)
        assert all(abs(after[i]-before[i]*factor)<=2 for i in range(3)), (before,after,factor)
        assert image.getpixel(transparent) == baseline.getpixel(transparent), "dim shader changed transparent parent pixels"
    action("nonmodal",1)
    wait(lambda d:len(d["windows"]) == 2 and bool(d["window_lifecycle"]["opening"]),"nonmodal-mapped")
    move(250)
    wait(lambda d:not d["window_lifecycle"]["opening"],"nonmodal-landed")
    assert factor(json.loads(state.read_text())) == 1.0, "ordinary transient incorrectly dims parent"
    action("set-modal",2)
    started = wait(lambda d:len(d["modal_dim"]["parents"]) == 1 and d["modal_dim"]["running"],"dim-start")
    assert started["modal_dim"]["parents"][0]["duration_ms"] == 500
    move(500)
    half = wait(lambda d:abs(factor(d)-(1.0+(88/127-1.0)*.75))<1e-5,"dim-half-250ms")
    pixel_factor(screenshot("02-dim-half"),factor(half))
    move(750)
    full = wait(lambda d:not d["modal_dim"]["running"] and factor(d)<.7,"dim-full-500ms")
    pixel_factor(screenshot("03-dim-full"),factor(full))
    action("second-dialog",3)
    wait(lambda d:len(d["windows"]) == 3 and bool(d["window_lifecycle"]["opening"]),"overlapping-modals")
    assert abs(factor(json.loads(state.read_text()))-88/127)<1e-5
    move(850)
    wait(lambda d:not d["window_lifecycle"]["opening"],"second-landed")
    action("close-dialog",4)
    wait(lambda d:len(d["windows"]) == 2,"first-modal-closed")
    move(950)
    wait(lambda d:not d["window_lifecycle"]["destroying"],"first-close-landed")
    assert abs(factor(json.loads(state.read_text()))-88/127)<1e-5, "first of two modals undimmed parent"
    action("close-second",5)
    started = wait(lambda d:len(d["windows"]) == 1 and d["modal_dim"]["running"],"undim-start")
    assert started["modal_dim"]["parents"][0]["duration_ms"] == 250
    move(1075)
    half = wait(lambda d:abs(factor(d)-(88/127+(1.0-88/127)*.75))<1e-5,"undim-half-125ms")
    pixel_factor(screenshot("04-undim-half"),factor(half))
    move(1200)
    wait(lambda d:not d["modal_dim"]["parents"],"undim-full-250ms")
    pixel_factor(screenshot("05-undim-full"),1.0)
    subprocess.run(["gsettings","set","org.gnome.desktop.a11y.interface","reduced-motion","reduce"],env=env,check=True)
    wait(lambda d:d["motion_policy"] == "fade-only","reduced-motion")
    action("dialog",6)
    wait(lambda d:len(d["modal_dim"]["parents"]) == 1,"reduced-modal")
    move(1450)
    half=wait(lambda d:abs(factor(d)-(1.0+(88/127-1.0)*.75))<1e-5,"reduced-dim-half")
    pixel_factor(screenshot("06-reduced-dim-half"),factor(half))
    subprocess.run(["gsettings","set","org.gnome.desktop.interface","enable-animations","false"],env=env,check=True)
    snapped = wait(lambda d:d["motion_policy"] == "off" and not d["modal_dim"]["running"] and factor(d)<.7,"off-snap-dim")
    pixel_factor(screenshot("07-off-dim"),factor(snapped))
    action("unset-modal",7)
    wait(lambda d:not d["modal_dim"]["parents"],"off-immediate-undim")
    pixel_factor(screenshot("08-off-undim"),1.0)
    subprocess.run(["gsettings","set","org.gnome.desktop.interface","enable-animations","true"],env=env,check=True)
    wait(lambda d:d["motion_policy"] == "fade-only","restored-fades")
    action("set-modal",8)
    wait(lambda d:len(d["modal_dim"]["parents"]) == 1,"dim-before-parent-close")
    move(1950)
    wait(lambda d:not d["modal_dim"]["running"] and factor(d)<.7,"dim-before-parent-close-full")
    action("close",9)
    client.wait(timeout=10)
    wait(lambda d:not d["windows"] and not d["modal_dim"]["parents"] and len(d["window_lifecycle"]["destroying"]) == 1,"parent-death-clears-state")
    pixel_factor(screenshot("09-closed-parent-retains-dim"),88/127)
    move(2100)
    wait(lambda d:not d["window_lifecycle"]["destroying"],"parent-death-clean")
    assert compositor.poll() is None
    success = True
finally:
    owned_accessibility_pids = [manifest["session_isolation"]["accessibility_bus_pid"]] if "session_isolation" in manifest else []
    cleanup_query_errors = []
    if accessibility:
        for name in ("org.a11y.atspi.Registry",):
            try:
                owned_accessibility_pids.append(accessibility.call_sync("org.freedesktop.DBus","/org/freedesktop/DBus","org.freedesktop.DBus","GetConnectionUnixProcessID",GLib.Variant("(s)",(name,)),None,Gio.DBusCallFlags.NONE,2000,None).unpack()[0])
            except GLib.Error as error:
                if not expected_missing_accessibility_owner(name, Gio.DBusError.get_remote_error(error)):
                    cleanup_query_errors.append(str(error))
            except Exception as error:
                cleanup_query_errors.append(str(error))
    for pid in owned_accessibility_pids[1:]:
        try:
            owned_pidfds.append(os.pidfd_open(pid))
        except ProcessLookupError:
            pass
    for proc in reversed(processes):
        if proc.poll() is None:
            try:
                os.killpg(proc.pid,signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid,signal.SIGKILL)
                proc.wait()
    accessibility_stopped = True
    for pidfd in owned_pidfds:
        poller = select.poll()
        poller.register(pidfd,select.POLLIN)
        try:
            signal.pidfd_send_signal(pidfd,signal.SIGTERM)
        except ProcessLookupError:
            pass
        if not poller.poll(1000):
            signal.pidfd_send_signal(pidfd,signal.SIGKILL)
            accessibility_stopped = bool(poller.poll(1000)) and accessibility_stopped
        os.close(pidfd)
    if accessibility:
        try:
            accessibility.close_sync(None)
        except GLib.Error:
            pass
    shutil.rmtree(runtime)
    manifest["owned_cleanup"] = {"runtime_removed":not runtime.exists(), "accessibility_pids":owned_accessibility_pids,"accessibility_processes_stopped":accessibility_stopped, "accessibility_identity_verified":bool(owned_accessibility_pids) and not cleanup_query_errors, "query_errors":cleanup_query_errors}
    (art / "manifest.json").write_text(json.dumps(manifest,indent=2))
    for log in logs:
        log.close()

require_owned_cleanup(manifest["owned_cleanup"])
if success:
    (art / "assertions.txt").write_text("MD-NATIVE pass explicit xdg-dialog modal; nonmodal transient excluded\nMD-DIM pass 500ms quad RGB-only dim; transparent pixels unchanged\nMD-OVERLAP pass two modal children; first close preserves dim\nMD-UNDIM pass 250ms quad restoration\nMD-MOTION pass actual GTK reduced/off settings bridge\nMD-DEATH pass parent destruction clears state and retained close texture keeps dim\nMD-CLEANUP pass verified private session cleanup\n")
    print(f"native modal dim proof passed: {art}")
