#!/usr/bin/env python3
"""Select, retain and bind authenticated normal-CI native product capsules."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts/lib'))
from native_product import main

if __name__ == '__main__':
    try:
        sys.exit(main(root=ROOT))
    except (ValueError, OSError) as error:
        print('native product: ' + str(error), file=sys.stderr)
        sys.exit(1)
