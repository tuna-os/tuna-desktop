    fail G-SETTINGS-NOTIFICATIONS "external false allowed a banner"
fi
gsettings set org.gnome.desktop.notifications show-banners true
sleep 1
notify "External Banner" "External show-banners true" || fail G-SETTINGS-NOTIFICATIONS "Notify failed"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-dnd-external-banner.json" 20 ||
    fail G-SETTINGS-NOTIFICATIONS "allowed banner dump failed"
showing "$ARTIFACTS/a11y-dnd-external-banner.json" "External Banner" ||
    fail G-SETTINGS-NOTIFICATIONS "external true did not allow a banner"
# Expire the banner and return to the preceding proof's DND-on state.
xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2))
sleep 3.5
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-dnd-external-cleared.json" 20 --press "Clear" ||
    fail G-SETTINGS-NOTIFICATIONS "could not clear external proof notifications"
xdotool key Escape
gsettings set org.gnome.desktop.notifications show-banners false
sleep 1
open_qs
pass G-SETTINGS-NOTIFICATIONS "external show-banners flips update DND toggle and suppress/allow banners"

