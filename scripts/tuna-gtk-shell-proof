    cstate '.active_workspace != null and .locked == false' "screenshot desktop ready" ||
        fail G-SCREENSHOT-KEYS "desktop never became ready"
    if [ "$INSTALLED_PACKAGE" = 0 ]; then
        "$PY" - "$ROOT" "$ARTIFACTS/screenshot-keys-source.json" <<'SCREENSHOT_SOURCE'
import hashlib, json, os, pathlib, subprocess, sys
root, output = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
binaries = pathlib.Path(os.environ.get("TUNA_PROOF_BIN_DIR", root / "target/debug"))
def git(*args):
    return subprocess.check_output(["git", "-C", str(root), *args])
proof = {
    "qualification_scope": "nested GTK screenshot keyboard controls; not hardware or installed-image qualification",
    "source_commit": git("rev-parse", "HEAD").decode().strip(),
    "source_diff_sha256": hashlib.sha256(git("diff", "HEAD", "--binary")).hexdigest(),
    "binary_source_commit": os.environ.get("TUNA_PROOF_BINARY_SOURCE_COMMIT") if os.environ.get("TUNA_PROOF_BIN_DIR") else git("rev-parse", "HEAD").decode().strip(),
    "supplied_binary_dir": os.environ.get("TUNA_PROOF_BIN_DIR"),
    "shell_launcher_override": os.environ.get("TUNA_PROOF_SHELL_BIN"),
    "runtime_directory": os.environ.get("XDG_RUNTIME_DIR"),
    "runtime_mode": oct(pathlib.Path(os.environ["XDG_RUNTIME_DIR"]).stat().st_mode & 0o777),
    "accessibility_bus": os.environ.get("AT_SPI_BUS_ADDRESS"),
    "session_bus": os.environ.get("DBUS_SESSION_BUS_ADDRESS"),
    "binaries": {
        name: hashlib.sha256((binaries / name).read_bytes()).hexdigest()
        for name in ("tuna-compositor", "tuna-shell-gtk")
    },
}
output.write_text(json.dumps(proof, indent=2) + "\n")
SCREENSHOT_SOURCE
    fi
    screenshot_keys_proof
    exit 0
fi
