cat >"$XDG_DATA_HOME/applications/tuna-x-probe.desktop" <<XDESK
[Desktop Entry]
Name=Tuna X Probe
Exec=$ARTIFACTS/bin/tuna-x-probe
Type=Application
XDESK
PROVIDER_PID=""
TRAY_PID=""
OWNED_XVFB=""
COMPOSITOR_PID=""
STUBS_PID=""
CUPS_STUB_PID=""
WWANLOC_STUB_PID=""
SYSBUS_PID=""
ACCEL_PID=""
CAL_PID=""
SCREENSAVER_PID=""
ICON_PID=""
HINTS_PID=""
PERMISSIONS_PID=""
INHIBITOR_PID=""
SCROLL_PROBE_PID=""
SET_FONTS_PID=""
HOT_CORNER_PID=""
OCCLUSION_PIDS=""
A11Y_INPUT_PID=""
CURSOR_PID=""
IME_PIDS=""
GSD_MEDIA_KEYS_PID=""
GSD_BUS_PID=""
MPRIS_PID=""
PW_PULSE_PID=""
cleanup() {
    if [ -n "$ICON_PID" ]; then kill "$ICON_PID" 2>/dev/null || true; fi
    if [ -n "$HINTS_PID" ]; then kill "$HINTS_PID" 2>/dev/null || true; fi
    if [ -n "$INHIBITOR_PID" ]; then kill "$INHIBITOR_PID" 2>/dev/null || true; fi
    if [ -n "$PERMISSIONS_PID" ]; then kill "$PERMISSIONS_PID" 2>/dev/null || true; fi
    if [ -n "$SCROLL_PROBE_PID" ]; then kill "$SCROLL_PROBE_PID" 2>/dev/null || true; fi
    if [ -n "$SET_FONTS_PID" ]; then kill "$SET_FONTS_PID" 2>/dev/null || true; fi
    if [ -n "$HOT_CORNER_PID" ]; then kill "$HOT_CORNER_PID" 2>/dev/null || true; fi
    if [ -n "$A11Y_INPUT_PID" ]; then kill "$A11Y_INPUT_PID" 2>/dev/null || true; fi
    if [ -n "$CURSOR_PID" ]; then kill "$CURSOR_PID" 2>/dev/null || true; fi
    # shellcheck disable=SC2086
    if [ -n "$OCCLUSION_PIDS" ]; then kill $OCCLUSION_PIDS 2>/dev/null || true; fi
    # shellcheck disable=SC2086
    if [ -n "$IME_PIDS" ]; then kill $IME_PIDS 2>/dev/null || true; fi
    # The bridge daemonized ibus-daemon for this session's display.
    if [ -n "${SOCKET_NAME:-}" ] && command -v ibus >/dev/null 2>&1; then
        env -u DISPLAY -u IBUS_ADDRESS -u WAYLAND_SOCKET WAYLAND_DISPLAY="$SOCKET_NAME" \
            ibus exit >/dev/null 2>&1 || true
    fi
    if [ -n "$SCREENSAVER_PID" ]; then kill "$SCREENSAVER_PID" 2>/dev/null || true; fi
    if [ -n "$CAL_PID" ]; then kill "$CAL_PID" 2>/dev/null || true; fi
    for gsd_pid in $GSD_MEDIA_KEYS_PID $MPRIS_PID $GSD_BUS_PID $PW_PULSE_PID; do
        kill "$gsd_pid" 2>/dev/null || true
    done
    if [ -n "$ACCEL_PID" ]; then kill "$ACCEL_PID" 2>/dev/null || true; fi
    if [ -n "$COMPOSITOR_PID" ]; then
        kill "$COMPOSITOR_PID" 2>/dev/null || true
        # Let the owning compositor/shell shut down before their private
        # services and bus disappear underneath them.
        wait "$COMPOSITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$OWNED_XVFB" ]; then kill "$OWNED_XVFB" 2>/dev/null || true; fi
    if [ -n "$STUBS_PID" ]; then kill "$STUBS_PID" 2>/dev/null || true; fi
    if [ -n "$CUPS_STUB_PID" ]; then kill "$CUPS_STUB_PID" 2>/dev/null || true; fi
    if [ -n "$WWANLOC_STUB_PID" ]; then kill "$WWANLOC_STUB_PID" 2>/dev/null || true; fi
    if [ -n "$PROVIDER_PID" ]; then kill "$PROVIDER_PID" 2>/dev/null || true; fi
    if [ -n "$TRAY_PID" ]; then kill "$TRAY_PID" 2>/dev/null || true; fi
    # shellcheck disable=SC2086
    if [ -n "$PW_PIDS" ]; then kill $PW_PIDS 2>/dev/null || true; fi
    for portal_pid in $PORTAL_PIDS; do kill "$portal_pid" 2>/dev/null || true; done
    if [ -n "${AT_SPI_PID:-}" ]; then kill "$AT_SPI_PID" 2>/dev/null || true; fi
    rm -rf "${PIPEWIRE_RUNTIME_DIR:-/nonexistent}"
    if [ -n "$OWNED_RUNTIME" ]; then rm -rf "$OWNED_RUNTIME"; fi
    if [ -n "$SYSBUS_PID" ]; then kill "$SYSBUS_PID" 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM
# Drive compositor animation time (TUNA_ANIMATION_CLOCK): the first
# write freezes it, later writes move it to that moment plus N ms, and
# removing the file resumes real time.
anim_clock() {
    printf '%s\n' "$1" >"$TUNA_ANIMATION_CLOCK.tmp"
    mv "$TUNA_ANIMATION_CLOCK.tmp" "$TUNA_ANIMATION_CLOCK"
}
real_clock() {
    rm -f "$TUNA_ANIMATION_CLOCK"
    cstate '.animation_clock_manual | not' "real animation clock" 5
}
# The family's current value ($2: lift or opacity) within a hair, on the
# frozen animation clock; $3 another jq field of the family (value).
tvalue() {
    cstate "(.transitions.$1.${3:-value} // -9) - ($2) | fabs < 0.002" "$1 ${3:-value} $2" 10
}
# One transition family counter from the compositor state:
# `tval <family> <started|animated_frames>`.
tval() {
    jq -r ".transitions.$1.$2" "$CSTATE"
}
# The family has settled with more starts than $2 and, when $3 is set,
# more animated frames than it (animations on) or exactly as many (when
# $4 is "same": the change was instant).
tsettled() {
    if [ "${4:-}" = same ]; then
        frames=".transitions.$1.animated_frames == $3"
    else
        frames=".transitions.$1.animated_frames > $3"
    fi
    cstate ".transitions.$1.started > $2 and $frames and (.transitions.$1.active | not)" "$1 settled" "${5:-15}"
}
# RGB of one pixel of a PNG, as "r g b".
px() {
    ffmpeg -loglevel error -i "$1" -vf "crop=1:1:$2:$3" -f rawvideo -pix_fmt rgb24 - |
        od -An -tu1 | tr -s ' ' | sed 's/^ //; s/ $//'
}
pass() { echo "$1 pass $2" >>"$ASSERTIONS"; echo "tuna-gtk-shell-proof: $1 pass: $2"; }
fail() {
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "tuna-gtk-shell-proof: $1 FAIL: $2" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
}

showing() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$1" >/dev/null
}

hidden() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .showing) | not' "$1" >/dev/null
}

# A showing push button named NAME: quick settings' "Lock Screen" shares
# its name with the lock surfaces' frames (GNOME's name for both).
button_showing() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .showing and (.role == "push button" or .role == "button"))' "$1" >/dev/null
}

focused() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .focused)' "$1" >/dev/null
}

cstate() {
    end=$(($(date +%s) + ${3:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.3
    done
    echo "tuna-gtk-shell-proof: compositor state was:" >&2
    cat "$CSTATE" >&2 2>/dev/null || true
    return 1
}

