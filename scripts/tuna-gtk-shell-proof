showing "$ARTIFACTS/a11y-nm-vpn.json" "VPN authentication" || fail G-NM-VPN "no plugin-provided title"
showing "$ARTIFACTS/a11y-nm-vpn.json" "VPN Password" || fail G-NM-VPN "no plugin-provided secret field"
scrot "$ARTIFACTS/15f-network-vpn.png" >/dev/null
xdotool type --delay 20 vpn-password
xdotool key Return
nm_answered '^ProofSecrets vpn flags=1 password=vpn-password username=alice' || fail G-NM-VPN "VPN secrets dictionary is wrong"
nm_request vpn 0
nm_answered '^ProofSecrets vpn flags=0 password=vpn-password username=alice' || fail G-NM-VPN "stored VPN password not reused"
pass G-NM-VPN "external-UI VPN helper drives shell prompt, returned secret dictionary and keyring reuse"

