# in the dash) follow Alpha, Beta, Gamma.
n=0
for spec in Alpha:#3584e4 Beta:#2ec27e Gamma:#e66100; do
    WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" \
        "${spec%%:*}" "${spec#*:}" >"$ARTIFACTS/window-${spec%%:*}.log" 2>&1 &
    fixture_pid=$!
    n=$((n + 1))
    cstate "(.windows | length) == $n" "window $n" ||
        fail G-WINDOWS "${spec%%:*} never mapped"
    if [ "${spec%%:*}" = Alpha ]; then
        "$PY" "$ROOT/scripts/lib/tuna_window_menu_fixture.py" record "$CSTATE" "$ARTIFACTS/alpha-window-owner.json" "$fixture_pid" ||
            fail G-WINDOWS "original native Alpha launch identity could not be recorded"
    fi
done
cstate '(.windows | length) == 3' "three app windows" ||
    fail G-WINDOWS "three libadwaita windows never mapped"
pass G-WINDOWS "three libadwaita windows mapped"
