    --grayscale false --fade false \
    --start-clock-ms "$((WB_FROZEN + 0))" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-reset-ramp-check.json" ||
    fail G-WELLBEING-PIXEL-RESET "neutral did not hold across stepped time"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '(.animation_clock_manual | not) and .wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "real neutral" ||
    fail G-WELLBEING-PIXEL-RESET "real time did not resume neutral"
wb_provenance_finish
pass G-WELLBEING-PIXEL-RESET "reset-to-neutral holds across stepped animation time with no restore fade"

# Take-with-lock: an ACTUAL Take press on the due banner locks the session
# (lock-screen toggle on). Without pam_wrapper the session could not
# unlock to continue, so the gate records infeasible evidence and skips
# exactly like G-UNLOCK; it never passes weakly.
wb_gate_begin G-WELLBEING-ACTION-TAKE-LOCK
if [ -z "$PAM_ON" ]; then
    jq -n --arg reason "no pam_wrapper: locking would strand the journey (G-UNLOCK also skips)" \
        '{gate:"G-WELLBEING-ACTION-TAKE-LOCK",verdict:"infeasible",reason:$reason}' \
        >"$ARTIFACTS/wb-G-WELLBEING-ACTION-TAKE-LOCK-infeasible.json"
    echo "tuna-gtk-shell-proof: G-WELLBEING-ACTION-TAKE-LOCK skipped (no pam_wrapper)"
else
    # The probe is ensured (not sampled) so capture-time provenance binds
    # the same three processes in every gate.
    wb_probe_ensure
    gsettings set org.gnome.desktop.notifications show-banners true ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not show banners"
    cstate '(.overview_open | not)' "no overview" ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "the overview is open"
    gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not set the break interval"
    gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 10 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not set the break duration"
    gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not silence the countdown OSD"
    gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen false ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not clear fade-screen"
    gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen true ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not set lock-screen"
    gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not select the eyesight break"
    wb_press_banner G-WELLBEING-ACTION-TAKE-LOCK "$ARTIFACTS/a11y-wb-take-lock-due.json" \
        "Time for an Eyesight Break" Take 25 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "no due banner to take"
    cstate '.locked' "locked" 10 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "Take did not lock the session"
    wb_state_capture take-lock-locked
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" locked-state \
        --cstate-before "$ARTIFACTS/wb-take-lock-locked-cstate-before.json" \
        --cstate-after "$ARTIFACTS/wb-take-lock-locked-cstate-after.json" \
        --proc-before "$ARTIFACTS/wb-take-lock-locked-proc-before.json" \
        --proc-after "$ARTIFACTS/wb-take-lock-locked-proc-after.json" \
        --label take-lock-locked ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "lock not observed in state (full typed presence, redaction, sandwich)"
    cp "$CSTATE" "$ARTIFACTS/wb-take-lock-stale-before.json"
    stale_code=0
    wb_a11y_dump "$ARTIFACTS/a11y-wb-take-lock-stale.json" 20 --press "Take" >/dev/null 2>&1 || stale_code=$?
    cp "$CSTATE" "$ARTIFACTS/wb-take-lock-stale-after.json"
    wb_a11y_dump "$ARTIFACTS/a11y-wb-take-lock-retired.json" 20 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "a11y bus dead or owned shell tree gone; retired UI cannot be qualified"
    take_lock_retired_seq="$WB_DUMP_SEQ"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" stale-press \
        --exit-code "$stale_code" \
        --before "$ARTIFACTS/wb-take-lock-stale-before.json" \
        --after "$ARTIFACTS/wb-take-lock-stale-after.json" \
        --action Take \
        --dump "$ARTIFACTS/a11y-wb-take-lock-retired.json" \
        --title "Time for an Eyesight Break" \
        --gate-start "$WB_START" \
        --expect-pid "$WB_SHELL_PID" \
        --expect-start "$WB_SHELL_START" \
        --stamp "$ARTIFACTS/a11y-wb-take-lock-retired.json.stamp" \
        --expect-gate G-WELLBEING-ACTION-TAKE-LOCK \
        --expect-nonce "$WB_NONCE" \
        --expect-seq "$take_lock_retired_seq" ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "a stale Take press fired"
    sleep 1
    xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT * 3 / 4)) click 1 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not lift the curtain"
    sleep 1
    xdotool type --delay 30 "$UNLOCK_PASSWORD" ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not type the password"
    xdotool key Return || fail G-WELLBEING-ACTION-TAKE-LOCK "could not submit"
    cstate '(.locked | not)' "unlocked" 15 ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "the password did not unlock"
    wb_break_cleanup
    gsettings set org.gnome.desktop.notifications show-banners false ||
        fail G-WELLBEING-ACTION-TAKE-LOCK "could not restore DND"
    wb_provenance_finish
    pass G-WELLBEING-ACTION-TAKE-LOCK "an actual Take press locks the session (state-only locked evidence) and a stale Take fails"
fi

# Take-with-fade: an ACTUAL Take press (lock off, fade on) produces a
# faded frame at brightness 0.6 on the owned probe.
wb_gate_begin G-WELLBEING-ACTION-TAKE-FADE
wb_probe_ensure
gsettings set org.gnome.desktop.notifications show-banners true ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not show banners"
cstate '(.overview_open | not)' "no overview" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "the overview is open"
cstate '.motion_policy == "full"' "full motion" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "motion is not full"
cstate '.wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "neutral" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "effects are not neutral at gate start"
# Freeze brackets the baseline only: bracketed captures require identical
# typed manual-clock samples, while the live break countdown and fade run
# on real time below.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "the clock file did not freeze animation time"
wb_capture take-fade-baseline
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" owned-interior \
    --image "$ARTIFACTS/wb-take-fade-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --rgb 143,63,208 \
    --cstate-before "$ARTIFACTS/wb-take-fade-baseline-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-take-fade-baseline-cstate-after.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-take-fade-baseline-check.json" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "baseline is not the live owned probe interior (overlap?)"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '.animation_clock_manual | not' "real clock" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "real time did not resume after the baseline"
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not set the break interval"
# The break must outlive settle + capture + stale check so the settled
# 0.6 fade the gate asserts cannot end mid-observation (setup, not tolerance).
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 60 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not set the break duration"
gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not silence the countdown OSD"
gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen true ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not set fade-screen"
gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen false ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not clear lock-screen"
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not select the eyesight break"
wb_press_banner G-WELLBEING-ACTION-TAKE-FADE "$ARTIFACTS/a11y-wb-take-fade-due.json" \
    "Time for an Eyesight Break" Take 25 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "no due banner to take"
cstate '.wellbeing_effects.brightness < 1' "fade started" 10 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "Take produced no fade"
# The compositor stores effects as f32: settled brightness serializes as
# 0.6000000238418579, which exact f64 equality can never match. Compare
# within 1e-6 of the unchanged 0.6 target instead, and require the ramp
# to have finished so a still-running pass near target cannot qualify.
cstate '(.wellbeing_effects.animating == false) and ((.wellbeing_effects.brightness - 0.6 | if . < 0 then -. else . end) < 0.000001)' "fade settled" 10 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "the fade did not settle at 0.6"
# Re-freeze the settled fade for its bracketed capture: progress already
# reached 1, so freezing holds 0.6 instead of stalling a live ramp.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "the clock file did not freeze animation time"
wb_capture take-fade-settled
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" fade-sample \
    "$ARTIFACTS/wb-take-fade-settled-cstate-after.json" --expect faded ||
    fail G-WELLBEING-ACTION-TAKE-FADE "faded sample not observed in state"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" verify \
    --baseline "$ARTIFACTS/wb-take-fade-baseline.png" \
    --current "$ARTIFACTS/wb-take-fade-settled.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 0 --brightness 0.6 \
    --cstate-before "$ARTIFACTS/wb-take-fade-settled-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-take-fade-settled-cstate-after.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-take-fade-check.json" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "no faded frame on the owned probe"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '.animation_clock_manual | not' "real clock" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "real time did not resume after the settled capture"
cp "$CSTATE" "$ARTIFACTS/wb-take-fade-stale-before.json"
stale_code=0
wb_a11y_dump "$ARTIFACTS/a11y-wb-take-fade-stale.json" 20 --press "Take" >/dev/null 2>&1 || stale_code=$?
cp "$CSTATE" "$ARTIFACTS/wb-take-fade-stale-after.json"
wb_a11y_dump "$ARTIFACTS/a11y-wb-take-fade-retired.json" 20 ||
    fail G-WELLBEING-ACTION-TAKE-FADE "a11y bus dead or owned shell tree gone; retired UI cannot be qualified"
take_fade_retired_seq="$WB_DUMP_SEQ"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" stale-press \
    --exit-code "$stale_code" \
    --before "$ARTIFACTS/wb-take-fade-stale-before.json" \
    --after "$ARTIFACTS/wb-take-fade-stale-after.json" \
    --action Take \
    --dump "$ARTIFACTS/a11y-wb-take-fade-retired.json" \
    --title "Time for an Eyesight Break" \
    --gate-start "$WB_START" \
    --expect-pid "$WB_SHELL_PID" \
    --expect-start "$WB_SHELL_START" \
    --stamp "$ARTIFACTS/a11y-wb-take-fade-retired.json.stamp" \
    --expect-gate G-WELLBEING-ACTION-TAKE-FADE \
    --expect-nonce "$WB_NONCE" \
    --expect-seq "$take_fade_retired_seq" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "a stale Take press fired"
wb_break_cleanup
gsettings set org.gnome.desktop.notifications show-banners false ||
    fail G-WELLBEING-ACTION-TAKE-FADE "could not restore DND"
cstate '.wellbeing_effects.brightness == 1' "neutral" ||
    fail G-WELLBEING-ACTION-TAKE-FADE "the fade outlived cleanup"
wb_provenance_finish
pass G-WELLBEING-ACTION-TAKE-FADE "an actual Take press fades a frame to brightness 0.6 and a stale Take fails"

# Delay: an ACTUAL Delay press moves the live due by delay-seconds (30s),
# observed as the next due banner's arrival time.
wb_gate_begin G-WELLBEING-ACTION-DELAY
wb_probe_ensure
gsettings set org.gnome.desktop.notifications show-banners true ||
    fail G-WELLBEING-ACTION-DELAY "could not show banners"
cstate '(.overview_open | not)' "no overview" ||
    fail G-WELLBEING-ACTION-DELAY "the overview is open"
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10 ||
    fail G-WELLBEING-ACTION-DELAY "could not set the break interval"
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 10 ||
    fail G-WELLBEING-ACTION-DELAY "could not set the break duration"
gsettings set org.gnome.desktop.break-reminders.eyesight delay-seconds 30 ||
    fail G-WELLBEING-ACTION-DELAY "could not set delay-seconds"
gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
    fail G-WELLBEING-ACTION-DELAY "could not silence the countdown OSD"
gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen false ||
    fail G-WELLBEING-ACTION-DELAY "could not clear fade-screen"
gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen false ||
    fail G-WELLBEING-ACTION-DELAY "could not clear lock-screen"
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
    fail G-WELLBEING-ACTION-DELAY "could not select the eyesight break"
wb_press_banner G-WELLBEING-ACTION-DELAY "$ARTIFACTS/a11y-wb-delay-due.json" \
    "Time for an Eyesight Break" Delay 25 ||
    fail G-WELLBEING-ACTION-DELAY "no due banner to delay"
delay_due_epoch="$WB_PRESS_EPOCH"
cp "$CSTATE" "$ARTIFACTS/wb-delay-stale-before.json"
stale_code=0
wb_a11y_dump "$ARTIFACTS/a11y-wb-delay-stale.json" 20 --press "Delay" >/dev/null 2>&1 || stale_code=$?
cp "$CSTATE" "$ARTIFACTS/wb-delay-stale-after.json"
# The retired dump is taken now (the redue banner is not showing yet);
# the stale verdict waits for the redue so the due schedule the live
# press set is proven undisturbed by the stale press.
wb_a11y_dump "$ARTIFACTS/a11y-wb-delay-retired.json" 20 ||
    fail G-WELLBEING-ACTION-DELAY "a11y bus dead or owned shell tree gone; retired UI cannot be qualified"
delay_retired_seq="$WB_DUMP_SEQ"
DELAYREDUE=""
end=$(($(date +%s) + 45))
while [ "$(date +%s)" -le "$end" ]; do
    xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2)) ||
        fail G-WELLBEING-ACTION-DELAY "keep-alive failed"
    sleep 1
    xdotool mousemove --window "$WID" $((WIDTH / 3 + 40)) $((HEIGHT / 2)) ||
        fail G-WELLBEING-ACTION-DELAY "keep-alive failed"
    sleep 1
    wb_a11y_dump "$ARTIFACTS/a11y-wb-delay-redue.json" 20 >/dev/null 2>&1 || continue
    if showing "$ARTIFACTS/a11y-wb-delay-redue.json" "Time for an Eyesight Break"; then
        delay_redue_epoch="$(date +%s)"
        DELAYREDUE=1
        break
    fi
done
[ -n "$DELAYREDUE" ] || fail G-WELLBEING-ACTION-DELAY "no redue banner after Delay"
wb_capture_after_live_action delay-redue
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" delay \
    --old-due "$delay_due_epoch" --new-due "$delay_redue_epoch" --delay-secs 30 ||
    fail G-WELLBEING-ACTION-DELAY "live due did not move by delay-seconds"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" stale-press \
    --exit-code "$stale_code" \
    --before "$ARTIFACTS/wb-delay-stale-before.json" \
    --after "$ARTIFACTS/wb-delay-stale-after.json" \
    --action Delay \
    --dump "$ARTIFACTS/a11y-wb-delay-retired.json" \
    --title "Time for an Eyesight Break" \
    --gate-start "$WB_START" \
    --expect-pid "$WB_SHELL_PID" \
    --expect-start "$WB_SHELL_START" \
    --stamp "$ARTIFACTS/a11y-wb-delay-retired.json.stamp" \
    --expect-gate G-WELLBEING-ACTION-DELAY \
    --expect-nonce "$WB_NONCE" \
    --expect-seq "$delay_retired_seq" \
    --due-kind delay --due-old "$delay_due_epoch" --due-new "$delay_redue_epoch" --due-expect 30 ||
    fail G-WELLBEING-ACTION-DELAY "a stale Delay press fired"
wb_break_cleanup
gsettings set org.gnome.desktop.notifications show-banners false ||
    fail G-WELLBEING-ACTION-DELAY "could not restore DND"
wb_provenance_finish
pass G-WELLBEING-ACTION-DELAY "an actual Delay press moves the live due by delay-seconds and a stale Delay fails"

# Skip: GNOME 51 offers Skip ONLY on the upcoming notice (breakManager.js
# at 2177bdf9, lines 985-1023); the due notice carries Delay+Take with no
# Skip (lines 1133-1162). An ACTUAL Skip press on the upcoming warning
# retires it and leaves the due schedule undisturbed (the press is a
# timer no-op), observed as the due banner still arriving on the
# original schedule. A stale Skip press must fail.
wb_gate_begin G-WELLBEING-ACTION-SKIP
wb_probe_ensure
gsettings set org.gnome.desktop.notifications show-banners true ||
    fail G-WELLBEING-ACTION-SKIP "could not show banners"
cstate '(.overview_open | not)' "no overview" ||
    fail G-WELLBEING-ACTION-SKIP "the overview is open"
# Interval 130: with remaining 130 at enable, the one-shot upcoming warning
# posts ~10 s into the poll (first 2 s tick with remaining <= 120), mid-poll
# with warm dumps. At 65 it posts on the select-breaks tick itself and its
# 4 s fuse expires before the first dumps can see it (run 38467423094).
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 130 ||
    fail G-WELLBEING-ACTION-SKIP "could not set the break interval"
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 10 ||
    fail G-WELLBEING-ACTION-SKIP "could not set the break duration"
gsettings set org.gnome.desktop.break-reminders.eyesight delay-seconds 30 ||
    fail G-WELLBEING-ACTION-SKIP "could not set delay-seconds"
gsettings set org.gnome.desktop.break-reminders.eyesight notify-upcoming true ||
    fail G-WELLBEING-ACTION-SKIP "could not enable upcoming notices"
gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
    fail G-WELLBEING-ACTION-SKIP "could not silence the countdown OSD"
gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen false ||
    fail G-WELLBEING-ACTION-SKIP "could not clear fade-screen"
gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen false ||
    fail G-WELLBEING-ACTION-SKIP "could not clear lock-screen"
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
    fail G-WELLBEING-ACTION-SKIP "could not select the eyesight break"
skip_enable_epoch="$(date +%s)"
skip_orig_due_epoch=$((skip_enable_epoch + 130))
wb_press_banner G-WELLBEING-ACTION-SKIP "$ARTIFACTS/a11y-wb-skip-upcoming.json" \
    "Eyesight Break Soon" Skip 30 ||
    fail G-WELLBEING-ACTION-SKIP "no upcoming banner to skip"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" notice-buttons \
    "$ARTIFACTS/a11y-wb-skip-upcoming.json" --title "Eyesight Break Soon" \
    --expect Delay,Skip --reject Take ||
    fail G-WELLBEING-ACTION-SKIP "the upcoming banner does not offer Delay+Skip without Take"
cp "$CSTATE" "$ARTIFACTS/wb-skip-stale-before.json"
stale_code=0
wb_a11y_dump "$ARTIFACTS/a11y-wb-skip-stale.json" 20 --press "Skip" >/dev/null 2>&1 || stale_code=$?
cp "$CSTATE" "$ARTIFACTS/wb-skip-stale-after.json"
# The retired dump is taken now (the due banner is not showing yet);
# the stale verdict waits for the due so the original schedule the
# live press left undisturbed is proven intact after the stale press.
wb_a11y_dump "$ARTIFACTS/a11y-wb-skip-retired.json" 20 ||
    fail G-WELLBEING-ACTION-SKIP "a11y bus dead or owned shell tree gone; retired UI cannot be qualified"
skip_retired_seq="$WB_DUMP_SEQ"
# Sample at wb_press_banner's cadence: one keep-alive move per 0.5 s step
# keeps idle under GNOME's IDLE_TIME (1 s), so the due banner shows to an
# active user for the full BANNER_TIMEOUT. With 1 s gaps the banner could
# post to an "away" user and expire 2 s after the next move, and a sample
# could then land in its slide-out, when expiry has retired its actions
# and the shell is clearing the card mid-walk (title seen, action row
# already gone). A sample counts once the banner's action row is
# observable (any notice action pressable); the Take+Delay/no-Skip
# verdict below is pinned on that same sample. Arrival is the first
# sighting of the title.
SKIPDUE=""
skip_due_epoch=""
skip_step=0
end=$(($(date +%s) + 150))
while [ "$(date +%s)" -le "$end" ]; do
    xdotool mousemove --window "$WID" $((WIDTH / 3 + skip_step % 2 * 40)) $((HEIGHT / 2)) ||
        fail G-WELLBEING-ACTION-SKIP "keep-alive failed"
    skip_step=$((skip_step + 1))
    sleep 0.5
    wb_a11y_dump "$ARTIFACTS/a11y-wb-skip-due.json" 20 >/dev/null 2>&1 || continue
    showing "$ARTIFACTS/a11y-wb-skip-due.json" "Time for an Eyesight Break" || continue
    if [ -z "$skip_due_epoch" ]; then
        skip_due_epoch="$(date +%s)"
        # The banner lives BANNER_TIMEOUT (4 s) once shown.
        end=$((skip_due_epoch + 6))
    fi
    if jq -e 'any(.[]; (.name == "Take" or .name == "Delay" or .name == "Skip")
            and .role != "label" and .showing)' \
        "$ARTIFACTS/a11y-wb-skip-due.json" >/dev/null; then
        SKIPDUE=1
        break
    fi
done
[ -n "$skip_due_epoch" ] || fail G-WELLBEING-ACTION-SKIP "no due banner on the original schedule after Skip"
[ -n "$SKIPDUE" ] || fail G-WELLBEING-ACTION-SKIP "the due banner does not offer Take+Delay without Skip"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" notice-buttons \
    "$ARTIFACTS/a11y-wb-skip-due.json" --title "Time for an Eyesight Break" \
    --expect Take,Delay --reject Skip ||
    fail G-WELLBEING-ACTION-SKIP "the due banner does not offer Take+Delay without Skip"
# Capture label stays skip-redue: pinned by test_wb_shell_contract.py.
wb_capture_after_live_action skip-redue
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" skip-undisturbed \
    --orig-due "$skip_orig_due_epoch" --due-arrival "$skip_due_epoch" ||
    fail G-WELLBEING-ACTION-SKIP "the Skip press disturbed the due schedule"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" stale-press \
    --exit-code "$stale_code" \
    --before "$ARTIFACTS/wb-skip-stale-before.json" \
    --after "$ARTIFACTS/wb-skip-stale-after.json" \
    --action Skip \
    --dump "$ARTIFACTS/a11y-wb-skip-retired.json" \
    --title "Eyesight Break Soon" \
    --gate-start "$WB_START" \
    --expect-pid "$WB_SHELL_PID" \
    --expect-start "$WB_SHELL_START" \
    --stamp "$ARTIFACTS/a11y-wb-skip-retired.json.stamp" \
    --expect-gate G-WELLBEING-ACTION-SKIP \
    --expect-nonce "$WB_NONCE" \
    --expect-seq "$skip_retired_seq" \
    --due-kind skip-undisturbed --due-old "$skip_orig_due_epoch" --due-new "$skip_due_epoch" --due-expect 0 ||
    fail G-WELLBEING-ACTION-SKIP "a stale Skip press fired"
wb_break_cleanup
gsettings set org.gnome.desktop.notifications show-banners false ||
    fail G-WELLBEING-ACTION-SKIP "could not restore DND"
wb_provenance_finish
pass G-WELLBEING-ACTION-SKIP "an actual Skip press on the upcoming notice retires it with the schedule undisturbed and a stale Skip fails"

# Negative controls: neutral frames FAIL the effect assertions (assertion
# failure, same build, not source-identity failure); intermediate RGB is
# asserted explicitly, not just endpoints; a post-cleanup stale press FAILS.
# The intermediates' brackets were proven when their ramps consumed them,
# so this gate re-verifies their pixels only. Callback-retirement stays
