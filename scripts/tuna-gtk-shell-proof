pass G-GRID-REORDER "an app dropped on a tile's edge takes its place and the grid is saved as GNOME saves it"
xdotool key Escape
cstate '.overview_open | not' "closed" || { xdotool key Escape; cstate '.overview_open | not' "closed" || fail G-GRID-REORDER "overview stayed open"; }
# Moving an item to another page leaves its old page short; a catalog
# rebuild must respect those saved page boundaries instead of flattening.
"$PY" "$ROOT/scripts/lib/grid-target-settled-tests.py" >"$ARTIFACTS/grid-target-settled-tests.log" 2>&1 ||
    fail G-GRID-SHORT-PAGES "settled target negative controls failed"
gsettings set org.gnome.shell app-picker-layout "[{'tuna-move-One.desktop': <{'position': <0>}>, 'tuna-move-Three.desktop': <{'position': <1>}>}, {'tuna-move-Two.desktop': <{'position': <0>}>}]"
printf '[Desktop Entry]\nName=ZZZ Rebuild Probe\nExec=true\nType=Application\n' >"$XDG_DATA_HOME/applications/tuna-grid-rebuild.desktop"
sleep 1.5
xdotool key super+a
cstate '.overview_open and .overview_app_grid' "short page setup" || fail G-GRID-SHORT-PAGES "app grid missing"
# The probe in the tree proves the rebuild that read the saved pages.
a11y_settled "$ARTIFACTS/a11y-grid-short-before.json" 'select(any(.[]; .name == "ZZZ Rebuild Probe")) | [.[] | select(.showing and (.role == "push button" or .role == "button") and .name == "AAA Move Three")][0].bounds | select(. != null)' ||
    fail G-GRID-SHORT-PAGES "setup grid never settled"
grid_origin
grid_shown "$ARTIFACTS/a11y-grid-short-before.json" "AAA Move Three" || fail G-GRID-SHORT-PAGES "source missing from first page"
if grid_shown "$ARTIFACTS/a11y-grid-short-before.json" "AAA Move Two"; then fail G-GRID-SHORT-PAGES "saved second page was flattened"; fi
grid_origin
grid_coordinates="$(grid_point "$ARTIFACTS/a11y-grid-short-before.json" "AAA Move Three")" || fail G-GRID-SHORT-PAGES "source tile bounds missing"
read -r source_x source_y <<EOF
$grid_coordinates
EOF
xdotool mousemove --window "$WID" "$source_x" "$source_y"
sleep 0.3
xdotool mousedown 1
sleep 0.1
for step in $(seq 1 6); do
    xdotool mousemove --window "$WID" $((source_x + step * 10)) "$source_y"
    sleep 0.05
done
# The drag starts once GTK sees the held pointer pass its threshold, which
# a loaded runner can deliver after these steps: bump the edge only then.
a11y_until "$ARTIFACTS/a11y-grid-short-drag.json" 'any(.[]; .showing and .name == "Next page preview")' ||
    fail G-GRID-SHORT-PAGES "the drag did not start"
xdotool mousemove --window "$WID" $((WIDTH - 6)) 330
# Observe the owned target while keeping the drag at the page edge. A
# merely visible tile can still move 21px before release, turning +4px
# reorder into an OnIcon folder drop. Require fully onscreen fresh bounds
# unchanged for 200ms, with one absolute 10s deadline (including AT-SPI).
grid_target_pid="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk | head -1 || true)"
[ -n "$grid_target_pid" ] || fail G-GRID-SHORT-PAGES "owned shell PID missing"
grid_coordinates="$("$PY" "$ROOT/scripts/lib/grid-target-settled.py" \
    --dump "$ROOT/scripts/lib/tuna-a11y-dump.py" --out "$ARTIFACTS/a11y-grid-short-target.json" \
    --receipt "$ARTIFACTS/grid-short-target-settled.json" --name "AAA Move Two" \
    --pid "$grid_target_pid" --origin "$grid_origin_x" "$grid_origin_y" \
    --viewport "$WIDTH" "$HEIGHT" --timeout 10)" ||
    fail G-GRID-SHORT-PAGES "owned second-page target did not settle within 10s at the edge"
read -r target_x target_y <<EOF
$grid_coordinates
EOF
xdotool mousemove --window "$WID" "$target_x" "$target_y"
sleep 0.35
xdotool mouseup 1
short_end=$(($(date +%s) + 10))
until "$PY" -c 'from gi.repository import Gio; import json; pages=Gio.Settings.new("org.gnome.shell").get_value("app-picker-layout").unpack(); print(json.dumps([sorted(page, key=lambda key: page[key]["position"]) for page in pages]))' >"$ARTIFACTS/grid-short-pages.json" &&
    jq -e '.[0] == ["tuna-move-One.desktop"] and .[1][0:2] == ["tuna-move-Three.desktop", "tuna-move-Two.desktop"]' "$ARTIFACTS/grid-short-pages.json" >/dev/null; do
    [ "$(date +%s)" -lt "$short_end" ] || fail G-GRID-SHORT-PAGES "cross-page move did not leave the source short"
    sleep 0.2
done
# Another installed entry changes the catalog. The grid lists the catalog
# as the overview opens, so reopen it and wait for the entry: a rebuild
# that must keep the saved short page.
printf '[Desktop Entry]\nName=ZZZ Rebuild Probe Two\nExec=true\nType=Application\n' >"$XDG_DATA_HOME/applications/tuna-grid-rebuild-two.desktop"
xdotool key Escape
cstate '.overview_open | not' "short grid closed for the rebuild" || fail G-GRID-SHORT-PAGES "overview stayed open"
xdotool key super+a
cstate '.overview_open and .overview_app_grid' "short grid reopened" || fail G-GRID-SHORT-PAGES "app grid missing after reopening"
a11y_settled "$ARTIFACTS/a11y-grid-short-rebuilt.json" 'select(any(.[]; .name == "ZZZ Rebuild Probe Two")) | [.[] | select(.showing and (.role == "push button" or .role == "button") and .name == "AAA Move One")][0].bounds | select(. != null)' ||
    fail G-GRID-SHORT-PAGES "the rebuilt grid never showed the new entry"
grid_shown "$ARTIFACTS/a11y-grid-short-rebuilt.json" "AAA Move One" || fail G-GRID-SHORT-PAGES "short first page lost its item"
if grid_shown "$ARTIFACTS/a11y-grid-short-rebuilt.json" "AAA Move Two" || grid_shown "$ARTIFACTS/a11y-grid-short-rebuilt.json" "AAA Move Three"; then fail G-GRID-SHORT-PAGES "rebuilding filled the short first page"; fi
pass G-GRID-SHORT-PAGES "a cross-page drag leaves its source short and the saved boundary survives a catalog rebuild"
xdotool key Escape
cstate '.overview_open | not' "short grid closed" || fail G-GRID-SHORT-PAGES "overview stayed open"
gsettings reset org.gnome.shell app-picker-layout
rm -f "$XDG_DATA_HOME"/applications/tuna-grid-rebuild*.desktop
rm -f "$XDG_DATA_HOME"/applications/tuna-move-*.desktop
sleep 1.5

# Search providers (#57): a D-Bus provider's result lists under the
# apps, and clicking it hands the result back to the provider.
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-SEARCH-PROVIDER "overview did not reopen"
sleep 1
xdotool type --delay 40 "report"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-provider.json" 20 ||
    fail G-SEARCH-PROVIDER "accessibility dump failed"
scrot "$ARTIFACTS/10b-search-provider.png" >/dev/null
showing "$ARTIFACTS/a11y-provider.json" "Quarterly Report.odt" ||
    fail G-SEARCH-PROVIDER "the provider's result is not listed"
pass G-SEARCH-PROVIDER "typing lists a D-Bus search provider's result"
cstate '.overview_search' "search view" ||
    fail G-SEARCH-VIEW "the compositor kept the workspace view during search"
cstate '.overview_search and .overview_motion.search == 1' "search fade settled" ||
    fail G-SEARCH-VIEW "the workspace view did not finish fading out for search"
pass G-SEARCH-VIEW "search results fade the workspace view out"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-provider-press.json" 20 \
    --press "Quarterly Report.odt" || fail G-SEARCH-ACTIVATE "could not press the result"
end=$(($(date +%s) + 10))
until [ -s "$SEARCH_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "^activate doc-1 report" "$SEARCH_MARKER" 2>/dev/null ||
    fail G-SEARCH-ACTIVATE "ActivateResult never reached the provider"
cstate '.overview_open | not' "closed" || fail G-SEARCH-ACTIVATE "overview stayed open"
cstate '.overview_search | not' "search reset" ||
    fail G-SEARCH-ACTIVATE "search state outlived the overview"
pass G-SEARCH-ACTIVATE "clicking a provider result activates it and closes the overview"

xdotool key Super_L
cstate '.overview_open' "overview" || fail G-OV-APPGRID "overview did not reopen"
sleep 1
grid_fade_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid.json" 20 --press "Show Apps" ||
    fail G-OV-APPGRID "could not press Show Apps"
showing "$ARTIFACTS/a11y-grid.json" "Tuna Probe" ||
    fail G-OV-APPGRID "app grid does not list installed apps"
cstate '.overview_app_grid and .overview_motion.last_morph.cause == "app-grid" and .overview_motion.last_morph.curve == "ease-out-sine" and .overview_motion.last_morph.duration_ms == 250' "picker to grid morph" ||
    fail G-OV-APPGRID "the window picker did not ease into the app grid (250 ms out-sine)"
pass G-OV-APPGRID "Show Apps eases the window picker into the app grid"
# GNOME's animateSwitch: the grid fades in over 400 ms after 100 ms.
log_wait "$grid_fade_mark" "grid-anim grid-fade-in settle" || fail G-GRID-FADE "the grid's fade-in never settled"
log_has "$grid_fade_mark" "grid-anim grid-fade-in start ms=500 motion=full" ||
    fail G-GRID-FADE "the grid did not fade in over 400 ms after 100 ms"
grid_fade_ms="$(settle_ms "$grid_fade_mark" grid-fade-in)"
[ "${grid_fade_ms:-0}" -ge 490 ] || fail G-GRID-FADE "the grid fade settled after ${grid_fade_ms:-?} ms, not 500"
pass G-GRID-FADE "Show Apps fades the grid in over GNOME's 400 ms after a 100 ms delay"
scrot "$ARTIFACTS/11-app-grid.png" >/dev/null
xdotool key Escape

# App folders, from GNOME's own keys.
xdotool key Escape
if ! cstate '.overview_open | not' "closed" 3; then
    xdotool key Super_L
    cstate '.overview_open | not' "closed" || fail G-APP-FOLDERS "overview would not close"
fi
FOLDER=org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/ProbeTools/
gsettings set org.gnome.desktop.app-folders folder-children "['ProbeTools']"
gsettings set "$FOLDER" name 'Probe Tools'
gsettings set "$FOLDER" apps "['tuna-probe.desktop']"
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-APP-FOLDERS "overview did not open"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folders.json" 20 --press "Show Apps" ||
    fail G-APP-FOLDERS "could not press Show Apps"
showing "$ARTIFACTS/a11y-folders.json" "Probe Tools" ||
    fail G-APP-FOLDERS "the grid has no Probe Tools folder"
if showing "$ARTIFACTS/a11y-folders.json" "Tuna Probe"; then
    fail G-APP-FOLDERS "a foldered app still shows loose in the grid"
fi
# Mutate root and child settings while the same app grid remains open.
folder_watch_pid="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk)"
case "$folder_watch_pid" in *[!0-9]*|'') fail G-APP-FOLDERS "GTK child PID is not unique" ;; esac
folder_watch_observe() {
    timeout --kill-after=2s 10s "$PY" "$ROOT/scripts/lib/gtk-folder-watch-proof.py" --pid "$folder_watch_pid" \
        --parent "$COMPOSITOR_PID" --binary "$privacy_expected_shell" \
        --output "$ARTIFACTS/folder-watch-$1.json" --present "$2" --absent "$3" || \
        fail G-APP-FOLDERS "live settings change did not update the owned grid: $1"
}
gsettings set "$FOLDER" name 'Probe Tools Live'
folder_watch_observe rename 'Probe Tools Live' 'Probe Tools'
gsettings set "$FOLDER" apps "[]"
folder_watch_observe child-remove 'Tuna Probe' 'Probe Tools Live'
gsettings set "$FOLDER" apps "['tuna-probe.desktop']"
folder_watch_observe child-readd 'Probe Tools Live' 'Tuna Probe'
gsettings set org.gnome.desktop.app-folders folder-children "[]"
folder_watch_observe remove 'Tuna Probe' 'Probe Tools Live'
gsettings set "$FOLDER" name 'Probe Tools'
gsettings set org.gnome.desktop.app-folders folder-children "['ProbeTools']"
folder_watch_observe readd 'Probe Tools' 'Tuna Probe'
folder_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-open.json" 20 --press "Probe Tools" ||
    fail G-APP-FOLDERS "could not open the folder"
# Screenshot the dialog once its zoom has settled.
log_wait "$folder_mark" "grid-anim folder-zoom-in settle" || fail G-FOLDER-ZOOM "the folder dialog's zoom never settled"
sleep 0.3
scrot "$ARTIFACTS/11b-app-folder.png" >/dev/null
showing "$ARTIFACTS/a11y-folder-open.json" "Tuna Probe" ||
    fail G-APP-FOLDERS "the open folder does not show its app"
pass G-APP-FOLDERS "GNOME's app folders group the grid and open to their apps"

# A click on the shade beside the dialog closes it (Escape may reach
# the overview first when the dialog has not taken keyboard focus yet).
folder_shade_click() {
    xdotool mousemove --window "$WID" 40 $((HEIGHT / 2)) click 1
}
# GNOME's _zoomAndFadeIn/_zoomAndFadeOut: 200 ms out of the folder's
# icon and back, the icon fading out over the first half and back over
# the last half of the closing.
log_has "$folder_mark" "grid-anim folder-zoom-in start ms=200 motion=full" ||
    fail G-FOLDER-ZOOM "opening did not zoom out of the folder icon over 200 ms"
log_has "$folder_mark" "grid-anim folder-icon start ms=100" ||
    fail G-FOLDER-ZOOM "the folder icon did not fade out over 100 ms"
folder_ms="$(settle_ms "$folder_mark" folder-zoom-in)"
[ "${folder_ms:-0}" -ge 190 ] || fail G-FOLDER-ZOOM "the zoom settled after ${folder_ms:-?} ms, not 200"
folder_mark="$(log_mark)"
folder_shade_click
log_wait "$folder_mark" "grid-anim folder-zoom-out settle" ||
    fail G-FOLDER-ZOOM "closing did not zoom back into the folder icon"
log_has "$folder_mark" "grid-anim folder-zoom-out start ms=200 motion=full" ||
    fail G-FOLDER-ZOOM "closing did not take 200 ms"
log_has "$folder_mark" "grid-anim folder-icon start ms=200" ||
    fail G-FOLDER-ZOOM "the folder icon did not fade back over the closing's last 100 ms"
sleep 0.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-closed.json" 20 ||
    fail G-FOLDER-ZOOM "accessibility dump failed"
showing "$ARTIFACTS/a11y-folder-closed.json" "Tuna Probe" &&
    fail G-FOLDER-ZOOM "the dialog still showed after its zoom settled"
showing "$ARTIFACTS/a11y-folder-closed.json" "Probe Tools" ||
    fail G-FOLDER-ZOOM "the grid did not stay open under the closed dialog"
# Animations off: the dialog jumps open and shut.
motion_policy Off
folder_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-open-off.json" 20 --press "Probe Tools" ||
    fail G-FOLDER-ZOOM "could not open the folder with animations off"
log_wait "$folder_mark" "grid-anim folder-zoom-in instant motion=off" ||
    fail G-FOLDER-ZOOM "with animations off the dialog still zoomed open"
showing "$ARTIFACTS/a11y-folder-open-off.json" "Tuna Probe" ||
    fail G-FOLDER-ZOOM "with animations off the dialog did not show its app"
folder_mark="$(log_mark)"
folder_shade_click
log_wait "$folder_mark" "grid-anim folder-zoom-out instant motion=off" ||
    fail G-FOLDER-ZOOM "with animations off the dialog still zoomed shut"
# Reduced Motion: the shade, dialog and icon still fade over 200 ms, but
# nothing zooms (the zoom part settles at once).
motion_policy FadesOnly
folder_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-open-reduced.json" 20 --press "Probe Tools" ||
    fail G-FOLDER-ZOOM "could not open the folder with Reduced Motion"
log_wait "$folder_mark" "grid-anim folder-zoom-in start ms=200 motion=fade-only" ||
    fail G-FOLDER-ZOOM "Reduced Motion dropped the dialog's fade"
log_wait "$folder_mark" "grid-anim folder-zoom-in settle" ||
    fail G-FOLDER-ZOOM "the Reduced Motion fade never settled"
pass G-FOLDER-ZOOM "the folder dialog zooms from and back to its icon over 200 ms; off it jumps, Reduced Motion only fades"

# GNOME's launch animation (zoomOutActor): the launched icon grows to
# three times its size and fades over 250 ms while the overview closes;
# the dialog closes at once rather than zooming back.
motion_policy Full
rm -f "$PROBE_MARKER"
launch_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-launch.json" 20 --press "Tuna Probe" ||
    fail G-LAUNCH-ZOOM "could not press the folder's app"
log_wait "$launch_mark" "grid-anim launch-zoom settle" ||
    fail G-LAUNCH-ZOOM "the launch zoom never settled"
log_has "$launch_mark" "grid-anim launch-zoom start ms=250 motion=full" ||
    fail G-LAUNCH-ZOOM "the launch zoom did not run 250 ms"
# zoomOutActor clones BaseIcon's child, the icon with its label: the
# clone is the tile's drawn icon-and-label box, not an empty frame.
log_has "$launch_mark" "grid-anim launch-zoom clone size=[0-9]*x[0-9]* drawn=[1-9][0-9]*x[1-9][0-9]* label=1" ||
    fail G-LAUNCH-ZOOM "the launch clone was not the tile's drawn icon and label"
launch_ms="$(settle_ms "$launch_mark" launch-zoom)"
[ "${launch_ms:-0}" -ge 240 ] || fail G-LAUNCH-ZOOM "the launch zoom settled after ${launch_ms:-?} ms, not 250"
log_has "$launch_mark" "grid-anim folder-zoom-out" &&
    fail G-LAUNCH-ZOOM "the dialog zoomed back into its icon behind a launch"
anim_end=$(($(date +%s) + 10))
until [ -f "$PROBE_MARKER" ] || [ "$(date +%s)" -gt "$anim_end" ]; do sleep 0.3; done
[ -f "$PROBE_MARKER" ] || fail G-LAUNCH-ZOOM "the folder's app did not launch"
cstate '.overview_open | not' "closed" || fail G-LAUNCH-ZOOM "the overview stayed open after the launch"
sleep 0.5
cstate '.layers | all(.namespace != "tuna-shell-launch-zoom")' "launch zoom gone" ||
    fail G-LAUNCH-ZOOM "the launch zoom's surface outlived its animation"
pass G-LAUNCH-ZOOM "a launch from the grid zooms its icon out over 250 ms and leaves nothing behind"

# Notifications (#56). Close whatever the grid left open first (#97).
xdotool key Escape
if ! cstate '.overview_open | not' "closed" 3; then
    xdotool key Super_L
    cstate '.overview_open | not' "closed" || fail G-NOTIFY-BANNER "overview would not close"
fi
sleep 1
notify() {
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        -- "Tuna Desktop Proof" 0 "" "$1" "$2" "[]" "{}" -1 >>"$ARTIFACTS/notify.log" 2>&1
}
notify_hinted() {
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        -- "Tuna Desktop Proof" 0 "" "$1" "$2" "[]" "{'desktop-entry': <'$POLICY_APP'>}" -1 >>"$ARTIFACTS/notify.log" 2>&1
}
open_calendar() {
    xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
    sleep 2
}
# Two quiet seconds first: the banner arrives while the user is away.
sleep 2
notify "Proof Banner" "Sent over D-Bus" || fail G-NOTIFY-BANNER "Notify call failed"
sleep 1
scrot "$ARTIFACTS/12-banner.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-banner.json" 20 ||
    fail G-NOTIFY-BANNER "accessibility dump failed"
showing "$ARTIFACTS/a11y-banner.json" "Proof Banner" ||
    fail G-NOTIFY-BANNER "no banner showing for the notification"
pass G-NOTIFY-BANNER "a D-Bus notification shows a banner"

# GNOME's message tray: a banner that arrives while the user is away
# waits for them (org.gnome.Mutter.IdleMonitor), then goes 2 s after
# their next input.
sleep 6
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-away.json" 20 ||
    fail G-NOTIFY-EXPIRE "accessibility dump failed"
showing "$ARTIFACTS/a11y-away.json" "Proof Banner" ||
    fail G-NOTIFY-EXPIRE "the banner left while the user was away"
xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2))
sleep 3.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-expired.json" 20 ||
    fail G-NOTIFY-EXPIRE "accessibility dump failed"
if showing "$ARTIFACTS/a11y-expired.json" "Proof Banner"; then
    fail G-NOTIFY-EXPIRE "banner still showing 2 s after the user came back"
fi
pass G-NOTIFY-EXPIRE "the banner waits for an away user and goes 2 s after their input"

open_calendar
scrot "$ARTIFACTS/13-notification-list.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-list.json" 20 ||
    fail G-NOTIFY-LIST "accessibility dump failed"
showing "$ARTIFACTS/a11y-list.json" "Proof Banner" ||
    fail G-NOTIFY-LIST "the calendar does not list the notification"
if showing "$ARTIFACTS/a11y-list.json" "No Notifications"; then
    fail G-NOTIFY-LIST "the empty state shows next to a notification"
fi
pass G-NOTIFY-LIST "the calendar lists the notification"

"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-cleared.json" 20 --press "Clear" ||
    fail G-NOTIFY-CLEAR "could not press Clear"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-cleared.json" 20 ||
    fail G-NOTIFY-CLEAR "accessibility dump failed"
showing "$ARTIFACTS/a11y-cleared.json" "No Notifications" ||
