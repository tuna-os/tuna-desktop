case "$layout" in
    *"'tuna-move-Two.desktop': <{'position': <0>}>"*) ;;
    *) fail G-GRID-REORDER "the moved app is not first in app-picker-layout: $(echo "$layout" | cut -c1-200)" ;;
esac
case "$layout" in
    *"'tuna-move-One.desktop': <{'position': <1>}>"*"'tuna-move-Three.desktop': <{'position': <2>}>"* | \
        *"'tuna-move-Three.desktop': <{'position': <2>}>"*"'tuna-move-One.desktop': <{'position': <1>}>"*) ;;
    *) fail G-GRID-REORDER "the apps it displaced did not each move one place on" ;;
