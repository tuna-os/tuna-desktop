# Tray (P-TR-01): an item registers, shows with its tooltip, its
# menu fires, and its row leaves the panel when it exits.
TRAY_MARKER="$ARTIFACTS/tray-marker"
rm -f "$TRAY_MARKER"
"$PY" "$ROOT/scripts/lib/tuna-tray-item-stub.py" "$TRAY_MARKER" >"$ARTIFACTS/tray.log" 2>&1 &
TRAY_PID=$!
for _ in $(seq 1 30); do grep -q registered "$ARTIFACTS/tray.log" 2>/dev/null && break; sleep 0.5; done
for _ in $(seq 1 20); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-tray.json" 20 >/dev/null 2>&1
    showing "$ARTIFACTS/a11y-tray.json" "Tuna Desktop Tray Probe" && break
    sleep 0.5
done
showing "$ARTIFACTS/a11y-tray.json" "Tuna Desktop Tray Probe" ||
    fail G-TRAY "the registered item never showed in the panel"
jq -e --arg n "Tuna Desktop Tray Probe" \
    'any(.[]; .name == $n and .showing and ((.description // "") | contains("Tray probe tip")))' \
    "$ARTIFACTS/a11y-tray.json" >/dev/null ||
    fail G-TRAY "the item showed without its tooltip"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-tray-menu.json" 20 \
    --press "Tuna Desktop Tray Probe" || fail G-TRAY "could not open the item"
scrot "$ARTIFACTS/03b-tray-menu.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-tray-fire.json" 20 \
    --press "Open Probe" || fail G-TRAY "the item's menu row never showed"
end=$(($(date +%s) + 10))
until [ -s "$TRAY_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "^clicked 1" "$TRAY_MARKER" 2>/dev/null || fail G-TRAY "the menu row never reached the item"
kill "$TRAY_PID" 2>/dev/null || true
tray_absent=0
for _ in $(seq 1 30); do
    if "$PY" "$ROOT/scripts/lib/tuna_tray_absence.py" "$ARTIFACTS/privacy-portal/receipt.json" \
        "$ARTIFACTS/a11y-tray-gone.json" "$ROOT/scripts/lib/tuna-a11y-dump.py"; then
        tray_absent=1
        break
    else
        tray_observation=$?
        [ "$tray_observation" = 2 ] || fail G-TRAY "fresh owner-bound tray absence observation failed"
    fi
    sleep 0.5
done
[ "$tray_absent" = 1 ] || fail G-TRAY "the item stayed in the panel after it exited"
pass G-TRAY "an AppIndicator item shows with its tooltip, fires its menu, and leaves on exit"
