    fail G-APP-GRID-PAGES "accessibility dump failed"
scrot "$ARTIFACTS/11c-app-grid-pages.png" >/dev/null
showing "$ARTIFACTS/a11y-grid-pages.json" "$grid_long_name" ||
    fail G-GRID-FOLDER-WIDTH "long folder fixture is missing"
cstate '.layers | any(.namespace == "tuna-shell-appgrid")' "app-grid viewport" ||
    fail G-GRID-FOLDER-WIDTH "app-grid layer missing"
grid_viewport="$(jq -c '.layers[] | select(.namespace == "tuna-shell-appgrid") | .rect' "$CSTATE")"
jq -e --argjson viewport "$grid_viewport" '
    any(.[]; .showing and .role == "frame" and .name == "App Grid"
        and .bounds[2] > 0 and .bounds[2] <= $viewport[2])
    and any(.[]; .showing and (.role == "push button" or .role == "button")
        and .name == "Next Page" and .bounds[2] > 0
        and .bounds[0] + .bounds[2] / 2 >= 0
        and .bounds[0] + .bounds[2] / 2 < $viewport[2])
' "$ARTIFACTS/a11y-grid-pages.json" >/dev/null ||
    fail G-GRID-FOLDER-WIDTH "long folder widened the frame or pushed the Next Page click center outside the viewport"
pass G-GRID-FOLDER-WIDTH "a long folder label preserves the grid viewport and visible Next Page button"
for name in "Next Page" "Page 1" "Page 2"; do
    showing "$ARTIFACTS/a11y-grid-pages.json" "$name" || fail G-APP-GRID-PAGES "no '$name' with two pages"
done
if showing "$ARTIFACTS/a11y-grid-pages.json" "Previous Page"; then
    fail G-APP-GRID-PAGES "Previous Page shows on the first page"
fi
page_mark="$(log_mark)"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-next.json" 20 \
    --press "Next Page" || fail G-APP-GRID-PAGES "could not press Next Page"
# The comparison slice also runs old binaries, which predate the grid's
# animations; the full gate checks them below.
if [ "$GRID_CANCEL_ONLY" = 1 ]; then
    sleep 1
else
    log_wait "$page_mark" "grid-anim page-switch settle" || fail G-GRID-PAGE-ANIM "the page switch never settled"
    sleep 0.5
fi
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-page2.json" 20 ||
    fail G-APP-GRID-PAGES "accessibility dump failed"
showing "$ARTIFACTS/a11y-grid-page2.json" "Previous Page" ||
    fail G-APP-GRID-PAGES "Next Page did not turn to the second page"
scrot "$ARTIFACTS/11d-app-grid-page2.png" >/dev/null
pass G-APP-GRID-PAGES "thirty more apps page the grid; indicators and arrows show and Next Page turns it"

# GNOME's page switch (iconGrid.js goToPage): 300 ms ease-out-cubic,
# instead of a spring; the Previous Page arrow fades in over 200 ms.
# Every animated frame (elapsed time on the GDK frame clock) must sit on
# GNOME's curve and the page dots must follow the drawn position
# (pageIndicators.js), checked by grid-anim-samples.py against GNOME's
# own constants.
grid_samples() {
    samples_mark="$1"
    samples_name="$2"
    shift 2
    "$PY" "$ROOT/scripts/lib/grid-anim-samples.py" --log "$LOG" --offset "$samples_mark" "$@" \
        >"$ARTIFACTS/grid-anim-samples-$samples_name.txt" 2>&1
}
if [ "$GRID_CANCEL_ONLY" != 1 ]; then
    log_has "$page_mark" "grid-anim page-switch start ms=300 motion=full" ||
        fail G-GRID-PAGE-ANIM "the page switch did not start a 300 ms eased slide"
    page_ms="$(settle_ms "$page_mark" page-switch)"
    [ "${page_ms:-0}" -ge 290 ] || fail G-GRID-PAGE-ANIM "the page switch settled after ${page_ms:-?} ms, not 300"
    log_has "$page_mark" "grid-anim page-arrow start ms=200" ||
        fail G-GRID-PAGE-ANIM "the page arrows did not fade over 200 ms"
    grid_samples "$page_mark" next --from 0 --to 1 ||
        fail G-GRID-PAGE-ANIM "page-switch frames or page dots strayed from GNOME's 300 ms out-cubic (grid-anim-samples-next.txt)"
    # With animations off the switch and the arrows jump.
    motion_policy Off
    page_mark="$(log_mark)"
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-prev-off.json" 20 \
        --press "Previous Page" || fail G-GRID-PAGE-ANIM "could not press Previous Page"
    log_wait "$page_mark" "grid-anim page-switch instant motion=off" ||
        fail G-GRID-PAGE-ANIM "with animations off the page switch still animated"
    log_has "$page_mark" "grid-anim page-switch start" &&
        fail G-GRID-PAGE-ANIM "with animations off a page slide started"
    grid_samples "$page_mark" off --instant --to 0 ||
        fail G-GRID-PAGE-ANIM "with animations off the pages or dots passed through between pages (grid-anim-samples-off.txt)"
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-page1-off.json" 20 ||
        fail G-GRID-PAGE-ANIM "accessibility dump failed"
    showing "$ARTIFACTS/a11y-grid-page1-off.json" "Previous Page" &&
        fail G-GRID-PAGE-ANIM "with animations off the Previous Page arrow lingered"
    motion_policy Full
    page_mark="$(log_mark)"
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-next-again.json" 20 \
        --press "Next Page" || fail G-GRID-PAGE-ANIM "could not return to page two"
    log_wait "$page_mark" "grid-anim page-switch settle" || fail G-GRID-PAGE-ANIM "the page switch back never settled"
    grid_samples "$page_mark" next-again --from 0 --to 1 ||
        fail G-GRID-PAGE-ANIM "the second switch's frames or dots strayed from GNOME's curve (grid-anim-samples-next-again.txt)"
    sleep 0.5
    pass G-GRID-PAGE-ANIM "page switches ease out-cubic over 300 ms (every frame-clock sample on GNOME's curve, page dots following the drawn position) and the arrows fade over 200 ms; with animations off both jump"
fi

# Select the rendered icon through actual accessibility bounds, including
# the descendant button; distribution app catalogs change grid allocation.
grid_origin() {
    grid_namespace="${1:-tuna-shell-appgrid}"
    cstate ".layers | any(.namespace == \"$grid_namespace\")" "grid layer" || fail G-GRID-DRAG-PAGE "grid layer missing"
    grid_origin_x="$(jq --arg namespace "$grid_namespace" '.layers[] | select(.namespace == $namespace) | .rect[0]' "$CSTATE")"
    grid_origin_y="$(jq --arg namespace "$grid_namespace" '.layers[] | select(.namespace == $namespace) | .rect[1]' "$CSTATE")"
}
grid_point() {
    jq -er --arg name "$2" --argjson ox "$grid_origin_x" --argjson oy "$grid_origin_y" --argjson edge "${3:--1}" '[.[] | select(.showing and (.role == "push button" or .role == "button") and .name == $name and (.bounds[2] > 0) and (.bounds[3] > 0))][0].bounds | select(length == 4) | "\((.[0] + $ox + (if $edge >= 0 then $edge else .[2] / 2 end)) | floor) \((.[1] + $oy + .[3] / 2) | floor)"' "$1"
}
grid_edge() { grid_point "$1" "$2" 4; }
# Carousel maps neighboring pages, so STATE_SHOWING alone includes tiles
# outside its clip. Compare their real window bounds with the viewport.
grid_shown() {
    jq -e --arg name "$2" --argjson ox "$grid_origin_x" --argjson oy "$grid_origin_y" --argjson width "$WIDTH" --argjson height "$HEIGHT" 'any(.[]; .showing and (.role == "push button" or .role == "button") and .name == $name and .bounds[2] > 0 and .bounds[3] > 0 and .bounds[0] + $ox < $width and .bounds[0] + $ox + .bounds[2] > 0 and .bounds[1] + $oy < $height and .bounds[1] + $oy + .bounds[3] > 0)' "$1" >/dev/null
}
# A grid drag starts once GTK sees the held pointer pass its threshold,
# and pages and hints slide on GTK's clock: poll the shell's tree for
# the state instead of sleeping. a11y_until dumps into $1 until the jq
# filter $2 holds; a11y_settled until the jq expression $2 is non-empty
# and unchanged across two dumps in a row. Both give up after ${3:-10} s.
a11y_until() {
    a11y_end=$(($(date +%s) + ${3:-10}))
    until "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$1" 20 >/dev/null &&
        jq -e "$2" "$1" >/dev/null 2>&1; do
        [ "$(date +%s)" -lt "$a11y_end" ] || return 1
        sleep 0.1
    done
}
a11y_settled() {
    a11y_end=$(($(date +%s) + ${3:-10}))
    a11y_last=""
    while :; do
        if "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$1" 20 >/dev/null; then
            a11y_now="$(jq -c "$2" "$1" 2>/dev/null)" || a11y_now=""
            [ -n "$a11y_now" ] && [ "$a11y_now" = "$a11y_last" ] && return 0
            a11y_last="$a11y_now"
        fi
        [ "$(date +%s)" -lt "$a11y_end" ] || return 1
        sleep 0.1
    done
}

# Bind this drag proof to the one supervised GTK child, never a same-name peer.
grid_cancel_pid="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk)" || fail G-GRID-DRAG-CANCEL "GTK child absent"
case "$grid_cancel_pid" in ''|*[!0-9]*) fail G-GRID-DRAG-CANCEL "ambiguous GTK child" ;; esac
grid_cancel_start="$("$PY" - "$grid_cancel_pid" <<'PY_GRID_OWNER'
import pathlib, sys
print(pathlib.Path(f"/proc/{int(sys.argv[1])}/stat").read_text().rsplit(")", 1)[1].split()[19])
PY_GRID_OWNER
)" || fail G-GRID-DRAG-CANCEL "GTK child identity unavailable"
grid_cancel_dump() {
    rm -f "$1"
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$1" 20 --strict --pid "$grid_cancel_pid" || return 1
    "$PY" "$ROOT/scripts/lib/tuna_grid_cancel_proof.py" tree "$grid_cancel_pid" "$grid_cancel_start" "$1"
}
if [ "$GRID_CANCEL_ONLY" = 1 ]; then
    "$PY" - "$ROOT" "$GRID_CANCEL_ADMISSION" "$COMPOSITOR_PID" "$grid_cancel_pid" "$GRID_CANCEL_OLD_NEGATIVE" <<'PY_GRID_ADMIT'
import importlib.util, json, pathlib, sys
root, admission, compositor, shell, old = sys.argv[1:]
spec = importlib.util.spec_from_file_location("comparison", pathlib.Path(root) / "scripts/lib/grid_cancel_comparison.py")
contract = importlib.util.module_from_spec(spec)
spec.loader.exec_module(contract)
contract.validate_live_admission(json.loads(pathlib.Path(admission).read_text()), pathlib.Path(root), int(compositor), int(shell), old == "1")
PY_GRID_ADMIT
fi
"$PY" - "$ROOT" "$grid_cancel_pid" "$grid_cancel_start" "$COMPOSITOR_PID" "$ARTIFACTS/grid-cancel-provenance.json" <<'PY_GRID_PROVENANCE'
import hashlib, json, os, pathlib, subprocess, sys
root, shell_pid, shell_start, compositor_pid, output = sys.argv[1:]
root = pathlib.Path(root)
def digest(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
def git(*args):
    return subprocess.check_output(["git", "-C", str(root), *args]).decode().strip()
receipt = {
    "scope": "harness-owned nested drag; not installed image or authenticated drag-source identity",
    "harness_source": git("rev-parse", "HEAD"),
    "harness_diff_sha256": hashlib.sha256(subprocess.check_output(["git", "-C", str(root), "diff", "HEAD", "--binary"])).hexdigest(),
    "harness_sha256": digest(root / "scripts/tuna-gtk-shell-proof"),
    "helper_sha256": digest(root / "scripts/lib/tuna_grid_cancel_proof.py"),
    "binary_source_external": os.environ.get("TUNA_PROOF_BINARY_SOURCE_COMMIT"),
    "run": os.environ.get("GITHUB_RUN_ID"), "attempt": os.environ.get("GITHUB_RUN_ATTEMPT"),
    "runtime": os.environ["XDG_RUNTIME_DIR"],
    "shell": {"pid": int(shell_pid), "start": shell_start, "binary_sha256": digest(f"/proc/{shell_pid}/exe")},
    "compositor": {"pid": int(compositor_pid), "binary_sha256": digest(f"/proc/{compositor_pid}/exe")},
}
pathlib.Path(output).write_text(json.dumps(receipt, sort_keys=True, indent=2) + "\n")
PY_GRID_PROVENANCE
# A local folder source must initialize hints too. Cancel the real drag
# before dropping and require normal arrows with no preview or stale timer.
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-page-back.json" 20 \
    --press "Previous Page" || fail G-GRID-DRAG-CANCEL "could not return to page one"
sleep 1
grid_cancel_dump "$ARTIFACTS/a11y-folder-page-source.json" || fail G-GRID-DRAG-CANCEL "folder source dump failed"
grid_origin tuna-shell-appgrid
folder_coordinates="$(grid_point "$ARTIFACTS/a11y-folder-page-source.json" "$grid_long_name")" || fail G-GRID-DRAG-CANCEL "real folder source has no bounds"
read -r folder_source_x folder_source_y <<EOF
$folder_coordinates
EOF
# Select an empty interior gap from the real owned tree, not a nominal hint
# width. The later live preview tree must confirm it against actual hints.
neutral_coordinates="$("$PY" "$ROOT/scripts/lib/tuna_grid_cancel_proof.py" neutral \
    "$grid_cancel_pid" "$grid_cancel_start" "$ARTIFACTS/a11y-folder-page-source.json" \
    "$CSTATE" "$ARTIFACTS/grid-cancel-neutral-point.json")" || fail G-GRID-DRAG-CANCEL "no actual neutral grid region"
read -r grid_neutral_x grid_neutral_y <<EOF
$neutral_coordinates
EOF
folder_layout_before="$(gsettings get org.gnome.shell app-picker-layout)"
printf '%s\n' "$folder_layout_before" > "$ARTIFACTS/grid-cancel-layout-before.txt"
xdotool mousemove --window "$WID" "$folder_source_x" "$folder_source_y"
sleep 0.3
xdotool mousedown 1
sleep 0.1
for step in $(seq 1 6); do
    xdotool mousemove --window "$WID" $((folder_source_x + step * 10)) "$folder_source_y"
    sleep 0.05
done
# Keep the actual button held, but leave timed page hints and tile hover
# targets before slow AT-SPI/screenshot/state acquisition. Wait for the
# normal arrows' fade to finish as well as the neighboring hint to appear.
xdotool mousemove --window "$WID" "$grid_neutral_x" "$grid_neutral_y"
grid_peek_end=$(($(date +%s) + 10))
until grid_cancel_dump "$ARTIFACTS/a11y-folder-page-peek.json" &&
    jq -e '[.[] | select(.showing) | .name] |
        (index("Next page preview") != null and
         index("Previous page preview") == null and
         index("Next Page") == null and index("Previous Page") == null)' \
        "$ARTIFACTS/a11y-folder-page-peek.json" >/dev/null; do
    [ "$(date +%s)" -lt "$grid_peek_end" ] ||
        fail G-GRID-DRAG-CANCEL "real local folder drag has no neighboring-page hint"
    sleep 0.1
done
scrot "$ARTIFACTS/11h-folder-page-peek.png" >/dev/null
cstate ".client_dnd_active == true and .overview_open and .overview_app_grid and (.locked == false) and (.pointer_position == [$grid_neutral_x, $grid_neutral_y])" "real folder drag active at observed neutral point" || fail G-GRID-DRAG-CANCEL "native client drag never acquired grab"
cp "$CSTATE" "$ARTIFACTS/grid-cancel-before-escape.json"
"$PY" "$ROOT/scripts/lib/tuna_grid_cancel_proof.py" neutral-check \
    "$grid_cancel_pid" "$grid_cancel_start" "$ARTIFACTS/a11y-folder-page-peek.json" \
    "$ARTIFACTS/grid-cancel-before-escape.json" "$grid_neutral_x" "$grid_neutral_y" \
    "$ARTIFACTS/a11y-folder-page-source.json" "$ARTIFACTS/grid-cancel-neutral-admission.json" || fail G-GRID-DRAG-CANCEL "active neutral pointer or first page not observed"
[ "$(gsettings get org.gnome.shell app-picker-layout)" = "$folder_layout_before" ] || fail G-GRID-DRAG-CANCEL "preview already committed layout"
grid_cancel_before_frame="$(jq -er .rendered_frames "$ARTIFACTS/grid-cancel-before-escape.json")" || fail G-GRID-DRAG-CANCEL "drag frame missing"
grid_cancel_before_keys="$(jq -er .seat_pressed_key_count "$ARTIFACTS/grid-cancel-before-escape.json")" || fail G-GRID-DRAG-CANCEL "held-key baseline missing"
xdotool key Escape
if [ "$GRID_CANCEL_OLD_NEGATIVE" = 1 ]; then
    # Test-only old-source discriminator. The default/full gate NEVER accepts
    # overview close, and this branch requires the exact live old tuple above.
    cstate ".client_dnd_active == true and .overview_open == false and (.locked == false) and (.rendered_frames > $grid_cancel_before_frame)" "old drag retained before release" || fail G-GRID-DRAG-OLD-NEG "reviewed old source did not reproduce Escape routing failure"
    cp "$CSTATE" "$ARTIFACTS/grid-cancel-old-before-release.json"
    scrot "$ARTIFACTS/grid-cancel-old-before-release.png" >/dev/null
    gsettings get org.gnome.shell app-picker-layout > "$ARTIFACTS/grid-cancel-old-layout-before-release.txt"
    "$PY" - "$ROOT" "$ARTIFACTS/grid-cancel-before-escape.json" "$ARTIFACTS/grid-cancel-old-before-release.json" <<'PY_GRID_OLD'
import importlib.util, json, pathlib, sys
root, before, after = map(pathlib.Path, sys.argv[1:])
spec = importlib.util.spec_from_file_location("comparison", root / "scripts/lib/grid_cancel_comparison.py")
contract = importlib.util.module_from_spec(spec)
spec.loader.exec_module(contract)
contract.old_negative(json.loads(before.read_text()), json.loads(after.read_text()))
PY_GRID_OLD
    pass G-GRID-DRAG-OLD-NEG "exact observation-only old source retained native drag while closing grid; button still held"
    # Exit/cleanup without releasing the button; preserve pre-release evidence.
    exit 0
fi
# The source must retire while the button is STILL held. Overview close/reopen
# cannot stand in for cancellation, and mouseup must not complete an old offer.
# xdotool's Escape release reaches the seat after its press cancels the drag,
# so wait for the held-key count to return to its baseline too.
cstate ".client_dnd_active == false and .overview_open and .overview_app_grid and (.locked == false) and (.rendered_frames > $grid_cancel_before_frame) and (.seat_pressed_key_count == $grid_cancel_before_keys)" "folder cancellation before release" || fail G-GRID-DRAG-CANCEL "Escape failed to cancel native drag while keeping grid open"
cp "$CSTATE" "$ARTIFACTS/grid-cancel-before-release.json"
scrot "$ARTIFACTS/grid-cancel-before-release.png" >/dev/null
# GTK hears cancel asynchronously and removes preview widgets during traversal.
# Reject an inconsistent tree, then wait for a fresh complete owner-bound tree
# within the existing budget, with the pointer button still held.
end=$(($(date +%s) + 5))
until grid_cancel_dump "$ARTIFACTS/a11y-folder-before-release.json" &&
    showing "$ARTIFACTS/a11y-folder-before-release.json" "Next Page" &&
    ! showing "$ARTIFACTS/a11y-folder-before-release.json" "Next page preview"; do
    [ "$(date +%s)" -le "$end" ] ||
        fail G-GRID-DRAG-CANCEL "complete cancellation tree did not restore arrow before release"
    sleep 0.3
done
showing "$ARTIFACTS/a11y-folder-before-release.json" "Next Page" || fail G-GRID-DRAG-CANCEL "GTK drag cleanup did not restore arrow before release"
if showing "$ARTIFACTS/a11y-folder-before-release.json" "Next page preview"; then fail G-GRID-DRAG-CANCEL "GTK drag preview remains before release"; fi
xdotool mouseup 1
sleep 1
xdotool mousemove --window "$WID" $((WIDTH - 6)) "$folder_source_y"
sleep 1.5
grid_cancel_dump "$ARTIFACTS/a11y-folder-page-cancelled.json" || fail G-GRID-DRAG-CANCEL "cancelled dump failed"
showing "$ARTIFACTS/a11y-folder-page-cancelled.json" "Next Page" || fail G-GRID-DRAG-CANCEL "normal Next Page arrow did not return"
for name in "Previous Page" "Next page preview" "Previous page preview"; do
    if showing "$ARTIFACTS/a11y-folder-page-cancelled.json" "$name"; then
        fail G-GRID-DRAG-CANCEL "cancelled drag left '$name' visible or a timer turned the page"
    fi
done
gsettings get org.gnome.shell app-picker-layout > "$ARTIFACTS/grid-cancel-layout-after.txt"
"$PY" "$ROOT/scripts/lib/tuna_grid_cancel_proof.py" \
    "$ARTIFACTS/grid-cancel-before-escape.json" "$ARTIFACTS/grid-cancel-before-release.json" \
    "$ARTIFACTS/grid-cancel-layout-before.txt" "$ARTIFACTS/grid-cancel-layout-after.txt" || \
    fail G-GRID-DRAG-CANCEL "native cancellation evidence or saved layout invalid"
xdotool key Escape
cstate '.overview_open == false and .client_dnd_active == false' "ordinary Escape closes overview" || fail G-GRID-DRAG-CANCEL "ordinary Escape no longer closes overview"
xdotool key super+a
cstate '.overview_open and .overview_app_grid' "grid reopened after ordinary Escape" || fail G-GRID-DRAG-CANCEL "grid did not reopen"
pass G-GRID-DRAG-CANCEL "native cancel before release preserves layout; subsequent ordinary Escape closes overview"
if [ "$GRID_CANCEL_ONLY" = 1 ]; then exit 0; fi
# Restore page two for the existing app-drag proof's Previous Page action.
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-page-next.json" 20 \
    --press "Next Page" || fail G-GRID-DRAG-CANCEL "could not return to page two"
sleep 1

# GNOME's page switching while dragging: an app held against the grid's
# edge turns the page (no arrow to press mid-drag).
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-back.json" 20 \
    --press "Previous Page" || fail G-GRID-DRAG-PAGE "could not press Previous Page"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-page-source.json" 20 || fail G-GRID-DRAG-PAGE "source dump failed"
grid_origin tuna-shell-appgrid
page_source="$(jq -r '[.[] | select(.showing and .role == "table cell")][0].name' "$ARTIFACTS/a11y-grid-page-source.json")"
grid_coordinates="$(grid_point "$ARTIFACTS/a11y-grid-page-source.json" "$page_source")" || fail G-GRID-DRAG-PAGE "source tile has no actual bounds"
read -r page_source_x page_source_y <<EOF
$grid_coordinates
EOF
xdotool mousemove --window "$WID" "$page_source_x" "$page_source_y"
sleep 0.3
xdotool mousedown 1
sleep 0.1
# Deliver distinct held-pointer samples so GTK recognizes the drag before
# we inspect its preview; an immediate press/jump can remain a button press.
for step in $(seq 1 6); do
    xdotool mousemove --window "$WID" $((page_source_x + step * 10)) "$page_source_y"
    sleep 0.05
done
# Wait for the drag's hint, then for its icons to finish sliding in.
a11y_settled "$ARTIFACTS/a11y-grid-page-peek.json" 'select(any(.[]; .showing and .name == "Next page preview")) | [.[] | select(.showing and .role == "image" and (.name | startswith("Tuna Page App"))) | .bounds] | select(length > 0)' ||
    fail G-GRID-PAGE-PEEK "next page hint missing or never settled during drag"
scrot "$ARTIFACTS/11h-grid-page-peek.png" >/dev/null
showing "$ARTIFACTS/a11y-grid-page-peek.json" "Next page preview" || fail G-GRID-PAGE-PEEK "next page hint missing during drag"
jq -e 'any(.[]; .showing and .role == "image" and (.name | startswith("Tuna Page App")))' "$ARTIFACTS/a11y-grid-page-peek.json" >/dev/null || fail G-GRID-PAGE-PEEK "neighboring page icons did not enter the hint"
# GNOME's hint is a tenth of the grid; wider, it covers tiles and turns
# the page under a pointer that is only crossing them.
grid_layer_width="$(jq '.layers[] | select(.namespace == "tuna-shell-appgrid") | .rect[2]' "$CSTATE")"
jq -e --argjson grid "$grid_layer_width" 'all(.[] | select(.showing and (.name | endswith("page preview"))); .bounds[2] > 0 and .bounds[2] <= ($grid / 10 | floor))' "$ARTIFACTS/a11y-grid-page-peek.json" >/dev/null ||
    fail G-GRID-PAGE-PEEK "the page hint is wider than a tenth of the grid"
peek_rect="$(jq -r --argjson ox "$grid_origin_x" --argjson oy "$grid_origin_y" '.[] | select(.showing and .name == "Next page preview") | .bounds | "\(.[0] + $ox) \(.[1] + $oy) \(.[2]) \(.[3])"' "$ARTIFACTS/a11y-grid-page-peek.json" | head -1)"
# shellcheck disable=SC2086
set -- $peek_rect
ffmpeg -nostdin -loglevel error -y -i "$ARTIFACTS/11h-grid-page-peek.png" -vf "crop=$3:$4:$1:$2,format=gray" -f rawvideo "$ARTIFACTS/grid-page-peek.gray" || fail G-GRID-PAGE-PEEK "could not inspect hint pixels"
"$PY" -c 'import sys; data=open(sys.argv[1], "rb").read(); sys.exit(0 if sum(pixel > 150 for pixel in data) > 20 else 1)' "$ARTIFACTS/grid-page-peek.gray" || fail G-GRID-PAGE-PEEK "hint contains no visible icon or label pixels"
pass G-GRID-PAGE-PEEK "neighboring page icons slide into the 10% hint over 150ms and paint real pixels"
for i in $(seq 1 20); do
    xdotool mousemove --window "$WID" $((page_source_x + 60 + (WIDTH - 6 - page_source_x - 60) * i / 20)) "$page_source_y"
    sleep 0.03
done
sleep 0.8
scrot "$ARTIFACTS/11h-grid-drag-edge.png" >/dev/null
xdotool mouseup 1
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-drag-page.json" 20 ||
    fail G-GRID-DRAG-PAGE "accessibility dump failed"
showing "$ARTIFACTS/a11y-grid-drag-page.json" "Previous Page" ||
    fail G-GRID-DRAG-PAGE "holding a dragged app at the edge did not turn the page"
pass G-GRID-DRAG-PAGE "an app dragged against the grid's edge turns the page, as GNOME's grid does"
for name in "Next page preview" "Previous page preview"; do
    if showing "$ARTIFACTS/a11y-grid-drag-page.json" "$name"; then
        fail G-GRID-DRAG-END "completed app drag left '$name' visible"
    fi
done
# Keep the pointer at the edge beyond the dwell period after releasing it.
# A stale timer must not take us back to page one or resume preview mode.
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-drag-ended.json" 20 || fail G-GRID-DRAG-END "ended dump failed"
showing "$ARTIFACTS/a11y-grid-drag-ended.json" "Previous Page" || fail G-GRID-DRAG-END "completed drag kept paging after release"
for name in "Next page preview" "Previous page preview"; do
    if showing "$ARTIFACTS/a11y-grid-drag-ended.json" "$name"; then
        fail G-GRID-DRAG-END "completed drag restored '$name' after release"
    fi
done
pass G-GRID-DRAG-END "real app drag completion restores arrows and leaves no delayed preview or edge timer"
gsettings set org.gnome.desktop.app-folders folder-children "$grid_original_folders"
sleep 1
xdotool key Escape
cstate '.overview_open | not' "closed" || { xdotool key Escape; cstate '.overview_open | not' "closed" || fail G-APP-GRID-PAGES "overview stayed open"; }
rm -f "$XDG_DATA_HOME"/applications/tuna-page-*.desktop
sleep 1.5

# GNOME's folder edits by drag: one app onto another makes a folder of
# the two (org.gnome.desktop.app-folders); one dragged out of the
# folder's dialog onto the shade leaves it. Two apps named to sort first
# sit in the first two cells (113px tiles 12px apart, centred).
for n in One Two; do
    printf '[Desktop Entry]\nName=AAA Drag %s\nExec=true\nType=Application\n' "$n" \
        >"$XDG_DATA_HOME/applications/tuna-drag-$n.desktop"
done
sleep 1.5
before="$(gsettings get org.gnome.desktop.app-folders folder-children)"
drag() {
    xdotool mousemove --window "$WID" "$1" "$2"
    sleep 0.3
    xdotool mousedown 1
    sleep 0.2
    for i in $(seq 1 20); do
        xdotool mousemove --window "$WID" $(($1 + ($3 - $1) * i / 20)) $(($2 + ($4 - $2) * i / 20))
        sleep 0.03
    done
    sleep 0.4
    xdotool mouseup 1
    sleep 1.5
}
xdotool key super+a
cstate '.overview_open and .overview_app_grid' "app grid" || fail G-FOLDER-DND "Super+A did not show the app grid"
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-drag-source.json" 20 || fail G-FOLDER-DND "source dump failed"
grid_origin
source_point="$(grid_point "$ARTIFACTS/a11y-folder-drag-source.json" "AAA Drag Two")" || fail G-FOLDER-DND "source bounds missing"
target_point="$(grid_point "$ARTIFACTS/a11y-folder-drag-source.json" "AAA Drag One")" || fail G-FOLDER-DND "target bounds missing"
# shellcheck disable=SC2086
drag $source_point $target_point
scrot "$ARTIFACTS/11e-folder-made.png" >/dev/null
after="$(gsettings get org.gnome.desktop.app-folders folder-children)"
folder=""
for f in $(echo "$after" | tr -d "[]',"); do
    case " $(echo "$before" | tr -d "[]',") " in *" $f "*) ;; *) folder="$f" ;; esac
done
[ -n "$folder" ] || fail G-FOLDER-DND "dropping an app on another made no folder ($after)"
fpath="org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/$folder/"
apps="$(gsettings get "$fpath" apps)"
case "$apps" in
    *tuna-drag-One.desktop*tuna-drag-Two.desktop*|*tuna-drag-Two.desktop*tuna-drag-One.desktop*) ;;
    *) fail G-FOLDER-DND "the new folder holds $apps" ;;
esac
name="$(gsettings get "$fpath" name | tr -d "'")"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-new.json" 20 \
    --press "$name" || fail G-FOLDER-DND "could not open the new folder '$name'"
sleep 1.5
scrot "$ARTIFACTS/11f-folder-dialog.png" >/dev/null
# The dialog's second tile (AAA Drag Two) out onto the shade.
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-dialog-source.json" 20 || fail G-FOLDER-DND "dialog dump failed"
grid_origin tuna-folder-dialog
source_point="$(grid_point "$ARTIFACTS/a11y-folder-dialog-source.json" "AAA Drag Two")" || fail G-FOLDER-DND "dialog source bounds missing"
# shellcheck disable=SC2086
drag $source_point 140 560
apps="$(gsettings get "$fpath" apps)"
[ "$apps" = "['tuna-drag-One.desktop']" ] ||
    fail G-FOLDER-DND "dragging an app out left the folder with $apps"
pass G-FOLDER-DND "an app dropped on another makes a GNOME folder; one dragged out of its dialog leaves it"
xdotool key Escape
cstate '.overview_open | not' "closed" || { xdotool key Escape; cstate '.overview_open | not' "closed" || fail G-FOLDER-DND "overview stayed open"; }
rm -f "$XDG_DATA_HOME"/applications/tuna-drag-*.desktop
sleep 1.5

# GNOME's grid reorder: an app dropped on another tile's edge takes its
# place, and the grid is saved to org.gnome.shell app-picker-layout.
# The earlier folder drop persisted its catalog. Give this reorder proof
# an explicit starting order before asserting exact positions 0, 1 and 2.
gsettings set org.gnome.shell app-picker-layout "[{'tuna-move-One.desktop': <{'position': <0>}>, 'tuna-move-Three.desktop': <{'position': <1>}>, 'tuna-move-Two.desktop': <{'position': <2>}>}]"
