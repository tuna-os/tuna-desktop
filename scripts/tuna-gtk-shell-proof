sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-panel-open.json" 20 ||
    fail G-PANEL-FOCUS "accessibility dump failed"
showing "$ARTIFACTS/a11y-panel-open.json" "Dark Style" ||
