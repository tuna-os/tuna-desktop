    fail G-PANEL-FOCUS "accessibility dump failed"
hidden "$ARTIFACTS/a11y-panel-unwind.json" "Dark Style" ||
    fail G-PANEL-FOCUS "Escape did not close the keyboard-opened menu"
focused "$ARTIFACTS/a11y-panel-unwind.json" "System" ||
