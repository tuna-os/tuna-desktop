# Location (#362): the shell's agent registers with GeoClue, InUse
# lights the panel, and AuthorizeApp answers from the permission store
# under the Settings-owned master switch and ceiling (GNOME keeps the
# switch in Settings, so the proof writes it like Settings does, as
# the DND gate writes show-banners).
gsettings set org.gnome.system.location enabled true ||
    fail G-QS-LOCATION "could not switch location on"
gsettings set org.gnome.system.location max-accuracy-level 'exact' ||
    fail G-QS-LOCATION "could not set the accuracy ceiling"
# Re-appearing GeoClue gets a fresh registration: only post-mark
# AddAgent lines prove the agent registers live.
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.tuna.Proof.WwanLocation \
    --object-path /org/tuna/Proof/WwanLocation --method org.tuna.Proof.WwanLocation.GeoCluePresent false >/dev/null ||
    fail G-QS-LOCATION "could not release the stub GeoClue name"
sleep 1
geo_mark=$(wc -l < "$TUNA_STUB_WWANLOC_LOG")
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.tuna.Proof.WwanLocation \
    --object-path /org/tuna/Proof/WwanLocation --method org.tuna.Proof.WwanLocation.GeoCluePresent true >/dev/null ||
    fail G-QS-LOCATION "could not restore the stub GeoClue name"
for _ in $(seq 1 20); do
    tail -n +"$((geo_mark + 1))" "$TUNA_STUB_WWANLOC_LOG" 2>/dev/null | grep -qE "^[0-9.]+ AddAgent tuna-shell from " && break
    sleep 0.5
done
tail -n +"$((geo_mark + 1))" "$TUNA_STUB_WWANLOC_LOG" | grep -qE "^[0-9.]+ AddAgent tuna-shell from " ||
    fail G-QS-LOCATION "the shell did not register its GeoClue agent on appearance"
shell_bus=$(tail -n +"$((geo_mark + 1))" "$TUNA_STUB_WWANLOC_LOG" | grep -oE "AddAgent tuna-shell from [^ ]+" | tail -1 | awk '{print $4}')
[ -n "$shell_bus" ] || fail G-QS-LOCATION "no agent bus name in the GeoClue log"
# dconf delivers the write to the shell asynchronously: wait until the
# agent's own MaxAccuracyLevel reports the new ceiling before asking it
# to authorize, so the answer reflects the setting rather than the race.
agent_ceiling() {
    ceiling_got=""
    for _ in $(seq 1 20); do
        ceiling_got=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
            --object-path /org/freedesktop/GeoClue2/Agent \
            --method org.freedesktop.DBus.Properties.Get org.freedesktop.GeoClue2.Agent MaxAccuracyLevel 2>&1)
        echo "$ceiling_got" | grep -qE "^\(<(uint32 )?$1>,\)$" && return 0
        sleep 0.25
    done
    echo "$ceiling_got"
    return 1
}
ceiling=$(agent_ceiling 8) ||
    fail G-QS-LOCATION "the agent never reported the exact ceiling: $ceiling"
# InUse lights the panel indicator; clearing it darkens it again.
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.GeoClue2 \
    --object-path /org/freedesktop/GeoClue2/Manager --method org.freedesktop.DBus.Properties.Set \
    org.freedesktop.GeoClue2.Manager InUse "<true>" >/dev/null ||
    fail G-QS-LOCATION "could not set GeoClue InUse"
in_use=""
for _ in $(seq 1 15); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-location-inuse.json" 20 ||
        fail G-QS-LOCATION "accessibility dump failed"
    if showing "$ARTIFACTS/a11y-qs-location-inuse.json" "Location in use"; then in_use=1; break; fi
    sleep 1
done
[ -n "$in_use" ] || fail G-QS-LOCATION "no Location in use indicator while GeoClue is in use"
scrot "$ARTIFACTS/16e-location.png" >/dev/null
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.GeoClue2 \
    --object-path /org/freedesktop/GeoClue2/Manager --method org.freedesktop.DBus.Properties.Set \
    org.freedesktop.GeoClue2.Manager InUse "<false>" >/dev/null ||
    fail G-QS-LOCATION "could not clear GeoClue InUse"
in_use_dark=""
for _ in $(seq 1 15); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-location-idle.json" 20 ||
        fail G-QS-LOCATION "accessibility dump failed"
    if ! showing "$ARTIFACTS/a11y-qs-location-idle.json" "Location in use"; then in_use_dark=1; break; fi
    sleep 1
done
[ -n "$in_use_dark" ] || fail G-QS-LOCATION "the Location indicator stayed after GeoClue went idle"
# Authorization end to end: a stored EXACT grant for an installed app
# authorizes at the request; the ceiling clamps it; first-use known
# apps prompt (deny/allow flows through); unknown apps are denied.
# Proof apps live in $XDG_DATA_HOME (the shell's user data dir), like
# every other tuna-probe desktop file above.
printf '[Desktop Entry]\nName=Proof Location App\nType=Application\nExec=/bin/true\n' \
    >"$XDG_DATA_HOME/applications/proof-location-app.desktop"
printf '[Desktop Entry]\nName=Proof Location Stranger\nType=Application\nExec=/bin/true\n' \
    >"$XDG_DATA_HOME/applications/proof-location-stranger.desktop"
printf '[Desktop Entry]\nName=Proof Location Newcomer\nType=Application\nExec=/bin/true\n' \
    >"$XDG_DATA_HOME/applications/proof-location-newcomer.desktop"
gdbus call --session --dest org.freedesktop.impl.portal.PermissionStore \
    --object-path /org/freedesktop/impl/portal/PermissionStore \
    --method org.freedesktop.impl.portal.PermissionStore.SetPermission \
    location true location proof-location-app '["EXACT", "1700000000"]' >/dev/null ||
    fail G-QS-LOCATION "could not seed the location permission store"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-app 8 2>&1) ||
    fail G-QS-LOCATION "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(true, (uint32 )?8\)" ||
    fail G-QS-LOCATION "stored EXACT grant answered $auth, not (true, 8)"
gsettings set org.gnome.system.location max-accuracy-level 'city' ||
    fail G-QS-LOCATION "could not lower the accuracy ceiling"
ceiling=$(agent_ceiling 4) ||
    fail G-QS-LOCATION "the agent never reported the city ceiling: $ceiling"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-app 8 2>&1) ||
    fail G-QS-LOCATION "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(true, (uint32 )?4\)" ||
    fail G-QS-LOCATION "city ceiling answered $auth, not (true, 4)"
gsettings set org.gnome.system.location max-accuracy-level 'exact' ||
    fail G-QS-LOCATION "could not restore the accuracy ceiling"
ceiling=$(agent_ceiling 8) ||
    fail G-QS-LOCATION "the agent never reported the exact ceiling: $ceiling"
# First use prompts: the stranger's request surfaces the consent
# dialog; denying answers denied and saves the denial.
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-stranger 8 \
    --timeout 30 >"$ARTIFACTS/location-stranger-auth.txt" 2>&1 &
stranger_pid=$!
prompt_shown=""
for _ in $(seq 1 15); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-location-prompt.json" 20 ||
        fail G-QS-LOCATION "accessibility dump failed"
    if jq -e 'any(.[]; .showing and (.name | contains("to access your location?")))' \
        "$ARTIFACTS/a11y-location-prompt.json" >/dev/null; then prompt_shown=1; break; fi
    sleep 1
done
[ -n "$prompt_shown" ] || { kill "$stranger_pid" 2>/dev/null; fail G-QS-LOCATION "first-use request did not surface a consent prompt"; }
scrot "$ARTIFACTS/16g-location-prompt.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-location-deny.json" 20 \
    --press "Deny" >/dev/null ||
    { kill "$stranger_pid" 2>/dev/null; fail G-QS-LOCATION "could not press Deny on the consent prompt"; }
wait "$stranger_pid"
auth=$(cat "$ARTIFACTS/location-stranger-auth.txt")
echo "$auth" | grep -qE "\(false, (uint32 )?0\)" ||
    fail G-QS-LOCATION "denied first-use answered $auth, not (false, 0)"
# Allowing a different newcomer grants at the request (and saves it:
# asking again answers from the store without a prompt).
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-newcomer 8 \
