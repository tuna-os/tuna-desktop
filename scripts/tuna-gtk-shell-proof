# GNOME 51 darkMode.js / nightLight.js: the tiles follow their keys when
# something else (Settings, gsettings) writes them (#844).
qs_tile_checked() {
    jq -e --arg n "$2" --arg want "$3" 'any(.[]; .name == $n and .role == "toggle button"
        and .showing and (.checked | tostring) == $want)' "$1" >/dev/null
}
