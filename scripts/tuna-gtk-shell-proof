cursor_probe shape wait G-CURSOR-SHAPE
cstate '.cursor.image_theme == "TunaProofBase" and .cursor.animation_frames == 2 and .cursor.image == [24,24]' "animated legacy cursor" ||
    fail G-CURSOR-SHAPE "the legacy wait cursor did not retain both frames"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-legacy-frame-0.png" 24 1 1 181,29,91 ||
    fail G-CURSOR-SHAPE "the first legacy animation frame never painted"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-legacy-frame-1.png" 24 1 1 25,173,125 ||
    fail G-CURSOR-SHAPE "the second legacy animation frame never painted without new input"
gsettings set org.gnome.desktop.interface cursor-theme TunaProofSvg
cstate '.cursor.image_theme == "TunaProofSvg" and .cursor.animation_frames == 2 and .cursor.image == [24,24]' "animated scalable cursor" ||
    fail G-CURSOR-SHAPE "the SVG wait cursor did not replace both legacy frames"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-svg-frame-0.png" 24 4 6 49,95,199 ||
    fail G-CURSOR-SHAPE "the first SVG animation frame never painted"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-svg-frame-1.png" 24 4 6 213,161,33 ||
    fail G-CURSOR-SHAPE "the second SVG animation frame never painted without new input"
cursor_probe surface 32 G-CURSOR-SHAPE
cstate '.cursor.kind == "surface" and .cursor.image == [32, 32] and .cursor.logical == [32, 32]' "client cursor surface" ||
    fail G-CURSOR-SHAPE "a client's 32px cursor surface was not drawn at its size"
cp "$CSTATE" "$ARTIFACTS/cursor-surface.json"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-surface.png" 32 0 0 224,27,36 ||
    fail G-CURSOR-SHAPE "the client surface has incorrect actual pixels"
kill "$CURSOR_PID" 2>/dev/null || true
