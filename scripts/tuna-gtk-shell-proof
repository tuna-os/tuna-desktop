for t in alpha beta gamma delta; do
    printf '[Desktop Entry]\nName=Tuna Desktop Test %s\nExec=true\nType=Application\nNoDisplay=true\n' "$t" \
        >"$XDG_DATA_HOME/applications/tuna-test-$t.desktop"
done
cat >"$XDG_DATA_HOME/applications/tuna-probe.desktop" <<EOF
