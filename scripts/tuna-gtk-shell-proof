#!/bin/sh
# tuna-gtk-shell-proof — GTK shell (ADR 0006) inside the nested session.
#
# Usage:
#   scripts/tuna-gtk-shell-proof [--display :N] [--artifacts DIR]
#   --screenshot-keys-only runs panel readiness and actual keyboard captures only.
#   --a11y-focus-only runs panel readiness, G-FOCUS-RING, G-FOCUS-RING-TIMEOUT,
#   G-A11Y-MENU-RESTART and G-SHELL-STABLE only.
#   --notify-lock-only runs panel readiness and the lock-screen notification
#   and notification sound gates only (needs pam_wrapper).
#   --grid-cancel-only --grid-cancel-admission FILE is an exact CI comparison slice.
#   --expect-grid-cancel-old-negative is permitted only in that admitted slice.
#
# Runs the nested compositor with tuna-shell-gtk as its supervised shell
# on a private session bus with the AT-SPI accessibility bus, then:
#   G-PANEL     the panel maps (frame differs from the bare session)
#   A11Y-PANEL  the panel controls are exposed to screen readers by name
#   G-CAL-EVENTS the calendar server's events for today list in the date
#               menu's events card, timed as GNOME formats them
#   G-CAL-OPEN  clicking the clock opens the calendar popover (xdg popup
#               on the layer surface, #88)
#   G-CAL-PREFS live first-weekday and ISO-week changes, plus locale reset
#   G-QS-OPEN   clicking the system indicators opens quick settings
#   A11Y-QS     quick-settings toggles and the volume slider are exposed
#   G-WINDOWS   three libadwaita app windows map
#   G-OV-OPEN   Super opens the overview with a preview per window (#54)
#   G-OV-PICK   clicking a preview focuses that window, closes overview
#   G-APP-POPOVER an app's menu popover opens (xdg popups, #88)
#   G-APP-INSTALLED an app installed mid-session shows in search
#   G-GRID-DRAG-PAGE a dragged app held at the grid's edge turns the page
#   G-GRID-REORDER  an app dropped on a tile's edge moves there (saved
#                   to app-picker-layout)
#   G-FOLDER-DND    dragging an app onto another makes a GNOME folder of
#                   them; dragging one out of the folder dialog removes it
#   G-APP-GRID-PAGES enough apps page the grid: indicators and arrows show,
#                   and Next Page turns to the second page
#   G-GRID-PAGE-ANIM a page switch eases over GNOME's 300 ms (each frame's
#                   frame-clock sample on its out-cubic, the page dots
#                   following) and the arrows fade over 200 ms; with
#                   animations off, both jump
#   G-SEARCH-PROVIDER  typing lists a D-Bus search provider's result (#57)
#   G-SEARCH-VIEW      while search shows results the workspace view hides
#   G-SEARCH-ACTIVATE  clicking it calls ActivateResult, closes overview
#   G-FOLDER-ZOOM  the folder dialog zooms out of its icon and back in
#                  over 200 ms while the icon fades; with animations off
#                  it jumps, and Reduced Motion keeps only the fades
#   G-LAUNCH-ZOOM  launching from the grid zooms the icon and label out
#                  over 250 ms
#   G-GRID-FADE    Show Apps fades the grid in over 400 ms after 100 ms
#   G-APP-FOLDERS  GNOME's app-folders settings group the app grid: the
#                  folder replaces its apps and opens to show them
#   G-NOTIFY-BANNER  a D-Bus notification shows a banner (#56)
#   G-NOTIFY-EXPIRE  the banner waits for an away user, then goes 2 s after input
#   G-NOTIFY-LIST    the calendar lists it instead of "No Notifications"
#   G-NOTIFY-CLEAR   Clear empties the list
#   G-NOTIFY-SEND    GetServerInformation answers; real notify-send shows a banner
#   G-NOTIFY-BLOCKED the banner hides while the date menu is open
#   G-NOTIFY-DND     with Do Not Disturb on, no banner, but listed
#   G-NOTIFY-GROUP   two from one app group, collapsed; pressing expands
#   G-NOTIFY-POLICY  per-app policy (#348): first notify registers the app,
#                    disabling it keeps banners and list entries away
#   G-NOTIFY-LOCK    while locked, allowed apps show name and count on the
#                    lock screen, details only with details-in-lock-screen;
#                    other apps are absent from the accessible tree (#348)
#   G-NOTIFY-LOCK-PIXELS a redacted source's pixels do not depend on its
#                    text; details change them and taking them back
#                    restores the frame
#   G-NOTIFY-LOCK-PUSH a list taller than the room under the clock raises
#                    the clock, at most to a tenth of the height from the top
#   G-NOTIFY-LOCK-LIVE arrivals and policy keys reach the locked screen at
#                    once; unlocking brings the queued banners and sounds
#   G-NOTIFY-SOUND   banners play sound-name / sound-file as they show,
#                    silenced by enable-sound-alerts or event-sounds off
#   G-NOTIFY-RESTORE re-enabling a disabled app brings what it sent while
#                    disabled back to the list, with no banner
#   G-QS-SERVICES    quick settings shows the tiles of the services on
#                    the bus (stub daemons on a private system bus, #55)
#   G-QS-WIFI-MENU   the Wi-Fi menu scans, lists NetworkManager's networks
#                    as GNOME does, and activates a saved one
#   G-QS-WIRED  the wired menu disconnects; the Wired tile reconnects
#   G-NM-AGENT       the shell is NetworkManager's secret agent: an unsaved
#                    secured network asks for its password in GNOME's dialog
#   G-QS-SOUND-MENU  the volume slider's menu lists the outputs and makes
#                    the picked one the default
#   G-QS-WIFI        the Wi-Fi tile turns NetworkManager's radio off
#   G-QS-BT-MENU     the Bluetooth menu lists paired devices as GNOME does
#                    and connects one
#   G-QS-PRINTERS    the Printers menu lists the CUPS stub's printers;
#                    the queue window shows GNOME's rows and drives
#                    Cancel and Test Page through the stub
#   G-QS-PRINTERS-ABSENT with no print server the menu says so (no hang)
#   G-QS-BLUETOOTH   the Bluetooth tile powers the BlueZ adapter off
#   G-QS-POWER       the Power Mode tile switches to power saver
#   G-QS-DARK        the Dark Style tile writes GNOME's color-scheme key
#   G-QS-EXTERNAL-SYNC  Dark Style / Night Light follow keys written by gsettings
#   G-QS-DIM-OPAQUE  an open toggle menu dims the grid; the panel stays opaque
#   G-QS-BRIGHTNESS  the brightness slider sets the backlight via logind
#   G-QS-VOLUME      the volume slider sets the PipeWire sink volume
#   G-QS-MIC         recording shows the microphone indicator and slider
#   G-QS-WWAN        the Mobile Network menu lists the modem with its live
#                    operator, signal and APN; the tile flips WwanEnabled
#   G-QS-WWAN-ABSENT without modems the tile hides; without ModemManager
#                    the rows honestly show no signal or operator
#   G-QS-LOCATION    the shell registers its GeoClue agent, InUse lights
#                    the panel, and AuthorizeApp answers from the store
#                    under the Settings-owned master switch and ceiling
#   G-QS-LOCATION-ABSENT without GeoClue the indicator hides while the
#                    switch keeps gating grants and unknown apps stay denied
#   G-QS-ABSENT      with the daemons gone, their tiles hide (no hang)
#   G-GL-WINDOW      a GTK window on the GL renderer maps and paints
#                    (linux-dmabuf, #89)
#   G-WAYLAND-INFO   wayland-info lists every global GNOME 51's Mutter
#                    offers that Tuna Desktop must, at its version or newer
#                    (tests/protocols/gnome51-globals.tsv, P-SY-06)
#   G-OV-SHELL-UI  the overview shows the search entry and the dash
#   G-OV-SEARCH typing lists matching apps (#57)
#   G-OV-LAUNCH Enter launches the top result and closes the overview
#   G-OV-APPGRID Show Apps opens the app grid
#   G-X11-APP      XWayland is on by default: an X11 app launched from
#                  overview search gets DISPLAY and maps a window (#59)
#   G-X11-INPUT-FOCUS the X server's input focus is the focused X11 window
#   G-SETTINGS-CLOCK GNOME's clock-show-seconds key changes the panel clock
#   G-SETTINGS-INPUT GNOME's input sources set the keymap (Super+Space
#                  switches), repeat-interval the repeat rate, and
#                  enable-hot-corners the hot corner (#60)
#   G-SETTINGS-POINTER GNOME's touchpad, mouse, trackball and pointing-stick
#                  keys (send-events, click method, scroll methods, tap
#                  options, middle-click and scroll-wheel emulation,
#                  per-class acceleration) reach the compositor live and
#                  reset to GNOME 51's defaults (#343); the native VM lane
#                  proves libinput device state
#   G-INPUT-SOURCE-MRU Super+Space flips between the two most recent
#                  sources (also when Super is up before the popup holds
#                  the keyboard), the held popup steps through the MRU
#                  list, and mru-sources keeps the order (#346)
#   G-INPUT-PER-WINDOW per-window: each window restores its own source on
#                  focus, new windows start on the first (#346)
#   G-NUMLOCK      Num Lock changes save numlock-state only while
#                  remember-numlock-state is set; a keymap reload keeps
#                  the lock and the active source (#346)
#   G-A11Y-STICKY  Sticky Keys: a tapped Shift latches for one key, two
#                  taps lock, two modifiers at once switch the aid off (#350)
#   G-A11Y-SHORTCUTS Shift five times / held eight seconds switch Sticky /
#                  Slow Keys with GNOME's confirmation; Toggle Keys beep
#   G-A11Y-SLOW    Slow Keys drop short taps and deliver held keys once
#   G-A11Y-BOUNCE  Bounce Keys drop a repeat within the delay
#   G-A11Y-MOUSEKEYS the keypad moves (accelerating) and clicks the pointer
#   G-CURSOR-SIZE  GNOME's cursor-theme and cursor-size change the
#                  compositor-drawn cursor live: an inherited Xcursor
#                  theme's image at 24px, then 48px (#342)
#   G-CURSOR-SHAPE wp_cursor_shape_v1 requests draw that theme's shape
#                  (a missing one falls back to Adwaita or the arrow); a client
#                  cursor surface draws at its own size
#   G-LOCATE-POINTER with locate-pointer on, a lone Ctrl tap draws GNOME's
#                  ripples at the pointer; off, it draws nothing
#   G-A11Y-DWELL   hover click: a resting pointer clicks once with GNOME's
#                  pie timer; gesture mode picks the click by direction
#   G-A11Y-SECONDARY a held primary button makes a secondary click
#   G-SETTINGS-IDLE GNOME's idle-delay and lock-enabled keys set the
#                  compositor's idle lock live (#63)
#   G-SET-WALLPAPER GNOME Settings' picture-uri write reaches the
#                  compositor live: drop file, file identity, decoded
#                  pixels and a visible repaint, with file-replacement
#                  refresh, an ignored invalid URI and revert (#594)
#   G-SET-CLOCK  clock-format and clock-show-date reach the panel
#                  clock live, an invalid format is rejected or falls
#                  back without a crash, and revert restores (#594)
#   G-SET-FONTS  document/monospace fonts reach GTK apps live through
#                  the apps' own Gio.Settings reads with a visible
#                  repaint, a bogus family falls back without a crash,
#                  and revert restores (#594)
#   G-WELLBEING-HISTORY the shell records GNOME-compatible
#                  session-active history, deleted while disabled (#354)
#   G-WELLBEING-LIMIT a spent daily limit posts its high-urgency notice
#                  (no 10 minute warning for a 10 s limit, as GNOME) and
#                  requests grayscale, live; limit off removes it (#354)
#   G-WELLBEING-BREAK a 10 s break shows the OSD countdown, the due
#                  notice updated in place at high urgency, an idle take
#                  fades and sounds, completion removes it (#354)
#   G-WELLBEING-PIXEL-GRAY gray-only framebuffer: 3s EASE_OUT_QUAD to
#                  full desaturation, immediate disable (#354)
#   G-WELLBEING-PIXEL-FADE fade-only framebuffer: 3s EASE_OUT_QUAD to
#                  brightness 0.6, immediate disable (#354)
#   G-WELLBEING-PIXEL-BOTH combined framebuffer: settled gray plus a
#                  fade ramp to 1.0/0.6, immediate disable (#354)
#   G-WELLBEING-PIXEL-RESET reset-to-neutral holds with no restore
#                  fade across stepped time (#354)
#   G-WELLBEING-ACTION-TAKE-LOCK an actual Take press locks; stale
#                  Take fails (#354)
#   G-WELLBEING-ACTION-TAKE-FADE an actual Take press fades a frame
#                  to 0.6; stale Take fails (#354)
#   G-WELLBEING-ACTION-DELAY an actual Delay press moves the live due
#                  by delay-seconds; stale Delay fails (#354)
#   G-WELLBEING-ACTION-SKIP an actual Skip press on the upcoming
#                  notice retires it with the due schedule left
#                  undisturbed; stale Skip fails (#354)
#   G-WELLBEING-NEGATIVE neutral frames fail every effect assertion,
#                  intermediates hold, stale presses fail (#354)
#   G-SCREENSHOT   org.gnome.Shell.Screenshot saves the screen as a PNG
#                  the right way up (#61)
#   G-SCREENSHOT-BUTTON the quick-settings button saves one under
#                  Pictures/Screenshots and lists "Screenshot captured"
#   G-SCREENCAST   a client doing what xdg-desktop-portal-gnome does lists
#                  the monitor (Mutter DisplayConfig), records it (Mutter
#                  ScreenCast) and pulls a frame over PipeWire (#61)
#   G-WINDOW-CAST  window sharing: Introspect refuses non-portal callers,
#                  lists windows to the portal, and RecordWindow streams
#                  one window at its own size (#61)
#   G-SCREENSHOT-WINDOW ScreenshotWindow saves the focused window alone
#   G-STARTUP-REVEAL the desktop fades in from GNOME's startup cover once
#                  the shell maps, then nothing animates
#   G-WALLPAPER-CROSSFADE a new background crossfades over 1000 ms, then
#                  nothing animates; instant with animations off
#   G-HOT-CORNER-RIPPLES the hot corner plays GNOME's ripples, none under
#                  Reduced Motion or with animations off
#   G-MONITOR-TRANSITION a monitor change fades the old screen out, none
#                  with animations off
#   G-LOCK-SLIDE   the lock curtain lowers on lock and lifts after PAM
#                  unlocks, fades only under Reduced Motion, instant
#                  with animations off
#                  (these sample TUNA_ANIMATION_CLOCK at exact delays)
#   G-DISPLAY-SETTINGS GNOME Settings' DisplayConfig as Mutter 51 answers
#                  it: modes and scales listed, verify/stale/bad-mode
#                  errors, temporary changes unsaved, persistent ones
#                  kept by GNOME Shell's dialog into monitors.xml or
#                  reverted by Revert Settings or the 20 s timeout (#59, #340)
#   G-POWER-MENU   the power button opens GNOME's menu (Suspend,
#                  Restart…, Power Off…, Log Out…) (#62)
#   G-POWER-ESCAPE Escape dismisses the end-session dialog (it holds the
#                  keyboard, layer-shell exclusivity)
#   G-POWER-DIALOG Power Off… opens the 60 s end-session dialog, and
#                  Cancel closes it with nothing done
#   G-POWER-OFF    confirming the dialog asks logind to power off
#   G-LOCKDOWN-LOG-OUT disable-log-out flipped live removes Log Out…,
#                  Restart… and Power Off… from the open power menu,
#                  keeps Suspend, and restores them (#357)
#   G-LOCKDOWN-LOCK disable-lock-screen turns the idle lock and the
#                  compositor's Lock off, hides Lock, and Super+L and
#                  ScreenSaver.Lock leave the session unlocked; reset
#                  restores all of it
#   G-LOCKDOWN-COMMAND-LINE Alt+F2 opens Run a Command and runs a line;
#                  disable-command-line refuses it live; reset reopens
#   G-LOCKDOWN-SAVE-TO-DISK disable-save-to-disk keeps the screenshot
#                  key's shot on the clipboard and writes no file
#   G-ACCEL        org.gnome.Shell: an allowlisted caller grabs a media key,
#                  the key fires AcceleratorActivated, and ShowOSD shows
#   G-GSD-MEDIA-OWNER the distribution's real gsd-media-keys owns
#                  org.gnome.SettingsDaemon.MediaKeys, the shell stands its
#                  native media bindings down and gsd's grabs succeed
#   G-GSD-MIC-MUTE XF86AudioMicMute mutes and unmutes the default PipeWire
#                  source through gsd, which shows the microphone OSD; the
#                  native path stays silent
#   G-GSD-VOLUME-ONCE one volume key moves the sink exactly one gsd step
#   G-GSD-MPRIS    XF86AudioPlay reaches an MPRIS player as PlayPause
#   G-GSD-LAUNCHER XF86WWW launches the default x-scheme-handler/http app
#   G-GSD-NATIVE-RESUME with gsd-media-keys gone the native bindings return
#   G-KEYBINDINGS  GNOME Shell's keys: Super+S quick settings, Super+V the
#                  date menu, Super+A the app grid (and back)
#   G-PANEL-FOCUS  Ctrl+Alt+Tab focuses the top bar (switch-panels):
#                  Activities takes focus, Tab walks to the clock and
#                  the system menu, Enter opens quick settings, Escape
#                  unwinds and returns focus to the client; the
#                  backward chord starts on the last control
#   G-KEY-BRIGHTNESS the brightness key steps the backlight through logind
#   G-SCREENSHOT-UI  Print opens the screenshot UI; Screen + Capture saves
#   G-SCREENSHOT-UI-WINDOW Window shows GNOME's window selector, the
#                  focused window chosen; picking another and Capture
#                  saves that window alone at its own size
#   G-SCREENCAST-UI the video switch records the selection: the red
#                  indicator shows in the panel, its stop button ends it,
#                  and a VP8 WebM of the selection's size lands in
#                  Videos/Screencasts
#   G-SCREENCAST-DBUS org.gnome.Shell.Screencast records the screen
#                  between Screencast and StopScreencast
#   G-POLKIT       the shell is the polkit agent: GNOME's dialog, a wrong
#                  password refused, the right one authorizing
#   G-WINDOW-MENU  GNOME's window menu: Always on Top, Hide, and the
#                  overview brings the hidden window back
#   G-WM-KEYS      Alt+Space, Alt+F10, Super+End/Home (wm keybindings)
#   G-WM-REBIND    GNOME's maximize key rebinds through its settings:
#                  the old chord stops, the new one maximizes
#   G-FOCUS-SLOPPY GNOME's focus-mode sloppy: entering a window focuses
#                  it without raising; the desktop keeps focus
#   G-FOCUS-AUTORAISE auto-raise lifts the entered window after its delay
#   G-FOCUS-MOUSE  focus-mode mouse: the desktop drops focus
#   G-FOCUS-RAISE-ON-CLICK raise-on-click false focuses without raising
#   G-FOCUS-MODIFIER mouse-button-modifier <Alt> moves windows, Super no
#                  longer does; resize-with-right-button swaps resize/menu
#   G-SIZE-CHANGE-ANIM maximize, unmaximize, half-tiling and a client's
#                  fullscreen ease 250 ms from the old frame (#496), never
#                  stretching new content; fade-only under Reduced Motion,
#                  instant with animations off
#   G-WS-POPUP     a workspace key shows the workspace switcher popup
#   G-WS-THUMBS    three workspaces put GNOME's thumbnails strip in the
#                  overview, and a thumbnail click switches workspace
#   G-OV-DND       dragging a window's preview onto the next workspace's
#                  card moves the window there, the overview staying open
#   G-SUSPEND-LOCK Suspend asks logind, and its PrepareForSleep locks
#                  the session before sleep
#   G-UNLOCK       GNOME's lock screen: a wrong password is refused and
#                  the right one unlocks through PAM (pam_wrapper)
#   G-LOCK-CURTAIN-CLOCK a key lifts the unlock dialog's clock curtain and
#                  Escape lowers it over 300 ms ease-out quad, sampled on
#                  the frozen animation clock (unlockDialog.js 51, #502)
#   G-LOCK-CURTAIN-POLICY Reduced Motion keeps the unlock dialog's fade
#                  without motion; animations off switch it at once
#   G-LOCK-CURTAIN-DRAG a real pointer drag moves the curtain; releases
#                  settle on swipeTracker.js's projection and ease-out
#                  cubic, a flick reaches the prompt, which unlocks
#   G-LOCK-SWIPE-SECURITY a three-finger swipe under way when the lock
#                  engages ends cancelled, and swipes while locked leave
#                  the overview closed and the workspace unchanged
#   G-LOCK-CURTAIN-HINT the clock's hint stays hidden until 4 s of idle
#                  (HINT_TIMEOUT), then fades in over 300 ms ease-out
#                  cubic on the frozen clock; a power-save change hides
#                  it at once; Reduced Motion keeps the fade, animations
#                  off show it at once (unlockDialog.js 51, #502)
#   G-LOCK-CURTAIN-TOUCHPAD an injected three-finger swipe and a
#                  two-finger scroll ended by the axis stop lift the
#                  curtain and settle on swipeTracker.js's touchpad
#                  projection; the lifted prompt unlocks
#   G-TRANSIENT-OFF with animations off the OSD, banners and panel menus
#                  show and close at once; Reduced Motion keeps the fades
#                  and drops the panel menu's rise (#501)
#   G-TRANSIENT-SETTLE the transient animations ran over GNOME 51's
#                  durations and settled; panel menus rose and grew; the
#                  window menu faded in and closed over 150 ms (#501)
#   G-TRANSIENT-CLOSE-CLOCK a panel menu leaves the accessible tree at
#                  once (Escape, one outside click) while the compositor
#                  draws BoxPointer's close, sampled on the proof clock;
#                  reopening replaces the close; a button hidden under
#                  its menu closes it unanimated (#501)
#   A11Y-GOLDEN    the panel, calendar, quick settings and overview
#                  accessible trees match tests/a11y/ (#71)
#   G-FOCUS-RING   real Ctrl+Alt+Tab and Tab light GNOME 51's focus fill
#                  (white at 17%) on exactly the focused panel control,
#                  read from X frames (P-A11Y-05, #351)
#   G-FOCUS-RING-TIMEOUT keyboard-focus-visible-timeout clears a real
#                  key's indication at the toolkit's 3 s by default, at
#                  2 s and 5 s when set, never at 0, with focus kept
#   G-A11Y-MENU-RESTART a menu row toggled with real keys persists across
#                  one deliberate shell restart and the restarted menu
#                  follows the settings live
#   G-SHELL-STABLE the shell never exits or restarts during the journey,
#                  except G-A11Y-MENU-RESTART's one deliberate restart

#   G-APP-DRAG  dragging an app's header bar moves the window (#58)
#   G-TILE-PREVIEW dragging a window to the left edge shows GNOME's tile
#               preview over the left half; dragging back drops it
#   G-EDGE-TILING-OFF with org.gnome.mutter edge-tiling off the same
#               drag shows no preview and drops floating (P-WM-08)
#   G-SWITCHER-WORKSPACE the window and app switchers follow their live
#               current-workspace-only keys (P-WM-08)
#   G-WS-FIXED  num-workspaces with dynamic-workspaces off keeps a fixed
#               count; shrinking moves windows to the last slot; dynamic
#               again compacts (P-WM-08)
#   G-CENTER-NEW-WINDOWS new windows are centred, or take mutter's first
#               fit with center-new-windows off (P-WM-08)
#   G-TRAY      an AppIndicator item shows in the panel with its
#               tooltip, its menu row reaches the item, and the row
#               leaves the panel when the item exits (P-TR-01)
#   G-SWITCHER-GROUP Alt+Above_Tab shows an app's windows as thumbnails
#               inside the output and steps through them; W closes the
#               focused one
#   G-SWITCHER-FADE the thumbnails fade in and the popup fades out over
#               GNOME's 100 ms, animated and settled; the compositor draws
#               the window images at their frames' opacity, sampled on
#               the proof clock (#501)
#   G-IME            IBus composes pinyin into hanzi in a GTK app
#   G-SCROLL         niri's scrollable tiling: gaps, view follows focus, ring
#   G-IME-SURROUNDING the engine sees the field's text around the
#                    cursor (in characters) and its deletion reaches
#                    the field
#   G-IME-CURSOR     IBus hears the text cursor's location inside the
#                    field's window, in global coordinates
#   G-IME-CANDIDATES the shell is IBus's panel: "ni" shows 你 尼 泥 in
#                    GNOME's candidate popup under the text cursor, and
#                    clicking 尼 commits it
#   G-SWITCHER-REBIND switch-applications rebound moves the switcher
#                   to the new chord
#   G-SWITCHER  Alt+Tab shows the switcher with every app (GNOME's
#               switch-applications; the three test windows are three apps), and
#               releasing Alt focuses the highlighted one
# Frames and accessibility dumps land in the artifacts dir; assertions in
# assertions.txt for the parity ledger.
set -eu
if [ -z "${TUNA_PROOF_PRIVATE_BUS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    TUNA_PROOF_PRIVATE_BUS=1 exec dbus-run-session -- "$0" "$@"
fi
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/gtk-shell-artifacts"
WIDTH=1280
HEIGHT=800
INSTALLED_PACKAGE=0
SCREENSHOT_KEYS_ONLY=0
A11Y_FOCUS_ONLY=0
NOTIFY_LOCK_ONLY=0
GRID_CANCEL_ONLY=0
GRID_CANCEL_OLD_NEGATIVE=0
GRID_CANCEL_ADMISSION=""
COMPANIONS="${TUNA_PROOF_COMPANIONS:-$ROOT/target/debug/examples}"
while [ $# -gt 0 ]; do
    case "$1" in
        --installed-package) INSTALLED_PACKAGE=1; shift ;;
        --grid-cancel-only) GRID_CANCEL_ONLY=1; shift ;;
        --expect-grid-cancel-old-negative) GRID_CANCEL_OLD_NEGATIVE=1; shift ;;
        --grid-cancel-admission) GRID_CANCEL_ADMISSION="$2"; shift 2 ;;
        --screenshot-keys-only) SCREENSHOT_KEYS_ONLY=1; shift ;;
        --a11y-focus-only) A11Y_FOCUS_ONLY=1; shift ;;
        --notify-lock-only) NOTIFY_LOCK_ONLY=1; shift ;;
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --help|-h) sed -n '2,19p' "$0"; exit 0 ;;
        *) echo "tuna-gtk-shell-proof: unknown argument $1" >&2; exit 1 ;;
    esac
done
if [ "$GRID_CANCEL_ONLY" = 1 ]; then
    if [ "$INSTALLED_PACKAGE" != 0 ] || [ "$SCREENSHOT_KEYS_ONLY" != 0 ] || [ "$A11Y_FOCUS_ONLY" != 0 ] || [ -z "$GRID_CANCEL_ADMISSION" ]; then
        echo "grid comparison requires an admitted source-mode tuple" >&2; exit 1
    fi
elif [ "$GRID_CANCEL_OLD_NEGATIVE" = 1 ] || [ -n "$GRID_CANCEL_ADMISSION" ]; then
    echo "old-negative/admission flags require --grid-cancel-only" >&2; exit 1
fi
if [ "$SCREENSHOT_KEYS_ONLY" = 1 ] && [ "$A11Y_FOCUS_ONLY" = 1 ]; then
    echo "--screenshot-keys-only and --a11y-focus-only are separate slices" >&2; exit 1
fi
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
OWNED_RUNTIME=""
# AT-SPI uses a fixed socket below XDG_RUNTIME_DIR. A private session
# bus alone cannot isolate simultaneous nested proof sessions.
OWNED_RUNTIME="$(mktemp -d /tmp/tuna-gtk-runtime.XXXXXX)"
chmod 0700 "$OWNED_RUNTIME"
XDG_RUNTIME_DIR="$OWNED_RUNTIME"
export XDG_RUNTIME_DIR
printf '%s\n' "$XDG_RUNTIME_DIR" >"$ARTIFACTS/runtime-directory.txt"
if [ "$INSTALLED_PACKAGE" = 1 ]; then
    # The private bus has already been established. Do not allow an inherited
    # display/explicit shell override to stand in for installed default selection.
    python3 "$ROOT/scripts/lib/installed-deb-proof.py" preflight "$ARTIFACTS/installed-package.json"
    COMPANIONS=/usr/libexec/tuna-deb-proof
fi
LOG="$ARTIFACTS/nested.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
: >"$ASSERTIONS"
XDG_PICTURES_DIR="$ARTIFACTS/pictures"
XDG_VIDEOS_DIR="$ARTIFACTS/videos"
export XDG_PICTURES_DIR XDG_VIDEOS_DIR
# A private PipeWire for screen casts (#61), never the user's own.
# Short path: Unix sockets cap at 108 bytes.
PIPEWIRE_RUNTIME_DIR="$(mktemp -d /tmp/tuna-pw.XXXXXX)"
export PIPEWIRE_RUNTIME_DIR
# GStreamer (casts, recordings) says what goes wrong in the logs.
GST_DEBUG="${GST_DEBUG:-2}"
export GST_DEBUG
PORTAL_PIDS=""
PW_PIDS=""
if command -v pipewire >/dev/null 2>&1 && command -v wireplumber >/dev/null 2>&1; then
    pipewire >"$ARTIFACTS/pipewire.log" 2>&1 &
    PW_PIDS="$!"
    sleep 1
    wireplumber >"$ARTIFACTS/wireplumber.log" 2>&1 &
    PW_PIDS="$PW_PIDS $!"
fi
XDG_STATE_HOME="$ARTIFACTS/state"
XDG_DATA_HOME="$ARTIFACTS/data"
export XDG_STATE_HOME XDG_DATA_HOME
# Cursor themes (#342): the proof's own first, then the system's.
XCURSOR_PATH="$XDG_DATA_HOME/icons:$HOME/.icons:/usr/share/icons:/usr/share/pixmaps"
export XCURSOR_PATH
# The dash shows only the proof's own windows: pin a favourite no
# runner has, so the host's apps (GitHub's runners now ship Firefox,
# which GNOME's default favourites name) never reach the a11y goldens.
mkdir -p "$XDG_DATA_HOME/tuna-shell"
echo '["org.tuna.ProofNoFavorite.desktop"]' >"$XDG_DATA_HOME/tuna-shell/favorites.json"
# Launch probe for overview search: only this journey has it, and its
# Exec leaves a marker, proving search-to-launch end to end.
PROBE_MARKER="$ARTIFACTS/probe-marker"
rm -f "$PROBE_MARKER"
# pyatspi ships with the distro Python, which a user-local Python
# (Homebrew, pyenv) may shadow on PATH.
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3

# The shell keeps portal opt-outs privately for its whole lifetime; a
# desktop-entry child must see exactly the caller's original flag values.
cat >"$ARTIFACTS/launch-environment.py" <<'PYENV'
import json, os, pathlib, sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({
    key: os.environ.get(key) for key in ("GDK_DEBUG", "ADW_DISABLE_PORTAL")
}, sort_keys=True))
PYENV
"$PY" "$ARTIFACTS/launch-environment.py" "$ARTIFACTS/launch-environment-expected.json"
mkdir -p "$XDG_DATA_HOME/applications"
