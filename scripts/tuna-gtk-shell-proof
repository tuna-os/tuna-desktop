"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-external-a.json" 20 ||
    fail G-QS-EXTERNAL-SYNC "accessibility dump failed"
qs_tile_checked "$ARTIFACTS/a11y-qs-external-a.json" "Dark Style" false ||
    fail G-QS-EXTERNAL-SYNC "Dark Style stayed on after color-scheme became default"
qs_tile_checked "$ARTIFACTS/a11y-qs-external-a.json" "Night Light" true ||
    fail G-QS-EXTERNAL-SYNC "Night Light stayed off after night-light-enabled became true"
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled false
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-external-b.json" 20 ||
    fail G-QS-EXTERNAL-SYNC "accessibility dump failed"
qs_tile_checked "$ARTIFACTS/a11y-qs-external-b.json" "Dark Style" true ||
    fail G-QS-EXTERNAL-SYNC "Dark Style stayed off after color-scheme became prefer-dark"
qs_tile_checked "$ARTIFACTS/a11y-qs-external-b.json" "Night Light" false ||
    fail G-QS-EXTERNAL-SYNC "Night Light stayed on after night-light-enabled became false"
[ "$(gsettings get org.gnome.desktop.interface color-scheme)" = "'prefer-dark'" ] ||
    fail G-QS-EXTERNAL-SYNC "following the key wrote it back"
pass G-QS-EXTERNAL-SYNC "Dark Style and Night Light follow color-scheme and night-light-enabled written outside the tile"
# GNOME Settings' slider path: write the key, then NightLightPreview
# forces it even though Night Light is off. The compositor's own
# org.gnome.SettingsDaemon.Color must ease the applied Temperature
# there over gsd's 5 s smoothing, then back to 6500 K after expiry.
color_call() {
    gdbus call --session --dest org.gnome.SettingsDaemon.Color \
        --object-path /org/gnome/SettingsDaemon/Color "$@" 2>/dev/null
}
color_prop() {
    color_call --method org.freedesktop.DBus.Properties.Get org.gnome.SettingsDaemon.Color "$1"
}
color_temp() {
    color_prop Temperature | sed -n 's/^(<uint32 \([0-9]*\)>,)$/\1/p'
}
gsettings set org.gnome.settings-daemon.plugins.color night-light-temperature 3000
# The tile just switched Night Light off: let any ease back finish.
for _ in $(seq 1 70); do
    [ "$(color_temp)" = 6500 ] && break
    sleep 0.1
done
[ "$(color_temp)" = 6500 ] || fail G-QS-NIGHT "Temperature is $(color_temp), not 6500 K, with Night Light off"
if color_call --method org.gnome.SettingsDaemon.Color.NightLightPreview 0 >/dev/null; then
    fail G-QS-NIGHT "NightLightPreview accepted a zero duration"
fi
# Watch the signals GNOME Settings' proxy reacts to, not only polling.
NIGHT_SIGNALS="$ARTIFACTS/night-light-signals.txt"
gdbus monitor --session --dest org.gnome.SettingsDaemon.Color \
    --object-path /org/gnome/SettingsDaemon/Color >"$NIGHT_SIGNALS" 2>&1 &
night_monitor=$!
sleep 0.5
color_call --method org.gnome.SettingsDaemon.Color.NightLightPreview 10 >/dev/null ||
    fail G-QS-NIGHT "NightLightPreview(10) failed"
night_eased="" night_reached=""
for _ in $(seq 1 100); do
    night_temp="$(color_temp)"
    if [ "$night_temp" = 3000 ]; then
        night_reached=1
        break
    fi
    if [ -n "$night_temp" ] && [ "$night_temp" -gt 3000 ] && [ "$night_temp" -lt 6500 ]; then
        night_eased=1
    fi
    sleep 0.1
done
[ -n "$night_reached" ] || fail G-QS-NIGHT "the preview never applied 3000 K (Temperature $(color_temp))"
[ -n "$night_eased" ] || fail G-QS-NIGHT "the preview jumped to 3000 K without gsd's smoothing"
color_prop NightLightActive | grep -q true ||
    fail G-QS-NIGHT "NightLightActive is not true during the preview"
night_restored=""
for _ in $(seq 1 200); do
    if [ "$(color_temp)" = 6500 ]; then
        night_restored=1
        break
    fi
    sleep 0.1
done
[ -n "$night_restored" ] || fail G-QS-NIGHT "the preview never expired back to 6500 K (Temperature $(color_temp))"
color_prop NightLightActive | grep -q false ||
    fail G-QS-NIGHT "NightLightActive stayed true after the preview expired"
kill "$night_monitor" 2>/dev/null || true
wait "$night_monitor" 2>/dev/null || true
night_signal() {
    grep -F "org.freedesktop.DBus.Properties.PropertiesChanged ('org.gnome.SettingsDaemon.Color', {'$1': $2" \
        "$NIGHT_SIGNALS" >/dev/null
}
night_signal NightLightActive '<true>' ||
    fail G-QS-NIGHT "no PropertiesChanged NightLightActive=true during the preview ($(wc -l <"$NIGHT_SIGNALS") lines)"
night_signal NightLightActive '<false>' ||
    fail G-QS-NIGHT "no PropertiesChanged NightLightActive=false after the preview"
night_signal Temperature '<uint32 3000>' ||
    fail G-QS-NIGHT "no PropertiesChanged Temperature=3000 during the preview"
night_signal Temperature '<uint32 6500>' ||
    fail G-QS-NIGHT "no PropertiesChanged Temperature=6500 after the preview"
gsettings reset org.gnome.settings-daemon.plugins.color night-light-temperature
pass G-QS-NIGHT "the real tile toggles night-light-enabled; NightLightPreview eases Temperature to the key and back, announced by PropertiesChanged"

"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-brightness.json" 20 \
    --set Brightness 30 || fail G-QS-BRIGHTNESS "could not set Brightness"
[ "$(cat "$BACKLIGHT/brightness")" = 300 ] ||
    fail G-QS-BRIGHTNESS "backlight is $(cat "$BACKLIGHT/brightness"), not 300"
pass G-QS-BRIGHTNESS "the brightness slider sets the backlight through logind"

"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-volume.json" 20 \
    --set Volume 40 || fail G-QS-VOLUME "could not set Volume"
[ "$(cat "$VOLUME_FILE")" = 0.40 ] ||
    fail G-QS-VOLUME "sink volume is $(cat "$VOLUME_FILE"), not 0.40"
pass G-QS-VOLUME "the volume slider sets the PipeWire sink volume"

# GNOME's microphone: while an app records, an orange indicator leads
# the panel and a Microphone slider sets the default source; both go
# when the recording stops.
mic_shown() {
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-mic-$1.json" 20 &&
        showing "$ARTIFACTS/a11y-mic-$1.json" "$2"
}
mic_shown idle Microphone && fail G-QS-MIC "the Microphone slider shows with nothing recording"
touch "$RECORDING_FILE"
"$PY" "$ROOT/scripts/lib/tuna-audio-fixture.py" "$ARTIFACTS" --event
for _ in $(seq 1 20); do grep -q "audio recording frame true" "$LOG" && break; sleep 0.05; done
grep -q "audio recording frame true" "$LOG" || fail G-QS-MIC-EVENT "recording event was not reflected by the next frame"
mic_shown recording Microphone || fail G-QS-MIC "no Microphone slider while an app records"
showing "$ARTIFACTS/a11y-mic-recording.json" "Microphone in use" ||
    fail G-QS-MIC "no microphone indicator in the panel while an app records"
scrot "$ARTIFACTS/16b-microphone.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-mic.json" 20 \
    --set Microphone 30 || fail G-QS-MIC "could not set Microphone"
[ "$(cat "$MIC_FILE")" = 0.30 ] ||
    fail G-QS-MIC "source volume is $(cat "$MIC_FILE"), not 0.30"
rm -f "$RECORDING_FILE"
"$PY" "$ROOT/scripts/lib/tuna-audio-fixture.py" "$ARTIFACTS" --event
for _ in $(seq 1 20); do grep -q "audio recording frame false" "$LOG" && break; sleep 0.05; done
grep -q "audio recording frame false" "$LOG" || fail G-QS-MIC-EVENT "recording removal was not reflected by the next frame"
pass G-QS-MIC-EVENT "PipeWire node creation/removal updates recording widgets in the event callback before the next frame, without polling"
mic_shown stopped "Microphone in use" &&
    fail G-QS-MIC "the microphone indicator stayed after the recording stopped"
pass G-QS-MIC "an app recording shows the microphone indicator and slider; the slider sets the source"
scrot "$ARTIFACTS/16-quick-settings-toggled.png" >/dev/null
xdotool key Escape
sleep 1

