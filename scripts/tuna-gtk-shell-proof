    fail G-SETTINGS-NOTIFICATIONS "DND on dump failed"
jq -e 'any(.[]; .name == "Do Not Disturb" and .role == "toggle button" and .showing and .checked)' \
    "$ARTIFACTS/a11y-dnd-external-on.json" >/dev/null || fail G-SETTINGS-NOTIFICATIONS "external false did not check DND"
xdotool key Escape
