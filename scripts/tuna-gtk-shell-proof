sleep 1.5
xdotool key super+a
cstate '.overview_open and .overview_app_grid' "app grid" || fail G-GRID-REORDER "Super+A did not show the app grid"
sleep 1.5
# By name the cells read One, Three, Two: Two (third cell) onto the left
# edge of One (first cell, x 146-259).
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-before-hover.json" 20 || fail G-GRID-HOVER "baseline dump failed"
grid_origin
layout_before_hover="$(gsettings get org.gnome.shell app-picker-layout)"
grid_coordinates="$(grid_point "$ARTIFACTS/a11y-grid-before-hover.json" "AAA Move Two")" || fail G-GRID-HOVER "source tile bounds missing"
read -r source_x source_y <<EOF
$grid_coordinates
EOF
grid_coordinates="$(grid_point "$ARTIFACTS/a11y-grid-before-hover.json" "AAA Move One" 4)" || fail G-GRID-HOVER "target edge bounds missing"
read -r target_x target_y <<EOF
$grid_coordinates
EOF
xdotool mousemove --window "$WID" "$source_x" "$source_y"
sleep 0.3
xdotool mousedown 1
sleep 0.1
# Recognize the drag before crossing to the target, as in the page proof.
for step in $(seq 1 6); do
    xdotool mousemove --window "$WID" $((source_x - step * 10)) "$source_y"
    sleep 0.05
done
sleep 0.25
xdotool mousemove --window "$WID" "$target_x" "$target_y"
sleep 0.35
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-grid-live-hover.json" 20 || fail G-GRID-HOVER "hover dump failed"
before_x="$(jq '[.[] | select(.showing and (.role == "push button" or .role == "button") and .name == "AAA Move One")][0].bounds[0]' "$ARTIFACTS/a11y-grid-before-hover.json")"
after_x="$(jq '[.[] | select(.showing and (.role == "push button" or .role == "button") and .name == "AAA Move One")][0].bounds[0]' "$ARTIFACTS/a11y-grid-live-hover.json")"
scrot "$ARTIFACTS/11g-grid-live-hover.png" >/dev/null
