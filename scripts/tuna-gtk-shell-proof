# A desktop has no battery. Hotplug and live UPower/settings changes must
# update both the panel and the power summary without reopening the menu.
battery_set() {
    gdbus call --system --dest org.freedesktop.UPower \
        --object-path /org/freedesktop/UPower/devices/DisplayDevice \
        --method org.freedesktop.DBus.Properties.Set \
        org.freedesktop.UPower.Device "$1" "$2" >/dev/null
}
battery_dump() {
    sleep 1
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-battery.json" 20
}
if showing "$ARTIFACTS/a11y-qs.json" "37% · Discharging · 1∶30 remaining"; then
    fail G-BATTERY "battery is visible on a desktop without one"
fi
gsettings set org.gnome.desktop.interface show-battery-percentage false
battery_set IsPresent '<true>'
battery_dump
showing "$ARTIFACTS/a11y-battery.json" "37% · Discharging · 1∶30 remaining" ||
    fail G-BATTERY "UPower discharging battery summary missing"
if showing "$ARTIFACTS/a11y-battery.json" '37%'; then
    fail G-BATTERY "panel percentage ignored disabled setting"
fi
gsettings set org.gnome.desktop.interface show-battery-percentage true
battery_dump
showing "$ARTIFACTS/a11y-battery.json" '37%' || fail G-BATTERY "percentage setting did not update live"
battery_set State '<uint32 1>'
battery_set Percentage '<82.0>'
battery_dump
showing "$ARTIFACTS/a11y-battery.json" '82%' || fail G-BATTERY "panel level did not update live"
showing "$ARTIFACTS/a11y-battery.json" "82% · Charging · 0∶30 until full" ||
    fail G-BATTERY "charging time did not update live"
gsettings set org.gnome.desktop.interface show-battery-percentage false
battery_set IsPresent '<false>'
battery_dump
if showing "$ARTIFACTS/a11y-battery.json" '82%'; then
    fail G-BATTERY "removed battery stayed visible"
fi
pass G-BATTERY "UPower hotplug, charging/discharging and percentage setting update live"

