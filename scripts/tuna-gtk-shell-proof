import json, sys
nodes = json.load(open(sys.argv[1]))
# PopupSubMenuMenuItem and its submenu share one group: the rows sit in
# the group of the adapter's item, not in the other adapter's.
item = next(i for i, n in enumerate(nodes) if n['name'] == 'Wired (enp1s0)' and n['role'] != 'label')
start = max(i for i in range(item) if nodes[i]['depth'] < nodes[item]['depth'])
