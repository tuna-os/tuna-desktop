pass G-QS-WIFI-MENU "the Wi-Fi menu scans, lists networks as GNOME does, and activates a saved one"

# GNOME's wired menu: the active profile is one row named for the device
# with a Disconnect subtitle; it takes the device down. The toggle then
# brings the profile back and shows checked.
wired_checked() {
    jq -e --arg want "$2" 'any(.[]; .name == "Wired" and .role == "toggle button"
        and (.checked | tostring) == $want)' "$1" >/dev/null
}
wired_checked "$ARTIFACTS/a11y-qs-wifi-on.json" true ||
    fail G-QS-WIRED "the Wired tile is not checked with its profile up"
qs_press "Wired Menu" wired-menu || fail G-QS-WIRED "could not open the wired menu"
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-wired-menu.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
scrot "$ARTIFACTS/15e-wired-menu.png" >/dev/null
# GNOME 51 quickSettings.js _setDimmed darkens only the grid behind an
# open menu; the panel stays opaque (#847: libadwaita's .dimmed made it
# 55% opaque). The open frame must hold the opaque dimmed surface
# #202023 in the panel's padding, not a blend with what is behind it.
"$PY" - "$ARTIFACTS/15e-wired-menu.png" <<'PYEOF' || fail G-QS-DIM-OPAQUE "the dimmed panel is not opaque #202023 (translucent?)"
import sys
from PIL import Image
img = Image.open(sys.argv[1]).convert("RGB")
w, h = img.size
px = img.load()
def near(p):
    return all(abs(a - b) <= 3 for a, b in zip(p, (0x20, 0x20, 0x23)))
rows = 0
for y in range(h):
    run = best = 0
    for x in range(w // 2, w):
        run = run + 1 if near(px[x, y]) else 0
        best = max(best, run)
    rows += best >= 12
print(f"rows with an opaque #202023 run: {rows}")
sys.exit(0 if rows >= 20 else 1)
PYEOF
pass G-QS-DIM-OPAQUE "an open toggle menu dims the grid while the panel stays opaque"
showing "$ARTIFACTS/a11y-qs-wired-menu.json" "Disconnect Wired" ||
    fail G-QS-WIRED "the menu has no Disconnect row for the active profile"
showing "$ARTIFACTS/a11y-qs-wired-menu.json" "Wired Settings" ||
    fail G-QS-WIRED "the menu has no Wired Settings item"
qs_press "Disconnect Wired" wired-off || fail G-QS-WIRED "could not press Disconnect"
grep -q "^Disconnect /org/freedesktop/NetworkManager/Devices/1" "$TUNA_STUB_NM_LOG" ||
    fail G-QS-WIRED "Disconnect did not take the device down"
sleep 1.5
open_qs
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-wired-off.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
wired_checked "$ARTIFACTS/a11y-qs-wired-off.json" false ||
    fail G-QS-WIRED "the Wired tile stayed checked with the device down"
qs_press "Wired" wired-on || fail G-QS-WIRED "could not press the Wired tile"
grep -q "^ActivateConnection /org/freedesktop/NetworkManager/Settings/3 /org/freedesktop/NetworkManager/Devices/1" \
    "$TUNA_STUB_NM_LOG" || fail G-QS-WIRED "the Wired tile did not bring its profile back"
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-wired-on.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
wired_checked "$ARTIFACTS/a11y-qs-wired-on.json" true ||
    fail G-QS-WIRED "the Wired tile is not checked again"
pass G-QS-WIRED "the wired menu disconnects the profile and the Wired tile brings it back, as GNOME's do"

# GNOME's network agent: an unsaved WPA2 network makes NetworkManager
# ask the shell's agent, which shows GNOME's dialog; the typed password
# goes back to NetworkManager.
grep -q "network agent registered" "$LOG" || fail G-NM-AGENT "the shell never registered a secret agent"
qs_press "Wi-Fi Menu" wifi-menu-again || fail G-NM-AGENT "could not reopen the Wi-Fi menu"
sleep 1
qs_press "Tuna Desktop Guest, Secure, Signal strength 50%" wifi-guest ||
    fail G-NM-AGENT "could not press Tuna Desktop Guest"
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-nm-agent.json" 20 ||
    fail G-NM-AGENT "accessibility dump failed"
showing "$ARTIFACTS/a11y-nm-agent.json" "Authentication required" ||
    fail G-NM-AGENT "no Authentication required dialog"
scrot "$ARTIFACTS/15d-network-agent.png" >/dev/null
xdotool type --delay 30 "guest-pass-$$"
xdotool key Return
for _ in $(seq 1 20); do grep -q "^Secrets" "$TUNA_STUB_NM_LOG" && break; sleep 0.5; done
grep -q "^Secrets psk=guest-pass-$$" "$TUNA_STUB_NM_LOG" ||
    fail G-NM-AGENT "NetworkManager got $(grep "^Secrets" "$TUNA_STUB_NM_LOG" || echo nothing), not the typed password"
pass G-NM-AGENT "an unsaved secured network asks for its password in GNOME's dialog"
sleep 1

# A real private Secret Service, accessed by libsecret's secret-tool.
command -v secret-tool >/dev/null || fail G-NM-ENTERPRISE "libsecret secret-tool is required"
command -v gnome-keyring-daemon >/dev/null || fail G-NM-ENTERPRISE "GNOME Keyring is required"
printf 'tuna-proof-keyring\n' | gnome-keyring-daemon --unlock --components=secrets --control-directory="$ARTIFACTS/keyring-control" >"$ARTIFACTS/keyring.log" 2>&1
# The daemon's parent returns before the child owns org.freedesktop.secrets.
# A lookup in that gap makes the bus activate a second, locked keyring
# daemon whose store needs gcr-prompter, which has no display here (#528).
# Wait until the name belongs to the daemon unlocked above.
keyring_owns_secrets() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.secrets 2>/dev/null | grep -q true || return 1
    owner="$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetNameOwner org.freedesktop.secrets | sed -n "s/^('\(.*\)',)$/\1/p")"
    pid="$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetConnectionUnixProcessID "$owner" | sed -n 's/^(uint32 \([0-9]*\),)$/\1/p')"
    [ -n "$pid" ] && tr '\0' ' ' <"/proc/$pid/cmdline" | grep -qF -- "--control-directory=$ARTIFACTS/keyring-control"
}
for _ in $(seq 1 100); do keyring_owns_secrets && break; sleep 0.1; done
keyring_owns_secrets || fail G-NM-ENTERPRISE "the unlocked GNOME Keyring never owned org.freedesktop.secrets"
TUNA_NM_VPN_PLUGIN_DIR="$ARTIFACTS/vpn-plugins"
TUNA_NM_VPN_PROOF=1
export TUNA_NM_VPN_PLUGIN_DIR TUNA_NM_VPN_PROOF
# The shell inherited this directory at startup (set beside the NM log).
mkdir -p "$TUNA_NM_VPN_PLUGIN_DIR"
cat >"$TUNA_NM_VPN_PLUGIN_DIR/proof-auth" <<'VPNHELPER'
#!/bin/sh
# A real external-ui plugin protocol: consume connection data through DONE.
while IFS= read -r line; do [ "$line" = DONE ] && break; done
cat <<'UI'
[VPN Plugin UI]
Version=2
Title=VPN authentication
Description=Connect to Tuna Desktop VPN
[username]
Value=alice
ShouldAsk=false
[password]
Value=
ShouldAsk=true
Label=VPN Password
IsSecret=true
UI
VPNHELPER
chmod +x "$TUNA_NM_VPN_PLUGIN_DIR/proof-auth"
cat >"$TUNA_NM_VPN_PLUGIN_DIR/proof.name" <<VPNNAME
[VPN Connection]
service=org.tuna.Proof.VPN
[GNOME]
auth-dialog=$TUNA_NM_VPN_PLUGIN_DIR/proof-auth
supports-external-ui-mode=true
supports-hints=true
VPNNAME
nm_request() {
    gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.NetworkManager \
        --object-path /org/freedesktop/NetworkManager --method org.tuna.Proof.Network.RequestSecrets "$1" "$2" >/dev/null
}
nm_answered() {
    for _ in $(seq 1 30); do grep -q "$1" "$TUNA_STUB_NM_LOG" && return 0; sleep 0.5; done
    return 1
}
nm_request enterprise 1
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-nm-enterprise.json" 20 || fail G-NM-ENTERPRISE "dump failed"
showing "$ARTIFACTS/a11y-nm-enterprise.json" Username || fail G-NM-ENTERPRISE "no identity field"
showing "$ARTIFACTS/a11y-nm-enterprise.json" Password || fail G-NM-ENTERPRISE "no EAP password field"
scrot "$ARTIFACTS/15e-network-enterprise.png" >/dev/null
xdotool key ctrl+a
xdotool type --delay 20 alice
xdotool key Tab
xdotool type --delay 20 enterprise-password
xdotool key Return
nm_answered '^ProofSecrets enterprise flags=1 identity=alice password=enterprise-password' || fail G-NM-ENTERPRISE "identity and password did not reach NM"
# No interaction: the second request must use the actual keyring item.
nm_request enterprise 0
nm_answered '^ProofSecrets enterprise flags=0 identity=alice password=enterprise-password' || fail G-NM-ENTERPRISE "keyring lookup did not answer without a dialog"
secret-tool lookup connection-uuid 00000000-0000-4000-8000-000000000211 setting-name 802-1x setting-key password | grep -qx enterprise-password || fail G-NM-ENTERPRISE "secret is absent from GNOME Keyring"
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.NetworkManager \
    --object-path /org/freedesktop/NetworkManager --method org.tuna.Proof.Network.DeleteSecrets enterprise >/dev/null
nm_answered '^ProofSecrets enterprise deleted' || fail G-NM-ENTERPRISE "DeleteSecrets failed"
if secret-tool lookup connection-uuid 00000000-0000-4000-8000-000000000211 setting-name 802-1x setting-key password >/dev/null; then fail G-NM-ENTERPRISE "DeleteSecrets retained the keyring item"; fi
nm_request tls 1
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-nm-tls.json" 20 || fail G-NM-ENTERPRISE "TLS dump failed"
showing "$ARTIFACTS/a11y-nm-tls.json" "Private key password" || fail G-NM-ENTERPRISE "TLS did not ask for the private-key password"
xdotool type --delay 20 private-key-password
xdotool key Return
nm_answered '^ProofSecrets tls flags=1 private-key-password=private-key-password' || fail G-NM-ENTERPRISE "TLS secret did not reach NM"
pass G-NM-ENTERPRISE "802.1X identity/password and TLS key password; user secret stored, reused without interaction and deleted through libsecret"
nm_request vpn 1
sleep 2
