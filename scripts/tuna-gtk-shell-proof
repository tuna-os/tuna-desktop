    --press "Allow" >/dev/null ||
    { kill "$newcomer_pid" 2>/dev/null; fail G-QS-LOCATION "could not press Allow on the consent prompt"; }
wait "$newcomer_pid"
auth=$(cat "$ARTIFACTS/location-newcomer-auth.txt")
echo "$auth" | grep -qE "\(true, (uint32 )?8\)" ||
    fail G-QS-LOCATION "allowed first-use answered $auth, not (true, 8)"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-newcomer 8 2>&1) ||
    fail G-QS-LOCATION "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(true, (uint32 )?8\)" ||
    fail G-QS-LOCATION "saved newcomer grant answered $auth, not (true, 8)"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp no-such-app-xyz 8 2>&1) ||
    fail G-QS-LOCATION "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(false, (uint32 )?0\)" ||
    fail G-QS-LOCATION "unknown app answered $auth, not denied"
# Switching off denies live: the stored grant stops authorizing and the
# indicator stays dark even while GeoClue reports in use.
gsettings set org.gnome.system.location enabled false ||
    fail G-QS-LOCATION "could not switch location off"
ceiling=$(agent_ceiling 0) ||
    fail G-QS-LOCATION "the agent never reported the switch off: $ceiling"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-app 8 2>&1) ||
    fail G-QS-LOCATION "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(false, (uint32 )?0\)" ||
    fail G-QS-LOCATION "stored grant answered $auth with the switch off, not denied"
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.GeoClue2 \
    --object-path /org/freedesktop/GeoClue2/Manager --method org.freedesktop.DBus.Properties.Set \
    org.freedesktop.GeoClue2.Manager InUse "<true>" >/dev/null ||
    fail G-QS-LOCATION "could not set GeoClue InUse"
off_dark=""
for _ in $(seq 1 10); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-location-off.json" 20 ||
        fail G-QS-LOCATION "accessibility dump failed"
    if ! showing "$ARTIFACTS/a11y-qs-location-off.json" "Location in use"; then
        # Absence must hold, not merely race the signal: one more dump.
        sleep 1
        "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-location-off.json" 20 ||
            fail G-QS-LOCATION "accessibility dump failed"
        if ! showing "$ARTIFACTS/a11y-qs-location-off.json" "Location in use"; then off_dark=1; break; fi
    fi
    sleep 1
done
[ -n "$off_dark" ] || fail G-QS-LOCATION "the Location indicator lit with the switch off"
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.freedesktop.GeoClue2 \
    --object-path /org/freedesktop/GeoClue2/Manager --method org.freedesktop.DBus.Properties.Set \
    org.freedesktop.GeoClue2.Manager InUse "<false>" >/dev/null ||
    fail G-QS-LOCATION "could not clear GeoClue InUse"
gsettings set org.gnome.system.location enabled true ||
    fail G-QS-LOCATION "could not switch location back on"
pass G-QS-LOCATION "the agent registers, InUse lights the panel, AuthorizeApp answers from the store under the switch and ceiling, and first use prompts with deny/allow flowing through"

# Without GeoClue the indicator hides while the switch keeps gating
# grants and unknown apps stay denied.
gsettings set org.gnome.system.location enabled true ||
    fail G-QS-LOCATION-ABSENT "could not switch location on"
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.tuna.Proof.WwanLocation \
    --object-path /org/tuna/Proof/WwanLocation --method org.tuna.Proof.WwanLocation.GeoCluePresent false >/dev/null ||
    fail G-QS-LOCATION-ABSENT "could not release the stub GeoClue name"
loc_dark=""
for _ in $(seq 1 15); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-location-absent.json" 20 ||
        fail G-QS-LOCATION-ABSENT "accessibility dump failed (shell hung?)"
    if ! showing "$ARTIFACTS/a11y-qs-location-absent.json" "Location in use"; then loc_dark=1; break; fi
    sleep 1
done
scrot "$ARTIFACTS/16f-location-absent.png" >/dev/null
[ -n "$loc_dark" ] || fail G-QS-LOCATION-ABSENT "the Location indicator stayed with GeoClue gone"
# The switch still gates the agent with the daemon gone: off denies the
# stored grant, on restores it, and unknown apps stay denied throughout.
gsettings set org.gnome.system.location enabled false ||
    fail G-QS-LOCATION-ABSENT "could not switch location off"
ceiling=$(agent_ceiling 0) ||
    fail G-QS-LOCATION-ABSENT "the agent never reported the switch off: $ceiling"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-app 8 2>&1) ||
    fail G-QS-LOCATION-ABSENT "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(false, (uint32 )?0\)" ||
    fail G-QS-LOCATION-ABSENT "stored grant answered $auth with the switch off, not denied"
gsettings set org.gnome.system.location enabled true ||
    fail G-QS-LOCATION-ABSENT "could not switch location back on"
ceiling=$(agent_ceiling 8) ||
    fail G-QS-LOCATION-ABSENT "the agent never reported the switch back on: $ceiling"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp proof-location-app 8 2>&1) ||
    fail G-QS-LOCATION-ABSENT "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(true, (uint32 )?8\)" ||
    fail G-QS-LOCATION-ABSENT "stored grant answered $auth with the switch back on, not (true, 8)"
auth=$(gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest "$shell_bus" \
    --object-path /org/freedesktop/GeoClue2/Agent \
    --method org.freedesktop.GeoClue2.Agent.AuthorizeApp no-such-app-xyz 8 2>&1) ||
    fail G-QS-LOCATION-ABSENT "AuthorizeApp call failed: $auth"
echo "$auth" | grep -qE "\(false, (uint32 )?0\)" ||
    fail G-QS-LOCATION-ABSENT "unknown app answered $auth, not denied"
gdbus call --address "$DBUS_SYSTEM_BUS_ADDRESS" --dest org.tuna.Proof.WwanLocation \
    --object-path /org/tuna/Proof/WwanLocation --method org.tuna.Proof.WwanLocation.GeoCluePresent true >/dev/null ||
    fail G-QS-LOCATION-ABSENT "could not restore the stub GeoClue name"
pass G-QS-LOCATION-ABSENT "without GeoClue the indicator hides while the switch gates grants and unknown apps stay denied"

kill "$STUBS_PID" 2>/dev/null || true
STUBS_PID=""
sleep 2
scrot "$ARTIFACTS/17-before-absent.png" >/dev/null
open_qs
scrot "$ARTIFACTS/18-quick-settings-absent.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-absent.json" 20 ||
    fail G-QS-ABSENT "accessibility dump failed (shell hung?)"
for label in "Wi-Fi" "Bluetooth" "Mobile Network" "Power Mode"; do
    if showing "$ARTIFACTS/a11y-qs-absent.json" "$label"; then
        fail G-QS-ABSENT "'$label' still showing with its daemon gone"
    fi
done
showing "$ARTIFACTS/a11y-qs-absent.json" "Dark Style" ||
    fail G-QS-ABSENT "the settings tiles went away with the daemons"
pass G-QS-ABSENT "tiles hide when their daemons leave the bus"
xdotool key Escape

# GPU clients (#89): with linux-dmabuf advertised, a GTK window on the
# GL renderer maps and paints instead of hanging.
WAYLAND_DISPLAY="$SOCKET_NAME" GSK_RENDERER=gl "$PY" "$ROOT/scripts/lib/tuna-test-window.py" \
    Delta "#c01c28" >"$ARTIFACTS/window-Delta.log" 2>&1 &
cstate '.windows | any(.app_id == "tuna-test-delta")' "gl window" ||
    fail G-GL-WINDOW "a GL-rendered GTK window never mapped"
# The compositor draws the pointer (#342): park it off the probed body.
xdotool mousemove --window "$WID" $((WIDTH - 2)) $((HEIGHT - 2))
sleep 2
scrot "$ARTIFACTS/19-gl-window.png" >/dev/null
centre="$(jq -r '.windows[] | select(.app_id == "tuna-test-delta") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 3)"' "$CSTATE")"
# shellcheck disable=SC2086
set -- $centre
rgb="$(px "$ARTIFACTS/19-gl-window.png" "${1%.*}" "${2%.*}")"
# shellcheck disable=SC2086
set -- $rgb
if [ "$1" -lt 150 ] || [ "$2" -gt 80 ] || [ "$3" -gt 80 ]; then
    fail G-GL-WINDOW "GL window did not paint its red body (pixel $rgb)"
fi
pass G-GL-WINDOW "a GL-rendered GTK window maps and paints"

# The globals a client finds (P-SY-06, #89): wayland-info against this
# session, compared with GNOME 51's capture. Here, after G-GL-WINDOW,
# the renderer has reported its formats, so linux-dmabuf is advertised.
if command -v wayland-info >/dev/null 2>&1; then
    WAYLAND_DISPLAY="$SOCKET_NAME" wayland-info >"$ARTIFACTS/wayland-info.txt" 2>&1 ||
        fail G-WAYLAND-INFO "wayland-info could not talk to the session"
    "$PY" "$ROOT/scripts/tuna-wayland-info-compare" "$ARTIFACTS/wayland-info.txt" \
        --report "$ARTIFACTS/wayland-info-compare.txt" ||
        fail G-WAYLAND-INFO "globals short of GNOME 51's (see wayland-info-compare.txt)"
    "$PY" "$ROOT/scripts/tuna-wayland-info-compare" "$ARTIFACTS/wayland-info.txt" \
        --reference "$ROOT/tests/protocols/marlin-gnome51-globals.tsv" \
        --report "$ARTIFACTS/wayland-info-marlin-compare.txt" ||
        fail G-WAYLAND-INFO "globals short of native Marlin GNOME 51's recorded expectations"
    pass G-WAYLAND-INFO "headless and native Marlin GNOME 51 comparisons satisfy version floors, with gaps recorded"
elif [ "${TUNA_REQUIRE_WAYLAND_INFO:-0}" = 1 ]; then
    fail G-WAYLAND-INFO "wayland-info is required (TUNA_REQUIRE_WAYLAND_INFO=1) but not installed"
else
    echo "tuna-gtk-shell-proof: G-WAYLAND-INFO skipped (no wayland-info)"
fi

# X11 by default (#59/#219): the shell advertises reserved sockets; the
# first real X11 connection starts the server and maps that queued client.
if command -v Xwayland >/dev/null 2>&1 && command -v xeyes >/dev/null 2>&1; then
    cstate '.x11_display != null' "xwayland" 30 || fail G-X11-APP "XWayland never came up"
    x11_display="$(jq -r '.x11_display' "$CSTATE")"
    before="$(jq '.windows | length' "$CSTATE")"
    xdotool key Super_L
    cstate '.overview_open' "overview" || fail G-X11-APP "overview did not open"
    sleep 1
    xdotool type --delay 40 "tuna x probe"
    sleep 1
    xdotool key Return
    end=$(($(date +%s) + 15))
    until [ -s "$X11_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(cat "$X11_MARKER" 2>/dev/null)" = "$x11_display" ] ||
        fail G-X11-APP "launched app saw DISPLAY='$(cat "$X11_MARKER" 2>/dev/null)', not $x11_display"
    cstate "(.windows | length) > $before" "x11 window" 20 ||
        fail G-X11-APP "the X11 app never mapped a window"
    # Like a native app: focused, and placed below the top bar.
    cstate '.focused_app_id == "XEyes"' "x11 focus" ||
        fail G-X11-APP "the X11 window was not focused after launch"
    cstate '.windows[] | select(.app_id == "XEyes") | .rect[1] >= 32' "x11 placement" ||
        fail G-X11-APP "the X11 window was placed under the top bar"
    sleep 1
    scrot "$ARTIFACTS/20-x11-app.png" >/dev/null
    cstate '.x11_ready' "X11 manager ready" || fail G-X11-APP "manager not ready"
    x11_pid="$(pgrep -P "$COMPOSITOR_PID" -x Xwayland)"
    [ "$(printf '%s\n' "$x11_pid" | wc -l)" -eq 1 ] || fail G-X11-DEMAND "expected one owned compatibility process"
    native_ids="$(jq -c '[.windows[] | select(.app_id != "XEyes") | .id] | sort' "$CSTATE")"
    old_xim_pid=""
    if command -v ibus-daemon >/dev/null 2>&1; then
        for _ in $(seq 1 30); do
            old_xim_pid="$(pgrep -P "$COMPOSITOR_PID" -x ibus-x11 || true)"
            [ -n "$old_xim_pid" ] && break
            sleep 0.2
        done
        [ -n "$old_xim_pid" ] || fail G-X11-RESTART "XIM did not start after actual X11 readiness"
    fi
    kill "$x11_pid"
    cstate 'all(.windows[]; .app_id != "XEyes")' "old X11 windows removed" 10 || fail G-X11-RESTART "stale X11 model survived server loss"
    cstate '.x11_ready' "bounded compatibility restart" 15 || fail G-X11-RESTART "server did not restart"
    [ "$(jq -c '[.windows[] | .id] | sort' "$CSTATE")" = "$native_ids" ] || fail G-X11-RESTART "native windows changed across restart"
    restarted_pid="$(pgrep -P "$COMPOSITOR_PID" -x Xwayland)"
    [ "$restarted_pid" != "$x11_pid" ] || fail G-X11-RESTART "old compatibility process remained"
    if [ -n "$old_xim_pid" ]; then
        for _ in $(seq 1 30); do
            new_xim_pid="$(pgrep -P "$COMPOSITOR_PID" -x ibus-x11 || true)"
            [ -n "$new_xim_pid" ] && [ "$new_xim_pid" != "$old_xim_pid" ] && break
            sleep 0.2
        done
        if [ -z "$new_xim_pid" ] || [ "$new_xim_pid" = "$old_xim_pid" ]; then
            fail G-X11-RESTART "XIM helper did not restart for the fresh X11 server"
        fi
        ! kill -0 "$old_xim_pid" 2>/dev/null || fail G-X11-RESTART "old XIM helper survived server loss"
    fi
    env DISPLAY="$x11_display" xeyes >/dev/null 2>&1 &
    cstate '.focused_app_id == "XEyes" and .x11_ready' "reconnected X11 client" 15 || fail G-X11-RESTART "client did not reconnect on the same reserved display"
    pass G-X11-RESTART "server loss removes compatibility windows, preserves native IDs and accepts a new client on the same display"
    pass G-X11-APP "the first X11 app launched from search gets DISPLAY $x11_display and maps"
    # An app without a matching desktop file supplies its window icon.
    x11_window="$(DISPLAY="$x11_display" xdotool search --class XEyes | head -1)"
    DISPLAY="$x11_display" xprop -id "$x11_window" -f _NET_WM_ICON 32c -set _NET_WM_ICON '2,2,4293935280,4280340624,4280340624,4293935280'
    cstate '.windows[] | select(.app_id == "XEyes") | .icon != null' "X11 icon" || fail G-WINDOW-ICONS "X11 icon never reached model"
    x11_icon="$(jq -r '.windows[] | select(.app_id == "XEyes") | .icon' "$CSTATE")"
    [ -s "$x11_icon" ] || fail G-WINDOW-ICONS "X11 icon cache missing"
    cp "$x11_icon" "$ARTIFACTS/x11-window-icon.png"
    # Change the actual mapped X11 client's EWMH role, rather than testing
    # only synthetic snapshot flags. The same live policy feeds GetWindows.
    x11_model_id="$(jq -r '.windows[] | select(.app_id == "XEyes") | .id' "$CSTATE")"
    while read -r x11_kind x11_pickable; do
        DISPLAY="$x11_display" xprop -id "$x11_window" -f _NET_WM_WINDOW_TYPE 32a \
            -set _NET_WM_WINDOW_TYPE "_NET_WM_WINDOW_TYPE_$x11_kind"
        cstate ".windows[] | select(.id == $x11_model_id) | .introspect_eligible == $x11_pickable" \
            "X11 $x11_kind picker eligibility" ||
            fail G-INTROSPECT-TYPES "actual X11 $x11_kind role did not yield $x11_pickable"
        cp "$CSTATE" "$ARTIFACTS/introspect-type-$x11_kind.json"
    done <<EOF
NORMAL true
DIALOG true
UTILITY true
DESKTOP false
DOCK false
COMBO false
DND false
DROPDOWN_MENU false
MENU false
NOTIFICATION false
POPUP_MENU false
SPLASH false
TOOLBAR false
TOOLTIP false
EOF
    DISPLAY="$x11_display" xprop -id "$x11_window" -remove _NET_WM_WINDOW_TYPE
    cstate ".windows[] | select(.id == $x11_model_id) | .introspect_eligible" \
        "X11 absent type is normal" || fail G-INTROSPECT-TYPES "absent type did not restore eligibility"
    cp "$CSTATE" "$ARTIFACTS/introspect-type-absent.json"
    pass G-INTROSPECT-TYPES "actual mapped X11 role changes follow all fourteen EWMH types and restore the absent-type default"
    DISPLAY="$x11_display" "$COMPANIONS/icon-probe" --x11-hints >"$ARTIFACTS/hints-probe.log" 2>&1 &
    HINTS_PID=$!
    cstate '.windows[] | select(.app_id == "TunaHintsProbe") | .icon != null' "WM_HINTS icon" || fail G-WINDOW-ICONS "legacy pixmap icon never reached model"
    hints_icon="$(jq -r '.windows[] | select(.app_id == "TunaHintsProbe") | .icon' "$CSTATE")"
    [ -s "$hints_icon" ] || fail G-WINDOW-ICONS "WM_HINTS icon cache missing"
    cp "$hints_icon" "$ARTIFACTS/wm-hints-window-icon.png"
    # The X server's own input focus follows the focused X11 window (Mutter's
    # meta_x11_display_set_input_focus). Left PointerRoot, keys reach
    # whichever X11 window lies under the X pointer instead. xeyes asks for
    # no input (WM_HINTS input False, no WM_TAKE_FOCUS), so like Mutter Tuna
    # never gives it X focus; xev sets no WM_HINTS, ICCCM's Passive default.
    x11_before="$(jq -c '[.windows[] | .id]' "$CSTATE")"
    DISPLAY="$x11_display" xev >/dev/null 2>&1 &
    XEV_PID=$!
    cstate ".focused != null and (.focused as \$f | $x11_before | index(\$f) == null)" "xev focused" ||
        fail G-X11-INPUT-FOCUS "xev never took model focus"
    xev_window="$(DISPLAY="$x11_display" xdotool search --name '^Event Tester$' | head -1)"
    x_focus=""
    for _ in $(seq 1 25); do
        x_focus="$(DISPLAY="$x11_display" xdotool getwindowfocus 2>/dev/null || true)"
        [ -n "$xev_window" ] && [ "$x_focus" = "$xev_window" ] && break
        sleep 0.2
    done
    if [ -z "$xev_window" ] || [ "$x_focus" != "$xev_window" ]; then
        fail G-X11-INPUT-FOCUS "X input focus is '$x_focus', not the focused X11 window '$xev_window'"
    fi
    kill "$XEV_PID" 2>/dev/null || true
    pass G-X11-INPUT-FOCUS "X input focus is the focused X11 window $xev_window"
else
    echo "tuna-gtk-shell-proof: G-X11-APP skipped (no Xwayland or xeyes)"
fi

# Raw Wayland SHM icon: GTK versions on the runner need not implement the new protocol.
WAYLAND_DISPLAY="$SOCKET_NAME" "$COMPANIONS/icon-probe" >"$ARTIFACTS/icon-probe.log" 2>&1 &
ICON_PID=$!
cstate '.windows[] | select(.app_id == "tuna-window-icon-probe") | .icon != null' "Wayland icon" || fail G-WINDOW-ICONS "Wayland icon never reached model"
native_icon="$(jq -r '.windows[] | select(.app_id == "tuna-window-icon-probe") | .icon' "$CSTATE")"
[ -s "$native_icon" ] || fail G-WINDOW-ICONS "Wayland icon cache missing"
cp "$native_icon" "$ARTIFACTS/wayland-window-icon.png"
xdotool key Super_L
cstate '.overview_open' "icon overview" || fail G-WINDOW-ICONS "overview did not open"
sleep 1
scrot "$ARTIFACTS/20a-window-icons-overview.png" >/dev/null
cp "$CSTATE" "$ARTIFACTS/window-icons-state.json"
xdotool key Escape
cstate '.overview_open == false' "icon overview closed" || fail G-WINDOW-ICONS "overview did not close"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "icon switcher" || fail G-WINDOW-ICONS "switcher did not open"
sleep 1
scrot "$ARTIFACTS/20b-window-icons-switcher.png" >/dev/null
"$PY" - "$ARTIFACTS/20a-window-icons-overview.png" "$ARTIFACTS/20b-window-icons-switcher.png" <<'PYICON'
from PIL import Image
import sys
for path in sys.argv[1:]:
    pixels = Image.open(path).convert("RGB").getdata()
    # The native probe has a distinctive magenta quadrant absent from its client.
    magenta = sum(r > 200 and 35 < g < 110 and 120 < b < 220 for r, g, b in pixels)
    if magenta < 16:
        raise SystemExit(path + ": native window icon pixels missing")
PYICON
xdotool keyup Alt_L
kill "$ICON_PID" 2>/dev/null || true
ICON_PID=""
if [ -n "$HINTS_PID" ]; then kill "$HINTS_PID" 2>/dev/null || true; fi
HINTS_PID=""
pass G-WINDOW-ICONS "native SHM and X11 window icons reach PNG cache, overview chrome/dash and switcher"

# GNOME's clock keys reach the panel clock within its 1 s tick.
gsettings set org.gnome.desktop.interface clock-show-seconds true
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-clock.json" 20 ||
    fail G-SETTINGS-CLOCK "accessibility dump failed"
jq -e 'any(.[]; .role == "label" and (.name | test("[0-9]+:[0-9]{2}:[0-9]{2}")))' \
    "$ARTIFACTS/a11y-clock.json" >/dev/null ||
    fail G-SETTINGS-CLOCK "clock-show-seconds did not add seconds to the panel clock"
gsettings set org.gnome.desktop.interface clock-show-seconds false
pass G-SETTINGS-CLOCK "GNOME's clock-show-seconds changes the panel clock"

# CSS inherits GNOME's user font; text scale reaches GTK's Wayland settings.
original_font="$(gsettings get org.gnome.desktop.interface font-name)"
original_scale="$(gsettings get org.gnome.desktop.interface text-scaling-factor)"
gsettings set org.gnome.desktop.interface font-name 'Sans 11'
gsettings set org.gnome.desktop.interface text-scaling-factor 1.0
sleep 1
scrot "$ARTIFACTS/settings-font-before.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Monospace 20'
sleep 1
scrot "$ARTIFACTS/settings-font-after.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Monospace Bold Italic Condensed 20'
sleep 1
scrot "$ARTIFACTS/settings-font-styled.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Sans 11'
gsettings set org.gnome.desktop.interface text-scaling-factor 1.75
sleep 1
scrot "$ARTIFACTS/settings-scale-after.png" >/dev/null
"$PY" - "$ARTIFACTS" <<'PYFONT' || fail G-SETTINGS-FONT "font or text scale did not change the live panel"
from PIL import Image, ImageChops
import sys
from pathlib import Path
root = Path(sys.argv[1])
before = Image.open(root / "settings-font-before.png").convert("RGB").crop((500, 0, 780, 32))
for name in ["settings-font-after.png", "settings-scale-after.png"]:
    after = Image.open(root / name).convert("RGB").crop((500, 0, 780, 32))
    hist = ImageChops.difference(before, after).convert("L").histogram()
    changed = sum(hist[25:]) / (280 * 32)
    assert changed > 0.03, (name, changed)
# Same family and size: this change must come from the selected font's style.
plain = Image.open(root / "settings-font-after.png").convert("RGB").crop((500, 0, 780, 32))
styled = Image.open(root / "settings-font-styled.png").convert("RGB").crop((500, 0, 780, 32))
hist = ImageChops.difference(plain, styled).convert("L").histogram()
changed = sum(hist[25:]) / (280 * 32)
assert changed > 0.01, ("styled font", changed)
print(f"styled font changed {changed:.3%} of panel pixels")
PYFONT
gsettings set org.gnome.desktop.interface font-name "$original_font"
gsettings set org.gnome.desktop.interface text-scaling-factor "$original_scale"
sleep 1
pass G-SETTINGS-FONT "font-name family/size/style and text-scaling-factor change the running panel"

# P-ST-01 (#594): GNOME Settings' wallpaper write reaches the running
# desktop live. The shell publishes the drop file, the compositor
# records the file's identity and decoded pixels, and the desktop
# visibly repaints. Re-setting the same URI is idempotent (no
# restart); replacing the file refreshes without a URI change; an
# invalid URI is ignored without a crash. Restart persistence is
# covered by cargo:wallpaper_survives_session_restart.
set_wallpaper_before_uri=$(gsettings get org.gnome.desktop.background picture-uri)
set_wallpaper_before_dark=$(gsettings get org.gnome.desktop.background picture-uri-dark)
set_wallpaper_before_options=$(gsettings get org.gnome.desktop.background picture-options)
set_wallpaper_green="$ARTIFACTS/set-wallpaper-green.png"
ffmpeg -loglevel error -y -f lavfi -i color=c=0x00ff00:s=64x64 -frames:v 1 -threads 1 "$set_wallpaper_green"
set_wallpaper_uri=$("$PY" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().as_uri())' "$set_wallpaper_green")
printf '%s\n' "$set_wallpaper_uri" >"$ARTIFACTS/set-wallpaper-uri.txt"
gsettings set org.gnome.desktop.background picture-options zoom
gsettings set org.gnome.desktop.background picture-uri "$set_wallpaper_uri"
gsettings set org.gnome.desktop.background picture-uri-dark "$set_wallpaper_uri"
set_wallpaper_end=$(($(date +%s) + 15))
while :; do
    set_wallpaper_drop_first=$(sed -n '1p' "$XDG_RUNTIME_DIR/tuna-wallpaper" 2>/dev/null || true)
    [ "$set_wallpaper_drop_first" = "$set_wallpaper_uri" ] && break
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "shell did not publish $set_wallpaper_uri to the wallpaper drop file (got '$set_wallpaper_drop_first')"
    sleep 0.3
done
set_wallpaper_end=$(($(date +%s) + 20))
while :; do
    "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" wallpaper-check "$CSTATE" \
        --uri "$set_wallpaper_uri" --identity file --decoded \
        >"$ARTIFACTS/set-wallpaper-check.txt" 2>&1 && break
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "compositor never tracked the wallpaper: $(cat "$ARTIFACTS/set-wallpaper-check.txt")"
    sleep 0.3
done
set_wallpaper_sample=$("$PY" "$ROOT/scripts/lib/tuna-set-gates.py" desktop-pixel "$CSTATE" --width "$WIDTH" --height "$HEIGHT") ||
    fail G-SET-WALLPAPER "no desktop pixel outside every window to sample"
# shellcheck disable=SC2086
set -- $set_wallpaper_sample
set_wallpaper_x=$1
set_wallpaper_y=$2
set_wallpaper_end=$(($(date +%s) + 15))
while :; do
    scrot -o "$ARTIFACTS/set-wallpaper-shot-green.png" >/dev/null
    set_wallpaper_rgb=$(px "$ARTIFACTS/set-wallpaper-shot-green.png" "$set_wallpaper_x" "$set_wallpaper_y")
    # shellcheck disable=SC2086
    set -- $set_wallpaper_rgb
    if [ "${1:-255}" -lt 20 ] && [ "${2:-0}" -gt 220 ] && [ "${3:-255}" -lt 20 ]; then break; fi
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "wallpaper write did not paint green at $set_wallpaper_x,$set_wallpaper_y: $set_wallpaper_rgb"
    sleep 0.3
done
# Idempotent: writing the same URI again changes nothing observable.
gsettings set org.gnome.desktop.background picture-uri "$set_wallpaper_uri"
sleep 1
[ "$(sed -n '1p' "$XDG_RUNTIME_DIR/tuna-wallpaper")" = "$set_wallpaper_uri" ] ||
    fail G-SET-WALLPAPER "re-setting the same wallpaper URI moved the drop file"
scrot -o "$ARTIFACTS/set-wallpaper-shot-green-again.png" >/dev/null
set_wallpaper_rgb=$(px "$ARTIFACTS/set-wallpaper-shot-green-again.png" "$set_wallpaper_x" "$set_wallpaper_y")
# shellcheck disable=SC2086
set -- $set_wallpaper_rgb
if [ "${1:-255}" -ge 20 ] || [ "${2:-0}" -le 220 ] || [ "${3:-255}" -ge 20 ]; then
    fail G-SET-WALLPAPER "re-setting the same wallpaper URI lost the green desktop: $set_wallpaper_rgb"
fi
# Refresh: replacing the file repaints without a URI change.
ffmpeg -loglevel error -y -f lavfi -i color=c=0xff00ff:s=64x64 -frames:v 1 -threads 1 "$set_wallpaper_green"
set_wallpaper_end=$(($(date +%s) + 20))
while :; do
    scrot -o "$ARTIFACTS/set-wallpaper-shot-magenta.png" >/dev/null
    set_wallpaper_rgb=$(px "$ARTIFACTS/set-wallpaper-shot-magenta.png" "$set_wallpaper_x" "$set_wallpaper_y")
    # shellcheck disable=SC2086
    set -- $set_wallpaper_rgb
    if [ "${1:-0}" -gt 220 ] && [ "${2:-255}" -lt 20 ] && [ "${3:-0}" -gt 220 ]; then break; fi
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "replacing the wallpaper file did not repaint magenta: $set_wallpaper_rgb"
    sleep 0.3
done
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" wallpaper-check "$CSTATE" \
    --uri "$set_wallpaper_uri" --identity file --decoded ||
    fail G-SET-WALLPAPER "compositor lost the replaced wallpaper"
# Negative control: a non-file URI is ignored as an image (identity
# None, solid fallback) without crashing the shell or compositor.
gsettings set org.gnome.desktop.background picture-uri 'http://example.invalid/set-wallpaper.png'
gsettings set org.gnome.desktop.background picture-uri-dark 'http://example.invalid/set-wallpaper.png'
sleep 2
kill -0 "$COMPOSITOR_PID" 2>/dev/null || fail G-SET-WALLPAPER "invalid wallpaper URI killed the compositor"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-wallpaper-invalid.json" 20 ||
    fail G-SET-WALLPAPER "shell stopped answering after an invalid wallpaper URI"
set_wallpaper_end=$(($(date +%s) + 15))
while :; do
    "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" wallpaper-check "$CSTATE" \
        --uri 'http://example.invalid/set-wallpaper.png' --identity none \
        >"$ARTIFACTS/set-wallpaper-invalid-check.txt" 2>&1 && break
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "invalid URI was not ignored: $(cat "$ARTIFACTS/set-wallpaper-invalid-check.txt")"
    sleep 0.3
done
scrot -o "$ARTIFACTS/set-wallpaper-shot-invalid.png" >/dev/null
set_wallpaper_rgb=$(px "$ARTIFACTS/set-wallpaper-shot-invalid.png" "$set_wallpaper_x" "$set_wallpaper_y")
# shellcheck disable=SC2086
set -- $set_wallpaper_rgb
if [ "${1:-0}" -gt 220 ] && [ "${2:-255}" -lt 20 ] && [ "${3:-0}" -gt 220 ]; then
    fail G-SET-WALLPAPER "invalid wallpaper URI kept the magenta image: $set_wallpaper_rgb"
fi
gsettings set org.gnome.desktop.background picture-uri "$set_wallpaper_before_uri"
gsettings set org.gnome.desktop.background picture-uri-dark "$set_wallpaper_before_dark"
gsettings set org.gnome.desktop.background picture-options "$set_wallpaper_before_options"
# The shell publishes the dark URI under the dark style, nothing when
# picture-options is "none": expect exactly what it must publish. The
# pre-proof file may not exist on the runner, so the revert asserts the
# shell's publication (already proved end to end above), not a decode.
set_wallpaper_scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "'default'")
set_wallpaper_before_bare=$(printf '%s' "$set_wallpaper_before_uri" | sed "s/^'//; s/'$//")
set_wallpaper_before_dark_bare=$(printf '%s' "$set_wallpaper_before_dark" | sed "s/^'//; s/'$//")
set_wallpaper_expect_revert="$set_wallpaper_before_bare"
if [ "$set_wallpaper_scheme" = "'prefer-dark'" ] && [ -n "$set_wallpaper_before_dark_bare" ]; then
    set_wallpaper_expect_revert="$set_wallpaper_before_dark_bare"
fi
if [ "$set_wallpaper_before_options" = "'none'" ]; then
    set_wallpaper_expect_revert=""
fi
set_wallpaper_end=$(($(date +%s) + 15))
while :; do
    set_wallpaper_drop_first=$(sed -n '1p' "$XDG_RUNTIME_DIR/tuna-wallpaper" 2>/dev/null || true)
    [ "$set_wallpaper_drop_first" = "$set_wallpaper_expect_revert" ] && break
    [ "$(date +%s)" -ge "$set_wallpaper_end" ] && fail G-SET-WALLPAPER "revert did not restore the drop file (got '$set_wallpaper_drop_first')"
    sleep 0.3
done
sleep 1
scrot -o "$ARTIFACTS/set-wallpaper-shot-reverted.png" >/dev/null
cp "$CSTATE" "$ARTIFACTS/set-wallpaper-reverted-state.json"
pass G-SET-WALLPAPER "picture-uri writes publish, identify, decode and visibly repaint; replacement refreshes, an invalid URI is ignored, and revert restores"

# P-ST-01 (#594): clock-format and clock-show-date reach the panel clock
# live. The shell re-reads them every second, so no restart is needed
# and re-setting the same values is idempotent. Seconds are covered by
# G-SETTINGS-CLOCK; the weekday key shares this date code path.
set_clock_before_format=$(gsettings get org.gnome.desktop.interface clock-format)
set_clock_before_date=$(gsettings get org.gnome.desktop.interface clock-show-date)
set_clock_before_weekday=$(gsettings get org.gnome.desktop.interface clock-show-weekday)
set_clock_before_seconds=$(gsettings get org.gnome.desktop.interface clock-show-seconds)
gsettings set org.gnome.desktop.interface clock-show-weekday false
gsettings set org.gnome.desktop.interface clock-show-date false
gsettings set org.gnome.desktop.interface clock-show-seconds false
gsettings set org.gnome.desktop.interface clock-format '12h'
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-clock-12h.json" 20 ||
    fail G-SET-CLOCK "accessibility dump failed"
scrot "$ARTIFACTS/set-clock-12h.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" clock-check "$ARTIFACTS/a11y-set-clock-12h.json" --format 12h --date off ||
    fail G-SET-CLOCK "clock-format 12h without date did not reach the panel clock"
gsettings set org.gnome.desktop.interface clock-show-date true
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-clock-date.json" 20 ||
    fail G-SET-CLOCK "accessibility dump failed"
scrot "$ARTIFACTS/set-clock-date.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" clock-check "$ARTIFACTS/a11y-set-clock-date.json" --format 12h --date on ||
    fail G-SET-CLOCK "clock-show-date did not add the date to the panel clock"
# Negative control: an invalid format is rejected by the schema (or
# falls back to 24h where the schema allows it) without breaking the clock.
if gsettings set org.gnome.desktop.interface clock-format 'bogus' 2>"$ARTIFACTS/set-clock-invalid.err"; then
    sleep 2
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-clock-invalid.json" 20 ||
        fail G-SET-CLOCK "accessibility dump failed"
    scrot "$ARTIFACTS/set-clock-invalid.png" >/dev/null
    "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" clock-check "$ARTIFACTS/a11y-set-clock-invalid.json" --format 24h --date on ||
        fail G-SET-CLOCK "invalid clock-format did not fall back to a 24h clock"
else
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-clock-invalid.json" 20 ||
        fail G-SET-CLOCK "accessibility dump failed"
    scrot "$ARTIFACTS/set-clock-invalid.png" >/dev/null
    "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" clock-check "$ARTIFACTS/a11y-set-clock-invalid.json" --format 12h --date on ||
        fail G-SET-CLOCK "rejected clock-format changed the panel clock"
fi
gsettings set org.gnome.desktop.interface clock-format "$set_clock_before_format"
gsettings set org.gnome.desktop.interface clock-show-date "$set_clock_before_date"
gsettings set org.gnome.desktop.interface clock-show-weekday "$set_clock_before_weekday"
gsettings set org.gnome.desktop.interface clock-show-seconds "$set_clock_before_seconds"
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-set-clock-reverted.json" 20 ||
    fail G-SET-CLOCK "accessibility dump failed"
scrot "$ARTIFACTS/set-clock-reverted.png" >/dev/null
set_clock_expect_format=24h
case "$set_clock_before_format" in *12h*) set_clock_expect_format=12h ;; esac
set_clock_expect_date=off
case "$set_clock_before_date" in *true*) set_clock_expect_date=on ;; esac
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" clock-check "$ARTIFACTS/a11y-set-clock-reverted.json" --format "$set_clock_expect_format" --date "$set_clock_expect_date" ||
    fail G-SET-CLOCK "revert did not restore clock-format $set_clock_before_format / clock-show-date $set_clock_before_date"
pass G-SET-CLOCK "clock-format and clock-show-date render live; an invalid format is rejected or falls back, and revert restores"

# P-ST-01 (#594): document and monospace fonts reach GTK apps live
# through the apps' own Gio.Settings reads, as gnome-terminal and
# gedit read them (GTK offers no Gtk.Settings properties for these
# keys; Tuna Desktop chrome keeps using font-name). No restart is
# needed and re-setting the same values is idempotent.
set_fonts_before_doc=$(gsettings get org.gnome.desktop.interface document-font-name)
set_fonts_before_mono=$(gsettings get org.gnome.desktop.interface monospace-font-name)
set_fonts_before_doc_bare=$(printf '%s' "$set_fonts_before_doc" | sed "s/^'//; s/'$//")
set_fonts_before_mono_bare=$(printf '%s' "$set_fonts_before_mono" | sed "s/^'//; s/'$//")
set_fonts_count="$(jq '.windows | length' "$CSTATE")"
SET_FONTS_JSON="$ARTIFACTS/set-fonts-fixture.json"
rm -f "$SET_FONTS_JSON"
WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-set-font-fixture.py" "$SET_FONTS_JSON" >"$ARTIFACTS/set-fonts-fixture.log" 2>&1 &
SET_FONTS_PID=$!
cstate '.windows | any(.app_id == "tuna-set-fonts-fixture")' "fonts fixture mapped" ||
    { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "GTK font fixture never mapped"; }
sleep 1
scrot "$ARTIFACTS/set-fonts-before.png" >/dev/null
gsettings set org.gnome.desktop.interface document-font-name 'Serif 24'
gsettings set org.gnome.desktop.interface monospace-font-name 'Monospace 24'
set_fonts_end=$(($(date +%s) + 20))
while :; do
    if [ -s "$SET_FONTS_JSON" ]; then
        "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" fonts-check "$SET_FONTS_JSON" \
            --document 'Serif 24' --monospace 'Monospace 24' \
            >"$ARTIFACTS/set-fonts-check.txt" 2>&1 && break
    fi
    [ "$(date +%s)" -ge "$set_fonts_end" ] && { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "GTK app never observed the font keys: $(cat "$ARTIFACTS/set-fonts-check.txt" 2>/dev/null || echo 'no fixture report')"; }
    sleep 0.3
done
cp "$SET_FONTS_JSON" "$ARTIFACTS/set-fonts-after.json"
sleep 1
scrot "$ARTIFACTS/set-fonts-after.png" >/dev/null
set_fonts_rect="$(jq -r '.windows[] | select(.app_id == "tuna-set-fonts-fixture") | .rect | join(" ")' "$CSTATE")"
[ -n "$set_fonts_rect" ] ||
    { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "font fixture window has no rectangle to sample"; }
# shellcheck disable=SC2086
set -- $set_fonts_rect
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" pixel-diff "$ARTIFACTS/set-fonts-before.png" "$ARTIFACTS/set-fonts-after.png" \
    "$1" "$2" "$3" "$4" --min-fraction 0.02 ||
    { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "document/monospace change did not visibly repaint the GTK fixture"; }
# Idempotent: writing the same fonts again keeps the same app read.
gsettings set org.gnome.desktop.interface document-font-name 'Serif 24'
gsettings set org.gnome.desktop.interface monospace-font-name 'Monospace 24'
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" fonts-check "$SET_FONTS_JSON" \
    --document 'Serif 24' --monospace 'Monospace 24' ||
    { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "re-setting the same fonts lost the app's font read"; }
# Negative control: a bogus family falls back in Pango without killing
# the app or its font read.
gsettings set org.gnome.desktop.interface document-font-name 'NoSuchFontXYZ 24'
sleep 1
kill -0 "$SET_FONTS_PID" 2>/dev/null || fail G-SET-FONTS "bogus document font killed the GTK fixture"
cstate '.windows | any(.app_id == "tuna-set-fonts-fixture")' "fixture survives bogus font" ||
    fail G-SET-FONTS "bogus document font unmapped the GTK fixture"
scrot "$ARTIFACTS/set-fonts-invalid.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-set-gates.py" fonts-check "$SET_FONTS_JSON" \
    --document 'NoSuchFontXYZ 24' --monospace 'Monospace 24' ||
    fail G-SET-FONTS "bogus document font broke the app's font read"
gsettings set org.gnome.desktop.interface document-font-name "$set_fonts_before_doc"
gsettings set org.gnome.desktop.interface monospace-font-name "$set_fonts_before_mono"
set_fonts_end=$(($(date +%s) + 20))
while :; do
    if [ -s "$SET_FONTS_JSON" ]; then
        "$PY" "$ROOT/scripts/lib/tuna-set-gates.py" fonts-check "$SET_FONTS_JSON" \
            --document "$set_fonts_before_doc_bare" --monospace "$set_fonts_before_mono_bare" \
            >"$ARTIFACTS/set-fonts-revert-check.txt" 2>&1 && break
    fi
    [ "$(date +%s)" -ge "$set_fonts_end" ] && { kill "$SET_FONTS_PID" 2>/dev/null || true; SET_FONTS_PID=""; fail G-SET-FONTS "revert never reached the GTK app: $(cat "$ARTIFACTS/set-fonts-revert-check.txt" 2>/dev/null || echo 'no fixture report')"; }
    sleep 0.3
done
sleep 1
scrot "$ARTIFACTS/set-fonts-reverted.png" >/dev/null
kill "$SET_FONTS_PID" 2>/dev/null || true
SET_FONTS_PID=""
cstate ".windows | length == $set_fonts_count" "fonts fixture removed" ||
    fail G-SET-FONTS "font fixture window did not unmap"
pass G-SET-FONTS "document/monospace fonts reach GTK apps live with a visible repaint; a bogus family falls back, and revert restores"

# GNOME's input settings (#60).
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'de')]"
cstate '.keyboard.layouts == ["English (US)", "German"]' "two sources" ||
    fail G-SETTINGS-INPUT "input sources did not become the keymap"
xdotool key super+space
cstate '.keyboard.layout == "German"' "next source" ||
    fail G-SETTINGS-INPUT "Super+Space did not switch to the next input source"

# GNOME's input-source policy (#346, keyboard.js InputSourceManager). The
# quick tap above picked the second most recent source and saved the order.
mru_wait() {
    end=$(($(date +%s) + 10))
    until [ "$(gsettings get org.gnome.desktop.input-sources mru-sources)" = "$1" ] ||
        [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(gsettings get org.gnome.desktop.input-sources mru-sources)" = "$1" ]
}
mru_wait "[('xkb', 'de'), ('xkb', 'us')]" ||
    fail G-INPUT-SOURCE-MRU "the switch did not save mru-sources: $(gsettings get org.gnome.desktop.input-sources mru-sources)"
# A third source joins after the remembered order; the front stays active.
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'de'), ('xkb', 'fr')]"
cstate '.keyboard.layouts == ["English (US)", "German", "French"] and .keyboard.layout == "German"' "three sources" ||
    fail G-INPUT-SOURCE-MRU "a new source list did not keep the most recent source active"
# Taps flip between the two most recent sources; position order would
# have reached French.
xdotool key super+space
cstate '.keyboard.layout == "English (US)"' "tap to the previous source" ||
    fail G-INPUT-SOURCE-MRU "Super+Space did not pick the second most recent source"
xdotool key super+space
cstate '.keyboard.layout == "German"' "tap back" ||
    fail G-INPUT-SOURCE-MRU "a second tap did not flip back"
# A tap whose popup takes the keyboard only after Super is up, as on a
# loaded runner (runs 40842699440 and 40846223707 left it open): the
# shell stays stopped until the compositor has seen the release. GNOME
# checks the modifiers when its grab lands, on every show, and picks.
mru_shell="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk)" ||
    fail G-INPUT-SOURCE-MRU "expected exactly one owned shell"
case "$mru_shell" in ''|*[!0-9]*) fail G-INPUT-SOURCE-MRU "expected exactly one owned shell" ;; esac
for mru_expected in "English (US)" "German"; do
    mru_releases="$(grep -c 'modifier super keycode=[0-9]* pressed=false' "$LOG")"
    kill -STOP "$mru_shell"
    xdotool key super+space
    end=$(($(date +%s) + 10))
    until [ "$(grep -c 'modifier super keycode=[0-9]* pressed=false' "$LOG")" -gt "$mru_releases" ] ||
        [ "$(date +%s)" -gt "$end" ]; do sleep 0.1; done
    kill -CONT "$mru_shell"
    [ "$(grep -c 'modifier super keycode=[0-9]* pressed=false' "$LOG")" -gt "$mru_releases" ] ||
        fail G-INPUT-SOURCE-MRU "the compositor never saw Super released"
    cstate ".keyboard.layout == \"$mru_expected\"" "late-grab tap to $mru_expected" ||
        fail G-INPUT-SOURCE-MRU "a tap released before the switcher held the keyboard did not pick $mru_expected"
done
# Held: the popup lists the sources most recent first; a second press
# steps to the third, releasing Super picks it.
xdotool keydown Super_L
xdotool key space
sleep 0.4
xdotool key space
sleep 0.4
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-input-source-popup.json" 20 ||
    { xdotool keyup Super_L; fail G-INPUT-SOURCE-MRU "accessibility dump failed"; }
scrot "$ARTIFACTS/input-source-popup.png" >/dev/null
xdotool keyup Super_L
for name in "German" "English (US)" "French"; do
    showing "$ARTIFACTS/a11y-input-source-popup.json" "$name" ||
        fail G-INPUT-SOURCE-MRU "the held switcher did not list $name"
done
cstate '.keyboard.layout == "French"' "held switch" ||
    fail G-INPUT-SOURCE-MRU "releasing Super did not pick the stepped-to source"
mru_wait "[('xkb', 'fr'), ('xkb', 'de'), ('xkb', 'us')]" ||
    fail G-INPUT-SOURCE-MRU "the held switch did not save mru-sources"
sleep 0.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-input-source-popup-closed.json" 20 ||
    fail G-INPUT-SOURCE-MRU "accessibility dump failed"
hidden "$ARTIFACTS/a11y-input-source-popup-closed.json" "French" ||
    fail G-INPUT-SOURCE-MRU "the switcher stayed open after Super was released"
pass G-INPUT-SOURCE-MRU "Super+Space flips between the two most recent sources, the held popup steps through the MRU list, and mru-sources keeps the order across source changes"

# per-window: each window keeps its own source; a window seen for the
# first time starts on the first one.
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'de')]"
cstate '.keyboard.layouts == ["English (US)", "German"]' "two sources again" ||
    fail G-INPUT-PER-WINDOW "the source list did not return to two"
[ "$(jq '.windows | length' "$CSTATE")" -ge 2 ] ||
    fail G-INPUT-PER-WINDOW "the per-window check needs two windows"
gsettings set org.gnome.desktop.input-sources per-window true
sleep 1
window_a="$(jq '.focused' "$CSTATE")"
[ "$window_a" != null ] || fail G-INPUT-PER-WINDOW "no window has the focus"
# A window remembers what is activated in it while per-window is on.
cstate '.keyboard.layout == "German"' "German before per-window" ||
    fail G-INPUT-PER-WINDOW "the two-source list did not keep German active"
xdotool key super+space
cstate '.keyboard.layout == "English (US)"' "window A tap" ||
    fail G-INPUT-PER-WINDOW "Super+Space did not switch in window A"
xdotool key super+space
cstate '.keyboard.layout == "German"' "window A on German" ||
    fail G-INPUT-PER-WINDOW "window A did not switch back to German"
xdotool key alt+Tab
cstate ".focused != $window_a and .focused != null" "window B focused" ||
    fail G-INPUT-PER-WINDOW "Alt+Tab did not focus another window"
window_b="$(jq '.focused' "$CSTATE")"
cstate '.keyboard.layout == "English (US)"' "window B starts on the first source" ||
    fail G-INPUT-PER-WINDOW "a newly focused window did not start on the first source"
xdotool key alt+Tab
cstate ".focused == $window_a and .keyboard.layout == \"German\"" "window A restored" ||
    fail G-INPUT-PER-WINDOW "refocusing window A did not restore German"
xdotool key alt+Tab
cstate ".focused == $window_b and .keyboard.layout == \"English (US)\"" "window B restored" ||
    fail G-INPUT-PER-WINDOW "refocusing window B did not restore English (US)"
gsettings set org.gnome.desktop.input-sources per-window false
xdotool key alt+Tab
cstate ".focused == $window_a" "window A again" ||
    fail G-INPUT-PER-WINDOW "Alt+Tab did not return to window A"
sleep 1
jq -e '.keyboard.layout == "English (US)"' "$CSTATE" >/dev/null ||
    fail G-INPUT-PER-WINDOW "with per-window off the focus change still switched sources"
pass G-INPUT-PER-WINDOW "with per-window each window restores its own source on focus, new windows start on the first, and turning it off stops following the focus"

# Remembered Num Lock (mutter's maybe_save_numlock_state): every change is
# saved while remember-numlock-state is set, nothing is saved without it,
# and a keymap reload keeps the lock.
numlock_wait() {
    end=$(($(date +%s) + 10))
    until [ "$(gsettings get org.gnome.desktop.peripherals.keyboard numlock-state)" = "$1" ] ||
        [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(gsettings get org.gnome.desktop.peripherals.keyboard numlock-state)" = "$1" ]
}
gsettings set org.gnome.desktop.peripherals.keyboard remember-numlock-state true
numlock_before="$(jq '.keyboard.num_lock' "$CSTATE")"
if [ "$numlock_before" = true ]; then
    xdotool key Num_Lock
    cstate '.keyboard.num_lock == false' "Num Lock off" || fail G-NUMLOCK "Num Lock did not turn off"
fi
xdotool key Num_Lock
cstate '.keyboard.num_lock == true' "Num Lock on" || fail G-NUMLOCK "Num_Lock did not lock Num Lock"
numlock_wait true || fail G-NUMLOCK "the compositor did not save numlock-state true"
# Wait for each reload to land: a keymap applied between a lock key's
# press and its release keeps the lock (Num Lock unlocks on release), so
# a Num_Lock typed while the reset is still in flight can be lost.
keymap_generation="$(jq '.keyboard.keymap_generation' "$CSTATE")"
gsettings set org.gnome.desktop.input-sources xkb-options "['compose:ralt']"
cstate ".keyboard.keymap_generation > $keymap_generation and .keyboard.num_lock == true and .keyboard.layout == \"English (US)\"" "reload keeps Num Lock" ||
    fail G-NUMLOCK "a keymap reload dropped Num Lock or the active source"
keymap_generation="$(jq '.keyboard.keymap_generation' "$CSTATE")"
gsettings reset org.gnome.desktop.input-sources xkb-options
cstate ".keyboard.keymap_generation > $keymap_generation and .keyboard.num_lock == true" "reset reload keeps Num Lock" ||
    fail G-NUMLOCK "resetting xkb-options did not reload the keymap with Num Lock kept"
xdotool key Num_Lock
cstate '.keyboard.num_lock == false' "Num Lock off again" || fail G-NUMLOCK "Num_Lock did not unlock Num Lock"
numlock_wait false || fail G-NUMLOCK "the compositor did not save numlock-state false"
gsettings set org.gnome.desktop.peripherals.keyboard remember-numlock-state false
xdotool key Num_Lock
cstate '.keyboard.num_lock == true' "Num Lock on unremembered" || fail G-NUMLOCK "Num_Lock did not lock Num Lock"
sleep 2
[ "$(gsettings get org.gnome.desktop.peripherals.keyboard numlock-state)" = false ] ||
    fail G-NUMLOCK "numlock-state was saved with remember-numlock-state off"
xdotool key Num_Lock
cstate '.keyboard.num_lock == false' "Num Lock off unremembered" || fail G-NUMLOCK "Num_Lock did not unlock Num Lock"
gsettings reset org.gnome.desktop.peripherals.keyboard remember-numlock-state
gsettings reset org.gnome.desktop.peripherals.keyboard numlock-state
pass G-NUMLOCK "Num Lock changes save numlock-state only while remember-numlock-state is set, and a keymap reload keeps the lock and the active source"

# Back to the state G-SETTINGS-INPUT continues from: German active.
xdotool key super+space
cstate '.keyboard.layout == "German"' "German again" ||
    fail G-SETTINGS-INPUT "Super+Space did not return to German"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50
cstate '.keyboard.repeat_rate == 20' "repeat" ||
    fail G-SETTINGS-INPUT "repeat-interval 50 ms did not set 20 keys/s"
gsettings set org.gnome.desktop.interface enable-hot-corners false
sleep 1
xdotool mousemove --window "$WID" 1 1
sleep 1
xdotool mousemove --window "$WID" 0 0
sleep 1
if jq -e '.overview_open' "$CSTATE" >/dev/null; then
    fail G-SETTINGS-INPUT "the hot corner opened the overview with enable-hot-corners off"
fi
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
gsettings set org.gnome.desktop.interface enable-hot-corners true
sleep 1
ripples_started=$(tval hot_corner_ripples started)
ripples_frames=$(tval hot_corner_ripples animated_frames)
anim_clock 0
cstate '.animation_clock_manual' "frozen corner clock" ||
    fail G-HOT-CORNER-RIPPLES "the clock file did not freeze animation time"
xdotool mousemove --window "$WID" 1 1
cstate '.overview_open' "hot corner enabled" ||
    fail G-HOT-CORNER "enabling GNOME hot corners did not open the actual overview"
cp "$CSTATE" "$ARTIFACTS/hot-corner-enabled.json"
# The first ring starts at full opacity and is a quarter gone half way.
tvalue hot_corner_ripples 1 || fail G-HOT-CORNER-RIPPLES "the corner did not start GNOME's ripples"
anim_clock 415
tvalue hot_corner_ripples 0.75 || fail G-HOT-CORNER-RIPPLES "the first ring was not at ease-in-quad 75% half way"
scrot "$ARTIFACTS/hot-corner-ripples-415ms.png" >/dev/null
anim_clock 1350
tsettled hot_corner_ripples "$ripples_started" "$ripples_frames" ||
    fail G-HOT-CORNER-RIPPLES "the corner did not play GNOME's ripples to the end"
scrot "$ARTIFACTS/hot-corner-enabled.png" >/dev/null
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Escape
anim_clock 1700
cstate '.overview_open | not' "hot corner dismissed" ||
    fail G-HOT-CORNER "the corner-opened overview did not close"
real_clock || fail G-HOT-CORNER-RIPPLES "removing the clock file did not resume real time"
pass G-HOT-CORNER "live GNOME disable rejects the corner; enable opens the actual overview"
# Ripples are motion: Reduced Motion drops them, as does animations off.
for policy in reduce off; do
    if [ "$policy" = reduce ]; then
        gsettings set org.gnome.desktop.a11y.interface reduced-motion 'reduce'
        cstate '.motion_policy == "fade-only"' "reduced corner" ||
            fail G-HOT-CORNER-RIPPLES "Reduced Motion did not reach the compositor"
    else
        gsettings set org.gnome.desktop.interface enable-animations false
        cstate '.motion_policy == "off"' "still corner" ||
            fail G-HOT-CORNER-RIPPLES "enable-animations false did not reach the compositor"
    fi
    ripples_started=$(tval hot_corner_ripples started)
    xdotool mousemove --window "$WID" 1 1
    cstate ".overview_open and .transitions.hot_corner_ripples.started == $ripples_started" "corner without ripples ($policy)" ||
        fail G-HOT-CORNER-RIPPLES "the corner rippled under motion policy $policy"
    xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
    xdotool key Escape
    cstate '(.overview_open | not) and .overview_progress == 0' "corner dismissed ($policy)" ||
        fail G-HOT-CORNER-RIPPLES "the corner-opened overview did not close"
    gsettings reset org.gnome.desktop.a11y.interface reduced-motion
    gsettings set org.gnome.desktop.interface enable-animations true
    cstate '.motion_policy == "full"' "corner motion restored" ||
        fail G-HOT-CORNER-RIPPLES "the full motion policy did not return"
done
pass G-HOT-CORNER-RIPPLES "the hot corner plays GNOME's three ripples on the exact curve and settles; none under Reduced Motion or with animations off"

# GNOME's cursor theme, size and shapes are the compositor's to draw
# (#342). A proof theme inherits its cursors from a base theme, with
# 24px and 48px images, so the drawn buffer shows which size applied.
"$ROOT/scripts/tuna-cursor-client-build" "$ARTIFACTS/cursor-client" >"$ARTIFACTS/cursor-client-build.log" 2>&1 ||
    fail G-CURSOR-SIZE "the cursor probe did not build: $(tail -3 "$ARTIFACTS/cursor-client-build.log")"
"$PY" "$ROOT/scripts/lib/cursor-proof-theme.py" "$XDG_DATA_HOME/icons"
cursor_theme_before="$(gsettings get org.gnome.desktop.interface cursor-theme)"
cursor_size_before="$(gsettings get org.gnome.desktop.interface cursor-size)"
cursor_windows="$(jq '.windows | length' "$CSTATE")"
# cursor_probe MODE ARG: map the probe window and put the pointer on it.
cursor_probe() {
    [ -z "$CURSOR_PID" ] || { kill "$CURSOR_PID" 2>/dev/null || true; wait "$CURSOR_PID" 2>/dev/null || true; }
    cstate ".windows | length == $cursor_windows" "cursor probe gone" ||
        fail "$3" "the previous cursor probe did not close"
    xdotool mousemove --window "$WID" $((WIDTH / 2)) 16
    WAYLAND_DISPLAY="$SOCKET_NAME" "$ARTIFACTS/cursor-client/tuna-cursor-client" "$1" "$2" \
        >"$ARTIFACTS/cursor-probe-$1-$2.log" 2>&1 &
    CURSOR_PID=$!
    cstate 'any(.windows[]; .app_id == "tuna-cursor-probe")' "cursor probe mapped" ||
        fail "$3" "the cursor probe ($1 $2) did not map"
    probe_rect="$(jq -r '.windows[] | select(.app_id == "tuna-cursor-probe") | .rect | "\((.[0] + .[2] / 2) | floor) \((.[1] + .[3] / 2) | floor)"' "$CSTATE")"
    # shellcheck disable=SC2086 # two coordinates
    xdotool mousemove --window "$WID" $probe_rect
    for _ in $(seq 1 20); do
        grep -q enter "$ARTIFACTS/cursor-probe-$1-$2.log" && return 0
        xdotool mousemove_relative 1 0
        sleep 0.25
    done
    fail "$3" "the pointer never entered the cursor probe ($1 $2)"
}
cursor_probe shape default G-CURSOR-SIZE
gsettings set org.gnome.desktop.interface cursor-theme 'TunaProof'
gsettings set org.gnome.desktop.interface cursor-size 24
cstate '.cursor.theme == "TunaProof" and .cursor.size == 24 and .cursor.kind == "named" and .cursor.name == "default" and .cursor.source == "client" and .cursor.image_theme == "TunaProofBase" and .cursor.image == [24, 24] and .cursor.logical == [24, 24]' "theme cursor at 24px" ||
    fail G-CURSOR-SIZE "cursor-theme TunaProof at size 24 did not draw the inherited 24px image"
cp "$CSTATE" "$ARTIFACTS/cursor-size-24.json"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-size-24.png" 24 1 1 181,29,91 ||
    fail G-CURSOR-SIZE "the actual 24px legacy cursor pixels or hotspot differ"
gsettings set org.gnome.desktop.interface cursor-size 48
cstate '.cursor.size == 48 and .cursor.image_theme == "TunaProofBase" and .cursor.image == [48, 48] and .cursor.logical == [48, 48]' "theme cursor at 48px" ||
    fail G-CURSOR-SIZE "cursor-size 48 did not redraw the cursor from the 48px image live"
cp "$CSTATE" "$ARTIFACTS/cursor-size-48.json"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-size-48.png" 48 1 1 25,173,125 ||
    fail G-CURSOR-SIZE "the actual 48px legacy cursor pixels or hotspot differ"
# A live theme change must replace the buffer with GNOME51 SVG data,
# preserving its hotspot while rasterizing the requested physical size.
gsettings set org.gnome.desktop.interface cursor-theme TunaProofSvg
cstate '.cursor.image_theme == "TunaProofSvg" and .cursor.image == [48,48]' "48px scalable cursor" ||
    fail G-CURSOR-SIZE "the scalable theme did not replace the legacy image"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-svg-48.png" 48 8 12 49,95,199 ||
    fail G-CURSOR-SIZE "the actual 48px SVG pixels or scaled hotspot differ"
gsettings set org.gnome.desktop.interface cursor-size 24
cstate '.cursor.image_theme == "TunaProofSvg" and .cursor.image == [24,24]' "24px scalable cursor" ||
    fail G-CURSOR-SIZE "the scalable theme did not resize live"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-svg-24.png" 24 4 6 49,95,199 ||
    fail G-CURSOR-SIZE "the actual 24px SVG pixels or hotspot differ"
gsettings set org.gnome.desktop.interface cursor-theme TunaProof
pass G-CURSOR-SIZE "live cursor-theme (inherited) and cursor-size: 24px then 48px images drawn at 24 and 48 logical px"

gsettings set org.gnome.desktop.interface cursor-size 24
cursor_probe shape crosshair G-CURSOR-SHAPE
cstate '.cursor.kind == "named" and .cursor.name == "crosshair" and .cursor.source == "client" and .cursor.file == "crosshair" and .cursor.image_theme == "TunaProofBase" and .cursor.image == [24, 24]' "crosshair shape" ||
    fail G-CURSOR-SHAPE "a wp_cursor_shape_v1 crosshair request did not draw the theme's crosshair"
cp "$CSTATE" "$ARTIFACTS/cursor-shape-crosshair.json"
"$PY" "$ROOT/scripts/lib/cursor-pixels.py" "$ARTIFACTS/cursor-shape-crosshair.png" 24 1 1 181,29,91 ||
    fail G-CURSOR-SHAPE "the requested shape has incorrect actual legacy pixels"
# A shape the theme chain lacks still shows: from libXcursor's default
# and GNOME's Adwaita fallbacks when installed, else the theme's arrow.
cursor_probe shape pointer G-CURSOR-SHAPE
cstate '.cursor.kind == "named" and .cursor.name == "pointer" and (.cursor.file == "default" or (.cursor.image_theme | IN("default", "Adwaita", "hicolor")))' "missing shape" ||
    fail G-CURSOR-SHAPE "a shape missing from the theme did not fall back"
# After the initial pointer enter, both frames must actually paint with no
