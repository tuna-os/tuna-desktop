# Accessibility bus for GTK's AT-SPI backend.
if [ -x /usr/libexec/at-spi-bus-launcher ]; then
    /usr/libexec/at-spi-bus-launcher --launch-immediately >"$ARTIFACTS/atspi.log" 2>&1 &
    AT_SPI_PID=$!
    # Bind all GTK/pyatspi processes to this proof's private accessibility
    # bus, rather than rediscovering a shared runtime bus for each dump.
    AT_SPI_BUS_ADDRESS="$("$PY" - <<'AT_SPI_ADDRESS'
import time
from gi.repository import Gio
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
end = time.monotonic() + 10
while True:
    try:
        reply = bus.call_sync('org.a11y.Bus', '/org/a11y/bus',
                              'org.a11y.Bus', 'GetAddress', None, None,
                              Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        print(reply.unpack()[0])
        break
    except Exception:
        if time.monotonic() >= end:
            raise
        time.sleep(0.1)
AT_SPI_ADDRESS
)"
    export AT_SPI_BUS_ADDRESS
    printf '%s\n' "$AT_SPI_BUS_ADDRESS" >"$ARTIFACTS/atspi-address.txt"
fi
"$PY" - "$ARTIFACTS/session-isolation.json" <<'SESSION_ISOLATION'
import json, os, pathlib, sys
runtime = pathlib.Path(os.environ['XDG_RUNTIME_DIR'])
mode = runtime.stat().st_mode & 0o777
assert mode == 0o700, 'proof runtime must be private'
assert os.environ.get('AT_SPI_BUS_ADDRESS'), 'explicit accessibility bus is required'
assert str(runtime) in os.environ['AT_SPI_BUS_ADDRESS'], 'accessibility bus must belong to the proof runtime'
pathlib.Path(sys.argv[1]).write_text(json.dumps({
    'runtime_directory': str(runtime), 'runtime_mode': oct(mode),
    'session_bus': os.environ.get('DBUS_SESSION_BUS_ADDRESS'),
    'accessibility_bus': os.environ['AT_SPI_BUS_ADDRESS'],
}, indent=2) + '\n')
SESSION_ISOLATION

