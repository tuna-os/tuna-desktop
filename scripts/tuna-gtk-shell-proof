# Callback-only commits must progress without reattaching or damaging the
# unchanged cursor buffer. An unselected cursor must receive no callbacks.
xdotool mousemove --window "$WID" $((WIDTH / 2)) 16
WAYLAND_DISPLAY="$SOCKET_NAME" "$ARTIFACTS/cursor-client/tuna-cursor-client" callbacks 32 \
    >"$ARTIFACTS/cursor-callbacks.log" 2>&1 &
CURSOR_PID=$!
cstate 'any(.windows[]; .app_id == "tuna-cursor-probe")' "callback cursor mapped" ||
    fail G-CURSOR-FRAME "the callback fixture did not map"
sleep 0.3
if grep -q cursor_callback "$ARTIFACTS/cursor-callbacks.log"; then
    fail G-CURSOR-FRAME "an unselected cursor received frame callbacks"
fi
probe_rect="$(jq -r '.windows[] | select(.app_id == "tuna-cursor-probe") | .rect | "\((.[0] + .[2] / 2) | floor) \((.[1] + .[3] / 2) | floor)"' "$CSTATE")"
# shellcheck disable=SC2086 # exactly two numeric coordinates
xdotool mousemove --window "$WID" $probe_rect
for _ in $(seq 1 30); do
    grep -q '"cursor_callback":16,' "$ARTIFACTS/cursor-callbacks.log" && break
    sleep 0.2
done
grep -q '"cursor_callback":16,' "$ARTIFACTS/cursor-callbacks.log" ||
    fail G-CURSOR-FRAME "unchanged-buffer frame-only commits stalled without new input"
kill "$CURSOR_PID" 2>/dev/null || true
wait "$CURSOR_PID" 2>/dev/null || true
CURSOR_PID=""
cstate ".windows | length == $cursor_windows" "callback cursor gone" ||
    fail G-CURSOR-FRAME "the callback fixture did not close"
pass G-CURSOR-FRAME "unselected cursor receives no callback; 16 callback-only commits progress on the visible unchanged cursor without fresh input"

# GNOME's locate-pointer: a lone Ctrl tap ripples at the pointer, only
# while the key is on (Mutter's locate-pointer-key, Control_L).
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
gsettings set org.gnome.desktop.interface locate-pointer false
cstate '.cursor.locate_pointer.enabled | not' "locate-pointer off" ||
    fail G-LOCATE-POINTER "locate-pointer false did not reach the compositor"
locate_before="$(jq '.cursor.locate_pointer.count' "$CSTATE")"
locate_frames="$(jq '.cursor.locate_pointer.frames' "$CSTATE")"
xdotool key Control_L
sleep 1.5
jq -e ".cursor.locate_pointer.count == $locate_before and .cursor.locate_pointer.frames == $locate_frames" "$CSTATE" >/dev/null ||
    fail G-LOCATE-POINTER "a Ctrl tap rippled with locate-pointer off"
gsettings set org.gnome.desktop.interface locate-pointer true
cstate '.cursor.locate_pointer.enabled' "locate-pointer on" ||
    fail G-LOCATE-POINTER "locate-pointer true did not reach the compositor"
xdotool key Control_L
cstate ".cursor.locate_pointer.count == $((locate_before + 1)) and .cursor.locate_pointer.active and .cursor.locate_pointer.frames > $locate_frames" "ripples" 3 ||
    fail G-LOCATE-POINTER "a Ctrl tap with locate-pointer on drew no ripples"
cp "$CSTATE" "$ARTIFACTS/locate-pointer.json"
jq -e ".cursor.locate_pointer.at == [$((WIDTH / 2)), $((HEIGHT / 2))]" "$CSTATE" >/dev/null ||
    fail G-LOCATE-POINTER "the ripples did not center on the pointer: $(jq -c '.cursor.locate_pointer' "$CSTATE")"
cstate '.cursor.locate_pointer.active | not' "ripples finished" 5 ||
    fail G-LOCATE-POINTER "the ripples did not finish"
gsettings set org.gnome.desktop.interface locate-pointer false
pass G-LOCATE-POINTER "a Ctrl tap ripples at the pointer with locate-pointer on, nothing with it off"

# A genuine GTK fullscreen request blocks accidental corner opening, while
# deliberate Super access remains available and unfullscreen restores it.
corner_requests="$ARTIFACTS/hot-corner-requests.json"
rm -f "$corner_requests" "$corner_requests.ack"
corner_count="$(jq '.windows | length' "$CSTATE")"
WAYLAND_DISPLAY="$SOCKET_NAME" TUNA_TEST_REQUESTS="$corner_requests" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Fullscreen Corner Proof" '#804000' >"$ARTIFACTS/hot-corner-fullscreen.log" 2>&1 &
HOT_CORNER_PID=$!
cstate ".windows | length == $((corner_count + 1))" "corner proof mapped" ||
    fail G-HOT-CORNER-FULLSCREEN "genuine GTK proof window did not map"
cstate '([.windows[] | select(.app_id == "tuna-test-fullscreen corner proof")] | length) == 1' "unique actual corner client identity" ||
    fail G-HOT-CORNER-FULLSCREEN "actual corner client identity was not unique"
corner_window_id="$(jq '.windows[] | select(.app_id == "tuna-test-fullscreen corner proof") | .id' "$CSTATE")"
# The toplevel enters the model before its first buffer, in a provisional
# cascade slot; that commit places it. Read the restore rect only once it
# holds still (and no size change is in flight), not the pre-commit slot.
corner_rect_query=".windows[] | select(.id == $corner_window_id) | .rect"
corner_restored_rect=""
corner_end=$(($(date +%s) + 20))
while [ "$(date +%s)" -le "$corner_end" ]; do
    corner_rect_now="$(jq -c "if ((.size_changes.in_flight // []) | any(.window == $corner_window_id)) then null else ($corner_rect_query) end" "$CSTATE" 2>/dev/null || true)"
    if [ -n "$corner_rect_now" ] && [ "$corner_rect_now" != null ] && [ "$corner_rect_now" = "$corner_restored_rect" ]; then
        break
    fi
    corner_restored_rect="$corner_rect_now"
    sleep 0.5
done
if [ -z "$corner_restored_rect" ] || [ "$corner_restored_rect" = null ]; then
    fail G-HOT-CORNER-FULLSCREEN "genuine GTK proof window never settled in place"
fi
cp "$CSTATE" "$ARTIFACTS/hot-corner-client-before-fullscreen.json"
printf '{"generation":1,"request":"fullscreen"}\n' >"$corner_requests"
cstate ".focused_rect == [0, 0, $WIDTH, $HEIGHT]" "corner proof fullscreen" ||
    fail G-HOT-CORNER-FULLSCREEN "actual GTK fullscreen request did not cover the output"
# The client's own fullscreen request runs GNOME's size-change
# transition too (#496).
cstate "(.size_changes.in_flight | length) == 0 and any(.size_changes.history[]; .window == $corner_window_id and .last == [0, 0, $WIDTH, $HEIGHT] and .outcome == \"completed\" and (.samples | length) >= 2)" "fullscreen transition" 10 ||
    fail G-SIZE-CHANGE-ANIM "the GTK fullscreen request did not ease to the output"
xdotool mousemove --window "$WID" 1 1
sleep 1
cstate '.pointer_position == [1, 1] and .pointer_fullscreen_blocked' "fullscreen corner motion delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "actual corner coordinates or fullscreen guard were not observed"
cstate '.overview_open | not' "fullscreen corner blocked" ||
    fail G-HOT-CORNER-FULLSCREEN "the corner opened over the fullscreen window"
cp "$CSTATE" "$ARTIFACTS/hot-corner-fullscreen-blocked.json"
scrot "$ARTIFACTS/hot-corner-fullscreen-blocked.png" >/dev/null
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key super
cstate '.overview_open' "fullscreen deliberate overview" ||
    fail G-HOT-CORNER-FULLSCREEN "fullscreen blocked deliberate Super access"
xdotool key Escape
cstate '.overview_open | not' "fullscreen deliberate overview dismissed" ||
    fail G-HOT-CORNER-FULLSCREEN "fullscreen overview did not close"
# Observe a real corner exit after overview teardown before the one fresh
# entry after unfullscreen.
# Retain actual delivered coordinates, not just xdotool's successful exit.
# Leave the corner after overview teardown before making the one fresh entry.
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
cstate ".pointer_position == [$((WIDTH / 2)), $((HEIGHT / 2))]" "fullscreen corner exit delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "backend did not deliver the requested corner exit"
cp "$CSTATE" "$ARTIFACTS/hot-corner-fullscreen-before-unfullscreen.json"
printf '{"generation":2,"request":"unfullscreen"}\n' >"$corner_requests"
# A null focus during overview teardown is not an unfullscreen completion.
# Observe the original mapped client and its exact saved rectangle with the
# real pointer still at the center, before the one genuine corner entry.
cstate ".focused == $corner_window_id and .focused_rect == $corner_restored_rect and (.windows | any(.id == $corner_window_id and .rect == $corner_restored_rect)) and .pointer_position == [$((WIDTH / 2)), $((HEIGHT / 2))] and (.pointer_fullscreen_blocked | not)" "original corner proof restored at center" ||
    fail G-HOT-CORNER-FULLSCREEN "actual GTK unfullscreen request did not restore geometry"
cp "$CSTATE" "$ARTIFACTS/hot-corner-unfullscreen-before-entry.json"
xdotool mousemove --window "$WID" 1 1
xdotool getmouselocation --shell >"$ARTIFACTS/hot-corner-unfullscreen-host-pointer.txt"
cstate '.pointer_position == [1, 1]' "unfullscreen corner entry delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "backend did not deliver the requested corner entry"
cp "$CSTATE" "$ARTIFACTS/hot-corner-unfullscreen-entry.json"
cstate '.pointer_fullscreen_blocked | not' "unfullscreen corner guard removed" ||
    fail G-HOT-CORNER-FULLSCREEN "actual fullscreen guard remained after restoring geometry"
cstate '.overview_open' "corner restored after fullscreen" ||
    fail G-HOT-CORNER-FULLSCREEN "unfullscreen did not restore corner opening"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Escape
cstate '.overview_open | not' "restored corner overview dismissed" ||
    fail G-HOT-CORNER-FULLSCREEN "restored corner overview did not close"
kill "$HOT_CORNER_PID" 2>/dev/null || true
HOT_CORNER_PID=""
cstate ".windows | length == $corner_count" "corner proof removed" ||
    fail G-HOT-CORNER-FULLSCREEN "corner proof window did not unmap"
pass G-HOT-CORNER-FULLSCREEN "genuine fullscreen blocks corner opening, Super remains available, and unfullscreen restores it"

# Occlusion culling (#503): an opaque fullscreen window hides the windows
# beneath it, so the compositor skips drawing them (frame_cost, published
# per output for the last drawn frame). Unfullscreened, the top window's
# client shadow and rounded corners are translucent, so the window under
# it is drawn again.
occlusion_requests="$ARTIFACTS/occlusion-requests.json"
rm -f "$occlusion_requests" "$occlusion_requests.ack"
occlusion_count="$(jq '.windows | length' "$CSTATE")"
WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Occlusion Below" '#204080' >"$ARTIFACTS/occlusion-below.log" 2>&1 &
OCCLUSION_PIDS="$!"
cstate '.windows | any(.app_id == "tuna-test-occlusion below")' "occlusion lower window mapped" ||
    fail G-OCCLUSION-CULL "lower proof window did not map"
below_id="$(jq '.windows[] | select(.app_id == "tuna-test-occlusion below") | .id' "$CSTATE")"
cstate "[.frame_cost[] | .drawn_windows[]] | index($below_id) != null" "lower window drawn" ||
    fail G-OCCLUSION-CULL "frame_cost did not report the visible lower window as drawn"
WAYLAND_DISPLAY="$SOCKET_NAME" TUNA_TEST_REQUESTS="$occlusion_requests" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Occlusion Above" '#408020' >"$ARTIFACTS/occlusion-above.log" 2>&1 &
OCCLUSION_PIDS="$OCCLUSION_PIDS $!"
cstate '.windows | any(.app_id == "tuna-test-occlusion above")' "occlusion upper window mapped" ||
    fail G-OCCLUSION-CULL "upper proof window did not map"
above_id="$(jq '.windows[] | select(.app_id == "tuna-test-occlusion above") | .id' "$CSTATE")"
printf '{"generation":1,"request":"fullscreen"}\n' >"$occlusion_requests"
cstate ".focused == $above_id and .focused_rect == [0, 0, $WIDTH, $HEIGHT]" "occlusion upper fullscreen" ||
    fail G-OCCLUSION-CULL "upper proof window did not fullscreen"
# The lower proof window sits wholly under the opaque fullscreen window.
cstate "([.frame_cost[] | .culled_windows[]] | index($below_id) != null) and ([.frame_cost[] | .drawn_windows[]] | index($above_id) != null)" "lower window culled" ||
    fail G-OCCLUSION-CULL "the window under an opaque fullscreen window was still drawn"
cstate ".throttled_windows | index($below_id) != null and index($above_id) == null" "lower window frame callbacks throttled" ||
    fail G-OCCLUSION-CULL "the hidden window kept full-rate frame callbacks"
cp "$CSTATE" "$ARTIFACTS/occlusion-fullscreen.json"
scrot "$ARTIFACTS/occlusion-fullscreen.png" >/dev/null
printf '{"generation":2,"request":"unfullscreen"}\n' >"$occlusion_requests"
cstate ".focused == $above_id and .focused_rect != [0, 0, $WIDTH, $HEIGHT]" "occlusion upper restored" ||
    fail G-OCCLUSION-CULL "upper proof window did not unfullscreen"
cstate "([.frame_cost[] | .drawn_windows[]] | index($below_id) != null) and ([.frame_cost[] | .culled_windows[]] | index($below_id) == null)" "lower window drawn again" ||
    fail G-OCCLUSION-CULL "the lower window stayed culled under a translucent-edged window"
cstate ".throttled_windows | index($below_id) == null" "lower window frame callbacks restored" ||
    fail G-OCCLUSION-CULL "the shown window stayed throttled"
cp "$CSTATE" "$ARTIFACTS/occlusion-restored.json"
# shellcheck disable=SC2086
kill $OCCLUSION_PIDS 2>/dev/null || true
OCCLUSION_PIDS=""
cstate ".windows | length == $occlusion_count" "occlusion proof windows removed" ||
    fail G-OCCLUSION-CULL "occlusion proof windows did not unmap"
pass G-OCCLUSION-CULL "an opaque fullscreen window culls and throttles the windows beneath it; translucent edges do not"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 30
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us')]"
cstate '.keyboard.layouts == ["English (US)"]' "one source" ||
    fail G-SETTINGS-INPUT "the keymap did not return to us"
pass G-SETTINGS-INPUT "input sources, Super+Space, key repeat and the hot corner follow GNOME"

# GNOME's per-class pointer device keys (#343) reach the compositor's
# settings live. The nested session has no libinput devices; V-POINTER-LIVE
# proves applied device state on the native VM's mouse.
set_pointer_keys() {
    gsettings set org.gnome.desktop.peripherals.touchpad send-events disabled-on-external-mouse
    gsettings set org.gnome.desktop.peripherals.touchpad click-method areas
    gsettings set org.gnome.desktop.peripherals.touchpad edge-scrolling-enabled true
    gsettings set org.gnome.desktop.peripherals.touchpad two-finger-scrolling-enabled false
    gsettings set org.gnome.desktop.peripherals.touchpad tap-and-drag false
    gsettings set org.gnome.desktop.peripherals.touchpad tap-and-drag-lock true
    gsettings set org.gnome.desktop.peripherals.touchpad tap-button-map lmr
    gsettings set org.gnome.desktop.peripherals.touchpad middle-click-emulation true
    gsettings set org.gnome.desktop.peripherals.touchpad accel-profile flat
    gsettings set org.gnome.desktop.peripherals.mouse middle-click-emulation true
    gsettings set org.gnome.desktop.peripherals.trackball accel-profile adaptive
    gsettings set org.gnome.desktop.peripherals.trackball middle-click-emulation true
    gsettings set org.gnome.desktop.peripherals.trackball scroll-wheel-emulation-button 8
    gsettings set org.gnome.desktop.peripherals.trackball scroll-wheel-emulation-button-lock true
    gsettings set org.gnome.desktop.peripherals.pointingstick speed -0.5
    gsettings set org.gnome.desktop.peripherals.pointingstick accel-profile flat
    gsettings set org.gnome.desktop.peripherals.pointingstick scroll-method none
}
reset_pointer_keys() {
    for key in send-events click-method edge-scrolling-enabled two-finger-scrolling-enabled \
        tap-and-drag tap-and-drag-lock tap-button-map middle-click-emulation accel-profile; do
        gsettings reset org.gnome.desktop.peripherals.touchpad "$key"
    done
    # shellcheck disable=SC2086 # the optional key list splits on purpose
    for key in middle-click-emulation $pointer_mouse_wheel_keys; do
        gsettings reset org.gnome.desktop.peripherals.mouse "$key"
    done
    for key in accel-profile middle-click-emulation scroll-wheel-emulation-button \
        scroll-wheel-emulation-button-lock; do
        gsettings reset org.gnome.desktop.peripherals.trackball "$key"
    done
    for key in speed accel-profile scroll-method; do
        gsettings reset org.gnome.desktop.peripherals.pointingstick "$key"
    done
}
# The mouse schema gained scroll-wheel emulation in gsettings-desktop-schemas
# 51; older hosts lack the keys, and the shell then keeps GNOME's default.
pointer_mouse_wheel_keys=""
pointer_mouse_wheel='{"button":0,"lock":false}'
pointer_wheel_note="host mouse schema predates scroll-wheel emulation"
if gsettings list-keys org.gnome.desktop.peripherals.mouse | grep -qx scroll-wheel-emulation-button; then
    pointer_mouse_wheel_keys="scroll-wheel-emulation-button scroll-wheel-emulation-button-lock"
    pointer_mouse_wheel='{"button":2,"lock":true}'
    pointer_wheel_note="mouse scroll-wheel emulation included"
fi
set_pointer_keys
if [ -n "$pointer_mouse_wheel_keys" ]; then
    gsettings set org.gnome.desktop.peripherals.mouse scroll-wheel-emulation-button 2
    gsettings set org.gnome.desktop.peripherals.mouse scroll-wheel-emulation-button-lock true
fi
cstate ".pointer_device_settings == {
    \"mouse_accel_profile\": \"Default\",
    \"touchpad\": {\"send_events\": \"DisabledOnExternalMouse\", \"click_method\": \"Areas\",
        \"edge_scrolling\": true, \"two_finger_scrolling\": false, \"tap_and_drag\": false,
        \"tap_and_drag_lock\": true, \"tap_button_map\": \"Lmr\",
        \"middle_click_emulation\": true, \"accel_profile\": \"Flat\"},
    \"mouse\": {\"middle_click_emulation\": true, \"scroll_wheel_emulation\": $pointer_mouse_wheel},
    \"trackball\": {\"accel_profile\": \"Adaptive\", \"middle_click_emulation\": true,
        \"scroll_wheel_emulation\": {\"button\": 8, \"lock\": true}},
    \"pointing_stick\": {\"speed_milli\": -500, \"accel_profile\": \"Flat\", \"scroll_method\": \"None\"}}" \
    "pointer device keys applied" ||
    fail G-SETTINGS-POINTER "GNOME's touchpad, mouse, trackball and pointing-stick keys did not reach the compositor"
cp "$CSTATE" "$ARTIFACTS/pointer-device-settings.json"
reset_pointer_keys
cstate '.pointer_device_settings == {
    "mouse_accel_profile": "Default",
    "touchpad": {"send_events": "Enabled", "click_method": "Fingers",
        "edge_scrolling": false, "two_finger_scrolling": true, "tap_and_drag": true,
        "tap_and_drag_lock": false, "tap_button_map": "Default",
        "middle_click_emulation": false, "accel_profile": "Default"},
    "mouse": {"middle_click_emulation": false, "scroll_wheel_emulation": {"button": 0, "lock": false}},
    "trackball": {"accel_profile": "Default", "middle_click_emulation": false,
        "scroll_wheel_emulation": {"button": 0, "lock": false}},
    "pointing_stick": {"speed_milli": 0, "accel_profile": "Default", "scroll_method": "Default"}}' \
    "pointer device keys reset" ||
    fail G-SETTINGS-POINTER "resetting the pointer device keys did not restore GNOME 51 defaults"
pass G-SETTINGS-POINTER "touchpad, mouse, trackball and pointing-stick keys reach the compositor live and reset to GNOME 51 defaults; $pointer_wheel_note"

# GNOME's keyboard accessibility aids (#350). Real key events from the
# host X server pass through the compositor's input pipeline into a
# recording GTK client; each aid is first shown absent (negative control),
# then switched on through GNOME's own settings and exercised.
"$PY" "$ROOT/scripts/lib/tuna-a11y-input-keyvals-tests.py" >"$ARTIFACTS/a11y-keyvals-classifier.log" 2>&1 ||
    fail G-A11Y-KEYMAP "the GTK recorder character classifier failed its negative controls"
A11Y_KBD=org.gnome.desktop.a11y.keyboard
A11Y_KEYS="$ARTIFACTS/a11y-input.json"
rm -f "$A11Y_KEYS"
gsettings reset-recursively "$A11Y_KBD"
WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-a11y-input-window.py" "$A11Y_KEYS" >"$ARTIFACTS/a11y-input.log" 2>&1 &
A11Y_INPUT_PID=$!
cstate '.focused_app_id == "org.tuna.A11yInputProof"' "a11y recorder focused" ||
    fail G-A11Y-STICKY "the recording GTK window did not map focused"
[ -s "$A11Y_KEYS" ] || sleep 1
# Wait for the recorder to satisfy a jq expression.
a11y_wait() {
    end=$(($(date +%s) + ${3:-10}))
    while [ "$(date +%s)" -le "$end" ]; do
        [ -s "$A11Y_KEYS" ] && jq -e "$1" "$A11Y_KEYS" >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    echo "tuna-gtk-shell-proof: a11y recorder ($2) was:" >&2
    cat "$A11Y_KEYS" >&2 2>/dev/null || true
    return 1
}
# Printable presses as classified by the real GTK recorder through GDK
# Unicode conversion (ISO_Level3_Shift is below 0xff00), since mark $1, as
# "keyval:shift" strings.
a11y_typed() {
    echo "[.presses[$1:][] | select(.printable) | \"\\(.keyval):\\(.shift)\"]"
}
a11y_mark() { jq '.presses | length' "$A11Y_KEYS"; }

# Sticky Keys. Without the aid a tapped Shift is spent at once.
mark="$(a11y_mark)"
xdotool key Shift_L
xdotool key a
a11y_wait "$(a11y_typed "$mark") == [\"97:false\"]" "plain shift tap" ||
    fail G-A11Y-STICKY "without Sticky Keys a Shift tap should not change the next key"
gsettings set "$A11Y_KBD" stickykeys-enable true
cstate '.input_aids.sticky' "sticky on" || fail G-A11Y-STICKY "stickykeys-enable did not reach the compositor"
mark="$(a11y_mark)"
xdotool key Shift_L
cstate '.input_aids.latched == ["shift"]' "shift latched" || fail G-A11Y-STICKY "a Shift tap did not latch"
xdotool key a
xdotool key b
a11y_wait "$(a11y_typed "$mark") == [\"65:true\",\"98:false\"]" "latched shift" ||
    fail G-A11Y-STICKY "the latched Shift did not apply to exactly one key"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "latch spent" ||
    fail G-A11Y-STICKY "the latched Shift was not released after one key"
# A live semantic keymap replacement must release the old modifier under
# the old map; unrelated repeat updates must preserve a pending latch.
a11y_xkb_options="$(gsettings get org.gnome.desktop.input-sources xkb-options)"
xdotool key Control_L
cstate '.input_aids.latched == ["control"]' "control before repeat update" ||
    fail G-A11Y-KEYMAP "the old map did not latch Control"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 60
cstate '.keyboard.repeat_rate == 16 and .input_aids.latched == ["control"]' "repeat without map reset" ||
    fail G-A11Y-KEYMAP "an unrelated repeat change discarded the Control latch"
gsettings set org.gnome.desktop.input-sources xkb-options "['ctrl:swapcaps']"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "old-map holds released" ||
    fail G-A11Y-KEYMAP "a keymap replacement retained old modifier state"
mark="$(a11y_mark)"
xdotool key a
a11y_wait "[.presses[$mark:][] | select(.printable) | {keyval,ctrl}] == [{\"keyval\":97,\"ctrl\":false}]" "no old-map control" ||
    fail G-A11Y-KEYMAP "the old Control latch affected the first new-map key"
xdotool key Caps_Lock
cstate '.input_aids.latched == ["control"]' "remapped Caps is Control" ||
    fail G-A11Y-KEYMAP "the configured Caps-to-Control role did not latch"
mark="$(a11y_mark)"
xdotool key a
a11y_wait "[.presses[$mark:][] | select(.printable) | {keyval,ctrl}] == [{\"keyval\":97,\"ctrl\":true}]" "real remapped control chord" ||
    fail G-A11Y-KEYMAP "the remapped physical Caps key did not control the real GTK key"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "remapped latch spent" ||
    fail G-A11Y-KEYMAP "the remapped Control latch did not release"
# Balance the host Caps Lock toggle while the guest still maps it to Control.
xdotool key Caps_Lock
cstate '.input_aids.latched == ["control"]' "remapped control before restore" ||
    fail G-A11Y-KEYMAP "the remapped role did not remain live before restoration"
gsettings set org.gnome.desktop.input-sources xkb-options "$a11y_xkb_options"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "map restoration clears holds" ||
    fail G-A11Y-KEYMAP "restoring the original map retained a remapped Control hold"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50
cstate '.keyboard.repeat_rate == 20' "repeat restored" ||
    fail G-A11Y-KEYMAP "repeat preferences did not restore"
cp "$A11Y_KEYS" "$ARTIFACTS/a11y-keymap.json"
pass G-A11Y-KEYMAP "repeat changes preserve a latch; semantic keymap replacement clears it; remapped physical Caps produces a real Control chord"
# The private Xvfb/evdev input fixture uses X keycode108 for physical
# RightAlt (evdev100). xdotool's Alt_R keysym lookup sends an additional
# Alt_L64 on this host map, so tap the physical key through XTEST. Keep
# exact guest latch assertions: US RightAlt is Alt, German RightAlt is
# Level3. No host modifier clearing/filtering is performed.
"$PY" "$ROOT/scripts/lib/xkeycode-tap-tests.py" >"$ARTIFACTS/a11y-physical-tap-tests.log" 2>&1 ||
    fail G-A11Y-KEYMAP "physical key driver negative controls failed"
a11y_right_alt_tap() {
    "$PY" "$ROOT/scripts/lib/xkeycode-tap.py" "$DISPLAY" --keycode 108 ||
        fail G-A11Y-KEYMAP "physical RightAlt XTEST tap failed"
}
"$PY" "$ROOT/scripts/lib/xkeysym-levels.py" "$DISPLAY" ffea fe03 >"$ARTIFACTS/a11y-host-rightalt-levels.log" 2>&1 ||
    fail G-A11Y-KEYMAP "could not record the host RightAlt/Level3 keymap"
cp "$CSTATE" "$ARTIFACTS/a11y-keymap-before-rightalt.json"
mark="$(a11y_mark)"
a11y_right_alt_tap
cstate '.input_aids.latched == ["alt"]' "US physical RightAlt is Alt" ||
    fail G-A11Y-KEYMAP "US physical RightAlt did not latch only Alt"
xdotool key a
a11y_wait "[.presses[$mark:][] | select(.printable) | {keyval,alt}] == [{\"keyval\":97,\"alt\":true}]" "US RightAlt actual chord" ||
    fail G-A11Y-KEYMAP "US RightAlt was not delivered as a real Alt chord"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "US RightAlt spent" ||
    fail G-A11Y-KEYMAP "US RightAlt remained held after its chord"
# Actual German Level3 selector: an AltGr tap must affect exactly one
# subsequent real client key, and be inert with Sticky Keys disabled.
a11y_sources="$(gsettings get org.gnome.desktop.input-sources sources)"
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'de')]"
cstate '.keyboard.layouts == ["German"] and .input_aids.latched == [] and .seat_pressed_key_count == 0' "German map resets holds" ||
    fail G-A11Y-KEYMAP "German layout replacement did not clear held modifiers"
gsettings set "$A11Y_KBD" stickykeys-enable false
cstate '(.input_aids.sticky | not)' "German sticky off" || fail G-A11Y-KEYMAP "Sticky Keys off did not apply"
cp "$CSTATE" "$ARTIFACTS/a11y-keymap-german-sticky-off.json"
mark="$(a11y_mark)"
a11y_right_alt_tap
xdotool key q
a11y_wait "[.presses[$mark:][] | select(.printable) | {keyval,alt}] == [{\"keyval\":113,\"alt\":false}]" "plain German AltGr tap" ||
    fail G-A11Y-KEYMAP "without Sticky Keys an AltGr tap changed the next q"
gsettings set "$A11Y_KBD" stickykeys-enable true
cstate '.input_aids.sticky and (.input_aids.shortcuts | not)' "German sticky without shortcuts" ||
    fail G-A11Y-KEYMAP "Sticky Keys must operate independently of shortcut enable"
mark="$(a11y_mark)"
a11y_right_alt_tap
cstate '.input_aids.latched == ["level3"]' "German Level3 latched" ||
    fail G-A11Y-KEYMAP "the configured German AltGr selector did not latch Level3"
cp "$CSTATE" "$ARTIFACTS/a11y-keymap-german-level3-latched.json"
xdotool key q q
a11y_wait "[.presses[$mark:][] | select(.printable) | {keyval,alt}] == [{\"keyval\":64,\"alt\":false},{\"keyval\":113,\"alt\":false}]" "German Level3 spent once" ||
    fail G-A11Y-KEYMAP "the real German client did not receive @ then plain q"
cstate '.input_aids.latched == [] and .seat_pressed_key_count == 0' "German latch released" ||
    fail G-A11Y-KEYMAP "German Level3 retained a synthetic hold"
a11y_right_alt_tap
cstate '.input_aids.latched == ["level3"]' "German pending latch before restore" ||
    fail G-A11Y-KEYMAP "German Level3 second latch was missing"
gsettings set org.gnome.desktop.input-sources sources "$a11y_sources"
cstate '.keyboard.layouts != ["German"] and .input_aids.latched == [] and .seat_pressed_key_count == 0' "restore map clears German hold" ||
    fail G-A11Y-KEYMAP "restoring original source retained the Level3 hold"
cp "$A11Y_KEYS" "$ARTIFACTS/a11y-keymap-level3.json"
# Two taps lock, a third releases.
mark="$(a11y_mark)"
xdotool key Shift_L
xdotool key Shift_L
cstate '.input_aids.locked == ["shift"]' "shift locked" || fail G-A11Y-STICKY "a second Shift tap did not lock"
xdotool key a
xdotool key b
xdotool key Shift_L
cstate '.input_aids.locked == []' "shift unlocked" || fail G-A11Y-STICKY "a third Shift tap did not unlock"
xdotool key c
a11y_wait "$(a11y_typed "$mark") == [\"65:true\",\"66:true\",\"99:false\"]" "locked shift" ||
    fail G-A11Y-STICKY "the locked Shift did not hold across keys and release on the third tap"
cp "$A11Y_KEYS" "$ARTIFACTS/a11y-sticky.json"
# stickykeys-two-key-off: two modifiers at once switch the aid off, the
# shell saves it and shows GNOME's confirmation; Enter keeps it off.
gsettings set "$A11Y_KBD" stickykeys-two-key-off true
sleep 0.5
xdotool keydown Control_L keydown Alt_L
xdotool keyup Alt_L keyup Control_L
cstate '(.input_aids.sticky | not) and any(.layers[]; .namespace == "tuna-kbd-a11y")' "two keys off" ||
    fail G-A11Y-STICKY "two modifiers at once did not switch Sticky Keys off and confirm"
[ "$(gsettings get "$A11Y_KBD" stickykeys-enable)" = false ] ||
    fail G-A11Y-STICKY "the shell did not save stickykeys-enable false"
scrot "$ARTIFACTS/a11y-sticky-off-dialog.png" >/dev/null
xdotool key Return
cstate 'all(.layers[]; .namespace != "tuna-kbd-a11y")' "dialog closed" ||
    fail G-A11Y-STICKY "Leave Off did not close the confirmation"
[ "$(gsettings get "$A11Y_KBD" stickykeys-enable)" = false ] ||
    fail G-A11Y-STICKY "Leave Off did not keep Sticky Keys off"
pass G-A11Y-STICKY "a tapped Shift latches for one key, two taps lock, and two modifiers at once switch the aid off with GNOME's confirmation"

# Keyboard shortcuts (enable): Shift five times switches Sticky Keys on.
gsettings set "$A11Y_KBD" enable true
gsettings set "$A11Y_KBD" togglekeys-enable true
cstate '.input_aids.shortcuts' "shortcuts on" || fail G-A11Y-SHORTCUTS "enable did not reach the compositor"
for _ in 1 2 3 4 5; do xdotool key Shift_L; sleep 0.1; done
cstate '.input_aids.sticky and any(.layers[]; .namespace == "tuna-kbd-a11y")' "shift five times" ||
    fail G-A11Y-SHORTCUTS "Shift pressed five times did not switch Sticky Keys on"
scrot "$ARTIFACTS/a11y-sticky-on-dialog.png" >/dev/null
[ "$(gsettings get "$A11Y_KBD" stickykeys-enable)" = true ] ||
    fail G-A11Y-SHORTCUTS "the shell did not save stickykeys-enable true"
xdotool key Return
cstate 'all(.layers[]; .namespace != "tuna-kbd-a11y")' "leave on" ||
    fail G-A11Y-SHORTCUTS "Leave On did not close the confirmation"
gsettings set "$A11Y_KBD" stickykeys-enable false
cstate '(.input_aids.sticky | not)' "sticky off" || fail G-A11Y-SHORTCUTS "stickykeys-enable false did not apply"
# Toggle Keys follows actual XKB LED transitions (twice restores Caps).
cstate '.input_aids.toggle_beep' "toggle preference live" || fail G-A11Y-SHORTCUTS "Toggle Keys preference did not apply"
bells="$(jq '.input_aids.bells' "$CSTATE")"
xdotool key Caps_Lock Caps_Lock Num_Lock Num_Lock
cstate ".input_aids.bells == $((bells + 4))" "toggle beeps" ||
    fail G-A11Y-SHORTCUTS "Toggle Keys did not ring once per actual Caps/Num LED change"
# The compositor saves each Num Lock change (remember-numlock-state)
# through the gsettings CLI, which rewrites the whole keyfile it loaded:
# a setting written before that save settles is undone.
cstate '.keyboard.num_lock == false and .keyboard.numlock_saving == false' "Num Lock save settled" ||
    fail G-A11Y-SHORTCUTS "the compositor's numlock-state save did not settle"
# The setting must be live before measuring. No bell for Caps remapped
# to Control: its keysym/physical location does not change actual LEDs.
cstate '.input_aids.toggle_beep' "toggle preference live" || fail G-A11Y-SHORTCUTS "Toggle Keys preference did not apply"
keymap_generation="$(jq '.keyboard.keymap_generation' "$CSTATE")"
gsettings set org.gnome.desktop.input-sources xkb-options "['ctrl:swapcaps']"
gsettings set "$A11Y_KBD" stickykeys-enable true
cstate ".keyboard.keymap_generation > $keymap_generation" "toggle Caps-to-Control map" ||
    fail G-A11Y-SHORTCUTS "the Caps-to-Control keymap did not load"
cstate '.input_aids.sticky' "toggle map barrier sticky on" || fail G-A11Y-SHORTCUTS "Sticky Keys on did not apply"
xdotool key Caps_Lock Caps_Lock
cstate '.input_aids.locked == ["control"]' "toggle actual remapped role" || fail G-A11Y-SHORTCUTS "the actual Caps-to-Control keymap was not applied"
gsettings set "$A11Y_KBD" stickykeys-enable false
cstate '(.input_aids.sticky | not)' "toggle remap sticky off" || fail G-A11Y-SHORTCUTS "Sticky Keys off did not apply"
bells="$(jq '.input_aids.bells' "$CSTATE")"
mark="$(a11y_mark)"
xdotool key Caps_Lock Caps_Lock a
a11y_wait "[.presses[$mark:][] | select(.printable) | .keyval] == [97]" "remapped no-LED client barrier" || fail G-A11Y-SHORTCUTS "remapped key sequence did not reach client"
cstate ".input_aids.bells == $bells" "no LED change no bell" || fail G-A11Y-SHORTCUTS "a Caps-to-Control press rang without a LED transition"
gsettings set "$A11Y_KBD" stickykeys-enable true
cstate '.input_aids.sticky' "toggle restore barrier sticky on" || fail G-A11Y-SHORTCUTS "Sticky Keys on did not apply"
xdotool key Caps_Lock Caps_Lock
cstate '.input_aids.locked == ["control"]' "toggle pending remapped latch" || fail G-A11Y-SHORTCUTS "the remapped Control barrier was missing"
gsettings set org.gnome.desktop.input-sources xkb-options "$a11y_xkb_options"
cstate '.input_aids.latched == [] and .input_aids.locked == [] and .seat_pressed_key_count == 0' "toggle original map restored" || fail G-A11Y-SHORTCUTS "toggle map restoration retained holds"
gsettings set "$A11Y_KBD" stickykeys-enable false
cstate '(.input_aids.sticky | not)' "toggle restore sticky off" || fail G-A11Y-SHORTCUTS "Sticky Keys off did not apply"
gsettings set "$A11Y_KBD" togglekeys-enable false
cstate '(.input_aids.toggle_beep | not)' "toggle preference off" || fail G-A11Y-SHORTCUTS "Toggle Keys off did not apply"
bells="$(jq '.input_aids.bells' "$CSTATE")"
mark="$(a11y_mark)"
xdotool key Caps_Lock Caps_Lock a
a11y_wait "[.presses[$mark:][] | select(.printable) | .keyval] == [97]" "toggle off client barrier" || fail G-A11Y-SHORTCUTS "Toggle Keys off sequence did not reach client"
cstate ".input_aids.bells == $bells" "toggle disabled no bell" || fail G-A11Y-SHORTCUTS "disabled Toggle Keys rang for an actual LED transition"
# Shift held eight seconds switches Slow Keys on.
xdotool keydown Shift_L
sleep 9
cstate '.input_aids.slow and any(.layers[]; .namespace == "tuna-kbd-a11y")' "shift held" ||
    { xdotool keyup Shift_L; fail G-A11Y-SHORTCUTS "Shift held eight seconds did not switch Slow Keys on"; }
xdotool keyup Shift_L
[ "$(gsettings get "$A11Y_KBD" slowkeys-enable)" = true ] ||
    fail G-A11Y-SHORTCUTS "the shell did not save slowkeys-enable true"
# Slow Keys now apply: Turn Off needs Escape held past the delay.
xdotool keydown Escape
sleep 0.8
xdotool keyup Escape
cstate '(.input_aids.slow | not) and all(.layers[]; .namespace != "tuna-kbd-a11y")' "turn off" ||
    fail G-A11Y-SHORTCUTS "Turn Off did not switch Slow Keys back off"
gsettings set "$A11Y_KBD" enable false
gsettings set "$A11Y_KBD" togglekeys-enable false
pass G-A11Y-SHORTCUTS "Shift five times and Shift held eight seconds switch Sticky and Slow Keys with GNOME's confirmation; Toggle Keys beep"

# Slow Keys: a quick tap is dropped, a held key arrives once.
gsettings set "$A11Y_KBD" slowkeys-delay 600
gsettings set "$A11Y_KBD" slowkeys-enable true
cstate '.input_aids.slow' "slow on" || fail G-A11Y-SLOW "slowkeys-enable did not reach the compositor"
mark="$(a11y_mark)"
rejected="$(jq '.input_aids.slow_rejected' "$CSTATE")"
xdotool key a
cstate ".input_aids.slow_rejected == $((rejected + 1))" "tap rejected" ||
    fail G-A11Y-SLOW "a tap shorter than the delay was not rejected"
xdotool keydown b
sleep 1
xdotool keyup b
a11y_wait "$(a11y_typed "$mark") == [\"98:false\"]" "held key" ||
    fail G-A11Y-SLOW "Slow Keys did not deliver only the key held past the delay"
gsettings set "$A11Y_KBD" slowkeys-enable false
cstate '(.input_aids.slow | not)' "slow off" || fail G-A11Y-SLOW "slowkeys-enable false did not apply"
mark="$(a11y_mark)"
xdotool key a
a11y_wait "$(a11y_typed "$mark") == [\"97:false\"]" "slow off" ||
    fail G-A11Y-SLOW "a tap was not delivered with Slow Keys off"
pass G-A11Y-SLOW "Slow Keys drop a tap shorter than slowkeys-delay and deliver a held key once"

# Bounce Keys: a key pressed again within the delay is ignored.
mark="$(a11y_mark)"
xdotool key a
sleep 0.1
xdotool key a
a11y_wait "$(a11y_typed "$mark") == [\"97:false\",\"97:false\"]" "no bounce" ||
    fail G-A11Y-BOUNCE "without Bounce Keys both presses should arrive"
gsettings set "$A11Y_KBD" bouncekeys-delay 700
gsettings set "$A11Y_KBD" bouncekeys-enable true
cstate '.input_aids.bounce' "bounce on" || fail G-A11Y-BOUNCE "bouncekeys-enable did not reach the compositor"
mark="$(a11y_mark)"
xdotool key a
sleep 0.1
xdotool key a
sleep 1
xdotool key a
a11y_wait "$(a11y_typed "$mark") == [\"97:false\",\"97:false\"]" "bounce" ||
    fail G-A11Y-BOUNCE "the quick repeat was not dropped, or the later press was"
cstate '.input_aids.bounce_rejected >= 1' "bounce counted" || fail G-A11Y-BOUNCE "no bounce was rejected"
gsettings set "$A11Y_KBD" bouncekeys-enable false
pass G-A11Y-BOUNCE "a repeat within bouncekeys-delay is dropped; a later press arrives"

# Mouse Keys: the keypad moves the pointer and clicks.
a11y_rect="$(jq -c '.focused_rect' "$CSTATE")"
a11y_cx="$(echo "$a11y_rect" | jq '.[0] + (.[2] / 2 | floor)')"
a11y_cy="$(echo "$a11y_rect" | jq '.[1] + (.[3] / 2 | floor)')"
xdotool mousemove --window "$WID" "$a11y_cx" "$a11y_cy"
cstate ".pointer_position == [$a11y_cx, $a11y_cy]" "pointer on recorder" ||
    fail G-A11Y-MOUSEKEYS "the pointer did not reach the recording window"
xdotool keydown KP_Right
sleep 0.6
xdotool keyup KP_Right
sleep 0.3
cstate ".pointer_position == [$a11y_cx, $a11y_cy]" "keypad without mouse keys" ||
    fail G-A11Y-MOUSEKEYS "the keypad moved the pointer without Mouse Keys"
gsettings set "$A11Y_KBD" mousekeys-max-speed 1000
gsettings set "$A11Y_KBD" mousekeys-accel-time 300
gsettings set "$A11Y_KBD" mousekeys-init-delay 100
gsettings set "$A11Y_KBD" mousekeys-enable true
cstate '.input_aids.mouse' "mouse keys on" || fail G-A11Y-MOUSEKEYS "mousekeys-enable did not reach the compositor"
xdotool keydown KP_Right
sleep 0.8
xdotool keyup KP_Right
# xdotool has sent the release, not waited for the compositor to process it.
# Match the disabled-keypad settling interval before taking the stop baseline.
sleep 0.3
cstate ".pointer_position[0] >= $((a11y_cx + 60)) and .pointer_position[1] == $a11y_cy" "pointer moved right" ||
    fail G-A11Y-MOUSEKEYS "holding keypad 6 did not accelerate the pointer right"
moved="$(jq -c '.pointer_position' "$CSTATE")"
sleep 0.5
cstate ".pointer_position == $moved" "pointer stopped" ||
    fail G-A11Y-MOUSEKEYS "the pointer kept moving after the key was released"
# The host pointer never left the center, so return one pixel aside:
# a move to where it already is sends no motion.
xdotool mousemove --window "$WID" $((a11y_cx + 1)) "$a11y_cy"
cstate ".pointer_position == [$((a11y_cx + 1)), $a11y_cy]" "pointer back on recorder" ||
    fail G-A11Y-MOUSEKEYS "the pointer did not return to the recording window"
buttons="$(jq '.buttons | length' "$A11Y_KEYS")"
xdotool key KP_Begin
a11y_wait "(.buttons | length) == $((buttons + 1)) and .buttons[-1].button == 1" "keypad click" ||
    fail G-A11Y-MOUSEKEYS "keypad 5 did not click the primary button"
xdotool key KP_Subtract KP_Begin
a11y_wait "(.buttons | length) == $((buttons + 2)) and .buttons[-1].button == 3" "keypad secondary" ||
    fail G-A11Y-MOUSEKEYS "keypad - then 5 did not click the secondary button"
cp "$A11Y_KEYS" "$ARTIFACTS/a11y-mousekeys.json"
gsettings set "$A11Y_KBD" mousekeys-enable false
cstate '(.input_aids.mouse | not) and .input_aids.mouse_buttons_down == 0' "mouse keys off" ||
    fail G-A11Y-MOUSEKEYS "mousekeys-enable false did not apply"
pass G-A11Y-MOUSEKEYS "keypad 6 accelerates the pointer and stops on release; 5 clicks, - picks the secondary button"

# Pointer aids (org.gnome.desktop.a11y.mouse) on the same recorder: real
# host pointer motion and buttons through the compositor.
A11Y_MOUSE=org.gnome.desktop.a11y.mouse
gsettings reset-recursively "$A11Y_MOUSE"
a11y_buttons() { jq '.buttons | length' "$A11Y_KEYS"; }
# Hover click: without it a resting pointer clicks nothing.
xdotool mousemove --window "$WID" "$a11y_cx" "$a11y_cy"
buttons="$(a11y_buttons)"
sleep 2
[ "$(a11y_buttons)" = "$buttons" ] || fail G-A11Y-DWELL "a resting pointer clicked without hover click"
gsettings set "$A11Y_MOUSE" dwell-time 0.8
gsettings set "$A11Y_MOUSE" dwell-click-enabled true
cstate '.input_aids.pointer.dwell_click' "dwell on" || fail G-A11Y-DWELL "dwell-click-enabled did not reach the compositor"
xdotool mousemove --window "$WID" $((a11y_cx - 30)) "$a11y_cy"
cstate 'any(.layers[]; .namespace == "tuna-pointer-a11y")' "pie timer" 5 ||
    fail G-A11Y-DWELL "the pie timer did not show while the pointer dwelled"
scrot "$ARTIFACTS/a11y-dwell-pie.png" >/dev/null
a11y_wait "(.buttons | length) == $((buttons + 1)) and .buttons[-1].button == 1" "dwell click" ||
    fail G-A11Y-DWELL "resting the pointer did not make one primary click"
sleep 2
[ "$(a11y_buttons)" = "$((buttons + 1))" ] || fail G-A11Y-DWELL "a still pointer clicked more than once"
cstate 'all(.layers[]; .namespace != "tuna-pointer-a11y")' "pie gone" ||
    fail G-A11Y-DWELL "the pie timer stayed after the click"
# Gesture mode: after the dwell, moving right picks GNOME's default
# secondary click, made back where the pointer dwelled.
gsettings set "$A11Y_MOUSE" dwell-mode gesture
cstate '.input_aids.pointer.dwell_gesture' "gesture mode" || fail G-A11Y-DWELL "dwell-mode gesture did not apply"
gesture_x=$((a11y_cx - 80))
xdotool mousemove --window "$WID" "$gesture_x" "$a11y_cy"
cstate '.input_aids.pointer.gesture' "gesture open" 6 ||
    fail G-A11Y-DWELL "the dwell did not open the direction gesture"
xdotool mousemove --window "$WID" $((gesture_x + 40)) "$a11y_cy"
a11y_wait "(.buttons | length) == $((buttons + 2)) and .buttons[-1].button == 3" "gesture secondary" ||
    fail G-A11Y-DWELL "moving right after the dwell did not make a secondary click"
cstate ".pointer_position == [$gesture_x, $a11y_cy]" "click where it dwelled" ||
    fail G-A11Y-DWELL "the gesture click was not made where the pointer dwelled"
cp "$A11Y_KEYS" "$ARTIFACTS/a11y-dwell.json"
gsettings set "$A11Y_MOUSE" dwell-click-enabled false
cstate '(.input_aids.pointer.dwell_click | not)' "dwell off" || fail G-A11Y-DWELL "dwell-click-enabled false did not apply"
pass G-A11Y-DWELL "a resting pointer clicks once after dwell-time with GNOME's pie timer; a gesture picks the click by direction"

# Simulated secondary click: a held primary button becomes a secondary
# click on release; a quick click stays a plain click.
xdotool mousemove --window "$WID" "$a11y_cx" "$a11y_cy"
buttons="$(a11y_buttons)"
xdotool mousedown 1
sleep 1.2
xdotool mouseup 1
a11y_wait "(.buttons | length) == $((buttons + 1)) and .buttons[-1].button == 1" "held without the aid" ||
    fail G-A11Y-SECONDARY "without the aid a held press should stay a primary click"
gsettings set "$A11Y_MOUSE" secondary-click-time 0.6
gsettings set "$A11Y_MOUSE" secondary-click-enabled true
cstate '.input_aids.pointer.secondary_click' "secondary on" ||
    fail G-A11Y-SECONDARY "secondary-click-enabled did not reach the compositor"
xdotool mousedown 1
sleep 0.1
xdotool mouseup 1
a11y_wait "(.buttons | length) == $((buttons + 2)) and .buttons[-1].button == 1" "quick click" ||
    fail G-A11Y-SECONDARY "a quick click did not stay a primary click"
xdotool mousedown 1
sleep 1.2
xdotool mouseup 1
a11y_wait "(.buttons | length) == $((buttons + 4)) and .buttons[-2].button == 1 and .buttons[-1].button == 3" "held click" ||
    fail G-A11Y-SECONDARY "holding the primary button did not make a secondary click"
sleep 0.5
[ "$(a11y_buttons)" = "$((buttons + 4))" ] || fail G-A11Y-SECONDARY "the held click made extra clicks"
gsettings set "$A11Y_MOUSE" secondary-click-enabled false
pass G-A11Y-SECONDARY "holding the primary button for secondary-click-time makes a secondary click"
gsettings reset-recursively "$A11Y_MOUSE"

gsettings reset-recursively "$A11Y_KBD"
kill "$A11Y_INPUT_PID" 2>/dev/null || true
A11Y_INPUT_PID=""
cstate 'all(.windows[]; .app_id != "org.tuna.A11yInputProof")' "a11y recorder closed" ||
    fail G-A11Y-MOUSEKEYS "the recording window did not unmap"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))

# Disabling animations is live and snaps compositor and GTK transitions.
gsettings set org.gnome.desktop.interface enable-animations false
cstate '(.animations_enabled | not)' "animations disabled" ||
    fail G-ANIMATIONS-OFF "enable-animations false did not reach the compositor"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 1' "instant overview" ||
    fail G-ANIMATIONS-OFF "the disabled overview did not jump to its open state"
cp "$CSTATE" "$ARTIFACTS/animations-disabled-open.json"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 0' "instant desktop" ||
    fail G-ANIMATIONS-OFF "the disabled overview did not jump to its closed state"
xdotool key super+shift+t
cstate '.session_mode == "scroll" and .strip_view == .strip_offset' "instant strip" ||
    fail G-ANIMATIONS-OFF "the disabled strip view did not match its target"
xdotool key super+Left
cstate '.strip_view == .strip_offset' "instant focus" ||
    fail G-ANIMATIONS-OFF "the disabled strip view lagged after a focus move"
xdotool key super+shift+t
cstate '.session_mode == "gnome"' "floating" || fail G-ANIMATIONS-OFF "could not restore floating mode"
# The Alt+Tab popup closes without its fade (#501).
fade_mark="$(wc -c <"$LOG")"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "switcher without motion" 5 ||
    { xdotool keyup Alt_L; fail G-ANIMATIONS-OFF "the switcher did not open"; }
sleep 0.3
# Escape cancels, leaving the focus where the later gates expect it.
xdotool key Escape keyup Alt_L
cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "switcher closed without motion" 5 ||
    fail G-ANIMATIONS-OFF "the switcher did not close"
tail -c +"$((fade_mark + 1))" "$LOG" | "$ROOT/scripts/lib/tuna-fade-match" popup-out start false ||
    fail G-ANIMATIONS-OFF "the switcher popup still faded with animations off"
gsettings set org.gnome.desktop.interface enable-animations true
cstate '.animations_enabled' "animations enabled" ||
    fail G-ANIMATIONS-OFF "enable-animations true did not restore live animation"
# Settings' Reduced Motion switch must work even with enable-animations true.
# GNOME 51 keeps fades and drops motion: enable-animations (and Introspect's
# AnimationsEnabled) stays true while the policy turns fade-only.
gsettings set org.gnome.desktop.a11y.interface reduced-motion 'reduce'
cstate '.animations_enabled and .motion_policy == "fade-only"' "reduced motion" ||
    fail G-ANIMATIONS-OFF "Reduced Motion did not reach the compositor as fade-only"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 1' "reduced overview" ||
    fail G-ANIMATIONS-OFF "Reduced Motion overview did not jump to its open state"
cp "$CSTATE" "$ARTIFACTS/reduced-motion-open.json"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 0' "reduced desktop" ||
    fail G-ANIMATIONS-OFF "Reduced Motion overview did not jump to its closed state"
# The Alt+Tab popup's fade-out is a fade: Reduced Motion keeps it.
fade_mark="$(wc -c <"$LOG")"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "reduced switcher" 5 ||
    { xdotool keyup Alt_L; fail G-ANIMATIONS-OFF "the Reduced Motion switcher did not open"; }
sleep 0.3
xdotool key Escape keyup Alt_L
cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "reduced switcher closed" 5 ||
    fail G-ANIMATIONS-OFF "the Reduced Motion switcher did not close"
tail -c +"$((fade_mark + 1))" "$LOG" | "$ROOT/scripts/lib/tuna-fade-match" popup-out start true ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the switcher popup's fade"
# The idle shield is a fade: Reduced Motion keeps it (GNOME's screenShield
# uses adjustAnimationTime), while animations off removes it.
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.screensaver lock-delay 0
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 610000' "reduced idle" ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the ten-second idle fade from the lock timeout"
[ "$(sed -n '2p' "$XDG_RUNTIME_DIR/tuna-idle-blank")" = 10000 ] ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the screen-blank fade"
gsettings set org.gnome.desktop.interface enable-animations false
cstate '(.animations_enabled | not) and .motion_policy == "off" and .idle_timeout_ms == 600000' "animations off idle" ||
    fail G-ANIMATIONS-OFF "enable-animations false left the idle fade in the lock timeout"
[ "$(sed -n '2p' "$XDG_RUNTIME_DIR/tuna-idle-blank")" = 0 ] ||
    fail G-ANIMATIONS-OFF "enable-animations false left the screen-blank fade enabled"
gsettings reset org.gnome.desktop.a11y.interface reduced-motion
cstate '(.animations_enabled | not) and .motion_policy == "off"' "explicit animation disable" ||
    fail G-ANIMATIONS-OFF "resetting Reduced Motion overrode enable-animations false"
gsettings set org.gnome.desktop.interface enable-animations true
cstate '.animations_enabled and .motion_policy == "full" and .idle_timeout_ms == 610000' "motion restored" ||
    fail G-ANIMATIONS-OFF "resetting both preferences did not restore motion and idle fade"
pass G-ANIMATIONS-OFF "enable-animations and GNOME 51 Reduced Motion are live; off snaps everything, fade-only snaps overview/strip motion and keeps the idle fade"
python3 "$ROOT/scripts/lib/tuna-introspect-motion-client.py" "$CSTATE" \
    "$ARTIFACTS/introspect-motion.json" >"$ARTIFACTS/introspect-motion.log" 2>&1 || \
    fail G-INTROSPECT-MOTION "live D-Bus motion properties/signals disagree with actual compositor policy"
pass G-INTROSPECT-MOTION "GNOME clients receive four enable-animations changes; Reduced Motion leaves AnimationsEnabled true as in GNOME 51; property and compositor agree"

# The proof-driven animation clock samples the overview transition at
# exact delays: 250 ms each way, so 125 ms is exactly half.
anim_clock 0
cstate '.animation_clock_manual and .motion_policy == "full" and (.overview_open | not) and .overview_progress == 0' "frozen clock" ||
    fail G-ANIMATION-CLOCK "the clock file did not freeze compositor animation time"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 0' "frozen overview" ||
    fail G-ANIMATION-CLOCK "the overview moved while animation time was frozen"
anim_clock 125
# Opening eases out-sine (#499): sin(pi/4) of the way at half time.
cstate '(.overview_progress - 0.7071067811865476 | if . < 0 then -. else . end) < 1e-9' "overview at 125 ms" ||
    fail G-ANIMATION-CLOCK "the overview was not sin(pi/4) open 125 ms in (EASE_OUT_SINE)"
cp "$CSTATE" "$ARTIFACTS/animation-clock-125ms.json"
anim_clock 250
cstate '.overview_progress == 1' "overview at 250 ms" ||
    fail G-ANIMATION-CLOCK "the overview had not settled 250 ms in"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 1' "frozen close" ||
    fail G-ANIMATION-CLOCK "the closing overview moved while animation time was frozen"
anim_clock 375
# Closing eases out-quad: three quarters of the way gone at half time.
cstate '(.overview_progress - 0.25 | if . < 0 then -. else . end) < 1e-9' "close at 125 ms" ||
    fail G-ANIMATION-CLOCK "the closing overview was not a quarter open 125 ms in (EASE_OUT_QUAD)"
anim_clock 500
cstate '.overview_progress == 0' "close at 250 ms" ||
    fail G-ANIMATION-CLOCK "the closing overview had not settled 250 ms in"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '.animation_clock_manual | not' "real clock" ||
    fail G-ANIMATION-CLOCK "removing the clock file did not resume real time"
pass G-ANIMATION-CLOCK "a proof-driven clock freezes compositor animation time and samples the overview's out-sine opening and out-quad closing at exact 125/250 ms delays"

# BoxPointer.close (#501): GTK closes a panel menu logically at once and
# the compositor draws its close from the last frame, sampled here on the
# proof clock: 150 ms ease-out quad, fading while it rises 6px and shrinks
# to 96%. The accessible tree loses the menu while the close stands still.
menu_ghost() {
    printf '(.menu_close.closing | length) == 1 and (.menu_close.closing[0] | %s)' "$1"
}
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-menu-close-open.json" 20 ||
    fail G-TRANSIENT-CLOSE-CLOCK "a11y dump failed"
showing "$ARTIFACTS/a11y-menu-close-open.json" "Previous month" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the date menu did not open"
anim_clock 0
cstate '.animation_clock_manual and (.menu_close.closing | length) == 0' "frozen clock, no close" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the clock did not freeze or a close was already running"
xdotool key Escape
cstate "$(menu_ghost '.elapsed_ms == 0 and .duration_ms == 150 and .frame.alpha == 1 and .frame.dy == 0 and .frame.scale == 1 and .motion and (.fade_only | not)')" "frozen menu close" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "Escape did not start a frozen 150 ms BoxPointer close"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-menu-close-frozen.json" 20 ||
    fail G-TRANSIENT-CLOSE-CLOCK "a11y dump failed"
hidden "$ARTIFACTS/a11y-menu-close-frozen.json" "Previous month" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the menu stayed in the accessible tree during its close"
anim_clock 75
# Ease-out quad: three quarters of the way at half time.
cstate "$(menu_ghost '.elapsed_ms == 75 and ((.frame.alpha - 0.25) | fabs) < 1e-9 and ((.frame.dy + 4.5) | fabs) < 1e-9 and ((.frame.scale - 0.97) | fabs) < 1e-9')" "menu close at 75 ms" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the menu was not a quarter opaque, 4.5px up and 97% 75 ms in"
cp "$CSTATE" "$ARTIFACTS/menu-close-75ms.json"
anim_clock 150
cstate '(.menu_close.closing | length) == 0 and .menu_close.history[-1].outcome == "started"' "menu close at 150 ms" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the menu close had not finished 150 ms in"
# Opening again replaces a close under way (BoxPointer.open).
open_calendar
xdotool key Escape
cstate "$(menu_ghost '.elapsed_ms == 0')" "second frozen close" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "the second Escape did not start a close"
open_calendar
cstate '(.menu_close.closing | length) == 0' "reopen drops the close" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "reopening the menu left its close drawn"
# An outside click closes on the first click and still animates.
xdotool mousemove --window "$WID" 40 $((HEIGHT - 40)) click 1
cstate "$(menu_ghost '.elapsed_ms == 0 and .motion')" "outside-click close" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "an outside click did not close the menu with a BoxPointer close"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-menu-close-click.json" 20 ||
    fail G-TRANSIENT-CLOSE-CLOCK "a11y dump failed"
hidden "$ARTIFACTS/a11y-menu-close-click.json" "Previous month" ||
    fail G-TRANSIENT-CLOSE-CLOCK "one outside click left the menu open"
anim_clock 300
cstate '(.menu_close.closing | length) == 0' "outside-click close done" ||
    fail G-TRANSIENT-CLOSE-CLOCK "the outside-click close never finished"
# PanelMenu.Button.vfunc_hide (panelMenu.js:149-154): a panel button
# hidden under its open menu closes it with animate: false, so the
# compositor draws no BoxPointer close. The Accessibility button shows
# while always-show-universal-access-status is on.
gsettings set org.gnome.desktop.a11y always-show-universal-access-status true
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-menu-hide-button.json" 20 ||
    fail G-TRANSIENT-CLOSE-CLOCK "a11y dump failed"
a11y_button="$(jq -er '[.[] | select(.showing and .name == "Accessibility" and ((.bounds[2] // 0) > 0) and ((.bounds[3] // 0) > 0))][0].bounds | "\(.[0] + .[2] / 2 | floor) \(.[1] + .[3] / 2 | floor)"' "$ARTIFACTS/a11y-menu-hide-button.json")" ||
    fail G-TRANSIENT-CLOSE-CLOCK "always-show-universal-access-status showed no Accessibility button"
# shellcheck disable=SC2086
xdotool mousemove --window "$WID" $a11y_button click 1
cstate '.menu_close.retained == 1 and (.menu_close.closing | length) == 0' "accessibility menu open" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "the Accessibility menu did not open"
gsettings set org.gnome.desktop.a11y always-show-universal-access-status false
cstate '.menu_close.retained == 0 and (.menu_close.closing | length) == 0 and .menu_close.history[-1].outcome == "unanimated" and (.menu_close.unanimated_pending | not)' "unanimated close" 5 ||
    fail G-TRANSIENT-CLOSE-CLOCK "hiding the Accessibility button under its menu drew BoxPointer's close (GNOME closes it unanimated)"
gsettings reset org.gnome.desktop.a11y always-show-universal-access-status
real_clock
pass G-TRANSIENT-CLOSE-CLOCK "panel menus close logically at once (accessible tree, one outside click) while the compositor draws BoxPointer's 150 ms out-quad fade, 6px rise and 96% shrink, sampled at 0/75/150 ms; reopening replaces the close; a button hidden under its menu closes it unanimated"

# GNOME settings (#63): the idle lock follows idle-delay and
# lock-enabled as they change.
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 610000' "idle 600" ||
    fail G-SETTINGS-IDLE "idle-delay 600 did not reach the compositor"
gsettings set org.gnome.desktop.screensaver lock-enabled false
cstate '.idle_timeout_ms > 1e18' "lock off" ||
    fail G-SETTINGS-IDLE "lock-enabled false did not turn the idle lock off"
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.session idle-delay 300
cstate '.idle_timeout_ms == 310000' "idle 300" ||
    fail G-SETTINGS-IDLE "the idle lock did not follow back to 300 s"
pass G-SETTINGS-IDLE "GNOME's idle-delay and lock-enabled set the idle lock live"

# Wellbeing (#354): the live shell records session-active history where
# GNOME Settings 51 reads it, with GNOME's field names and a startup edge
# from this journey (not fabricated usage).
HISTORY_FILE="$XDG_DATA_HOME/gnome-shell/session-active-history.json"
[ -s "$HISTORY_FILE" ] || fail G-WELLBEING-HISTORY "no history file at $HISTORY_FILE"
"$PY" - "$HISTORY_FILE" <<'PYHIST' || fail G-WELLBEING-HISTORY "history file failed validation"
import json, sys, time
transitions = json.load(open(sys.argv[1]))
assert transitions, "history is empty"
for t in transitions:
    assert set(t) == {"oldState", "newState", "wallTimeSecs"}, t
    assert t["oldState"] != t["newState"], t
    assert t["wallTimeSecs"] <= time.time() + 60, t
recent = [t for t in transitions if abs(t["wallTimeSecs"] - time.time()) < 7200]
assert recent, "no startup edge from this journey"
PYHIST
cp "$HISTORY_FILE" "$ARTIFACTS/wellbeing-history.json"
# Negative control: disabling recording deletes the file live through the
# settings watch (not the 30 s tick); re-enabling records again.
gsettings set org.gnome.desktop.screen-time-limits history-enabled false
end=$(($(date +%s) + 15))
while [ -f "$HISTORY_FILE" ] && [ "$(date +%s)" -le "$end" ]; do sleep 1; done
[ ! -f "$HISTORY_FILE" ] || fail G-WELLBEING-HISTORY "history file survived history-enabled=false"
gsettings reset org.gnome.desktop.screen-time-limits history-enabled
end=$(($(date +%s) + 15))
while [ ! -s "$HISTORY_FILE" ] && [ "$(date +%s)" -le "$end" ]; do sleep 1; done
[ -s "$HISTORY_FILE" ] || fail G-WELLBEING-HISTORY "history did not resume after re-enabling"
pass G-WELLBEING-HISTORY "the shell records GNOME-compatible session-active history, deleted while disabled"

# History was just deleted and restarted. A real 10 s daily limit must
# reach its deadline within this 20 s gate, post the limit notice and request
# grayscale without waiting for the 30 s background sample. Banners need DND
# off; the journey's DND state is restored after the break gate.
DND_BEFORE="$(gsettings get org.gnome.desktop.notifications show-banners)"
gsettings set org.gnome.desktop.notifications show-banners true
sleep 2
limit_post_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.screen-time-limits daily-limit-seconds 10
gsettings set org.gnome.desktop.screen-time-limits daily-limit-enabled true
LIMIT_BANNER=""
end=$(($(date +%s) + 20))
while [ "$(date +%s)" -le "$end" ]; do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-limit.json" 20 >/dev/null 2>&1 || continue
    if showing "$ARTIFACTS/a11y-wellbeing-limit.json" "Screen Time Limit Reached"; then LIMIT_BANNER=1; break; fi
    sleep 2
done
[ -n "$LIMIT_BANNER" ] || fail G-WELLBEING-LIMIT "no Screen Time Limit Reached banner"
scrot "$ARTIFACTS/25-wellbeing-limit.png" >/dev/null
grep -q "wellbeing: effect grayscale=true" "$LOG" || fail G-WELLBEING-LIMIT "no grayscale request in the shell log"
# GNOME parity: a 10 s limit is never exactly 600 s away, so it gets no
# "10 Minutes" warning; "Reached" is posted at Urgency.HIGH.
LIMIT_LOG="$(tail -c +"$((limit_post_mark + 1))" "$LOG")"
if printf '%s\n' "$LIMIT_LOG" | grep -q "Screen Time Limit in"; then
    fail G-WELLBEING-LIMIT "a 10 s limit posted the 10 minute warning (GNOME posts it only at exactly 600 s left)"
fi
LIMIT_ID="$(printf '%s\n' "$LIMIT_LOG" | sed -n 's/.*wellbeing: limit notice \([0-9]*\) posted urgency=high: Screen Time Limit Reached$/\1/p' | head -n1)"
[ -n "$LIMIT_ID" ] || fail G-WELLBEING-LIMIT "the limit notice was not posted at high urgency"
# Negative controls: grayscale off clears the request; the limit off
# returns the tracker to Active without a second notice.
gsettings set org.gnome.desktop.screen-time-limits grayscale false
end=$(($(date +%s) + 15))
until grep -q "wellbeing: effect grayscale=false" "$LOG" || [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
grep -q "wellbeing: effect grayscale=false" "$LOG" || fail G-WELLBEING-LIMIT "grayscale=false did not clear the request"
limit_mark="$(wc -c <"$LOG")"
gsettings reset org.gnome.desktop.screen-time-limits daily-limit-enabled
gsettings reset org.gnome.desktop.screen-time-limits daily-limit-seconds
gsettings reset org.gnome.desktop.screen-time-limits grayscale
end=$(($(date +%s) + 15))
until tail -c +"$((limit_mark + 1))" "$LOG" | grep -q "wellbeing: screen-time state Active" || [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((limit_mark + 1))" "$LOG" | grep -q "wellbeing: screen-time state Active" || fail G-WELLBEING-LIMIT "the tracker did not return to Active"
# GNOME destroys the notification once the limit is off: gone from the
# message list too, not just the banner.
tail -c +"$((limit_mark + 1))" "$LOG" | grep -q "wellbeing: limit notice $LIMIT_ID removed" ||
    fail G-WELLBEING-LIMIT "turning the limit off did not remove the limit notice"
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-limit-off.json" 20 ||
    fail G-WELLBEING-LIMIT "message list dump failed"
xdotool key Escape
if jq -e 'any(.[]; .name == "Screen Time Limit Reached")' "$ARTIFACTS/a11y-wellbeing-limit-off.json" >/dev/null; then
    fail G-WELLBEING-LIMIT "the limit notice outlived the limit in the message list"
fi
pass G-WELLBEING-LIMIT "the spent daily limit posts its high-urgency notice without a 10 minute warning, requests grayscale live, and is removed when the limit is off"

# Break reminders with correct timing: a 10 s eyesight interval shows the
# OSD countdown, then the due notice; an idle user takes the break (fade
# request) and finishing it plays the complete sound.
wb_mark="$(wc -c <"$LOG")"
xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2))
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 10
gsettings set org.gnome.desktop.break-reminders.eyesight countdown true
gsettings set org.gnome.desktop.break-reminders.eyesight notify true
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']"
# Three keep-alives over 6 s: the user stays in the Active phase (idle
# under 10 s) while the countdown shows and the break comes due. Due is
# detected on a 2 s tick, so the last input lands 4-6 s before it: away
# enough for the banner to wait (over 1 s), present enough to be due.
sleep 2
xdotool mousemove --window "$WID" $((WIDTH / 3 + 40)) $((HEIGHT / 2))
sleep 2
xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2))
sleep 2
xdotool mousemove --window "$WID" $((WIDTH / 3 + 40)) $((HEIGHT / 2))
scrot "$ARTIFACTS/26a-wellbeing-countdown.png" >/dev/null
DUE_BANNER=""
end=$(($(date +%s) + 20))
while [ "$(date +%s)" -le "$end" ]; do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-break.json" 20 >/dev/null 2>&1 || continue
    if showing "$ARTIFACTS/a11y-wellbeing-break.json" "Time for an Eyesight Break"; then DUE_BANNER=1; break; fi
    sleep 2
done
[ -n "$DUE_BANNER" ] || fail G-WELLBEING-BREAK "no Time for an Eyesight Break banner"
scrot "$ARTIFACTS/26b-wellbeing-due.png" >/dev/null
tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: countdown Break in" || fail G-WELLBEING-BREAK "no countdown OSD for the upcoming break"
# The idle user takes the 10 s break: InBreak fades, completion unfades
# and sounds. Completion lands ~20 s after selection; sleep past it.
sleep 20
end=$(($(date +%s) + 15))
until tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=true" || [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=true" || fail G-WELLBEING-BREAK "no fade request while the break was taken"
tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: break complete sound" || fail G-WELLBEING-BREAK "no complete sound when the break finished"
tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=false" || fail G-WELLBEING-BREAK "no unfade after the break finished"
# GNOME parity: within one break cycle the resident break notification is
# updated in place at Urgency.HIGH (notify on), never closed and reposted,
# and completing the break destroys it (removed from the list).
BREAK_LOG="$(tail -c +"$((wb_mark + 1))" "$LOG" | grep "wellbeing: break notice " | awk '{print} / removed$/{exit}' || true)"
printf '%s\n' "$BREAK_LOG" | grep -q " removed$" ||
    fail G-WELLBEING-BREAK "the completed break did not remove its notice"
BREAK_POSTS="$(printf '%s\n' "$BREAK_LOG" | grep " urgency=" || true)"
[ -n "$BREAK_POSTS" ] || fail G-WELLBEING-BREAK "no break notice posts in the shell log"
if printf '%s\n' "$BREAK_POSTS" | grep -vq " urgency=high: "; then
    fail G-WELLBEING-BREAK "a break notice with notify on was not high urgency"
fi
BREAK_IDS="$(printf '%s\n' "$BREAK_LOG" | sed -n 's/.*wellbeing: break notice \([0-9]*\) .*/\1/p' | sort -u | wc -l)"
[ "$BREAK_IDS" -eq 1 ] || fail G-WELLBEING-BREAK "one break cycle used $BREAK_IDS notifications, not one updated in place"
if [ "$(printf '%s\n' "$BREAK_POSTS" | wc -l)" -gt 1 ]; then
    printf '%s\n' "$BREAK_POSTS" | sed -n '2,$p' | grep -vq " updated urgency=" &&
        fail G-WELLBEING-BREAK "a later break notice was reposted instead of updated in place"
fi
# Leave no trace for the later gates: deselect (Disabled), reset the keys,
# clear any other notices, let the banners expire, restore the journey's DND.
gsettings reset org.gnome.desktop.break-reminders selected-breaks
gsettings reset org.gnome.desktop.break-reminders.eyesight interval-seconds
gsettings reset org.gnome.desktop.break-reminders.eyesight duration-seconds
gsettings reset org.gnome.desktop.break-reminders.eyesight countdown
gsettings reset org.gnome.desktop.break-reminders.eyesight notify
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-list.json" 20 ||
    fail G-WELLBEING-BREAK "message list dump failed"
# The completed break's notice is destroyed, as in GNOME: not in the list.
for title in "Time for an Eyesight Break" "Eyesight Break in Progress" "Break Overdue" "Break Interrupted"; do
    if jq -e --arg n "$title" 'any(.[]; .name == $n)' "$ARTIFACTS/a11y-wellbeing-list.json" >/dev/null; then
        fail G-WELLBEING-BREAK "\"$title\" outlived the completed break in the message list"
    fi
done
# GNOME hides Clear with nothing to clear; press it only when shown.
if showing "$ARTIFACTS/a11y-wellbeing-list.json" "Clear"; then
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-cleared.json" 20 --press "Clear" ||
        fail G-WELLBEING-BREAK "could not press Clear"
fi
xdotool key Escape
xdotool mousemove --window "$WID" $((WIDTH / 3)) $((HEIGHT / 2))
sleep 3
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wellbeing-quiet.json" 20 ||
    fail G-WELLBEING-BREAK "quiet dump failed"
if showing "$ARTIFACTS/a11y-wellbeing-quiet.json" "Time for an Eyesight Break"; then
    fail G-WELLBEING-BREAK "the due banner outlived the break"
fi
if showing "$ARTIFACTS/a11y-wellbeing-quiet.json" "Screen Time Limit Reached"; then
    fail G-WELLBEING-BREAK "the limit banner outlived the limit"
fi
gsettings set org.gnome.desktop.notifications show-banners "$DND_BEFORE"
pass G-WELLBEING-BREAK "the 10 s break counts down, notifies due as one high-urgency notification updated in place, an idle take fades and sounds, and completion removes it"

# Wellbeing pixel/action proofs (#354, w3 pixel lane, proof4f hardening):
# framebuffer effects through the production path (settings ->
# tick/deadline -> 0.35 wire -> compositor FrameColor), sampled on the
# EXISTING deterministic saturated native test-client region
# (tuna-cursor-client 320x200 solid 0xff8f3fd0, same interior offsets as
# the native tuna-wellbeing-proof). Hardening over frozen 47d:
#
# - probe binding: CSTATE exposes id/app_id/application_window_id but
#   NOT pid/start, and no script-readable inventory exposes the kernel
#   client PID, so PID-from-CSTATE is never asserted. The probe is
#   bound by exact before/after unique new-map identity (one new
#   native window with the owned app_id; decoys fail closed) plus the
#   owned client's own pointer-enter handshake and /proc lifetime
#   (pid/uid/start/exe) re-checked on every gate.
# - owned-region proof: baselines must show the exact known interior
#   RGB, every capture re-checks the bound geometry, requires settled
#   overview_progress==0, and excludes actual layers geometrically.
# - frame bracketing: a CSTATE snapshot is taken BEFORE and AFTER
#   every scrot; identical manual clock + effect sample + owned
#   geometry is required or the capture is discarded and the gate
#   fails.
# - provenance: every capture carries a capture-time /proc snapshot
#   (exe byte hash + starttime + boot id); the gate requires
#   cross-capture agreement and requires the admitted binary hashes to
#   equal the live processes' exe bytes. No path-only hashing.
# - stale-press (NARROWED, do not expand): retired-UI-absence is
#   asserted only with a mandatory alive owned (--pid) AT-SPI tree and
#   zero transport errors; a dead bus or timeout FAILS the gate.
#   Delay/Skip stale checks also assert the live-press due schedule is
#   undisturbed. Callback-retirement stays explicitly UNQUALIFIED at
#   e2e (qualified at unit/GTK level elsewhere); no callback evidence
#   is claimed here.
# - neutral control: geometry/image inputs are validated before any
#   effect assertion; malformed inputs are harness errors (exit 2),
#   never passes and never pixel verdicts.
#
# Each gate records source commit, binary hashes, capture timestamps
# and animation-clock readings; missing or stale captures fail closed.
# Pixel tolerance is fixed at 2 (no widening); logs never qualify.
# Manual-clock steps never skip the 3s ramp (500ms steps). No
# old-build controls: every capture comes from this run's single
# admitted build. Issue #354 stays OPEN; nested observation pending.
WB_PROBE_PID=""
WB_SHELL_PID=""
WB_SHELL_START=""
WB_GATE=""
WB_NONCE=""
WB_DUMP_SEQ=0
WB_START=0
WB_FROZEN=0
WB_CAPS_JSONL=""
WB_STATE_JSONL=""
WB_WINDOWS_BEFORE=0

wb_proc_start_ticks() {
    "$PY" -c 'import sys
pid = sys.argv[1]
try:
    stat = open("/proc/%s/stat" % pid).read().rsplit(")", 1)[1].split()
    print(int(stat[19]))
except Exception as exc:
    print("cannot read start time of %s: %s" % (pid, exc))
    raise SystemExit(1)' "$1"
}

wb_gate_begin() {
    WB_GATE="$1"
    WB_START="$(date +%s)"
    WB_NONCE="$1-$(date +%s)-$$"
    WB_DUMP_SEQ=0
    WB_CAPS_JSONL="$ARTIFACTS/wb-$WB_GATE-captures.jsonl"
    : >"$WB_CAPS_JSONL"
    WB_STATE_JSONL="$ARTIFACTS/wb-$WB_GATE-state.jsonl"
    : >"$WB_STATE_JSONL"
    [ -x "$ARTIFACTS/cursor-client/tuna-cursor-client" ] ||
        fail "$WB_GATE" "the cursor probe build is missing"
    [ -f "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" ] ||
        fail "$WB_GATE" "the frame proof helper is missing"
    [ -f "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" ] ||
        fail "$WB_GATE" "the action proof helper is missing"
    [ -f "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" ] ||
        fail "$WB_GATE" "the probe bind helper is missing"
    if [ -z "$COMPOSITOR_PID" ] || ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        fail "$WB_GATE" "the compositor process went missing"
    fi
    wb_shell_matches="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk || true)"
    [ -n "$wb_shell_matches" ] ||
        fail "$WB_GATE" "no shell process under the compositor (expected exactly one)"
    [ "$(printf '%s\n' "$wb_shell_matches" | wc -l)" -eq 1 ] ||
        fail "$WB_GATE" "ambiguous shell processes under the compositor (expected exactly one)"
    WB_SHELL_PID="$wb_shell_matches"
    kill -0 "$WB_SHELL_PID" 2>/dev/null ||
        fail "$WB_GATE" "the shell process went missing"
    WB_SHELL_START="$(wb_proc_start_ticks "$WB_SHELL_PID")" ||
        fail "$WB_GATE" "the shell start time is unreadable"
    [ -n "$WB_SHELL_START" ] ||
        fail "$WB_GATE" "the shell start time is unreadable"
}

wb_stamp_dump() {
    wb_stamp_ticks="$(wb_proc_start_ticks "$WB_SHELL_PID")" || return 1
    [ "$wb_stamp_ticks" = "$WB_SHELL_START" ] || return 1
    wb_stamp_sha="$(sha256sum "$1" 2>/dev/null | cut -d' ' -f1)" || return 1
    [ -n "$wb_stamp_sha" ] || return 1
    jq -n --arg gate "$WB_GATE" --arg nonce "$WB_NONCE" \
        --argjson seq "$WB_DUMP_SEQ" --argjson pid "$WB_SHELL_PID" \
        --argjson start_ticks "$wb_stamp_ticks" \
        --argjson epoch "$(date +%s)" --arg dump_sha256 "$wb_stamp_sha" \
        '{gate:$gate,nonce:$nonce,seq:$seq,pid:$pid,start_ticks:$start_ticks,epoch:$epoch,dump_sha256:$dump_sha256}' \
        >"$1.stamp" || return 1
}

wb_dump_anchor() {
    [ "$(jq -r '.[0].process_id // "null"' "$1" 2>/dev/null)" = "$WB_SHELL_PID" ] || return 1
    jq -e 'any(.[]; .showing)' "$1" >/dev/null 2>&1 || return 1
}

wb_a11y_dump() {
    wb_dump_out="$1"
    wb_dump_timeout="$2"
    shift 2
    WB_DUMP_SEQ=$((WB_DUMP_SEQ + 1))
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk \
        "$wb_dump_out" "$wb_dump_timeout" --pid "$WB_SHELL_PID" "$@" || return $?
    wb_stamp_dump "$wb_dump_out" || return 1
    wb_dump_anchor "$wb_dump_out" || return 1
}

# Wait up to SECONDS for a wellbeing banner titled TITLE and press its BUTTON
# in the same AT-SPI pass that saw it (OUT is that pre-press tree). GNOME
# times a banner out 4 s after it shows to an active user, or 2 s after an
# away user's next input, and the shell retires its actions on expiry. A
# separate dump-then-press round trip with keep-alive input in between could
# press a banner that had already expired, so one keep-alive move per short
# step keeps the user active and the press within about a second of the
# banner showing. Waits 1.5 s after the press, like --press alone.
wb_press_banner() {
    wbpb_gate="$1" wbpb_out="$2" wbpb_title="$3" wbpb_button="$4"
    wbpb_until=$(($(date +%s) + $5)) wbpb_step=0
    while [ "$(date +%s)" -le "$wbpb_until" ]; do
        xdotool mousemove --window "$WID" $((WIDTH / 3 + wbpb_step % 2 * 40)) $((HEIGHT / 2)) ||
            fail "$wbpb_gate" "keep-alive failed"
        wbpb_step=$((wbpb_step + 1))
        sleep 0.5
        if wb_a11y_dump "$wbpb_out" 20 --when-showing "$wbpb_title" --press "$wbpb_button" >/dev/null 2>&1; then
            WB_PRESS_EPOCH="$(date +%s)"
            sleep 1.5
            return 0
        fi
    done
    return 1
}

wb_probe_ensure() {
    if [ -n "$WB_PROBE_PID" ] && kill -0 "$WB_PROBE_PID" 2>/dev/null; then
        cstate 'any(.windows[]; .app_id == "tuna-cursor-probe")' "probe mapped" 5 ||
            fail "$WB_GATE" "the owned probe window went missing"
        "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" check \
            --cstate "$CSTATE" --owner "$ARTIFACTS/wb-probe-owner.json" \
            --pid "$WB_PROBE_PID" ||
            fail "$WB_GATE" "the owned probe binding no longer holds (decoy, move, or client change)"
    else
        if [ -n "$WB_PROBE_PID" ]; then
            kill "$WB_PROBE_PID" 2>/dev/null || true
            wait "$WB_PROBE_PID" 2>/dev/null || true
            WB_PROBE_PID=""
        fi
        cstate 'all(.windows[]; .app_id != "tuna-cursor-probe")' "stale probe gone" 5 ||
            fail "$WB_GATE" "a stale probe map outlived its client"
        cp "$CSTATE" "$ARTIFACTS/wb-probe-before.json" ||
            fail "$WB_GATE" "compositor state missing before probe map"
        rm -f "$ARTIFACTS/wb-cursor-probe.log"
        WAYLAND_DISPLAY="$SOCKET_NAME" "$ARTIFACTS/cursor-client/tuna-cursor-client" surface 32 \
            >"$ARTIFACTS/wb-cursor-probe.log" 2>&1 &
        WB_PROBE_PID=$!
        cstate 'any(.windows[]; .app_id == "tuna-cursor-probe")' "probe mapped" ||
            fail "$WB_GATE" "the owned probe window never mapped"
        # A new window's first published rect can precede the client's
        # own size (the idle loop writes state as soon as it maps): bind
        # only once the same rect has been published three reads running.
        wb_rect_last=""
        wb_rect_same=0
        wb_rect_end=$(($(date +%s) + 10))
        while [ "$wb_rect_same" -lt 3 ]; do
            [ "$(date +%s)" -le "$wb_rect_end" ] ||
                fail "$WB_GATE" "the owned probe geometry never settled"
            wb_rect_now="$(jq -c '[.windows[] | select(.app_id == "tuna-cursor-probe") | .rect]' "$CSTATE" 2>/dev/null)" || wb_rect_now=""
            if [ -n "$wb_rect_now" ] && [ "$wb_rect_now" = "$wb_rect_last" ]; then
                wb_rect_same=$((wb_rect_same + 1))
            else
                wb_rect_same=1
                wb_rect_last="$wb_rect_now"
            fi
            sleep 0.3
        done
        cp "$CSTATE" "$ARTIFACTS/wb-probe-after.json" ||
            fail "$WB_GATE" "compositor state missing after probe map"
        "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" bind \
            --before "$ARTIFACTS/wb-probe-before.json" \
            --after "$ARTIFACTS/wb-probe-after.json" --pid "$WB_PROBE_PID" \
            --app-id tuna-cursor-probe --out "$ARTIFACTS/wb-probe-owner.json" ||
            fail "$WB_GATE" "the owned probe map is ambiguous (decoy?) or not native"
        # Fresh-enter handshake: only our client writes this log.
        # Park away and OBSERVE the pointer outside the bound rect (an
        # actual leave, not a commanded move), record the log byte
        # offset, move onto the bound center, then require a NEW
        # complete enter strictly after the offset while the pointer
        # sits inside the bound rect; bound geometry and the
        # owned-client lifetime are pinned before and after.
        # Whole-log matching is gone, and the wait itself only
        # completes on a complete NEW record (no substring grep). The
        # outside observation runs through pointer-zone, which rejects
        # malformed pointer shapes, mistyped or non-finite coordinates
        # instead of letting jq null-ordering accept [] as outside.
        probe_center="$(jq -r '.rect | "\((.[0] + .[2] / 2) | floor) \((.[1] + .[3] / 2) | floor)"' \
            "$ARTIFACTS/wb-probe-owner.json")" ||
            fail "$WB_GATE" "the bound probe rect went missing"
        if [ -z "$probe_center" ] || [ "$probe_center" = "null null" ]; then
            fail "$WB_GATE" "the bound probe rect went missing"
        fi
        wb_bound_x="$(jq -r '.rect[0]' "$ARTIFACTS/wb-probe-owner.json")" ||
            fail "$WB_GATE" "the bound probe rect went missing"
        wb_bound_y="$(jq -r '.rect[1]' "$ARTIFACTS/wb-probe-owner.json")" ||
            fail "$WB_GATE" "the bound probe rect went missing"
        wb_bound_w="$(jq -r '.rect[2]' "$ARTIFACTS/wb-probe-owner.json")" ||
            fail "$WB_GATE" "the bound probe rect went missing"
        wb_bound_h="$(jq -r '.rect[3]' "$ARTIFACTS/wb-probe-owner.json")" ||
            fail "$WB_GATE" "the bound probe rect went missing"
        for wb_bound_v in "$wb_bound_x" "$wb_bound_y" "$wb_bound_w" "$wb_bound_h"; do
            case "$wb_bound_v" in ''|*[!0-9]*) fail "$WB_GATE" "the bound probe rect is not integer geometry" ;; esac
        done
        wb_park_x=20
        wb_park_y=$((HEIGHT - 20))
        if [ "$wb_park_x" -ge "$wb_bound_x" ] && [ "$wb_park_x" -lt "$((wb_bound_x + wb_bound_w))" ] &&
            [ "$wb_park_y" -ge "$wb_bound_y" ] && [ "$wb_park_y" -lt "$((wb_bound_y + wb_bound_h))" ]; then
            fail "$WB_GATE" "the probe covers the park corner; no leave is observable"
        fi
        xdotool mousemove --window "$WID" "$wb_park_x" "$wb_park_y" ||
            fail "$WB_GATE" "could not park the pointer for a fresh enter"
        wb_left=""
        for _ in $(seq 1 20); do
            wb_zone="$("$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" pointer-zone \
                --cstate "$CSTATE" \
                --rect "$wb_bound_x,$wb_bound_y,$wb_bound_w,$wb_bound_h" 2>/dev/null)" || { sleep 0.25; continue; }
            if [ "$wb_zone" = "outside" ]; then wb_left=1; break; fi
            sleep 0.25
        done
        if [ -z "$wb_left" ]; then
            if wb_zone_err="$("$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" pointer-zone \
                --cstate "$CSTATE" \
                --rect "$wb_bound_x,$wb_bound_y,$wb_bound_w,$wb_bound_h" 2>&1)"; then
                fail "$WB_GATE" "the pointer never left the bound rect before the enter mark"
            fi
            fail "$WB_GATE" "pointer position unusable before the enter mark: $wb_zone_err"
        fi
        kill -0 "$WB_PROBE_PID" 2>/dev/null ||
            fail "$WB_GATE" "the owned probe client died before the enter handshake"
        "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" check \
            --cstate "$CSTATE" --owner "$ARTIFACTS/wb-probe-owner.json" \
            --pid "$WB_PROBE_PID" ||
            fail "$WB_GATE" "the owned probe binding broke before the enter handshake"
        wb_probe_start_before="$(wb_proc_start_ticks "$WB_PROBE_PID")" ||
            fail "$WB_GATE" "the owned probe start time is unreadable"
        wb_enter_mark="$(wc -c <"$ARTIFACTS/wb-cursor-probe.log")" ||
            fail "$WB_GATE" "the owned client log went missing"
        # shellcheck disable=SC2086 # two coordinates, second move after leave
        xdotool mousemove --window "$WID" $probe_center ||
            fail "$WB_GATE" "could not move onto the bound probe"
        cstate ".pointer_position != null and .pointer_position[0] >= $wb_bound_x and .pointer_position[1] >= $wb_bound_y and .pointer_position[0] < $((wb_bound_x + wb_bound_w)) and .pointer_position[1] < $((wb_bound_y + wb_bound_h))" "pointer inside the bound rect" 5 ||
            fail "$WB_GATE" "the pointer did not land inside the bound rect"
        wb_entered=""
        for _ in $(seq 1 20); do
            if "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" fresh-enter \
                --log "$ARTIFACTS/wb-cursor-probe.log" --offset "$wb_enter_mark" >/dev/null 2>&1; then wb_entered=1; break; fi
            sleep 0.25
        done
        [ -n "$wb_entered" ] ||
            fail "$WB_GATE" "no fresh pointer enter after the offset on the bound surface"
        "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" fresh-enter \
            --log "$ARTIFACTS/wb-cursor-probe.log" --offset "$wb_enter_mark" ||
            fail "$WB_GATE" "no fresh pointer enter strictly after the offset"
        kill -0 "$WB_PROBE_PID" 2>/dev/null ||
            fail "$WB_GATE" "the owned probe client died across the enter handshake"
        "$PY" "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" check \
            --cstate "$CSTATE" --owner "$ARTIFACTS/wb-probe-owner.json" \
            --pid "$WB_PROBE_PID" ||
            fail "$WB_GATE" "the owned probe binding broke across the enter handshake"
        wb_probe_start_after="$(wb_proc_start_ticks "$WB_PROBE_PID")" ||
            fail "$WB_GATE" "the owned probe start time is unreadable"
        [ "$wb_probe_start_after" = "$wb_probe_start_before" ] ||
            fail "$WB_GATE" "the owned probe client was replaced across the enter handshake"
    fi
    owner_rect="$(jq -c '.rect' "$ARTIFACTS/wb-probe-owner.json")" ||
        fail "$WB_GATE" "the bound probe rect went missing"
    if [ -z "$owner_rect" ] || [ "$owner_rect" = "null" ]; then
        fail "$WB_GATE" "the bound probe rect went missing"
    fi
    region_rect="$(jq -n --argjson r "$owner_rect" '[($r[0]+64),($r[1]+64),16,16]')" ||
        fail "$WB_GATE" "could not derive the sample region"
    jq -n --argjson rect "$region_rect" \
        '[{name:"wb-probe-texture",kind:"texture",rect:$rect}]' >"$ARTIFACTS/wb-regions.json" ||
        fail "$WB_GATE" "could not write the sample regions"
    xdotool mousemove --window "$WID" 20 $((HEIGHT - 20)) ||
        fail "$WB_GATE" "could not park the pointer away from the probe"
}

wb_pixel_preconditions() {
    gsettings set org.gnome.desktop.notifications show-banners false ||
        fail "$WB_GATE" "could not hold banners back"
    [ "$(gsettings get org.gnome.desktop.notifications show-banners)" = "false" ] ||
        fail "$WB_GATE" "DND did not hold"
    cstate '.motion_policy == "full"' "full motion" ||
        fail "$WB_GATE" "motion is not full; 3s ramps do not apply"
    cstate '(.overview_open | not) and .overview_progress == 0' "settled no overview" ||
        fail "$WB_GATE" "the overview overlaps the probe or is not settled"
    cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "no switcher" ||
        fail "$WB_GATE" "a switcher popup overlaps the probe"
    cstate '.wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "neutral" ||
        fail "$WB_GATE" "effects are not neutral at gate start"
}

# The shell logs its request before the compositor applies it, and CSTATE
# publishes the applied effects BEFORE rendering/submitting the next frame.
# Observe neutral, then a strictly later submitted frame at the same frozen
# animation time before taking the single-shot pixel proof. Waiting for state
# alone can still capture the old faded framebuffer (installed CI 39247011409).
# The clock never advances here: a real fade-out cannot finish and still fails.
wb_await_off() {
    cstate '.wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1 and .wellbeing_effects.animating == false' \
        "compositor applied the disable" 5 ||
        fail "$1" "the compositor never reached neutral on the frozen clock (fade-out found)"
    wb_off_sample="$(jq -ce '
        select(.animation_clock_manual == true) |
        [.animation_clock_ms, .rendered_frames] |
        select(all(.[]; type == "number" and . >= 0 and . == floor))
    ' "$CSTATE")" ||
        fail "$1" "disable needs a typed frozen clock and submitted-frame counter"
    wb_off_clock="$(printf '%s\n' "$wb_off_sample" | jq '.[0]')"
    wb_off_frame="$(printf '%s\n' "$wb_off_sample" | jq '.[1]')"
    cstate ".animation_clock_manual == true and .animation_clock_ms == $wb_off_clock and (.rendered_frames | type) == \"number\" and .rendered_frames > $wb_off_frame and .rendered_frames == (.rendered_frames | floor) and .wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1 and .wellbeing_effects.animating == false" \
        "neutral frame submitted on the frozen clock" 5 ||
        fail "$1" "no neutral frame was submitted on the unchanged frozen clock"
}

wb_capture() {
    label="$1"
    cstate '.animation_clock_manual == true and (.animation_clock_ms | type) == "number" and .animation_clock_ms >= 0 and .animation_clock_ms == (.animation_clock_ms | floor)' "manual capture clock" ||
        fail "$WB_GATE" "pixel capture $label requires a typed manual animation clock"
    png="$ARTIFACTS/wb-$label.png"
    cstate_before="$ARTIFACTS/wb-$label-cstate-before.json"
    cstate_after="$ARTIFACTS/wb-$label-cstate-after.json"
    proc_before_file="$ARTIFACTS/wb-$label-proc-before.json"
    proc_after_file="$ARTIFACTS/wb-$label-proc-after.json"
    cp "$CSTATE" "$cstate_before" || fail "$WB_GATE" "compositor state missing before $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-snapshot \
        --probe "$WB_PROBE_PID" --compositor "$COMPOSITOR_PID" --shell "$WB_SHELL_PID" \
        >"$proc_before_file" ||
        fail "$WB_GATE" "capture-time process snapshot failed before $label"
    scrot "$png" >/dev/null || fail "$WB_GATE" "scrot failed for $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-snapshot \
        --probe "$WB_PROBE_PID" --compositor "$COMPOSITOR_PID" --shell "$WB_SHELL_PID" \
        >"$proc_after_file" ||
        fail "$WB_GATE" "capture-time process snapshot failed after $label"
    cp "$CSTATE" "$cstate_after" || fail "$WB_GATE" "compositor state missing after $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-sandwich \
        --before "$proc_before_file" --after "$proc_after_file" --label "$label" ||
        fail "$WB_GATE" "a capture-time process was replaced across $label"
    proc_json="$(cat "$proc_after_file")" ||
        fail "$WB_GATE" "capture-time process snapshot unreadable for $label"
    proc_before_json="$(cat "$proc_before_file")" ||
        fail "$WB_GATE" "capture-time process snapshot unreadable for $label"
    clk="$(jq -r '.animation_clock_ms // "null"' "$cstate_after")" ||
        fail "$WB_GATE" "clock unreadable after $label"
    epoch="$(date +%s)"
    iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    jq -n -c --arg label "$label" --arg image "$png" \
        --arg before "$cstate_before" --arg after "$cstate_after" \
        --argjson clock "$clk" --argjson epoch "$epoch" --arg iso "$iso" \
        --argjson proc "$proc_json" --argjson proc_before "$proc_before_json" \
        '{label:$label,image:$image,cstate_before:$before,cstate_after:$after,clock_ms:$clock,epoch:$epoch,iso:$iso,proc:$proc,proc_before:$proc_before}' \
        >>"$WB_CAPS_JSONL" || fail "$WB_GATE" "could not record $label"
}

# Live Delay/Skip schedules use wall time. Freeze only their resulting pixel
# capture, then restore wall time before the next action or cleanup.
wb_capture_after_live_action() {
    anim_clock 0
    cstate '.animation_clock_manual' "frozen capture clock" ||
        fail "$WB_GATE" "the clock did not freeze for the live-action capture"
    wb_capture "$1" || fail "$WB_GATE" "live-action pixel capture failed"
    rm -f "$TUNA_ANIMATION_CLOCK"
    cstate '.animation_clock_manual | not' "real clock" ||
        fail "$WB_GATE" "real time did not resume after the live-action capture"
}

wb_state_capture() {
    label="$1"
    cstate_before="$ARTIFACTS/wb-$label-cstate-before.json"
    cstate_after="$ARTIFACTS/wb-$label-cstate-after.json"
    proc_before_file="$ARTIFACTS/wb-$label-proc-before.json"
    proc_after_file="$ARTIFACTS/wb-$label-proc-after.json"
    cp "$CSTATE" "$cstate_before" || fail "$WB_GATE" "compositor state missing before $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-snapshot \
        --probe "$WB_PROBE_PID" --compositor "$COMPOSITOR_PID" --shell "$WB_SHELL_PID" \
        >"$proc_before_file" ||
        fail "$WB_GATE" "capture-time process snapshot failed before $label"
    cp "$CSTATE" "$cstate_after" || fail "$WB_GATE" "compositor state missing after $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-snapshot \
        --probe "$WB_PROBE_PID" --compositor "$COMPOSITOR_PID" --shell "$WB_SHELL_PID" \
        >"$proc_after_file" ||
        fail "$WB_GATE" "capture-time process snapshot failed after $label"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" proc-sandwich \
        --before "$proc_before_file" --after "$proc_after_file" --label "$label" ||
        fail "$WB_GATE" "a capture-time process was replaced across $label"
    proc_json="$(cat "$proc_after_file")" ||
        fail "$WB_GATE" "capture-time process snapshot unreadable for $label"
    proc_before_json="$(cat "$proc_before_file")" ||
        fail "$WB_GATE" "capture-time process snapshot unreadable for $label"
    epoch="$(date +%s)"
    iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    jq -n -c --arg label "$label" \
        --arg before "$cstate_before" --arg after "$cstate_after" \
        --argjson epoch "$epoch" --arg iso "$iso" \
        --argjson proc "$proc_json" --argjson proc_before "$proc_before_json" \
        '{label:$label,cstate_before:$before,cstate_after:$after,epoch:$epoch,iso:$iso,proc:$proc,proc_before:$proc_before}' \
        >>"$WB_STATE_JSONL" || fail "$WB_GATE" "could not record $label"
}

wb_provenance_finish() {
    comp_bin="$(readlink -f "/proc/$COMPOSITOR_PID/exe")"
    [ -n "$comp_bin" ] || fail "$WB_GATE" "the compositor binary went missing"
    kill -0 "$WB_SHELL_PID" 2>/dev/null || fail "$WB_GATE" "the shell process went missing"
    shell_bin="$(readlink -f "/proc/$WB_SHELL_PID/exe")"
    [ -n "$shell_bin" ] || fail "$WB_GATE" "the shell binary went missing"
    jq -n --arg c "$comp_bin" --arg s "$shell_bin" \
        --arg p "$ARTIFACTS/cursor-client/tuna-cursor-client" \
        --arg f "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" \
        --arg a "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" \
        --arg b "$ROOT/scripts/lib/tuna-wellbeing-probe-bind.py" \
        '{compositor:$c,shell:$s,probe:$p,frame_helper:$f,action_helper:$a,bind_helper:$b}' \
        >"$ARTIFACTS/wb-$WB_GATE-binaries.json"
    jq -s '.' "$WB_CAPS_JSONL" >"$ARTIFACTS/wb-$WB_GATE-captures.json"
    jq -s '.' "$WB_STATE_JSONL" >"$ARTIFACTS/wb-$WB_GATE-state-captures.json"
    commit="$(git -C "$ROOT" rev-parse HEAD)"
    [ -n "$commit" ] || fail "$WB_GATE" "source commit missing"
    "$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" provenance \
        --gate "$WB_GATE" --source-commit "$commit" \
        --binaries "$ARTIFACTS/wb-$WB_GATE-binaries.json" \
        --captures "$ARTIFACTS/wb-$WB_GATE-captures.json" \
        --state-captures "$ARTIFACTS/wb-$WB_GATE-state-captures.json" \
        --owner "$ARTIFACTS/wb-probe-owner.json" \
        --regions "$ARTIFACTS/wb-regions.json" \
        --gate-start "$WB_START" \
        --output "$ARTIFACTS/wb-$WB_GATE-provenance.json" ||
        fail "$WB_GATE" "provenance failed to close"
    if [ -s "$WB_STATE_JSONL" ]; then
        echo "tuna-gtk-shell-proof: $WB_GATE state-only evidence: $(jq -r '[.[].label] | join(", ")' "$ARTIFACTS/wb-$WB_GATE-state-captures.json")"
    fi
}

wb_step_ramp() {
    prefix="$1"
    file_base="$2"
    for step in 0 500 1000 1500 2000 2500 3000; do
        anim_clock $((file_base + step))
        cstate ".animation_clock_manual and .animation_clock_ms == $((WB_FROZEN + file_base + step))" \
            "$prefix at $step ms" ||
            fail "$WB_GATE" "the manual clock did not reach $((file_base + step))ms"
        sleep 0.5
        wb_capture "$prefix-$step"
    done
}

wb_limit_cleanup() {
    wb_mark="$(wc -c <"$LOG")"
    gsettings reset org.gnome.desktop.screen-time-limits daily-limit-enabled ||
        fail "$WB_GATE" "could not reset the daily limit"
    gsettings reset org.gnome.desktop.screen-time-limits daily-limit-seconds ||
        fail "$WB_GATE" "could not reset the limit seconds"
    end=$(($(date +%s) + 15))
    until tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: screen-time state Active" ||
        [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
    tail -c +"$((wb_mark + 1))" "$LOG" | grep -q "wellbeing: screen-time state Active" ||
        fail "$WB_GATE" "the tracker did not return to Active"
}

wb_break_cleanup() {
    gsettings reset org.gnome.desktop.break-reminders selected-breaks ||
        fail "$WB_GATE" "could not deselect breaks"
    gsettings reset org.gnome.desktop.break-reminders.eyesight interval-seconds ||
        fail "$WB_GATE" "could not reset the break interval"
    gsettings reset org.gnome.desktop.break-reminders.eyesight duration-seconds ||
        fail "$WB_GATE" "could not reset the break duration"
    gsettings reset org.gnome.desktop.break-reminders.eyesight delay-seconds ||
        fail "$WB_GATE" "could not reset the break delay"
    gsettings reset org.gnome.desktop.break-reminders.eyesight countdown ||
        fail "$WB_GATE" "could not reset the countdown"
    gsettings reset org.gnome.desktop.break-reminders.eyesight fade-screen ||
        fail "$WB_GATE" "could not reset fade-screen"
    gsettings reset org.gnome.desktop.break-reminders.eyesight lock-screen ||
        fail "$WB_GATE" "could not reset lock-screen"
    open_calendar
    # Disabling reminders destroys the break notice (GNOME), so the list
    # may be empty and Clear hidden; press it only when shown.
    wb_a11y_dump "$ARTIFACTS/a11y-wb-$WB_GATE-list.json" 20 ||
        fail "$WB_GATE" "message list dump failed"
    if showing "$ARTIFACTS/a11y-wb-$WB_GATE-list.json" "Clear"; then
        wb_a11y_dump "$ARTIFACTS/a11y-wb-$WB_GATE-cleared.json" 20 --press "Clear" ||
            fail "$WB_GATE" "could not press Clear"
    fi
    xdotool key Escape || fail "$WB_GATE" "could not close the calendar"
    xdotool mousemove --window "$WID" 20 $((HEIGHT - 20)) ||
        fail "$WB_GATE" "could not park the pointer"
    sleep 3
    wb_a11y_dump "$ARTIFACTS/a11y-wb-$WB_GATE-quiet.json" 20 ||
        fail "$WB_GATE" "quiet dump failed"
    if showing "$ARTIFACTS/a11y-wb-$WB_GATE-quiet.json" "Time for an Eyesight Break"; then
        fail "$WB_GATE" "a break banner outlived cleanup"
    fi
    if showing "$ARTIFACTS/a11y-wb-$WB_GATE-quiet.json" "Screen Time Limit Reached"; then
        fail "$WB_GATE" "a limit banner outlived cleanup"
    fi
}

# Gray-only: daily limit -> screen tick -> 0.35 grayscale -> desaturation
# 1.0, 3s EASE_OUT_QUAD entry, immediate disable on Active.
wb_gate_begin G-WELLBEING-PIXEL-GRAY
WB_WINDOWS_BEFORE="$(jq '.windows | length' "$CSTATE")"
wb_probe_ensure
wb_pixel_preconditions
# Freeze before the baseline: bracketed captures require identical
# typed manual-clock samples, and real time reports ms null.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-PIXEL-GRAY "the clock file did not freeze animation time"
WB_FROZEN="$(jq -r '.animation_clock_ms' "$CSTATE")"
wb_capture gray-baseline
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" owned-interior \
    --image "$ARTIFACTS/wb-gray-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --rgb 143,63,208 \
    --cstate-before "$ARTIFACTS/wb-gray-baseline-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-gray-baseline-cstate-after.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-gray-baseline-check.json" ||
    fail G-WELLBEING-PIXEL-GRAY "baseline is not the live owned probe interior (overlap?)"
gray_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.screen-time-limits grayscale true ||
    fail G-WELLBEING-PIXEL-GRAY "could not set grayscale"
gsettings set org.gnome.desktop.screen-time-limits daily-limit-seconds 10 ||
    fail G-WELLBEING-PIXEL-GRAY "could not set the daily limit"
gsettings set org.gnome.desktop.screen-time-limits daily-limit-enabled true ||
    fail G-WELLBEING-PIXEL-GRAY "could not enable the daily limit"
end=$(($(date +%s) + 25))
until tail -c +"$((gray_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=false" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((gray_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=false" ||
    fail G-WELLBEING-PIXEL-GRAY "no grayscale request reached the 0.35 wire"
wb_step_ramp gray-ramp 0
jq -s '[.[] | select(.label | startswith("gray-ramp-"))]' "$WB_CAPS_JSONL" \
    >"$ARTIFACTS/wb-gray-ramp-captures.json"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" ramp \
    --baseline "$ARTIFACTS/wb-gray-baseline.png" \
    --captures "$ARTIFACTS/wb-gray-ramp-captures.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --grayscale true --fade false \
    --start-clock-ms "$((WB_FROZEN + 0))" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-gray-ramp-check.json" ||
    fail G-WELLBEING-PIXEL-GRAY "the gray ramp diverged from 3s EASE_OUT_QUAD to 1.0"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" negative-neutral \
    --baseline "$ARTIFACTS/wb-gray-baseline.png" \
    --neutral "$ARTIFACTS/wb-gray-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 1 --brightness 1 ||
    fail G-WELLBEING-PIXEL-GRAY "neutral passed the gray assertion (weak test)"
wb_limit_cleanup
wb_await_off G-WELLBEING-PIXEL-GRAY
wb_capture gray-off
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" immediate-off \
    --baseline "$ARTIFACTS/wb-gray-baseline.png" \
    --current "$ARTIFACTS/wb-gray-off.png" \
    --cstate-before "$ARTIFACTS/wb-gray-off-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-gray-off-cstate-after.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --clock-ms "$((WB_FROZEN + 3000))" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-gray-off-check.json" ||
    fail G-WELLBEING-PIXEL-GRAY "disable was not immediate (fade-out found)"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '(.animation_clock_manual | not) and .wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "real neutral" ||
    fail G-WELLBEING-PIXEL-GRAY "real time did not resume neutral"
wb_provenance_finish
pass G-WELLBEING-PIXEL-GRAY "gray-only pixels ease 3s EASE_OUT_QUAD to full desaturation and disable immediately"

# Fade-only: break idle take -> 2s tick -> 0.35 fade -> brightness 0.6,
# 3s EASE_OUT_QUAD entry, immediate disable on Disabled.
wb_gate_begin G-WELLBEING-PIXEL-FADE
wb_probe_ensure
wb_pixel_preconditions
# Freeze before the baseline: bracketed captures require identical
# typed manual-clock samples, and real time reports ms null.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-PIXEL-FADE "the clock file did not freeze animation time"
WB_FROZEN="$(jq -r '.animation_clock_ms' "$CSTATE")"
wb_capture fade-baseline
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" owned-interior \
    --image "$ARTIFACTS/wb-fade-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --rgb 143,63,208 \
    --cstate-before "$ARTIFACTS/wb-fade-baseline-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-fade-baseline-cstate-after.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-fade-baseline-check.json" ||
    fail G-WELLBEING-PIXEL-FADE "baseline is not the live owned probe interior (overlap?)"
fade_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10 ||
    fail G-WELLBEING-PIXEL-FADE "could not set the break interval"
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 60 ||
    fail G-WELLBEING-PIXEL-FADE "could not set the break duration"
gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
    fail G-WELLBEING-PIXEL-FADE "could not silence the countdown OSD"
gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen true ||
    fail G-WELLBEING-PIXEL-FADE "could not set fade-screen"
gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen false ||
    fail G-WELLBEING-PIXEL-FADE "could not clear lock-screen"
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
    fail G-WELLBEING-PIXEL-FADE "could not select the eyesight break"
sleep 15
end=$(($(date +%s) + 15))
until tail -c +"$((fade_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=true" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((fade_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=true" ||
    fail G-WELLBEING-PIXEL-FADE "no fade request reached the 0.35 wire"
wb_step_ramp fade-ramp 0
jq -s '[.[] | select(.label | startswith("fade-ramp-"))]' "$WB_CAPS_JSONL" \
    >"$ARTIFACTS/wb-fade-ramp-captures.json"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" ramp \
    --baseline "$ARTIFACTS/wb-fade-baseline.png" \
    --captures "$ARTIFACTS/wb-fade-ramp-captures.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --grayscale false --fade true \
    --start-clock-ms "$((WB_FROZEN + 0))" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-fade-ramp-check.json" ||
    fail G-WELLBEING-PIXEL-FADE "the fade ramp diverged from 3s EASE_OUT_QUAD to 0.6"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" negative-neutral \
    --baseline "$ARTIFACTS/wb-fade-baseline.png" \
    --neutral "$ARTIFACTS/wb-fade-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 0 --brightness 0.6 ||
    fail G-WELLBEING-PIXEL-FADE "neutral passed the fade assertion (weak test)"
fade_off_mark="$(wc -c <"$LOG")"
gsettings reset org.gnome.desktop.break-reminders selected-breaks ||
    fail G-WELLBEING-PIXEL-FADE "could not deselect breaks"
end=$(($(date +%s) + 15))
until tail -c +"$((fade_off_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=false" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((fade_off_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=false" ||
    fail G-WELLBEING-PIXEL-FADE "no unfade after deselect"
wb_await_off G-WELLBEING-PIXEL-FADE
wb_capture fade-off
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" immediate-off \
    --baseline "$ARTIFACTS/wb-fade-baseline.png" \
    --current "$ARTIFACTS/wb-fade-off.png" \
    --cstate-before "$ARTIFACTS/wb-fade-off-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-fade-off-cstate-after.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --clock-ms "$((WB_FROZEN + 3000))" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-fade-off-check.json" ||
    fail G-WELLBEING-PIXEL-FADE "disable was not immediate (fade-out found)"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '(.animation_clock_manual | not) and .wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "real neutral" ||
    fail G-WELLBEING-PIXEL-FADE "real time did not resume neutral"
wb_break_cleanup
wb_provenance_finish
pass G-WELLBEING-PIXEL-FADE "fade-only pixels ease 3s EASE_OUT_QUAD to brightness 0.6 and disable immediately"

# Both-on: gray ramp settles first, then fade ramps while gray stays at
# 1.0 (independent 0.35 starts); endpoint is 1.0/0.6, disable immediate.
wb_gate_begin G-WELLBEING-PIXEL-BOTH
wb_probe_ensure
wb_pixel_preconditions
# Freeze before the baseline: bracketed captures require identical
# typed manual-clock samples, and real time reports ms null.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-PIXEL-BOTH "the clock file did not freeze animation time"
WB_FROZEN="$(jq -r '.animation_clock_ms' "$CSTATE")"
wb_capture both-baseline
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" owned-interior \
    --image "$ARTIFACTS/wb-both-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --rgb 143,63,208 \
    --cstate-before "$ARTIFACTS/wb-both-baseline-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-both-baseline-cstate-after.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-both-baseline-check.json" ||
    fail G-WELLBEING-PIXEL-BOTH "baseline is not the live owned probe interior (overlap?)"
both_gray_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.screen-time-limits grayscale true ||
    fail G-WELLBEING-PIXEL-BOTH "could not set grayscale"
gsettings set org.gnome.desktop.screen-time-limits daily-limit-seconds 10 ||
    fail G-WELLBEING-PIXEL-BOTH "could not set the daily limit"
gsettings set org.gnome.desktop.screen-time-limits daily-limit-enabled true ||
    fail G-WELLBEING-PIXEL-BOTH "could not enable the daily limit"
end=$(($(date +%s) + 25))
until tail -c +"$((both_gray_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=false" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((both_gray_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=false" ||
    fail G-WELLBEING-PIXEL-BOTH "no grayscale request reached the 0.35 wire"
wb_step_ramp both-gray 0
jq -s '[.[] | select(.label | startswith("both-gray-"))]' "$WB_CAPS_JSONL" \
    >"$ARTIFACTS/wb-both-gray-captures.json"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" ramp \
    --baseline "$ARTIFACTS/wb-both-baseline.png" \
    --captures "$ARTIFACTS/wb-both-gray-captures.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --grayscale true --fade false \
    --start-clock-ms "$((WB_FROZEN + 0))" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-both-gray-check.json" ||
    fail G-WELLBEING-PIXEL-BOTH "the gray phase diverged from 3s EASE_OUT_QUAD"
both_fade_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.break-reminders.eyesight interval-seconds 10 ||
    fail G-WELLBEING-PIXEL-BOTH "could not set the break interval"
gsettings set org.gnome.desktop.break-reminders.eyesight duration-seconds 60 ||
    fail G-WELLBEING-PIXEL-BOTH "could not set the break duration"
gsettings set org.gnome.desktop.break-reminders.eyesight countdown false ||
    fail G-WELLBEING-PIXEL-BOTH "could not silence the countdown OSD"
gsettings set org.gnome.desktop.break-reminders.eyesight fade-screen true ||
    fail G-WELLBEING-PIXEL-BOTH "could not set fade-screen"
gsettings set org.gnome.desktop.break-reminders.eyesight lock-screen false ||
    fail G-WELLBEING-PIXEL-BOTH "could not clear lock-screen"
gsettings set org.gnome.desktop.break-reminders selected-breaks "['eyesight']" ||
    fail G-WELLBEING-PIXEL-BOTH "could not select the eyesight break"
sleep 15
end=$(($(date +%s) + 15))
until tail -c +"$((both_fade_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=true" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((both_fade_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=true fade=true" ||
    fail G-WELLBEING-PIXEL-BOTH "no combined request reached the 0.35 wire"
wb_step_ramp both-fade 3000
jq -s '[.[] | select(.label | startswith("both-fade-"))]' "$WB_CAPS_JSONL" \
    >"$ARTIFACTS/wb-both-fade-captures.json"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" ramp \
    --baseline "$ARTIFACTS/wb-both-baseline.png" \
    --captures "$ARTIFACTS/wb-both-fade-captures.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --grayscale settled --fade true \
    --start-clock-ms "$((WB_FROZEN + 3000))" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-both-fade-check.json" ||
    fail G-WELLBEING-PIXEL-BOTH "the fade phase diverged while gray stayed settled"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" negative-neutral \
    --baseline "$ARTIFACTS/wb-both-baseline.png" \
    --neutral "$ARTIFACTS/wb-both-baseline.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 1 --brightness 0.6 ||
    fail G-WELLBEING-PIXEL-BOTH "neutral passed the combined assertion (weak test)"
wb_limit_cleanup
both_off_mark="$(wc -c <"$LOG")"
gsettings reset org.gnome.desktop.break-reminders selected-breaks ||
    fail G-WELLBEING-PIXEL-BOTH "could not deselect breaks"
end=$(($(date +%s) + 15))
until tail -c +"$((both_off_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=false" ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 1; done
tail -c +"$((both_off_mark + 1))" "$LOG" | grep -q "wellbeing: effect grayscale=false fade=false" ||
    fail G-WELLBEING-PIXEL-BOTH "no combined unfade after reset"
wb_await_off G-WELLBEING-PIXEL-BOTH
wb_capture both-off
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" immediate-off \
    --baseline "$ARTIFACTS/wb-both-baseline.png" \
    --current "$ARTIFACTS/wb-both-off.png" \
    --cstate-before "$ARTIFACTS/wb-both-off-cstate-before.json" \
    --cstate-after "$ARTIFACTS/wb-both-off-cstate-after.json" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --owner "$ARTIFACTS/wb-probe-owner.json" \
    --clock-ms "$((WB_FROZEN + 6000))" \
    --gate-start "$WB_START" \
    --receipt "$ARTIFACTS/wb-both-off-check.json" ||
    fail G-WELLBEING-PIXEL-BOTH "combined disable was not immediate (fade-out found)"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '(.animation_clock_manual | not) and .wellbeing_effects.desaturation == 0 and .wellbeing_effects.brightness == 1' "real neutral" ||
    fail G-WELLBEING-PIXEL-BOTH "real time did not resume neutral"
wb_break_cleanup
wb_provenance_finish
pass G-WELLBEING-PIXEL-BOTH "combined pixels settle at desaturation 1.0 and brightness 0.6 and disable immediately"

# Reset-to-neutral: with no effects desired, stepped animation time stays
# neutral (immediate disable leaves no restore fade behind).
wb_gate_begin G-WELLBEING-PIXEL-RESET
wb_probe_ensure
wb_pixel_preconditions
# Freeze before the baseline: bracketed captures require identical
# typed manual-clock samples, and real time reports ms null.
anim_clock 0
cstate '.animation_clock_manual' "frozen clock" ||
    fail G-WELLBEING-PIXEL-RESET "the clock file did not freeze animation time"
WB_FROZEN="$(jq -r '.animation_clock_ms' "$CSTATE")"
wb_capture reset-baseline
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" owned-interior \
