xdotool key Escape
sleep 1
# libnotify asks GetServerInformation before every Notify; the spec
# makes it mandatory and gnome-shell answers spec 1.2 (#843).
server_info="$(gdbus call --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.GetServerInformation 2>&1)" ||
    fail G-NOTIFY-SEND "GetServerInformation failed: $server_info"
echo "GetServerInformation: $server_info" >>"$ARTIFACTS/notify.log"
case "$server_info" in
    *"'1.2')") ;;
    *) fail G-NOTIFY-SEND "GetServerInformation answered $server_info, not spec 1.2" ;;
esac
notify-send -a "Tuna Desktop Proof" "Proof notify-send" "Sent with libnotify" >>"$ARTIFACTS/notify.log" 2>&1 ||
    fail G-NOTIFY-SEND "notify-send failed: $(tail -1 "$ARTIFACTS/notify.log")"
sleep 1
scrot "$ARTIFACTS/13b-notify-send.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-notify-send.json" 20 ||
    fail G-NOTIFY-SEND "accessibility dump failed"
showing "$ARTIFACTS/a11y-notify-send.json" "Proof notify-send" ||
    fail G-NOTIFY-SEND "no banner for the notify-send notification"
pass G-NOTIFY-SEND "notify-send (libnotify) gets server information and shows its banner"

# GNOME 51 panel.js sets messageTray.bannerBlocked while the date menu
# is open: the notification is only in the menu's list (#845). The open
# menu must show the title as often as the banner alone did (the list
# card and the banner card are built alike), not twice.
title_count() {
    jq --arg n "Proof notify-send" '[.[] | select(.showing and .name == $n)] | length' "$1"
}
banner_alone="$(title_count "$ARTIFACTS/a11y-notify-send.json")"
open_calendar
scrot "$ARTIFACTS/13c-banner-blocked.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-banner-blocked.json" 20 ||
    fail G-NOTIFY-BLOCKED "accessibility dump failed"
with_menu="$(title_count "$ARTIFACTS/a11y-banner-blocked.json")"
[ "$with_menu" -ge 1 ] || fail G-NOTIFY-BLOCKED "the date menu does not list the notification"
[ "$with_menu" = "$banner_alone" ] ||
    fail G-NOTIFY-BLOCKED "the banner stays drawn over the open date menu ($with_menu showing, $banner_alone from the banner alone)"
pass G-NOTIFY-BLOCKED "the banner hides while the date menu is open; the notification shows only in its list"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-blocked-cleared.json" 20 --press "Clear" ||
    fail G-NOTIFY-BLOCKED "could not press Clear"
sleep 1

xdotool key Escape
sleep 1
# Do Not Disturb from the quick-settings tile (the calendar's switch
# shares the same store).
xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-dnd.json" 20 --press "Do Not Disturb" ||
    fail G-NOTIFY-DND "could not press Do Not Disturb"
xdotool key Escape
sleep 1
notify "Quiet Note" "Held back by Do Not Disturb" || fail G-NOTIFY-DND "Notify call failed"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-dnd-banner.json" 20 ||
    fail G-NOTIFY-DND "accessibility dump failed"
if showing "$ARTIFACTS/a11y-dnd-banner.json" "Quiet Note"; then
    fail G-NOTIFY-DND "a banner showed with Do Not Disturb on"
fi
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-dnd-list.json" 20 ||
    fail G-NOTIFY-DND "accessibility dump failed"
showing "$ARTIFACTS/a11y-dnd-list.json" "Quiet Note" ||
    fail G-NOTIFY-DND "the held-back notification is missing from the list"
pass G-NOTIFY-DND "Do Not Disturb holds banners back but keeps the list"
scrot "$ARTIFACTS/14-dnd-list.png" >/dev/null

# GNOME 51 groups an app's notifications: collapsed, the newest card
# shows in full with the older ones peeking out under it; pressing the
# group expands it under a header with a Collapse button.
notify "Quiet Two" "A second note from the same app" || fail G-NOTIFY-GROUP "Notify call failed"
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-group.json" 20 ||
    fail G-NOTIFY-GROUP "accessibility dump failed"
scrot "$ARTIFACTS/14b-notification-group.png" >/dev/null
jq -e 'any(.[]; .name == "Tuna Desktop Proof" and (.role == "push button" or .role == "button") and .showing)' \
    "$ARTIFACTS/a11y-group.json" >/dev/null ||
    fail G-NOTIFY-GROUP "no collapsed group named for the app"
showing "$ARTIFACTS/a11y-group.json" "Quiet Two" ||
    fail G-NOTIFY-GROUP "the collapsed group does not show its newest card"
if showing "$ARTIFACTS/a11y-group.json" "Quiet Note"; then
    fail G-NOTIFY-GROUP "the older card shows in full in a collapsed group"
fi
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-group-open.json" 20 \
    --press "Tuna Desktop Proof" || fail G-NOTIFY-GROUP "could not press the group"
scrot "$ARTIFACTS/14c-notification-group-expanded.png" >/dev/null
for name in "Quiet Two" "Quiet Note" "Collapse"; do
    showing "$ARTIFACTS/a11y-group-open.json" "$name" ||
        fail G-NOTIFY-GROUP "the expanded group does not show \"$name\""
done
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-group-cleared.json" 20 \
    --press "Clear" || fail G-NOTIFY-GROUP "could not press Clear"
showing "$ARTIFACTS/a11y-group-cleared.json" "No Notifications" ||
    fail G-NOTIFY-GROUP "Clear did not empty the grouped list"
pass G-NOTIFY-GROUP "an app's notifications group, collapsed, and expand on press"
xdotool key Escape
# The next click belongs to the panel, after the calendar's popup grab
# has actually closed and returned pointer focus.
for _ in $(seq 1 20); do
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-group-closed.json" 20 || fail G-NOTIFY-GROUP "post-Escape calendar dump failed"
    showing "$ARTIFACTS/a11y-group-closed.json" "No Notifications" || break
    sleep 0.1
done
if showing "$ARTIFACTS/a11y-group-closed.json" "No Notifications"; then fail G-NOTIFY-GROUP "Escape did not close the calendar before opening quick settings"; fi

# Per-app notification policy (#348): the first notification registers
# the app in application-children so GNOME Settings lists it; disabling
# the app drops its banners and keeps it out of the list.
POLICY_APP="tuna-proof-notes"
POLICY_DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
POLICY_DESKTOP_FILE="$POLICY_DESKTOP_DIR/$POLICY_APP.desktop"
POLICY_CHILDREN_BEFORE=$(gsettings get org.gnome.desktop.notifications application-children)
POLICY_BANNERS_BEFORE=$(gsettings get org.gnome.desktop.notifications show-banners)
# Banners must be globally allowed for this gate; the key mirrors to the
# DND toggle live, whatever the preceding gates left behind.
gsettings set org.gnome.desktop.notifications show-banners true
sleep 1
mkdir -p "$POLICY_DESKTOP_DIR"
printf '[Desktop Entry]\nName=Tuna Proof Notes\nExec=true\nType=Application\n' >"$POLICY_DESKTOP_FILE"
notify_hinted "Policy First" "Filed while the app is enabled" || fail G-NOTIFY-POLICY "Notify call failed"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-first.json" 20 ||
    fail G-NOTIFY-POLICY "accessibility dump failed"
showing "$ARTIFACTS/a11y-policy-first.json" "Policy First" ||
    fail G-NOTIFY-POLICY "no banner for a notification from an enabled app"
gsettings get org.gnome.desktop.notifications application-children | grep -q "$POLICY_APP" ||
    fail G-NOTIFY-POLICY "the first notification did not register the app in application-children"
gsettings set "org.gnome.desktop.notifications.application:/org/gnome/desktop/notifications/application/$POLICY_APP/" enable false
sleep 1
notify_hinted "Policy Held" "Hidden while the app is disabled" || fail G-NOTIFY-POLICY "Notify call failed"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-held.json" 20 ||
    fail G-NOTIFY-POLICY "accessibility dump failed"
if showing "$ARTIFACTS/a11y-policy-held.json" "Policy Held"; then
    fail G-NOTIFY-POLICY "a disabled app's notification showed a banner"
fi
open_calendar
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-list.json" 20 ||
    fail G-NOTIFY-POLICY "accessibility dump failed"
# GNOME takes the disabled app's whole source out of the tray
# (`_onSourceEnableChanged`): what it filed while enabled hides too.
for policy_title in "Policy First" "Policy Held"; do
    if showing "$ARTIFACTS/a11y-policy-list.json" "$policy_title"; then
        fail G-NOTIFY-POLICY "the disabled app's \"$policy_title\" is in the list"
    fi
done
# Enabled again, its source comes back with both notifications.
gsettings set "org.gnome.desktop.notifications.application:/org/gnome/desktop/notifications/application/$POLICY_APP/" enable true
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-restored.json" 20 ||
    fail G-NOTIFY-POLICY "accessibility dump failed"
# The two come back as one collapsed group showing the newest; pressing
# the group (named for the app) shows both.
showing "$ARTIFACTS/a11y-policy-restored.json" "Policy Held" ||
    fail G-NOTIFY-POLICY "re-enabling the app did not bring \"Policy Held\" back to the list"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-restored-open.json" 20 \
    --press "Tuna Proof Notes" || fail G-NOTIFY-POLICY "could not press the restored group"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-restored-open.json" 20 ||
    fail G-NOTIFY-POLICY "accessibility dump failed"
for policy_title in "Policy First" "Policy Held"; do
    showing "$ARTIFACTS/a11y-policy-restored-open.json" "$policy_title" ||
        fail G-NOTIFY-POLICY "re-enabling the app did not bring \"$policy_title\" back to the list"
done
pass G-NOTIFY-POLICY "first notify registers the app; disabling it hides its banners and list entries, re-enabling brings them back"
# Leave the list empty and the settings as found for the next gates.
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-policy-cleared.json" 20 \
    --press "Clear" || fail G-NOTIFY-POLICY "could not press Clear"
showing "$ARTIFACTS/a11y-policy-cleared.json" "No Notifications" ||
    fail G-NOTIFY-POLICY "Clear did not empty the policy list"
xdotool key Escape
sleep 1
gsettings set org.gnome.desktop.notifications application-children "$POLICY_CHILDREN_BEFORE"
gsettings set org.gnome.desktop.notifications show-banners "$POLICY_BANNERS_BEFORE"
rm -f "$POLICY_DESKTOP_FILE"

# Quick-settings services (#55): each toggle is read back from its daemon.
sysprop() {
    gdbus call --system --dest "$1" --object-path "$2" \
        --method org.freedesktop.DBus.Properties.Get "$3" "$4" 2>>"$ARTIFACTS/stubs.log"
}
open_qs() {
    xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
    sleep 2
}
qs_press() {
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-$2.json" 20 --press "$1"
}
open_qs
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-qs-services.json" 20 ||
    fail G-QS-SERVICES "accessibility dump failed"
