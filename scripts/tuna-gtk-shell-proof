        --regions "$ARTIFACTS/wb-regions.json" \
        --desaturation "$desat" --brightness "$bright" ||
        fail G-WELLBEING-NEGATIVE "neutral passed the $name assertion (weak test)"
done
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" verify \
    --baseline "$ARTIFACTS/wb-gray-baseline.png" \
    --current "$ARTIFACTS/wb-gray-ramp-1500.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 0.75 --brightness 1 \
    --receipt "$ARTIFACTS/wb-negative-gray-mid-check.json" ||
    fail G-WELLBEING-NEGATIVE "the gray 1500ms intermediate diverged from 0.75"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-frame-proof.py" verify \
    --baseline "$ARTIFACTS/wb-fade-baseline.png" \
    --current "$ARTIFACTS/wb-fade-ramp-1500.png" \
    --regions "$ARTIFACTS/wb-regions.json" \
    --desaturation 0 --brightness 0.7 \
    --receipt "$ARTIFACTS/wb-negative-fade-mid-check.json" ||
    fail G-WELLBEING-NEGATIVE "the fade 1500ms intermediate diverged from 0.7"
cp "$CSTATE" "$ARTIFACTS/wb-negative-stale-before.json"
stale_code=0
wb_a11y_dump "$ARTIFACTS/a11y-wb-negative-stale.json" 20 --press "Take" >/dev/null 2>&1 || stale_code=$?
cp "$CSTATE" "$ARTIFACTS/wb-negative-stale-after.json"
wb_a11y_dump "$ARTIFACTS/a11y-wb-negative-retired.json" 20 ||
    fail G-WELLBEING-NEGATIVE "a11y bus dead or owned shell tree gone; retired UI cannot be qualified"
negative_retired_seq="$WB_DUMP_SEQ"
"$PY" "$ROOT/scripts/lib/tuna-wellbeing-action-proof.py" stale-press \
    --exit-code "$stale_code" \
    --before "$ARTIFACTS/wb-negative-stale-before.json" \
    --after "$ARTIFACTS/wb-negative-stale-after.json" \
    --action Take \
    --dump "$ARTIFACTS/a11y-wb-negative-retired.json" \
    --title "Time for an Eyesight Break" \
    --gate-start "$WB_START" \
    --expect-pid "$WB_SHELL_PID" \
    --expect-start "$WB_SHELL_START" \
    --stamp "$ARTIFACTS/a11y-wb-negative-retired.json.stamp" \
    --expect-gate G-WELLBEING-NEGATIVE \
    --expect-nonce "$WB_NONCE" \
    --expect-seq "$negative_retired_seq" ||
    fail G-WELLBEING-NEGATIVE "a post-cleanup stale Take press fired"
wb_capture_after_live_action negative-baseline
wb_provenance_finish
pass G-WELLBEING-NEGATIVE "neutral frames fail every effect assertion, intermediates hold, stale presses fail"

# Leave no trace for later gates: close the owned probe, restore the
# journey's DND state and real animation time.
if [ -n "$WB_PROBE_PID" ]; then
    kill "$WB_PROBE_PID" 2>/dev/null || true
    wait "$WB_PROBE_PID" 2>/dev/null || true
    WB_PROBE_PID=""
fi
cstate ".windows | length == $WB_WINDOWS_BEFORE" "probe closed" ||
    fail G-WELLBEING-NEGATIVE "the owned probe did not close"
gsettings set org.gnome.desktop.notifications show-banners "$DND_BEFORE" ||
    fail G-WELLBEING-NEGATIVE "could not restore DND"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '(.animation_clock_manual | not)' "real clock" ||
    fail G-WELLBEING-NEGATIVE "the animation clock did not resume"

# org.gnome.Shell for gnome-settings-daemon: a caller outside GNOME's
# allowlist is refused; the media-keys daemon's grab takes the key away
# from apps, fires AcceleratorActivated, and its ShowOSD shows the OSD.
if gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method org.gnome.Shell.GrabAccelerator "<Super>F9" 1 0 >/dev/null 2>&1; then
    fail G-ACCEL "a caller outside the allowlist grabbed an accelerator"
fi
ACCEL_MARKER="$ARTIFACTS/accel-marker"
rm -f "$ACCEL_MARKER"
"$PY" "$ROOT/scripts/lib/tuna-accel-probe.py" "$ACCEL_MARKER" >"$ARTIFACTS/accel.log" 2>&1 &
ACCEL_PID=$!
end=$(($(date +%s) + 10))
until grep -q grabbed "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "grabbed [1-9]" "$ACCEL_MARKER" 2>/dev/null ||
    fail G-ACCEL "the media-keys stand-in could not grab XF86AudioPlay"
xdotool key XF86AudioPlay
end=$(($(date +%s) + 5))
until grep -q activated "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "activated" "$ACCEL_MARKER" ||
    fail G-ACCEL "pressing the grabbed key fired no AcceleratorActivated"
sleep 0.5
scrot "$ARTIFACTS/24b-osd.png" >/dev/null
pass G-ACCEL "gnome-settings-daemon's grab fires on its key and its ShowOSD shows the OSD"
# The stand-in owns org.gnome.SettingsDaemon.MediaKeys, so while it runs the
# shell leaves the media keys to it. End it: the native proofs below run on
# the native bindings, as the nested preview (no gsd-media-keys) has them.
accel_off="$(log_mark)"
kill "$ACCEL_PID" 2>/dev/null || true
wait "$ACCEL_PID" 2>/dev/null || true
ACCEL_PID=""
log_wait "$accel_off" "tuna-shell-gtk: media keys: no gsd-media-keys, native volume and lock bindings" 10 ||
    fail G-MEDIA-VOLUME "the shell did not take the media keys back when the stand-in left"

# Native media actions work even without gsd-media-keys. These assert
# the actual asynchronous backend mutations, including GNOME's unmute rule.
touch "$TUNA_MEDIA_DIAGNOSTICS"
media_mark() { "$PY" "$ROOT/scripts/lib/media-causal-trace.py" "$ARTIFACTS" marker "$$" "$1"; }
media_mark begin
MEDIA_SHELL_PID="$(pgrep -P "$COMPOSITOR_PID" -x tuna-shell-gtk)" ||
    fail G-MEDIA-VOLUME "expected exactly one owned shell"
case "$MEDIA_SHELL_PID" in
    ''|0|*[!0-9]*) fail G-MEDIA-VOLUME "expected exactly one owned shell" ;;
esac
"$PY" - "$MEDIA_SHELL_PID" "$ARTIFACTS/media-completion-owner.json" <<'PY_MEDIA_OWNER'
import json, pathlib, sys
pid = int(sys.argv[1])
fields = (pathlib.Path('/proc') / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
pathlib.Path(sys.argv[2]).write_text(json.dumps({'pid': pid, 'start_ticks': int(fields[19])}) + '\n')
PY_MEDIA_OWNER
MEDIA_SINCE=0
MEDIA_KIND=idle
media_wait() {
    policy="$(gsettings get org.gnome.desktop.sound allow-volume-above-100-percent)"
    "$PY" "$ROOT/scripts/lib/media-completion-barrier.py" --log "$LOG" \
        --pid "$MEDIA_SHELL_PID" --owner "$ARTIFACTS/media-completion-owner.json" \
        --since "$MEDIA_SINCE" --kind "$MEDIA_KIND" --policy "$policy" \
        --receipt "$ARTIFACTS/media-completion-last.json" ||
        fail G-MEDIA-VOLUME "actual owned key/clamp callbacks did not settle"
}
media_policy() {
    old_policy="$(gsettings get org.gnome.desktop.sound allow-volume-above-100-percent)"
    if [ "$old_policy" != "$1" ]; then
        MEDIA_SINCE="$("$PY" -c 'import time; print(time.monotonic_ns())')"
        MEDIA_KIND=clamp
    fi
    gsettings set org.gnome.desktop.sound allow-volume-above-100-percent "$1"
    media_wait
}
media_key() {
    MEDIA_SINCE="$("$PY" -c 'import time; print(time.monotonic_ns())')"
    MEDIA_KIND=key
    xdotool key "$@"
    media_wait
}
media_baseline() {
    media_wait
    echo "$1" >"$VOLUME_FILE"
}
# Force one real settings callback before the first baseline; no value/idle
# inference and no dependency on incidental AudioUi monitor polling.
original_policy="$(gsettings get org.gnome.desktop.sound allow-volume-above-100-percent)"
if [ "$original_policy" = false ]; then media_policy true; else media_policy false; fi
media_policy "$original_policy"
media_baseline 0.40
echo 0 >"$VOLUME_MUTED_FILE"
media_volume() {
    expected=$1
    for _ in $(seq 1 30); do
        [ "$(cat "$VOLUME_FILE")" = "$expected" ] && return 0
        sleep 0.1
    done
    return 1
}
media_key XF86AudioRaiseVolume
media_volume 0.4600 || fail G-MEDIA-VOLUME "volume up did not apply the 6% step"
media_key XF86AudioLowerVolume
media_volume 0.4000 || fail G-MEDIA-VOLUME "volume down did not apply the 6% step"
media_key shift+XF86AudioRaiseVolume
media_volume 0.4200 || fail G-MEDIA-VOLUME "precise volume up did not use 2%"
media_key XF86AudioMute
for _ in $(seq 1 30); do [ "$(cat "$VOLUME_MUTED_FILE")" = 1 ] && break; sleep 0.1; done
[ "$(cat "$VOLUME_MUTED_FILE")" = 1 ] || fail G-MEDIA-VOLUME "volume mute did not mute"
media_key XF86AudioRaiseVolume
for _ in $(seq 1 30); do [ "$(cat "$VOLUME_MUTED_FILE")" = 0 ] && break; sleep 0.1; done
if [ "$(cat "$VOLUME_MUTED_FILE")" != 0 ] || [ "$(cat "$VOLUME_FILE")" != 0.4200 ]; then
    fail G-MEDIA-VOLUME "unmuting increased or lost the existing volume"
fi
media_key XF86AudioMicMute
for _ in $(seq 1 30); do [ "$(cat "$MIC_MUTED_FILE")" = 1 ] && break; sleep 0.1; done
[ "$(cat "$MIC_MUTED_FILE")" = 1 ] || fail G-MEDIA-VOLUME "microphone mute did not mute"
media_key XF86AudioMicMute
for _ in $(seq 1 30); do [ "$(cat "$MIC_MUTED_FILE")" = 0 ] && break; sleep 0.1; done
[ "$(cat "$MIC_MUTED_FILE")" = 0 ] || fail G-MEDIA-VOLUME "microphone unmute did not unmute"
# This headed fixture uses a wpctl stand-in; the native VM separately checks
# actual HDA/PipeWire channel volume. Same live shell and real hardware keys.
SOUND_SCHEMA=org.gnome.desktop.sound
media_policy false
sleep 0.3
media_baseline 0.98
media_key XF86AudioRaiseVolume
media_volume 1.0000 || fail G-MEDIA-AMPLIFICATION "disabled amplification did not cap at 100%"
media_policy true
sleep 0.3
media_baseline 0.98
media_key XF86AudioRaiseVolume
media_volume 1.0400 || fail G-MEDIA-AMPLIFICATION "live enabled amplification did not cross 100%"
media_baseline 1.50
media_key XF86AudioRaiseVolume
media_volume 1.5252 || fail G-MEDIA-AMPLIFICATION "amplified key did not obey GNOME's +11dB limit"
media_policy false
sleep 0.3
media_baseline 0.98
media_key XF86AudioRaiseVolume
media_volume 1.0000 || fail G-MEDIA-AMPLIFICATION "live disable did not restore the ordinary limit"
media_mark amplification-reset-before
gsettings reset "$SOUND_SCHEMA" allow-volume-above-100-percent
media_mark amplification-reset-after
media_baseline 0.4200
media_mark baseline-written
pass G-MEDIA-AMPLIFICATION "same shell follows live opt-in and reset; native VM qualifies real PipeWire separately"

# Live rebinding and an empty static array must take effect without restart.
MEDIA_SCHEMA=org.gnome.settings-daemon.plugins.media-keys
media_mark static-disable-before
gsettings set "$MEDIA_SCHEMA" volume-up-static '[]'
media_mark static-disable-after
sleep 0.7
media_mark disabled-key-before
cp "$CSTATE" "$ARTIFACTS/media-before-disabled-key.json"
xdotool key XF86AudioRaiseVolume
media_mark disabled-key-after
sleep 0.7
media_mark disabled-check
cp "$CSTATE" "$ARTIFACTS/media-after-disabled-key.json"
[ "$(cat "$VOLUME_FILE")" = 0.4200 ] || fail G-MEDIA-VOLUME "an explicitly disabled hardware key still changed volume"
gsettings set "$MEDIA_SCHEMA" volume-up "['F8']"
gsettings set "$MEDIA_SCHEMA" volume-step 10
sleep 0.7
MEDIA_SINCE="$("$PY" -c 'import time; print(time.monotonic_ns())')"
MEDIA_KIND=key
fkey_tap "" ffc5 || fail G-MEDIA-VOLUME "F8 tap failed"
media_wait
media_volume 0.5200 || fail G-MEDIA-VOLUME "live rebound volume key ignored the configured step"
gsettings reset "$MEDIA_SCHEMA" volume-up
gsettings reset "$MEDIA_SCHEMA" volume-up-static
gsettings reset "$MEDIA_SCHEMA" volume-step
sleep 0.7
media_baseline 0.4200
scrot "$ARTIFACTS/media-volume-osd.png" >/dev/null
rm -f "$TUNA_MEDIA_DIAGNOSTICS"
pass G-MEDIA-VOLUME "native volume/precise/mute/microphone keys mutate PipeWire state; unmute preserves the level"

# gnome-settings-daemon's real gsd-media-keys against this same shell
# (G-GSD-*). A hardware session starts it (tuna-session.target); the nested
# preview does not, which is why the native proofs above remain the
# fallback. CI runs the distribution's build (Ubuntu's gnome-settings-daemon
# is older than GNOME 51; gsd-media-keys/version.txt records which): its
# media-keys plugin speaks the same org.gnome.Shell GrabAccelerators /
# AcceleratorActivated / ShowOSD contract. gsd changes a real PipeWire
# through pipewire-pulse (libgvc), while the native path only ever reaches
# the wpctl stand-in, so a double-handled key shows on either side.
GSD_DIR="$ARTIFACTS/gsd-media-keys"
GSD_BIN=""
for candidate in /usr/libexec/gsd-media-keys /usr/lib/gsd-media-keys; do
    if [ -x "$candidate" ]; then GSD_BIN="$candidate"; break; fi
done
gsd_now() { "$PY" -c 'import time; print(time.monotonic_ns())'; }
gsd_bus() { "$PY" "$ROOT/scripts/lib/gsd-media-keys-bus.py" "$@"; }
# Run "$@" until it succeeds, for at most $1 seconds.
gsd_until() {
    gsd_end=$(($(date +%s) + $1))
    shift
    until "$@"; do
        [ "$(date +%s)" -lt "$gsd_end" ] || return 1
        sleep 0.2
    done
}
# "0.40", or "0.40 [MUTED]", from the real wpctl (never the stand-in).
real_volume() { "$WPCTL_REAL" get-volume "$1" 2>/dev/null | sed -n 's/^Volume: //p'; }
real_volume_is() { [ "$(real_volume "$1")" = "$2" ]; }
real_muted() { real_volume "$1" | grep -q '\[MUTED\]'; }
real_unmuted() {
    gsd_vol="$(real_volume "$1")"
    [ -n "$gsd_vol" ] && [ "$gsd_vol" = "${gsd_vol%\[MUTED\]}" ]
}
real_moved() {
    gsd_vol="$(real_volume "$1")"
    [ -n "$gsd_vol" ] && [ "$gsd_vol" != "$2" ]
}
gsd_owner() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetNameOwner org.gnome.SettingsDaemon.MediaKeys 2>/dev/null |
        sed -n "s/^('\(:[0-9.]*\)',)\$/\1/p"
}
gsd_released() { [ -z "$(gsd_owner)" ]; }
gsd_node_id() {
    "$PW_DUMP_REAL" 2>/dev/null | jq -r --arg n "$1" \
        '.[] | select(.type == "PipeWire:Interface:Node" and .info.props["node.name"] == $n) | .id' | head -1
}
gsd_node_ready() { [ -n "$(gsd_node_id "$1")" ]; }
gsd_default_is() { "$WPCTL_REAL" inspect "$1" 2>/dev/null | grep -qF "node.name = \"$2\""; }
# gsd's libgvc client has reached pipewire-pulse.
gsd_audio_client() {
    "$PW_DUMP_REAL" 2>/dev/null | jq -e --arg pid "$GSD_MEDIA_KEYS_PID" \
        'any(.[]; .type == "PipeWire:Interface:Client" and
            (((.info.props["application.process.id"] // "") | tostring) == $pid or
             .info.props["application.process.binary"] == "gsd-media-keys"))' >/dev/null
}
gsd_fixture() { cat "$VOLUME_FILE" "$VOLUME_MUTED_FILE" "$MIC_FILE" "$MIC_MUTED_FILE" | tr '\n' ' '; }
# The native path left the stand-in alone and logged no media action, and
# the key fired gsd's grab exactly once ($1 gate, $2 log offset, $3 action,
# $4 monotonic time of the press, $5 the stand-in's state before).
gsd_once() {
    sleep 0.5
    [ "$(gsd_bus native "$LOG" "$2")" = 0 ] || fail "$1" "the shell's native media path ran while gsd-media-keys owned the keys"
    [ "$(gsd_fixture)" = "$5" ] || fail "$1" "the native wpctl stand-in changed while gsd-media-keys owned the keys"
    [ "$(gsd_bus activations "$GSD_DIR/bus.jsonl" "$3" "$4")" = 1 ] ||
        fail "$1" "the key did not fire gsd's grab $3 exactly once"
}
gsd_media_keys_proof() {
    mkdir -p "$GSD_DIR"
    {
        echo "binary: $GSD_BIN"
        dpkg-query -W gnome-settings-daemon 2>/dev/null || pacman -Q gnome-settings-daemon 2>/dev/null ||
            echo "package: unknown"
        echo "parity target: GNOME 51 gnome-settings-daemon; this is the host distribution's build"
    } >"$GSD_DIR/version.txt"
    cat "$GSD_DIR/version.txt"
    # libgvc speaks the PulseAudio protocol: pipewire-pulse on the proof's
    # private PipeWire, with a null speaker and microphone as the defaults.
    gsd_pulse="unix:$XDG_RUNTIME_DIR/pulse/native"
    pipewire-pulse >"$GSD_DIR/pipewire-pulse.log" 2>&1 &
    PW_PULSE_PID=$!
    gsd_until 10 test -S "$XDG_RUNTIME_DIR/pulse/native" ||
        fail G-GSD-MEDIA-OWNER "pipewire-pulse did not open its socket"
    "$PW_CLI_REAL" create-node adapter '{ factory.name=support.null-audio-sink node.name=tuna-gsd-proof-sink node.description="Tuna Proof Speakers" media.class=Audio/Sink object.linger=true audio.position=[FL FR] }' \
        >"$GSD_DIR/pw-cli-sink.txt" 2>&1 || fail G-GSD-MEDIA-OWNER "could not create the PipeWire sink"
    "$PW_CLI_REAL" create-node adapter '{ factory.name=support.null-audio-sink node.name=tuna-gsd-proof-source node.description="Tuna Proof Microphone" media.class=Audio/Source object.linger=true audio.position=[FL FR] }' \
        >"$GSD_DIR/pw-cli-source.txt" 2>&1 || fail G-GSD-MEDIA-OWNER "could not create the PipeWire source"
    gsd_until 10 gsd_node_ready tuna-gsd-proof-sink || fail G-GSD-MEDIA-OWNER "the PipeWire sink never appeared"
    gsd_until 10 gsd_node_ready tuna-gsd-proof-source || fail G-GSD-MEDIA-OWNER "the PipeWire source never appeared"
    gsd_sink="$(gsd_node_id tuna-gsd-proof-sink)"
    gsd_source="$(gsd_node_id tuna-gsd-proof-source)"
    "$WPCTL_REAL" set-default "$gsd_sink"
    "$WPCTL_REAL" set-default "$gsd_source"
    gsd_until 10 gsd_default_is @DEFAULT_AUDIO_SINK@ tuna-gsd-proof-sink ||
        fail G-GSD-MEDIA-OWNER "the proof sink did not become the default"
    gsd_until 10 gsd_default_is @DEFAULT_AUDIO_SOURCE@ tuna-gsd-proof-source ||
        fail G-GSD-MEDIA-OWNER "the proof source did not become the default"
    "$WPCTL_REAL" set-volume @DEFAULT_AUDIO_SINK@ 0.40
    "$WPCTL_REAL" set-mute @DEFAULT_AUDIO_SINK@ 0
    "$WPCTL_REAL" set-mute @DEFAULT_AUDIO_SOURCE@ 0
    gsd_until 5 real_volume_is @DEFAULT_AUDIO_SINK@ 0.40 || fail G-GSD-MEDIA-OWNER "could not set the sink baseline"
    gsd_until 5 real_unmuted @DEFAULT_AUDIO_SOURCE@ || fail G-GSD-MEDIA-OWNER "could not unmute the source"
    # XF86WWW's handler: a private default x-scheme-handler/http app whose
    # Exec leaves a marker (gsd's do_url_action launches the default).
    gsd_www_marker="$GSD_DIR/www-launched"
    rm -f "$gsd_www_marker"
    cat >"$ARTIFACTS/bin/tuna-gsd-www-probe" <<WWW_PROBE
#!/bin/sh
printf 'launched with %s arguments\n' "\$#" >>"$gsd_www_marker"
WWW_PROBE
    chmod +x "$ARTIFACTS/bin/tuna-gsd-www-probe"
    cat >"$XDG_DATA_HOME/applications/tuna-gsd-www-probe.desktop" <<WWW_DESKTOP
[Desktop Entry]
Name=Tuna Proof Browser
Exec=$ARTIFACTS/bin/tuna-gsd-www-probe %u
Type=Application
MimeType=x-scheme-handler/http;
NoDisplay=true
WWW_DESKTOP
    cp "$XDG_CONFIG_HOME/mimeapps.list" "$GSD_DIR/mimeapps.list.before"
    gio mime x-scheme-handler/http tuna-gsd-www-probe.desktop >"$GSD_DIR/gio-mime.txt" 2>&1 ||
        fail G-GSD-LAUNCHER "could not make the probe the default http handler"
    # The very lookup gsd's do_url_action makes.
    "$PY" -c 'import sys; from gi.repository import Gio; a = Gio.AppInfo.get_default_for_uri_scheme("http"); sys.exit(not a or a.get_id() != sys.argv[1])' \
        tuna-gsd-www-probe.desktop ||
        fail G-GSD-LAUNCHER "the probe is not the default http handler"
    # Witness every org.gnome.Shell call, reply and signal on the bus.
    gsd_bus monitor "$GSD_DIR/bus.jsonl" "$GSD_DIR/bus-ready" 600 >"$GSD_DIR/bus-monitor.log" 2>&1 &
    GSD_BUS_PID=$!
    gsd_until 10 test -s "$GSD_DIR/bus-ready" || fail G-GSD-MEDIA-OWNER "the session bus monitor did not start"
    "$PY" "$ROOT/scripts/lib/tuna-mpris-player-stub.py" "$GSD_DIR/mpris-calls" 600 >"$GSD_DIR/mpris.log" 2>&1 &
    MPRIS_PID=$!
    gsd_until 10 grep -qsx ready "$GSD_DIR/mpris-calls" || fail G-GSD-MPRIS "the MPRIS player did not own its name"
    gsd_fixture_before="$(gsd_fixture)"
    touch "$TUNA_MEDIA_DIAGNOSTICS"

    gsd_off="$(log_mark)"
    env -u DISPLAY GDK_BACKEND=wayland WAYLAND_DISPLAY="$SOCKET_NAME" PULSE_SERVER="$gsd_pulse" \
        "$GSD_BIN" --verbose >"$GSD_DIR/gsd-media-keys.log" 2>&1 &
    GSD_MEDIA_KEYS_PID=$!
    GSD_OWNER=""
    gsd_end=$(($(date +%s) + 20))
    while [ -z "$GSD_OWNER" ]; do
        kill -0 "$GSD_MEDIA_KEYS_PID" 2>/dev/null || fail G-GSD-MEDIA-OWNER "gsd-media-keys exited during startup"
        [ "$(date +%s)" -le "$gsd_end" ] ||
            fail G-GSD-MEDIA-OWNER "gsd-media-keys never owned org.gnome.SettingsDaemon.MediaKeys"
        sleep 0.3
        GSD_OWNER="$(gsd_owner)"
    done
    gsd_owner_pid="$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetConnectionUnixProcessID "$GSD_OWNER" | sed -n 's/^(uint32 \([0-9]*\),)$/\1/p')"
    [ "$gsd_owner_pid" = "$GSD_MEDIA_KEYS_PID" ] ||
        fail G-GSD-MEDIA-OWNER "org.gnome.SettingsDaemon.MediaKeys is owned by pid $gsd_owner_pid, not gsd-media-keys"
    log_wait "$gsd_off" "tuna-shell-gtk: media keys: gsd-media-keys owns the media-keys bindings" 10 ||
        fail G-GSD-MEDIA-OWNER "the shell did not hand the media keys to gsd-media-keys"
    gsd_grabs="$(gsd_bus grabs "$GSD_DIR/bus.jsonl" "$GSD_OWNER" \
        XF86AudioMicMute XF86AudioRaiseVolume XF86AudioPlay XF86WWW --timeout 20)" ||
        fail G-GSD-MEDIA-OWNER "org.gnome.Shell refused gsd-media-keys' grabs"
    printf '%s\n' "$gsd_grabs" >"$GSD_DIR/grabs.json"
    gsd_mic="$(printf '%s' "$gsd_grabs" | jq -r .XF86AudioMicMute)"
    gsd_raise="$(printf '%s' "$gsd_grabs" | jq -r .XF86AudioRaiseVolume)"
    gsd_play="$(printf '%s' "$gsd_grabs" | jq -r .XF86AudioPlay)"
    gsd_www="$(printf '%s' "$gsd_grabs" | jq -r .XF86WWW)"
    # ... and the shell handed exactly those grabs to the compositor.
    gsd_bus forwarded "$LOG" "$gsd_off" "$gsd_mic" 269025202 --timeout 10 ||
        fail G-GSD-MEDIA-OWNER "the compositor never received gsd's XF86AudioMicMute grab"
    gsd_bus forwarded "$LOG" "$gsd_off" "$gsd_raise" 269025043 --timeout 10 ||
        fail G-GSD-MEDIA-OWNER "the compositor never received gsd's XF86AudioRaiseVolume grab"
    pass G-GSD-MEDIA-OWNER "gsd-media-keys owns MediaKeys; the shell stands down and gsd's MicMute/RaiseVolume/Play/WWW grabs succeed"

    gsd_until 15 gsd_audio_client || fail G-GSD-MIC-MUTE "gsd-media-keys never connected to pipewire-pulse"
    # Its mixer learns the defaults, and the last OSD (if any) hides (1.5 s),
    # so this one fades in.
    sleep 2
    gsd_off="$(log_mark)"
    gsd_since="$(gsd_now)"
    xdotool key XF86AudioMicMute
    gsd_until 5 real_muted @DEFAULT_AUDIO_SOURCE@ || fail G-GSD-MIC-MUTE "XF86AudioMicMute did not mute the default source"
    gsd_bus osd "$GSD_DIR/bus.jsonl" "$GSD_OWNER" "$gsd_since" microphone-sensitivity-muted-symbolic --timeout 5 ||
        fail G-GSD-MIC-MUTE "gsd-media-keys showed no muted-microphone OSD"
    log_wait "$gsd_off" "tuna-shell-gtk: transient osd " 5 || fail G-GSD-MIC-MUTE "the shell did not show gsd's OSD"
    scrot "$GSD_DIR/mic-muted-osd.png" >/dev/null
    [ "$(gsd_bus fired "$LOG" "$gsd_off" "$gsd_mic")" = 1 ] ||
        fail G-GSD-MIC-MUTE "the compositor did not fire gsd's XF86AudioMicMute grab once"
    gsd_once G-GSD-MIC-MUTE "$gsd_off" "$gsd_mic" "$gsd_since" "$gsd_fixture_before"
    gsd_since="$(gsd_now)"
    xdotool key XF86AudioMicMute
    gsd_until 5 real_unmuted @DEFAULT_AUDIO_SOURCE@ || fail G-GSD-MIC-MUTE "a second XF86AudioMicMute did not unmute"
    gsd_bus osd "$GSD_DIR/bus.jsonl" "$GSD_OWNER" "$gsd_since" microphone-sensitivity-low-symbolic \
        microphone-sensitivity-medium-symbolic microphone-sensitivity-high-symbolic --timeout 5 ||
        fail G-GSD-MIC-MUTE "gsd-media-keys showed no unmuted-microphone OSD"
    gsd_once G-GSD-MIC-MUTE "$gsd_off" "$gsd_mic" "$gsd_since" "$gsd_fixture_before"
    pass G-GSD-MIC-MUTE "gsd mutes and unmutes the default PipeWire source and shows its microphone OSD; native path silent"

    gsd_off="$(log_mark)"
    gsd_since="$(gsd_now)"
    xdotool key XF86AudioRaiseVolume
    gsd_until 5 real_moved @DEFAULT_AUDIO_SINK@ 0.40 || fail G-GSD-VOLUME-ONCE "XF86AudioRaiseVolume did not change the sink"
    gsd_bus osd "$GSD_DIR/bus.jsonl" "$GSD_OWNER" "$gsd_since" audio-volume-low-symbolic \
        audio-volume-medium-symbolic audio-volume-high-symbolic --timeout 5 ||
        fail G-GSD-VOLUME-ONCE "gsd-media-keys showed no volume OSD"
    # A second handler of the same press would have landed by now.
    sleep 1.5
    gsd_after="$(real_volume @DEFAULT_AUDIO_SINK@)"
    echo "$gsd_after" >"$GSD_DIR/sink-after-raise.txt"
    "$PY" -c 'import sys; sys.exit(abs(float(sys.argv[1]) - 0.40 - 0.06) > 0.011)' "$gsd_after" ||
        fail G-GSD-VOLUME-ONCE "one press moved the sink from 0.40 to $gsd_after, not one 6% step"
    [ "$(gsd_bus fired "$LOG" "$gsd_off" "$gsd_raise")" = 1 ] ||
        fail G-GSD-VOLUME-ONCE "the compositor did not fire gsd's XF86AudioRaiseVolume grab once"
    gsd_once G-GSD-VOLUME-ONCE "$gsd_off" "$gsd_raise" "$gsd_since" "$gsd_fixture_before"
    pass G-GSD-VOLUME-ONCE "one XF86AudioRaiseVolume moves the sink one 6% gsd step (0.40 to $gsd_after), handled once"

    gsd_until 10 grep -qsxF "properties $GSD_OWNER" "$GSD_DIR/mpris-calls" ||
        fail G-GSD-MPRIS "gsd-media-keys never loaded the player's properties"
    sleep 0.5
    gsd_since="$(gsd_now)"
    xdotool key XF86AudioPlay
    gsd_until 5 grep -qsxF "call PlayPause $GSD_OWNER" "$GSD_DIR/mpris-calls" ||
        fail G-GSD-MPRIS "XF86AudioPlay did not reach the player as PlayPause"
    [ "$(gsd_bus activations "$GSD_DIR/bus.jsonl" "$gsd_play" "$gsd_since")" = 1 ] ||
        fail G-GSD-MPRIS "XF86AudioPlay did not fire gsd's grab exactly once"
    [ "$(grep -c '^call ' "$GSD_DIR/mpris-calls")" = 1 ] || fail G-GSD-MPRIS "the player received other calls"
    pass G-GSD-MPRIS "XF86AudioPlay reaches the MPRIS player as PlayPause through gsd-media-keys"

    gsd_since="$(gsd_now)"
    xdotool key XF86WWW
    gsd_until 10 test -s "$gsd_www_marker" || fail G-GSD-LAUNCHER "XF86WWW did not launch the default http handler"
    [ "$(gsd_bus activations "$GSD_DIR/bus.jsonl" "$gsd_www" "$gsd_since")" = 1 ] ||
        fail G-GSD-LAUNCHER "XF86WWW did not fire gsd's grab exactly once"
    pass G-GSD-LAUNCHER "XF86WWW makes gsd-media-keys launch the default x-scheme-handler/http application"

    gsd_sink_held="$(real_volume @DEFAULT_AUDIO_SINK@)"
    gsd_off="$(log_mark)"
    kill "$GSD_MEDIA_KEYS_PID"
    (sleep 10; kill -9 "$GSD_MEDIA_KEYS_PID" 2>/dev/null) &
    gsd_watchdog=$!
    gsd_status=0
    wait "$GSD_MEDIA_KEYS_PID" || gsd_status=$?
    kill "$gsd_watchdog" 2>/dev/null || true
    echo "gsd-media-keys exit status after SIGTERM: $gsd_status" >>"$GSD_DIR/version.txt"
    GSD_MEDIA_KEYS_PID=""
    gsd_until 10 gsd_released || fail G-GSD-NATIVE-RESUME "org.gnome.SettingsDaemon.MediaKeys outlived gsd-media-keys"
    log_wait "$gsd_off" "tuna-shell-gtk: media keys: no gsd-media-keys, native volume and lock bindings" 10 ||
        fail G-GSD-NATIVE-RESUME "the shell did not take the media keys back"
    sleep 0.7
    [ "$(cat "$VOLUME_FILE")" = 0.4200 ] || fail G-GSD-NATIVE-RESUME "unexpected stand-in baseline $(cat "$VOLUME_FILE")"
    MEDIA_SINCE="$(gsd_now)"
    MEDIA_KIND=key
    xdotool key XF86AudioRaiseVolume
    "$PY" "$ROOT/scripts/lib/media-completion-barrier.py" --log "$LOG" \
        --pid "$MEDIA_SHELL_PID" --owner "$ARTIFACTS/media-completion-owner.json" \
        --since "$MEDIA_SINCE" --kind "$MEDIA_KIND" \
        --policy "$(gsettings get org.gnome.desktop.sound allow-volume-above-100-percent)" \
        --receipt "$GSD_DIR/native-resume-completion.json" ||
        fail G-GSD-NATIVE-RESUME "the native volume key's callbacks did not settle"
    media_volume 0.4800 || fail G-GSD-NATIVE-RESUME "the native volume key did not apply the 6% step"
    [ "$(gsd_bus native "$LOG" "$gsd_off")" -ge 1 ] || fail G-GSD-NATIVE-RESUME "no native media action ran"
    [ "$(real_volume @DEFAULT_AUDIO_SINK@)" = "$gsd_sink_held" ] ||
        fail G-GSD-NATIVE-RESUME "something still drove the PipeWire sink after gsd-media-keys left"
    echo 0.4200 >"$VOLUME_FILE"
    scrot "$GSD_DIR/native-resume.png" >/dev/null
    pass G-GSD-NATIVE-RESUME "with gsd-media-keys gone the shell rebinds and handles the volume key natively"

    rm -f "$TUNA_MEDIA_DIAGNOSTICS"
    kill "$MPRIS_PID" "$GSD_BUS_PID" 2>/dev/null || true
    wait "$MPRIS_PID" "$GSD_BUS_PID" 2>/dev/null || true
    MPRIS_PID=""
    GSD_BUS_PID=""
    "$PW_CLI_REAL" destroy "$gsd_sink" >/dev/null 2>&1 || true
    "$PW_CLI_REAL" destroy "$gsd_source" >/dev/null 2>&1 || true
    kill "$PW_PULSE_PID" 2>/dev/null || true
    wait "$PW_PULSE_PID" 2>/dev/null || true
    PW_PULSE_PID=""
    cp "$GSD_DIR/mimeapps.list.before" "$XDG_CONFIG_HOME/mimeapps.list"
    rm -f "$XDG_DATA_HOME/applications/tuna-gsd-www-probe.desktop"
}
gsd_missing=""
if [ -z "$GSD_BIN" ]; then gsd_missing="gsd-media-keys"; fi
if ! command -v pipewire-pulse >/dev/null 2>&1; then gsd_missing="$gsd_missing pipewire-pulse"; fi
if [ -z "$PW_PIDS" ]; then gsd_missing="$gsd_missing pipewire/wireplumber"; fi
if [ -z "$WPCTL_REAL" ] || [ -z "$PW_CLI_REAL" ] || [ -z "$PW_DUMP_REAL" ]; then
    gsd_missing="$gsd_missing wpctl/pw-cli/pw-dump"
fi
if [ -z "$gsd_missing" ]; then
    gsd_media_keys_proof
elif [ "${TUNA_REQUIRE_GSD_MEDIA_KEYS:-}" = 1 ]; then
    fail G-GSD-MEDIA-OWNER "required but missing:$gsd_missing"
else
    echo "tuna-gtk-shell-proof: G-GSD-MEDIA-KEYS not run, missing:$gsd_missing" >&2
fi

# GNOME Shell's own keybindings (org.gnome.shell.keybindings defaults).
sleep 2
xdotool key super+s
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-key-qs.json" 20 ||
    fail G-KEYBINDINGS "accessibility dump failed"
showing "$ARTIFACTS/a11y-key-qs.json" "Dark Style" ||
    fail G-KEYBINDINGS "Super+S did not open quick settings"
xdotool key Escape
sleep 1
xdotool key super+v
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-key-tray.json" 20 ||
    fail G-KEYBINDINGS "accessibility dump failed"
showing "$ARTIFACTS/a11y-key-tray.json" "Previous month" ||
    fail G-KEYBINDINGS "Super+V did not open the date menu"
xdotool key Escape
sleep 1
xdotool key super+a
cstate '.overview_open' "app grid" || fail G-KEYBINDINGS "Super+A did not open the overview"
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-key-grid.json" 20 ||
    fail G-KEYBINDINGS "accessibility dump failed"
showing "$ARTIFACTS/a11y-key-grid.json" "Probe Tools" ||
    fail G-KEYBINDINGS "Super+A did not show the app grid"
xdotool key super+a
cstate '.overview_open | not' "closed" || fail G-KEYBINDINGS "Super+A again did not leave the app grid"
# The shell hides its overview surfaces on its next frame: let it.
sleep 1
pass G-KEYBINDINGS "Super+S, Super+V and Super+A open GNOME's menus and the app grid"
