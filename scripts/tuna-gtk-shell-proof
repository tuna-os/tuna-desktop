# The app grid's animations trace their start and settle
# (TUNA_GRID_TRACE): log_mark, then log_wait for a line after it.
log_mark() { wc -c <"$LOG"; }
log_wait() {
    anim_end=$(($(date +%s) + ${3:-6}))
    while :; do
        tail -c +"$(($1 + 1))" "$LOG" | grep -q -- "$2" && return 0
        [ "$(date +%s)" -gt "$anim_end" ] && return 1
        sleep 0.2
    done
}
log_has() { tail -c +"$(($1 + 1))" "$LOG" | grep -q -- "$2"; }
settle_ms() {
    tail -c +"$(($1 + 1))" "$LOG" | grep -o "grid-anim $2 settle ms=[0-9]*" | tail -1 | sed 's/.*ms=//'
}
# Set the motion policy and wait for the shell to apply it (it tells
# the compositor after its own animations switch).
motion_policy() {
    case "$1" in
    Full)
        gsettings set org.gnome.desktop.interface enable-animations true
        gsettings set org.gnome.desktop.a11y.interface reduced-motion 'no-preference'
        ;;
    Off)
        gsettings set org.gnome.desktop.a11y.interface reduced-motion 'no-preference'
        gsettings set org.gnome.desktop.interface enable-animations false
        ;;
    FadesOnly)
        gsettings set org.gnome.desktop.interface enable-animations true
        gsettings set org.gnome.desktop.a11y.interface reduced-motion 'reduce'
        ;;
    esac
    case "$1" in
    Full) want=full ;;
    Off) want=off ;;
    FadesOnly) want='fade-only' ;;
    esac
    cstate ".motion_policy == \"$want\"" "motion policy $want" || fail G-FOLDER-ZOOM "motion policy $want never arrived"
}

# GNOME's paged app grid: thirty more apps make a second page, with the
