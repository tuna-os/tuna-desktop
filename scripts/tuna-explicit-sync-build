#!/usr/bin/env bash
# Build the real DRM/GBM/EGL/Wayland consumer without building the desktop.
set -euo pipefail
if [[ $# != 1 ]]; then
    echo 'usage: tuna-explicit-sync-build OUTPUT_DIRECTORY' >&2
    exit 2
fi
script_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
protocol_root=${WAYLAND_PROTOCOLS_DIR:?set WAYLAND_PROTOCOLS_DIR to the staged locked Cargo package protocols directory}
mkdir -p -- "$1"
output_root=$(cd -- "$1" && pwd)
rm -f -- "$output_root/native-build.json"
cp -- "$protocol_root/../source.json" "$output_root/protocol-source.json"
printf '' > "$output_root/protocol-xml.sha256"
protocols=(
    'xdg-shell:stable/xdg-shell/xdg-shell.xml'
    'presentation-time:stable/presentation-time/presentation-time.xml'
    'linux-dmabuf:stable/linux-dmabuf/linux-dmabuf-v1.xml'
    'linux-drm-syncobj:staging/linux-drm-syncobj/linux-drm-syncobj-v1.xml'
)
sources=()
for protocol in "${protocols[@]}"; do
    name=${protocol%%:*}
    xml=$protocol_root/${protocol#*:}
    sha256sum "$xml" >> "$output_root/protocol-xml.sha256"
    wayland-scanner client-header "$xml" "$output_root/$name-client-protocol.h"
    wayland-scanner private-code "$xml" "$output_root/$name-protocol.c"
    sources+=("$output_root/$name-protocol.c")
done
read -r -a compile_flags <<< "$(pkg-config --cflags wayland-client libdrm gbm egl glesv2)"
read -r -a link_flags <<< "$(pkg-config --libs wayland-client libdrm gbm egl glesv2)"
cc -std=c11 -O2 -Wall -Wextra -Werror "${compile_flags[@]}" -I "$output_root" \
    "$script_root/lib/tuna-explicit-sync-client.c" "${sources[@]}" \
    "${link_flags[@]}" -o "$output_root/tuna-explicit-sync-client"
"$script_root/tuna-background-effect-client-build" "$output_root"
sha256sum "$protocol_root/staging/ext-background-effect/ext-background-effect-v1.xml" \
    >> "$output_root/protocol-xml.sha256"
python3 - "$script_root" "$output_root" "$protocol_root" <<'PY'
import hashlib
import json
from pathlib import Path
import sys

scripts, output, protocols = map(Path, sys.argv[1:])
sources = (
    "scripts/tuna-explicit-sync-build",
    "scripts/tuna-background-effect-client-build",
    "scripts/lib/tuna-explicit-sync-client.c",
    "scripts/lib/tuna-background-effect-client.c",
)
members = {
    "/usr/libexec/tuna-explicit-sync-client": "tuna-explicit-sync-client",
    "/usr/libexec/tuna-background-effect-client": "tuna-background-effect-client",
    "/usr/share/tuna-explicit-sync/protocol-xml.sha256": "protocol-xml.sha256",
    "/usr/share/tuna-explicit-sync/protocol-source.json": "protocol-source.json",
}
digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
# A source receipt alone must not authorize different XML bytes in the image
# build context. Validate every actual generator input before emitting proof.
staged = json.loads((output / "protocol-source.json").read_bytes())
for relative in (
    "stable/xdg-shell/xdg-shell.xml",
    "stable/presentation-time/presentation-time.xml",
    "stable/linux-dmabuf/linux-dmabuf-v1.xml",
    "staging/linux-drm-syncobj/linux-drm-syncobj-v1.xml",
    "staging/ext-background-effect/ext-background-effect-v1.xml",
):
    if digest(protocols / relative) != staged["file_sha256"].get("protocols/" + relative):
        raise SystemExit("native build XML differs from archive-verified source: " + relative)
receipt = {
    "schema": 1,
    "source_sha256": {name: digest(scripts / name.removeprefix("scripts/")) for name in sources},
    "member_sha256": {name: digest(output / filename) for name, filename in members.items()},
}
(output / "native-build.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
PY
