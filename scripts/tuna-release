#!/bin/sh
# tuna-release — build the Tuna Desktop Debian package from a clean checkout.
#
# Usage:
#   scripts/tuna-release [--out DIR] [--allow-dirty] [--help]
#
# Builds the six release binaries with the version stamped from the git tag,
# stages the documented install layout (binaries side by side plus the
# login-screen session entry), generates the package metadata from the same
# stamp, and produces tuna-desktop_<version>_amd64.deb via dpkg-deb.
#
# Release tags are vX.Y.Z or SemVer prereleases such as vX.Y.Z-beta.N. The
# binaries report the SemVer version; the package Version maps the prerelease
# hyphen to "~" (X.Y.Z~beta.N) so dpkg orders it before the final X.Y.Z.
#
# The tree must be clean and HEAD must carry a v-prefixed release tag unless
# --allow-dirty is given (dev builds; the version is still stamped from the
# nearest release tag or falls back to the crate version when none resolves).
set -eu

unset CDPATH

OUT="dist"
ALLOW_DIRTY="no"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --out)
            OUT="$2"
            shift 2
            ;;
        --allow-dirty)
            ALLOW_DIRTY="yes"
            shift
            ;;
        --help | -h)
            sed -n '2,18p' "$0"
            exit 0
            ;;
        *)
            echo "tuna-release: unknown argument $1" >&2
            exit 1
            ;;
    esac
done

if [ "$ALLOW_DIRTY" != "yes" ]; then
    if [ -n "$(git status --porcelain)" ]; then
        echo "tuna-release: working tree is dirty (use --allow-dirty for dev builds)" >&2
        exit 1
    fi
    # Recorded human visual review (#67): a release tag needs a filled
    # docs/reviews/<tag>.md comparing Tuna Desktop frames against the GNOME 51
    # baseline bundle.
    RELEASE_TAG="$(git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null || true)"
    if [ -n "$RELEASE_TAG" ]; then
        REVIEW="docs/reviews/$RELEASE_TAG.md"
        if [ ! -f "$REVIEW" ]; then
            echo "tuna-release: missing visual review $REVIEW (copy docs/reviews/TEMPLATE.md)" >&2
            exit 1
        fi
        if grep -q 'TBD' "$REVIEW"; then
            echo "tuna-release: $REVIEW still has TBD placeholders" >&2
            exit 1
        fi
    fi
fi

TAG="$(git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null || true)"
if [ -z "$TAG" ]; then
    TAG="$(git describe --tags --match 'v[0-9]*' 2>/dev/null || true)"
fi
# Drop the leading v and any git-describe distance suffix (-N-gHASH); keep a
# SemVer prerelease (-beta.N) so the binaries report it.
VERSION="$(printf '%s' "$TAG" | sed -e 's/^v//' -e 's/-[0-9][0-9]*-g[0-9a-f][0-9a-f]*$//')"
if [ -z "$VERSION" ]; then
    echo "tuna-release: no tag found and no version given; crate fallback applies" >&2
fi

export TUNA_VERSION="$VERSION"
cargo build --locked --release -p tuna-compositor -p tuna-wallpaper-svg -p tuna-shell-gtk -p tuna-shell-host

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT INT TERM
chmod 0755 "$STAGE"
# Name every required policy ancestor: install implementations differ in how
# implicit parent modes interact with the builder's umask.
install -d -m0755 "$STAGE/DEBIAN" "$STAGE/usr" "$STAGE/usr/bin" \
    "$STAGE/usr/share" "$STAGE/usr/share/wayland-sessions" \
    "$STAGE/etc" "$STAGE/etc/pam.d"

for bin in tuna-compositor tuna-session tuna-shell-gtk tuna-shell-host tuna-ibus-bridge tuna-wallpaper-svg; do
    install -m0755 "target/release/$bin" "$STAGE/usr/bin/$bin"
done
install -d "$STAGE/usr/share/tuna-desktop/icons"
cp -a share/tuna-desktop/icons/. "$STAGE/usr/share/tuna-desktop/icons/"
python3 scripts/tuna-cursor-assets-check "$STAGE/usr/share/tuna-desktop/icons/Adwaita"
install -m0644 share/wayland-sessions/tuna.desktop \
    "$STAGE/usr/share/wayland-sessions/tuna.desktop"
install -Dm0644 share/systemd/user/tuna-session.target \
    "$STAGE/usr/lib/systemd/user/tuna-session.target"
install -Dm0644 share/xdg-desktop-portal/portals/tuna.portal \
    "$STAGE/usr/share/xdg-desktop-portal/portals/tuna.portal"
install -Dm0644 packaging/marlin/tuna-portals.conf \
    "$STAGE/usr/share/xdg-desktop-portal/tuna-portals.conf"
# Retained regular session bridge: hidden from menus, still resolvable by ID.
# tuna-rename: keep-begin
install -m0644 share/compat/wayland-sessions/roost.desktop \
    "$STAGE/usr/share/wayland-sessions/roost.desktop"
# tuna-rename: keep-end
# Both PAM services are conffiles; let dpkg preserve local edits/removals.
install -m0644 share/pam.d/tuna-lock "$STAGE/etc/pam.d/tuna-lock"
# tuna-rename: keep-begin
install -m0644 share/compat/pam.d/roost-lock "$STAGE/etc/pam.d/roost-lock"
printf '%s\n' /etc/pam.d/tuna-lock /etc/pam.d/roost-lock >"$STAGE/DEBIAN/conffiles"
# tuna-rename: keep-end
chmod 0644 "$STAGE/DEBIAN/conffiles"
# Former package control relations permit replacing the installed package.
LEGACY_PACKAGE=roost  # tuna-rename: keep

# Agreement check: the stamped binaries must report the stamped version.
for bin in tuna-compositor tuna-session tuna-shell-gtk tuna-shell-host tuna-ibus-bridge tuna-wallpaper-svg; do
    (ulimit -f 8; timeout 10 "$STAGE/usr/bin/$bin" --version) >"$STAGE/version-output" || { echo "tuna-release: version command failed" >&2; exit 1; }
    [ "$(wc -c <"$STAGE/version-output")" -le 256 ] || exit 1
    LINE="$(cat "$STAGE/version-output")"
    REPORTED="${LINE#"$bin "}"
    [ "$LINE" = "$bin $REPORTED" ] && [ -n "$REPORTED" ] && [ "$REPORTED" = "$(printf '%s' "$REPORTED" | tr -d '[:space:]')" ] || { echo "tuna-release: malformed version line" >&2; exit 1; }
    printf '%s\n' "$bin $REPORTED" >"$STAGE/version-expected"
    cmp -s "$STAGE/version-output" "$STAGE/version-expected" || exit 1
    [ -n "$VERSION" ] || VERSION="$REPORTED"
    if [ "$REPORTED" != "$VERSION" ]; then
        echo "tuna-release: $bin reports $REPORTED, expected $VERSION" >&2
        exit 1
    fi
done

rm "$STAGE/version-output" "$STAGE/version-expected"

# Resolve the real selected-distribution ELF ABI closure; never ignore missing
# shlibs/symbols information. Explicit dependencies below cover dlopen/tools.
mkdir "$STAGE/debian"
printf 'Source: tuna-desktop\nSection: x11\nPriority: optional\nMaintainer: Tuna Desktop Developers <tuna@example.invalid>\n\nPackage: tuna\nArchitecture: any\nDescription: Tuna Desktop\n' >"$STAGE/debian/control"
SHLIBS="$(cd "$STAGE" && dpkg-shlibdeps -O -eusr/bin/tuna-compositor -eusr/bin/tuna-session -eusr/bin/tuna-shell-gtk -eusr/bin/tuna-shell-host -eusr/bin/tuna-ibus-bridge -eusr/bin/tuna-wallpaper-svg)" || exit 1
case "$SHLIBS" in shlibs:Depends=*) SHLIBS="${SHLIBS#shlibs:Depends=}" ;; *) echo "tuna-release: missing ELF dependency closure" >&2; exit 1 ;; esac
[ -n "$SHLIBS" ] || exit 1
rm -r "$STAGE/debian"
# Debian orders "~" before everything, so X.Y.Z~beta.N < X.Y.Z.
DEB_VERSION="$(printf '%s' "$VERSION" | sed 's/-/~/')"
cat >"$STAGE/DEBIAN/control" <<EOF
Package: tuna-desktop
Version: $DEB_VERSION
Replaces: $LEGACY_PACKAGE
Conflicts: $LEGACY_PACKAGE
Provides: $LEGACY_PACKAGE
Section: x11
Priority: optional
Architecture: amd64
Depends: $SHLIBS, colord, gnome-color-manager, gnome-session-canberra, libcanberra-pulse, sound-theme-freedesktop, librsvg2-common, libgtk4-layer-shell0 (>= 1.1), libgtk-4-1 (>= 4.12), libadwaita-1-0 (>= 1.0), libpam0g, gsettings-desktop-schemas, gnome-settings-daemon-common, libsecret-tools, libxkbcommon0, libxkbcommon-x11-0, libegl1, libgl1, libgbm1, libseat1, libinput10, libudev1, libdrm2, libpipewire-0.3-0t64 | libpipewire-0.3-0, libglib2.0-0t64 | libglib2.0-0
Recommends: ibus, gstreamer1.0-tools, gstreamer1.0-pipewire, gstreamer1.0-plugins-good
Maintainer: Tuna Desktop Developers <tuna@example.invalid>
Description: Tuna Desktop Wayland desktop session
 A GNOME-style Wayland desktop with an optional scrollable tiling shell,
 with the preferred GTK shell and a supervised compositor.
 .
 Installs the compositor, GTK and legacy shell hosts, session launcher, and IBus bridge plus
 the login-screen session entry.
EOF
chmod 0644 "$STAGE/DEBIAN/control"

mkdir -p "$OUT"
PKG="$OUT/tuna-desktop_${DEB_VERSION}_amd64.deb"
dpkg-deb --root-owner-group --build "$STAGE" "$PKG" >/dev/null
echo "tuna-release: wrote $PKG"
