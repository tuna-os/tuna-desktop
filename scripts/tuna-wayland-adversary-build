#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 1 ]]; then
    echo 'usage: tuna-wayland-adversary-build OUTPUT_DIRECTORY' >&2
    exit 2
fi
script_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
protocol_root=$(pkg-config --variable=pkgdatadir wayland-protocols)
mkdir -p -- "$1"
output_root=$(cd -- "$1" && pwd)
# The fuzz mode binds these globals by name. Session-wide state a stray
# client must not reach (ext-session-lock and privileged protocols) stays out.
protocols=(
    stable/xdg-shell/xdg-shell.xml
    stable/viewporter/viewporter.xml
    stable/presentation-time/presentation-time.xml
    unstable/xdg-decoration/xdg-decoration-unstable-v1.xml
    staging/fractional-scale/fractional-scale-v1.xml
    staging/single-pixel-buffer/single-pixel-buffer-v1.xml
    staging/xdg-activation/xdg-activation-v1.xml
    staging/content-type/content-type-v1.xml
    staging/cursor-shape/cursor-shape-v1.xml
    unstable/tablet/tablet-unstable-v2.xml
    unstable/text-input/text-input-unstable-v3.xml
    unstable/pointer-constraints/pointer-constraints-unstable-v1.xml
    unstable/relative-pointer/relative-pointer-unstable-v1.xml
    unstable/idle-inhibit/idle-inhibit-unstable-v1.xml
    unstable/primary-selection/primary-selection-unstable-v1.xml
    unstable/keyboard-shortcuts-inhibit/keyboard-shortcuts-inhibit-unstable-v1.xml
    unstable/xdg-foreign/xdg-foreign-unstable-v2.xml
)
sources=()
interfaces=(wl_compositor wl_subcompositor wl_shm wl_seat wl_output wl_data_device_manager)
for protocol in "${protocols[@]}"; do
    xml="$protocol_root/$protocol"
    name=$(basename -- "$protocol" .xml)
    wayland-scanner client-header "$xml" "$output_root/$name-client-protocol.h"
    wayland-scanner private-code "$xml" "$output_root/$name-protocol.c"
    sources+=("$output_root/$name-protocol.c")
    while read -r interface; do
        interfaces+=("$interface")
    done < <(sed -n 's/.*<interface name="\([a-z0-9_]*\)".*/\1/p' "$xml")
done
{
    echo '/* Generated by tuna-wayland-adversary-build: interfaces the fuzz mode binds. */'
    echo '#include <wayland-client.h>'
    for interface in "${interfaces[@]}"; do
        echo "extern const struct wl_interface ${interface}_interface;"
    done
    echo 'static const struct wl_interface *const fuzz_interfaces[] = {'
    for interface in "${interfaces[@]}"; do
        echo "    &${interface}_interface,"
    done
    echo '    NULL,'
    echo '};'
} >"$output_root/fuzz-interfaces.h"
read -r -a compile_flags <<< "$(pkg-config --cflags wayland-client)"
read -r -a link_flags <<< "$(pkg-config --libs wayland-client)"
cc -std=c11 -O2 -Wall -Wextra -Werror "${compile_flags[@]}" -I "$output_root" \
    "$script_root/lib/tuna-wayland-adversary.c" "${sources[@]}" \
    "${link_flags[@]}" -o "$output_root/tuna-wayland-adversary"
