#!/usr/bin/env python3
"""ci-select-lanes — choose which ci.yml proof lanes a run executes.

Usage:
  scripts/ci-select-lanes [--event NAME] [--run-number N] [--size K] [--changed FILE|-] [--draft]

Prints `lanes=<JSON array>` and the marlin-vm legs as `vm_matrix=<JSON>`
(VM_PRIMARY etc. below) for $GITHUB_OUTPUT; the reason goes to
stderr and, when set, $GITHUB_STEP_SUMMARY. The `select-lanes` and `check`
jobs always run and are not proof lanes. A draft pull request (--draft)
runs no proof lane until it is marked ready for review.

push, schedule and workflow_dispatch run every lane but the merge queue's
gtk-shell-smoke, whose gates their full gtk-shell job proves. A merge group
(merge_group) runs MERGE_QUEUE only: check plus one GTK session, the fast
battery the queue waits for; every other lane runs on the push to main the
group becomes. A pull_request runs
what its changed files (`git diff --name-only HEAD^1 HEAD` on the merge
commit, or --changed) can affect:

- shared CI inputs (this script, the Cargo workspace manifests, vendored
  third-party crates, the nested-session launcher, the proof session
  helper and its preflight, and a ci.yml edit
  outside the lane jobs or to a job that is not a lane) run every lane,
  gtk-shell-smoke included, so a change to the queue's battery is proven
  before it reaches the queue; with --base a ci.yml edit to lane jobs runs
  only those lanes;
- docs and other non-runtime files (including tooling of other workflows,
  see NO_LANE) add no lane;
- a lane's own proof script, fixtures or packaging runs that lane, and a
  packaged conffile (share/pam.d/) runs journey's lifecycle and every
  package consumer; so does a scripts/tests/ file that the lane's job runs
  (OWNED below; WorkflowSync.test_lane_run_tests_select_their_lane keeps it
  complete). Tests only the check job runs add no lane;
- anything else (crates, share/, other scripts) runs CORE plus a
  round-robin slice of ROTATION: K lanes starting at
  (run_number * K) mod len(ROTATION), K from --size, $CI_ROUND_ROBIN_SIZE
  or 2. Every rotated lane runs on main after merge either way. Code a lane
  is the only end-to-end proof of (CODE_OWNED) also runs that lane.

Lanes that consume another lane's artifacts pull in their producers.
"""
import argparse
import fnmatch
import json
import os
import re
import subprocess
import sys

# Selectable ci.yml proof jobs, in workflow order.
LANES = [
    "journey", "drm-smoke", "hotplug", "desktop-proofs", "gtk-shell",
