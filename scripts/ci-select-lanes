#!/usr/bin/env python3
"""ci-select-lanes — choose which ci.yml proof lanes a run executes.

Usage:
  scripts/ci-select-lanes [--event NAME] [--run-number N] [--size K] [--changed FILE|-]

Prints `lanes=<JSON array>` for $GITHUB_OUTPUT; the reason goes to
stderr and, when set, $GITHUB_STEP_SUMMARY. The `select-lanes` and `check`
jobs always run and are not proof lanes.

push, schedule and workflow_dispatch run every lane. A pull_request runs
what its changed files (`git diff --name-only HEAD^1 HEAD` on the merge
commit, or --changed) can affect:

- shared CI inputs (this script, the Cargo workspace manifests, vendored
  third-party crates, the nested-session launcher, and a ci.yml edit
  outside the lane jobs or to a job that is not a lane) run every lane; with
  --base a ci.yml edit to lane jobs runs only those lanes;
- docs and other non-runtime files (including tooling of other workflows,
  see NO_LANE) add no lane;
- a lane's own proof script, fixtures or packaging runs that lane, and a
  packaged conffile (share/pam.d/) runs journey's lifecycle and every
  package consumer;
- anything else (crates, share/, other scripts) runs gtk-shell plus a
  round-robin slice of ROTATION: K lanes starting at
  (run_number * K) mod len(ROTATION), K from --size, $CI_ROUND_ROBIN_SIZE
  or 2. Every rotated lane runs on main after merge either way.

Lanes that consume another lane's artifacts pull in their producers.
"""
import argparse
import fnmatch
import json
import os
import re
import subprocess
import sys

# Selectable ci.yml proof jobs, in workflow order.
LANES = [
    "fprint-phase-proof", "journey", "app-content", "scroll-proof", "drm-smoke",
    "grid-cancel-comparison", "gtk-shell", "orca-speech",
    "portal-security", "remote-security", "niri-parity", "arch-package",
    "marlin-image", "marlin-vm", "parity-ledger", "docs-shots",
]

# Every code change runs the GTK shell proof: it drives the compositor and
# the preferred shell together and is what most changes touch. The
# fingerprint phase and grid-cancel comparison proofs are short and cover
# authentication and drag paths no rotated lane does.
CORE = ["fprint-phase-proof", "grid-cancel-comparison", "gtk-shell"]

# Interchangeable end-to-end coverage of the same build, rotated per run.
# marlin-image is not here: ci.yml runs it on push, schedule and dispatch
# only (it rebuilds what marlin-vm builds), so a pull request rotating it
# would pay for arch-package and run nothing.
ROTATION = [
    "journey", "app-content", "scroll-proof", "drm-smoke", "orca-speech",
    "portal-security", "remote-security", "niri-parity", "marlin-vm",
]

# Lanes that download other lanes' artifacts.
NEEDS = {
    "portal-security": ["arch-package"],
    "remote-security": ["arch-package"],
    "niri-parity": ["arch-package"],
    "marlin-image": ["arch-package"],
    "marlin-vm": ["arch-package"],
    "parity-ledger": ["journey", "gtk-shell", "orca-speech", "drm-smoke", "marlin-vm"],
    "docs-shots": ["journey", "app-content", "scroll-proof"],
}

# fnmatch patterns: `*` also matches `/`. First matching rule wins.
FULL = [
    ".github/workflows/ci.yml",
    ".github/actions/ci-tool/*",
    "scripts/ci-*",
    "Cargo.toml",
    "Cargo.lock",
    "third-party/*",
    "scripts/tuna-nested",
]

PACKAGE_CONSUMERS = ["arch-package", "portal-security", "remote-security",
                     "niri-parity", "marlin-image", "marlin-vm"]

OWNED = [
    ("scripts/tuna-gtk-shell-proof", ["gtk-shell", "journey"]),
    ("scripts/tuna-scale-proof", ["gtk-shell"]),
    ("scripts/tuna-slow-portal-proof", ["gtk-shell"]),
    ("scripts/tuna-session-restore-proof", ["gtk-shell"]),
    ("scripts/tuna-walkthrough", ["gtk-shell"]),
    ("scripts/tuna-gtk-accessibility-proof", ["gtk-shell"]),
    ("scripts/tuna-a11y-golden", ["gtk-shell"]),
    ("scripts/tuna-wayland-info-compare", ["gtk-shell"]),
    ("scripts/lib/tuna-a11y-proof-guard.py", ["gtk-shell"]),
    ("docs/walkthrough*", ["gtk-shell"]),
    ("scripts/tuna-journey", ["journey"]),
    ("scripts/tuna-release", ["journey"]),
    ("scripts/check-release-package", ["journey"]),
    ("scripts/check-deb-clean-install", ["journey"]),
    ("scripts/lib/installed-deb-proof.py", ["journey"]),
    ("scripts/lib/release-deb-ownership.py", ["journey"]),
    ("scripts/lib/transition-package-policy*", ["journey"]),
    ("scripts/lib/legacy-upgrade-*", ["journey"]),
    ("share/compat/*", ["journey", *PACKAGE_CONSUMERS]),
    # The lock screen's PAM service is a dpkg conffile and an Arch backup
    # file: journey's Debian lifecycle prompts on any byte change (#899), the
    # images ship it, and the lock screen authenticates through it.
    ("share/pam.d/*", ["journey", *CORE, *PACKAGE_CONSUMERS]),
    ("scripts/tuna-app-content", ["app-content"]),
    ("scripts/tuna-scroll-proof", ["scroll-proof"]),
    ("scripts/tuna-drm-smoke", ["drm-smoke"]),
    ("scripts/tuna-orca-speech-proof", ["orca-speech"]),
    ("scripts/lib/tuna-orca-speech.py", ["orca-speech"]),
    ("scripts/tuna-frame-pacer-build", ["drm-smoke"]),
    ("scripts/lib/tuna-frame-pacer.c", ["drm-smoke"]),
    ("scripts/tuna-portal-security", ["portal-security"]),
    ("scripts/lib/tuna-portal-artifact*", ["portal-security"]),
    ("tests/portal-reference/*", ["portal-security"]),
    ("scripts/tuna-remote-security", ["remote-security"]),
    ("tests/remote-desktop-reference/*", ["remote-security"]),
    ("scripts/tuna-niri-*", ["niri-parity"]),
    ("tests/niri-reference/*", ["niri-parity"]),
    ("packaging/arch/*", PACKAGE_CONSUMERS),
    ("docs/nested-session.md", ["arch-package"]),
    ("packaging/marlin/*", ["marlin-image", "marlin-vm"]),
    ("scripts/tuna-vm-lane", ["marlin-vm"]),
    ("scripts/lib/vm_guest_agent.py", ["marlin-vm"]),
    ("scripts/lib/vm_gnome_reference.py", ["marlin-vm"]),
    ("scripts/lib/vm_strip_*", ["marlin-vm"]),
    ("scripts/tuna-ledger", ["parity-ledger"]),
    ("docs/parity-ledger.md", ["parity-ledger"]),
    ("scripts/tuna-docs-shots", ["docs-shots"]),
]

# Checked by the always-on check job, or not CI runtime input at all.
NO_LANE = [
    "docs/*",
    "*.md",
    "LICENSE",
    "renovate.json",
    ".github/*",
    ".spektacular/*",
    "fuzz/*",
    "scripts/tests/*",
    "scripts/lib/*-tests.py",
    # Products and workflows of their own, never run by a ci.yml lane
    # (WorkflowSync.test_no_lane_scripts_are_not_run_by_a_lane keeps this
    # true): corral installed-image tooling, variant qualification, hero
    # media, the stress, coverage and VM-release workflows, and the
    # contributor-facing try script and justfile. Each is covered by the
    # always-on check job and by its own workflow's path filter.
    "justfile",
    "scripts/try-tuna-desktop*",
    "scripts/tuna-corral-*",
    "scripts/lib/corral_*.py",
    "scripts/tuna-variant-qualification",
    "scripts/tuna-hero-media",
    "scripts/tuna-coverage-report",
    "scripts/tuna-stress",
    "scripts/tuna-hotplug-stress",
    "scripts/lib/vm_release*",
    "scripts/lib/vm_firstboot_diagnosis.py",
]


WORKFLOW = ".github/workflows/ci.yml"
# ci.yml job name -> the lane that owns it. Every other lane is its own job.
WORKFLOW_JOB_LANE = {
    **{lane: lane for lane in LANES},
    "gdm51-native-package": "marlin-vm",
    "native-reference-context": "marlin-vm",
}
# Jobs that run on every pull request regardless of selection.
WORKFLOW_ALWAYS_ON_JOBS = {"check", "ci-gate"}


def matches(path, patterns):
    return any(fnmatch.fnmatchcase(path, pattern) for pattern in patterns)


def rotation(run_number, size):
    size = max(0, min(size, len(ROTATION)))
    start = (run_number * size) % len(ROTATION)
    return [ROTATION[(start + i) % len(ROTATION)] for i in range(size)]


def _download_steps(job):
    return [step.get("with", {}) for step in job.get("steps", [])
            if "actions/download-artifact" in str(step.get("uses", ""))]


def _upload_names(job):
    return [str(step.get("with", {}).get("name", "")) for step in job.get("steps", [])
            if "actions/upload-artifact" in str(step.get("uses", ""))]


def _needs(job):
    needs = job.get("needs", [])
    return {needs} if isinstance(needs, str) else set(needs)


def artifact_consumers(jobs):
    """job -> the jobs that download an artifact it uploads.

    A consumer must also list the producer in `needs:` (GitHub only lets a
    job download what an earlier job of the run uploaded) and either
    download an artifact by a name the producer uploads or select one by an
    id taken from `needs.<producer>.outputs`. An upload name that is a
    `${{ }}` expression, such as a matrix artifact, matches any download
    name its literal parts fit.
    """
    consumers = {name: set() for name in jobs}
    for producer, produced in jobs.items():
        patterns = [re.compile(".*".join(re.escape(part) for part in re.split(r"\$\{\{.*?\}\}", upload)))
                    for upload in _upload_names(produced)]
        for consumer, job in jobs.items():
            if producer not in _needs(job):
                continue
            for download in _download_steps(job):
                name = str(download.get("name", ""))
                by_name = bool(name) and any(pattern.fullmatch(name) for pattern in patterns)
                by_output = f"needs.{producer}.outputs." in str(download)
                if by_name or by_output:
                    consumers[producer].add(consumer)
    return consumers


def workflow_lanes(base_text, head_text):
    """Lanes whose job definition differs between two ci.yml texts.

    YAML anchors are resolved before comparing, so editing an anchored
    `runs-on` or checkout block changes every job that aliases it. A changed
    job also selects the jobs that download its artifacts, transitively
    (artifact_consumers): an edit to arch-package reruns the lanes that
    install its package, an edit to check reruns parity-ledger. Returns
    None (caller falls back to every lane) when the files cannot be compared,
    when anything outside `jobs:` (triggers, concurrency, permissions) or the
    select-lanes job changed, or when a job is not a known lane.
    """
    try:
        import yaml
        base, head = yaml.safe_load(base_text), yaml.safe_load(head_text)
        base_jobs, head_jobs = base.pop("jobs"), head.pop("jobs")
    except Exception:  # missing PyYAML, unreadable or non-mapping YAML
        return None
    if base != head:
        return None
    jobs = {**base_jobs, **head_jobs}
    consumers = artifact_consumers(jobs)
    affected, pending = set(), []
    for name in jobs:
        if base_jobs.get(name) != head_jobs.get(name):
            if name == "select-lanes" or (name not in WORKFLOW_JOB_LANE
                                          and name not in WORKFLOW_ALWAYS_ON_JOBS):
                return None
            pending.append(name)
    while pending:
        name = pending.pop()
        if name in affected:
            continue
        affected.add(name)
        pending.extend(consumers.get(name, ()))
    if any(name not in WORKFLOW_JOB_LANE and name not in WORKFLOW_ALWAYS_ON_JOBS for name in affected):
        return None
    return {WORKFLOW_JOB_LANE[name] for name in affected if name in WORKFLOW_JOB_LANE}


def workflow_texts(base):
    """ci.yml at the merge base of `base` and HEAD, and at HEAD."""
    def git(*argv):
        return subprocess.run(["git", *argv], capture_output=True, text=True)
    merge_base = git("merge-base", base, "HEAD")
    old, new = git("show", f"{merge_base.stdout.strip()}:{WORKFLOW}"), git("show", f"HEAD:{WORKFLOW}")
    if merge_base.returncode or old.returncode or new.returncode:
        return "", ""
    return old.stdout, new.stdout


def select(event, run_number, size, changed, wf_lanes=None):
    """Return (lanes in LANES order, human-readable reason).

    wf_lanes: lanes touched by this change's ci.yml edit (workflow_lanes);
    None treats any ci.yml edit as a shared CI input.
    """
    if event != "pull_request":
        return list(LANES), f"{event}: every lane"
    chosen, reasons, code = set(), [], []
    for path in changed:
        if path == WORKFLOW and wf_lanes is not None:
            chosen.update(wf_lanes)
            reasons.append(f"{path} edits only the {', '.join(sorted(wf_lanes)) or 'check/gate'} job(s)")
            continue
        if matches(path, FULL):
            return list(LANES), f"{path} is shared CI input: every lane"
        owned = next((lanes for pattern, lanes in OWNED
                      if fnmatch.fnmatchcase(path, pattern)), None)
        if owned is not None:
            chosen.update(owned)
            reasons.append(f"{path} -> {', '.join(owned)}")
        elif not matches(path, NO_LANE):
            code.append(path)
    if code:
        rotated = rotation(run_number, size)
        chosen.update(CORE + rotated)
        reasons.append(f"{len(code)} code path(s), e.g. {code[0]} -> "
                       f"{', '.join(CORE)} + round-robin {rotated or 'none'} "
                       f"(run {run_number}, size {size})")
    pending = list(chosen)
    while pending:
        for need in NEEDS.get(pending.pop(), []):
            if need not in chosen:
                chosen.add(need)
                pending.append(need)
    if not reasons:
        reasons.append("docs/non-runtime changes only: check job only")
    return [lane for lane in LANES if lane in chosen], "; ".join(reasons)


def changed_files(source):
    if source == "-":
        return [line for line in sys.stdin.read().splitlines() if line]
    if source:
        with open(source, encoding="utf-8") as handle:
            return [line for line in handle.read().splitlines() if line]
    out = subprocess.run(["git", "diff", "--name-only", "-z", "HEAD^1", "HEAD"],
                         check=True, capture_output=True, text=True).stdout
    return [path for path in out.split("\0") if path]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--event", default=os.environ.get("GITHUB_EVENT_NAME", "pull_request"))
    parser.add_argument("--run-number", type=int, default=int(os.environ.get("GITHUB_RUN_NUMBER", "0")))
    parser.add_argument("--size", type=int,
                        default=int(os.environ.get("CI_ROUND_ROBIN_SIZE") or "2"))
    parser.add_argument("--changed", help="file of changed paths, - for stdin "
                        "(default: git diff HEAD^1 HEAD on pull_request)")
    parser.add_argument("--base", help="pull request base revision; with it, an edit to "
                        "ci.yml selects only the lanes whose job definition changed")
    args = parser.parse_args()
    changed = changed_files(args.changed) if args.event == "pull_request" else []
    wf_lanes = None
    if args.event == "pull_request" and args.base and WORKFLOW in changed:
        wf_lanes = workflow_lanes(*workflow_texts(args.base))
    lanes, reason = select(args.event, args.run_number, args.size, changed, wf_lanes)
    print("lanes=" + json.dumps(lanes, separators=(",", ":")))
    message = f"ci lanes: {', '.join(lanes) or 'none'}\nreason: {reason}\n"
    sys.stderr.write(message)
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as handle:
            handle.write("### CI lane selection\n\n```\n" + message + "```\n")


if __name__ == "__main__":
    main()
