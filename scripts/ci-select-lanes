    "marlin-image", "marlin-vm", "parity-ledger", "docs-shots",
]

# The merge queue's whole battery beside check: one nested GTK session
# through the core desktop path (scripts/tuna-gtk-shell-proof
# --smoke-only), about as long as check itself. Push, schedule and
# dispatch never select it; a pull request does when it runs every lane or
# edits its job.
MERGE_QUEUE = ["gtk-shell-smoke"]

