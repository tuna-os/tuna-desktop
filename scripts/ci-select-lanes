# the preferred shell together and is what most changes touch, and its
# scripts/tuna-lock-auth-proof covers lock authentication, fingerprint
# included. desktop-proofs is short: the grid-cancel comparison, which
# covers drag paths no rotated lane does, and the app content and
# scroll-mode strip proofs on its build.
CORE = ["desktop-proofs", "gtk-shell"]

