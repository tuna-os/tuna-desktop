#!/bin/sh
# tuna-docs-shots — curated docs screenshots, regenerated from proof harnesses.
#
# Usage:
#   scripts/tuna-docs-shots collect <journey-dir> <app-dir> <scroll-dir> [--dest DIR]
#   scripts/tuna-docs-shots regen [--dest DIR] [--display :N]
#
# `collect` preserves the seven legacy artifact frames, not canonical media.
# It checks every source before copying; existence alone is not freshness.
# `regen` runs those proof harnesses first. Both remain staging-only diagnostics;
# docs/shots was removed (#506), and no historical docs may be overwritten.
# Default staging output is target/docs-shots.
# Canonical media uses `receipt ARTIFACT --bundle KIND`, `intake ARTIFACT...`
# and `freshness --bundle KIND` with exact current-run identity flags.
# `scripts/lib/maintained_media.py --help` documents the receipt/outcome schema.
set -eu

unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
case "${1:-}" in
    receipt|intake|freshness|source-inputs) exec python3 "$ROOT/scripts/lib/maintained_media.py" "$@" ;;
esac
DEST="$ROOT/target/docs-shots"

usage() {
    sed -n '2,15p' "$0"
}

# dest src — copy one frame or fail loudly.
pick() {
    if [ ! -f "$2" ]; then
        echo "tuna-docs-shots: missing source frame $2" >&2
        exit 1
    fi
    cp "$2" "$DEST/$1"
    echo "tuna-docs-shots: $1 <= $2"
}

collect() {
    if [ "$#" -lt 3 ]; then
        echo "tuna-docs-shots: collect needs 3 artifact dirs" >&2
        usage >&2
        exit 1
    fi
    JOURNEY="$1"; APP="$2"; SCROLL="$3"
    python3 - "$ROOT" "$DEST" "$JOURNEY" "$APP" "$SCROLL" <<'VALIDATE'
from pathlib import Path
import sys
root, dest, journey, app, scroll = (Path(value).resolve() for value in sys.argv[1:])
if dest.is_relative_to(root / "docs"):
    sys.exit("tuna-docs-shots: legacy collect cannot overwrite maintained or historical docs; use receipted intake")
for directory, names in (
    (journey, ("01-baseline.png", "02-overview.png", "03-search.png")),
    (app, ("02-app.png", "03-tiled.png")),
    (scroll, ("02-strip.png", "04-wheel.png")),
):
    for name in names:
        if not (directory / name).is_file():
            sys.exit("tuna-docs-shots: missing source frame " + str(directory / name))
VALIDATE
    mkdir -p "$DEST"
    pick desktop-baseline.png "$JOURNEY/01-baseline.png"
    pick overview.png "$JOURNEY/02-overview.png"
    pick search.png "$JOURNEY/03-search.png"
    pick app-window.png "$APP/02-app.png"
    pick tiled-window.png "$APP/03-tiled.png"
    pick scroll-strip.png "$SCROLL/02-strip.png"
    pick scroll-wheel.png "$SCROLL/04-wheel.png"
}

regen() {
    TMP_BASE="${RUNNER_TEMP:-/tmp}/tuna-docs-regen-$$"
    rm -rf "$TMP_BASE"
    mkdir -p "$TMP_BASE"
    # shellcheck disable=SC2064
    trap "rm -rf '$TMP_BASE'" EXIT INT TERM
    "$ROOT/scripts/tuna-journey" "$@" --artifacts "$TMP_BASE/journey"
    "$ROOT/scripts/tuna-app-content" "$@" --artifacts "$TMP_BASE/app"
    "$ROOT/scripts/tuna-scroll-proof" "$@" --artifacts "$TMP_BASE/scroll"
    collect "$TMP_BASE/journey" "$TMP_BASE/app" "$TMP_BASE/scroll"
    trap - EXIT INT TERM
    rm -rf "$TMP_BASE"
}

CMD=""
while [ $# -gt 0 ]; do
    case "$1" in
        collect|regen) CMD="$1"; shift; break ;;
        --help|-h) usage; exit 0 ;;
        *) echo "tuna-docs-shots: unknown argument $1" >&2; usage >&2; exit 1 ;;
    esac
done

ARGS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dest) DEST="$2"; shift 2 ;;
        *) ARGS="$ARGS $1"; shift ;;
    esac
done

case "$CMD" in
    collect)
        # shellcheck disable=SC2086
        collect $ARGS
        ;;
    regen)
        # shellcheck disable=SC2086
        regen $ARGS
        ;;
    *)
        echo "tuna-docs-shots: need collect or regen" >&2
        usage >&2
        exit 1
        ;;
esac
