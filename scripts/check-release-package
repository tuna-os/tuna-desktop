#!/bin/sh
# check-release-package — verify a Tuna Desktop .deb built by scripts/tuna-release.
#
# Usage:
#   scripts/check-release-package <package.deb>
#
# Asserts the session binaries and login-screen entry are present and
# executable, and that the package metadata version matches the binaries'
# reported version (a X.Y.Z~beta.N package carries X.Y.Z-beta.N binaries).
set -eu

unset CDPATH

if [ "$#" -ne 1 ]; then
    echo "Usage: scripts/check-release-package <package.deb>" >&2
    exit 1
fi

PKG="$1"
fail() {
    echo "check-release-package: $1" >&2
    exit 1
}

# Validate numeric metadata in BOTH original archives before extraction can
# replace ownership with that of the checker process.
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
python3 "$ROOT/scripts/lib/release-deb-ownership.py" "$PKG" || fail "archive ownership rejected"

CONTENTS="$(dpkg-deb -c "$PKG" 2>/dev/null)"
for path in \
    usr/bin/tuna-compositor \
    usr/bin/tuna-session \
    usr/bin/tuna-shell-gtk \
    usr/bin/tuna-shell-host \
    usr/bin/tuna-ibus-bridge \
    usr/bin/tuna-greeter \
    usr/share/wayland-sessions/tuna.desktop \
    usr/lib/systemd/user/tuna-session.target \
    etc/pam.d/tuna-lock; do
    printf '%s' "$CONTENTS" | grep -q "$path" || fail "missing $path"
done

printf '%s' "$CONTENTS" | grep "usr/bin/tuna-" | grep -q "^-rwx" \
    || fail "session binaries are not executable"

VERSION="$(dpkg-deb -f "$PKG" Version)"
[ -n "$VERSION" ] || fail "empty Version field"
# tuna-release writes a SemVer prerelease's hyphen as "~" for dpkg ordering.
SEMVER="$(printf '%s' "$VERSION" | sed 's/~/-/')"

DIR="$(mktemp -d)"
trap 'rm -rf "$DIR"' EXIT INT TERM
dpkg-deb -x "$PKG" "$DIR"
python3 "$ROOT/scripts/tuna-cursor-assets-check" "$DIR/usr/share/tuna-desktop/icons/Adwaita" \
    || fail "bundled cursor assets rejected"
for path in usr/share/wayland-sessions/tuna.desktop usr/lib/systemd/user/tuna-session.target etc/pam.d/tuna-lock; do
    [ -f "$DIR/$path" ] && [ ! -L "$DIR/$path" ] || fail "invalid required file $path"
done
for bin in tuna-compositor tuna-session tuna-shell-gtk tuna-shell-host tuna-ibus-bridge tuna-greeter; do
    [ -f "$DIR/usr/bin/$bin" ] && [ ! -L "$DIR/usr/bin/$bin" ] && [ -x "$DIR/usr/bin/$bin" ] || fail "invalid executable $bin"
    (ulimit -f 8; timeout 10 "$DIR/usr/bin/$bin" --version) >"$DIR/version-output" || fail "$bin version command failed"
    printf '%s\n' "$bin $SEMVER" >"$DIR/version-expected"
    cmp -s "$DIR/version-output" "$DIR/version-expected" || fail "$bin version line differs from package"
    ldd "$DIR/usr/bin/$bin" >"$DIR/ldd.txt" || fail "$bin ELF loader check failed"
    if grep -q 'not found' "$DIR/ldd.txt"; then fail "$bin missing ELF library"; fi
done

DEPENDS="$(dpkg-deb -f "$PKG" Depends)"
for required in 'libgtk4-layer-shell0 (>= 1.1)' 'libgtk-4-1 (>= 4.12)' 'libadwaita-1-0 (>= 1.0)' 'libpam0g' 'gsettings-desktop-schemas' 'gnome-settings-daemon-common'; do
    printf '%s\n' "$DEPENDS" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -Fxq "$required" || fail "missing runtime floor $required"
done
[ "$(cat "$DIR/DEBIAN/conffiles" 2>/dev/null || dpkg-deb --ctrl-tarfile "$PKG" | tar -xOf - ./conffiles)" = /etc/pam.d/tuna-lock ] || fail "PAM conffiles missing"

# The former package name survives only in the control relations.
for field in Replaces Conflicts Provides; do
    [ "$(dpkg-deb -f "$PKG" "$field")" = roost ] || fail "$field must name the former package roost"  # tuna-rename: keep
done

# Login entry must parse: run the validator when present, allowing only
# the DesktopNames session-file convention (GNOME/KDE/Sway session
# entries ship it and display managers read it; the base-spec validator
# flags it).
if command -v desktop-file-validate >/dev/null 2>&1; then
    DESKTOP_ERRORS="$(desktop-file-validate "$DIR/usr/share/wayland-sessions/tuna.desktop" 2>&1 || true)"
    DESKTOP_ERRORS="$(printf '%s' "$DESKTOP_ERRORS" | grep -v 'key "DesktopNames"' || true)"
    [ -z "$DESKTOP_ERRORS" ] || fail "tuna.desktop invalid: $DESKTOP_ERRORS"
fi

echo "check-release-package: $PKG OK (version $VERSION)"
