# Self-hosted GitHub Actions runner for tuna-desktop CI on karnataka.
#
# Mirrors what our jobs assume from GitHub's ubuntu-24.04/ubuntu-26.04
# images: passwordless sudo, git, jq, python3, rustup with stable, podman,
# shellcheck, xvfb and the usual build tools. Common CI apt dependencies are
# baked in; jobs still install their declared dependencies for hosted parity
# and updates. Build with .github/runners/build-image.
ARG UBUNTU=26.04
FROM docker.io/library/ubuntu:${UBUNTU}

ARG UBUNTU
ARG RUNNER_VERSION
ARG RUNNER_UID=1001
ARG IMAGE_OS=ubuntu24
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ImageOS=${IMAGE_OS} \
    RUNNER_TOOL_CACHE=/opt/hostedtoolcache \
    AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache

# Subset of actions/runner-images' ubuntu toolset apt_packages plus the
# tools that image installs separately (git, gh, podman, pipx, rustup).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      acl aria2 autoconf automake bc binutils bison brotli bzip2 ca-certificates \
      clang cmake coreutils curl dbus dnsutils dpkg-dev fakeroot file findutils flex \
      g++ gcc git git-lfs gnupg imagemagick iproute2 iputils-ping jq \
      libclang-dev libssl-dev libtool libyaml-dev lld llvm locales lsb-release lsof lz4 m4 make \
      net-tools netcat-openbsd ninja-build openssh-client p7zip-full parallel patchelf \
      pigz pkg-config podman podman-docker buildah skopeo passt slirp4netns uidmap \
      python-is-python3 python3 python3-pip python3-venv pipx rsync \
      shellcheck sqlite3 sudo tar time tree tzdata unzip wget xvfb xxd \
      xz-utils zip zstd \
 && curl -fsSLo /usr/share/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Common compositor/shell development and proof runtime packages from ci.yml
# (check, fprint-phase-proof, app-content, scroll-proof, grid-cancel-comparison,
# gtk-shell, journey and orca-speech). Keep workflow installs: the image only
# avoids repeatedly unpacking the stable baseline in each ephemeral pod.
# Use each Ubuntu release's packages rather than pinning cross-distro ABIs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential desktop-file-utils libseat-dev libinput-dev libudev-dev \
      libgbm-dev libdrm-dev libxkbcommon-dev libxkbcommon-x11-dev \
      libegl1 libgl1-mesa-dri libgbm1 libwayland-dev wayland-protocols meson \
      libglib2.0-dev libglib2.0-bin libglib2.0-dev-bin libgtk-4-dev \
      libfontconfig1-dev librsvg2-common libpipewire-0.3-dev libadwaita-1-dev \
      libpam-wrapper libpam0g-dev gsettings-desktop-schemas \
      dbus-x11 xdotool scrot ffmpeg xwayland x11-apps x11-utils wayland-utils \
      pipewire pipewire-pulse wireplumber gstreamer1.0-pipewire \
      gstreamer1.0-tools gstreamer1.0-plugins-good at-spi2-core \
      python3-gi python3-pyatspi python3-pil python3-yaml \
      gir1.2-gtk-4.0 gir1.2-gtk-3.0 gir1.2-ibus-1.0 \
      ibus ibus-gtk3 ibus-gtk4 fonts-cantarell libnotify-bin libsecret-tools \
      gnome-keyring gnome-settings-daemon-common gnome-settings-daemon \
      xdg-desktop-portal xdg-desktop-portal-gnome xdg-desktop-portal-gtk \
 && case "$UBUNTU" in \
      24.04) ;; \
      26.04) apt-get install -y --no-install-recommends \
               libgtk4-layer-shell-dev orca speech-dispatcher ;; \
      *) echo "Unsupported runner Ubuntu release: $UBUNTU" >&2; exit 1 ;; \
    esac \
 && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 does not package gtk4-layer-shell. Its jobs retain the pinned
# scripts/ci-install-gtk4-layer-shell source build; do not bake a /usr/local
# copy into 26.04, whose package proofs require genuine distro libraries.

# The ubuntu base image ships an `ubuntu` user at uid 1000; GitHub's
# images run jobs as `runner` (uid 1001) with passwordless sudo.
RUN useradd -m -u "${RUNNER_UID}" -s /bin/bash runner \
 && usermod -aG sudo runner \
 && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
 && chmod 0440 /etc/sudoers.d/runner \
 && echo 'Defaults env_keep += "DEBIAN_FRONTEND"' > /etc/sudoers.d/env_keep \
 && mkdir -p /opt/hostedtoolcache && chown runner:runner /opt/hostedtoolcache

# What systemd-tmpfiles and logind create at boot on GitHub's VMs (X servers
# and XWayland bind their sockets in /tmp/.X11-unix; the runner's session
# has XDG_RUNTIME_DIR), and the hosted work directory, so job paths, and
# with them actions/cache versions, match GitHub-hosted runs.
RUN install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix \
 && install -d -m 0700 -o runner -g runner /run/user/${RUNNER_UID} \
 && install -d -o runner -g runner /home/runner/work
ENV XDG_RUNTIME_DIR=/run/user/${RUNNER_UID} \
    XDG_CONFIG_HOME=/home/runner/.config

# Nested containers (podman, and `docker` via podman-docker) inside the
# pod's user namespace, which spans uids 0-65535: root maps the whole
# range, runner every id but its own. The pod's cgroupfs is read-only, so
# nested containers run without their own cgroups (the pod's limits apply).
RUN printf 'root:1:65535\nrunner:1:1000\nrunner:1002:64534\n' | tee /etc/subuid > /etc/subgid \
 && printf '[containers]\ncgroups = "disabled"\n[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' \
      > /etc/containers/containers.conf \
 && touch /etc/containers/nodocker

WORKDIR /home/runner
RUN curl -fsSL "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" \
      | tar -xz \
 && ./bin/installdependencies.sh \
 && rm -rf /var/lib/apt/lists/* \
 && chown -R runner:runner /home/runner

# Refuses jobs from forks and foreign repositories, whatever runs-on says.
COPY --chmod=0755 job-started.sh /opt/tuna-ci/job-started.sh
ENV ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/tuna-ci/job-started.sh

USER runner
# Same CARGO_HOME as GitHub's images (rust-cache hashes it into its keys);
# rustup uses its default ~/.rustup, which they leave unset.
ENV PATH=/home/runner/.cargo/bin:/home/runner/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CARGO_HOME=/home/runner/.cargo
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal \
      --default-toolchain stable --component rustfmt,clippy --no-modify-path \
 && rustc --version && cargo --version

ENTRYPOINT []
CMD ["/home/runner/run.sh"]
