#!/bin/sh
set -eu
# Only this interpreter receives the private prefix. The launcher's system
# RPM database, cache and shared-library search configuration remain untouched.
unset PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE
PYTHONHOME=/opt/tuna-python/usr PYTHONNOUSERSITE=1 \
    exec /opt/tuna-python/usr/lib64/ld-linux-x86-64.so.2 \
    --inhibit-cache --library-path /opt/tuna-python/usr/lib64:/opt/tuna-python/lib64 \
    /opt/tuna-python/usr/bin/python3.12 "$@"
