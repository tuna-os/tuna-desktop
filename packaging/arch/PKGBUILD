# Maintainer: Tuna Desktop contributors <https://github.com/tuna-os/tuna-desktop>
#
# Arch Linux package for Tuna Desktop (formerly Roost), the target format for TunaOS Marlin (#69).
#
# Release builds fetch the tagged source. CI and local builds set
# TUNA_LOCAL_SRC to a checkout instead:
#   TUNA_LOCAL_SRC="$PWD" makepkg -f --dir packaging/arch   (or cd there)
# The version is stamped from the tag exactly like scripts/tuna-release,
# so every binary's --version matches _semver. Set _semver to the release
# tag minus its v (X.Y.Z or a prerelease X.Y.Z-beta.N). pacman forbids "-" in
# pkgver, so a prerelease becomes X.Y.Zbeta.N, which vercmp orders before
# X.Y.Z (a "." or "_" before the letters would order it after).

pkgname=tuna-desktop
# Upgrades the package's former name in place (#505).
replaces=('roost')  # tuna-rename: keep
conflicts=('roost')  # tuna-rename: keep
provides=('roost')  # tuna-rename: keep
_semver=1.0.0-beta.1
pkgver=${_semver/-/}
pkgrel=1
pkgdesc='Tuna Desktop: GNOME-style Wayland desktop session in Rust (v1 beta)'
arch=('x86_64')
url='https://github.com/tuna-os/tuna-desktop'
license=('GPL-3.0-or-later')
depends=(
    'dbus'
    'glib2'
    'gnome-settings-daemon'
    'gtk4'
    'gtk4-layer-shell'
    'libadwaita'
    'libcanberra'
    'libdrm'
    'libinput'
    'libsecret'
    'libxkbcommon'
    'libxkbcommon-x11'
    'mesa'
    'pipewire'
    'seatd'
    'sound-theme-freedesktop'
    'systemd-libs'
    'wayland'
)
makedepends=('cargo' 'clang' 'git' 'pkgconf')
optdepends=(
    'orca: GNOME Screen Reader activation and speech'
    'gnome-keyring: user network secret storage'
    'xdg-desktop-portal-gnome: screenshots and screen sharing for apps'
    'greetd: login manager driving tuna-greeter'
    'xorg-xwayland: X11 application support'
    'ibus: input methods (tuna-ibus-bridge, as GNOME uses IBus)'
    'gst-plugin-pipewire: screen recording from the screenshot UI'
    'gst-plugins-good: screen recording (VP8 and WebM)'
)
options=('!lto' '!debug')
backup=('etc/pam.d/tuna-lock')

if [[ -n "${TUNA_LOCAL_SRC:-}" ]]; then
    source=()
    sha256sums=()
else
    source=("tuna::git+${url}.git#tag=v${_semver}")
    sha256sums=('SKIP')
fi

_srcroot() {
    if [[ -n "${TUNA_LOCAL_SRC:-}" ]]; then
        printf '%s' "$TUNA_LOCAL_SRC"
    else
        printf '%s' "$srcdir/tuna"
    fi
}

prepare() {
    cd "$(_srcroot)"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_srcroot)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    export TUNA_VERSION="v${_semver}"
    cargo build --frozen --release \
        -p tuna-compositor -p tuna-shell-host -p tuna-shell-gtk -p tuna-greeter
}

check() {
    local bin
    for bin in tuna-compositor tuna-session tuna-shell-host tuna-shell-gtk tuna-ibus-bridge tuna-greeter; do
        local reported
        reported="$("${CARGO_TARGET_DIR:-$srcdir/target}/release/$bin" --version | awk '{print $NF}')"
        if [[ "$reported" != "$_semver" ]]; then
            echo "$bin reports $reported, expected $_semver" >&2
            return 1
        fi
    done
}

package() {
    local root target bin
    root="$(_srcroot)"
    target="${CARGO_TARGET_DIR:-$srcdir/target}/release"
    for bin in tuna-compositor tuna-session tuna-shell-host tuna-shell-gtk tuna-ibus-bridge tuna-greeter; do
        install -Dm0755 "$target/$bin" "$pkgdir/usr/bin/$bin"
    done
    install -Dm0644 "$root/share/wayland-sessions/tuna.desktop" \
        "$pkgdir/usr/share/wayland-sessions/tuna.desktop"
    install -Dm0644 "$root/share/systemd/user/tuna-session.target" \
        "$pkgdir/usr/lib/systemd/user/tuna-session.target"
    install -Dm0644 "$root/share/xdg-desktop-portal/portals/tuna.portal" \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/tuna.portal"
    install -Dm0644 "$root/packaging/marlin/tuna-portals.conf" \
        "$pkgdir/usr/share/xdg-desktop-portal/tuna-portals.conf"
    # Private GNOME51 scalable cursor fallback; no system Adwaita file conflicts.
    install -d "$pkgdir/usr/share/tuna-desktop/icons"
    cp -a "$root/share/tuna-desktop/icons/." "$pkgdir/usr/share/tuna-desktop/icons/"
    # Lock-screen PAM service (#62): unlock under GDM, where no greetd runs.
    install -Dm0644 "$root/share/pam.d/tuna-lock" "$pkgdir/etc/pam.d/tuna-lock"
    install -Dm0644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 "$root/docs/nested-session.md" \
        "$pkgdir/usr/share/doc/$pkgname/nested-session.md"
}
