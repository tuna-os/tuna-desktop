# GDM 51.1 libgdm/gdm-sessions.c collect_sessions(): the greeter searches the
# X session directories, then <data dir>/xsessions and <data dir>/wayland-sessions
# for each XDG data dir, which gdm-launch-environment.c prefixes with
# /usr/share/gdm/greeter for the greeter; earlier directories win by id.
GDM_DATA_DIRS = ("/usr/share/gdm/greeter", "/usr/local/share", "/usr/share")
GDM_SESSION_DIRS = (("/etc/X11/sessions", "/etc/gdm/Sessions", "/usr/share/gdm/BuiltInSessions")
                    + tuple(f"{root}/xsessions" for root in GDM_DATA_DIRS)
                    + tuple(f"{root}/wayland-sessions" for root in GDM_DATA_DIRS))
GDM_PATH = "/usr/local/sbin:/usr/local/bin:/usr/bin"


def desktop_entry(text):
    """[Desktop Entry] keys as GKeyFile reads them (last duplicate wins), or
    None when the group is absent."""
    group, found, keys = None, False, {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            group = line[1:-1]
            found = found or group == "Desktop Entry"
        elif group == "Desktop Entry" and "=" in line:
            key, value = line.split("=", 1)
            keys[key.strip()] = value.strip()
    return keys if found else None


def gdm_sessions(dirs=GDM_SESSION_DIRS, which=None):
    """[[id, Name]] GDM offers: key_file_is_relevant() drops NoDisplay, Hidden
    and failing TryExec entries (and removes an earlier same-id entry), a
    missing Name skips the file, and remove_duplicate_sessions() keeps one
    session per Name."""
    import shutil
    which = which or (lambda program: shutil.which(program, path=GDM_PATH))
    available = {}
    for directory in reversed(dirs):
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".desktop"):
                continue
            session_id = name[:-len(".desktop")]
            try:
                keys = desktop_entry(pathlib.Path(directory, name).read_text())
            except (OSError, UnicodeDecodeError):
                continue
            if keys is None or "Name" not in keys:
                continue
            tryexec = keys.get("TryExec", "")
            if (keys.get("NoDisplay") in ("true", "1") or keys.get("Hidden") in ("true", "1")
                    or (tryexec and which(tryexec) is None)):
                available.pop(session_id, None)
                continue
            available[session_id] = keys["Name"]
    offered, seen = [], set()
    for session_id, title in sorted(available.items()):
        if title not in seen:
            seen.add(title)
            offered.append([session_id, title])
    return offered


# GDM 51.1 daemon/gdm-session.c get_system_session_dirs() for Wayland: the
# daemon's own XDG data dirs (GLib default /usr/local/share:/usr/share)
# between the greeter directory and DATADIR; the first file found wins.
GDM_LAUNCH_DIRS = ("/usr/share/gdm/greeter/wayland-sessions", "/usr/local/share/wayland-sessions",
                   "/usr/share/wayland-sessions", "/usr/share/wayland-sessions")


def gdm_daemon_key(key, path=pathlib.Path("/etc/gdm/custom.conf")):
    """[daemon] key from GDM's configuration, or None."""
    group, value = None, None
    for line in path.read_text().splitlines() if path.exists() else []:
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            group = line[1:-1]
        elif group == "daemon" and "=" in line and line.split("=", 1)[0].strip() == key:
            value = line.split("=", 1)[1].strip()
    return value


def gdm_fallback_session(config=pathlib.Path("/etc/gdm/custom.conf"), dirs=GDM_LAUNCH_DIRS, which=None):
    """The session GDM 51.1 starts for a user without a saved session:
    get_fallback_session_name() takes [daemon] FallbackSession (default
    "gnome") when get_session_command_for_file() accepts it, which rejects
    only Hidden, a failing TryExec or a missing Exec (NoDisplay still
    launches); otherwise the first such session id in sorted order."""
    import shutil
    which = which or (lambda program: shutil.which(program, path=GDM_PATH))

    def launchable(session_id):
        for directory in dirs:
            path = pathlib.Path(directory, f"{session_id}.desktop")
            if path.exists():
                try:
                    keys = desktop_entry(path.read_text())
                except (OSError, UnicodeDecodeError):
                    return False
                return (keys is not None and keys.get("Hidden") not in ("true", "1")
                        and (not keys.get("TryExec") or which(keys["TryExec"]) is not None)
                        and bool(keys.get("Exec")))
        return False

    configured = gdm_daemon_key("FallbackSession", config) or "gnome"
    if launchable(configured):
        return configured
    candidates = set()
    for directory in dirs:
        try:
            candidates.update(name[:-len(".desktop")] for name in os.listdir(directory)
                              if name.endswith(".desktop"))
        except OSError:
            continue
    return next((session_id for session_id in sorted(candidates) if launchable(session_id)), None)


def call(*args, user=False, check=True):
    command = list(args)
    if user:
        command = ["runuser", "-u", OWNER.pw_name, "--", "env",
                   f"XDG_RUNTIME_DIR={RUNTIME}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", *command]
    return subprocess.run(command, capture_output=True, text=True,
                          timeout=15, check=check).stdout.strip()



def gpu_pci_caps():
    result = {}
    for card in pathlib.Path("/sys/class/drm").glob("card[0-9]*"):
        config = card / "device/config"
        if not config.exists():
            continue
        with config.open("rb") as stream:
            data = stream.read(256)
        if len(data) < 64:
            continue
        pm = pcie = 0
        offset, seen = data[0x34] & ~3, set()
        while 0x40 <= offset < len(data) - 1 and offset not in seen:
            seen.add(offset)
            if data[offset] == 1:
                pm = offset
            elif data[offset] == 0x10:
                pcie = offset
            offset = data[offset + 1] & ~3
        control = int.from_bytes(data[pm + 4:pm + 6], "little") if pm else 0
        result[card.name] = {"slot": (card / "device").resolve().name,
                             "pm_capability": pm, "pcie_capability": pcie,
                             "no_soft_reset": bool(control & 8), "power_state": control & 3}
    return result



PAM_HELPER_FLAG = b"--internal-pam-conversation"


def auth_process(pid, attempts=20):
    """Read only fixed helper flags and kernel identity; never return argv.

    fork → setpgid → exec and exit pass a process through instants at which
    two reads disagree: a new group, executable or setuid owner, or the empty
    command line of an address space being replaced or released. Every PAM
    unlock does this twice (the compositor's helper spawn, then pam_unix's
    unix_chkpwd child), so a read straddling one is repeated until the kernel
    identity is self-consistent. A process that left is absent (None); one
    that never settles still fails with its fixed code."""
    path = pathlib.Path(f"/proc/{pid}")
    for attempt in range(attempts):
        try:
            first = (path / "stat").read_text().rsplit(")", 1)[1].split()
            uid = path.stat().st_uid
            executable = pathlib.Path(os.readlink(path / "exe")).name
            inode = (path / "exe").stat()
            marked = private = False
            if executable == COMPOSITOR:
                with (path / "cmdline").open("rb") as stream:
                    raw = stream.read(4097)
                if len(raw) > 4096 or not raw.endswith(b"\0"):
                    error = RuntimeError("unbounded or partial compositor command metadata")
                    error.delayed_auth_code = "process-metadata-invalid"
                    raise error
                args = raw[:-1].split(b"\0")
                marked = PAM_HELPER_FLAG in args
                private = len(args) == 2 and args[1] == PAM_HELPER_FLAG
            second = (path / "stat").read_text().rsplit(")", 1)[1].split()
            after = (path / "exe").stat()
            if ((first[19], first[1], first[2]) != (second[19], second[1], second[2])
                    or (inode.st_dev, inode.st_ino) != (after.st_dev, after.st_ino)
                    or uid != path.stat().st_uid):
                error = RuntimeError("authentication process identity changed during read")
                error.delayed_auth_code = "process-identity-changed"
                raise error
            return {"pid": int(pid), "uid": uid, "ppid": int(first[1]),
                    "pgrp": int(first[2]), "start_ticks": int(first[19]),
                    "executable": executable, "exe_device": inode.st_dev, "exe_inode": inode.st_ino,
                    "_marked": marked, "_private": private, "_state": second[0]}
        except (FileNotFoundError, ProcessLookupError):
            return None
        except RuntimeError:
            if attempt + 1 >= attempts:
                raise
        time.sleep(0.005)


def public_auth_identity(value):
    return {key: item for key, item in value.items() if not key.startswith("_")}


def classify_pam_helpers(rows):
    """Exact owned held-self children, not an arbitrary descendant sleep."""
    roots = [row for row in rows if row["uid"] == OWNER.pw_uid
             and row["executable"] == COMPOSITOR and not row["_marked"]]
    if len(roots) != 1:
        return None, []
    desktop = roots[0]
    helpers = [row for row in rows if row["_private"] and row["_state"] not in ("Z", "X")
               and row["uid"] == desktop["uid"] and row["ppid"] == desktop["pid"]
               and row["pgrp"] == row["pid"] and row["start_ticks"] >= desktop["start_ticks"]
               and (row["exe_device"], row["exe_inode"]) == (desktop["exe_device"], desktop["exe_inode"])]
    return desktop, helpers


def pam_process_snapshot():
    rows = []
    for path in pathlib.Path("/proc").iterdir():
        if path.name.isdigit():
            # Limit command metadata reads to the original user and fixed binaries.
            try:
                if path.stat().st_uid != OWNER.pw_uid:
                    continue
                name = pathlib.Path(os.readlink(path / "exe")).name
                if name not in (COMPOSITOR, "sleep"):
                    continue
                row = auth_process(int(path.name))
                if row is not None:
                    rows.append(row)
            except (FileNotFoundError, ProcessLookupError):
                continue
    return rows


def delayed_auth_state(pid, start_ticks):
    stage = "process-snapshot"
    try:
        rows = pam_process_snapshot()
        stage = "desktop-identity"
        desktop, helpers = classify_pam_helpers(rows)
        if desktop is None or (desktop["pid"], desktop["start_ticks"]) != (pid, start_ticks):
            error = RuntimeError("original desktop identity missing or replaced")
            error.delayed_auth_code = "desktop-identity-mismatch"
            if desktop is None:
                roots = [row for row in rows if row["uid"] == OWNER.pw_uid
                         and row["executable"] == COMPOSITOR and not row["_marked"]]
                error.delayed_auth_code = "desktop-not-unique"
                error.delayed_auth_root_count = min(len(roots), 65535)
                error.delayed_auth_expected_present = any(
                    (row["pid"], row["start_ticks"]) == (pid, start_ticks) for row in roots)
            raise error
        stage = "sleep-identity"
        sleep_inode = pathlib.Path("/usr/bin/sleep").stat()
        # pam_exec forks the command and calls setsid() before exec, so the
        # delay is the helper's direct child leading its own session and group.
        stage = "delay-ownership"
        delays = [row for row in rows if row["executable"] == "sleep" and row["_state"] not in ("Z", "X")
                  and (row["exe_device"], row["exe_inode"]) == (sleep_inode.st_dev, sleep_inode.st_ino)
                  and any(row["uid"] == helper["uid"] and row["ppid"] == helper["pid"]
                          and row["pgrp"] == row["pid"] and row["start_ticks"] >= helper["start_ticks"]
                          for helper in helpers)]
        stage = "owner-read"
        owner_text = STATE.read_text()
        stage = "owner-parse"
        owner = json.loads(owner_text).get("auth_owner")
        # The legacy password worker or the lock conversation (#366) owns it.
        pending = type(owner) is dict and (
            owner.get("outer_pending") is True
            or (type(owner.get("conversations")) is dict
                and owner["conversations"].get("password") is True))
        stage = "serialization"
        return {"real_pam_delay_running": pending and len(helpers) == 1 and len(delays) == 1,
                "auth_owner": owner,
                "compositor": public_auth_identity(desktop),
                "helpers": [public_auth_identity(row) for row in helpers],
                "delays": [public_auth_identity(row) for row in delays]}
    except Exception as error:
        error.delayed_auth_stage = stage
        raise


def delayed_auth_error(error):
    """Fixed failure codes only; never exception strings, argv or raw stderr."""
    types = {"RuntimeError", "ValueError", "TypeError", "KeyError", "IndexError", "AttributeError",
             "OSError", "FileNotFoundError", "PermissionError", "ProcessLookupError",
             "JSONDecodeError", "UnicodeDecodeError"}
    stages = {"arguments", "process-snapshot", "desktop-identity", "sleep-identity",
              "delay-ownership", "owner-read", "owner-parse", "serialization"}
    codes = {"process-metadata-invalid": "process-snapshot",
             "process-identity-changed": "process-snapshot",
             "desktop-not-unique": "desktop-identity",
             "desktop-identity-mismatch": "desktop-identity"}
    kind = type(error).__name__
    stage = getattr(error, "delayed_auth_stage", None)
    stage = stage if type(stage) is str and stage in stages else "arguments"
    result = {"stage": stage, "exception_type": kind if kind in types else "OtherError",
              "code": "observation-exception"}
    code = getattr(error, "delayed_auth_code", None)
    if kind == "RuntimeError" and type(code) is str and codes.get(code) == stage:
        if code == "desktop-not-unique":
            count = getattr(error, "delayed_auth_root_count", None)
            present = getattr(error, "delayed_auth_expected_present", None)
            if (type(count) is not int or not 0 <= count <= 65535 or count == 1
                    or type(present) is not bool or (count == 0 and present)):
                return result
            result.update(root_count=count, expected_desktop_present=present)
        result["code"] = code
    return result


def auth_retirement_state(record):
    if type(record) is not dict or set(record) != {"compositor", "helper", "delay", "attempt"}:
        raise ValueError("invalid original authentication observation")
    current = auth_process(record["compositor"]["pid"])
    if current is None or public_auth_identity(current) != record["compositor"]:
        raise RuntimeError("original desktop changed before retirement observation")
    presence = {}
    for role in ("helper", "delay"):
        current = auth_process(record[role]["pid"])
        # Retiring the helper orphans a still-running delay, which the kernel
        # reparents: a new ppid is the same process, still not absent. Every
        # other identity field (start time, group, uid, executable) must hold.
        if current is not None and ({k: v for k, v in public_auth_identity(current).items() if k != "ppid"}
                                    != {k: v for k, v in record[role].items() if k != "ppid"}):
            raise RuntimeError("original method PID was replaced")
        presence[role + "_absent"] = current is None and not pathlib.Path(f"/proc/{record[role]['pid']}").exists()
    # Absence of two PIDs alone is not absence of other owned group descendants:
    # the helper's group, and the session pam_exec's setsid() gave the delay.
    groups = {record["helper"]["pid"], record["delay"]["pid"]}
    members = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            fields = (path / "stat").read_text().rsplit(")", 1)[1].split()
            if int(fields[2]) in groups:
                members.append({"pid": int(path.name), "start_ticks": int(fields[19])})
        except (FileNotFoundError, ProcessLookupError):
            continue
    # Recheck after the group scan; a reused numeric PID cannot become an
    # absence receipt while this observation is being assembled.
    for role in ("helper", "delay"):
        if presence[role + "_absent"] and pathlib.Path(f"/proc/{record[role]['pid']}").exists():
            raise RuntimeError("original method PID appeared during absence observation")
    current = auth_process(record["compositor"]["pid"])
    if current is None or public_auth_identity(current) != record["compositor"]:
        raise RuntimeError("original desktop changed during retirement observation")
    return presence | {"owned_group_members": sorted(members, key=lambda row: row["pid"]),
                       "original": record}


def owner_login_session():
    """The fixture user's single logind session from the qualified login."""
    sessions = [line.split() for line in call("loginctl", "list-sessions",
                                             "--no-legend", "--no-pager").splitlines()]
    owned = []
    for line in sessions:
        if len(line) < 2 or line[1] != str(OWNER.pw_uid):
            continue
        # Every runuser probe opens a short logind session for this UID, and
        # one may close between list-sessions and show-session. A vanished
        # session yields no properties; the single login session still must.
        description = call("loginctl", "show-session", line[0], "--property=Id",
                           "--property=VTNr", "--property=User", "--property=Type",
                           "--property=Service", "--property=Class", check=False)
        properties = dict(item.split("=", 1) for item in description.splitlines())
        vt = properties.get("VTNr", "")
        if (properties.get("Service") == LOGIN_SERVICE
                and vt.isdigit() and vt != "0"
                and properties.get("User") == str(OWNER.pw_uid)
                and not properties.get("Class", "").startswith("manager")):
            owned.append(properties)
    if len(owned) != 1:
        raise RuntimeError(f"expected exactly one {LOGIN_SERVICE} user session on a VT")
    return owned[0]


def inventory():
    # Each failure carries its fixed stage; main() returns it with the
    # exception type and this probe's frame locations, never exception text.
    stage = "state-read"
    try:
        text = STATE.read_text()
        stage = "state-parse"
        state = json.loads(text)
        stage = "pam-snapshot"
        _, helpers = classify_pam_helpers(pam_process_snapshot())
        helper_identities = {row["pid"]: public_auth_identity(row) for row in helpers}
        stage = "process-scan"
        processes = []
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                uid = path.stat().st_uid
                executable = pathlib.Path(os.readlink(path / "exe")).name
                if int(path.name) in helper_identities:
                    observed_helper = auth_process(int(path.name))
                    # The exact private helper this scan classified, still
                    # itself or since departed, is never an owned compositor.
                    if observed_helper is None or (observed_helper["_private"]
                            and public_auth_identity(observed_helper) == helper_identities[int(path.name)]):
                        continue
                if uid != OWNER.pw_uid or executable not in {
                    COMPOSITOR, SHELL_GTK, "gnome-disks",
                    "gnome-system-monitor", "nautilus",
                }:
                    continue
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                processes.append({"pid": int(path.name), "uid": uid,
                                  "executable": executable, "start_ticks": int(stat[19])})
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        stage = "login-session"
        owned = owner_login_session()
        stage = "snapshot-keys"
        # Only the original four snapshot keys are mandatory: the published
        # flavor still ships a Tuna Desktop build that predates the newer
        # instrumentation, and session detection must not depend on it.
        # Gates that need a newer key observe an explicit None instead of
        # collapsing every probe into a missing session (run 37696030597).
        return {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
                "session": owned,
                # Published pre-key snapshots (run 37696030597) still detect the
                # session; a missing device list stays None, never an empty list.
                "state": {k: state[k] for k in ("locked", "windows", "focused", "active_workspace")}
                         | {k: state.get(k) for k in ("overview_open", "pointer_position",
                                                      "native_relative_motion_count", "input_devices",
                                                      "mouse_left_handed", "touchpad_left_handed",
                                                      "hot_corners", "auth_owner", "power_save_mode")},
                "processes": sorted(processes, key=lambda item: item["pid"])}
    except Exception as error:
        error.inventory_stage = stage
        raise


INVENTORY_STAGES = ("state-read", "state-parse", "pam-snapshot", "process-scan",
                    "login-session", "snapshot-keys")


def inventory_error(error):
    """Fixed stage, type and code plus this probe's own frame locations;
    never exception text, argv, paths, subprocess output or locals."""
    oserrors = {"OSError", "FileNotFoundError", "PermissionError", "ProcessLookupError"}
    types = oserrors | {"RuntimeError", "ValueError", "TypeError", "KeyError", "IndexError",
                        "AttributeError", "StopIteration", "JSONDecodeError", "UnicodeDecodeError",
                        "CalledProcessError", "TimeoutExpired"}
    kind = type(error).__name__
    stage = getattr(error, "inventory_stage", None)
    code = getattr(error, "delayed_auth_code", None)
    result = {"stage": stage if type(stage) is str and stage in INVENTORY_STAGES else "unstaged",
              "exception_type": kind if kind in types else "OtherError",
              "code": code if kind == "RuntimeError" and code in ("process-identity-changed",
                                                                 "process-metadata-invalid")
              else "observation-exception"}
    number = getattr(error, "errno", None)
    if kind in oserrors and type(number) is int and 0 <= number <= 4095:
        result["errno"] = number
    returncode = getattr(error, "returncode", None)
    if kind == "CalledProcessError" and type(returncode) is int and -255 <= returncode <= 255:
        result["returncode"] = returncode
    # Function names and line numbers in this file locate the failing check
    # at the reported commit; other files' frames and source text are omitted.
    source = inventory_error.__code__.co_filename
    result["frames"] = [[frame.name, frame.lineno]
                        for frame in traceback.extract_tb(error.__traceback__)
                        if frame.filename == source and type(frame.lineno) is int
                        and 0 < frame.lineno <= 1000000 and len(frame.name) <= 64
                        and frame.name.isascii() and frame.name.isidentifier()][-16:]
    return result


def owned_compositor(processes):
    candidates = [process for process in processes
                  if process.get("executable") == "tuna-compositor"
                  and process.get("uid") == OWNER.pw_uid]
    if len(candidates) != 1:
        raise RuntimeError("one original same-user compositor is required")
    return candidates[0]


