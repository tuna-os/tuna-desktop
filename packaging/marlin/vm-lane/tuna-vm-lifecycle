                  "power-button-block": power_button_block}[action](sys.argv[2])
    elif action == "logout":
        # The product's Log Out: the compositor's org.gnome.SessionManager
        # Logout(1), no confirmation, which ends the compositor (the session
        # leader) as gnome-session ends a GNOME session. A guest predating
        # that manager logs out as its shell's Log Out did, through logind.
        owned = call("gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
                     "--object-path", "/org/freedesktop/DBus",
                     "--method", "org.freedesktop.DBus.NameHasOwner", "org.gnome.SessionManager",
                     user=True) == "(true,)"
        if owned:
            # The reply can race the compositor's exit; the lane judges the outcome.
            call("gdbus", "call", "--session", "--dest", "org.gnome.SessionManager",
                 "--object-path", "/org/gnome/SessionManager",
                 "--method", "org.gnome.SessionManager.Logout", "1", user=True, check=False)
        else:
            call("loginctl", "terminate-session", inventory()["session"]["Id"])
        result = {"requested": "session manager logout" if owned else "terminate session"}
    elif action == "login-session":
        # Before Tuna Desktop writes its state snapshot: which desktop the
        # login actually started, by fixed process name only.
        result = {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
                  "session": owner_login_session(),
                  "desktop": [name for name in ("tuna-session", COMPOSITOR_COMM, "gnome-shell", "gnome-session-s")
                              if call("pgrep", "-u", str(OWNER.pw_uid), "-x", name, check=False)]}
    elif action == "greeter":
        # GDM's greeter is gnome-shell in a logind greeter-class session of
        # its own (dynamic) non-root user.
        result = {"manager": DISPLAY_MANAGER.resolve().stem,
                  "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
                  "manager_active": call("systemctl", "is-active", "gdm.service",
                                         check=False) == "active",
                  "probe_uid": os.geteuid(),
                  "compositor_pids": call("pgrep", "-u", str(OWNER.pw_uid), "-x",
                                          COMPOSITOR_COMM, check=False).splitlines()}
        greeter_sessions = []
        for line in call("loginctl", "list-sessions", "--no-legend", "--no-pager").splitlines():
            fields = line.split()
            if not fields:
                continue
            description = call("loginctl", "show-session", fields[0], "--property=Id",
                               "--property=User", "--property=Class", "--property=Service",
                               "--property=Active", "--property=VTNr", check=False)
            properties = dict(item.split("=", 1) for item in description.splitlines() if "=" in item)
            if properties.get("Class") == "greeter":
                greeter_sessions.append(properties)
        greeter_pids = [pid for uid in sorted({s.get("User", "") for s in greeter_sessions} - {""})
                        for pid in call("pgrep", "-u", uid, "-x", "gnome-shell", check=False).splitlines()]
        result |= {"greeter_sessions": greeter_sessions,
                   "sessions": gdm_sessions(),
                   "fallback_session": gdm_fallback_session(),
                   "greeter_pids": greeter_pids,
                   "greeter_uids": [pathlib.Path(f"/proc/{pid}").stat().st_uid for pid in greeter_pids]}
    elif action in FRESH_ACTIONS:
        # tunaOS#4092: record-free accounts made by tuna-vm-fresh-accounts.
        # Only the fixed public fixture names are accepted.
        if len(sys.argv) != 3 or sys.argv[2] not in FRESH_USERS:
            raise ValueError("fresh-account action takes one fixture account name")
        result = FRESH_ACTIONS[action](sys.argv[2])
    elif action == "reboot":
        boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        # Let the guest-exec receipt finish before reboot stops its QGA service.
        # Match the existing deferred reboot used by the Corral session driver.
        call("systemd-run", "--quiet", "--collect", "--unit=tuna-vm-lane-reboot",
             "--on-active=2s", "/usr/bin/systemctl", "reboot")
        result = {"requested": "reboot", "boot_id": boot_id}
    elif action == "payload":
        payload = pathlib.Path("/usr/share/tuna-vm/shipped-payload.sha256")
        call("sha256sum", "--check", str(payload))
        package = pathlib.Path("/usr/share/tuna-vm/shipped-package.txt").read_text().strip()
        if call("pacman", "-Q", PACKAGE) != package:
            raise RuntimeError("shipped Tuna Desktop package changed")
        result = {"probe_uid": os.geteuid(), "package": package,
                  "payload_sha256": payload.read_text().splitlines(),
                  "shipped_packages": pathlib.Path("/usr/share/tuna-vm/shipped-packages.txt").read_text().splitlines(),
                  "fixture_packages": pathlib.Path("/usr/share/tuna-vm/fixture-packages.txt").read_text().splitlines()}
    else:
        raise ValueError("unknown lifecycle action")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
