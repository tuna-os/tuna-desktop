GSD_POWER_MONITOR = pathlib.Path("/run/tuna-vm-gsd-power-monitor.log")
GSD_POWER_STATE = pathlib.Path("/run/tuna-vm-gsd-power-state.json")
POWER_BUTTON_STATE = pathlib.Path("/run/tuna-vm-power-button-state.json")
POWER_BUTTON_SESSION_LOG = pathlib.Path("/run/tuna-vm-power-button-session.log")
POWER_BUTTON_SYSTEM_LOG = pathlib.Path("/run/tuna-vm-power-button-system.log")
POWER_BUTTON_LOG_BOUND = 64 << 20
MEDIA_KEYS = "org.gnome.SettingsDaemon.MediaKeys"
# gsd-media-keys' GrabAccelerators/AcceleratorActivated exchange with the
# org.gnome.Shell key grabber, gnome-session's Shutdown entry point and the
# shell's EndSessionDialog. Method returns are matched to their calls by
# (destination, reply_serial) because the replier's unique name is not
# known when the monitor starts.
POWER_BUTTON_SESSION_RULES = (
    "type='method_call',interface='org.gnome.Shell',member='GrabAccelerators'",
    "type='method_return'",
    "type='error'",
    "type='signal',interface='org.gnome.Shell',member='AcceleratorActivated'",
    "type='method_call',interface='org.gnome.SessionManager',member='Shutdown'",
    "type='method_call',interface='org.gnome.SessionManager.EndSessionDialog'",
    "type='signal',interface='org.gnome.SessionManager.EndSessionDialog'")
# logind power requests, their error replies and logind's own announcement
# that it is about to act (gsd-media-keys' logind_power_action:
# PowerOffWithFlags/SuspendWithFlags/HibernateWithFlags). gsd passes no reply
# callback, so GDBus sends these calls NO_REPLY_EXPECTED and logind answers
# nothing, not even a refusal: a refused request shows as a call that
# PrepareForShutdown/PrepareForSleep never follows while PreparingForShutdown
# stays false.
POWER_BUTTON_LOGIND_CALLS = ("PowerOff", "PowerOffWithFlags", "Suspend", "SuspendWithFlags",
                             "Hibernate", "HibernateWithFlags")
POWER_BUTTON_LOGIND_PREPARE = ("PrepareForShutdown", "PrepareForSleep")
POWER_BUTTON_SYSTEM_RULES = tuple(
    f"type='method_call',interface='org.freedesktop.login1.Manager',member='{member}'"
    for member in POWER_BUTTON_LOGIND_CALLS) + tuple(
    f"type='signal',interface='org.freedesktop.login1.Manager',member='{member}'"
    for member in POWER_BUTTON_LOGIND_PREPARE) + ("type='error'",)
POWER_BUTTON_ACTIONS = ("interactive", "nothing")
# A block inhibitor on shutdown held by the fixture itself (root): since
# systemd 257 a strong block inhibitor refuses PowerOffWithFlags without
# SD_LOGIND_SKIP_INHIBITORS outright, which is how gsd 51 powers off a VM.
POWER_BUTTON_BLOCK_WHO = "tuna-vm-lane"
POWER_BUTTON_BLOCK_SYSTEMD = 257


def gsd_executable(plugin):
    """`gsd-<plugin>` as gnome-settings-daemon 51 plugins/meson.build names it."""
    return "gsd-" + "".join(("-" if index and char.isupper() else "") + char.lower()
                            for index, char in enumerate(plugin))


def bus_owner(name):
    """(unique name, pid) of the session-bus owner of `name`, else None."""
    try:
        owner = shlex.split(call("busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                 "org.freedesktop.DBus", "GetNameOwner", "s", name, user=True))
    except subprocess.CalledProcessError:
        return None
    if len(owner) != 2 or owner[0] != "s":
        raise RuntimeError(f"unexpected owner reply for {name}")
    pid = call("busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
               "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", owner[1], user=True).split()
    if len(pid) != 2 or pid[0] != "u":
        raise RuntimeError(f"unexpected pid reply for {name}")
    return [owner[1], int(pid[1])]


def user_unit(unit):
    shown = call("systemctl", "--user", "show", unit, "--property=LoadState",
                 "--property=ActiveState", "--property=MainPID", user=True)
    return dict(line.split("=", 1) for line in shown.splitlines() if "=" in line)


def gsd_plugin_row(plugin):
    """The plugin's unit, bus owner and owner process identity."""
    name = f"org.gnome.SettingsDaemon.{plugin}"
    row = {"unit": user_unit(name + ".service"), "owner": bus_owner(name)}
    if row["owner"]:
        proc = pathlib.Path(f"/proc/{row['owner'][1]}")
        executable = os.readlink(proc / "exe")
        row.update(uid=proc.stat().st_uid, executable=executable,
                   package=call("pacman", "-Qqo", executable, check=False))
    row["ok"] = (row["unit"].get("ActiveState") == "active" and row["owner"] is not None
                 and row["unit"].get("MainPID") == str(row["owner"][1])
                 and row.get("uid") == OWNER.pw_uid
                 and pathlib.Path(row.get("executable", "")).name == gsd_executable(plugin)
                 and row.get("package") == "gnome-settings-daemon")
    return row


def gsd_plugins():
    """Each started plugin is the packaged gsd binary, running as the session
    user under its own unit and owning its bus name; Tuna's own services keep
    theirs; the compositor holds the session leader FIFO."""
    compositor = owned_compositor(inventory()["processes"])
    started = {plugin: gsd_plugin_row(plugin) for plugin in GSD_STARTED}
    color = bus_owner("org.gnome.SettingsDaemon.Color")
    tuna = {"Color": {"owner": color, "ok": color is not None and color[1] == compositor["pid"]}}
    for plugin in GSD_TUNA_OWNED:
        name = f"org.gnome.SettingsDaemon.{plugin}"
        owner, unit = bus_owner(name), user_unit(name + ".service")
        tuna[plugin] = {"owner": owner, "unit": unit,
                        "ok": owner is None and unit.get("ActiveState") != "active"}
    targets = {unit: user_unit(unit).get("ActiveState") for unit in (
        "tuna-session.target", "gnome-session.target", "gnome-session-initialized.target",
        "gnome-session-monitor.service")}
    fds = pathlib.Path(f"/proc/{compositor['pid']}/fd")
    leader = any(os.readlink(fd) == LEADER_FIFO for fd in fds.iterdir())
    # XSettings follows Xwayland; record it without requiring an X11 client.
    xsettings = user_unit("org.gnome.SettingsDaemon.XSettings.service")
    return {"started": started, "tuna": tuna, "targets": targets, "leader_fifo_held": leader,
            "xsettings": xsettings, "x11_ready": json.loads(STATE.read_text()).get("x11_ready"),
            "pass": (all(row["ok"] for row in started.values())
                     and all(row["ok"] for row in tuna.values())
                     and all(state == "active" for state in targets.values()) and leader)}


def gsd_power_calls(text):
    """gsd-power's SetDimming and PowerSaveMode writes from dbus-monitor's
    text output, in bus order."""
    calls, block = [], []
    for line in text.splitlines() + [""]:
        if line.startswith((" ", "\t")):
            block.append(line.strip())
            continue
        if block and block[0].startswith("method call "):
            header = dict(part.split("=", 1) for part in block[0].replace(";", " ").split() if "=" in part)
            args = block[1:]
            if header.get("member") == "SetDimming" and args:
                calls.append({"sender": header.get("sender"), "time": float(header.get("time", 0)),
                              "call": "SetDimming", "value": args[0] == "boolean true"})
            elif (header.get("member") == "Set" and len(args) == 3
                  and args[1] == 'string "PowerSaveMode"'):
                calls.append({"sender": header.get("sender"), "time": float(header.get("time", 0)),
                              "call": "PowerSaveMode", "value": int(args[2].split()[-1])})
        block = [line] if line else []
    return calls


def dbus_monitor_messages(text):
    """Every message in dbus-monitor's text output, in bus order: header
    fields and stripped argument lines. Only complete lines count, so each
    message keeps its index while the monitor appends."""
    text = text[:text.rfind("\n") + 1]
    messages, block = [], []
    for line in text.splitlines() + [""]:
        if line.startswith((" ", "\t")):
            if block:
                block.append(line.strip())
            continue
        if block:
            kind = next((kind for kind in ("method call", "method return", "signal", "error")
                         if block[0].startswith(kind + " ")), None)
            if kind:
                header = dict(part.split("=", 1) for part in block[0].replace(";", " ").split() if "=" in part)
                # A broadcast prints "destination=(null destination)".
                destination = header.get("destination")
                messages.append({"index": len(messages), "type": kind, "sender": header.get("sender"),
                                 "destination": None if destination in (None, "(null") else destination,
                                 "serial": header.get("serial"), "reply_serial": header.get("reply_serial"),
                                 "interface": header.get("interface"), "member": header.get("member"),
                                 "error_name": header.get("error_name"), "args": block[1:]})
        block = [line] if line else []
    return messages


def power_button_log(path):
    with path.open("rb") as stream:
        data = stream.read(POWER_BUTTON_LOG_BOUND + 1)
    if len(data) > POWER_BUTTON_LOG_BOUND:
        raise RuntimeError("power button monitor log exceeds its bound")
    return dbus_monitor_messages(data.decode(errors="replace"))


def logind_inhibitors():
    listed = json.loads(call("busctl", "--system", "--json=short", "call", "org.freedesktop.login1",
                             "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "ListInhibitors"))
    return [dict(zip(("what", "who", "why", "mode", "uid", "pid"), row)) for row in listed["data"][0]]


def logind_preparing_for_shutdown():
    """logind's PreparingForShutdown: true once it has begun a power-off."""
    return json.loads(call("busctl", "--system", "--json=short", "get-property", "org.freedesktop.login1",
                           "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                           "PreparingForShutdown"))["data"]


def hostname_chassis():
    """hostnamed's Chassis property, which gsd reads once at startup."""
    return json.loads(call("busctl", "--system", "--json=short", "get-property", "org.freedesktop.hostname1",
                           "/org/freedesktop/hostname1", "org.freedesktop.hostname1", "Chassis"))["data"]


def machine_info_chassis(text):
    """The CHASSIS= value configured in /etc/machine-info, else None."""
    for line in (text or "").splitlines():
        if line.startswith("CHASSIS="):
            value = shlex.split(line[len("CHASSIS="):])
            return value[0] if value else ""
    return None


def system_bus_pid(name):
    try:
        reply = call("busctl", "--system", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                     "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", name).split()
    except subprocess.CalledProcessError:
        return None
    return int(reply[1]) if len(reply) == 2 and reply[0] == "u" else None


def power_button_observe():
    """gsd-media-keys' identity and inhibitors, its key grabs and
    activations, Shutdown and EndSessionDialog traffic on the session bus,
    logind power requests on the system bus and the compositor's layers."""
    session = power_button_log(POWER_BUTTON_SESSION_LOG)
    system = power_button_log(POWER_BUTTON_SYSTEM_LOG)

    def replies(messages):
        return {(m["destination"], m["reply_serial"]): m for m in messages
                if m["type"] in ("method return", "error") and m["reply_serial"]}
    session_replies, system_replies = replies(session), replies(system)

    def reply_of(table, message):
        reply = table.get((message["sender"], message["serial"]))
        if reply is None:
            return None
        text = next((arg[len('string "'):-1] for arg in reply["args"] if arg.startswith('string "')), None)
        return {"index": reply["index"], "type": reply["type"], "error_name": reply["error_name"],
                "message": text if reply["type"] == "error" else None}

    grabs = []
    for message in session:
        if message["type"] != "method call" or message["member"] != "GrabAccelerators":
            continue
        accelerators = [arg[len('string "'):-1] for arg in message["args"] if arg.startswith('string "')]
        reply = session_replies.get((message["sender"], message["serial"]))
        actions = ([int(arg.split()[1]) for arg in reply["args"] if arg.startswith("uint32 ")]
                   if reply is not None and reply["type"] == "method return" else None)
        power = (actions[accelerators.index("XF86PowerOff")]
                 if actions is not None and len(actions) == len(accelerators)
                 and "XF86PowerOff" in accelerators else None)
        grabs.append({"index": message["index"], "sender": message["sender"],
                      "accelerators": len(accelerators), "power_key": "XF86PowerOff" in accelerators,
                      "reply": reply["type"] if reply is not None else None, "power_action": power})
    activations = [{"index": m["index"], "sender": m["sender"], "destination": m["destination"],
                    "action": int(m["args"][0].split()[1])}
                   for m in session if m["type"] == "signal" and m["member"] == "AcceleratorActivated"
                   and m["args"][:1] and m["args"][0].startswith("uint32 ")]
    shutdowns = [{"index": m["index"], "sender": m["sender"], "destination": m["destination"],
                  "reply": reply_of(session_replies, m)}
                 for m in session if m["type"] == "method call"
                 and m["interface"] == "org.gnome.SessionManager" and m["member"] == "Shutdown"]
    dialog = [{"index": m["index"], "type": m["type"], "sender": m["sender"], "destination": m["destination"],
               "member": m["member"], "args": m["args"][:3]}
              for m in session if m["interface"] == "org.gnome.SessionManager.EndSessionDialog"
              and m["type"] in ("method call", "signal")]
    power_calls = [{"index": m["index"], "member": m["member"], "sender": m["sender"],
                    "sender_pid": system_bus_pid(m["sender"]), "args": m["args"][:1],
                    "reply": reply_of(system_replies, m)}
                   for m in system if m["type"] == "method call"
                   and m["interface"] == "org.freedesktop.login1.Manager"
                   and m["member"] in POWER_BUTTON_LOGIND_CALLS]
    saved = json.loads(POWER_BUTTON_STATE.read_text())
    layers = json.loads(STATE.read_text()).get("layers")
    return {"session_count": len(session), "system_count": len(system), "grabs": grabs,
            "activations": activations, "shutdowns": shutdowns, "dialog": dialog, "system": power_calls,
            "media_keys": gsd_plugin_row("MediaKeys"), "inhibitors": logind_inhibitors(),
            "prepare": [{"index": m["index"], "member": m["member"], "args": m["args"][:1]}
                        for m in system if m["type"] == "signal"
                        and m["member"] in POWER_BUTTON_LOGIND_PREPARE],
            "preparing_for_shutdown": logind_preparing_for_shutdown(),
            "session_user": OWNER.pw_name, "session_uid": OWNER.pw_uid,
            "owners": {"shell": bus_owner("org.gnome.Shell"),
                       "session_manager": bus_owner("org.gnome.SessionManager")},
            "layers": None if layers is None else [layer.get("namespace") for layer in layers],
            "monitors_alive": {name: pathlib.Path(f"/proc/{saved[name]}").exists()
                               for name in ("session_monitor", "system_monitor")}}


def power_button_start():
    if POWER_BUTTON_STATE.exists():
        raise RuntimeError("power button fixture already started")
    machine_info = pathlib.Path("/etc/machine-info")
    saved = {"action": call("gsettings", "get", "org.gnome.settings-daemon.plugins.power",
                            "power-button-action", user=True),
             "chassis": hostname_chassis(),
             "machine_info": machine_info.read_text() if machine_info.exists() else None,
             "systemd": int(call("systemctl", "--version").split()[1])}
    with POWER_BUTTON_SESSION_LOG.open("w") as log:
        session = subprocess.Popen(
            ["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
             f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", "dbus-monitor", "--session",
             *POWER_BUTTON_SESSION_RULES],
            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.DEVNULL, start_new_session=True)
    with POWER_BUTTON_SYSTEM_LOG.open("w") as log:
        system = subprocess.Popen(["dbus-monitor", "--system", *POWER_BUTTON_SYSTEM_RULES],
                                  stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.DEVNULL,
                                  start_new_session=True)
    saved.update(session_monitor=session.pid, system_monitor=system.pid)
    POWER_BUTTON_STATE.write_text(json.dumps(saved))
    time.sleep(1)
    if session.poll() is not None or system.poll() is not None:
        raise RuntimeError("dbus-monitor exited")
    return {"original_action": saved["action"], "original_chassis": saved["chassis"],
            "configured_chassis": machine_info_chassis(saved["machine_info"]),
            "systemd": saved["systemd"], **power_button_observe()}


def restart_media_keys():
    """Restart gsd-media-keys so it rereads hostnamed's chassis. The unit
    refuses manual start/stop, but restarting its PartOf target propagates."""
    old = bus_owner(MEDIA_KEYS)
    unit = user_unit(MEDIA_KEYS + ".service")
    try:
        call("systemctl", "--user", "restart", MEDIA_KEYS + ".target", user=True)
        route = "target"
    except subprocess.CalledProcessError:
        # Restart=on-failure brings an unclean exit back.
        pid = int(unit.get("MainPID", "0"))
        if old is None or pid <= 0 or pid != old[1]:
            raise
        os.kill(pid, signal.SIGKILL)
        route = "sigkill"
    return {"old_owner": old, "route": route}


def power_button_chassis(mode):
    saved = json.loads(POWER_BUTTON_STATE.read_text())
    machine_info = pathlib.Path("/etc/machine-info")
    if mode == "desktop":
        expected = "desktop"
    elif mode == "restore":
        expected = machine_info_chassis(saved["machine_info"]) or ""
    else:
        raise ValueError("unknown fixed chassis mode")
    call("busctl", "--system", "call", "org.freedesktop.hostname1", "/org/freedesktop/hostname1",
         "org.freedesktop.hostname1", "SetChassis", "sb", expected, "false")
    if mode == "restore":
        # hostnamed rewrites the whole file; put the image's bytes back.
        current = machine_info.read_text() if machine_info.exists() else None
        if current != saved["machine_info"]:
            if saved["machine_info"] is None:
                machine_info.unlink()
            else:
                machine_info.write_text(saved["machine_info"])
    chassis = hostname_chassis()
    if chassis != ("desktop" if mode == "desktop" else saved["chassis"]):
        raise RuntimeError("hostnamed chassis did not take the fixture value")
    current = machine_info.read_text() if machine_info.exists() else None
    return {"chassis": chassis, "machine_info_restored": current == saved["machine_info"],
            **restart_media_keys()}


def power_button_action(value):
    saved = json.loads(POWER_BUTTON_STATE.read_text())
    if value == "restore":
        target = saved["action"]
    elif value in POWER_BUTTON_ACTIONS:
        target = f"'{value}'"
    else:
        raise ValueError("unknown fixed power-button-action")
    schema, key = "org.gnome.settings-daemon.plugins.power", "power-button-action"
    call("gsettings", "set", schema, key, target, user=True)
    stored = call("gsettings", "get", schema, key, user=True)
    if stored != target:
        raise RuntimeError("power-button-action did not persist")
    return {"stored": stored}


def power_button_block(mode):
    saved = json.loads(POWER_BUTTON_STATE.read_text())
    listed = lambda: [row for row in logind_inhibitors() if row["who"] == POWER_BUTTON_BLOCK_WHO]
    if mode == "start":
        if saved["systemd"] < POWER_BUTTON_BLOCK_SYSTEMD:
            raise RuntimeError("logind predates strong block inhibitors; refusing to press a VM power-off")
        block = subprocess.Popen(
            ["systemd-inhibit", "--what=shutdown", f"--who={POWER_BUTTON_BLOCK_WHO}",
             "--why=V-POWER-BUTTON keeps the VM up", "--mode=block", "sleep", "infinity"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
        saved["block"] = block.pid
        POWER_BUTTON_STATE.write_text(json.dumps(saved))
        deadline = time.monotonic() + 5
        while not any(row["pid"] == block.pid and row["mode"] == "block"
                      and "shutdown" in row["what"].split(":") for row in listed()):
            if block.poll() is not None or time.monotonic() >= deadline:
                raise RuntimeError("fixture shutdown block inhibitor was not taken")
            time.sleep(0.1)
        return {"pid": block.pid, "systemd": saved["systemd"], "inhibitors": listed()}
    if mode != "stop":
        raise ValueError("unknown fixed block mode")
    pid = saved.pop("block", None)
    if pid is not None:
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    POWER_BUTTON_STATE.write_text(json.dumps(saved))
    deadline = time.monotonic() + 5
    while listed():
        if time.monotonic() >= deadline:
            raise RuntimeError("fixture shutdown block inhibitor was not released")
        time.sleep(0.1)
    return {"released": True}


def power_button_stop():
    saved = json.loads(POWER_BUTTON_STATE.read_text())
    for name in ("session_monitor", "system_monitor", "block"):
        if saved.get(name) is not None:
            try:
                os.killpg(saved[name], signal.SIGTERM)
            except ProcessLookupError:
                pass
    POWER_BUTTON_STATE.unlink()
    machine_info = pathlib.Path("/etc/machine-info")
    action = call("gsettings", "get", "org.gnome.settings-daemon.plugins.power",
                  "power-button-action", user=True)
    chassis = hostname_chassis()
    return {"action": action, "action_restored": action == saved["action"],
            "chassis": chassis, "chassis_restored": chassis == saved["chassis"],
            "machine_info_restored": (machine_info.read_text() if machine_info.exists() else None)
                                     == saved["machine_info"],
            "block_released": not any(row["who"] == POWER_BUTTON_BLOCK_WHO for row in logind_inhibitors())}



def orca_read_error(error):
    """Bounded diagnostics only for the fixed credential-free read action."""
    result = {"exception_type": type(error).__name__}
    if isinstance(error, OSError):
        result["errno"] = error.errno
    if isinstance(error, subprocess.CalledProcessError):
        result["returncode"] = error.returncode
        command = error.cmd if isinstance(error.cmd, list) else []
        # Never serialize argv, environment or arbitrary helper stderr. The
        # fixed D-Bus reads take only public names and return no secret values.
        try:
            index = command.index("busctl")
            dbus = command[index:]
            method = dbus[6]
            safe = dbus[1:3] == ["--user", "call"] and (
                (len(dbus) == 9 and dbus[3:6] == ["org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                "org.freedesktop.DBus"] and dbus[7] == "s"
                 and method in {"GetNameOwner", "GetConnectionUnixProcessID", "GetConnectionUnixUser"})
                or (len(dbus) == 7 and dbus[3].startswith(":") and method == "GetVersion"
                    and dbus[4:6] in [["/org/gnome/Orca/Service", "org.gnome.Orca.Service"],
                                     ["/org/gnome/Orca1/Service", "org.gnome.Orca1.Service"]]))
        except (ValueError, IndexError):
            safe = False
        if safe:
            result["dbus_method"] = method
            result["stderr"] = "".join(c for c in (error.stderr or "")[:512]
                                       if c.isprintable() or c in "\n\t")
    return result


CONSTRAINT_OWNER = pathlib.Path("/run/tuna-vm-constraint-owner.json")
CONSTRAINT_LOG = pathlib.Path("/run/tuna-vm-constraint.stderr")
CONSTRAINT_EXE = pathlib.Path("/usr/libexec/tuna-vm-constraints")


def constraint_process(pid):
    path = pathlib.Path(f"/proc/{pid}")
    executable = pathlib.Path(os.readlink(path / "exe"))
    if path.stat().st_uid != OWNER.pw_uid or executable != CONSTRAINT_EXE:
        raise RuntimeError("constraint client is not the actual original session executable")
    stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
    inode = (path / "exe").stat()
    return {"pid": pid, "uid": OWNER.pw_uid, "start_ticks": int(stat[19]),
            "executable": str(executable), "exe_inode": inode.st_ino,
            "exe_device": inode.st_dev, "exe_sha256": hashlib.sha256(CONSTRAINT_EXE.read_bytes()).hexdigest()}


def constraint_client(action):
    if action not in ("start", "status", "lock", "confine", "destroy", "empty", "restore", "quit"):
        raise ValueError("unknown fixed constraint action")
    if action == "start":
        if CONSTRAINT_OWNER.exists() or pathlib.Path(RUNTIME, "tuna-vm-constraints.sock").exists():
            raise RuntimeError("original constraint principal already exists")
        compositor = next(process for process in inventory()["processes"] if process["executable"] == COMPOSITOR)
        display = f"{NESTED}{compositor['pid']}"
        with CONSTRAINT_LOG.open("xb") as log:
            os.chmod(CONSTRAINT_LOG, 0o600)
            subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
                              f"WAYLAND_DISPLAY={display}", str(CONSTRAINT_EXE)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                             start_new_session=True)
        deadline = time.monotonic() + 5
        while not pathlib.Path(RUNTIME, "tuna-vm-constraints.sock").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual constraint principal did not bind its session socket")
            time.sleep(0.05)
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", "status", user=True))
        identity = constraint_process(snapshot["pid"])
        record = {"identity": identity, "display": display,
                  "surface_id": snapshot["surface_id"], "pointer_id": snapshot["pointer_id"],
                  "relative_id": snapshot["relative_id"],
                  "build_metadata": {name: pathlib.Path("/usr/share/tuna-vm-constraints", name).read_text()
                      for name in ("source-sha256sums", "build-sha256sums", "packages.txt", "compiler.txt")}}
        with CONSTRAINT_OWNER.open("x") as stream:
            os.chmod(CONSTRAINT_OWNER, 0o600)
            json.dump(record, stream)
    else:
        record = json.loads(CONSTRAINT_OWNER.read_text())
        identity = constraint_process(record["identity"]["pid"])
        if identity != record["identity"]:
            raise RuntimeError("actual original constraint client process changed")
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", action, user=True))
    if snapshot["uid"] != OWNER.pw_uid or snapshot["pid"] != record["identity"]["pid"]:
        raise RuntimeError("constraint response principal differs from original")
    if any(snapshot[key] != record[key] for key in ("surface_id", "pointer_id", "relative_id")):
        raise RuntimeError("original constraint protocol objects changed")
    if action == "quit":
        deadline = time.monotonic() + 5
        while pathlib.Path(f"/proc/{record['identity']['pid']}").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual original constraint client did not terminate")
            time.sleep(0.05)
    return {"principal": record, "client": snapshot}


def orca_child_diagnostic(state, pid):
    """Unready-child evidence only; never grants bus readiness or process authority."""
    if state.get("locked") is not False:
        return {"status": "locked"}
    if type(pid) is not int or pid <= 0:
        return {"status": "no-child"}
    def bounded(path, limit):
        with path.open("rb") as stream:
            data = stream.read(limit + 1)
        if len(data) > limit:
            raise OverflowError()
        return data
    try:
        process = pathlib.Path(f"/proc/{pid}")
        before = bounded(process / "stat", 4096).decode().rsplit(")", 1)[1].split()
        uid = process.stat().st_uid
        parent = int(before[1])
        ticks = int(before[19])
        executable = os.readlink(process / "exe")
        executed = os.stat(process / "exe")
        # Emit only known system Python/Orca executable names, never arbitrary paths.
        import re
        if not re.fullmatch(r"/usr/bin/(?:orca|python3(?:\.[0-9]{1,2})?)", executable):
            return {"status": "executable-refused"}
        parent_path = pathlib.Path(f"/proc/{parent}")
        parent_before = bounded(parent_path / "stat", 4096)
        if (uid != OWNER.pw_uid or parent_path.stat().st_uid != OWNER.pw_uid
                or os.readlink(parent_path / "exe") != f"/usr/bin/{COMPOSITOR}"):
            return {"status": "principal-refused"}
        environment = bounded(process / "environ", 128 * 1024)
        expected = f"{NESTED}{parent}".encode()
        displays = [item.split(b"=", 1)[1] for item in environment.split(b"\0")
                    if item.startswith(b"WAYLAND_DISPLAY=")]
        session_buses = [item.split(b"=", 1)[1] for item in environment.split(b"\0")
                         if item.startswith(b"DBUS_SESSION_BUS_ADDRESS=")]
        expected_bus = f"unix:path={RUNTIME}/bus".encode()
        package = call("pacman", "-Qqo", executable)
        if package not in {"python", "orca"}:
            return {"status": "package-refused"}
        after = bounded(process / "stat", 4096).decode().rsplit(")", 1)[1].split()
        final_state = json.loads(bounded(STATE, 1024 * 1024))
        executed_after = os.stat(process / "exe")
        if (after[19] != before[19] or after[1] != before[1]
                or process.stat().st_uid != uid or os.readlink(process / "exe") != executable
                or bounded(parent_path / "stat", 4096).decode().rsplit(")", 1)[1].split()[19]
                   != parent_before.decode().rsplit(")", 1)[1].split()[19]
                or parent_path.stat().st_uid != OWNER.pw_uid
                or os.readlink(parent_path / "exe") != f"/usr/bin/{COMPOSITOR}"
                or (executed_after.st_dev, executed_after.st_ino, executed_after.st_size)
                   != (executed.st_dev, executed.st_ino, executed.st_size)
                or type(final_state) is not dict or final_state.get("locked") is not False
                or final_state.get("screen_reader_pid") != pid):
            return {"status": "changed"}
        return {"status": "observed", "pid": pid, "uid": uid, "start_ticks": ticks,
                "parent_pid": parent, "executable": executable, "executable_package": package,
                "executed_dev": executed.st_dev, "executed_inode": executed.st_ino,
                "executed_size": executed.st_size,
                "display_matches_parent": displays == [expected],
                "session_bus_matches": session_buses == [expected_bus]}
    except (FileNotFoundError, ProcessLookupError):
        return {"status": "gone"}
    except PermissionError:
        return {"status": "permission"}
    except (OverflowError, ValueError, IndexError, UnicodeError):
        return {"status": "malformed"}
    except (OSError, subprocess.SubprocessError):
        return {"status": "acquisition-error"}


def orca_observation(session_settings=True):
    state = json.loads(STATE.read_text())
    pid = int(state.get("screen_reader_pid") or 0)
    contracts = []
    for name, path, prefix in (("org.gnome.Orca1.Service", "/org/gnome/Orca1/Service", "51."),
                               ("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "50.3")):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                     "s", name, user=True, check=False)
        parts = shlex.split(reply)
        if len(parts) == 2 and parts[0] == "s":
            contracts.append((name, path, prefix, parts[1], reply))
    owner = contracts[0][3] if contracts else None
    # A departure probe after logout must not read the ended session's
    # settings: gsettings blocked 15 s while the user bus restarted after
    # GNOME session shutdown (run 40874548317, marlin-vm-orca51).
    result = {"enabled": (call("gsettings", "get", "org.gnome.desktop.a11y.applications",
                               "screen-reader-enabled", user=True) == "true") if session_settings else None,
              "state": state.get("screen_reader_state"), "pid": pid, "owner": owner,
              # None when the image ships no Orca: the lane reports that as
              # the failure instead of a bare probe exit.
              "package": call("pacman", "-Q", "orca", check=False) or None, "ready": False,
              "frames": state.get("rendered_frames"), "keyboard": state.get("a11y_keyboard")}
    if not owner:
        result["unready_child_diagnostic"] = orca_child_diagnostic(state, pid)
    if pid == 0 or not owner:
        return result
    name, path, version_prefix, owner, owner_reply = contracts[0]
    try:
        return owned_orca_observation(result, state, pid, contracts)
    except subprocess.CalledProcessError:
        # A starting or stopping reader can drop its unique name between two
        # bus calls. Only a failure against an unchanged owner is an error.
        current = call("busctl", "--user", "call", "org.freedesktop.DBus",
                       "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                       "s", name, user=True, check=False)
        if current == owner_reply:
            raise
        return {**result, "owner": None, "owner_changed": True}


def owned_orca_observation(result, state, pid, contracts):
    name, path, version_prefix, owner, owner_reply = contracts[0]
    # Two supported names may only coexist for the same original owned child.
    for contract in contracts:
        for method, expected in (("GetConnectionUnixProcessID", pid),
                                 ("GetConnectionUnixUser", OWNER.pw_uid)):
            reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                         "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                         "s", contract[3], user=True).split()
            if reply != ["u", str(expected)]:
                result["foreign_owner"] = True
                return result
    credentials = {}
    for method in ("GetConnectionUnixProcessID", "GetConnectionUnixUser"):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                     "s", owner, user=True).split()
        if len(reply) != 2 or reply[0] != "u":
            raise RuntimeError("invalid Orca bus credentials")
        credentials[method] = int(reply[1])
    process = pathlib.Path(f"/proc/{pid}")
    if (credentials["GetConnectionUnixProcessID"] != pid
            or credentials["GetConnectionUnixUser"] != OWNER.pw_uid):
        return result
    try:
        uid = process.stat().st_uid
        with (process / "environ").open("rb") as stream:
            environment = stream.read(128 * 1024 + 1)
        process_stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
        ticks, parent_pid = int(process_stat[19]), int(process_stat[1])
    except (FileNotFoundError, ProcessLookupError):
        return result
    if len(environment) > 128 * 1024:
        raise RuntimeError("Orca environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in environment.split(b"\0")
                if entry.startswith(b"WAYLAND_DISPLAY=")]
    launcher = pathlib.Path("/usr/bin/orca")
    if launcher.stat().st_uid != 0:
        raise RuntimeError("Orca launcher not distribution-owned")
    launcher_owner = call("pacman", "-Qqo", str(launcher))
    version = shlex.split(call("busctl", "--user", "call", owner,
                              path, name, "GetVersion", user=True))
    stable = call("busctl", "--user", "call", "org.freedesktop.DBus",
                  "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                  "s", name, user=True) == owner_reply
    compositor = next(item for item in inventory()["processes"]
                      if item["executable"] == COMPOSITOR)
    expected_display = f"{NESTED}{compositor['pid']}"
    result.update({"uid": uid, "start_ticks": ticks, "display": displays,
                   "parent_pid": parent_pid, "compositor_pid": compositor["pid"],
                   "executable": os.readlink(process / "exe"), "version": version,
                   "bus_name": name, "bus_path": path,
                   "launcher_sha256": hashlib.sha256(launcher.read_bytes()).hexdigest(),
                   "bus_pid": credentials["GetConnectionUnixProcessID"],
                   "bus_uid": credentials["GetConnectionUnixUser"]})
    result["ready"] = (stable and uid == OWNER.pw_uid == credentials["GetConnectionUnixUser"]
                       and pid == credentials["GetConnectionUnixProcessID"]
                       and parent_pid == compositor["pid"]
                       and displays == [expected_display] and launcher_owner == "orca"
                       and len(version) == 2 and version[0] == "s" and version[1].startswith(version_prefix))
    return result


def speech_selection(actual):
    """Read live SSIP-backed properties on the original genuine 51 connection."""
    if not actual["ready"] or actual["state"] != "active" or actual["version"] != ["s", "51.0"]:
        raise RuntimeError("original genuine Orca 51 is required for speech selection")
    values = {}
    for name in ("CurrentServer", "CurrentSynthesizer"):
        value = shlex.split(call("busctl", "--user", "get-property", actual["owner"],
            "/org/gnome/Orca1/Service/SpeechManager", "org.gnome.Orca1.SpeechManager", name, user=True))
        if len(value) != 2 or value[0] != "s":
            raise RuntimeError("invalid actual Orca speech selection property")
        values[name] = value[1]
    after = orca_observation()
    fields = ("pid", "start_ticks", "owner", "uid", "bus_pid", "bus_uid", "version",
              "display", "parent_pid", "compositor_pid", "bus_name")
    if not after["ready"] or after["state"] != "active" or any(after.get(k) != actual[k] for k in fields):
        raise RuntimeError("original Orca identity changed during speech selection")
    if values != {"CurrentServer": "Speech Dispatcher", "CurrentSynthesizer": "espeak-ng"}:
        raise RuntimeError("original Orca did not select the real espeak-ng Speech Dispatcher module")
    return {"selection": values, "orca": after, "guest_monotonic": time.monotonic()}


def process_receipt(pid):
    """Kernel process identity; PipeWire app properties remain hints only."""
    path = pathlib.Path(f"/proc/{int(pid)}")
    stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
    uid, ticks = path.stat().st_uid, int(stat[19])
    exe = pathlib.Path(os.readlink(path / "exe"))
    with exe.open("rb") as stream:
        image = stream.read(16 * 1024 * 1024 + 1)
    if uid != OWNER.pw_uid or len(image) > 16 * 1024 * 1024:
        raise RuntimeError("speech process identity exceeds user/size authority")
    result = {"pid": int(pid), "uid": uid, "start_ticks": ticks, "exe": str(exe),
              "exe_sha256": hashlib.sha256(image).hexdigest(), "package": call("pacman", "-Qqo", str(exe))}
    stable = (path / "stat").read_text().rsplit(")", 1)[1].split()
    if int(stable[19]) != ticks or path.stat().st_uid != uid or os.readlink(path / "exe") != str(exe):
        raise RuntimeError("speech process identity changed during receipt")
    return result


def speech_graph():
    # Bound the producer's bytes before Python captures/decodes JSON. The fixed
    # pipeline has no interpolated arguments or private data.
    raw = call("bash", "-o", "pipefail", "-c", "pw-dump | head -c 2097153", user=True)
    if len(raw.encode()) > 2 * 1024 * 1024:
        raise RuntimeError("speech graph exceeds evidence bound")
    objects = json.loads(raw)
    keys = {"object.serial", "client.id", "node.id", "node.name", "media.class", "audio.channel",
            "application.process.id", "application.process.binary", "pipewire.sec.pid", "pipewire.sec.uid",
            "pipewire.sec.gid", "protocol.name"}
    receipt = []
    for obj in objects:
        if obj.get("type") not in {"PipeWire:Interface:Node", "PipeWire:Interface:Port",
                                  "PipeWire:Interface:Link", "PipeWire:Interface:Client"}:
            continue
        info = obj.get("info", {})
        receipt.append({"id": obj["id"], "type": obj["type"],
            "info": {k: info[k] for k in ("state", "direction", "output-node-id", "output-port-id",
                     "input-node-id", "input-port-id") if k in info},
            "props": {k: v for k, v in info.get("props", {}).items() if k in keys}})
    if len(receipt) > 512 or len(json.dumps(receipt).encode()) > 128 * 1024:
        raise RuntimeError("speech graph receipt exceeds evidence bound")
    return {"guest_monotonic": time.monotonic(), "objects": receipt,
            "process_properties_are_hints": True, "client_credentials_verified": False,
            "mixed_sink": True, "exclusive_pcm": False}


def file_identity(info):
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError("recording evidence must be a regular file")
    return {"dev": info.st_dev, "ino": info.st_ino, "uid": info.st_uid,
            "gid": info.st_gid, "mode": stat.S_IMODE(info.st_mode)}


def create_evidence(path, uid, gid):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(fd, uid, gid)
        return file_identity(os.fstat(fd))
    finally:
        os.close(fd)


def read_evidence(path, identity, limit):
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
        before = os.fstat(stream.fileno())
        if file_identity(before) != identity or file_identity(os.lstat(path)) != identity:
            raise RuntimeError("original recording file identity changed")
        data = stream.read(limit + 1)
        after = os.fstat(stream.fileno())
        if (file_identity(after) != identity or file_identity(os.lstat(path)) != identity
                or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns)
                or len(data) != before.st_size or len(data) > limit):
            raise RuntimeError("original recording file changed or exceeded its bound")
        return data


def reserve_recording():
    with contextlib.suppress(FileExistsError):
        RECORDING_DIR.mkdir(mode=0o700)
    directory = RECORDING_DIR.lstat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or stat.S_IMODE(directory.st_mode) != 0o700:
        raise RuntimeError("recording state directory lacks root authority")
    # O_EXCL reserves authority before any presenter mutation. A second start
    # cannot close or overwrite another original capture through a late race.
    fd = os.open(RECORDING_STATE, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    return fd, file_identity(os.fstat(fd))


def save_recording(recording, reservation):
    fd, identity = reservation
    if file_identity(os.fstat(fd)) != identity or file_identity(RECORDING_STATE.lstat()) != identity:
        raise RuntimeError("original recording reservation changed")
    recording["state_identity"] = identity
    payload = json.dumps(recording).encode()
    if len(payload) > 512 * 1024:
        raise RuntimeError("recording state exceeds bound")
    os.lseek(fd, 0, os.SEEK_SET)
    with os.fdopen(os.dup(fd), "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.ftruncate(fd, len(payload))


def load_recording():
    directory = RECORDING_DIR.lstat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or stat.S_IMODE(directory.st_mode) != 0o700:
        raise RuntimeError("recording state directory lacks root authority")
    info = RECORDING_STATE.lstat()
    identity = file_identity(info)
    if identity["uid"] != 0 or identity["mode"] != 0o600:
        raise RuntimeError("recording state lacks root authority")
    recording = json.loads(read_evidence(RECORDING_STATE, identity, 512 * 1024))
    if recording.get("capture_state") != "ready":
        raise RuntimeError("original recording setup has not completed")
    if recording["state_identity"] != identity:
        raise RuntimeError("original root recording state changed")
    return recording


def require_sink_graph(graph, sink, synth, recorder=None):
    objects = {obj["id"]: obj for obj in graph["objects"]}
    if len(objects) != len(graph["objects"]):
        raise RuntimeError("speech graph contains duplicate object IDs")
    for original in (sink, synth):
        actual = objects.get(original["id"], {})
        serial = original["props"].get("object.serial")
        if serial is None or actual.get("props", {}).get("object.serial") != serial:
            raise RuntimeError("original speech/sink graph identity changed")
    pairs = [(synth["id"], sink["id"])]
    if recorder is not None:
        pairs.append((sink["id"], recorder["id"]))
    for source, target in pairs:
        links = [o for o in graph["objects"] if o["type"] == "PipeWire:Interface:Link"
                 and o["info"].get("output-node-id") == source and o["info"].get("input-node-id") == target]
        if not links:
            raise RuntimeError("actual speech capture graph link is missing")
        for link in links:
            for direction, node in (("output", source), ("input", target)):
                port = objects.get(link["info"].get(direction + "-port-id"), {})
                if (port.get("type") != "PipeWire:Interface:Port" or port["info"].get("direction") != direction
                        or int(port["props"].get("node.id", -1)) != node):
                    raise RuntimeError("actual speech graph port/direction disagrees")


def recorder_owns_file(pid, identity):
    for index, entry in enumerate(pathlib.Path(f"/proc/{pid}/fd").iterdir()):
        if index >= 64:
            raise RuntimeError("recorder file descriptors exceed bound")
        with contextlib.suppress(FileNotFoundError):
            info = entry.stat()
            if stat.S_ISREG(info.st_mode) and file_identity(info) == identity:
                return True
    return False


def speech_error_type(error):
    value = type(error).__name__
    allowed = {"RuntimeError", "CalledProcessError", "FileNotFoundError", "ProcessLookupError",
               "PermissionError", "ValueError", "JSONDecodeError", "OSError", "TimeoutExpired"}
    return value if value in allowed else "OtherError"


def original_recorder_departed(original):
    path = pathlib.Path(f"/proc/{original['pid']}")
    try:
        before = int((path / "stat").read_text().rsplit(")", 1)[1].split()[19])
        after = int((path / "stat").read_text().rsplit(")", 1)[1].split()[19])
    except (FileNotFoundError, ProcessLookupError):
        return True
    if before != after:
        raise RuntimeError("recorder process identity changed during departure observation")
    return before != original["start_ticks"]


def recorder_unit_departure(stop_returncode, show_returncode, output, original_departed):
    # Only fixed public systemd properties are retained. Failed/empty/malformed
    # output cannot establish collection or departure of the original recorder.
    if any(type(value) is not int or not -255 <= value <= 255 for value in (stop_returncode, show_returncode)):
        raise RuntimeError("recording unit returncode receipt is invalid")
    if not isinstance(output, str) or len(output) > 256:
        raise RuntimeError("recording unit property receipt exceeds bound")
    rows = output.splitlines()
    props = {}
    for row in rows:
        key, separator, value = row.partition("=")
        if not separator or key not in {"LoadState", "ActiveState", "MainPID"} or key in props:
            raise RuntimeError("recording unit property receipt is not exact")
        props[key] = value
    if set(props) != {"LoadState", "ActiveState", "MainPID"} or props["MainPID"] != "0" or props["ActiveState"] != "inactive":
        raise RuntimeError("recording unit departure properties disagree")
    if props["LoadState"] == "not-found":
        if show_returncode not in (0, 4) or original_departed is not True:
            raise RuntimeError("collected unit lacks original recorder departure proof")
    elif props["LoadState"] == "loaded":
        if stop_returncode != 0 or show_returncode != 0 or original_departed is False:
            raise RuntimeError("loaded recording unit stop did not qualify")
    else:
        raise RuntimeError("recording unit load state does not qualify")
    return {"stop_returncode": stop_returncode, "show_returncode": show_returncode,
            "properties": props, "original_recorder_departed": original_departed}


def stop_recording_unit(recording):
    command = ["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
               f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", "systemctl", "--user"]
    stop = subprocess.run([*command, "stop", recording["unit"]], capture_output=True, text=True, timeout=15)
    show = subprocess.run([*command, "show", recording["unit"], "--property=LoadState",
                           "--property=ActiveState", "--property=MainPID"], capture_output=True, text=True, timeout=15)
    try:
        original = recording.get("recorder")
        departed = original_recorder_departed(original) if original else None
        return recorder_unit_departure(stop.returncode, show.returncode, show.stdout, departed)
    except Exception as error:
        error.stop_returncode = stop.returncode
        error.show_returncode = show.returncode
        raise


def cleanup_speech(recording, token, unit_started=True, presenter_started=True):
    receipt = {"unit_departed": not unit_started, "presenter_closed": not presenter_started, "errors": []}
    def failure(stage, error):
        item = {"stage": stage, "exception_type": speech_error_type(error)}
        if isinstance(error, subprocess.CalledProcessError) and type(error.returncode) is int and -255 <= error.returncode <= 255:
            item["returncode"] = error.returncode
        for key in ("stop_returncode", "show_returncode"):
            value = getattr(error, key, None)
            if stage == "owned_unit_stop" and type(value) is int and -255 <= value <= 255:
                item[key] = value
        receipt["errors"].append(item)
    if unit_started:
        try:
            receipt["unit_stop"] = stop_recording_unit(recording)
            receipt["unit_departed"] = True
        except Exception as error:
            failure("owned_unit_stop", error)
    if presenter_started:
        try:
            if token is None:
                raise RuntimeError("original presenter token unavailable for close")
            reply = call("busctl", "--user", "call", recording["owner"],
                         "/org/gnome/Orca1/Service/SpeechPresenter", "org.gnome.Orca1.SpeechPresenter",
                         "SetLogFileForTesting", "ss", token, "", user=True)
            if reply != "b true":
                raise RuntimeError("original presenter refused close")
            original = recording["selection"]["orca"]
            actual = orca_observation()
            fields = ("pid", "start_ticks", "owner", "uid", "bus_pid", "bus_uid", "version")
            if any(actual.get(k) != original.get(k) for k in fields):
                raise RuntimeError("original presenter identity changed during close")
            if recorder_owns_file(original["pid"], recording["log_identity"]):
                raise RuntimeError("original presenter retains the original log file")
            after = orca_observation()
            if any(after.get(k) != original.get(k) for k in fields):
                raise RuntimeError("original presenter identity changed after FD close proof")
            receipt["presenter_closed"] = True
        except Exception as error:
            failure("owned_presenter_close", error)
    return receipt


def fail_speech(error, cleanup, stage=None):
    diagnostic = {"exception_type": speech_error_type(error), "cleanup": cleanup}
    if stage is not None:
        if stage not in {"token", "selection", "graph", "sink-link"}:
            raise ValueError("fixed speech observation stage required")
        diagnostic["stage"] = stage
    if isinstance(error, subprocess.CalledProcessError) and type(error.returncode) is int and -255 <= error.returncode <= 255:
        diagnostic["returncode"] = error.returncode
    print(json.dumps({"orca_speech_error": diagnostic}))
    # The original exception may contain token-bearing argv. Preserve only its
    # fixed public type/code and the failed exit, never an exception traceback.
    raise SystemExit(1) from None


def mutate_orca_setting(action):
    schema, key = "org.gnome.desktop.a11y.applications", "screen-reader-enabled"
    if action == "orca-reset":
        call("gsettings", "reset", schema, key, user=True)
        requested = None
    else:
        requested = action == "orca-on"
        call("gsettings", "set", schema, key, str(requested).lower(), user=True)
    value = call("gsettings", "get", schema, key, user=True)
    if value not in {"true", "false"} or (requested is not None and (value == "true") != requested):
        raise RuntimeError("screen reader setting readback disagrees with mutation")
    # Acknowledgment only. The host separately awaits strict owned process/bus lifecycle evidence.
    return {"requested_enabled": requested, "readback_enabled": value == "true"}


FOCUS_ERROR_TYPES = {"RuntimeError", "ValueError", "OSError", "FileNotFoundError",
                     "ProcessLookupError", "PermissionError", "KeyError",
                     "JSONDecodeError", "UnicodeDecodeError", "RecursionError",
                     "TypeError", "AttributeError", "CalledProcessError", "TimeoutExpired",
                     "Error"}  # PyGObject GLib.Error's class name; never its message.
FOCUS_STAGES = {"arguments", "reader-principal", "helper", "post-observation", "disks-evidence"}
FOCUS_OPERATIONS = {"arguments", "imports", "process-identity", "atspi-timeout",
                    "desktop-enumeration", "atspi-owner", "bus-connection", "bus-credentials",
                    "tree-cache", "tree-state", "tree-role", "tree-name", "tree-children",
                    "controlled-query", "catalog-receipt", "final-principal", "serialization",
                    "tree-state-flags", "tree-public-control"}


def shell_navigation_focus(kind, original_pid=None, original_ticks=None, controlled=False):
    # Every zone names its fixed stage on failure; the host forwards the
    # typed stage instead of an opaque exit code. The helper keeps its own
    # shape and gains the stage like every other zone.
    focus_stage = "reader-principal"
    try:
        actual = orca_observation()
        state = json.loads(STATE.read_text())
        if state["locked"] or not actual["ready"] or actual["state"] != "active":
            raise RuntimeError("public navigation requires an unlocked original genuine reader")
        executable = "tuna-shell-gtk" if kind == "shell" else "gnome-disks"
        candidates = [p for p in inventory()["processes"] if p["executable"] == executable and p["uid"] == OWNER.pw_uid]
        if kind == "disks" or controlled:
            candidates = [p for p in candidates if p["pid"] == original_pid and p["start_ticks"] == original_ticks]
        if len(candidates) != 1:
            raise RuntimeError("one original navigation application principal is required")
        process = candidates[0]
        diagnostic_args = ("controlled-overview",) if controlled else ()
        focus_stage = "helper"
        try:
            raw = call("/usr/libexec/tuna-vm-shell-focus", str(process["pid"]), str(process["start_ticks"]),
                       executable, actual["display"][0], *diagnostic_args, user=True)
        except subprocess.CalledProcessError as error:
            # Forward the helper's own fixed typed diagnostic; never argv/stderr.
            # Without this the host sees only an opaque exit code.
            try:
                candidate = json.loads((error.stdout or "").strip())
            except (ValueError, TypeError, AttributeError):
                candidate = None
            if (isinstance(candidate, dict)
                    and set(candidate) in ({"focus_error_type"}, {"focus_error_type", "focus_operation"})
                    and type(candidate["focus_error_type"]) is str
                    and candidate["focus_error_type"] in FOCUS_ERROR_TYPES
                    and ("focus_operation" not in candidate
                         or (type(candidate["focus_operation"]) is str
                             and candidate["focus_operation"] in FOCUS_OPERATIONS))):
                diagnostic = {"focus_error_type": candidate["focus_error_type"],
                              "focus_stage": focus_stage}
                if "focus_operation" in candidate:
                    diagnostic["focus_operation"] = candidate["focus_operation"]
                print(json.dumps(diagnostic))
            raise SystemExit(1) from None
        focus_stage = "post-observation"
        receipt = json.loads(raw)
        after = orca_observation()
        if any(actual[k] != after.get(k) for k in ("pid", "uid", "start_ticks", "owner", "bus_pid", "bus_uid", "version")) or not after["ready"]:
            raise RuntimeError("original genuine reader changed during navigation observation")
        state = json.loads(STATE.read_text())
        if state["locked"]:
            raise RuntimeError("public navigation observation crossed lock")
        result = {"orca": after, "focus": receipt, "overview_open": state["overview_open"], "focused_window": state["focused"]}
        if kind == "disks":
            focus_stage = "disks-evidence"
            desktop = pathlib.Path("/usr/share/applications/org.gnome.DiskUtility.desktop")
            info = desktop.lstat()
            metadata = read_evidence(desktop, file_identity(info), 65536)
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022 or len(metadata) > 65536:
                raise RuntimeError("installed Disks desktop entry lacks bounded distribution authority")
            commands = [line[5:] for line in metadata.decode().splitlines() if line.startswith("Exec=")]
            if not commands or pathlib.Path(shlex.split(commands[0])[0]).name != "gnome-disks":
                raise RuntimeError("installed Disks desktop entry does not launch the actual frontend")
            exe = os.readlink(f"/proc/{process['pid']}/exe")
            package = call("pacman", "-Qqo", exe)
            if package != "gnome-disk-utility" or call("pacman", "-Qqo", str(desktop)) != package:
                raise RuntimeError("actual Disks frontend/desktop entry lack matching distribution package ownership")
            window = next((w for w in state["windows"] if w["id"] == state["focused"]), None)
            active = any(n["label"] == "Disks" and n["role"] == "frame" and n["active"] for n in receipt["public_controls"])
            result["launch_focus_ready"] = (window is not None and window["app_id"] == "org.gnome.DiskUtility"
                                             and active and not state["overview_open"])
            remaining = [p for p in inventory()["processes"] if p == process]
            if len(remaining) != 1 or json.loads(STATE.read_text())["locked"]:
                raise RuntimeError("original Disks frontend changed or locked during package observation")
            result["desktop"] = {"path": str(desktop), "uid": info.st_uid, "sha256": hashlib.sha256(metadata).hexdigest(), "package": package}
        return result
    except SystemExit:
        raise
    except Exception as error:
        name = type(error).__name__
        if name in FOCUS_ERROR_TYPES:
            print(json.dumps({"focus_error_type": name, "focus_stage": focus_stage}))
        raise SystemExit(1) from None


