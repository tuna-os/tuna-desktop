# public password "tuna". tunaseeded is the negative control: its
# AccountsService record is written before GDM starts.
FRESH_USERS = ("tunastd", "tunaadmin", "tunaseeded")
ACCOUNTS_RECORD_DIR = pathlib.Path("/var/lib/AccountsService/users")
GDM_CUSTOM_CONF = pathlib.Path("/etc/gdm/custom.conf")
FRESH_DESKTOP = ("tuna-session", COMPOSITOR_COMM, SHELL_GTK[:15], "gnome-shell", "gnome-session-b",
                 "gnome-session-s")


def fresh_state(name):
    """Identity, effective AccountsService session and optional cache record.
    FindUserByName is a read, not CacheUser: loading a template need not
    create a file in /var/lib/AccountsService/users."""
    try:
        entry = pwd.getpwnam(name)
    except KeyError:
        return {"user": name, "exists": False}
    record = ACCOUNTS_RECORD_DIR / name
    try:
        text = record.read_text(errors="replace")[:4096]
    except FileNotFoundError:
        text = None
    account = json.loads(call("busctl", "--system", "--json=short", "call",
                              "org.freedesktop.Accounts", "/org/freedesktop/Accounts",
                              "org.freedesktop.Accounts", "FindUserByName", "s", name))["data"][0]
    session = json.loads(call("busctl", "--system", "--json=short", "get-property",
                              "org.freedesktop.Accounts", account,
                              "org.freedesktop.Accounts.User", "Session"))["data"]
    return {"user": name, "exists": True, "uid": entry.pw_uid,
            "groups": call("id", "-nG", name).split(),
            "home": entry.pw_dir, "home_exists": os.path.isdir(entry.pw_dir),
            "record": text,
            "effective_session": session,
            "custom_conf": GDM_CUSTOM_CONF.read_text(errors="replace")[:8192]}


def fresh_session(name):
    """The account's gdm-password sessions on a VT and the desktop processes
    it runs, by fixed process name only."""
    uid = pwd.getpwnam(name).pw_uid
    sessions = []
    for line in call("loginctl", "list-sessions", "--no-legend", "--no-pager").splitlines():
        fields = line.split()
        if len(fields) < 2 or fields[1] != str(uid):
            continue
        description = call("loginctl", "show-session", fields[0], "--property=Id", "--property=VTNr",
                           "--property=User", "--property=Type", "--property=Service",
                           "--property=Class", "--property=State", check=False)
        properties = dict(item.split("=", 1) for item in description.splitlines() if "=" in item)
        if properties.get("Class", "").startswith("manager"):
            continue
        sessions.append(properties)
    return {"user": name, "uid": uid, "sessions": sessions,
            "desktop": [proc for proc in FRESH_DESKTOP
                        if call("pgrep", "-u", str(uid), "-x", proc, check=False)]}


def fresh_sudo(name):
    """Real sudo authentication as the account with its public password.
    Only the exit status and a fixed policy-denial flag leave the guest."""
    run = subprocess.run(["runuser", "-u", name, "--", "sudo", "-S", "-k", "-p", "", "/usr/bin/true"],
                         input="tuna\n", capture_output=True, text=True, timeout=30, check=False)
    denied = any(marker in run.stderr for marker in ("is not in the sudoers file", "is not allowed to run sudo",
                                                     "may not run sudo"))
    return {"user": name, "returncode": run.returncode, "policy_denied": denied,
            "sudo_present": pathlib.Path("/usr/bin/sudo").exists()}


def fresh_logout(name):
    """Log the account out through logind, as the shell's Log Out falls back to."""
    ended = []
    for session in fresh_session(name)["sessions"]:
        if session.get("Service") == LOGIN_SERVICE:
            call("loginctl", "terminate-session", session["Id"])
            ended.append(session["Id"])
    return {"user": name, "terminated": ended}


def greeter_prompt_entries(app, Atspi, query):
    """Inspect only the showing greeter scene, not its hidden actor trees."""
    pending, visited, entries = [(app, 0)], 0, []
    while pending:
        node, depth = pending.pop()
        visited += 1
        if visited > 512 or depth > 32:
            raise RuntimeError("greeter accessibility tree exceeds bound")
        query(node.clear_cache)
        states = query(node.get_state_set)
        # The application is metadata, not a showing component. All other
        # nodes must belong to the showing scene: AT-SPI SHOWING includes
        # ancestor visibility, so a hidden branch cannot contain the prompt.
        if depth and not states.contains(Atspi.StateType.SHOWING):
            continue
        role = query(node.get_role)
        if (role in (Atspi.Role.TEXT, Atspi.Role.ENTRY, Atspi.Role.PASSWORD_TEXT)
                and all(states.contains(flag) for flag in
                        (Atspi.StateType.FOCUSED, Atspi.StateType.SHOWING,
                         Atspi.StateType.VISIBLE, Atspi.StateType.EDITABLE,
                         Atspi.StateType.SENSITIVE, Atspi.StateType.ENABLED))):
            entries.append("password" if role == Atspi.Role.PASSWORD_TEXT else "username")
        count = query(node.get_child_count)
        if not 0 <= count <= 512:
            raise RuntimeError("greeter accessibility children exceed bound")
        pending.extend((child, depth + 1) for index in range(count)
                       if (child := query(node.get_child_at_index, index)) is not None)
    return entries


def greeter_prompt_user(pid, ticks):
    """Read only role/state from the original greeter's focused entry.

    Never query entry names, values, text, or perform accessibility actions.
    Passwords still travel only through the real QMP keyboard and GDM PAM.
    """
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, Gio, GLib

    uid = os.geteuid()
    def principal():
        process = pathlib.Path(f"/proc/{pid}")
        return (process.stat().st_uid,
                int((process / "stat").read_text().rsplit(")", 1)[1].split()[19]),
                (process / "comm").read_text().strip())
    expected = (uid, ticks, "gnome-shell")
    if uid == 0 or principal() != expected:
        raise RuntimeError("original non-root greeter principal required")
    deadline = time.monotonic() + 3
    Atspi.set_timeout(250, 250)
    def query(method, *args):
        if time.monotonic() >= deadline:
            raise RuntimeError("greeter prompt observation deadline exceeded")
        return method(*args)
    desktop = query(Atspi.get_desktop, 0)
    count = query(desktop.get_child_count)
    if not 0 <= count <= 64:
        raise RuntimeError("greeter accessibility desktop exceeds bound")
    apps = [query(desktop.get_child_at_index, index) for index in range(count)]
    apps = [app for app in apps if app is not None and query(app.get_process_id) == pid]
    if len(apps) != 1:
        raise RuntimeError("original greeter accessibility application not ready")
    app = apps[0]
    owner = app.app.bus_name
    if not isinstance(owner, str) or not owner.startswith(":"):
        raise RuntimeError("greeter accessibility owner must be unique")
    session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    address = session.call_sync("org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress",
                               None, GLib.VariantType.new("(s)"), Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
    bus = Gio.DBusConnection.new_for_address_sync(address,
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    def credentials():
        return [query(bus.call_sync, "org.freedesktop.DBus", "/org/freedesktop/DBus",
                      "org.freedesktop.DBus", method, GLib.Variant("(s)", (owner,)),
                      None, Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
                for method in ("GetConnectionUnixProcessID", "GetConnectionUnixUser")]
    if credentials() != [pid, uid]:
        raise RuntimeError("greeter accessibility bus credentials disagree")
    entries = greeter_prompt_entries(app, Atspi, query)
    if credentials() != [pid, uid] or principal() != expected:
        raise RuntimeError("original greeter changed during prompt observation")
    return {"pid": pid, "uid": uid, "start_ticks": ticks, "atspi_owner": owner,
            "prompt": entries[0] if len(entries) == 1 else None}


def greeter_prompt():
    greeter = json.loads(call(sys.executable, __file__, "greeter"))
    pids = greeter["greeter_pids"]
    active = [s for s in greeter["greeter_sessions"] if s.get("Active") == "yes"
              and s.get("Service") == "gdm-launch-environment"]
    if len(pids) != 1 or len(active) != 1:
        raise RuntimeError("one active GDM greeter required")
    pid = int(pids[0])
    process = pathlib.Path(f"/proc/{pid}")
    uid = process.stat().st_uid
    if uid == 0 or str(uid) != active[0].get("User"):
        raise RuntimeError("active greeter owner disagrees")
    ticks = int((process / "stat").read_text().rsplit(")", 1)[1].split()[19])
    raw = call("runuser", "-u", pwd.getpwuid(uid).pw_name, "--", "env",
               f"XDG_RUNTIME_DIR=/run/user/{uid}",
               f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
               sys.executable, __file__, "greeter-prompt-user", str(pid), str(ticks))
    return json.loads(raw)


