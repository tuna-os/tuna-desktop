def background_user_diagnostics():
    if os.geteuid() != OWNER.pw_uid or OWNER.pw_uid == 0:
        raise RuntimeError("background reader must be the actual ordinary session owner")
    from gi.repository import Gio
    result = {"reader_uid": os.geteuid(), "runtime": os.environ.get("XDG_RUNTIME_DIR"),
              "settings": {}, "drop": {}}
    for schema in ("org.gnome.desktop.background", "org.gnome.desktop.screensaver"):
        try:
            source = Gio.SettingsSchemaSource.get_default().lookup(schema, True)
            if source is None:
                raise RuntimeError("actual schema missing")
            settings = Gio.Settings.new_full(source, None, None)
            result["settings"][schema] = {
                key: settings.get_value(key).unpack() for key in
                ("picture-uri", "picture-options", "primary-color", "secondary-color", "color-shading-type")}
            if source.has_key("picture-uri-dark"):
                result["settings"][schema]["picture-uri-dark"] = settings.get_string("picture-uri-dark")
        except Exception as error:
            result["settings"][schema] = {"error": str(error)}
    interface = Gio.Settings.new("org.gnome.desktop.interface")
    result["color_scheme"] = interface.get_string("color-scheme")
    path = pathlib.Path(RUNTIME, f"{PREFIX}-wallpaper")
    identity = lambda m: {"dev": m.st_dev, "ino": m.st_ino, "bytes": m.st_size,
                          "uid": m.st_uid, "mode": m.st_mode,
                          "mtime_ns": m.st_mtime_ns, "ctime_ns": m.st_ctime_ns}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            before = os.fstat(fd)
            result["drop"]["before"] = identity(before)
            if not file_stat.S_ISREG(before.st_mode) or before.st_uid != OWNER.pw_uid or before.st_size > 16384:
                raise RuntimeError("private drop type/owner/size bound failed")
            data = bytearray()
            while len(data) <= 16384:
                chunk = os.read(fd, 16385 - len(data))
                if not chunk:
                    break
                data.extend(chunk)
            after = os.fstat(fd)
            named = path.lstat()
            result["drop"]["after"] = identity(after)
            result["drop"]["named"] = identity(named)
            if len(data) > 16384 or len(data) != before.st_size or identity(before) != identity(after) or identity(before) != identity(named):
                raise RuntimeError("private drop changed or exceeded bound")
            result["drop"].update(text=data.decode("utf-8"), sha256=hashlib.sha256(data).hexdigest())
        finally:
            os.close(fd)
    except (OSError, RuntimeError, UnicodeError) as error:
        result["drop"]["error"] = str(error)
    # The existing snapshot already excludes lock credential values. Retain
    # only the new in-memory wallpaper observations, and no window titles.
    try:
        fd = os.open(STATE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            before = os.fstat(fd)
            if not file_stat.S_ISREG(before.st_mode) or before.st_uid != OWNER.pw_uid or before.st_size > 1024 * 1024:
                raise RuntimeError("journey snapshot type/owner/size bound failed")
            with os.fdopen(os.dup(fd), "rb") as stream:
                data = stream.read(1024 * 1024 + 1)
            if len(data) > 1024 * 1024 or len(data) != before.st_size or identity(before) != identity(os.fstat(fd)) or identity(before) != identity(STATE.lstat()):
                raise RuntimeError("journey snapshot changed or exceeded bound")
        finally:
            os.close(fd)
        state = json.loads(data)
        result["compositor"] = {key: state.get(key) for key in
                                ("locked", "rendered_frames", "wallpaper_diagnostics")}
    except (OSError, RuntimeError, ValueError) as error:
        result["compositor"] = {"error": str(error)}
    return result


STRIP_EXE = pathlib.Path("/usr/libexec/tuna-vm-input")
STRIP_OWNER = pathlib.Path("/run/tuna-vm-strip-owner.json")


def strip_nonce(value):
    import re
    if not re.fullmatch(r"[0-9a-f]{32}", value):
        raise ValueError("invalid strip fixture nonce")
    return value


def strip_json(path, uid):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not file_stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_mode & 0o022:
            raise RuntimeError("strip receipt ownership/permissions mismatch")
        value = stream.read(131073)
    if len(value) > 131072:
        raise RuntimeError("strip receipt exceeds byte bound")
    return json.loads(value)


def strip_sha(path):
    digest = hashlib.sha256()
    size = 0
    with pathlib.Path(path).open("rb") as stream:
        while block := stream.read(65536):
            size += len(block)
            if size > 256 * 1024 * 1024:
                raise RuntimeError("strip executable exceeds hash byte bound")
            digest.update(block)
    return digest.hexdigest()


def strip_core(current):
    members = [p for p in current["processes"] if p["executable"] in (COMPOSITOR, SHELL_GTK)]
    if sorted(p["executable"] for p in members) != sorted((COMPOSITOR, SHELL_GTK)):
        raise RuntimeError("original native compositor/shell pair absent or ambiguous")
    return {p["executable"]: strip_identity(p["pid"], OWNER.pw_uid) for p in members}


def strip_identity(pid, uid):
    if type(pid) is not int or pid <= 0:
        raise ValueError("invalid strip process PID")
    path = pathlib.Path(f"/proc/{pid}")
    fd = os.pidfd_open(pid)
    try:
        before = (path / "stat").read_text().rsplit(")", 1)[1].split()
        inode = (path / "exe").stat()
        if path.stat().st_uid != uid or before[0] == "Z":
            raise RuntimeError("strip process owner/liveness mismatch")
        actual = {"pid": pid, "uid": uid, "start_ticks": int(before[19]),
                  "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
                  "exe_inode": inode.st_ino, "exe_device": inode.st_dev,
                  "exe_sha256": strip_sha(path / "exe")}
        after = (path / "stat").read_text().rsplit(")", 1)[1].split()
        new_inode = (path / "exe").stat()
        stable = lambda info: (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
        if before[19] != after[19] or after[0] == "Z" or stable(new_inode) != stable(inode):
            raise RuntimeError("strip process changed during identity read")
        return actual
    finally:
        os.close(fd)


def strip_validate_client(value, nonce, launcher, mode="baseline"):
    if value.get("schema") != 1 or value.get("nonce") != nonce or value.get("backend") != "wayland":
        raise RuntimeError("strip fixture receipt identity mismatch")
    if mode not in ("baseline", "edge") or value.get("fixture_mode") != mode:
        raise RuntimeError("actual strip fixture mode differs from admitted source mode")
    original = value["identity"]
    actual = strip_identity(original["pid"], OWNER.pw_uid)
    if any(original.get(key) != actual[key] for key in actual):
        raise RuntimeError("strip fixture process restarted or receipt is stale")
    if original.get("script_sha256") != strip_sha(STRIP_EXE):
        raise RuntimeError("strip fixture installed script bytes changed")
    path = pathlib.Path(f"/proc/{actual['pid']}")
    with (path / "cmdline").open("rb") as stream:
        command = stream.read(16385)
    argv = command.rstrip(b"\0").split(b"\0")
    if len(command) > 16384 or len(argv) != 4 or argv[1:] != [os.fsencode(STRIP_EXE), b"--strip-edge-fixture" if mode == "edge" else b"--strip-fixture", nonce.encode()]:
        raise RuntimeError("strip fixture is not the actual admitted script invocation")
    # A Python script receipt is not an executable binary identity by itself.
    # The exact interpreter inode/hash plus actual argv and parent link are checked.
    if launcher is not None:
        parent = int((path / "stat").read_text().rsplit(")", 1)[1].split()[1])
        if parent != launcher["pid"]:
            raise RuntimeError("strip fixture was not launched by the owned original launcher")
    return actual | {"script_sha256": original["script_sha256"]}


def strip_write_owner(value, exclusive=False):
    flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | (os.O_EXCL if exclusive else os.O_TRUNC)
    fd = os.open(STRIP_OWNER, flags, 0o600)
    with os.fdopen(fd, "w") as stream:
        if os.fstat(stream.fileno()).st_uid != 0:
            raise RuntimeError("strip owner record is not root-owned")
        json.dump(value, stream)


def strip_stop_identity(original, uid, deadline):
    import select
    import signal
    pid = original["pid"]
    if time.monotonic() >= deadline:
        raise TimeoutError("strip cleanup absolute deadline expired")
    try:
        fd = os.pidfd_open(pid)
    except ProcessLookupError:
        return {"original": original, "retired": True, "proc_absent": True}
    try:
        # A replacement PID is never signalled. Exit readiness before identity
        # acquisition is accepted only when the original process is gone.
        poll = select.poll()
        poll.register(fd, select.POLLIN)
        live = None
        if not poll.poll(0):
            try:
                live = strip_identity(pid, uid)
            except (OSError, RuntimeError):
                # The launcher retires as soon as its client does, so it can
                # exit under the read. An exiting process drops its executable
                # mapping (exit_mm) before the kernel marks it exited
                # (exit_notify) and its pidfd turns readable, so the read can
                # fail a moment before readiness: marlin-vm 116724301628 saw
                # runuser close its PAM session and strip-stop fail at once.
                # The pidfd predates the read: readiness within this short
                # bound means that process (the original, or a replacement of
                # an original already gone) has exited; nothing is signalled.
                remaining = min(1.0, max(0.0, deadline - time.monotonic()))
                if not poll.poll(int(remaining * 1000)):
                    raise
        if live is not None:
            if live != original:
                raise RuntimeError("refuse to signal changed strip process identity")
            if time.monotonic() >= deadline:
                raise TimeoutError("strip cleanup absolute deadline expired")
            signal.pidfd_send_signal(fd, signal.SIGTERM)
            remaining = min(2.0, max(0.0, deadline - time.monotonic()))
            if not poll.poll(int(remaining * 1000)):
                if time.monotonic() >= deadline:
                    raise RuntimeError("strip process retirement unconfirmed at absolute deadline")
                signal.pidfd_send_signal(fd, signal.SIGKILL)
                remaining = max(0.0, deadline - time.monotonic())
                if not poll.poll(int(remaining * 1000)):
                    raise RuntimeError("strip process physical retirement unconfirmed")
        while pathlib.Path(f"/proc/{pid}").exists() and time.monotonic() < deadline:
            time.sleep(min(.02, max(0, deadline - time.monotonic())))
        absent = not pathlib.Path(f"/proc/{pid}").exists()
        if not absent:
            raise RuntimeError("strip process PID remains; cleanup unconfirmed")
        return {"original": original, "retired": True, "proc_absent": True}
    finally:
        os.close(fd)


def strip_client(action, nonce):
    nonce = strip_nonce(nonce)
    receipt_path = pathlib.Path(RUNTIME, f"tuna-vm-strip-{nonce}.json")
    if action in ("start", "edge-start"):
        mode = "edge" if action == "edge-start" else "baseline"
        current = inventory()
        if receipt_path.exists():
            raise RuntimeError("refuse an existing strip fixture receipt")
        owner = {"nonce": nonce, "fixture_mode": mode, "boot_id": pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
                 "launch_state": "unknown", "launcher": None, "client": None, "core": strip_core(current)}
        strip_write_owner(owner, exclusive=True)
        compositor = next(p for p in current["processes"] if p["executable"] == COMPOSITOR)
        launcher = subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env",
                                     f"XDG_RUNTIME_DIR={RUNTIME}",
                                     f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
                                     f"WAYLAND_DISPLAY=tuna-nested-{compositor['pid']}", "GDK_BACKEND=wayland",
                                     str(STRIP_EXE), "--strip-edge-fixture" if mode == "edge" else "--strip-fixture", nonce],
                                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        owner["launcher"] = strip_identity(launcher.pid, 0)
        strip_write_owner(owner)
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            try:
                value = strip_json(receipt_path, OWNER.pw_uid)
                owner["client"] = strip_validate_client(value, nonce, owner["launcher"], mode)
                owner["launch_state"] = "known"
                strip_write_owner(owner)
                return {"owner": owner, "fixture": value, "inventory": inventory()}
            except FileNotFoundError:
                time.sleep(min(.05, max(0, deadline - time.monotonic())))
        raise RuntimeError("strip launch acknowledgement absent; retirement unconfirmed")
    owner = strip_json(STRIP_OWNER, 0)
    if owner.get("nonce") != nonce or owner.get("boot_id") != pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip():
        raise RuntimeError("strip owner nonce/boot mismatch")
    mode = owner.get("fixture_mode")
    if mode not in ("baseline", "edge"):
        raise RuntimeError("unknown original strip owner mode")
    if action == "stop":
        deadline = time.monotonic() + 6
        records = []
        client = owner.get("client")
        stages = []
        if client is not None:
            identity = {key: value for key, value in client.items() if key != "script_sha256"}
            stages.append(("client", identity, OWNER.pw_uid))
        if owner.get("launcher") is not None:
            stages.append(("launcher", owner["launcher"], 0))
        for stage, identity, uid in stages:
            try:
                records.append(strip_stop_identity(identity, uid, deadline))
            except Exception as error:
                error.strip_stage = stage
                raise
        if owner.get("launch_state") != "known" or client is None:
            raise RuntimeError("unknown fixture launch prevents confirmed cleanup")
        return {"nonce": nonce, "boot_id": owner["boot_id"], "owned_processes": records,
                "cleanup_confirmed": True, "descendant_group_retirement_qualified": False}
    if action not in ("state", "banner") or owner.get("launch_state") != "known":
        raise RuntimeError("strip fixture ownership not admitted")
    fixture = strip_json(receipt_path, OWNER.pw_uid)
    if strip_validate_client(fixture, nonce, owner["launcher"], mode) != owner["client"]:
        raise RuntimeError("strip client identity differs from original admission")
    current = inventory()
    if strip_core(current) != owner["core"]:
        raise RuntimeError("native compositor/shell identity changed since original fixture admission")
    if action == "banner":
        shell = owner["core"][SHELL_GTK]
        display = f"{NESTED}{owner['core'][COMPOSITOR]['pid']}"
        observed = json.loads(call("/usr/libexec/tuna-vm-shell-focus", str(shell["pid"]),
                                   str(shell["start_ticks"]), SHELL_GTK, display, "banner", user=True))
        if strip_core(inventory()) != owner["core"]:
            raise RuntimeError("original native pair changed during banner observation")
        return {"owner": owner, "notification": observed}
    summary = strip_json(STATE, OWNER.pw_uid)
    current["state"].update({key: summary.get(key) for key in
                           ("session_mode", "strip_offset", "strip_view", "strip_animating", "rendered_frames", "tile_preview",
                            "seat_pressed_key_count")})
    # Native window->PID kernel credentials are not in the current summary.
    # Nonce app IDs/new-map sets are checked by the host; never fabricate that join.
    return {"owner": owner, "fixture": fixture, "inventory": current,
            "native_window_kernel_pid_join_qualified": False}


def strip_stop_error(error):
    """Bounded strip-stop failure record for the lane's failure record.

    Strip cleanup carries no credentials: its messages are this helper's own
    fixed strings or OS errors on /proc paths. QGA's stderr stays discarded.
    """
    result = {"exception_type": type(error).__name__,
              "message": "".join(c for c in str(error)[:512] if c.isprintable())}
    if isinstance(error, OSError) and type(error.errno) is int:
        result["errno"] = error.errno
    if getattr(error, "strip_stage", None) in ("client", "launcher"):
        result["stage"] = error.strip_stage
    return result


def shell_stack():
    """Each session shell's threads: name, state, kernel wait and stack,
    plus user backtraces without arguments, locals or debuginfod traffic."""
    shells = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            if (path.stat().st_uid != OWNER.pw_uid
                    or pathlib.Path(os.readlink(path / "exe")).name != SHELL_GTK):
                continue
            tasks = sorted((path / "task").iterdir(), key=lambda task: int(task.name))
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        threads = []
        for task in tasks:
            thread = {"tid": int(task.name)}
            for key, name in (("name", "comm"), ("wait_site", "wchan"),
                              ("syscall", "syscall"), ("kernel_stack", "stack")):
                try:
                    thread[key] = (task / name).read_text().strip()
                except OSError as error:
                    thread[key] = f"unavailable: {type(error).__name__}"
            try:
                thread["state"] = (task / "stat").read_text().rsplit(")", 1)[1].split()[0]
            except OSError as error:
                thread["state"] = f"unavailable: {type(error).__name__}"
            threads.append(thread)
        try:
            gdb = subprocess.run(["gdb", "-nx", "-batch", "-iex", "set debuginfod enabled off",
                                  "-iex", "set print frame-arguments none",
                                  "-iex", "set print entry-values no",
                                  "-ex", "info threads", "-ex", "thread apply all bt",
                                  "-p", path.name],
                                 capture_output=True, text=True, timeout=90)
            # The lane's QGA reply bound is 1 MiB of base64 JSON.
            backtraces = (gdb.stdout + gdb.stderr)[-196608:]
        except (OSError, subprocess.TimeoutExpired) as error:
            backtraces = f"unavailable: {type(error).__name__}"
        shells.append({"pid": int(path.name), "threads": threads, "backtraces": backtraces})
    return {"shells": shells}


# The bounded nightly soak (docs/soak.md): the published fixture installs
# scripts/tuna-vm-soak with its native frame workload beside it.
SOAK_UNIT = "tuna-vm-soak"
SOAK_OBSERVER = pathlib.Path("/usr/libexec/tuna-soak/tuna-vm-soak")
SOAK_OUT = pathlib.Path("/var/tmp/tuna-vm-soak")
SOAK_FILES = ("provenance.json", "samples.jsonl", "report.json", "presentation.jsonl", "presentation.stderr")
# Raw bytes per read; base64 twice (here and QGA) stays under the lane's 1 MiB reply bound.
SOAK_CHUNK = 384 * 1024


def soak_start(seconds, warmup, interval, revision):
    if SOAK_OUT.exists():
        raise RuntimeError("soak output directory must be fresh")
    compositor = owned_compositor(inventory()["processes"])
    # The actual DRM session's socket, as runtime::default_for_pid names it.
    display = f"{NESTED}{compositor['pid']}"
    # A root transient service outside the session UID, as docs/soak.md runs it;
    # RemainAfterExit keeps a successful exit status for soak-status.
    call("systemd-run", f"--unit={SOAK_UNIT}", "--property=Type=exec", "--property=RemainAfterExit=yes",
         "--quiet", str(SOAK_OBSERVER), "--user", OWNER.pw_name, "--source-revision", revision,
         "--out", str(SOAK_OUT), "--seconds", str(seconds), "--warmup", str(warmup),
         "--interval", str(interval), "--presentation", "--wayland-display", display)
    return {"unit": SOAK_UNIT, "out": str(SOAK_OUT), "wayland_display": display, "compositor": compositor}


def soak_status():
    shown = call("systemctl", "show", SOAK_UNIT,
                 "--property=ActiveState,SubState,Result,ExecMainCode,ExecMainStatus")
    unit = dict(line.split("=", 1) for line in shown.splitlines() if "=" in line)
    running = (unit.get("ActiveState") in ("activating", "active", "deactivating", "reloading")
               and unit.get("SubState") != "exited")
    files = {name: (SOAK_OUT / name).stat().st_size for name in SOAK_FILES if (SOAK_OUT / name).is_file()}
    count, last = 0, None
    if "samples.jsonl" in files:
        # Only newline-terminated rows: the observer may be mid-write.
        rows = (SOAK_OUT / "samples.jsonl").read_bytes().split(b"\n")[:-1]
        count = len(rows)
        if rows:
            row = json.loads(rows[-1])
            pacing = row.get("presentation") or {}
            last = {key: row[key] for key in ("elapsed_s", "pss_kib", "rss_kib", "fds", "processes")}
            last |= {"frames": pacing.get("frames"),
                     "p99_ms": (pacing.get("interval_ms") or {}).get("p99")}
    result = {"unit": unit, "running": running, "samples": count, "files": files, "last": last}
    if not running:
        result["sha256"] = {name: hashlib.sha256((SOAK_OUT / name).read_bytes()).hexdigest() for name in files}
        # The observer's own failure text; it never prints credentials.
        result["journal"] = call("journalctl", "--unit", SOAK_UNIT, "--output", "cat", "--no-pager",
                                 "--lines", "80", check=False)[-8192:]
    return result


def soak_read(name, offset):
    if name not in SOAK_FILES or offset < 0:
        raise ValueError("unknown soak file or offset")
    with (SOAK_OUT / name).open("rb") as stream:
        stream.seek(offset)
        data = stream.read(SOAK_CHUNK)
        size = os.fstat(stream.fileno()).st_size
    return {"name": name, "offset": offset, "size": size, "data": base64.b64encode(data).decode()}


