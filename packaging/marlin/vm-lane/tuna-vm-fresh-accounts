#!/bin/sh
# CI-only (tunaOS#4092): create the fresh-account fixtures the way an
# installer does, with useradd, at boot. Runs only when the lane passes the
# tuna.vm.fresh-accounts systemd credential (SMBIOS type 11), so the default
# lanes' GDM user list is unchanged.
#
#   tunastd     standard account: no admin group
#   tunaadmin   administrator: the distribution's admin group (wheel)
#   tunaseeded  negative control: an AccountsService record is pre-seeded
#
# tunastd and tunaadmin get NO AccountsService record, NO Session
# preselection and NO autologin: AccountsService and GDM create whatever
# state they create on first login. Idempotent across reboots: an existing
# account is never recreated, re-passworded or touched.
set -eu
create() {
	name=$1
	shift
	if id -u "$name" >/dev/null 2>&1; then
		return 0
	fi
	useradd -m -U -s /bin/bash "$@" "$name"
	echo "$name:tuna" | chpasswd
}
create tunastd
create tunaadmin -G wheel
if ! id -u tunaseeded >/dev/null 2>&1; then
	create tunaseeded
	install -d -m 0700 /var/lib/AccountsService/users
	printf '[User]\nSystemAccount=false\n' >/var/lib/AccountsService/users/tunaseeded
	chmod 0600 /var/lib/AccountsService/users/tunaseeded
fi
# GDM's user list order depends on when AccountsService loads each account,
# so Tab-counting to "Not listed?" can select tunaseeded and type the target
# name as its password (run 41230684089). This credential-only boot asks for
# the name directly instead. Preserve GDM's profile databases, but insert
# a credential-only database before their defaults. The vendor profile need
# not contain system-db:gdm (run 41234017707); writing gdm.d alone is not enough.
profile=/etc/dconf/profile/gdm
if [ ! -f "$profile" ]; then
	profile=/usr/share/dconf/profile/gdm
fi
install -d -m 0755 /etc/dconf/profile /etc/dconf/db/tuna-vm-fresh-accounts.d
{
	printf 'user-db:user\nsystem-db:tuna-vm-fresh-accounts\n'
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		user-db:* | system-db:tuna-vm-fresh-accounts) continue ;;
		esac
		printf '%s\n' "$line"
	done <"$profile"
} >/run/tuna-vm-fresh-gdm-profile
install -m 0644 /run/tuna-vm-fresh-gdm-profile /etc/dconf/profile/gdm
rm /run/tuna-vm-fresh-gdm-profile
printf '[org/gnome/login-screen]\ndisable-user-list=true\n' >/etc/dconf/db/tuna-vm-fresh-accounts.d/00-login
dconf update
# Read through the actual profile/backend, not merely the source file.
test "$(DCONF_PROFILE=gdm gsettings get org.gnome.login-screen disable-user-list)" = true
