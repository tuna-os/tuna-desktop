# Private CI-only final layer: no repository, signature-policy or production-pin changes.
# The caller supplies the immutable image ID AFTER either Orca profile's upgrades.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG GDM_SOURCE_SHA=7b52bdf34be22bc60fef62b157be64b589b13f6a
COPY gdm51-artifacts/manifest.json gdm51-artifacts/packages/ /tmp/gdm51/
RUN GDM_SOURCE_SHA=${GDM_SOURCE_SHA} python3 - <<'PY'
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess

def require(condition, message):
    if not condition:
        raise SystemExit(message)

def unique(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, 'duplicate manifest key')
        result[key] = value
    return result

def keys(value, expected):
    require(type(value) is dict and set(value) == set(expected), 'invalid manifest fields')

def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()

def command(*args):
    return subprocess.check_output(args, text=True, timeout=60)

def validate_candidate(root, expected_source):
    # Read-only and unprivileged: admission finishes before any pacman operation.
    manifest_path = root / 'manifest.json'
    fd = os.open(manifest_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        require(stat.S_ISREG(info.st_mode) and 0 < info.st_size <= 16384, 'invalid manifest file')
        manifest_bytes = stream.read(16385)
    require(0 < len(manifest_bytes) <= 16384, 'invalid manifest size')
    manifest = json.loads(manifest_bytes, object_pairs_hook=unique)
    keys(manifest, ('schema', 'source_repository', 'source_commit', 'architecture', 'packages', 'members'))
    require(type(manifest['schema']) is int and manifest['schema'] == 1, 'invalid schema')
    require(manifest['source_repository'] == 'tuna-os/tunaos-packages', 'invalid source repository')
    require(expected_source == '7b52bdf34be22bc60fef62b157be64b589b13f6a'
            and manifest['source_commit'] == expected_source, 'invalid source commit')
    require(manifest['architecture'] == 'x86_64', 'invalid architecture')
    keys(manifest['packages'], ('gdm', 'libgdm'))
    expected_members = {'/usr/bin/gdm': 'gdm', '/usr/lib/gdm-session-worker': 'gdm',
                        '/usr/lib/libgdm.so.1.0.0': 'libgdm'}
    keys(manifest['members'], expected_members)
    archives = []
    for name in ('gdm', 'libgdm'):
        entry = manifest['packages'][name]
        keys(entry, ('file', 'version', 'sha256'))
        require(entry['file'] == f'{name}-51.1.1-1.1-x86_64.pkg.tar.zst'
                and entry['version'] == '51.1.1-1.1', 'invalid package identity')
        require(type(entry['sha256']) is str and re.fullmatch('[0-9a-f]{64}', entry['sha256']),
                'invalid package digest')
        archive = root / entry['file']
        require(stat.S_ISREG(archive.lstat().st_mode) and digest(archive) == entry['sha256'],
                'package digest mismatch')
        pkginfo = command('bsdtar', '-xOf', str(archive), '.PKGINFO')
        fields = {}
        for line in pkginfo.splitlines():
            if ' = ' in line:
                key, value = line.split(' = ', 1)
                fields.setdefault(key, []).append(value)
        for key, value in (('pkgname', name), ('pkgver', entry['version']), ('arch', 'x86_64')):
            require(fields.get(key) == [value], 'package metadata mismatch')
        archives.append(str(archive))
    for member, owner in expected_members.items():
        entry = manifest['members'][member]
        keys(entry, ('package', 'sha256'))
        require(entry['package'] == owner and type(entry['sha256']) is str
                and re.fullmatch('[0-9a-f]{64}', entry['sha256']), 'invalid member identity')
        archive = root / manifest['packages'][owner]['file']
        payload = subprocess.check_output(['bsdtar', '-xOf', str(archive), member.lstrip('/')], timeout=60)
        require(hashlib.sha256(payload).hexdigest() == entry['sha256'], 'archive member mismatch')
    return manifest, manifest_bytes, archives, expected_members

manifest, manifest_bytes, archives, expected_members = validate_candidate(
    Path('/tmp/gdm51'), os.environ['GDM_SOURCE_SHA'])
for name, archive in zip(('gdm', 'libgdm'), archives):
    require(command('pacman', '-Qp', archive).strip() == f'{name} 51.1.1-1.1',
            'pacman archive identity mismatch')
out = Path('/usr/share/tuna-vm-gdm51')
out.mkdir()

# Save the original receipt bytes; never regenerate it to hide package drift.
payload_manifest = Path('/usr/share/tuna-vm/shipped-payload.sha256')
payload_receipt = payload_manifest.read_bytes()
subprocess.run(['sha256sum', '--check', str(payload_manifest)], check=True, timeout=60)
policy = Path('/etc/pacman.conf').read_bytes()
# Ordinary local package transaction; existing LocalFileSigLevel remains in force.
with (out / 'install.log').open('wb') as log:
    subprocess.run(['pacman', '-U', '--noconfirm', *archives], stdout=log,
                   stderr=subprocess.STDOUT, check=True, timeout=300)
require(Path('/etc/pacman.conf').read_bytes() == policy, 'pacman policy changed')
require(payload_manifest.read_bytes() == payload_receipt, 'shipped payload receipt changed')
subprocess.run(['sha256sum', '--check', str(payload_manifest)], check=True, timeout=60)
installed = command('pacman', '-Q', 'gdm', 'libgdm')
require(installed == 'gdm 51.1.1-1.1\nlibgdm 51.1.1-1.1\n', 'installed version mismatch')
members = {}
for member, owner in expected_members.items():
    path = Path(member)
    require(stat.S_ISREG(path.lstat().st_mode), 'installed member is not a regular file')
    require(command('pacman', '-Qqo', member).strip() == owner, 'installed ownership mismatch')
    actual = digest(path)
    require(actual == manifest['members'][member]['sha256'], 'installed member mismatch')
    members[member] = {'package': owner, 'sha256': actual}
subprocess.run(['/usr/libexec/tuna-image-kernels', 'vm'], check=True, timeout=120)
(out / 'manifest.json').write_bytes(manifest_bytes)
(out / 'installed-packages.txt').write_text(installed)
(out / 'package-info.txt').write_text(command('pacman', '-Qi', 'gdm', 'libgdm'))
(out / 'install-provenance.json').write_text(json.dumps({
    'source_commit': manifest['source_commit'], 'architecture': manifest['architecture'],
    'manifest_sha256': hashlib.sha256(manifest_bytes).hexdigest(),
    'packages': manifest['packages'], 'members': members,
    'shipped_payload_sha256': hashlib.sha256(payload_receipt).hexdigest(),
    'shipped_payload_unchanged': True,
    'pacman_conf_sha256': hashlib.sha256(policy).hexdigest(),
}, indent=2) + '\n')
PY
RUN rm -rf /tmp/gdm51
LABEL org.opencontainers.image.title="marlin-tuna-vm-gdm51-private" \
      org.opencontainers.image.description="CI-only exact-source same-run GDM candidate; not production qualification"
