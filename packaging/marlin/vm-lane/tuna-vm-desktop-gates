#!/usr/bin/env python3
"""CI-only installed desktop gates (scripts/lib/vm_desktop_gates.py).

Root probe reached through tuna-vm-lifecycle's gates-* actions, plus the
session-user GTK fixtures it launches from this same file:

  --window main NONCE        a CSD window: GTK's own minimize/maximize/close
                             title buttons, an app menu button whose popover
                             is an xdg_popup, and a text entry
  --window bystander NONCE   another client, maximized, counting presses
  --window placed NONCE CONNECTOR
                             fullscreen on the output with that connector
  --window launched NONCE    the app the shell's own app grid launches (a
                             fixture .desktop entry's Exec)
  --tray-observe             the shell's own AT-SPI tree, fixed tray labels only
  --a11y-dump PID [FRAMES]   the shell's showing, named AT-SPI nodes in tree
                             order, with role, state and window extents
  --notify-monitor NONCE     the session bus's NotificationClosed and
                             ActionInvoked signals, one JSON line each

Every action prints one JSON object; a failure prints {"gates_error": ...}.
The probe never synthesizes input: the lane sends real keys and pointer
events through QEMU. Fixture state files (mode 0600, the session's runtime
directory) hold counts, GTK's own state and widget bounds, nothing else.
"""
import json
import os
import pathlib
import pwd
import re
import signal
import subprocess
import sys
import time

OWNER = pwd.getpwnam("tuna-test")
RUNTIME = pathlib.Path(f"/run/user/{OWNER.pw_uid}")
SCENE = RUNTIME / "tuna-vm-state.json"
SELF = "/usr/libexec/tuna-vm-desktop-gates"
TRAY_STUB = "/usr/libexec/tuna-tray-item-stub"
# The nested proof's StatusNotifierItem stub (scripts/lib/tuna-tray-item-stub.py).
TRAY_TITLE, TRAY_TIP, TRAY_ROW = "Tuna Desktop Tray Probe", "Tray probe tip", "Open Probe"
ROLES = ("main", "bystander", "placed", "launched")
NONCE = re.compile(r"[0-9a-f]{16,32}")
# Mutter's work-area keys, the overview's drawn state and the workspace
# switch records the shell gates (scripts/lib/vm_shell_gates.py) read.
SCENE_KEYS = ("windows", "focused", "minimized", "stacking", "outputs", "layers", "cursor",
              "pointer_position", "window_lifecycle", "animations_enabled", "overview_open",
              "locked", "window_outputs", "x11_ready", "x11_display", "animation_slowdown",
              "overview_app_grid", "overview_state", "overview_progress", "overview_search",
              "previews", "thumbnails", "workspace_cards", "workspaces", "active_workspace",
              "focused_app_id", "focused_rect", "session_mode", "tile_preview", "workspace_slide",
              "motion_policy")
# Fixed names of the app-grid fixtures and what notify-send may be handed.
APPS_DIR = pathlib.Path(OWNER.pw_dir) / ".local" / "share" / "applications"
PAGE_APPS = 30
TEXT = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}")
ACTION = re.compile(r"[a-z]{1,16}=[A-Za-z0-9 ]{1,24}")


def nonce(value):
    if not NONCE.fullmatch(value):
        raise ValueError("invalid nonce")
    return value


def app_id(role, key):
    return f"org.tuna.VmGates.n{key}.{role}"


def state_path(role, key):
    return RUNTIME / f"tuna-vm-gates-{role}-{key}.json"


# ---- session-user fixtures -------------------------------------------------

def publisher(path, state):
    def publish():
        temporary = path.with_suffix(".tmp")
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as stream:
            json.dump(state, stream)
        temporary.replace(path)
    return publish


def window_fixture(role, key, connector=None):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, Gio, GLib, Gtk
    # A blinking caret would repaint the window under the pixel checks.
    Gtk.Settings.get_default().set_property("gtk-cursor-blink", False)
    signal.alarm(600)  # Independent lifetime cap; the probe stops it first.
    state = {"role": role, "nonce": key, "pid": os.getpid(), "uid": os.getuid(),
             "app_id": app_id(role, key), "mapped": False, "active": False, "size": [0, 0],
             "maximized": False, "fullscreen": False, "tiled": False, "surface": [0, 0],
             "presses": 0, "releases": 0, "keys": 0, "nav_keys": 0,
             "popover_shows": 0, "popover_hides": 0, "popover_visible": False,
             "bounds": {}, "connector": connector, "connectors": [], "errors": []}
    publish = publisher(state_path(role, key), state)

    def bounds_of(widget, window):
        ok, rect = widget.compute_bounds(window)
        if not ok or not widget.get_mapped():
            return None
        return [round(rect.origin.x), round(rect.origin.y), round(rect.size.width), round(rect.size.height)]

    def find_button(root, css):
        child = root.get_first_child()
        while child is not None:
            if isinstance(child, Gtk.Button) and child.has_css_class(css):
                return child
            found = find_button(child, css)
            if found is not None:
                return found
            child = child.get_next_sibling()
        return None

    def activate(app):
        window = Gtk.ApplicationWindow(application=app, title=f"Tuna VM gates {role}")
        widgets = {}
        if role == "main":
            window.set_default_size(560, 360)
            header = Gtk.HeaderBar()
            # GTK's own window controls, as an app that shows all three asks
            # (GNOME's default button-layout shows close only).
            header.set_decoration_layout(":minimize,maximize,close")
            # A painted swatch, so the open popover is unmistakable in a
            # screendump whatever the theme's popover and window colours.
            swatch = Gtk.DrawingArea(content_width=160, content_height=60)
            swatch.set_draw_func(lambda _area, context, *_: (context.set_source_rgb(171 / 255, 65 / 255, 81 / 255),
                                                             context.paint()))
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            row.append(Gtk.Label(label="Tuna VM popover row"))
            row.append(swatch)
            popover = Gtk.Popover()
            popover.set_child(row)
            menu = Gtk.MenuButton(icon_name="open-menu-symbolic", popover=popover)
            header.pack_end(menu)
            window.set_titlebar(header)

            def shown(*_):
                state["popover_shows"] += 1
                state["popover_visible"] = True
                publish()

            def hidden(*_):
                state["popover_hides"] += 1
                state["popover_visible"] = False
                publish()
            popover.connect("show", shown)
            popover.connect("hide", hidden)
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            body.set_margin_start(24)
            body.set_margin_end(24)
            body.set_margin_bottom(24)
            # Top left, clear of the popover below the menu button.
            label = Gtk.Label(label="Tuna VM installed desktop gates", halign=Gtk.Align.START,
                              valign=Gtk.Align.START, margin_top=12)
            label.set_vexpand(True)
            entry = Gtk.Entry(placeholder_text="Tuna VM cursor probe")
            body.append(label)
            body.append(entry)
            window.set_child(body)
            widgets = {"menu": menu, "entry": entry, "header": header}
        else:
            window.set_default_size(640, 420)
            window.set_child(Gtk.Label(label=f"Tuna VM gates {role}"))
        clicks = Gtk.GestureClick()
        clicks.set_button(0)
        clicks.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

        def pressed(*_):
            state["presses"] += 1
            publish()

        def released(*_):
            state["releases"] += 1
            publish()
        clicks.connect("pressed", pressed)
        clicks.connect("released", released)
        window.add_controller(clicks)
        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

        def key_pressed(_controller, keyval, *_):
            state["keys"] += 1
            # Compositor chords the lane sends (Super+arrows, Super+Page keys)
            # consume these presses; a client counting them proves the leak.
            if Gdk.keyval_name(keyval) in ("Up", "Down", "Left", "Right", "Page_Up", "Page_Down"):
                state["nav_keys"] += 1
            publish()
            return False
        keys.connect("key-pressed", key_pressed)
        window.add_controller(keys)

        def mapped(*_):
            state["mapped"] = True
            if role == "placed":
                monitors = window.get_display().get_monitors()
                found = None
                for index in range(monitors.get_n_items()):
                    monitor = monitors.get_item(index)
                    state["connectors"].append(monitor.get_connector())
                    if monitor.get_connector() == connector:
                        found = monitor
                if found is None:
                    state["errors"].append("no monitor with the requested connector")
                else:
                    window.fullscreen_on_monitor(found)
            publish()
        window.connect("map", mapped)

        def surface_facts():
            """The Wayland surface, shadows included, and GTK's tiled state."""
            surface = window.get_surface()
            if surface is None:
                return [0, 0], False
            return [surface.get_width(), surface.get_height()], bool(surface.get_state() & Gdk.ToplevelState.TILED)

        def tick(*_):
            surface, tiled = surface_facts()
            current = {"active": window.is_active(), "size": [window.get_width(), window.get_height()],
                       "maximized": window.is_maximized(), "fullscreen": window.is_fullscreen(),
                       "surface": surface, "tiled": tiled, "bounds": {}}
            if role == "main":
                buttons = {css: find_button(widgets["header"], css) for css in ("minimize", "maximize", "close")}
                for name, widget in {**widgets, **buttons}.items():
                    if widget is not None and name != "header":
                        current["bounds"][name] = bounds_of(widget, window)
            if any(state[k] != v for k, v in current.items()):
                state.update(current)
                publish()
            return GLib.SOURCE_CONTINUE
        GLib.timeout_add(50, tick)
        if role == "bystander":
            window.maximize()
        window.present()
    publish()
    application = Gtk.Application(application_id=app_id(role, key), flags=Gio.ApplicationFlags.NON_UNIQUE)
    application.connect("activate", activate)
    application.run([])


def tray_observe():
    """The shell's tray item and its menu row, by the stub's fixed labels only."""
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, GLib
    shell = int(sys.argv[2])
    Atspi.set_timeout(1000, 1000)
    deadline = time.monotonic() + 8
    desktop = Atspi.get_desktop(0)
    apps = [desktop.get_child_at_index(i) for i in range(min(desktop.get_child_count(), 64))]
    apps = [a for a in apps if a is not None and a.get_process_id() == shell]
    if len(apps) != 1:
        raise RuntimeError("the shell's accessibility root is not unique")
    found = []
    pending = [(apps[0], None, 0)]
    visited = 0
    while pending:
        node, toplevel, depth = pending.pop()
        visited += 1
        if visited > 4000 or time.monotonic() > deadline:
            raise RuntimeError("shell accessibility walk exceeded its bound")
        try:
            name = node.get_name() or ""
            if depth == 1:
                toplevel = name
            if name in (TRAY_TITLE, TRAY_ROW):
                extents = node.get_extents(Atspi.CoordType.WINDOW)
                found.append({"name": name, "role": node.get_role_name(), "toplevel": toplevel,
                              "showing": node.get_state_set().contains(Atspi.StateType.SHOWING),
                              "tooltip": TRAY_TIP in (node.get_description() or ""),
                              "extents": [extents.x, extents.y, extents.width, extents.height]})
            children = [node.get_child_at_index(i) for i in range(min(node.get_child_count(), 256))]
        except GLib.Error:
            continue  # a node that went away mid-walk (a closing menu row)
        pending.extend((child, toplevel, depth + 1) for child in children if child is not None)
    return {"nodes": found, "visited": visited}


def a11y_dump():
    """The shell's showing, named AT-SPI nodes in tree order: the vocabulary of
    tests/a11y/*.txt (scripts/tuna-a11y-golden), plus the state flags and
    window-relative extents the lane clicks by. A node that is not showing
    hides its subtree, which keeps the walk to what is on screen. FRAMES
    (comma separated) limits it to those top-level windows."""
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, GLib
    shell = int(sys.argv[2])
    only = set(sys.argv[3].split(",")) if len(sys.argv) > 3 else None
    Atspi.set_timeout(1000, 1000)
    deadline = time.monotonic() + 25
    desktop = Atspi.get_desktop(0)
    apps = [desktop.get_child_at_index(i) for i in range(min(desktop.get_child_count(), 64))]
    apps = [a for a in apps if a is not None and a.get_process_id() == shell]
    if len(apps) != 1:
        raise RuntimeError("the shell's accessibility root is not unique")
    nodes, visited = [], 0
    pending = [(apps[0], None, 0)]
    while pending:
        node, toplevel, depth = pending.pop()
        visited += 1
        if visited > 6000 or time.monotonic() > deadline:
            raise RuntimeError("shell accessibility walk exceeded its bound")
        try:
            name = node.get_name() or ""
            if depth == 1:
                toplevel = name
                if only is not None and name not in only:
                    continue
            states = node.get_state_set()
            if depth >= 1 and not states.contains(Atspi.StateType.SHOWING):
                continue
            if depth >= 1 and name:
                extents = node.get_extents(Atspi.CoordType.WINDOW)
                nodes.append({"role": node.get_role_name(), "name": name, "toplevel": toplevel, "depth": depth,
                              "description": (node.get_description() or "")[:80],
                              "checked": states.contains(Atspi.StateType.CHECKED)
                              or states.contains(Atspi.StateType.PRESSED),
                              "focused": states.contains(Atspi.StateType.FOCUSED),
                              "extents": [extents.x, extents.y, extents.width, extents.height]})
            children = [node.get_child_at_index(i) for i in range(min(node.get_child_count(), 256))]
        except GLib.Error:
            continue  # a node that went away mid-walk (a closing banner or menu row)
        pending.extend((child, toplevel, depth + 1) for child in reversed(children) if child is not None)
    return {"nodes": nodes, "visited": visited}


def notify_monitor(key):
    """Session user: append the notification server's closed and action
    signals to a private log, one JSON line each, after a `ready` line."""
    from gi.repository import Gio, GLib
    signal.alarm(900)  # Independent lifetime cap; the probe stops it first.
    stream = os.fdopen(os.open(RUNTIME / f"tuna-vm-gates-notify-{key}.jsonl",
                               os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600), "a")

    def write(row):
        stream.write(json.dumps({**row, "t": time.time()}) + "\n")
        stream.flush()

    def received(_connection, _sender, _path, _interface, name, params, *_):
        write({"signal": name, "args": list(params.unpack())})
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    for name in ("NotificationClosed", "ActionInvoked"):
        bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", name,
                             "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, received)
    write({"signal": "ready"})
    GLib.MainLoop().run()


# ---- root probe -------------------------------------------------------------

def owned_processes(executable):
    rows = []
    for proc in pathlib.Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid == OWNER.pw_uid and pathlib.Path(os.readlink(proc / "exe")).name == executable:
                rows.append(int(proc.name))
        except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
            continue
    return sorted(rows)


def session_shell():
    shells = owned_processes("tuna-shell-gtk")
    if len(shells) != 1:
        raise RuntimeError("one session shell is required")
    return shells[0]


def session_env():
    """The session's own Wayland socket, as the shell holds it (lifecycle
    shell_controls reads it the same way)."""
    with open(f"/proc/{session_shell()}/environ", "rb") as stream:
        raw = stream.read(128 * 1024)
    displays = [entry.split(b"=", 1)[1].decode() for entry in raw.split(b"\0")
                if entry.startswith(b"WAYLAND_DISPLAY=")]
    if len(displays) != 1:
        raise RuntimeError("the shell's Wayland display is not one value")
    return [f"XDG_RUNTIME_DIR={RUNTIME}", f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
            f"HOME={OWNER.pw_dir}", f"WAYLAND_DISPLAY={displays[0]}", "GDK_BACKEND=wayland"]


def spawn_user(*command, log=None):
    output = open(log, "w") if log else subprocess.DEVNULL
    try:
        return subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env", *session_env(), *command],
                                stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                start_new_session=True).pid
    finally:
        if log:
            output.close()


def call_user(*command, timeout=15):
    return subprocess.run(["runuser", "-u", OWNER.pw_name, "--", "env", *session_env(), *command],
                          capture_output=True, text=True, timeout=timeout, check=True).stdout.strip()


def owned_json(path):
    info = path.lstat()
    if info.st_uid != OWNER.pw_uid or not path.is_file() or info.st_mode & 0o077:
        raise RuntimeError(f"{path.name} is not the session user's private file")
    return json.loads(path.read_text())


def scene():
    state = json.loads(SCENE.read_text())
    return {key: state.get(key) for key in SCENE_KEYS}


def wait_for(predicate, timeout, message):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.05)
    raise RuntimeError(message)


def fixture_alive(value, marker):
    proc = pathlib.Path(f"/proc/{value['pid']}")
    try:
        if proc.stat().st_uid != OWNER.pw_uid:
            return False
        return marker.encode() in (proc / "cmdline").read_bytes()
    except (FileNotFoundError, ProcessLookupError):
        return False


def fixtures(key):
    result = {}
    for role in ROLES:
        path = state_path(role, key)
        if path.exists():
            value = owned_json(path)
            value["alive"] = fixture_alive(value, key)
            result[role] = value
    return result


def start(role, key, connector=None):
    if role not in ROLES or (role == "placed") != (connector is not None):
        raise ValueError("unknown fixture role")
    if connector is not None and not re.fullmatch(r"[A-Za-z0-9-]{1,32}", connector):
        raise ValueError("invalid connector")
    path = state_path(role, key)
    if path.exists():
        raise RuntimeError("fixture already exists")
    spawn_user(sys.executable, SELF, "--window", role, key, *([connector] if connector else []))

    def ready():
        if not path.exists():
            return None
        value = owned_json(path)
        current = scene()
        windows = [w for w in current["windows"] or [] if w.get("app_id") == value["app_id"]]
        if not value["mapped"] or len(windows) != 1 or value["size"] == [0, 0]:
            return None
        if role == "main" and not all(value["bounds"].get(k) for k in ("menu", "entry", "minimize", "maximize", "close")):
            return None
        return {"fixture": value, "window": windows[0], "scene": current}
    return wait_for(ready, 30, f"{role} fixture did not map with its bounds")


def in_flight(current, effect, target):
    """This transition's own entries in the compositor snapshot right now."""
    if effect == "locate":
        locate = (current.get("cursor") or {}).get("locate_pointer") or {}
        return [locate] if locate.get("active") else []
    life = current.get("window_lifecycle") or {}
    entry = "minimizing" if effect == "minimize" else "restoring"
    return [run for run in life.get(entry) or [] if run.get("window") == target]


def watch(key, effect, target, seconds):
    """Poll the compositor's own state file while the lane sends one real
    input: every distinct in-flight frame of the transition it starts (a
    window's minimize or restore, or the locate-pointer ripple), until it ends.
    The lane sends its input once this has armed, about a second after start."""
    if effect not in ("minimize", "unminimize", "locate") or not 0 < seconds <= 10:
        raise ValueError("invalid watch")
    first = json.loads(SCENE.read_text())
    history = (first.get("window_lifecycle") or {}).get("history") or []
    baseline_at = max((h.get("at_ms") or 0 for h in history), default=-1)
    baseline_count = ((first.get("cursor") or {}).get("locate_pointer") or {}).get("count")
    samples, seen = [], set()
    deadline = time.monotonic() + seconds
    current = first
    while time.monotonic() < deadline:
        try:
            current = json.loads(SCENE.read_text())
        except (OSError, ValueError):
            continue  # the writer renames atomically; retry a vanished read
        flying = in_flight(current, effect, target)
        for run in flying:
            marker = json.dumps(run, sort_keys=True)
            if marker not in seen and len(samples) < 256:
                seen.add(marker)
                samples.append({**run, "t": time.monotonic()})
        if effect == "minimize":
            done = any(h.get("window") == target and h.get("effect") == "minimize"
                       and h.get("outcome") == "completed" and (h.get("at_ms") or 0) > baseline_at
                       for h in (current.get("window_lifecycle") or {}).get("history") or [])
        elif effect == "unminimize":
            done = bool(samples) and not flying
        else:
            count = ((current.get("cursor") or {}).get("locate_pointer") or {}).get("count")
            done = count != baseline_count and not flying
        if done:
            break
        time.sleep(0.004)
    return {"effect": effect, "target": target, "baseline_at_ms": baseline_at,
            "baseline_locate_count": baseline_count, "samples": samples, "fixtures": fixtures(key),
            "scene": {k: current.get(k) for k in SCENE_KEYS}}


def settings(action, size=None, locate=None):
    keys = (("cursor-size", size), ("locate-pointer", locate))
    if action == "set":
        if not (size.isdigit() and 8 <= int(size) <= 256 and locate in ("true", "false")):
            raise ValueError("invalid cursor settings")
        for name, value in keys:
            call_user("gsettings", "set", "org.gnome.desktop.interface", name, value)
    elif action != "get":
        raise ValueError("unknown settings action")
    return {name: call_user("gsettings", "get", "org.gnome.desktop.interface", name) for name, _ in keys}


def tray(action, key):
    marker = RUNTIME / f"tuna-vm-gates-tray-{key}.marker"
    log = RUNTIME / f"tuna-vm-gates-tray-{key}.log"
    if action == "start":
        if log.exists():
            raise RuntimeError("tray stub already exists")
        spawn_user(sys.executable, TRAY_STUB, str(marker), log=str(log))
        wait_for(lambda: "registered" in log.read_text(), 30,
                 "the StatusNotifierItem never registered with the shell's watcher")
        return {"registered": True, "stub": user_pids(str(marker))}
    if action == "observe":
        observed = json.loads(call_user(sys.executable, SELF, "--tray-observe", str(session_shell()), timeout=20))
        return {**observed, "scene": scene(), "stub": user_pids(str(marker)),
                "marker": marker.read_text().splitlines() if marker.exists() else []}
    if action == "stop":
        stopped = terminate(user_pids(str(marker)), "tray stub")
        for path in (marker, log):
            path.unlink(missing_ok=True)
        return {"stopped": stopped}
    raise ValueError("unknown tray action")


def watch_layer(namespace, seconds):
    """Poll the compositor's state file every 4 ms while the lane sends one real
    input: each distinct rectangle of the layer-shell surface `namespace`,
    from its first appearance until it is gone again (a workspace popup or a
    banner, which come and go within a second or two)."""
    if not re.fullmatch(r"tuna-[a-z-]{1,40}", namespace) or not 0 < seconds <= 15:
        raise ValueError("invalid layer watch")
    samples, seen, appeared, rects = [], set(), False, []
    deadline = time.monotonic() + seconds
    current = json.loads(SCENE.read_text())
    while time.monotonic() < deadline:
        try:
            current = json.loads(SCENE.read_text())
        except (OSError, ValueError):
            continue  # the writer renames atomically; retry a vanished read
        rects = [layer.get("rect") for layer in current.get("layers") or [] if layer.get("namespace") == namespace]
        for rect in rects:
            marker = json.dumps(rect)
            if marker not in seen and len(samples) < 64:
                seen.add(marker)
                samples.append({"rect": rect, "t": time.monotonic()})
        appeared = appeared or bool(rects)
        if appeared and not rects:
            break
        time.sleep(0.004)
    return {"namespace": namespace, "samples": samples, "gone": appeared and not rects,
            "scene": {k: current.get(k) for k in SCENE_KEYS}}


def a11y(frames):
    for frame in frames:
        if not re.fullmatch(r"[A-Za-z][A-Za-z ]{0,23}", frame):
            raise ValueError("invalid frame name")
    argv = [sys.executable, SELF, "--a11y-dump", str(session_shell())]
    if frames:
        argv.append(",".join(frames))
    return {**json.loads(call_user(*argv, timeout=40)), "scene": scene()}


def ensure_user_dir(path):
    missing = []
    while not path.exists():
        missing.append(path)
        path = path.parent
    for directory in reversed(missing):
        directory.mkdir(mode=0o755)
        os.chown(directory, OWNER.pw_uid, OWNER.pw_gid)


def apps(action, key):
    """Desktop entries for the app grid, in the session user's own data
    directory as the nested proof writes them: PAGE_APPS plain apps that
    make the grid page, and one whose Exec starts the launched fixture."""
    pages = [APPS_DIR / f"tuna-vm-gates-{key}-page-{n:02d}.desktop" for n in range(1, PAGE_APPS + 1)]
    launch = APPS_DIR / f"tuna-vm-gates-{key}-launch.desktop"
    if action == "start":
        ensure_user_dir(APPS_DIR)
        launch_name = f"Tuna VM Gates Zlaunch {key[:8]}"
        entries = {launch: (launch_name, f"{sys.executable} {SELF} --window launched {key}")}
        for n, path in enumerate(pages, 1):
            entries[path] = (f"Tuna VM Gates Page {n:02d}", "true")
        for path, (name, command) in entries.items():
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "w") as stream:
                stream.write(f"[Desktop Entry]\nType=Application\nName={name}\nExec={command}\nTerminal=false\n")
            os.chown(path, OWNER.pw_uid, OWNER.pw_gid)
        return {"launch_name": launch_name, "count": len(entries)}
    if action == "stop":
        removed = 0
        for path in (*pages, launch):
            if path.exists():
                path.unlink()
                removed += 1
        return {"removed": removed}
    raise ValueError("unknown apps action")


def private_lines(path):
    """A log the session user wrote, read by root only if it is theirs and private."""
    if not path.exists():
        return []
    info = path.lstat()
    if info.st_uid != OWNER.pw_uid or not path.is_file() or info.st_mode & 0o077:
        raise RuntimeError(f"{path.name} is not the session user's private file")
    return path.read_text().splitlines()


def output_lines(path):
    """A log this probe opened for a session process's stdout (root-owned)."""
    return path.read_text().splitlines() if path.exists() else []


def monitor_pids(key):
    return [pid for pid in user_pids(key)
            if b"--notify-monitor" in pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")]


def notify(action, key, *args):
    """libnotify's own notify-send as the session user, and the notification
    server's closed/action signals as a monitor on the session bus sees them."""
    log = RUNTIME / f"tuna-vm-gates-notify-{key}.jsonl"
    waiters = RUNTIME / f"tuna-vm-gates-notify-{key}.waiters"
    if action == "monitor-start":
        if log.exists():
            raise RuntimeError("notification monitor already exists")
        spawn_user(sys.executable, SELF, "--notify-monitor", key)
        wait_for(lambda: any('"ready"' in line for line in private_lines(log)), 30,
                 "the notification monitor never subscribed")
        return {"monitor": monitor_pids(key)}
    if action == "monitor-read":
        return {"events": [json.loads(line) for line in private_lines(log)]}
    if action == "send":
        title, body, urgency, *rest = args
        if not (TEXT.fullmatch(title) and TEXT.fullmatch(body) and urgency in ("low", "normal", "critical")):
            raise ValueError("invalid notification")
        argv = ["notify-send", "-a", "Tuna VM Gates", "-u", urgency, "-p"]
        if not rest:
            return {"id": int(call_user(*argv, title, body).splitlines()[0])}
        if not ACTION.fullmatch(rest[0]):
            raise ValueError("invalid notification action")
        # With an action, notify-send waits for the user to press it: keep it
        # running in its own process group, its stdout in a private log.
        output = RUNTIME / f"tuna-vm-gates-send-{key}-{time.time_ns()}.log"
        pid = spawn_user(*argv, "-w", "-A", rest[0], title, body, log=str(output))
        with waiters.open("a") as stream:
            stream.write(f"{pid} {output.name}\n")
        first = wait_for(lambda: next((line for line in output_lines(output) if line.isdigit()), None), 15,
                         "notify-send never printed the notification id")
        return {"id": int(first), "log": output.name}
    if action == "log":
        name = args[0]
        if not re.fullmatch(rf"tuna-vm-gates-send-{key}-[0-9]+\.log", name):
            raise ValueError("invalid log name")
        return {"lines": output_lines(RUNTIME / name)}
    if action == "stop":
        stopped = []
        for line in waiters.read_text().splitlines() if waiters.exists() else []:
            pid, name = line.split()
            try:
                os.killpg(int(pid), signal.SIGTERM)
                stopped.append(int(pid))
            except ProcessLookupError:
                pass
            (RUNTIME / name).unlink(missing_ok=True)
        waiters.unlink(missing_ok=True)
        stopped += terminate(monitor_pids(key), "notification monitor")
        log.unlink(missing_ok=True)
        return {"stopped": stopped}
    raise ValueError("unknown notify action")


def banners(action, value=None):
    """GNOME's show-banners key: false is Do Not Disturb."""
    if action == "set":
        if value not in ("true", "false"):
            raise ValueError("invalid show-banners value")
        call_user("gsettings", "set", "org.gnome.desktop.notifications", "show-banners", value)
    elif action != "get":
        raise ValueError("unknown banners action")
    return {"show-banners": call_user("gsettings", "get", "org.gnome.desktop.notifications", "show-banners")}


def user_pids(argument):
    """The session user's processes whose argv names this nonce's file."""
    rows = []
    for proc in pathlib.Path("/proc").iterdir():
        try:
            if proc.name.isdigit() and proc.stat().st_uid == OWNER.pw_uid \
                    and argument.encode() in (proc / "cmdline").read_bytes().split(b"\0"):
                rows.append(int(proc.name))
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
    return sorted(rows)


def terminate(pids, what):
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for pid in pids:
        wait_for(lambda pid=pid: not pathlib.Path(f"/proc/{pid}").exists(), 10, f"{what} did not exit")
    return pids


def stop(key):
    """Retire every fixture of this nonce, the tray stub, the notification
    monitor and waiters and the app-grid entries; confirm absence."""
    stopped = []
    for role, value in fixtures(key).items():
        if value["alive"]:
            stopped += terminate([value["pid"]], f"{role} fixture")
        state_path(role, key).unlink(missing_ok=True)
    tray_stopped = tray("stop", key)["stopped"]
    notify_stopped = notify("stop", key)["stopped"]
    apps_removed = apps("stop", key)["removed"]

    def remaining():
        return [w["id"] for w in scene()["windows"] or [] if f".n{key}." in (w.get("app_id") or "")]
    wait_for(lambda: not remaining(), 10, "fixture windows remain after their clients exited")
    return {"stopped": stopped, "tray_stopped": tray_stopped, "notify_stopped": notify_stopped,
            "apps_removed": apps_removed, "confirmed": True, "scene": scene()}


def main():
    if len(sys.argv) >= 4 and sys.argv[1] == "--window":
        window_fixture(sys.argv[2], nonce(sys.argv[3]), *sys.argv[4:5])
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--tray-observe":
        print(json.dumps(tray_observe()))
        return
    if len(sys.argv) in (3, 4) and sys.argv[1] == "--a11y-dump":
        print(json.dumps(a11y_dump()))
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--notify-monitor":
        notify_monitor(nonce(sys.argv[2]))
        return
    if os.geteuid() != 0 or OWNER.pw_uid == 0:
        raise RuntimeError("probe must be root and session owner must not be root")
    action, args = sys.argv[1], sys.argv[2:]
    if action == "gates-start":
        result = start(args[0], nonce(args[1]), *args[2:3])
    elif action == "gates-state":
        result = {"fixtures": fixtures(nonce(args[0])), "scene": scene()}
    elif action == "gates-watch":
        result = watch(nonce(args[0]), args[1], int(args[2]), float(args[3]))
    elif action == "gates-settings":
        result = settings(*args)
    elif action.startswith("gates-tray-"):
        result = tray(action.removeprefix("gates-tray-"), nonce(args[0]))
    elif action == "gates-a11y":
        result = a11y(args)
    elif action == "gates-watch-layer":
        result = watch_layer(args[0], float(args[1]))
    elif action == "gates-apps":
        result = apps(args[0], nonce(args[1]))
    elif action == "gates-notify":
        result = notify(args[0], nonce(args[1]), *args[2:])
    elif action == "gates-banners":
        result = banners(*args)
    elif action == "gates-stop":
        result = stop(nonce(args[0]))
    else:
        raise ValueError("unknown desktop-gates action")
    print(json.dumps(result))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:  # one bounded line for the lane's record, no traceback
        print(json.dumps({"gates_error": f"{type(error).__name__}: {error}"[:600]}))
