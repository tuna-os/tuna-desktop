def bounded(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if metadata.st_uid != 0 or not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f'unsafe observer file: {path}')
        raw = stream.read(limit + 1)
    if len(raw) > limit:
        raise RuntimeError(f'observer file exceeds bound: {path}')
    return raw


def save(path, value):
    with path.open('x') as stream:
        os.chmod(path, 0o600)
        json.dump(value, stream, indent=2)


def save_atomic(path, value):
    """Publish a complete supervisor receipt, never a visible partial JSON."""
    pending = path.with_name(path.name + '.pending')
    fd = os.open(pending, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, indent=2)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(pending, path, follow_symlinks=False)
    finally:
        pending.unlink()


def read_json(path):
    return json.loads(bounded(path, 2 * 1024 * 1024))




class Btf:
    """Read native little-endian BTF and split module BTF with its live base."""
    PAYLOAD = {1: (4, 0), 2: (0, 0), 3: (12, 0), 4: (0, 12),
               5: (0, 12), 6: (0, 8), 7: (0, 0), 8: (0, 0),
               9: (0, 0), 10: (0, 0), 11: (0, 0), 12: (0, 0),
               13: (0, 8), 14: (4, 0), 15: (0, 12), 16: (0, 0),
               17: (4, 0), 18: (0, 0), 19: (0, 12)}

    def __init__(self, raw, base=None):
        if len(raw) < 24:
            raise ValueError('short BTF header')
        magic, version, flags, length, type_off, type_len, str_off, str_len = struct.unpack_from('<HBBIIIII', raw)
        if magic != 0xeb9f or version != 1 or flags != 0 or length < 24:
            raise ValueError('unsupported BTF header')
        for offset, size in ((type_off, type_len), (str_off, str_len)):
            if length + offset + size > len(raw):
                raise ValueError('BTF section outside source')
        if type_off + type_len > str_off:
            raise ValueError('overlapping BTF sections')
        strings = raw[length + str_off:length + str_off + str_len]
        if not strings or strings[-1] != 0 or (base is None and strings[0] != 0):
            raise ValueError('invalid BTF strings')
        self.strings = (base.strings if base else b'') + strings
        self.types = dict(base.types) if base else {}
        self.local_ids = []
        index = max(self.types, default=0) + 1
        cursor, end = length + type_off, length + type_off + type_len
        while cursor < end:
            if cursor + 12 > end:
                raise ValueError('short BTF type')
            name_off, info, size_type = struct.unpack_from('<III', raw, cursor)
            kind, count, flag = (info >> 24) & 31, info & 65535, bool(info >> 31)
            if kind not in self.PAYLOAD or info & 0x60ff0000:
                raise ValueError('unsupported BTF type encoding')
            fixed, per = self.PAYLOAD[kind]
            payload_size = fixed + per * count
            if cursor + 12 + payload_size > end:
                raise ValueError('short BTF payload')
            payload = raw[cursor + 12:cursor + 12 + payload_size]
            self.types[index] = {'name': self.string(name_off), 'kind': kind,
                                 'vlen': count, 'flag': flag, 'size_type': size_type,
                                 'payload': payload}
            self.local_ids.append(index)
            index += 1
            cursor += 12 + payload_size
        if cursor != end:
            raise ValueError('BTF trailing type data')

    def string(self, offset):
        if offset >= len(self.strings):
            raise ValueError('BTF name outside strings')
        stop = self.strings.find(b'\0', offset)
        if stop < 0 or stop - offset > 1024:
            raise ValueError('invalid BTF name')
        return self.strings[offset:stop].decode('ascii')

    def unwrap(self, index):
        visited = set()
        while index:
            if index in visited or index not in self.types:
                raise ValueError('invalid recursive BTF type')
            visited.add(index)
            item = self.types[index]
            if item['kind'] not in (8, 9, 10, 11, 18):
                return index
            index = item['size_type']
        return 0

    def named(self, name, kind):
        ids = [index for index, item in self.types.items()
               if item['name'] == name and item['kind'] == kind]
        if len(ids) != 1:
            raise ValueError(f'BTF type is not unique: {name}')
        return ids[0]

    def member(self, index, name):
        item = self.types[self.unwrap(index)]
        if item['kind'] not in (4, 5):
            raise ValueError('BTF member parent is not struct/union')
        found = []
        for pos in range(item['vlen']):
            name_off, type_id, offset = struct.unpack_from('<III', item['payload'], pos * 12)
            if self.string(name_off) != name:
                continue
            bits = offset >> 24 if item['flag'] else 0
            offset = offset & 0xffffff if item['flag'] else offset
            if bits or offset % 8:
                raise ValueError('bitfield cannot be used as a pointer probe field')
            found.append((offset // 8, type_id))
        if len(found) != 1:
            raise ValueError(f'BTF member is not unique: {name}')
        return found[0]

    def offset(self, struct_name, *members):
        index, offset = self.named(struct_name, 4), 0
        for member in members:
            extra, index = self.member(index, member)
            offset += extra
        final = self.types[self.unwrap(index)]
        if final['kind'] == 2:
            size = 8
        elif final['kind'] in (1, 4, 5, 6, 16, 19):
            size = final['size_type']
        else:
            raise ValueError('unsupported final BTF member type')
        if offset + size > self.types[self.named(struct_name, 4)]['size_type']:
            raise ValueError('BTF field exceeds containing struct')
        return offset, size

    def signature(self, name, argument_structs, return_kind):
        function = self.types[self.named(name, 12)]
        proto = self.types[self.unwrap(function['size_type'])]
        if proto['kind'] != 13 or proto['vlen'] != len(argument_structs):
            raise ValueError(f'BTF function arity differs: {name}')
        returned = self.unwrap(proto['size_type'])
        if return_kind == 'void':
            if returned != 0:
                raise ValueError(f'BTF function return differs: {name}')
        elif returned == 0 or self.types[returned]['kind'] != 1 or self.types[returned]['size_type'] != 8:
            raise ValueError(f'BTF return is not a 64-bit scalar: {name}')
        for number, expected in enumerate(argument_structs):
            _, index = struct.unpack_from('<II', proto['payload'], number * 8)
            item = self.types[self.unwrap(index)]
            if expected == 'scalar64':
                if item['kind'] != 1 or item['size_type'] != 8:
                    raise ValueError(f'BTF argument is not 64-bit scalar: {name}')
            else:
                if item['kind'] != 2:
                    raise ValueError(f'BTF argument is not pointer: {name}')
                pointed = self.types[self.unwrap(item['size_type'])]
                if expected == 'scalar64ptr':
                    valid = pointed['kind'] == 1 and pointed['size_type'] == 8
                else:
                    valid = pointed['kind'] == 4 and pointed['name'] == expected
                if not valid:
                    raise ValueError(f'BTF argument target differs: {name}')


def build_layout(base, drm, virtio, drm_module=True):
    offsets = {}
    def field(owner, typename, path, size):
        offset, actual = owner.offset(typename, *path.split('.'))
        if actual != size:
            raise ValueError(f'BTF field size differs: {typename}.{path}')
        offsets[f'{typename}.{path}'] = {'offset': offset, 'bytes': actual}
        return offset
    crtc_id = field(drm, 'drm_crtc', 'base.id', 4)
    index = field(drm, 'drm_crtc', 'index', 4)
    dev = field(drm, 'drm_crtc', 'dev', 8)
    primary = field(drm, 'drm_device', 'primary', 8)
    minor_index = field(drm, 'drm_minor', 'index', 4)
    sequence = field(drm, 'drm_pending_vblank_event', 'sequence', 8)
    pipe = field(drm, 'drm_pending_vblank_event', 'pipe', 4)
    userdata = field(drm, 'drm_pending_vblank_event', 'event.vbl.user_data', 8)
    file = field(drm, 'drm_pending_vblank_event', 'base.file_priv', 8)
    timer_offset = field(drm, 'drm_vblank_crtc_timer', 'timer', base.types[base.named('hrtimer', 4)]['size_type'])
    interval = field(drm, 'drm_vblank_crtc_timer', 'interval', 8) - timer_offset
    timer_crtc = field(drm, 'drm_vblank_crtc_timer', 'crtc', 8) - timer_offset
    expires = field(base, 'hrtimer', 'node.expires', 8)
    drm.signature('drm_crtc_arm_vblank_event', ['drm_crtc', 'drm_pending_vblank_event'], 'void')
    drm.signature('drm_crtc_accurate_vblank_count', ['drm_crtc'], 'scalar64')
    drm.signature('drm_crtc_vblank_get_vblank_timeout', ['drm_crtc', 'scalar64ptr'], 'void')
    drm.signature('send_vblank_event', ['drm_device', 'drm_pending_vblank_event', 'scalar64', 'scalar64'], 'void')
    virtio.signature('virtio_gpu_crtc_atomic_flush', ['drm_crtc', 'drm_atomic_commit'], 'void')
    # Timer callback returns an enum. Its pointer argument is checked separately.
    timer_function = drm.types[drm.named('drm_vblank_timer_function', 12)]
    timer_proto = drm.types[drm.unwrap(timer_function['size_type'])]
    if timer_proto['kind'] != 13 or timer_proto['vlen'] != 1:
        raise ValueError('BTF timer callback signature differs')
    _, timer_arg = struct.unpack_from('<II', timer_proto['payload'])
    arg = drm.types[drm.unwrap(timer_arg)]
    if arg['kind'] != 2 or drm.types[drm.unwrap(arg['size_type'])]['name'] != 'hrtimer':
        raise ValueError('BTF timer callback argument differs')
    returned = drm.types[drm.unwrap(timer_proto['size_type'])]
    if returned['kind'] not in (1, 6) or returned['size_type'] != 4:
        raise ValueError('BTF timer callback return differs')
    functions = ('virtio_gpu_crtc_atomic_flush', 'drm_crtc_arm_vblank_event',
                 'drm_crtc_arm_vblank_event', 'drm_crtc_accurate_vblank_count',
                 'drm_crtc_accurate_vblank_count', 'drm_crtc_vblank_get_vblank_timeout',
                 'drm_crtc_vblank_get_vblank_timeout', 'drm_vblank_timer_function',
                 'drm_vblank_timer_function', 'send_vblank_event')
    return {
        'offsets': offsets,
        'values': [crtc_id, index, dev, primary, minor_index, sequence, pipe,
                   userdata, file, timer_offset, interval, timer_crtc, expires],
        'functions': [{'event': number, 'name': EVENT_NAMES[number],
                       'symbol': symbol,
                       'attach_owner': 'virtio_gpu' if number == 0 else 'drm' if drm_module else 'vmlinux',
                       'attach_btf_id': (virtio if number == 0 else drm).named(symbol, 12)}
                      for number, symbol in enumerate(functions)],
    }


def write(path, value):
    with path.open('w') as stream:
        stream.write(value + '\n')


def cpu_inventory(path, maximum):
    raw = bounded(path, 4096).decode().strip()
    if not re.fullmatch(r'[0-9]+(?:-[0-9]+)?(?:,[0-9]+(?:-[0-9]+)?)*', raw):
        raise ValueError('actual CPU inventory is malformed')
    result = []
    for part in raw.split(','):
        ends = [int(value) for value in part.split('-')]
        first, last = ends[0], ends[-1]
        if (last < first or last >= 65536 or last - first + 1 + len(result) > maximum
                or result and first <= result[-1]):
            raise ValueError('actual CPU inventory exceeds bound')
        result.extend(range(first, last + 1))
    return result


def online_cpu_ids():
    return cpu_inventory(Path('/sys/devices/system/cpu/online'), 8)


def bpf_records(raw, cpu_ids):
    """Decode only actual fixed-schema bytes; no replacement or inferred event."""
    if (not isinstance(cpu_ids, list) or not 1 <= len(cpu_ids) <= 8
            or any(type(cpu) is not int or not 0 <= cpu < 65536 for cpu in cpu_ids)
            or cpu_ids != sorted(set(cpu_ids))):
        raise ValueError('actual online CPU inventory differs')
    if not raw or len(raw) % BPF_RECORD.size:
        raise ValueError('actual BPF record extent is missing or incomplete')
    records = []
    previous = {}
    for row in BPF_RECORD.iter_unpack(raw):
        monotonic_ns, sequence, event, cpu, pid_tgid = row[:5]
        values, mask, faults, reserved = row[5:25], row[25], row[26], row[27]
        if event >= len(EVENT_NAMES) or cpu not in cpu_ids or not monotonic_ns or not sequence or reserved:
            raise ValueError('actual BPF record header differs')
        expected = sum(1 << FIELD_NAMES.index(key) for key in EVENT_FIELDS[event])
        if mask != expected or faults:
            raise ValueError('actual BPF field is missing or faulted: ' + EVENT_NAMES[event])
        fields = {}
        for number, key in enumerate(FIELD_NAMES):
            value = values[number]
            if not mask & (1 << number):
                if value:
                    raise ValueError('actual BPF record has an unexpected field')
                continue
            if key in SIGNED_FIELDS and value & (1 << 63):
                value -= 1 << 64
            fields[key] = value
        name = EVENT_NAMES[event]
        for key in ('crtc', 'dev', 'object', 'event', 'file', 'commit', 'timer',
                    'output', 'expires', 'timestamp', 'value', 'target'):
            if key in fields and fields[key] <= 0:
                raise ValueError('invalid actual pointer/time probe field: ' + name + '.' + key)
        for key in ('pipe', 'event_pipe', 'minor'):
            if key in fields and not 0 <= fields[key] < 32:
                raise ValueError('invalid actual device/index probe field')
        if 'restart' in fields and fields['restart'] not in (0, 1):
            raise ValueError('invalid timer callback return value')
        if 'interval' in fields and fields['interval'] < 0:
            raise ValueError('invalid observed timer interval')
        key = (cpu, event)
        if key in previous:
            old_sequence, old_time = previous[key]
            if sequence != old_sequence + 1 or monotonic_ns < old_time:
                raise ValueError('actual BPF per-CPU sequence is lost or reordered')
        previous[key] = (sequence, monotonic_ns)
        records.append({'event': name, 'cpu': cpu, 'pid_tgid': pid_tgid,
                        'monotonic_ns': monotonic_ns, 'sequence': sequence, 'fields': fields})
    return records


def record_counts(records):
    counts = dict.fromkeys(EVENT_NAMES, 0)
    for row in records:
        counts[row['event']] += 1
    return counts


def timer_mappings(records, expected=None):
    mappings = {}
    crtcs = {}
    for record in records:
        fields = record['fields']
        if expected is not None:
            if 'crtc' in fields and not any(all(fields.get(key) == identity[key] for key in CRTC_FIELDS) for identity in expected.values()):
                raise ValueError('measurement CRTC escaped discovered timer inventory')
            if 'event_pipe' in fields and not any(all(fields.get(key) == identity[target] for key, target in [('dev', 'dev'), ('minor', 'minor'), ('event_pipe', 'pipe')]) for identity in expected.values()):
                raise ValueError('measurement event escaped discovered timer inventory')
        if record['event'] not in ('timer', 'timer_return'):
            continue
        required = {'timer', 'crtc', 'object', 'pipe', 'dev', 'minor'}
        if not required <= fields.keys():
            raise ValueError('actual timer identity fields are missing')
        identity = {key: fields[key] for key in required}
        if any(identity[key] <= 0 for key in ('timer', 'crtc', 'object', 'dev')) or not all(0 <= identity[key] < 32 for key in ('pipe', 'minor')):
            raise ValueError('invalid actual timer identity')
        timer = str(identity['timer'])
        crtc = str(identity['crtc'])
        if timer in mappings and mappings[timer] != identity or crtc in crtcs and crtcs[crtc] != timer:
            raise ValueError('inconsistent actual timer/CRTC mapping')
        mappings[timer] = identity
        crtcs[crtc] = timer
        if len(mappings) > 8:
            raise ValueError('actual timer inventory exceeds bound')
        if expected is not None and expected.get(timer) != identity:
            raise ValueError('measurement timer escaped discovered kernel filter identity')
    if not mappings:
        raise ValueError('no actual timer identity was observed')
    return mappings


def timer_filter(timer_inventory, actual_format):
    if not re.search(r'field:void \* hrtimer;\s*offset:[0-9]+;\s*size:8;\s*signed:0;', actual_format):
        raise ValueError('actual hrtimer filter field differs')
    if not 1 <= len(timer_inventory) <= 8:
        raise ValueError('actual timer filter inventory exceeds bound')
    return ' || '.join('hrtimer == ' + hex(int(timer)) for timer in sorted(timer_inventory, key=int))


BUFFER_DATA_PAGE_BOUND = 2 * 1024 * 1024


def buffer_allocation(header_page, subbuffer_kb, page_bytes, bound_bytes=BUFFER_DATA_PAGE_BOUND):
    """Account for Linux ring payload rounding and its separate reader page."""
    if not isinstance(page_bytes, int) or page_bytes < 4096 or page_bytes & (page_bytes - 1):
        raise ValueError('actual kernel page size is invalid')
    if type(bound_bytes) is not int or not 0 < bound_bytes <= BUFFER_DATA_PAGE_BOUND or bound_bytes % page_bytes:
        raise ValueError('actual native ring budget is invalid')
    if not re.fullmatch(r'[1-9][0-9]*', subbuffer_kb):
        raise ValueError('actual trace subbuffer size is invalid')
    subbuffer_bytes = int(subbuffer_kb) * 1024
    if (subbuffer_bytes < page_bytes or subbuffer_bytes > bound_bytes
            or subbuffer_bytes & (subbuffer_bytes - 1) or subbuffer_bytes % page_bytes):
        raise ValueError('actual trace subbuffer/page layout is inconsistent')
    data = re.findall(r'field:\s*char data;\s*offset:([0-9]+);\s*size:([0-9]+);\s*signed:[01];', header_page)
    if len(data) != 1:
        raise ValueError('actual trace data page format is missing or ambiguous')
    header_bytes, payload_bytes = map(int, data[0])
    if header_bytes <= 0 or payload_bytes <= 0 or header_bytes + payload_bytes != subbuffer_bytes:
        raise ValueError('actual trace header/data extent differs from subbuffer size')
    # ring_buffer_resize rounds requested bytes UP by the reported payload.
    # rb_allocate_cpu_buffer allocates one additional reader data page.
    max_ring_pages = bound_bytes // subbuffer_bytes - 1
    request_kb = max_ring_pages * payload_bytes // 1024
    ring_pages = (request_kb * 1024 + payload_bytes - 1) // payload_bytes
    if request_kb < 1 or ring_pages < 2 or (ring_pages + 1) * subbuffer_bytes > bound_bytes:
        raise ValueError('actual trace layout cannot fit ring and reader within fixed bound')
    return {'page_bytes': page_bytes, 'subbuffer_kb': subbuffer_kb,
            'subbuffer_bytes': subbuffer_bytes, 'header_page': header_page,
            'header_bytes': header_bytes, 'payload_bytes_per_subbuffer': payload_bytes,
            'requested_kb': request_kb, 'ring_pages': ring_pages, 'reader_pages': 1,
            'event_payload_bytes_per_cpu': ring_pages * payload_bytes,
            'expected_readback_kb': str(ring_pages * payload_bytes // 1024),
            'data_page_bytes_per_cpu': (ring_pages + 1) * subbuffer_bytes,
            'bound_bytes_per_cpu': bound_bytes,
            'limitation': 'Bound covers ring and reader data pages, not allocator metadata or total kernel heap.'}


def buffer_budget(base, cpus, page_bytes):
    """Charge shared BPF pages once and both private tracefs instances."""
    if type(cpus) is not int or not 1 <= cpus <= 8 or page_bytes < 4096 or page_bytes & (page_bytes - 1):
        raise ValueError('actual observer CPU/page inventory exceeds bound')
    ring = base.named('bpf_ringbuf', 4)
    consumer, _ = base.member(ring, 'consumer_pos')
    producer, _ = base.member(ring, 'producer_pos')
    data, _ = base.member(ring, 'data')
    if (consumer <= 0 or consumer % page_bytes or producer != consumer + page_bytes
            or data != consumer + 2 * page_bytes or BPF_RING_BYTES % page_bytes):
        raise ValueError('actual BPF ring data/control page layout differs')
    map_bytes = base.types[base.named('bpf_ringbuf_map', 4)]['size_type']
    if not 0 < map_bytes <= page_bytes:
        raise ValueError('actual BPF ring map header exceeds charged page')
    pointer_array = (data // page_bytes + 2 * BPF_RING_BYTES // page_bytes) * 8
    pointer_array_bound = max(page_bytes, 1 << (pointer_array - 1).bit_length())
    shared = BPF_RING_BYTES + data + pointer_array_bound + page_bytes
    # A fresh inactive snapshot has two data pages plus its reader. The
    # separate cleanup barrier has the same minimum main ring AND snapshot.
    snapshot = 3 * page_bytes
    barrier = 6 * page_bytes
    total = BUFFER_DATA_PAGE_BOUND * cpus
    native_per_cpu = ((total - shared - cpus * (snapshot + barrier)) // cpus // page_bytes) * page_bytes
    if native_per_cpu < 3 * page_bytes:
        raise ValueError('shared BPF and private trace rings cannot fit original total bound')
    return {'total_bound_bytes': total, 'actual_cpus': cpus, 'page_bytes': page_bytes,
            'bpf_ring_data_bytes': BPF_RING_BYTES, 'bpf_control_prefix_bytes': data,
            'bpf_pointer_array_requested_bytes': pointer_array,
            'bpf_pointer_array_allocation_bound_bytes': pointer_array_bound,
            'bpf_ring_map_header_btf_bytes': map_bytes,
            'bpf_ring_map_header_allocation_bound_bytes': page_bytes,
            'bpf_ring_allocation_bytes': shared,
            'native_inactive_snapshot_bytes_per_cpu': snapshot,
            'barrier_ring_reader_snapshot_bytes_per_cpu': barrier,
            'native_bound_bytes_per_cpu': native_per_cpu,
            'maximum_accounted_ring_bytes': shared + cpus * (native_per_cpu + snapshot + barrier),
            'limitation': 'Counts physical ring/reader/control pages plus conservative BPF pointer-array/map-header charges. Excludes generic allocator/page-table metadata, other BPF programs/maps and userspace virtual aliases; not total kernel heap.'}


def snapshot_inventory(instance):
    raw = bounded(instance / 'snapshot', 65536)
    text = raw.decode('utf-8', errors='strict')
    if text.count('# * Snapshot is freed *') != 1 or '# * Snapshot is allocated *' in text:
        raise ValueError('fresh private inactive snapshot is not at its source-defined minimum')
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest(), 'text': text,
            'minimum_ring_reader_pages_per_cpu': 3,
            'allocation_source': KERNEL_SOURCE.replace('/tree/', '/blob/') + '/kernel/trace/trace_snapshot.c'}


def actual_buffer_layout(instance, native_bound):
    return buffer_allocation(bounded(instance / 'events/header_page', 16384).decode(),
                             bounded(instance / 'buffer_subbuf_size_kb', 4096).decode().strip(),
                             os.sysconf('SC_PAGE_SIZE'), native_bound)


def buffer_readbacks(instance, possible_cpus, expected):
    # tracefs creates per_cpu files for possible CPUs, even when offline.
    # Its all-CPU resize propagates the actual CPU0 ring payload readback.
    paths = sorted((instance / 'per_cpu').glob('cpu[0-9]*'))
    if len(paths) != possible_cpus:
        raise RuntimeError('actual per-CPU buffer sizes are incomplete')
    values = {'all': bounded(instance / 'buffer_size_kb', 4096).decode().strip()}
    values.update({cpu.name: bounded(cpu / 'buffer_size_kb', 4096).decode().strip() for cpu in paths})
    if any(value != expected for value in values.values()):
        raise RuntimeError('actual per-CPU buffer readback differs from exact bounded allocation: ' + json.dumps(values))
    return values


def cpu_stats(instance, possible_cpus):
    stats = {}
    for cpu in sorted((instance / 'per_cpu').glob('cpu[0-9]*')):
        values = {}
        for line in bounded(cpu / 'stats', 65536).decode().splitlines():
            if ':' in line:
                key, value = (part.strip() for part in line.split(':', 1))
                values[key] = value
        stats[cpu.name] = values
    if len(stats) != possible_cpus:
        raise RuntimeError('actual per-CPU trace statistics are incomplete')
    return stats


def retain_raw(path, raw):
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}


def fingerprint(path, limit):
    raw = bounded(path, limit)
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}


def process_identity(pid):
    try:
        raw = bounded(Path('/proc') / str(pid) / 'stat', 16384).decode()
    except FileNotFoundError:
        return None
    fields = raw[raw.rfind(')') + 2:].split()
    if len(fields) < 20:
        raise RuntimeError('native BPF process identity is incomplete')
    if fields[0] == 'Z':
        return None
    try:
        executable = (Path('/proc') / str(pid) / 'exe').stat()
    except FileNotFoundError:
        return None
    return {'start_ticks': int(fields[19]), 'executable_device': executable.st_dev,
            'executable_inode': executable.st_ino}


def stop_native(marker):
    # Publish cancellation before checking the process receipt. The supervisor
    # checks it after publishing that receipt, closing the launch/cleanup race.
    try:
        retain_raw(ROOT / 'native-cancel', b'cancel\n')
    except FileExistsError:
        pass
    if not marker.get('native_pid') and (ROOT / 'native-process.json').exists():
        process = read_json(ROOT / 'native-process.json')
        if process.get('group') != marker['group']:
            raise RuntimeError('native BPF supervisor process belongs to another acquisition')
        marker['native_pid'] = process['pid']
        marker['native_process_identity'] = process['identity']
    if not marker.get('native_pid'):
        return None
    pid = marker['native_pid']
    if not (ROOT / 'native-exit.json').exists():
        actual = process_identity(pid)
        if actual is not None:
            if actual != marker['native_process_identity']:
                raise RuntimeError('native BPF process ownership changed; refusing unrelated signal')
            os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 5
    while not (ROOT / 'native-exit.json').exists():
        actual = process_identity(pid)
        if actual is not None and actual != marker['native_process_identity']:
            raise RuntimeError('native BPF PID identity changed while stopping')
        if time.monotonic() >= deadline:
            raise RuntimeError('native BPF collector lacks physically observed terminal status')
        time.sleep(.02)
    terminal = read_json(ROOT / 'native-exit.json')
    if (terminal.get('schema') != 1 or terminal.get('group') != marker['group']
            or terminal.get('pid') != pid or terminal.get('terminal_observed') is not True
            or type(terminal.get('exitcode')) is not int):
        raise RuntimeError('native BPF child exit status is not original or physically observed')
    marker['native_exit'] = terminal
    marker['native_terminal_observed'] = True
    if not (ROOT / 'bpf-result.json').exists():
        raise RuntimeError('native BPF collector exited without whole result receipt')
    return read_json(ROOT / 'bpf-result.json')


def program_inventory(programs, layout):
    if not isinstance(programs, list) or len(programs) != len(EVENT_NAMES):
        raise ValueError('actual BPF program inventory is incomplete')
    ids = set()
    for number, (program, expected) in enumerate(zip(programs, layout['functions'])):
        if not isinstance(program, dict):
            raise ValueError('actual BPF program inventory is malformed')
        if (program.get('event') != number or program.get('name') != EVENT_NAMES[number]
                or program.get('attach_owner') != expected['attach_owner']
                or program.get('attach_btf_id') != expected['attach_btf_id']):
            raise ValueError('actual BPF attachment differs from validated live BTF')
        for key in ('id', 'attach_btf_obj_id', 'attach_btf_id'):
            if type(program.get(key)) is not int or program[key] <= 0:
                raise ValueError('actual BPF attachment identity is missing')
        if program['id'] in ids:
            raise ValueError('actual BPF program identity is duplicated')
        ids.add(program['id'])
        for key in ('run_cnt', 'run_time_ns', 'recursion_misses'):
            if type(program.get(key)) is not int or not 0 <= program[key] < 1 << 64:
                raise ValueError('actual BPF readable runtime statistics are missing')
        if program['recursion_misses']:
            raise ValueError('actual BPF program missed recursive invocations')
    return programs


def native_qualification(native, marker, records, raw_bytes):
    if not isinstance(native, dict) or type(native.get('schema')) is not int or native['schema'] != BPF_SCHEMA:
        raise ValueError('native BPF receipt schema is unsupported')
    terminal = marker.get('native_exit')
    if (native.get('qualified_acquisition') is not True or native.get('errors') != []
            or native.get('cleanup_errors') != [] or not isinstance(terminal, dict)
            or type(terminal.get('exitcode')) is not int or terminal.get('exitcode') != 0):
        raise ValueError('native BPF collector reports loss, unsupported counters or cleanup/exit failure')
    possible = native.get('possible_cpu_count')
    if (native.get('online_cpu_ids') != marker['online_cpu_ids']
            or type(possible) is not int or not len(marker['online_cpu_ids']) <= possible <= 65536
            or possible != marker['native_ready']['possible_cpu_count']):
        raise ValueError('actual BPF online/possible CPU inventory changed')
    before = program_inventory(native.get('programs_before'), marker['layout'])
    after = program_inventory(native.get('programs_after'), marker['layout'])
    if before != marker['native_ready']['programs_before']:
        raise ValueError('actual BPF initial program identities/counters changed')
    counts = record_counts(records)
    for initial, final in zip(before, after):
        for key in ('event', 'name', 'id', 'attach_btf_obj_id', 'attach_btf_id', 'attach_owner'):
            if initial[key] != final[key]:
                raise ValueError('actual BPF program/source identity changed')
        if final['run_cnt'] < initial['run_cnt'] or final['run_time_ns'] < initial['run_time_ns']:
            raise ValueError('actual BPF runtime counters regressed')
        for key in ('calls', 'disabled', 'emitted', 'reserve_failed', 'read_failed', 'retained_records'):
            if type(final.get(key)) is not int or not 0 <= final[key] < 1 << 64:
                raise ValueError('actual BPF loss/record accounting is incomplete')
        if (final['calls'] != final['run_cnt']
                or final['calls'] != final['disabled'] + final['emitted'] + final['reserve_failed']
                or final['emitted'] != final['retained_records']
                or final['emitted'] != counts[final['name']]
                or final['reserve_failed'] or final['read_failed']):
            raise ValueError('actual BPF run/call/emission/whole-byte counts do not reconcile')
    if native.get('raw', {}).get('bytes') != raw_bytes:
        raise ValueError('actual BPF retained byte extent differs from native receipt')
    clocks = [native.get(key) for key in ('capture_enable_begin_monotonic_ns',
              'capture_started_monotonic_ns', 'capture_stop_begin_monotonic_ns',
              'capture_stopped_monotonic_ns', 'quiescence_begin_monotonic_ns',
              'quiescence_end_monotonic_ns', 'detached_monotonic_ns')]
    if not all(type(value) is int and value > 0 for value in clocks) or clocks != sorted(clocks):
        raise ValueError('actual BPF control/detachment boundaries are incomplete or regressed')
    if (native.get('quiescence_backend') != 'tracefs-function-ops-tasks-rcu-v1'
            or native.get('quiescence_completed') is not True):
        raise ValueError('actual native BPF Tasks-RCU quiescence is unsupported or incomplete')
    registration = []
    for stage in ('before', 'active', 'after'):
        proof = native.get('quiescence_registration_' + stage)
        if (not isinstance(proof, dict) or type(proof.get('count')) is not int
                or not 0 <= proof['count'] < 1 << 32 or 'raw_line' not in proof):
            raise ValueError('actual Tasks-RCU registration evidence is missing')
        line = proof.get('raw_line')
        if (proof['count'] == 0 and line is not None) or (proof['count'] and (
                not isinstance(line, str) or len(line) >= 1024
                or not re.match(r'drm_crtc_arm_vblank_event(?: \[drm\])? \('
                                + str(proof['count']) + r'\)', line))):
            raise ValueError('actual Tasks-RCU registration line differs from count')
        registration.append(proof['count'])
    if registration[1] != registration[0] + 1 or registration[2] != registration[0]:
        raise ValueError('actual dynamic function tracer registration did not complete')
    if any(not clocks[0] <= row['monotonic_ns'] <= clocks[-1] for row in records):
        raise ValueError('actual BPF record escaped physical acquisition boundaries')
    return counts


def native_timer_reconciliation(raw, records, marker, native, stop_begin_ns):
    """Count actual calls in the definite common window, not hashed pointers."""
    begin = max(marker['filters_ready_monotonic_ns'], native['capture_started_monotonic_ns'])
    end = min(stop_begin_ns, native['capture_stop_begin_monotonic_ns'])
    if begin >= end:
        raise ValueError('native and BPF observers have no definite shared active window')
    sources, by_cpu = [], {}
    for line in raw.decode('utf-8', errors='strict').splitlines():
        matched = re.search(r'\[([0-9]+)\].*?\s([0-9]+)\.([0-9]{6,9}): hrtimer_expire_entry:', line)
        if not matched:
            continue
        if not re.search(r'\bfunction=drm_vblank_timer_function(?:\s|$)', line):
            raise ValueError('native callback filter admitted another function')
        cpu = int(matched[1])
        precision = 10 ** (9 - len(matched[3]))
        low = int(matched[2]) * 1_000_000_000 + int(matched[3]) * precision
        source = {'cpu': cpu, 'lower_ns': low, 'upper_ns': low + precision, 'matches': 0}
        if cpu not in marker['online_cpu_ids']:
            raise ValueError('native callback CPU escaped actual inventory')
        by_cpu.setdefault(cpu, []).append(len(sources))
        sources.append(source)
    if not sources:
        raise ValueError('whole native trace lacks filtered actual timer callbacks')
    positions = dict.fromkeys(by_cpu, 0)
    active_entries = 0
    for row in sorted((row for row in records if row['event'] == 'timer'),
                      key=lambda row: row['monotonic_ns']):
        indexes = by_cpu.get(row['cpu'], [])
        position = positions.get(row['cpu'], 0)
        while position + 1 < len(indexes) and sources[indexes[position + 1]]['lower_ns'] <= row['monotonic_ns']:
            position += 1
        positions[row['cpu']] = position
        source = sources[indexes[position]] if indexes and sources[indexes[position]]['lower_ns'] <= row['monotonic_ns'] else None
        inside = begin <= row['monotonic_ns'] < end
        if source is not None and (inside or not source['matches']):
            source['matches'] += 1
        if inside:
            active_entries += 1
            if source is None:
                raise ValueError('actual BPF timer entry has no independent native source')
    active_sources = [source for source in sources if begin <= source['lower_ns'] and source['upper_ns'] <= end]
    if not active_sources or any(source['matches'] != 1 for source in active_sources):
        raise ValueError('actual native callback and BPF entry counts disagree')
    pending, boundary_returns = {}, []
    pairs = 0
    for row in sorted((row for row in records if row['event'] in ('timer', 'timer_return')),
                      key=lambda row: row['monotonic_ns']):
        key = (row['cpu'], row['fields']['timer'])
        if row['event'] == 'timer':
            if key in pending:
                raise ValueError('actual timer entry overlaps an unmatched same-CPU call')
            pending[key] = row
        else:
            entry = pending.pop(key, None)
            if entry is None:
                if begin <= row['monotonic_ns'] < end:
                    raise ValueError('actual active-window BPF timer return lacks its retained entry')
                boundary_returns.append({'cpu': row['cpu'], 'monotonic_ns': row['monotonic_ns'],
                                         'timer': row['fields']['timer']})
            elif begin <= entry['monotonic_ns'] < end:
                pairs += 1
    if any(begin <= row['monotonic_ns'] < end for row in pending.values()) or pairs != active_entries:
        raise ValueError('actual active-window timer entries/returns do not reconcile')
    return {'active_window_begin_ns': begin, 'active_window_end_ns': end,
            'native_callbacks_total': len(sources), 'native_callbacks_definitely_inside': len(active_sources),
            'bpf_timer_entries_inside': active_entries, 'complete_timer_pairs_inside': pairs,
            'boundary_native_callbacks': [source for source in sources if not begin <= source['lower_ns'] or source['upper_ns'] > end],
            'boundary_bpf_returns_without_entry': boundary_returns,
            'boundary_bpf_entries_without_return': [{'cpu': row['cpu'], 'monotonic_ns': row['monotonic_ns'],
                                                     'timer': row['fields']['timer']} for row in pending.values()],
            'limitation': 'All sources retained. Native text times are intervals. Boundary/transition records are explicit, never trimmed, synthesized or hash-to-pointer joined.'}


def function_pair_reconciliation(records, begin, end):
    """Require real returns for every entry in the definite common window."""
    pairs = {'arm': CRTC_FIELDS + PENDING_FIELDS,
             'accurate': CRTC_FIELDS,
             'timeout': CRTC_FIELDS + ('output',),
             'timer': CRTC_FIELDS + ('timer',)}
    pending = {}
    entries = dict.fromkeys(pairs, 0)
    complete = dict.fromkeys(pairs, 0)
    boundary = {'returns_without_entry': [], 'entries_without_return': [],
                'pairs_crossing_start': [], 'pairs_crossing_stop': []}

    def location(index, row):
        return {**{key: row[key] for key in ('event', 'cpu', 'pid_tgid', 'monotonic_ns', 'sequence')},
                'record_index': index}

    for index, row in sorted(enumerate(records), key=lambda item: (item[1]['monotonic_ns'], item[0])):
        name = row['event'].removesuffix('_return')
        if name not in pairs:
            continue
        # A task can migrate; its full pid/tgid is the causal key. Idle tasks
        # share pid0 across CPUs, so only those require a CPU-qualified key.
        task = ('task', row['pid_tgid']) if row['pid_tgid'] else ('idle', row['cpu'])
        stack = pending.setdefault((name, task), [])
        inside = begin <= row['monotonic_ns'] < end
        if row['event'] == name:
            stack.append((index, row))
            entries[name] += inside
            continue
        if not stack:
            if inside:
                raise ValueError('actual active-window function return lacks retained entry: ' + name)
            boundary['returns_without_entry'].append(location(index, row))
            continue
        first_index, first = stack.pop()
        if any(first['fields'][key] != row['fields'][key] for key in pairs[name]):
            raise ValueError('actual function arguments/nested identity changed across return: ' + name)
        first_inside = begin <= first['monotonic_ns'] < end
        if first_inside:
            complete[name] += 1
            if row['monotonic_ns'] >= end:
                boundary['pairs_crossing_stop'].append(
                    {'entry': location(first_index, first), 'return': location(index, row)})
        elif inside:
            boundary['pairs_crossing_start'].append(
                {'entry': location(first_index, first), 'return': location(index, row)})
    for stack in pending.values():
        for index, row in stack:
            if begin <= row['monotonic_ns'] < end:
                raise ValueError('actual active-window function entry lacks retained return: ' + row['event'])
            boundary['entries_without_return'].append(location(index, row))
    if entries != complete:
        raise ValueError('actual active-window function pairs do not reconcile')
    return {'active_window_begin_ns': begin, 'active_window_end_ns': end,
            'entries_inside': entries, 'complete_pairs_by_entry_inside': complete,
            'boundary': boundary,
            'limitation': 'Whole source records retained; no pending active entry is excused by stop/detach. Boundary records outside this common native/BPF window are explicit and are not claimed complete.'}


def cleanup(marker):
    instances = [(marker.get('instance_created'), TRACE / 'instances' / marker['group']),
                 (marker.get('barrier_instance_created'), TRACE / 'instances' / (marker['group'] + '_barrier'))]
    errors = []
    if marker.get('native_launched'):
        try:
            stop_native(marker)
        except Exception as error:
            errors.append(str(error)[:2048])
        if not marker.get('native_terminal_observed'):
            # A blocked barrier may hold trace_types_lock. Never hide it by
            # blocking again in tracefs rmdir or claiming physical retirement.
            errors.append('native process not terminal; private trace instances retained')
            return errors
    if instances[0][0] and instances[0][1].exists():
        for path in ('tracing_on', 'events/enable'):
            try:
                write(instances[0][1] / path, '0')
            except OSError as error:
                errors.append(str(error))
    for created, instance in instances:
        try:
            if created and instance.exists():
                instance.rmdir()
        except OSError as error:
            errors.append(str(error))
    return errors


@contextlib.contextmanager
def lock():
    fd = os.open('/run/tuna-kernel-trace.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        metadata = os.fstat(fd)
        if metadata.st_uid != 0 or metadata.st_mode & 0o077 or not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError('unsafe observer lock')
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('observer lifecycle lock deadline exceeded')
                time.sleep(.05)
        yield
    finally:
        os.close(fd)


def start():
    try:
        return start_observer()
    except BaseException as error:
        # Preflight BTF/ABI failures also produce an honest diagnostic artifact.
        # Existing result/active sessions remain owned by their original marker.
        if ROOT.exists() and not (ROOT / 'result.json').exists() and not (ROOT / 'marker.json').exists():
            metadata = ROOT.stat()
            if metadata.st_uid == 0 and not metadata.st_mode & 0o077 and not ROOT.is_symlink():
                preflight = {}
                for name in ('inventory', 'kernel', 'vmlinux', 'virtio_gpu', 'drm'):
                    path = ROOT / ('preflight-' + name + '.json')
                    if path.exists():
                        preflight[name] = read_json(path)
                save(ROOT / 'result.json', {'preflight': preflight, 'group': 'tuna_vblank_' + os.urandom(8).hex(),
                     'qualified_acquisition': False, 'stage': 'preflight',
                     'errors': [str(error)[:2048]], 'diagnostic_only': True})
        raise


def start_observer():
    if ROOT.exists():
        previous = read_json(ROOT / 'result.json')
        group = previous['group']
        if not re.fullmatch(r'tuna_vblank_[0-9a-f]{16}', group):
            raise RuntimeError('invalid completed observer identity')
        terminal = previous.get('native_exit')
        if previous.get('native_launched') and (
                not isinstance(terminal, dict) or terminal.get('terminal_observed') is not True):
            raise RuntimeError('previous acquisition lacks physical native retirement evidence')
        if any((TRACE / 'instances' / name).exists() for name in (group, group + '_barrier')):
            raise RuntimeError('previous private trace rings were not physically removed')
        if len(list(ROOT.parent.glob('tuna-kernel-trace-complete-*'))) >= 16:
            raise RuntimeError('retained observer session count exceeds bound')
        ROOT.rename(ROOT.parent / ('tuna-kernel-trace-complete-' + group))
    ROOT.mkdir(mode=0o700)
    metadata = ROOT.stat()
    if metadata.st_uid != 0 or metadata.st_mode & 0o077 or ROOT.is_symlink():
        raise RuntimeError('unsafe observer root')
    if os.uname().machine != 'x86_64':
        raise RuntimeError('observer ABI is qualified only for x86-64')
    cpu_ids = online_cpu_ids()
    cpus = os.cpu_count()
    if cpus != len(cpu_ids):
        raise RuntimeError('observer online CPU count differs from actual inventory')
    possible_ids = cpu_inventory(Path('/sys/devices/system/cpu/possible'), 65536)
    possible_cpus = len(possible_ids)
    if not set(cpu_ids) <= set(possible_ids):
        raise RuntimeError('online CPU IDs escaped the kernel possible inventory')
    if cpu_inventory(Path('/sys/devices/system/cpu/present'), 65536) != cpu_ids:
        raise RuntimeError('offline present CPUs do not satisfy the fixed online ring-allocation contract')
    if not (TRACE / 'trace_clock').exists():
        subprocess.run(['/usr/bin/mount', '-t', 'tracefs', '-o', 'nosuid,nodev,noexec', 'tracefs', str(TRACE)],
                       check=True, capture_output=True, timeout=5)
    observer_raw = bounded(Path(__file__), 1024 * 1024)
    # DRM may be built into vmlinux. The actual loaded module inventory
    # and live BTF function definitions determine namespace, not filename
    # assumptions or a fallback when a loaded module's BTF is missing.
    module_inventory = bounded(Path('/proc/modules'), 1024 * 1024).decode()
    module_names = {line.split()[0] for line in module_inventory.splitlines() if line.split()}
    drm_module = 'drm' in module_names
    if 'virtio_gpu' not in module_names:
        raise RuntimeError('actual virtio_gpu module is not loaded')
    inventory = {'kernel_release': os.uname().release, 'proc_modules': module_inventory,
                 'drm_owner': 'drm' if drm_module else 'vmlinux', 'virtio_owner': 'virtio_gpu',
                 'kernel_source': KERNEL_SOURCE, 'cmdline': bounded(Path('/proc/cmdline'), 16384).decode()}
    save(ROOT / 'preflight-inventory.json', inventory)
    if os.uname().release != EXPECTED_KERNEL_RELEASE or drm_module:
        raise RuntimeError('native BPF source is qualified only for the original stock 7.2.9 built-in DRM kernel')
    if re.search(r'(?:^|\s)(?:alloc_snapshot|ftrace_boot_snapshot|trace_buf_size)(?:=|\s|$)', inventory['cmdline']):
        raise RuntimeError('boot trace-allocation overrides exceed the fresh-instance default peak contract')
    kernel_image = Path('/usr/lib/modules') / os.uname().release / 'vmlinuz'
    inventory['kernel_image'] = fingerprint(kernel_image, 128 * 1024 * 1024)
    save(ROOT / 'preflight-kernel.json', inventory['kernel_image'])
    if inventory['kernel_image']['sha256'] != EXPECTED_KERNEL_SHA256:
        raise RuntimeError('installed stock kernel image differs from the qualified original source')
    inventory['kernel_notes'] = fingerprint(Path('/sys/kernel/notes'), 1024 * 1024)
    inventory['virtio_gpu_notes'] = fingerprint(Path('/sys/module/virtio_gpu/notes/.note.gnu.build-id'), 65536)
    btf_sources = {}
    loaded = {}
    for name in ('vmlinux', 'virtio_gpu') + (('drm',) if drm_module else ()):
        raw = bounded(Path('/sys/kernel/btf') / name, 64 * 1024 * 1024)
        btf_sources[name] = {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}
        save(ROOT / ('preflight-' + name + '.json'), btf_sources[name])
        if btf_sources[name]['sha256'] != EXPECTED_BTF.get(name):
            raise RuntimeError('live BTF differs from the qualified original kernel source: ' + name)
        loaded[name] = Btf(raw, loaded.get('vmlinux'))
    group = 'tuna_vblank_' + os.urandom(8).hex()
    layout = build_layout(loaded['vmlinux'], loaded['vmlinux'], loaded['virtio_gpu'], drm_module=False)
    budget = buffer_budget(loaded['vmlinux'], cpus, os.sysconf('SC_PAGE_SIZE'))
    marker = {'group': group, 'layout': layout, 'btf': btf_sources, 'source_inventory': inventory,
              'started_monotonic_ns': time.monotonic_ns(), 'cpus': cpus, 'online_cpu_ids': cpu_ids,
              'possible_cpu_count': possible_cpus,
              'present_cpu_ids': cpu_ids,
              'limit_seconds': MAX_SECONDS, 'buffer_data_page_bound_bytes_per_cpu': BUFFER_DATA_PAGE_BOUND,
              'buffer_budget': budget, 'acquisition_backend': BPF_BACKEND, 'bpf_schema': BPF_SCHEMA,
              'observer': {'bytes': len(observer_raw), 'sha256': hashlib.sha256(observer_raw).hexdigest(), 'python': sys.version},
              'native_collector': fingerprint(BPF_COLLECTOR, 1024 * 1024),
              'native_object': fingerprint(BPF_OBJECT, 1024 * 1024),
              'return_argument_provenance': {'source': KERNEL_SOURCE.replace('/tree/', '/blob/') + '/kernel/bpf/trampoline.c',
                  'mechanism': 'BPF fexit context supplies the preserved function arguments and actual return value; no saved kretprobe instance or synthetic recovery'},
              'diagnostic_only': True, 'overhead': 'native tracepoints, BPF fentry/fexit, scoped runtime statistics and a root collector; never final performance parity'}
    instance = TRACE / 'instances' / group
    barrier = TRACE / 'instances' / (group + '_barrier')
    try:
        # Resize the initially default-sized barrier BEFORE either other ring
        # exists, so creation itself cannot exceed the original total cap.
        barrier.mkdir()
        marker['barrier_instance_created'] = True
        write(barrier / 'tracing_on', '0')
        write(barrier / 'events/enable', '0')
        write(barrier / 'current_tracer', 'nop')
        barrier_layout = actual_buffer_layout(barrier, 3 * budget['page_bytes'])
        marker['barrier_buffer_layout'] = barrier_layout
        write(barrier / 'buffer_size_kb', str(barrier_layout['requested_kb']))
        marker['barrier_buffer_readbacks'] = buffer_readbacks(barrier, possible_cpus, barrier_layout['expected_readback_kb'])
        marker['barrier_snapshot'] = snapshot_inventory(barrier)
        write(barrier / 'set_ftrace_filter', 'drm_crtc_arm_vblank_event')
        instance.mkdir()
        marker['instance_created'] = True
        write(instance / 'tracing_on', '0')
        write(instance / 'current_tracer', 'nop')
        marker['buffer_layout'] = actual_buffer_layout(instance, budget['native_bound_bytes_per_cpu'])
        write(instance / 'buffer_size_kb', str(marker['buffer_layout']['requested_kb']))
        marker['buffer_readbacks'] = buffer_readbacks(instance, possible_cpus, marker['buffer_layout']['expected_readback_kb'])
        marker['native_snapshot'] = snapshot_inventory(instance)
        write(instance / 'options/overwrite', '0')
        write(instance / 'trace_clock', 'mono')
        clock = bounded(instance / 'trace_clock', 4096).decode()
        if '[mono]' not in clock:
            raise RuntimeError('actual trace clock is not mono')
        marker['native_trace_clock'] = clock
        formats = {}
        for event in EVENTS:
            formats[event] = bounded(instance / 'events' / event / 'format', 65536).decode()
            if not event.startswith('timer/'):
                write(instance / 'events' / event / 'enable', '1')
        formats['bpf_binary'] = {'schema': BPF_SCHEMA, 'record_bytes': BPF_RECORD.size,
                                 'encoding': 'little-endian <QQIIQ20QQII', 'fields': FIELD_NAMES,
                                 'header_fields': ('monotonic_ns', 'per_cpu_program_call_sequence',
                                                   'event_id', 'cpu_id', 'pid_tgid'),
                                 'tail_fields': ('present_field_mask', 'failed_read_count', 'reserved_zero'),
                                 'signed_value_fields': sorted(SIGNED_FIELDS),
                                 'events': [{'name': name, 'fields': EVENT_FIELDS[number]}
                                            for number, name in enumerate(EVENT_NAMES)],
                                 'clock': 'bpf_ktime_get_ns / trace_clock mono',
                                 'layout': layout}
        save(ROOT / 'formats.json', formats)
        formats_raw = bounded(ROOT / 'formats.json', 2 * 1024 * 1024)
        marker['formats'] = {'bytes': len(formats_raw), 'sha256': hashlib.sha256(formats_raw).hexdigest()}
        marker['layout_input'] = retain_raw(ROOT / 'layout.bin', struct.pack('<13I', *(value & 0xffffffff for value in layout['values'])))
        save(ROOT / 'native-launch.json', marker)
        marker['native_launched'] = True
        subprocess.Popen([sys.executable, __file__, 'watchdog', '--group', group],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        ready_deadline = time.monotonic() + 10
        while not (ROOT / 'bpf-ready.json').exists():
            if (ROOT / 'native-exit.json').exists() or (ROOT / 'supervisor-error.json').exists():
                raise RuntimeError('native BPF collector failed before complete ready receipt')
            if time.monotonic() >= ready_deadline:
                raise RuntimeError('native BPF collector readiness exceeded bounded deadline')
            time.sleep(.02)
        process = read_json(ROOT / 'native-process.json')
        if process.get('group') != group or type(process.get('pid')) is not int or process['pid'] <= 0:
            raise RuntimeError('native BPF child identity is not original')
        marker['native_pid'] = process['pid']
        marker['native_process_identity'] = process['identity']
        if process_identity(process['pid']) != process['identity']:
            raise RuntimeError('native BPF collector is not physically present at ready')
        ready = read_json(ROOT / 'bpf-ready.json')
        if ready.get('schema') != BPF_SCHEMA or ready.get('buffer_accounting', {}).get('ring_data_bytes') != BPF_RING_BYTES:
            raise RuntimeError('native BPF ready schema/allocation is unsupported')
        possible = ready.get('possible_cpu_count')
        if (ready.get('online_cpu_ids') != cpu_ids or type(possible) is not int
                or possible != possible_cpus):
            raise RuntimeError('native BPF actual CPU inventory is unsupported')
        program_inventory(ready.get('programs_before'), layout)
        marker['native_ready'] = ready
        marker['capture_filter'] = 'actual-native-timer-inventory-v1'
        marker['discovery_started_monotonic_ns'] = time.monotonic_ns()
        write(instance / 'tracing_on', '1')
        marker['native_trace_started_monotonic_ns'] = time.monotonic_ns()
        # Observe actual native timers before profiler Start. No injected
        # event, guessed address, buffer reset, consuming read or scope trim.
        time.sleep(.5)
        discovery = bounded(instance / 'trace', 2 * 1024 * 1024)
        marker['discovery_raw'] = retain_raw(ROOT / 'discovery.txt', discovery)
        discovery_bpf = bounded(ROOT / 'bpf.bin', 2 * 1024 * 1024)
        marker['discovery_finished_monotonic_ns'] = time.monotonic_ns()
        if marker['discovery_finished_monotonic_ns'] - marker['discovery_started_monotonic_ns'] > 1_000_000_000:
            raise RuntimeError('actual timer discovery exceeded its one-second bound')
        marker['discovery_cpu_stats'] = cpu_stats(instance, possible_cpus)
        observed = bpf_records(discovery_bpf, cpu_ids)
        marker['discovery_bpf'] = {'bytes': len(discovery_bpf), 'sha256': hashlib.sha256(discovery_bpf).hexdigest(),
                                   'records': len(observed)}
        if (ROOT / 'native-exit.json').exists():
            raise RuntimeError('native BPF collector physically exited during discovery')
        inventory = timer_mappings(observed)
        marker['timer_inventory'] = inventory
        marker['timer_filters'] = {}
        for event in EVENTS:
            if not event.startswith('timer/'):
                continue
            expression = timer_filter(inventory, formats[event])
            write(instance / 'events' / event / 'filter', expression)
            actual = bounded(instance / 'events' / event / 'filter', 65536).decode().strip()
            if actual != expression:
                raise ValueError('kernel timer filter readback differs')
            marker['timer_filters'][event] = {'requested': expression, 'actual': actual}
            write(instance / 'events' / event / 'enable', '1')
        marker['filters_ready_monotonic_ns'] = time.monotonic_ns()
        marker['generic_pointer_limitation'] = 'Generic trace text prints hashed %p; kernel filters compare actual raw hrtimer fields. No hash-to-pointer causal join is inferred.'
        save(ROOT / 'marker.json', marker)
        return marker
    except BaseException as error:
        errors = [str(error)[:2048]]
        retained = {}
        if marker.get('native_launched'):
            try:
                stop_native(marker)
            except Exception as retirement_error:
                errors.append(str(retirement_error)[:2048])
        if not marker.get('native_launched') or marker.get('native_terminal_observed'):
            if marker.get('instance_created') and instance.exists():
                # On failed start, first retire a potentially failing native
                # collector. Its barrier may own trace_types_lock. Freeze and
                # retain the WHOLE native tail before deleting either instance.
                retained['start_failure_native_trace_stop_begin_monotonic_ns'] = time.monotonic_ns()
                for path in ('tracing_on', 'events/enable'):
                    try:
                        write(instance / path, '0')
                    except OSError as freeze_error:
                        errors.append(str(freeze_error)[:2048])
                retained['native_trace_stopped_monotonic_ns'] = time.monotonic_ns()
                try:
                    retained['raw'] = retain_raw(ROOT / 'capture.txt', bounded(instance / 'trace', MAX_RAW))
                    retained['cpu_stats'] = cpu_stats(instance, possible_cpus)
                    retained['native_trace_clock_after'] = bounded(instance / 'trace_clock', 4096).decode()
                except Exception as retention_error:
                    errors.append(str(retention_error)[:2048])
            if (ROOT / 'bpf.bin').exists():
                retained['bpf_raw'] = fingerprint(ROOT / 'bpf.bin', MAX_RAW)
        else:
            errors.append('native process unretired; whole live sources remain in their original private locations')
        cleanup_errors = cleanup(marker)
        result = dict(marker, **retained, qualified_acquisition=False, errors=errors, cleanup_errors=cleanup_errors)
        for key, name in (('native_bpf', 'bpf-result.json'), ('native_exit', 'native-exit.json')):
            if (ROOT / name).exists():
                result[key] = read_json(ROOT / name)
        save(ROOT / 'result.json', result)
        raise


def stop(watchdog=False):
    if (ROOT / 'result.json').exists():
        return read_json(ROOT / 'result.json')
    marker = read_json(ROOT / 'marker.json')
    instance = TRACE / 'instances' / marker['group']
    stop_begin = time.monotonic_ns()
    result = dict(marker, stopped_monotonic_ns=stop_begin, watchdog_expired=watchdog)
    errors = []
    for path in ('tracing_on', 'events/enable'):
        try:
            write(instance / path, '0')
        except OSError as error:
            errors.append(str(error))
    result['native_trace_stopped_monotonic_ns'] = time.monotonic_ns()
    # Retain both whole sources before admission/provenance/semantic validation.
    raw = bpf_raw = None
    try:
        raw = bounded(instance / 'trace', MAX_RAW)
        result['raw'] = retain_raw(ROOT / 'capture.txt', raw)
        result['formats'] = fingerprint(ROOT / 'formats.json', 2 * 1024 * 1024)
    except Exception as error:
        errors.append(str(error)[:2048])
    try:
        result['native_bpf'] = stop_native(marker)
        result['native_exit'] = marker.get('native_exit')
    except Exception as error:
        errors.append(str(error)[:2048])
        if (ROOT / 'bpf-result.json').exists():
            result['native_bpf'] = read_json(ROOT / 'bpf-result.json')
    try:
        bpf_raw = bounded(ROOT / 'bpf.bin', MAX_RAW)
        result['bpf_raw'] = {'bytes': len(bpf_raw), 'sha256': hashlib.sha256(bpf_raw).hexdigest()}
        if raw is not None and len(raw) + len(bpf_raw) > MAX_RAW:
            errors.append('combined whole native/BPF sources exceed original raw byte bound')
    except Exception as error:
        errors.append(str(error)[:2048])
    try:
        if fingerprint(Path(__file__), 1024 * 1024)['sha256'] != marker['observer']['sha256']:
            errors.append('installed observer changed during capture')
        for key, path in (('native_collector', BPF_COLLECTOR), ('native_object', BPF_OBJECT),
                          ('layout_input', ROOT / 'layout.bin')):
            if fingerprint(path, 1024 * 1024) != marker[key]:
                errors.append('installed native BPF source/layout changed: ' + key)
        for name, original in marker['btf'].items():
            if fingerprint(Path('/sys/kernel/btf') / name, 64 * 1024 * 1024) != original:
                errors.append('live BTF changed during capture: ' + name)
        inventory = marker['source_inventory']
        for key, path in (('kernel_image', Path('/usr/lib/modules') / EXPECTED_KERNEL_RELEASE / 'vmlinuz'),
                          ('kernel_notes', Path('/sys/kernel/notes')),
                          ('virtio_gpu_notes', Path('/sys/module/virtio_gpu/notes/.note.gnu.build-id'))):
            if fingerprint(path, 128 * 1024 * 1024) != inventory[key]:
                errors.append('actual kernel source identity changed: ' + key)
        if os.uname().release != inventory['kernel_release']:
            errors.append('actual kernel release changed during capture')
        result['buffer_layout_after'] = actual_buffer_layout(instance, marker['buffer_budget']['native_bound_bytes_per_cpu'])
        if result['buffer_layout_after'] != marker['buffer_layout']:
            errors.append('actual trace data page layout changed during capture')
        result['buffer_readbacks_after'] = buffer_readbacks(instance, marker['possible_cpu_count'], marker['buffer_layout']['expected_readback_kb'])
        if result['buffer_readbacks_after'] != marker['buffer_readbacks']:
            errors.append('actual per-CPU buffer allocation changed during capture')
        if online_cpu_ids() != marker['online_cpu_ids']:
            errors.append('actual online CPU inventory changed during capture')
        if cpu_inventory(Path('/sys/devices/system/cpu/present'), 65536) != marker['present_cpu_ids']:
            errors.append('actual present CPU inventory changed during capture')
        result['native_snapshot_after'] = snapshot_inventory(instance)
        barrier = TRACE / 'instances' / (marker['group'] + '_barrier')
        result['barrier_buffer_readbacks_after'] = buffer_readbacks(
            barrier, marker['possible_cpu_count'], marker['barrier_buffer_layout']['expected_readback_kb'])
        result['barrier_snapshot_after'] = snapshot_inventory(barrier)
        result['cpu_stats'] = cpu_stats(instance, marker['possible_cpu_count'])
        result['native_trace_clock_after'] = bounded(instance / 'trace_clock', 4096).decode()
        if result['native_trace_clock_after'] != marker['native_trace_clock']:
            errors.append('actual native trace clock changed during capture')
        result['timer_filters_after'] = {}
        for event, proof in marker['timer_filters'].items():
            actual = bounded(instance / 'events' / event / 'filter', 65536).decode().strip()
            result['timer_filters_after'][event] = actual
            if actual != proof['actual']:
                errors.append('actual kernel timer filter changed during measurement')
        for values in result['cpu_stats'].values():
            for key in ('overrun', 'commit overrun', 'dropped events'):
                if key not in values or not values[key].isdigit() or int(values[key]) != 0:
                    errors.append('actual trace buffer loss/missing loss field')
        if bpf_raw is not None:
            discovery = marker['discovery_bpf']
            if (len(bpf_raw) < discovery['bytes']
                    or hashlib.sha256(bpf_raw[:discovery['bytes']]).hexdigest() != discovery['sha256']):
                errors.append('whole BPF source no longer contains the original discovery prefix')
            records = bpf_records(bpf_raw, marker['online_cpu_ids'])
            counts = native_qualification(result.get('native_bpf'), marker, records, len(bpf_raw))
            result['actual_record_counts'] = counts
            result['unobserved_branches'] = [name for name, count in counts.items() if not count]
            timer_mappings(records, marker['timer_inventory'])
            if raw is not None:
                result['native_timer_reconciliation'] = native_timer_reconciliation(
                    raw, records, marker, result['native_bpf'], stop_begin)
                proof = result['native_timer_reconciliation']
                result['function_pair_reconciliation'] = function_pair_reconciliation(
                    records, proof['active_window_begin_ns'], proof['active_window_end_ns'])
        if watchdog or stop_begin - marker['started_monotonic_ns'] > MAX_SECONDS * 1_000_000_000:
            errors.append('observer exceeded its real duration bound')
    except Exception as error:
        errors.append(str(error)[:2048])
    result['cleanup_errors'] = cleanup(marker)
    result['native_exit'] = marker.get('native_exit')
    errors.extend(result['cleanup_errors'])
    result['qualified_acquisition'] = not errors
    result['errors'] = errors
    save(ROOT / 'result.json', result)
    return result


def watchdog(group):
    """Own waitpid across separate Start/Stop invocations; never infer exit0."""
    launch = read_json(ROOT / 'native-launch.json')
    if launch.get('group') != group or not re.fullmatch(r'tuna_vblank_[0-9a-f]{16}', group):
        raise RuntimeError('native supervisor does not own this acquisition')
    child = None
    try:
        if (ROOT / 'native-cancel').exists() or (ROOT / 'result.json').exists():
            return
        deadline_ns = launch['started_monotonic_ns'] + MAX_SECONDS * 1_000_000_000
        with (ROOT / 'native-stderr.txt').open('xb') as stderr:
            os.chmod(ROOT / 'native-stderr.txt', 0o600)
            child = subprocess.Popen([str(BPF_COLLECTOR), '--root', str(ROOT),
                    '--object', str(BPF_OBJECT), '--deadline-ns', str(deadline_ns),
                    '--drm-owner', launch['source_inventory']['drm_owner'],
                    '--barrier-instance', str(TRACE / 'instances' / (group + '_barrier'))],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=stderr)
            identity = process_identity(child.pid)
            if identity is None:
                raise RuntimeError('native BPF process exited before original identity observation')
            save_atomic(ROOT / 'native-process.json', {'schema': 1, 'group': group,
                                                'pid': child.pid, 'identity': identity})
            if (ROOT / 'native-cancel').exists():
                child.terminate()
            try:
                code = child.wait(timeout=max(.01, (deadline_ns - time.monotonic_ns()) / 1_000_000_000 + 5))
            except subprocess.TimeoutExpired:
                child.terminate()
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=5)
                raise RuntimeError('native BPF process exceeded physical retirement deadline')
        save_atomic(ROOT / 'native-exit.json', {'schema': 1, 'group': group, 'pid': child.pid,
             'terminal_observed': True, 'exitcode': code, 'observed_exit_monotonic_ns': time.monotonic_ns()})
        if (ROOT / 'marker.json').exists() and not (ROOT / 'result.json').exists():
            with lock():
                marker = read_json(ROOT / 'marker.json')
                if marker['group'] == group and not (ROOT / 'result.json').exists():
                    stop(watchdog=time.monotonic_ns() >= deadline_ns)
    except BaseException as error:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait(timeout=5)
        try:
            still_owned = read_json(ROOT / 'native-launch.json').get('group') == group
        except (OSError, ValueError):
            still_owned = False
        if still_owned and not (ROOT / 'supervisor-error.json').exists():
            save_atomic(ROOT / 'supervisor-error.json', {'group': group, 'error': str(error)[:2048],
                         'terminal_observed': child is not None and child.returncode is not None})
        raise


def read(index, kind):
    if type(index) is not int or not 0 <= index < 1024:
        raise ValueError('invalid kernel trace chunk index')
    paths = {'trace': 'capture.txt', 'formats': 'formats.json', 'discovery': 'discovery.txt', 'bpf': 'bpf.bin'}
    path = ROOT / paths[kind]
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if metadata.st_uid != 0 or metadata.st_mode & 0o077 or not stat.S_ISREG(metadata.st_mode) or metadata.st_size > MAX_RAW:
            raise RuntimeError('unsafe retained observer artifact')
        stream.seek(index * 65536)
        raw = stream.read(65536)
    if not raw:
        raise ValueError('kernel trace chunk beyond end')
    return {'index': index, 'data': base64.b64encode(raw).decode('ascii')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('start', 'stop', 'read', 'watchdog'))
    parser.add_argument('--index', type=int, default=0)
    parser.add_argument('--kind', choices=('trace', 'formats', 'discovery', 'bpf'), default='trace')
    parser.add_argument('--group')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError('kernel observer requires the CI root probe')
    if args.action in ('start', 'stop'):
        with lock():
            result = start() if args.action == 'start' else stop()
    elif args.action == 'read': result = read(args.index, args.kind)
    else:
        watchdog(args.group)
        return
    print(json.dumps(result))


if __name__ == '__main__':
    main()
