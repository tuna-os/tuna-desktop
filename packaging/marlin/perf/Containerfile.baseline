# CI-only GNOME 51.0 baseline derived from the recorded Marlin image.
# The declared baseline is GNOME 51.0 (ADR 0007), but Arch and the published
# Marlin tag have moved on to the 51.1 point release. Resolve every Arch
# repository from one dated Arch Linux Archive snapshot instead of the moving
# mirrors. ARCH_ARCHIVE_SNAPSHOT is the last daily snapshot in which extra
# carries gnome-shell 1:51.0-1 together with Mutter 51.0 (the next day's
# snapshot already moved Mutter to 51.1). The Mutter profiler build, the shared
# preview and the Tuna payload's dependencies all resolve from this image's
# synced databases, so they share the same snapshot. Changing this date changes
# the baseline and requires an ADR (docs/roadmap.md change control).
# Both testing repositories stay enabled from the same snapshot, as in the last
# green derived baseline; -Syuu performs one complete transaction that also
# downgrades packages the base image already took from newer mirrors.
ARG BASE_IMAGE=ghcr.io/tuna-os/marlin:gnome
ARG COHERENT_BASE=gnome-baseline
ARG ARCH_ARCHIVE_SNAPSHOT=2026/10/13
FROM ${BASE_IMAGE} AS gnome-baseline
ARG ARCH_ARCHIVE_SNAPSHOT
RUN printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$ARCH_ARCHIVE_SNAPSHOT" > /etc/pacman.d/mirrorlist && \
    sed -i '/^\[core\]/i [core-testing]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra-testing]\nInclude = /etc/pacman.d/mirrorlist\n' /etc/pacman.conf && \
    pacman -Syuu --noconfirm gnome-shell mutter gdm \
        evolution-data-server gnome-keyring xdg-desktop-portal-gnome xdg-desktop-portal-gtk \
        gst-plugin-pipewire gst-plugins-good orca speech-dispatcher \
        python python-gobject wayland-utils qemu-guest-agent openssh gcc pkgconf wayland-protocols && \
    kernel_count=0 && \
    for module_dir in /usr/lib/modules/*; do \
        test -d "$module_dir" || continue; \
        kernel="${module_dir##*/}"; \
        test -f "$module_dir/vmlinuz" || continue; \
        kernel_count=$((kernel_count + 1)); \
        depmod "$kernel" && dracut --force "$module_dir/initramfs.img" "$kernel" || exit 1; \
    done && \
    test "$kernel_count" -eq 1 && \
    gnome-shell --version | grep -qx 'GNOME Shell 51.0' && \
    pacman -Q mutter | grep -Eqx 'mutter 51\.0-[0-9]+' && \
    pacman -Q > /tmp/tuna-baseline-packages.txt && \
    LC_ALL=C sort /tmp/tuna-baseline-packages.txt > /usr/share/tuna-perf-baseline-packages.txt && \
    rm /tmp/tuna-baseline-packages.txt

# Unmodified distribution GNOME target; no diagnostic package is installed.
FROM ${COHERENT_BASE} AS stock-reference
COPY scripts/lib/gnome_reference.py /usr/libexec/gnome_reference.py
COPY packaging/marlin/perf/tuna-perf-reference-image /usr/libexec/tuna-perf-reference-image
RUN pacman -Qlq linux mutter gnome-shell > /tmp/tuna-baseline-critical-files.txt && \
    for module_dir in /usr/lib/modules/*; do \
        if test -f "$module_dir/vmlinuz"; then \
            test -s "$module_dir/vmlinuz" && test -s "$module_dir/initramfs.img" && test -s "$module_dir/modules.dep" && \
                printf '%s\n' "$module_dir/vmlinuz" "$module_dir/initramfs.img" "$module_dir/modules.dep" || exit 1; \
        fi; \
    done >> /tmp/tuna-baseline-critical-files.txt && \
    while IFS= read -r path; do \
        test ! -f "$path" || sha256sum "$path" || exit 1; \
    done < /tmp/tuna-baseline-critical-files.txt > /usr/share/tuna-perf-baseline-critical.sha256 && \
    test -s /usr/share/tuna-perf-baseline-critical.sha256 && \
    rm /tmp/tuna-baseline-critical-files.txt && \
    python3 /usr/libexec/tuna-perf-reference-image stock

# Build the pinned Arch 51.0 diagnostic variant with closed writer and source IDs.
# Toolchain and source files remain in this build stage, outside the measured image.
FROM ${COHERENT_BASE} AS mutter-profiler-build
COPY packaging/marlin/perf/mutter-profiler /build/mutter-profiler
RUN pacman -S --needed --noconfirm base-devel git sudo && \
    useradd --create-home --user-group profiler-builder && \
    printf '%s\n' 'profiler-builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/profiler-builder && \
    chmod 0440 /etc/sudoers.d/profiler-builder && \
    chown -R profiler-builder:profiler-builder /build/mutter-profiler && \
    cd /build/mutter-profiler && \
    runuser -u profiler-builder -- makepkg --syncdeps --noconfirm --cleanbuild && \
    mkdir /profiler-package && \
    cp mutter-51.0-1.7-x86_64.pkg.tar.zst /profiler-package/ && \
    cp PKGBUILD release-trace-context.patch frame-source-evidence.patch drained-capture-start.patch page-flip-identity.patch /profiler-package/ && \
    cd /profiler-package && \
    sha256sum PKGBUILD release-trace-context.patch frame-source-evidence.patch drained-capture-start.patch page-flip-identity.patch mutter-51.0-1.7-x86_64.pkg.tar.zst > sha256sums

FROM ${COHERENT_BASE} AS diagnostic-reference
COPY scripts/lib/gnome_reference.py /usr/libexec/gnome_reference.py
COPY packaging/marlin/perf/tuna-perf-reference-image /usr/libexec/tuna-perf-reference-image
COPY --from=mutter-profiler-build /profiler-package /usr/share/tuna-perf-mutter-profiler
RUN cd /usr/share/tuna-perf-mutter-profiler && sha256sum -c sha256sums && \
    pacman -U --noconfirm mutter-51.0-1.7-x86_64.pkg.tar.zst && \
    pacman -Q mutter | grep -qx 'mutter 51.0-1.7' && \
    pacman -Q > /tmp/tuna-baseline-packages.txt && \
    LC_ALL=C sort /tmp/tuna-baseline-packages.txt > /usr/share/tuna-perf-baseline-packages.txt && \
    pacman -Qlq linux mutter > /tmp/tuna-baseline-critical-files.txt && \
    for module_dir in /usr/lib/modules/*; do \
        if test -f "$module_dir/vmlinuz"; then \
            test -s "$module_dir/vmlinuz" && test -s "$module_dir/initramfs.img" && test -s "$module_dir/modules.dep" && \
                printf '%s\n' "$module_dir/vmlinuz" "$module_dir/initramfs.img" "$module_dir/modules.dep" || exit 1; \
        fi; \
    done >> /tmp/tuna-baseline-critical-files.txt && \
    while IFS= read -r path; do \
        test ! -f "$path" || sha256sum "$path" || exit 1; \
    done < /tmp/tuna-baseline-critical-files.txt > /usr/share/tuna-perf-baseline-critical.sha256 && \
    test -s /usr/share/tuna-perf-baseline-critical.sha256 && \
    rm /tmp/tuna-baseline-packages.txt /tmp/tuna-baseline-critical-files.txt && \
    python3 /usr/libexec/tuna-perf-reference-image diagnostic
