+        if self.keep_mapped {
+            buffer.persistent_map = PersistentMap::new(&buffer.bo);
+            if buffer.persistent_map.is_none() {
+                warn!("gbm_bo_map failed; the buffer is mapped per use");
+            }
+        }
+        Ok(buffer)
     }
