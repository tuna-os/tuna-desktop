+#[cfg(test)]
+mod cancellation_tests {
+    use super::*;
+
+    fn accepted_offer() -> OfferData {
+        OfferData {
+            active: true,
+            dropped: false,
+            accepted: true,
+            finished: false,
+            chosen_action: DndAction::Move,
+        }
+    }
+
+    #[test]
+    fn cancellation_invalidates_an_accepted_offer_idempotently() {
+        let mut offer = accepted_offer();
+        assert!(offer.valid_drop());
+        offer.cancel();
+        offer.cancel();
+        assert!(!offer.valid_drop());
+        assert!(!offer.active);
+        assert!(!offer.accepted);
+        assert!(!offer.dropped);
+        assert!(offer.chosen_action.is_empty());
+    }
+
+    #[test]
+    fn successful_drop_keeps_offer_active_until_finish() {
+        let mut offer = accepted_offer();
+        assert!(offer.valid_drop());
+        offer.dropped = true;
+        assert!(offer.active);
+        assert!(!offer.valid_drop());
+        offer.finished = true;
+        offer.active = false;
+        assert!(!offer.valid_drop());
+    }
+}
