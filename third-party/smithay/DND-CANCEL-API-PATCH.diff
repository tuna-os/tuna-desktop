+/// Whether a client drag owns either the pointer or touch grab (icons are optional).
+pub fn client_dnd_active<D>(seat: &Seat<D>) -> bool
+where
+    D: DataDeviceHandler + 'static,
+    D::PointerFocus: WaylandFocus,
+    D::TouchFocus: WaylandFocus,
+{
+    seat.get_pointer()
+        .is_some_and(|p| p.with_grab(|_, g| g.is::<DnDGrab<D>>()).unwrap_or(false))
+        || seat
+            .get_touch()
+            .is_some_and(|t| t.with_grab(|_, g| g.is::<DnDGrab<D>>()).unwrap_or(false))
+}
+
+/// Cancel only client DnD grabs. Mark offers invalid under the grab lock, then
+/// unset outside that lock: unset runs the terminal callback and acquires it again.
+pub fn cancel_client_dnd<D>(seat: &Seat<D>, data: &mut D, serial: Serial, time: u32) -> bool
+where
+    D: DataDeviceHandler + 'static,
+    D::PointerFocus: WaylandFocus,
+    D::TouchFocus: WaylandFocus,
+{
+    let mut cancelled = false;
+    if let Some(pointer) = seat.get_pointer() {
+        let marked = pointer
+            .with_grab(|_, grab| {
+                if let Some(dnd) = grab.downcast_ref::<DnDGrab<D>>() {
+                    dnd.prepare_cancel();
+                    true
+                } else {
+                    false
+                }
+            })
+            .unwrap_or(false);
+        if marked {
+            pointer.unset_grab(data, serial, time);
+            cancelled = true;
+        }
+    }
+    if let Some(touch) = seat.get_touch() {
+        let marked = touch
+            .with_grab(|_, grab| {
+                if let Some(dnd) = grab.downcast_ref::<DnDGrab<D>>() {
+                    dnd.prepare_cancel();
+                    true
+                } else {
+                    false
+                }
+            })
+            .unwrap_or(false);
+        if marked {
+            touch.unset_grab(data);
+            cancelled = true;
+        }
+    }
+    cancelled
+}
