[Unit]
Description=Tuna Desktop graphical user session
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target graphical-session.target

# GNOME Settings Daemon's plugins, through GNOME 51's own user units. Each
# org.gnome.SettingsDaemon.*.target is Requisite= and After=
# gnome-session-initialized.target, which is Requisite= gnome-session.target,
# so both join this transaction (gnome-session 51 data/*.target). The
# compositor holds the session leader FIFO that gnome-session.target's
# monitor watches, so the targets and plugins end with the session.
Wants=gnome-session.target gnome-session-initialized.target

# GNOME 51 gnome-session-basic-services.target and
# gnome-session-services.target, except the plugins whose services Tuna
# Desktop provides itself: Color (the compositor owns
# org.gnome.SettingsDaemon.Color for Night Light) and A11ySettings (the
# compositor runs Orca). MediaKeys is gsd's own: it grabs the media, launcher
# and power keys through org.gnome.Shell and holds logind's power-key
# inhibitors, so the power key follows power-button-action; the shell
# stands its native volume and lock keys down while it runs.
# XSettings follows Xwayland: the compositor starts
# gnome-session-x11-services-ready.target as GNOME Shell does.
Wants=org.gnome.SettingsDaemon.Keyboard.target org.gnome.SettingsDaemon.Power.target
Wants=org.gnome.SettingsDaemon.Rfkill.target org.gnome.SettingsDaemon.Sharing.target
Wants=org.gnome.SettingsDaemon.Smartcard.target org.gnome.SettingsDaemon.UsbProtection.target
Wants=org.gnome.SettingsDaemon.Datetime.target org.gnome.SettingsDaemon.Housekeeping.target
Wants=org.gnome.SettingsDaemon.PrintNotifications.target org.gnome.SettingsDaemon.ScreensaverProxy.target
Wants=org.gnome.SettingsDaemon.Sound.target org.gnome.SettingsDaemon.Wwan.target
Wants=org.gnome.SettingsDaemon.MediaKeys.target
